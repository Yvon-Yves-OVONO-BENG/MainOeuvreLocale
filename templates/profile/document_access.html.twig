{% extends 'base.html.twig' %}
{% block title %}Accès aux justificatifs{% endblock %}
{% block body %}
<div class="container py-5"><h1 class="h3 mb-4">Accès aux justificatifs</h1>
<div class="row g-4"><div class="col-lg-7"><div class="card card-body"><h2 class="h5">Demandes reçues</h2>{% for g in received %}<div class="border rounded-3 p-3 mb-2"><strong>{{ g.viewer.personalProfile.fullName ?? g.viewer.email }}</strong> demande l’accès à votre {{ g.documentType|upper }}. <span class="badge text-bg-secondary">{{ g.status }}</span>{% if g.status == 'pending' %}<div class="mt-2 d-flex gap-2"><button class="btn btn-sm btn-success" data-document-decision="{{ path('document_access_decision',{id:g.id,decision:'approve'}) }}" data-token="{{ csrf_token('document_access_decision_' ~ g.id) }}">Autoriser 30 jours</button><button class="btn btn-sm btn-outline-danger" data-document-decision="{{ path('document_access_decision',{id:g.id,decision:'reject'}) }}" data-token="{{ csrf_token('document_access_decision_' ~ g.id) }}">Refuser</button></div>{% endif %}</div>{% else %}<p class="text-muted">Aucune demande.</p>{% endfor %}</div></div>
<div class="col-lg-5"><div class="card card-body"><h2 class="h5">Mes demandes</h2>{% for g in sent %}<div class="border-bottom py-2">{{ g.owner.personalProfile.fullName ?? g.owner.email }} · {{ g.documentType|upper }} · {{ g.status }}{% if g.usable %}<a class="btn btn-sm btn-dark ms-2" href="{{ path('document_access_view',{id:g.id}) }}">Consulter</a>{% endif %}</div>{% else %}<p class="text-muted">Aucune demande.</p>{% endfor %}</div></div></div></div>
<script>document.addEventListener('click',async e=>{const b=e.target.closest('[data-document-decision]');if(!b)return;b.disabled=true;try{const f=new FormData();f.append('_token',b.dataset.token);const r=await fetch(b.dataset.documentDecision,{method:'POST',body:f,headers:{'X-Requested-With':'XMLHttpRequest'}});if(r.ok)location.reload();}finally{b.disabled=false;}});</script>
{% endblock %}
