{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/profile/edit.js') }}?v=20260815" defer></script>
    <script>
        (function () {
            'use strict';

            /** Met à jour le petit drapeau correspondant au pays réellement sélectionné. */
            function updateCountryFlag(country) {
                const wrapper = country.closest('[data-country-native-wrap]');
                const flag = document.getElementById('profileCountryFlag');
                const image = flag ? flag.querySelector('img') : null;
                const selectedOption = country.options[country.selectedIndex];
                const flagUrl = selectedOption ? selectedOption.dataset.flag : '';

                if (!wrapper || !flag || !image || !flagUrl) {
                    if (wrapper) wrapper.classList.remove('has-flag');
                    if (flag) flag.hidden = true;
                    return;
                }

                image.src = flagUrl;
                image.alt = '';
                flag.hidden = false;
                wrapper.classList.add('has-flag');
            }

            /** Rend le sélecteur de pays natif et préserve strictement la valeur enregistrée. */
            function stabilizeCountrySelection() {
                const country = document.querySelector('.mol-country-native-select');
                if (!country) return;

                const selectedValue = country.dataset.userSelected || country.dataset.currentCountry || country.value;

                if (country.dataset.selectionGuardBound !== '1') {
                    country.dataset.selectionGuardBound = '1';
                    country.addEventListener('change', function () {
                        country.dataset.userSelected = country.value;
                        updateCountryFlag(country);
                    });
                }

                if (country.tomselect && typeof country.tomselect.destroy === 'function') {
                    country.tomselect.destroy();
                }

                if (window.jQuery && window.jQuery.fn && window.jQuery.fn.select2) {
                    const field = window.jQuery(country);
                    if (field.hasClass('select2-hidden-accessible')) {
                        field.select2('destroy');
                    }
                }

                country.classList.remove('select2-hidden-accessible');
                country.removeAttribute('aria-hidden');
                country.removeAttribute('tabindex');
                country.style.display = '';
                country.value = selectedValue;
                updateCountryFlag(country);
            }

            /** Branche la sélection, l'aperçu et l'annulation de la photo de profil. */
            function initializeProfilePhotoPicker() {
                const input = document.querySelector('[data-profile-photo-input]');
                const preview = document.getElementById('profilePhotoPreview');
                const reset = document.getElementById('profilePhotoReset');
                const status = document.getElementById('profilePhotoStatus');

                if (!input || !preview || !reset || !status || input.dataset.photoPickerBound === '1') return;
                input.dataset.photoPickerBound = '1';

                let objectUrl = null;

                /** Libère l'URL temporaire de prévisualisation afin d'éviter une fuite mémoire. */
                function revokePreviewUrl() {
                    if (objectUrl) {
                        URL.revokeObjectURL(objectUrl);
                        objectUrl = null;
                    }
                }

                input.addEventListener('change', function () {
                    const file = input.files && input.files[0];
                    if (!file) return;

                    revokePreviewUrl();
                    objectUrl = URL.createObjectURL(file);
                    preview.src = objectUrl;
                    reset.hidden = false;
                    status.textContent = file.name + ' — ' + Math.max(1, Math.round(file.size / 1024)) + ' Ko';
                });

                input.addEventListener('mol:files-compressed', function (event) {
                    const file = event.detail && event.detail.files ? event.detail.files[0] : null;
                    if (file) {
                        status.textContent = file.name + ' — optimisée (' + Math.max(1, Math.round(file.size / 1024)) + ' Ko)';
                    }
                });

                reset.addEventListener('click', function () {
                    input.value = '';
                    revokePreviewUrl();
                    preview.src = preview.dataset.originalSrc;
                    reset.hidden = true;
                    status.textContent = 'Aucune nouvelle photo sélectionnée.';
                });
            }

            /** Ferme le menu Compétences après sélection et au clic hors du champ. */
            function initializeSkillsDropdownBehavior() {
                const skills = document.getElementById('profile_skills') || document.querySelector('.js-skills');
                if (!skills || skills.dataset.skillsCloseBound === '1') return;
                skills.dataset.skillsCloseBound = '1';

                const closeDropdown = function () {
                    if (skills.tomselect && typeof skills.tomselect.close === 'function') {
                        skills.tomselect.close();
                    }
                    if (window.jQuery && window.jQuery.fn && window.jQuery.fn.select2) {
                        const field = window.jQuery(skills);
                        if (field.hasClass('select2-hidden-accessible')) {
                            field.select2('close');
                        }
                    }
                };

                skills.addEventListener('change', function () {
                    window.setTimeout(closeDropdown, 0);
                });

                if (window.jQuery) {
                    window.jQuery(skills).on('select2:select', function () {
                        window.setTimeout(closeDropdown, 0);
                    });
                }

                document.addEventListener('pointerdown', function (event) {
                    const field = skills.closest('.mol-skills-field');
                    const select2Dropdown = event.target.closest && event.target.closest('.select2-container, .select2-dropdown, .ts-dropdown');
                    if (field && !field.contains(event.target) && !select2Dropdown) {
                        closeDropdown();
                    }
                }, {passive: true});
            }

            /** Affiche un retour immédiat lorsque le formulaire valide part vers le serveur. */
            function initializeProfileSaveFeedback() {
                const form = document.getElementById('profileForm');
                const button = document.getElementById('submitBtn');
                const status = document.getElementById('profileSaveStatus');
                if (!form || !button || form.dataset.saveFeedbackBound === '1') return;

                form.dataset.saveFeedbackBound = '1';
                form.addEventListener('submit', function () {
                    if (!form.checkValidity()) return;
                    button.setAttribute('aria-busy', 'true');
                    status.textContent = 'Enregistrement sécurisé en cours…';
                });
            }

            /** N'affiche l'icône rouge qu'après interaction et donne un état visuel au bouton Enregistrer. */
            function initializeProfileValidationUX() {
                const form = document.getElementById('profileForm');
                const button = document.getElementById('submitBtn');
                const status = document.getElementById('profileSaveStatus');
                if (!form || !button || form.dataset.validationUxBound === '1') return;
                form.dataset.validationUxBound = '1';

                const requiredContainers = Array.from(form.querySelectorAll('.field-container[data-required="true"]'));
                const relevantInputs = Array.from(form.querySelectorAll('input,select,textarea')).filter(function (el) {
                    return !['hidden','submit','button'].includes((el.type || '').toLowerCase()) && !el.disabled;
                });

                function containerIsComplete(container) {
                    const fields = Array.from(container.querySelectorAll('input,select,textarea')).filter(function (el) {
                        return !['hidden','submit','button'].includes((el.type || '').toLowerCase()) && !el.disabled;
                    });
                    if (!fields.length) return true;
                    const checkboxes = fields.filter(function (el) { return el.type === 'checkbox' || el.type === 'radio'; });
                    if (checkboxes.length === fields.length) return checkboxes.some(function (el) { return el.checked; });
                    return fields.every(function (el) {
                        if (el.type === 'file') return el.files && el.files.length > 0 || !el.required;
                        return String(el.value || '').trim() !== '' && el.checkValidity();
                    });
                }

                function refresh() {
                    requiredContainers.forEach(function (container) {
                        const complete = containerIsComplete(container);
                        container.classList.toggle('mol-invalid', container.classList.contains('mol-touched') && !complete);
                    });
                    const complete = requiredContainers.every(containerIsComplete);
                    button.classList.toggle('mol-save-incomplete', !complete);
                    button.classList.toggle('mol-save-ready', complete);
                    button.setAttribute('aria-disabled', complete ? 'false' : 'true');
                    // Le bouton reste cliquable : Symfony affiche ainsi précisément les champs manquants.
                    button.disabled = false;
                }

                relevantInputs.forEach(function (input) {
                    ['change','input','blur'].forEach(function (eventName) {
                        input.addEventListener(eventName, function () {
                            const container = input.closest('.field-container');
                            if (container && eventName === 'blur') container.classList.add('mol-touched');
                            refresh();
                        });
                    });
                });

                form.addEventListener('invalid', function (event) {
                    const container = event.target.closest && event.target.closest('.field-container');
                    if (container) {
                        container.classList.add('mol-touched','mol-invalid');
                        if (status) status.textContent = 'Vérifiez les champs signalés avant l’enregistrement.';
                    }
                    refresh();
                }, true);

                refresh();
            }

            /** Sur Android/WebView, accepte le sélecteur générique puis vérifie le type côté client et serveur. */
            function initializeCvPickerFallback() {
                const cv = document.getElementById('cvInput') || document.querySelector('input[type="file"][name$="[cvFile]"]');
                if (!cv || cv.dataset.cvFallbackBound === '1') return;
                cv.dataset.cvFallbackBound = '1';
                cv.setAttribute('accept', '*/*');
                cv.addEventListener('change', function () {
                    const file = cv.files && cv.files[0];
                    if (!file) return;
                    const ok = /\.(pdf|doc|docx)$/i.test(file.name || '');
                    cv.setCustomValidity(ok ? '' : 'Sélectionnez un CV PDF, DOC ou DOCX.');
                    if (!ok) {
                        cv.reportValidity();
                        cv.value = '';
                    }
                });
            }

            /** Initialise les améliorations mobiles une fois les scripts différés exécutés. */
            function initializeProfileEnhancements() {
                stabilizeCountrySelection();
                initializeProfilePhotoPicker();
                initializeSkillsDropdownBehavior();
                initializeProfileSaveFeedback();
                initializeProfileValidationUX();
                initializeCvPickerFallback();
                window.setTimeout(stabilizeCountrySelection, 150);
                window.setTimeout(initializeSkillsDropdownBehavior, 180);
            }

            document.addEventListener('DOMContentLoaded', initializeProfileEnhancements);
            document.addEventListener('turbo:load', initializeProfileEnhancements);
        }());
    </script>
{% endblock %}
