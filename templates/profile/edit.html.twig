                                        </div>
                                    </div>
                                {% endif %}

                                {# ========== PHOTO DE PROFIL ========== #}
                                <div class="mb-4">
                                    <div class="section-title"><span class="dot"></span> {% trans %}Photo de profil{% endtrans %}</div>

                                    <div class="field-container" data-required="{{ photoRequired ? 'true' : 'false' }}">
