    border: 1px solid rgba(0,0,0,.08);
    background: #0b5ed7;
    color: #fff;
    font-weight: 800;
    border-radius: 999px;
    padding: 8px 12px;
    font-size: 12px;
    text-decoration:none;
    box-shadow: 0 14px 30px rgba(13,110,253,.18);
    white-space:nowrap;
  }
  .pay-btn:hover{ filter: brightness(.98); color:#fff; }
