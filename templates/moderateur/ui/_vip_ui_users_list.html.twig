

<style>
  :root{
    --bg0:#F7F9FF; --bg1:#EEF2FF;
    --card:rgba(255,255,255,.82); --card2:rgba(255,255,255,.96);
    --line:rgba(15,23,42,.10);
    --text:rgba(15,23,42,.92);
    --muted:rgba(15,23,42,.62);
    --shadow:0 18px 55px rgba(15,23,42,.12);
    --r:24px;
  }
  .page{
    min-height: calc(100vh - 80px);
    width: 100vw;
    position: relative; left: 50%; right: 50%;
    margin-left: -50vw; margin-right: -50vw;
    overflow-x: clip;
    background:
      radial-gradient(900px circle at 12% 10%, rgba(56,189,248,.18), transparent 55%),
      radial-gradient(900px circle at 90% 15%, rgba(34,197,94,.14), transparent 55%),
      radial-gradient(1200px circle at 40% 110%, rgba(168,85,247,.12), transparent 52%),
      linear-gradient(180deg, var(--bg0), var(--bg1));
    padding: 12px 14px 56px;
    color: var(--text);
  }

  .card{
    background: linear-gradient(180deg, var(--card2), var(--card));
    border: 1px solid var(--line);
    border-radius: var(--r);
    box-shadow: var(--shadow);
    overflow: hidden;
    backdrop-filter: blur(10px);
  }

  .hd{
    padding: 14px 16px;
    border-bottom: 1px solid rgba(15,23,42,.08);
    background: linear-gradient(180deg, rgba(255,255,255,.90), rgba(255,255,255,.72));
    display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap; align-items:flex-start;
  }
  .bd{ padding: 16px; }

  .h1{ font-weight:950; letter-spacing:-.02em; margin:0; font-size:18px; }
  .hint{ font-size:12px; color: var(--muted); margin-top:4px; }

  .tabs{ display:flex; gap:8px; flex-wrap:wrap; }
  .tab{
    display:inline-flex; align-items:center; gap:8px;
    padding:10px 12px; border-radius:14px;
    border:1px solid rgba(15,23,42,.12);
    background:#fff; font-weight:900; text-decoration:none; color:#0f172a;
  }
  .tab.active{ border-color: rgba(56,189,248,.45); background: linear-gradient(180deg, rgba(56,189,248,.18), rgba(255,255,255,.92)); }

  .filters{ display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-left:auto; }
  .input,.select{
    background:#fff;
    border:1px solid rgba(15,23,42,.14);
    border-radius:14px;
    padding:10px 12px;
    font-weight:900;
  }
  .btn{
    display:inline-flex; align-items:center; gap:8px;
    padding:10px 12px; border-radius:14px;
    border:1px solid rgba(15,23,42,.12);
    background:#fff; font-weight:900; text-decoration:none; color:#0f172a; cursor:pointer;
    transition: transform .12s ease, background .12s ease, border-color .12s ease;
  }
  .btn:hover{ transform: translateY(-1px); background:#fff; border-color: rgba(15,23,42,.22); }
  .btn.primary{ border-color: rgba(56,189,248,.45); background: linear-gradient(180deg, rgba(56,189,248,.18), rgba(255,255,255,.92)); }

  .chip{
    display:inline-flex; gap:6px; align-items:center;
    padding:6px 10px; border-radius:999px;
    border:1px solid rgba(15,23,42,.12);
    background: rgba(255,255,255,.88);
    font-weight:950; font-size:12px;
  }
  .muted{ color: var(--muted); }

  /* Table desktop */
  .table-responsive{ overflow-x:auto; -webkit-overflow-scrolling:touch; margin-top:12px; }
  table{ width:100%; border-collapse:collapse; min-width: 1100px; }
  th{
    font-size:12px; color: rgba(15,23,42,.72); font-weight:950;
    padding:10px 12px; background: rgba(15,23,42,.03);
    border-bottom:1px solid rgba(15,23,42,.10); text-align:left;
  }
  td{ padding:10px 12px; border-bottom:1px solid rgba(15,23,42,.08); vertical-align:middle; }
  tr:hover td{ background: rgba(15,23,42,.02); }
  .avatar{ width:34px; height:34px; border-radius:999px; object-fit:cover; border:1px solid rgba(15,23,42,.12); background:#fff; }

  .pager{ display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end; margin-top:12px; }

  /* Cards mobile */
  .cards{ display:none; margin-top:12px; gap:10px; }
  .ucard{
    border:1px solid rgba(15,23,42,.10);
    background: rgba(255,255,255,.86);
    border-radius:18px;
    padding:12px;
  }
  .ucard-top{ display:flex; gap:10px; align-items:center; }
  .ucard-actions{ display:flex; gap:8px; flex-wrap:wrap; margin-top:10px; }

  @media (max-width: 820px){
    .table-responsive{ display:none; }
    .cards{ display:grid; }
  }

  /* menu ⋮ */
  .opts{ position:relative; display:inline-flex; gap:8px; align-items:center; justify-content:flex-end; }
  .menu{
    position:absolute; right:0; top: calc(100% + 8px);
    min-width: 260px;
    background: rgba(255,255,255,.98);
    border:1px solid rgba(15,23,42,.12);
    border-radius: 16px;
    box-shadow: 0 18px 55px rgba(15,23,42,.14);
    padding: 6px;
    display:none;
    z-index: 40;
  }
  .menu.open{ display:block; }
  .menu-item{
    width:100%;
    display:flex; justify-content:space-between; align-items:center;
    gap:10px;
    padding:10px 10px;
    border-radius: 12px;
    border: 0;
    background: transparent;
    cursor:pointer;
    text-decoration:none;
    color:#0f172a;
    font-weight:900;
  }
  .menu-item:hover{ background: rgba(15,23,42,.04); }
  .menu-item[disabled]{ opacity:.55; cursor:not-allowed; }
  .menu-sep{ height:1px; background: rgba(15,23,42,.08); margin:6px 6px; }
</style>