
<style>
  :root{
    --bg0:#F7F9FF; --bg1:#EEF2FF;
    --card:rgba(255,255,255,.82); --card2:rgba(255,255,255,.96);
    --line:rgba(15,23,42,.10);
    --text:rgba(15,23,42,.92);
    --muted:rgba(15,23,42,.62);
    --shadow:0 18px 55px rgba(15,23,42,.12);
    --r:24px;
  }
  .page{
    min-height: calc(100vh - 80px);
    width: 100vw; position: relative; left:50%; right:50%;
    margin-left:-50vw; margin-right:-50vw; overflow-x:clip;
    background:
      radial-gradient(900px circle at 12% 10%, rgba(56,189,248,.18), transparent 55%),
      radial-gradient(900px circle at 90% 15%, rgba(34,197,94,.14), transparent 55%),
      radial-gradient(1200px circle at 40% 110%, rgba(168,85,247,.12), transparent 52%),
      linear-gradient(180deg, var(--bg0), var(--bg1));
    padding: 12px 14px 56px;
    color: var(--text);
  }
  .card{ background:linear-gradient(180deg,var(--card2),var(--card)); border:1px solid var(--line); border-radius:var(--r); box-shadow:var(--shadow); overflow:hidden; backdrop-filter: blur(10px); }
  .hd{ padding:14px 16px; border-bottom:1px solid rgba(15,23,42,.08); background:linear-gradient(180deg, rgba(255,255,255,.90), rgba(255,255,255,.72)); display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap; align-items:flex-start; }
  .bd{ padding:16px; }
  .h1{ font-weight:950; font-size:18px; margin:0; letter-spacing:-.02em; }
  .hint{ font-size:12px; color: var(--muted); margin-top:4px; }
  .btn{ display:inline-flex; align-items:center; gap:8px; padding:10px 12px; border-radius:14px; border:1px solid rgba(15,23,42,.12); background:rgba(255,255,255,.90); font-weight:900; color:#0f172a; text-decoration:none; cursor:pointer; }
  .btn.primary{ border-color: rgba(56,189,248,.45); background: linear-gradient(180deg, rgba(56,189,248,.18), rgba(255,255,255,.90)); }
  .input,.select{ background:rgba(255,255,255,.92); border:1px solid rgba(15,23,42,.14); border-radius:14px; padding:10px 12px; font-weight:900; }
  .filters{ display:flex; gap:10px; flex-wrap:wrap; align-items:center; }

  .kpis{ display:grid; grid-template-columns: repeat(12, minmax(0,1fr)); gap:12px; margin-top: 10px; }
  .kpi{ grid-column: span 3; padding: 12px; border-radius: 18px; border:1px solid rgba(15,23,42,.10); background: rgba(255,255,255,.86); }
  .kpi .t{ font-size:12px; color: var(--muted); font-weight:950; }
  .kpi .v{ margin-top:6px; font-size:22px; font-weight:950; }
  @media(max-width:1100px){ .kpi{ grid-column: span 6; } }
  @media(max-width:640px){ .kpi{ grid-column: 1/-1; } }

  .table-responsive{ overflow-x:auto; -webkit-overflow-scrolling:touch; margin-top: 12px; }
  table{ width:100%; border-collapse:collapse; min-width: 980px; }
  th{ font-size:12px; color: rgba(15,23,42,.72); font-weight:950; padding:10px 12px; background: rgba(15,23,42,.03); border-bottom:1px solid rgba(15,23,42,.10); }
  td{ padding:10px 12px; border-bottom:1px solid rgba(15,23,42,.08); vertical-align: middle; }
  tr:hover td{ background: rgba(15,23,42,.02); }

  .chip{ display:inline-flex; align-items:center; gap:6px; padding:6px 10px; border-radius:999px; border:1px solid rgba(15,23,42,.12); background: rgba(255,255,255,.88); font-weight:950; font-size:12px; }
  .sev-info{ background: rgba(56,189,248,.12); border-color: rgba(56,189,248,.22); }
  .sev-warn{ background: rgba(245,158,11,.12); border-color: rgba(245,158,11,.22); }
  .sev-critical{ background: rgba(239,68,68,.12); border-color: rgba(239,68,68,.22); }

  .toggle{ display:inline-flex; align-items:center; gap:8px; }
  .switch{ width: 44px; height: 26px; border-radius: 999px; border: 1px solid rgba(15,23,42,.14); background: rgba(15,23,42,.08); position: relative; cursor:pointer; }
  .dot{ width: 22px; height: 22px; border-radius: 999px; background: #fff; border: 1px solid rgba(15,23,42,.12); position: absolute; top: 1px; left: 1px; transition: left .12s ease; }
  .switch.on{ background: rgba(34,197,94,.18); border-color: rgba(34,197,94,.30); }
  .switch.on .dot{ left: 21px; }

  .pager{ display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end; margin-top:12px; }
</style>