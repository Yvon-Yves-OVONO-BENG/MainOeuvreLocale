{# templates/moderateur/ui/_vip_ui_risk.html.twig #}

<style>
  :root{
    --bg0:#F7F9FF;
    --bg1:#EEF2FF;
    --card:rgba(255,255,255,.82);
    --card2:rgba(255,255,255,.96);
    --line:rgba(15,23,42,.10);
    --text:rgba(15,23,42,.92);
    --muted:rgba(15,23,42,.62);
    --shadow:0 18px 55px rgba(15,23,42,.12);
    --r:24px;
    --a1:rgba(56,189,248,.30);
    --a2:rgba(34,197,94,.22);
    --a3:rgba(245,158,11,.22);
  }

  .page{
    min-height:calc(100vh - 80px);
    width:100vw;
    position:relative;
    left:50%;
    right:50%;
    margin-left:-50vw;
    margin-right:-50vw;
    overflow-x:clip;
    background:
      radial-gradient(900px circle at 12% 10%, rgba(56,189,248,.18), transparent 55%),
      radial-gradient(900px circle at 90% 15%, rgba(34,197,94,.14), transparent 55%),
      radial-gradient(1200px circle at 40% 110%, rgba(168,85,247,.12), transparent 52%),
      linear-gradient(180deg,var(--bg0),var(--bg1));
    padding:12px 14px 56px;
    color:var(--text);
  }

  .card{
    background:linear-gradient(180deg,var(--card2),var(--card));
    border:1px solid var(--line);
    border-radius:var(--r);
    box-shadow:var(--shadow);
    overflow:hidden;
    backdrop-filter:blur(10px);
  }

  .hd{
    padding:14px 16px;
    border-bottom:1px solid rgba(15,23,42,.08);
    background:linear-gradient(180deg,rgba(255,255,255,.90),rgba(255,255,255,.72));
    display:flex;
    justify-content:space-between;
    gap:12px;
    flex-wrap:wrap;
    align-items:flex-start;
  }

  .bd{
    padding:16px;
  }

  .h1{
    font-weight:950;
    font-size:18px;
    margin:0;
    letter-spacing:-.02em;
  }

  .hint{
    font-size:12px;
    color:var(--muted);
    margin-top:4px;
  }

  .filters{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
    align-items:center;
    margin-left:auto;
  }

  .input,
  .select{
    background:#fff;
    border:1px solid rgba(15,23,42,.14);
    border-radius:14px;
    padding:10px 12px;
    font-weight:900;
  }

  .btn{
    display:inline-flex;
    gap:8px;
    align-items:center;
    padding:10px 12px;
    border-radius:14px;
    border:1px solid rgba(15,23,42,.12);
    background:#fff;
    font-weight:900;
    text-decoration:none;
    color:#0f172a;
    cursor:pointer;
  }

  .btn.primary{
    border-color:rgba(56,189,248,.45);
    background:linear-gradient(180deg,rgba(56,189,248,.18),rgba(255,255,255,.92));
  }

  .btn.danger{
    border-color:rgba(239,68,68,.35);
    background:linear-gradient(180deg,rgba(239,68,68,.12),rgba(255,255,255,.92));
  }

  .kpis{
    display:grid;
    grid-template-columns:repeat(12,minmax(0,1fr));
    gap:12px;
    margin-top:12px;
  }

  .kpi{
    grid-column:span 3;
    padding:14px;
    border-radius:22px;
    border:1px solid rgba(15,23,42,.10);
    background:rgba(255,255,255,.86);
  }

  .kpi .t{
    font-size:12px;
    color:var(--muted);
  }

  .kpi .v{
    font-size:26px;
    font-weight:950;
    margin-top:4px;
    letter-spacing:-.02em;
  }

  @media(max-width:1100px){
    .kpi{
      grid-column:span 6;
    }
  }

  @media(max-width:640px){
    .kpi{
      grid-column:1/-1;
    }
  }

  .grid{
    display:grid;
    grid-template-columns:repeat(12,minmax(0,1fr));
    gap:12px;
    margin-top:12px;
    align-items:stretch;
  }

  .col-6{
    grid-column:span 6;
  }

  .col-12{
    grid-column:1/-1;
  }

  @media(max-width:992px){
    .col-6{
      grid-column:1/-1;
    }
  }

  .chartbox{
    border:1px solid rgba(15,23,42,.10);
    border-radius:18px;
    background:rgba(255,255,255,.86);
    padding:12px;
    display:grid;
    grid-template-rows:auto 1fr;
    min-height:360px;
    overflow:hidden;
  }

  .charthead{
    display:flex;
    justify-content:space-between;
    gap:10px;
    flex-wrap:wrap;
    align-items:flex-start;
    margin-bottom:10px;
  }

  .canvaswrap{
    position:relative;
    min-height:260px;
  }

  .canvaswrap canvas{
    width:100%!important;
    height:100%!important;
    display:block;
  }

  .table-responsive{
    overflow-x:auto;
    -webkit-overflow-scrolling:touch;
    margin-top:12px;
  }

  table{
    width:100%;
    border-collapse:collapse;
    min-width:1100px;
  }

  th{
    font-size:12px;
    color:rgba(15,23,42,.72);
    font-weight:950;
    padding:10px 12px;
    background:rgba(15,23,42,.03);
    border-bottom:1px solid rgba(15,23,42,.10);
    text-align:left;
  }

  td{
    padding:10px 12px;
    border-bottom:1px solid rgba(15,23,42,.08);
    vertical-align:middle;
  }

  tr:hover td{
    background:rgba(15,23,42,.02);
  }

  .chip{
    display:inline-flex;
    gap:6px;
    align-items:center;
    padding:6px 10px;
    border-radius:999px;
    border:1px solid rgba(15,23,42,.12);
    background:rgba(255,255,255,.88);
    font-weight:950;
    font-size:12px;
  }

  .muted{
    color:var(--muted);
  }

  .avatar{
    width:34px;
    height:34px;
    border-radius:999px;
    object-fit:cover;
    border:1px solid rgba(15,23,42,.12);
    background:#fff;
  }
</style>