{# templates/moderateur/ui/_vip_ui_reports.html.twig #}

<style>
  :root{
    --m-bg0:#F7F9FF;
    --m-bg1:#EEF2FF;
    --m-card:rgba(255,255,255,.78);
    --m-card2:rgba(255,255,255,.92);
    --m-line:rgba(15,23,42,.10);
    --m-text:rgba(15,23,42,.92);
    --m-muted:rgba(15,23,42,.62);
    --m-shadow:0 18px 55px rgba(15,23,42,.12);
    --m-shadowSm:0 10px 30px rgba(15,23,42,.10);
    --m-r2:24px;
    --a1:rgba(56,189,248,.35);
    --a2:rgba(34,197,94,.35);
    --a3:rgba(245,158,11,.35);
    --a4:rgba(168,85,247,.30);
  }

  .mod-page{
    min-height:calc(100vh - 80px);
    background:
      radial-gradient(900px circle at 12% 10%, rgba(56,189,248,.18), transparent 55%),
      radial-gradient(900px circle at 90% 15%, rgba(34,197,94,.14), transparent 55%),
      radial-gradient(1200px circle at 40% 110%, rgba(168,85,247,.12), transparent 52%),
      linear-gradient(180deg,var(--m-bg0),var(--m-bg1));
    color:var(--m-text);
  }

  .wrap{
    max-width:1280px;
    margin:0 auto;
    padding:18px 12px 46px;
  }

  .card{
    background:linear-gradient(180deg,var(--m-card2),var(--m-card));
    border:1px solid var(--m-line);
    border-radius:var(--m-r2);
    box-shadow:var(--m-shadowSm);
    overflow:hidden;
    backdrop-filter:blur(10px);
  }

  .hd{
    padding:14px 16px;
    border-bottom:1px solid var(--m-line);
    background:linear-gradient(180deg,rgba(255,255,255,.90),rgba(255,255,255,.72));
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:10px;
    flex-wrap:wrap;
  }

  .bd{
    padding:16px;
  }

  .h1{
    font-weight:950;
    letter-spacing:-.02em;
    margin:0;
    font-size:18px;
  }

  .hint{
    font-size:12px;
    color:var(--m-muted);
    margin-top:4px;
  }

  .btn{
    display:inline-flex;
    align-items:center;
    gap:8px;
    border-radius:14px;
    border:1px solid rgba(15,23,42,.12);
    background:rgba(255,255,255,.86);
    color:rgba(15,23,42,.92);
    padding:10px 12px;
    font-weight:900;
    text-decoration:none;
    box-shadow:0 10px 25px rgba(15,23,42,.10);
    transition:transform .12s ease, background .12s ease, border-color .12s ease;
    cursor:pointer;
  }

  .btn:hover{
    transform:translateY(-1px);
    background:rgba(255,255,255,.95);
    border-color:rgba(15,23,42,.18);
  }

  .btn.warn{
    border-color:rgba(245,158,11,.45);
    background:linear-gradient(180deg,rgba(245,158,11,.16),rgba(255,255,255,.86));
  }

  .btn.primary{
    border-color:rgba(56,189,248,.45);
    background:linear-gradient(180deg,rgba(56,189,248,.18),rgba(255,255,255,.86));
  }

  .kpis{
    display:grid;
    grid-template-columns:repeat(12,minmax(0,1fr));
    gap:12px;
  }

  .kpi{
    grid-column:span 3;
    padding:14px;
    border-radius:22px;
    border:1px solid rgba(15,23,42,.10);
    background:rgba(255,255,255,.84);
  }

  .kpi .t{
    font-size:12px;
    color:var(--m-muted);
  }

  .kpi .v{
    font-size:26px;
    font-weight:950;
    margin-top:4px;
    letter-spacing:-.02em;
  }

  @media(max-width:1100px){
    .kpi{
      grid-column:span 6;
    }
  }

  @media(max-width:640px){
    .kpi{
      grid-column:1/-1;
    }
  }

  .filters{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
    align-items:center;
  }

  .input,
  .select{
    background:rgba(255,255,255,.92);
    border:1px solid rgba(15,23,42,.14);
    border-radius:14px;
    padding:10px 12px;
    font-weight:700;
    color:rgba(15,23,42,.92);
  }

  .grid{
    display:grid;
    grid-template-columns:repeat(12,minmax(0,1fr));
    gap:12px;
    margin-top:12px;
  }

  .col-6{
    grid-column:span 6;
  }

  .col-4{
    grid-column:span 4;
  }

  .col-8{
    grid-column:span 8;
  }

  .col-12{
    grid-column:1/-1;
  }

  @media(max-width:992px){
    .col-6,
    .col-4,
    .col-8{
      grid-column:1/-1;
    }
  }

  .chartbox{
    padding:12px;
    border-radius:18px;
    border:1px solid rgba(15,23,42,.10);
    background:rgba(255,255,255,.84);
  }

  canvas{
    width:100% !important;
    height:260px !important;
  }

  .table{
    width:100%;
    border-collapse:collapse;
  }

  .table th{
    font-size:12px;
    color:rgba(15,23,42,.72);
    font-weight:950;
    padding:10px 12px;
    border-bottom:1px solid rgba(15,23,42,.10);
    background:rgba(15,23,42,.03);
    text-align:left;
  }

  .table td{
    padding:10px 12px;
    border-bottom:1px solid rgba(15,23,42,.08);
    vertical-align:middle;
  }

  .table tr:hover td{
    background:rgba(15,23,42,.02);
  }

  .chip{
    display:inline-flex;
    align-items:center;
    gap:6px;
    font-size:12px;
    font-weight:950;
    padding:6px 10px;
    border-radius:999px;
    border:1px solid rgba(15,23,42,.12);
    background:rgba(255,255,255,.86);
  }

  .chip.open{
    background:rgba(245,158,11,.14);
    border-color:rgba(245,158,11,.28);
  }

  .chip.resolved{
    background:rgba(34,197,94,.12);
    border-color:rgba(34,197,94,.26);
  }

  .chip.canceled{
    background:rgba(148,163,184,.22);
    border-color:rgba(148,163,184,.35);
  }

  .pager{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
    justify-content:flex-end;
  }

  .muted{
    color:var(--m-muted);
  }

  /* ===========================
     ✅ HOTFIX FINAL : charts visibles + pas de jump au hover
     =========================== */

  .grid > .col-6,
  .grid > .col-4,
  .grid > .col-8,
  .grid > .col-12{
    width:auto !important;
    max-width:none !important;
    flex:none !important;
    padding-left:0 !important;
    padding-right:0 !important;
    min-width:0;
  }

  .grid{
    align-items:stretch;
  }

  .grid .chartbox{
    height:380px;
    display:flex;
    flex-direction:column;
    overflow:hidden;
    position:relative;
  }

  .grid .chartbox > div{
    flex:0 0 auto;
  }

  .grid .chartbox > canvas{
    flex:1 1 0;
    height:0 !important;
    min-height:260px;
    width:100% !important;
    display:block;
  }
</style>