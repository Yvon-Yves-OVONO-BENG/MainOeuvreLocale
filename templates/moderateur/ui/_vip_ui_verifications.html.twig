  /* ===== Actions notify (VIP) ===== */
  .menu-item.js-notify{
    width: 100%;
    border: 1px solid rgba(15,23,42,.12);
    background: rgba(255,255,255,.92);
    border-radius: 14px;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-weight: 950;
    font-size: 13px;
    color: rgba(15,23,42,.92);
    cursor: pointer;
    transition: transform .12s ease, background .12s ease, border-color .12s ease, box-shadow .12s ease;
    text-align: left;
  }

  /* Effet hover premium */
  .menu-item.js-notify:hover{
    transform: translateY(-1px);
    background: rgba(255,255,255,.98);
    border-color: rgba(15,23,42,.18);
    box-shadow: 0 14px 35px rgba(15,23,42,.10);
  }

  /* Focus clavier */
  .menu-item.js-notify:focus{
    outline: none;
    box-shadow: 0 0 0 4px rgba(56,189,248,.22);
    border-color: rgba(56,189,248,.35);
  }

  /* Désactivé */
  .menu-item.js-notify[disabled]{
    opacity: .55;
    cursor: not-allowed;
    transform: none !important;
    box-shadow: none !important;
  }

  /* Partie gauche : icône + texte */
  .notify-left{
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .notify-ico{
    width: 28px;
    height: 28px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(15,23,42,.12);
    background: rgba(255,255,255,.86);
    flex: 0 0 auto;
    font-size: 13px;
  }
  .notify-text{
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    min-width: 0;
  }
  .notify-title{
    font-weight: 950;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .notify-sub{
    margin-top: 2px;
    font-size: 12px;
    color: rgba(15,23,42,.62);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Partie droite : chevron */
  .notify-arrow{
    width: 28px;
    height: 28px;
    border-radius: 12px;
    border: 1px solid rgba(15,23,42,.10);
    background: rgba(15,23,42,.03);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(15,23,42,.75);
    flex: 0 0 auto;
  }

  /* ===== Variantes par type ===== */
  .menu-item.js-notify[data-kind="email"]{
    background: linear-gradient(180deg, rgba(56,189,248,.14), rgba(255,255,255,.92));
    border-color: rgba(56,189,248,.22);
  }
  .menu-item.js-notify[data-kind="sms"]{
    background: linear-gradient(180deg, rgba(245,158,11,.12), rgba(255,255,255,.92));
    border-color: rgba(245,158,11,.22);
  }
  .menu-item.js-notify[data-kind="whatsapp"]{
    background: linear-gradient(180deg, rgba(34,197,94,.12), rgba(255,255,255,.92));
    border-color: rgba(34,197,94,.22);
  }

  /* WhatsApp ico align */
  .menu-item.js-notify .wa-ico{
    width: 18px;
    height: 18px;
    border-radius: 6px;
  }

  /* ===== Notify premium ===== */
  .notify-btn{
    width: 100%;
    border: 1px solid rgba(15,23,42,.12);
    background: linear-gradient(180deg, rgba(56,189,248,.14), rgba(255,255,255,.92));
    border-radius: 14px;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-weight: 950;
    font-size: 13px;
    color: rgba(15,23,42,.92);
    cursor: pointer;
    transition: transform .12s ease, background .12s ease, border-color .12s ease, box-shadow .12s ease;
    text-align: left;
  }
  .notify-btn:hover{
    transform: translateY(-1px);
    background: linear-gradient(180deg, rgba(56,189,248,.18), rgba(255,255,255,.98));
    border-color: rgba(56,189,248,.30);
    box-shadow: 0 14px 35px rgba(15,23,42,.10);
  }
  .notify-btn:focus{
    outline: none;
    box-shadow: 0 0 0 4px rgba(56,189,248,.22);
    border-color: rgba(56,189,248,.35);
  }

  .notify-left{ display:flex; align-items:center; gap:10px; min-width:0; }
  .notify-text{ display:flex; flex-direction:column; min-width:0; line-height:1.1; }
  .notify-title{ font-weight: 950; white-space: nowrap; overflow:hidden; text-overflow: ellipsis; }
  .notify-sub{ margin-top:2px; font-size:12px; color: rgba(15,23,42,.62); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }

  .notify-ico{
    width: 30px; height: 30px;
    border-radius: 12px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    border: 1px solid rgba(15,23,42,.12);
    background: rgba(255,255,255,.86);
    flex: 0 0 auto;
    font-size: 14px;
  }

  .notify-right{ display:flex; align-items:center; gap:10px; }
  .notify-arrow{
    width: 30px; height: 30px;
    border-radius: 12px;
    border: 1px solid rgba(15,23,42,.10);
    background: rgba(15,23,42,.03);
    display:inline-flex;
    align-items:center;
    justify-content:center;
    color: rgba(15,23,42,.75);
    font-size: 18px;
  }

  /* Spinner (masqué par défaut) */
  .notify-spinner{
    width: 18px; height: 18px;
    border-radius: 999px;
    border: 2px solid rgba(15,23,42,.18);
    border-top-color: rgba(56,189,248,.95);
    display: none;
    animation: spin .7s linear infinite;
  }
  @keyframes spin{ to{ transform: rotate(360deg);} }

  /* États AJAX */
  .notify-btn.is-loading{
    cursor: progress;
    transform: none !important;
    box-shadow: none !important;
    opacity: .92;
  }
  .notify-btn.is-loading .notify-spinner{ display:inline-block; }
  .notify-btn.is-loading .notify-arrow{ display:none; }

  .notify-btn.is-success{
    border-color: rgba(34,197,94,.35) !important;
    background: linear-gradient(180deg, rgba(34,197,94,.14), rgba(255,255,255,.92)) !important;
  }
  .notify-btn.is-error{
    border-color: rgba(239,68,68,.35) !important;
    background: linear-gradient(180deg, rgba(239,68,68,.12), rgba(255,255,255,.92)) !important;
  }

  /* disabled */
  .notify-btn[disabled], .notify-btn:disabled{
    opacity: .55;
    cursor: not-allowed;
  }

  .icon-action {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 38px;
    border-radius: 10px;
}

.icon-action[data-tooltip]::after {
    content: attr(data-tooltip);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 10px);
    transform: translateX(-50%) translateY(6px);
    background: #0f172a;
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    padding: 8px 10px;
    border-radius: 8px;
    box-shadow: 0 10px 25px rgba(15, 23, 42, .18);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 50;
    transition: opacity .18s ease, transform .18s ease, visibility .18s ease;
}

.icon-action[data-tooltip]::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: calc(100% + 4px);
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-top-color: #0f172a;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 51;
    transition: opacity .18s ease, visibility .18s ease;
}

.icon-action:hover::after,
.icon-action:focus-visible::after {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
}

.icon-action:hover::before,
.icon-action:focus-visible::before {
    opacity: 1;
    visibility: visible;
}

.icon-action i {
    font-size: 15px;
}

.verif-table {
    width: 100%;
    max-width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
}

/* Largeurs propres des colonnes */
.verif-table th:nth-child(1),
.verif-table td:nth-child(1) {
    width: 24%;
}

.verif-table th:nth-child(2),
.verif-table td:nth-child(2) {
    width: 11%;
}

.verif-table th:nth-child(3),
.verif-table td:nth-child(3) {
    width: 15%;
}

.verif-table th:nth-child(4),
.verif-table td:nth-child(4) {
    width: 14%;
}

.verif-table th:nth-child(5),
.verif-table td:nth-child(5) {
    width: 14%;
}

.verif-table th:nth-child(6),
.verif-table td:nth-child(6) {
    width: 10%;
}

.verif-table th:nth-child(7),
.verif-table td:nth-child(7) {
    width: 12%;
}

/* Empêche le tableau de forcer un scroll horizontal */
.verif-table th,
.verif-table td {
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: normal;
    vertical-align: middle;
}

/* Bloc utilisateur */
.verif-table .user {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
}

.verif-table .user > div {
    min-width: 0;
}

.verif-table .u1,
.verif-table .u2,
.verif-table .muted {
    max-width: 100%;
    white-space: normal;
    overflow-wrap: anywhere;
}

/* Badges */
.verif-table .chip {
    max-width: 100%;
    white-space: normal;
    line-height: 1.25;
}

/* Options : les boutons passent à la ligne au lieu de créer un scroll */
.verif-table .opts {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    min-width: 0;
}

.verif-table .opts form {
    margin: 0;
    display: inline-flex;
}

/* Les boutons icônes restent propres */
.verif-table .icon-action {
    flex: 0 0 auto;
}

/* Menu actions : ne dépasse pas l'écran */
