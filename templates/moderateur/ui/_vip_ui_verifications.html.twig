
<style>
  :root{
    --bg0:#F7F9FF; --bg1:#EEF2FF;
    --card:rgba(255,255,255,.80); --card2:rgba(255,255,255,.95);
    --line:rgba(15,23,42,.10);
    --text:rgba(15,23,42,.92);
    --muted:rgba(15,23,42,.62);
    --shadow:0 18px 55px rgba(15,23,42,.12);
    --r:24px;
  }
  .page{
    min-height: calc(100vh - 80px);
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    overflow-x: clip;
    background:
      radial-gradient(900px circle at 12% 10%, rgba(56,189,248,.18), transparent 55%),
      radial-gradient(900px circle at 90% 15%, rgba(34,197,94,.14), transparent 55%),
      radial-gradient(1200px circle at 40% 110%, rgba(168,85,247,.12), transparent 52%),
      linear-gradient(180deg, var(--bg0), var(--bg1));
    color: var(--text);
    padding: 18px 16px 56px;
  }
  @media(max-width:640px){ .page{ padding: 14px 10px 46px; } }

  .wrap{ max-width: 1400px; margin: 0 auto; }
  .card{
    background: linear-gradient(180deg, var(--card2), var(--card));
    border: 1px solid var(--line);
    border-radius: var(--r);
    box-shadow: var(--shadow);
    overflow: hidden;
    backdrop-filter: blur(10px);
  }
  .hd{
    padding: 14px 16px;
    border-bottom: 1px solid rgba(15,23,42,.08);
    background: linear-gradient(180deg, rgba(255,255,255,.90), rgba(255,255,255,.72));
    display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap; align-items:flex-start;
  }
  .bd{ padding: 16px; }

  .h1{ font-size:18px; font-weight: 700; letter-spacing:-.02em; margin:0; }
  .hint{ font-size:12px; color: var(--muted); margin-top:4px; }

  .btn{
    display:inline-flex; align-items:center; gap:8px;
    padding:10px 12px; border-radius:14px;
    border:1px solid rgba(15,23,42,.12);
    background: rgba(255,255,255,.90);
    font-weight:400; color:#0f172a; text-decoration:none; cursor:pointer;
    transition: transform .12s ease, background .12s ease, border-color .12s ease;
    white-space: nowrap;
  }
  .btn:hover{ transform: translateY(-1px); background:#fff; border-color: rgba(15,23,42,.22); }
  .btn.primary{ border-color: rgba(56,189,248,.45); background: linear-gradient(180deg, rgba(56,189,248,.18), rgba(255,255,255,.90)); }
  .btn.warn{ border-color: rgba(245,158,11,.45); background: linear-gradient(180deg, rgba(245,158,11,.16), rgba(255,255,255,.90)); }
  .btn.danger{ border-color: rgba(239,68,68,.45); background: linear-gradient(180deg, rgba(239,68,68,.14), rgba(255,255,255,.90)); }

  .filters{ display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
  .input,.select{
    background: rgba(255,255,255,.92);
    border:1px solid rgba(15,23,42,.14);
    border-radius:14px;
    padding:10px 12px;
    /*font-weight:800;*/
    color: rgba(15,23,42,.92);
  }

  .kpis{ display:grid; grid-template-columns: repeat(12, minmax(0,1fr)); gap:12px; margin-top: 10px; }
  .kpi{ grid-column: span 4; padding: 12px; border-radius: 18px; border:1px solid rgba(15,23,42,.10); background: rgba(255,255,255,.86); }
  .kpi .t{ font-size:12px; color: var(--muted); font-weight:900; }
  .kpi .v{ margin-top:6px; font-weight:950; font-size:14px; display:flex; gap:8px; flex-wrap:wrap; }
  .chip{ display:inline-flex; gap:6px; align-items:center; padding: 6px 10px; border-radius: 999px; border:1px solid rgba(15,23,42,.12); background: rgba(255,255,255,.88); font-weight:950; font-size:12px; }
  .chip.p{ border-color: rgba(245,158,11,.30); background: rgba(245,158,11,.14); }
  .chip.v{ border-color: rgba(34,197,94,.26); background: rgba(34,197,94,.12); }
  .chip.r{ border-color: rgba(239,68,68,.26); background: rgba(239,68,68,.12); }

  @media(max-width: 992px){ .kpi{ grid-column: 1/-1; } }

  .table-responsive{ width:100%; overflow-x:auto; -webkit-overflow-scrolling: touch; margin-top: 12px; }
  table{ width:100%; border-collapse: collapse; min-width: 1050px; }
  th{
    text-align:left; font-size:12px; color: rgba(15,23,42,.72);
    font-weight:950; padding: 10px 12px; background: rgba(15,23,42,.03);
    border-bottom: 1px solid rgba(15,23,42,.10); white-space: nowrap;
  }
  td{
    padding: 10px 12px; border-bottom: 1px solid rgba(15,23,42,.08); vertical-align: middle;
  }
  tr:hover td{ background: rgba(15,23,42,.02); }

  .user{
    display:flex; align-items:center; gap:10px; min-width: 260px;
  }
  .avatar{
    width: 34px; height: 34px; border-radius: 999px; object-fit: cover;
    border:1px solid rgba(15,23,42,.12); background: rgba(255,255,255,.9);
    flex: 0 0 auto;
  }
  .u1{ font-weight:950; }
  .u2{ font-size:12px; color: var(--muted); margin-top:2px; }

  .opts{ display:flex; gap:8px; justify-content:flex-end; flex-wrap:wrap; }

  .pager{ display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end; margin-top: 12px; }

  /* ===== menu ⋮ ===== */
  .opts{ display:flex; gap:8px; justify-content:flex-end; align-items:center; flex-wrap:wrap; }
  .menu{
    position:absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 260px;
    background: rgba(255,255,255,.96);
    border: 1px solid rgba(15,23,42,.12);
    border-radius: 16px;
    box-shadow: 0 22px 70px rgba(15,23,42,.14);
    padding: 8px;
    display:none;
    z-index: 50;
    backdrop-filter: blur(10px);
  }
  .menu.open{ display:block; }
  .menu-item{
    display:flex;
    align-items:center;
    gap:10px;
    padding: 10px 10px;
    border-radius: 12px;
    text-decoration:none;
    color: rgba(15,23,42,.92);
    font-weight: 900;
    font-size: 13px;
  }
  .menu-item:hover{ background: rgba(15,23,42,.05); }
  .menu-item.disabled{ opacity:.55; cursor:not-allowed; pointer-events:none; }
  .menu-sep{ height:1px; background: rgba(15,23,42,.10); margin: 6px 6px; }
  .menu-note{ padding: 8px 10px; font-size: 12px; color: rgba(15,23,42,.65); }

  /* ✅ Icône WhatsApp (SVG inline via background) */
