  /* ===== Toast ===== */
  .toast-wrap{
    position: fixed;
    right: 14px;
    top: 14px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .toast{
    background: rgba(255,255,255,.95);
    border: 1px solid rgba(15,23,42,.12);
    border-radius: 14px;
    box-shadow: 0 18px 55px rgba(15,23,42,.14);
    padding: 10px 12px;
    min-width: 260px;
    display: flex;
    gap: 10px;
    align-items: flex-start;
    backdrop-filter: blur(10px);
  }
  .toast .t-ico{
    width: 26px; height: 26px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(15,23,42,.12);
    background: rgba(255,255,255,.9);
    flex: 0 0 auto;
    font-size: 13px;
  }
  .toast .t-msg{ font-weight: 900; color: rgba(15,23,42,.92); font-size: 13px; }
  .toast .t-sub{ margin-top: 2px; font-size: 12px; color: rgba(15,23,42,.62); }

  .toast.ok  .t-ico{ background: rgba(34,197,94,.14); border-color: rgba(34,197,94,.28); }
  .toast.err .t-ico{ background: rgba(239,68,68,.14); border-color: rgba(239,68,68,.28); }
  .toast.warn .t-ico{ background: rgba(245,158,11,.14); border-color: rgba(245,158,11,.28); }

  /* ===== menu-item disabled (button) ===== */
  .menu-item[disabled]{
    opacity: .55;
    cursor: not-allowed;
  }

  /* ✅ Icône WhatsApp (SVG inline via background) */
