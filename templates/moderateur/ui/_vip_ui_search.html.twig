

<style>
  :root{
    /* ===== Premium SaaS (Light / Glass) ===== */
    --bg0:#F7F9FF;
    --bg1:#EEF2FF;

    --card: rgba(255,255,255,.78);
    --card2: rgba(255,255,255,.92);
    --line: rgba(15,23,42,.10);

    --text: rgba(15,23,42,.92);
    --muted: rgba(15,23,42,.62);

    --shadow: 0 22px 70px rgba(15,23,42,.10);
    --shadowSm: 0 12px 35px rgba(15,23,42,.08);

    --r: 18px;
    --r2: 26px;

    --primary:#4F46E5;
    --primary2:#7C3AED;

    --ok:#10B981;
    --warn:#F59E0B;
    --danger:#EF4444;
  }

  /* Page */
  .mod-page{
    min-height: calc(100vh - 80px);
    background:
      radial-gradient(900px 450px at 15% 0%, rgba(79,70,229,.16), transparent 60%),
      radial-gradient(900px 450px at 85% 10%, rgba(16,185,129,.14), transparent 55%),
      linear-gradient(180deg, var(--bg0), #fff 45%, var(--bg1));
  }
  .mod-wrap{ max-width: 1180px; margin: 0 auto; padding: 22px 14px 36px; }

  /* Cards / UI kit */
  .mod-card{
    border: 1px solid var(--line);
    background: var(--card);
    border-radius: var(--r2);
    box-shadow: var(--shadow);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    overflow: hidden;
  }
  .mod-card .hd{
    display:flex; align-items:center; justify-content:space-between; gap:12px;
    padding: 16px 18px;
    background: linear-gradient(90deg, rgba(255,255,255,.75), rgba(255,255,255,.92));
    border-bottom: 1px solid rgba(15,23,42,.08);
  }
  .mod-card .bd{ padding: 18px; }
  .mod-title{ font-weight: 900; color: var(--text); letter-spacing: -.2px; }
  .hint{ font-size: 12px; color: var(--muted); }

  .mod-btn{
    display:inline-flex; align-items:center; justify-content:center; gap:8px;
    padding: 10px 12px;
    border-radius: 14px;
    border: 1px solid rgba(15,23,42,.12);
    background: rgba(255,255,255,.88);
    color: rgba(15,23,42,.92);
    font-weight: 800;
    text-decoration:none;
    transition: transform .12s ease, box-shadow .12s ease, background .12s ease, border-color .12s ease;
    box-shadow: 0 10px 25px rgba(15,23,42,.06);
  }
  .mod-btn:hover{
    transform: translateY(-1px);
    background: rgba(255,255,255,.98);
    border-color: rgba(15,23,42,.18);
    box-shadow: 0 16px 35px rgba(15,23,42,.10);
  }
  .mod-btn-primary{
    border-color: rgba(79,70,229,.32);
    background: linear-gradient(135deg, rgba(79,70,229,.95), rgba(124,58,237,.92));
    color: #fff;
  }
  .mod-btn-primary:hover{
    border-color: rgba(79,70,229,.45);
    box-shadow: 0 18px 40px rgba(79,70,229,.22);
  }

  .mod-input{
    border-radius: 16px !important;
    border: 1px solid rgba(15,23,42,.12) !important;
    background: rgba(255,255,255,.90) !important;
    box-shadow: 0 14px 40px rgba(15,23,42,.06);
    color: var(--text) !important;
  }
  .mod-input:focus{
    border-color: rgba(79,70,229,.45) !important;
    box-shadow: 0 0 0 .25rem rgba(79,70,229,.18) !important;
  }

  /* Search hero */
  .search-hero{
    border: 1px solid rgba(15,23,42,.10);
    background: linear-gradient(135deg, rgba(255,255,255,.72), rgba(255,255,255,.92));
    border-radius: var(--r2);
    box-shadow: var(--shadowSm);
    padding: 16px;
  }
  .search-grid{
    display:grid;
    grid-template-columns: 1.6fr .9fr auto;
    gap: 12px;
    align-items:end;
  }
  @media (max-width: 992px){
    .search-grid{ grid-template-columns: 1fr; }
  }

  /* Searchbox (fix icon alignment) */
  .searchbox{ position:relative; }

  /* wrapper uniquement pour l’input => top:50% fiable */
  .inputwrap{ position:relative; }

  .inputwrap .ico{
    position:absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 36px; height: 36px;
    border-radius: 12px;
    display:grid; place-items:center;
    color: rgba(15,23,42,.58);
    background: rgba(15,23,42,.05);
    border: 1px solid rgba(15,23,42,.08);
    pointer-events:none;
    z-index: 2;              /* ✅ au-dessus */
  }

  .inputwrap input{
    position:relative;
    z-index: 1;
    padding-left: 56px !important;
    height: 52px;
    font-weight: 700;
  }

    /* Segmented scope */
    .segmented{
      display:flex; gap:8px; flex-wrap:wrap;
      padding: 8px;
      border-radius: 18px;
      border: 1px solid rgba(15,23,42,.10);
      background: rgba(255,255,255,.75);
      box-shadow: 0 14px 40px rgba(15,23,42,.06);
    }
    .segmented input{ display:none; }
    .segmented label{
      cursor:pointer;
      user-select:none;
      padding: 10px 12px;
      border-radius: 14px;
      border: 1px solid rgba(15,23,42,.10);
      background: rgba(255,255,255,.86);
      color: rgba(15,23,42,.82);
      font-weight: 900;
      font-size: 13px;
      transition: all .12s ease;
    }
    .segmented input:checked + label{
      border-color: rgba(79,70,229,.35);
      background: linear-gradient(135deg, rgba(79,70,229,.12), rgba(124,58,237,.10));
      color: rgba(15,23,42,.92);
      box-shadow: 0 16px 35px rgba(79,70,229,.12);
    }

    /* Result layout */
    .results-head{
      display:flex; align-items:center; justify-content:space-between; gap:10px;
      padding: 10px 12px;
      border-radius: 18px;
      border: 1px dashed rgba(15,23,42,.18);
      background: rgba(255,255,255,.70);
    }
    .pill{
      display:inline-flex; align-items:center; gap:8px;
      padding: 6px 10px;
      border-radius: 999px;
      border: 1px solid rgba(15,23,42,.10);
      background: rgba(255,255,255,.88);
      font-weight: 900;
      font-size: 12px;
      color: rgba(15,23,42,.80);
    }
    .pill b{ color: rgba(15,23,42,.92); }
    .badge-soft{
      display:inline-flex; align-items:center; justify-content:center;
      height: 26px; padding: 0 10px;
      border-radius: 999px;
      border: 1px solid rgba(15,23,42,.10);
      background: rgba(15,23,42,.04);
      color: rgba(15,23,42,.70);
      font-weight: 900;
      font-size: 12px;
    }

    .res-card{
      border: 1px solid rgba(15,23,42,.10);
      background: rgba(255,255,255,.80);
      border-radius: 22px;
      box-shadow: 0 16px 50px rgba(15,23,42,.08);
      overflow:hidden;
      transition: transform .12s ease, box-shadow .12s ease;
    }
    .res-card:hover{ transform: translateY(-1px); box-shadow: 0 24px 70px rgba(15,23,42,.10); }

    .res-hd{
      display:flex; align-items:flex-start; justify-content:space-between; gap:12px;
      padding: 14px 14px 12px;
      background: linear-gradient(90deg, rgba(255,255,255,.72), rgba(255,255,255,.94));
      border-bottom: 1px solid rgba(15,23,42,.08);
    }
    .res-title{ font-weight: 950; color: var(--text); }
    .res-bd{ padding: 12px 14px; }

    .res-list{ display:flex; flex-direction:column; gap:10px; }
    .res-item{
      display:flex; align-items:center; justify-content:space-between; gap:10px;
      padding: 10px 10px;
      border-radius: 18px;
      border: 1px solid rgba(15,23,42,.08);
      background: rgba(255,255,255,.86);
    }
    .res-left{ display:flex; align-items:center; gap:10px; min-width: 0; }
    .avatar{
      width: 38px; height: 38px; border-radius: 14px;
      display:grid; place-items:center;
      border: 1px solid rgba(15,23,42,.10);
      background: rgba(15,23,42,.04);
      color: rgba(15,23,42,.72);
      font-weight: 950;
      flex: 0 0 auto;
    }
    .res-meta{ min-width:0; }
    .res-meta .top{
      font-weight: 950; color: rgba(15,23,42,.92);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .res-meta .sub{
      font-size: 12px; color: var(--muted);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    .empty{
      padding: 16px;
      border-radius: 22px;
      border: 1px dashed rgba(15,23,42,.18);
      background: rgba(255,255,255,.72);
      color: rgba(15,23,42,.78);
    }

    .kbd{
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 12px;
      padding: 2px 8px;
      border-radius: 999px;
      border: 1px solid rgba(15,23,42,.12);
      background: rgba(255,255,255,.86);
      color: rgba(15,23,42,.72);
      font-weight: 900;
    }
</style>