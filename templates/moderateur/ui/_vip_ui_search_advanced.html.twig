
<style>
  :root{
    /* ===== Premium SaaS (Light / Glass) ===== */
    --bg0:#F7F9FF;
    --bg1:#EEF2FF;

    --card: rgba(255,255,255,.78);
    --card2: rgba(255,255,255,.92);
    --line: rgba(15,23,42,.10);

    --text: rgba(15,23,42,.92);
    --muted: rgba(15,23,42,.62);

    --shadow: 0 22px 70px rgba(15,23,42,.10);
    --shadowSm: 0 12px 35px rgba(15,23,42,.08);

    --r: 18px;
    --r2: 26px;

    --primary:#4F46E5;
    --primary2:#7C3AED;

    --ok:#10B981;
    --warn:#F59E0B;
    --danger:#EF4444;
  }

  /* Page */
  .mod-page{
    min-height: calc(100vh - 80px);
    background:
      radial-gradient(900px 450px at 15% 0%, rgba(79,70,229,.16), transparent 60%),
      radial-gradient(900px 450px at 85% 10%, rgba(16,185,129,.14), transparent 55%),
      linear-gradient(180deg, var(--bg0), #fff 45%, var(--bg1));
  }
  .mod-wrap{ max-width: 1100px; margin: 0 auto; padding: 22px 14px 36px; }

  /* Cards */
  .mod-card{
    border: 1px solid var(--line);
    background: var(--card);
    border-radius: var(--r2);
    box-shadow: var(--shadow);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    overflow: hidden;
  }
  .mod-card .hd{
    display:flex; align-items:center; justify-content:space-between; gap:12px;
    padding: 16px 18px;
    background: linear-gradient(90deg, rgba(255,255,255,.75), rgba(255,255,255,.92));
    border-bottom: 1px solid rgba(15,23,42,.08);
  }
  .mod-card .bd{ padding: 18px; }
  .mod-title{ font-weight: 950; color: var(--text); letter-spacing: -.2px; }
  .hint{ font-size: 12px; color: var(--muted); }

  /* Buttons */
  .mod-btn{
    display:inline-flex; align-items:center; justify-content:center; gap:8px;
    padding: 10px 12px;
    border-radius: 14px;
    border: 1px solid rgba(15,23,42,.12);
    background: rgba(255,255,255,.88);
    color: rgba(15,23,42,.92);
    font-weight: 900;
    text-decoration:none;
    transition: transform .12s ease, box-shadow .12s ease, background .12s ease, border-color .12s ease;
    box-shadow: 0 10px 25px rgba(15,23,42,.06);
  }
  .mod-btn:hover{
    transform: translateY(-1px);
    background: rgba(255,255,255,.98);
    border-color: rgba(15,23,42,.18);
    box-shadow: 0 16px 35px rgba(15,23,42,.10);
  }
  .mod-btn-primary{
    border-color: rgba(79,70,229,.32);
    background: linear-gradient(135deg, rgba(79,70,229,.95), rgba(124,58,237,.92));
    color: #fff;
  }
  .mod-btn-primary:hover{
    border-color: rgba(79,70,229,.45);
    box-shadow: 0 18px 40px rgba(79,70,229,.22);
  }

  /* Inputs */
  .mod-input{
    border-radius: 16px !important;
    border: 1px solid rgba(15,23,42,.12) !important;
    background: rgba(255,255,255,.90) !important;
    box-shadow: 0 14px 40px rgba(15,23,42,.06);
    color: var(--text) !important;
  }
  .mod-input:focus{
    border-color: rgba(79,70,229,.45) !important;
    box-shadow: 0 0 0 .25rem rgba(79,70,229,.18) !important;
  }

  /* Advanced layout */
  .adv-hero{
    border: 1px solid rgba(15,23,42,.10);
    background: linear-gradient(135deg, rgba(255,255,255,.72), rgba(255,255,255,.92));
    border-radius: var(--r2);
    box-shadow: var(--shadowSm);
    padding: 16px;
  }

  .adv-grid{
    display:grid;
    grid-template-columns: 1.35fr .85fr .85fr;
    gap: 12px;
    align-items:end;
  }
  @media (max-width: 992px){
    .adv-grid{ grid-template-columns: 1fr; }
  }

  /* Search input with icon */
  /* Search input with icon (VIP fix) */
  .searchbox{ position:relative; }

  .inputwrap{ position:relative; }

  .inputwrap .ico{
    position:absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 36px; height: 36px;
    border-radius: 12px;
    display:grid; place-items:center;
    color: rgba(15,23,42,.58);
    background: rgba(15,23,42,.05);
    border: 1px solid rgba(15,23,42,.08);
    pointer-events:none;
    z-index: 2;          /* ✅ au-dessus */
  }

  .inputwrap input{
    position:relative;
    z-index: 1;
    padding-left: 56px !important;
    height: 52px;
    font-weight: 800;
  }

    /* Chips / toggles (VIP filters UI) */
    .chips{
      display:flex; gap:8px; flex-wrap:wrap;
      padding: 8px;
      border-radius: 18px;
      border: 1px solid rgba(15,23,42,.10);
      background: rgba(255,255,255,.75);
      box-shadow: 0 14px 40px rgba(15,23,42,.06);
    }
    .chip{
      position:relative;
      display:inline-flex; align-items:center; gap:8px;
      padding: 9px 11px;
      border-radius: 999px;
      border: 1px solid rgba(15,23,42,.10);
      background: rgba(255,255,255,.86);
      color: rgba(15,23,42,.82);
      font-weight: 950;
      font-size: 12px;
      cursor:pointer;
      user-select:none;
      transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease;
    }
    .chip:hover{
      transform: translateY(-1px);
      border-color: rgba(15,23,42,.16);
      box-shadow: 0 16px 35px rgba(15,23,42,.08);
    }

    /* Footer info */
    .adv-foot{
      display:flex; align-items:flex-start; gap:10px;
      padding: 14px;
      border-radius: 22px;
      border: 1px dashed rgba(15,23,42,.18);
      background: rgba(255,255,255,.70);
    }
    .adv-foot .i{
      width: 38px; height: 38px; border-radius: 14px;
      display:grid; place-items:center;
      border: 1px solid rgba(15,23,42,.10);
      background: rgba(15,23,42,.04);
      color: rgba(15,23,42,.75);
      font-weight: 950;
      flex: 0 0 auto;
    }
</style>