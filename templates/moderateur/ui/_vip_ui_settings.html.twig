

<style>
  :root{
    /* ===== VIP SaaS Premium (Light / Glass) ===== */
    --bg0:#F7F9FF;
    --bg1:#EEF2FF;

    --card: rgba(255,255,255,.78);
    --card2: rgba(255,255,255,.92);
    --line: rgba(15,23,42,.10);

    --text: rgba(15,23,42,.92);
    --muted: rgba(15,23,42,.62);

    --shadow: 0 22px 70px rgba(15,23,42,.10);
    --shadowSm: 0 12px 35px rgba(15,23,42,.08);

    --r: 18px;
    --r2: 26px;

    --primary:#4F46E5;
    --primary2:#7C3AED;

    --ok:#10B981;
    --warn:#F59E0B;
    --danger:#EF4444;
  }

  /* Page */
  .mod-page{
    min-height: calc(100vh - 80px);
    background:
      radial-gradient(900px 450px at 15% 0%, rgba(79,70,229,.16), transparent 60%),
      radial-gradient(900px 450px at 85% 10%, rgba(16,185,129,.14), transparent 55%),
      linear-gradient(180deg, var(--bg0), #fff 45%, var(--bg1));
  }
  .mod-wrap{ max-width: 1100px; margin: 0 auto; padding: 22px 14px 36px; }

  /* Card */
  .mod-card{
    border: 1px solid var(--line);
    background: var(--card);
    border-radius: var(--r2);
    box-shadow: var(--shadow);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    overflow: hidden;
  }
  .mod-card .hd{
    display:flex; align-items:center; justify-content:space-between; gap:12px;
    padding: 16px 18px;
    background: linear-gradient(90deg, rgba(255,255,255,.75), rgba(255,255,255,.92));
    border-bottom: 1px solid rgba(15,23,42,.08);
  }
  .mod-card .bd{ padding: 18px; }

  .mod-title{
    font-weight: 950;
    color: var(--text);
    letter-spacing: -.2px;
    line-height: 1.12;
  }
  .hint{ font-size: 12px; color: var(--muted); }

  /* Buttons */
  .mod-btn{
    display:inline-flex; align-items:center; justify-content:center; gap:8px;
    padding: 10px 12px;
    border-radius: 14px;
    border: 1px solid rgba(15,23,42,.12);
    background: rgba(255,255,255,.88);
    color: rgba(15,23,42,.92);
    font-weight: 900;
    text-decoration:none;
    transition: transform .12s ease, box-shadow .12s ease, background .12s ease, border-color .12s ease;
    box-shadow: 0 10px 25px rgba(15,23,42,.06);
  }
  .mod-btn:hover{
    transform: translateY(-1px);
    background: rgba(255,255,255,.98);
    border-color: rgba(15,23,42,.18);
    box-shadow: 0 16px 35px rgba(15,23,42,.10);
  }
  .mod-btn-primary{
    border-color: rgba(79,70,229,.32);
    background: linear-gradient(135deg, rgba(79,70,229,.95), rgba(124,58,237,.92));
    color: #fff;
  }
  .mod-btn-primary:hover{
    border-color: rgba(79,70,229,.45);
    box-shadow: 0 18px 40px rgba(79,70,229,.22);
  }
  .mod-btn:disabled,
  .mod-btn[aria-disabled="true"]{ opacity:.65; pointer-events:none; }

  /* Premium sections */
  .panel-hero{
    border: 1px solid rgba(15,23,42,.10);
    background: linear-gradient(135deg, rgba(255,255,255,.70), rgba(255,255,255,.92));
    border-radius: var(--r2);
    box-shadow: var(--shadowSm);
    padding: 14px;
  }
  .meta-row{ display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; }
  .pill{
    display:inline-flex; align-items:center; gap:8px;
    padding: 7px 10px;
    border-radius: 999px;
    border: 1px solid rgba(15,23,42,.10);
    background: rgba(255,255,255,.88);
    font-weight: 950;
    font-size: 12px;
    color: rgba(15,23,42,.82);
  }
  .status-dot{
    width:10px; height:10px; border-radius:99px;
    background: rgba(15,23,42,.25);
    box-shadow: 0 0 0 4px rgba(15,23,42,.06);
  }
  .status-dot.on{
    background: rgba(16,185,129,.95);
    box-shadow: 0 0 0 4px rgba(16,185,129,.14);
  }

  /* Setting cards */
  .set-card{
    border: 1px solid rgba(15,23,42,.10);
    background: rgba(255,255,255,.80);
    border-radius: 22px;
    box-shadow: 0 16px 50px rgba(15,23,42,.08);
    overflow:hidden;
    height:100%;
    transition: transform .12s ease, box-shadow .12s ease;
  }
  .set-card:hover{ transform: translateY(-1px); box-shadow: 0 24px 70px rgba(15,23,42,.10); }
  .set-hd{
    display:flex; align-items:flex-start; justify-content:space-between; gap:12px;
    padding: 14px 14px 12px;
    background: linear-gradient(90deg, rgba(255,255,255,.72), rgba(255,255,255,.94));
    border-bottom: 1px solid rgba(15,23,42,.08);
  }
  .set-title{ font-weight: 950; color: rgba(15,23,42,.92); line-height:1.15; }
  .set-sub{ margin-top:4px; font-size:12px; color: var(--muted); }
  .set-bd{ padding: 12px 14px 14px; display:flex; align-items:center; justify-content:space-between; gap:12px; }

  /* Inputs */
  .mod-input{
    border-radius: 16px !important;
    border: 1px solid rgba(15,23,42,.12) !important;
    background: rgba(255,255,255,.90) !important;
    box-shadow: 0 14px 40px rgba(15,23,42,.06);
    color: var(--text) !important;
  }
  .mod-input:focus{
    border-color: rgba(79,70,229,.45) !important;
    box-shadow: 0 0 0 .25rem rgba(79,70,229,.18) !important;
  }

  /* Switch premium */
  .switch{
    position: relative;
    width: 54px; height: 34px;
    display:inline-block;
  }
  .switch input{ display:none; }
  .slider{
    position:absolute; inset:0;
    border-radius: 999px;
    background: rgba(15,23,42,.14);
    border: 1px solid rgba(15,23,42,.16);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.55);
    transition: all .15s ease;
  }
  .slider:before{
    content:"";
    position:absolute;
    width: 26px; height: 26px;
    left: 4px; top: 50%;
    transform: translateY(-50%);
    border-radius: 999px;
    background: rgba(255,255,255,.96);
    border: 1px solid rgba(15,23,42,.10);
    box-shadow: 0 12px 30px rgba(15,23,42,.18);
    transition: all .15s ease;
  }
  .switch input:checked + .slider{
    background: linear-gradient(135deg, rgba(79,70,229,.95), rgba(124,58,237,.92));
    border-color: rgba(79,70,229,.35);
  }
  .switch input:checked + .slider:before{
    left: 24px;
  }

  /* Save bar (sticky) */
  .savebar{
    position: sticky;
    bottom: 12px;
    z-index: 20;
    margin-top: 14px;
    padding: 12px;
    border-radius: 22px;
    border: 1px solid rgba(15,23,42,.10);
    background: rgba(255,255,255,.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 18px 60px rgba(15,23,42,.12);
    display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;
  }

  /* Mini toast fallback */
  .mini-toast{
    position: fixed;
    right: 16px; bottom: 16px;
    z-index: 9999;
    padding: 10px 12px;
    border-radius: 16px;
    border: 1px solid rgba(15,23,42,.12);
    background: rgba(255,255,255,.92);
    box-shadow: 0 22px 70px rgba(15,23,42,.16);
    font-weight: 950;
    color: rgba(15,23,42,.88);
    display:none;
  }
  .mini-toast.show{ display:block; animation: pop .14s ease-out; }
  @keyframes pop { from { transform: translateY(6px); opacity:.0; } to { transform: translateY(0); opacity:1; } }
</style>