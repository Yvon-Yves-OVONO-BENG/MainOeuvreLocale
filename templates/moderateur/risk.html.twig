{% extends 'base.html.twig' %}
{% block title %}{% trans %}Modérateur • Santé & Risques{% endtrans %}{% endblock %}

{% block body %}

{% include "moderateur/ui/_vip_ui_risk.html.twig" %}

<div class="page">
  <div class="card">

    <div class="hd">
      <div>
        <div class="h1">🛡️ {% trans %}Santé & risques{% endtrans %}</div>
        <div class="hint">{% trans %}Vue radar : activité, signalements, jobs signalés et file “haut risque”{% endtrans %} ({{ days }} {% trans %}jours{% endtrans %}).</div>
      </div>

      <form class="filters" method="get">
        <select class="select" name="days">
          {% for d in [7,14,30,60,90] %}
            <option value="{{ d }}" {{ days==d?'selected':'' }}>{{ d }}{% trans %}j{% endtrans %}</option>
          {% endfor %}
        </select>
        <select class="select" name="top">
          {% for n in [5,10,15,20,30] %}
            <option value="{{ n }}" {{ top==n?'selected':'' }}>{% trans %}Top{% endtrans %} {{ n }}</option>
          {% endfor %}
        </select>
        <button class="btn primary" type="submit">{% trans %}Appliquer{% endtrans %}</button>
      </form>
    </div>

    <div class="bd">
      <div class="kpis">
        <div class="kpi"><div class="t">{% trans %}Nouveaux comptes (24h){% endtrans %}</div><div class="v">{{ kpi.newUsers24h }}</div></div>
        <div class="kpi"><div class="t">{% trans %}Signalements comptes OPEN{% endtrans %}</div><div class="v">{{ kpi.openReports }}</div></div>
        <div class="kpi"><div class="t">{% trans %}Jobs signalés PENDING{% endtrans %}</div><div class="v">{{ kpi.pendingJobs }}</div></div>
        <div class="kpi"><div class="t">{% trans %}Activité (logs 24h){% endtrans %}</div><div class="v">{{ kpi.logs24h }}</div></div>
        <div class="kpi"><div class="t">{% trans %}IPs uniques (24h){% endtrans %}</div><div class="v">{{ kpi.uniqueIps24h }}</div></div>
        <div class="kpi"><div class="t">{% trans %}Top IPs / Actions{% endtrans %}</div><div class="v">{{ (stats.logs.topIps|length) + (stats.logs.topActions|length) }}</div></div>
        <div class="kpi"><div class="t">{% trans %}Top comptes signalés{% endtrans %}</div><div class="v">{{ stats.accounts.topTargets|length }}</div></div>
        <div class="kpi"><div class="t">{% trans %}Top créateurs jobs signalés{% endtrans %}</div><div class="v">{{ stats.jobs.topCreators|length }}</div></div>
      </div>

      <div class="grid">
        <div class="col-6">
          <div class="chartbox">
            <div class="charthead">
              <div>
                <div style="font-weight:950;">{% trans %}Area — Activité plateforme (logs/jour){% endtrans %}</div>
                <div class="hint">{% trans %}Volume global d’activité{% endtrans %} ({{ days }}{% trans %}j{% endtrans %}).</div>
              </div>
              <span class="chip">📈</span>
            </div>
            <div class="canvaswrap"><canvas id="chLogs"></canvas></div>
          </div>
        </div>

        <div class="col-6">
          <div class="chartbox">
            <div class="charthead">
              <div>
                <div style="font-weight:950;">{% trans %}Line — Signalements comptes vs jobs{% endtrans %}</div>
                <div class="hint">{% trans %}Comparatif des volumes{% endtrans %} ({{ days }}{% trans %}j{% endtrans %}).</div>
              </div>
              <span class="chip">{% trans %}Trend{% endtrans %}</span>
            </div>
            <div class="canvaswrap"><canvas id="chReportsVsJobs"></canvas></div>
          </div>
        </div>

        <div class="col-6">
          <div class="chartbox">
            <div class="charthead">
              <div>
                <div style="font-weight:950;">{% trans %}Pie — Statuts comptes{% endtrans %} ({{ days }}{% trans %}j{% endtrans %})</div>
                <div class="hint">{% trans %}open / resolved / canceled.{% endtrans %}</div>
              </div>
              <span class="chip">⭘</span>
            </div>
            <div class="canvaswrap"><canvas id="chAccPie"></canvas></div>
          </div>
        </div>

        <div class="col-6">
          <div class="chartbox">
            <div class="charthead">
              <div>
                <div style="font-weight:950;">{% trans %}Horizontal Bar — Top IPs{% endtrans %}</div>
                <div class="hint">{% trans %}IPs les plus actives{% endtrans %} ({{ days }}{% trans %}j{% endtrans %}).</div>
              </div>
              <span class="chip">{% trans %}Top{% endtrans %}</span>
            </div>
            <div class="canvaswrap"><canvas id="chTopIps"></canvas></div>
          </div>
        </div>

        <div class="col-12">
          <div class="chartbox">
            <div class="charthead">
              <div>
                <div style="font-weight:950;">🧨 {% trans %}File “Haut risque” (priorité modération){% endtrans %}</div>
                <div class="hint">{% trans %}Score = reports OPEN + jobs PENDING (+ activité). Actions rapides à droite.{% endtrans %}</div>
              </div>
              <span class="chip">{% trans %}Queue{% endtrans %}</span>
            </div>

            <div class="table-responsive">
              <table>
                <thead>
                  <tr>
                    <th>{% trans %}Utilisateur{% endtrans %}</th>
                    <th>{% trans %}Rôle{% endtrans %}</th>
                    <th>{% trans %}OPEN reports{% endtrans %}</th>
                    <th>{% trans %}PENDING jobs{% endtrans %}</th>
                    <th>{% trans %}Dernière activité{% endtrans %}</th>
                    <th>{% trans %}Score{% endtrans %}</th>
                    <th style="text-align:right;">{% trans %}Actions{% endtrans %}</th>
                  </tr>
                </thead>
                <tbody>
                  {% for row in queue %}
                    {% set u = row.u %}
                    {% set pp = u.personalProfile ?? null %}
                    {% set roles = u.roles ?? [] %}
                    {% set isTalent = 'ROLE_TALENT' in roles %}
                    {% set isComp = 'ROLE_COMPANY' in roles %}
                    {% set roleLabel = isTalent ? 'Talent' : (isComp ? 'Company' : 'Particulier') %}
                    {% set photo = (pp and pp.photo) ? asset('uploads/profiles/' ~ pp.photo) : asset('uploads/profiles/avatar.png') %}

                    <tr>
                      <td>
                        <div style="display:flex;gap:10px;align-items:center;">
                          <img class="avatar" src="{{ photo }}" alt="">
                          <div>
                            <div style="font-weight:950;">{{ pp and pp.fullName ? pp.fullName : u.email }}</div>
                            <div class="muted" style="font-size:12px;">{{ u.email }}{% if u.phone %} • {{ u.phone }}{% endif %}</div>
                          </div>
                        </div>
                      </td>
                      <td><span class="chip">{{ roleLabel|trans }}</span></td>
                      <td><span class="chip">{{ row.openReports }}</span></td>
                      <td><span class="chip">{{ row.pendingJobReports }}</span></td>
                      <td class="muted" style="font-size:12px;">{{ row.lastSeen ?: '—' }}</td>
                      <td><span class="chip">{{ row.score }}</span></td>
                      <td style="text-align:right;">
                        <a class="btn primary" href="{{ path('moderateur_verifications_show_slug', {slug: pp.slug}) }}">{% trans %}Vérifier{% endtrans %}</a>
                        <a class="btn" href="{{ path('moderateur_reports_show', {status: 'open', slug: pp.slug}) }}">{% trans %}Signalements{% endtrans %}</a>

                        <form method="post" action="{{ path('moderateur_risk_toggle_block', {id:u.id}) }}" style="display:inline;">
                          <input type="hidden" name="_token" value="{{ csrf_token('risk_block_' ~ u.id) }}">
                          <button class="btn {{ u.isActive ? 'danger' : '' }}" type="submit">
                            {{ u.isActive ? 'Bloquer'|trans : 'Débloquer'|trans }}
                          </button>
                        </form>
                      </td>
                    </tr>
                  {% else %}
                    <tr><td colspan="7" class="muted" style="padding:18px;text-align:center;">{% trans %}Aucun compte “haut risque” sur la période.{% endtrans %}</td></tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
(() => {
  const stats = {{ stats|json_encode|raw }};

  // Logs daily
  const lLabels = stats.logs.daily.labels || [];
  const lVals   = stats.logs.daily.values || [];

  // Accounts daily
  const aLabels = stats.accounts.daily.labels || [];
  const aVals   = stats.accounts.daily.values || [];

  // Jobs daily
  const jLabels = stats.jobs.daily.labels || [];
  const jVals   = stats.jobs.daily.values || [];

  // Pie status (accounts)
  const byAccSt = stats.accounts.byStatus || {};
  const accOpen = Number(byAccSt.open || 0);
  const accRes  = Number(byAccSt.resolved || 0);
  const accCan  = Number(byAccSt.canceled || 0);

  // Top IPs
  const ips = stats.logs.topIps || [];
  const ipLabels = ips.map(x => x.label);
  const ipVals   = ips.map(x => Number(x.value||0));

  new Chart(document.getElementById('chLogs'), {
    type:'line',
    data:{ labels:lLabels, datasets:[{ label:'{{ "Logs"|trans|e("js") }}', data:lVals, tension:.35, fill:true, borderWidth:2, pointRadius:2,
      backgroundColor: getComputedStyle(document.documentElement).getPropertyValue('--a1').trim() || 'rgba(56,189,248,.30)' }]},
    options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{ display:false } }, scales:{ x:{ grid:{ display:false } }, y:{ beginAtZero:true } } }
  });

  // Align labels safely (use logs labels as base if mismatch)
  const baseLabels = lLabels.length ? lLabels : (aLabels.length ? aLabels : jLabels);

  const aMap = Object.fromEntries(aLabels.map((d,i)=>[d, aVals[i]||0]));
  const jMap = Object.fromEntries(jLabels.map((d,i)=>[d, jVals[i]||0]));
  const aSeries = baseLabels.map(d => aMap[d] ?? 0);
  const jSeries = baseLabels.map(d => jMap[d] ?? 0);

  new Chart(document.getElementById('chReportsVsJobs'), {
    type:'line',
    data:{
      labels: baseLabels,
      datasets:[
        { label:'{{ "Reports comptes"|trans|e("js") }}', data:aSeries, tension:.35, fill:true, borderWidth:2, pointRadius:2,
          backgroundColor: getComputedStyle(document.documentElement).getPropertyValue('--a2').trim() || 'rgba(34,197,94,.22)'},
        { label:'{{ "Reports jobs"|trans|e("js") }}', data:jSeries, tension:.35, fill:true, borderWidth:2, pointRadius:2,
          backgroundColor: getComputedStyle(document.documentElement).getPropertyValue('--a3').trim() || 'rgba(245,158,11,.22)'}
      ]
    },
    options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{ position:'bottom' } }, scales:{ x:{ grid:{ display:false } }, y:{ beginAtZero:true } } }
  });

  new Chart(document.getElementById('chAccPie'), {
    type:'pie',
    data:{ labels:['{{ "open"|trans|e("js") }}','{{ "resolved"|trans|e("js") }}','{{ "canceled"|trans|e("js") }}'], datasets:[{ data:[accOpen,accRes,accCan], borderWidth:1 }] },
    options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{ position:'bottom' } } }
  });

  new Chart(document.getElementById('chTopIps'), {
    type:'bar',
    data:{ labels: ipLabels, datasets:[{ label:'{{ "Hits"|trans|e("js") }}', data: ipVals, borderWidth:1 }] },
    options:{ indexAxis:'y', responsive:true, maintainAspectRatio:false, plugins:{ legend:{ display:false } }, scales:{ x:{ beginAtZero:true }, y:{ grid:{ display:false } } } }
  });
})();
</script>
{% endblock %}