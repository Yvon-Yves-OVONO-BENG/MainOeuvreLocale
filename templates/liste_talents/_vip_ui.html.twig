   ============================================ */

/* --- BOUTON LAISSER UN AVIS PREMIUM --- */
.vip-btn-primary.review-trigger {
    position: relative !important;
    background: linear-gradient(135deg, #6366f1, #8b5cf6, #a855f7) !important;
    border: none !important;
    padding: 10px 24px !important;
    border-radius: 16px !important;
    font-weight: 700 !important;
    color: #fff !important;
    box-shadow: 0 8px 32px rgba(99, 102, 241, 0.35) !important;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
}

.vip-btn-primary.review-trigger:hover {
    transform: translateY(-3px) scale(1.02) !important;
    box-shadow: 0 12px 48px rgba(99, 102, 241, 0.5) !important;
}

.vip-btn-primary.review-trigger:active {
    transform: translateY(0) scale(0.98) !important;
}

/* --- RATING BOX PREMIUM --- */
.vip-rating-box.premium-rating {
    background: linear-gradient(145deg, #ffffff, #f8fafc) !important;
    border: 1px solid rgba(99, 102, 241, 0.15) !important;
    border-radius: 20px !important;
    padding: 16px 20px !important;
    min-width: 280px !important;
    box-shadow: 0 4px 24px rgba(0,0,0,0.06), 0 8px 48px rgba(99, 102, 241, 0.08) !important;
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 10px !important;
}

.vip-rating-box.premium-rating:hover {
    box-shadow: 0 8px 32px rgba(99, 102, 241, 0.15), 0 2px 12px rgba(0,0,0,0.04) !important;
    transform: translateY(-2px) !important;
}

.rating-header {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
}

.rating-label {
    font-size: 11px !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
    color: #94a3b8 !important;
}

.rating-label i {
    color: #f59e0b !important;
    margin-right: 4px !important;
}

.rating-main {
    display: flex !important;
    align-items: center !important;
    gap: 16px !important;
    flex-wrap: wrap !important;
}

/* --- ÉTOILES PREMIUM --- */
.premium-stars {
    display: flex !important;
    gap: 3px !important;
}

.premium-stars .premium-star {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    cursor: pointer !important;
    transition: all 0.2s ease !important;
}

.premium-stars .premium-star i {
    font-size: 18px !important;
    color: #e2e8f0 !important;
    transition: all 0.2s ease !important;
}

.premium-stars .premium-star.is-on i {
    color: #f59e0b !important;
    text-shadow: 0 0 20px rgba(245, 158, 11, 0.3) !important;
}

.premium-stars .premium-star:hover {
    transform: scale(1.2) !important;
}

.premium-stars .premium-star:hover i {
    color: #fbbf24 !important;
}

.premium-stars .premium-star:active {
    transform: scale(0.9) !important;
}

/* --- MÉTA DONNÉES PREMIUM --- */
.premium-meta {
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
    flex-wrap: wrap !important;
    flex-direction: row !important;
}

.rating-score-wrap {
    display: flex !important;
    align-items: baseline !important;
}

.premium-avg {
    font-size: 28px !important;
    font-weight: 800 !important;
    color: #0f172a !important;
    letter-spacing: -0.02em !important;
    line-height: 1 !important;
}

.score-divider {
    font-size: 18px !important;
    font-weight: 300 !important;
    color: #94a3b8 !important;
    margin: 0 2px !important;
}

.score-max {
    font-size: 16px !important;
    font-weight: 600 !important;
    color: #94a3b8 !important;
}

.rating-stats {
    display: flex !important;
    align-items: center !important;
}

.premium-count {
    font-size: 13px !important;
}

.premium-link {
    display: inline-flex !important;
    align-items: center !important;
    color: #64748b !important;
    text-decoration: none !important;
    font-weight: 600 !important;
    padding: 4px 12px !important;
    border-radius: 20px !important;
    background: rgba(99, 102, 241, 0.06) !important;
    transition: all 0.3s ease !important;
    gap: 4px !important;
}

.premium-link:hover {
    background: rgba(99, 102, 241, 0.12) !important;
    color: #6366f1 !important;
    transform: translateX(2px) !important;
}

.premium-count-badge {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-width: 20px !important;
    height: 20px !important;
    padding: 0 6px !important;
    background: linear-gradient(135deg, #6366f1, #8b5cf6) !important;
    color: #fff !important;
    border-radius: 10px !important;
    font-size: 11px !important;
    font-weight: 700 !important;
}

/* --- BARRE DE PROGRESSION --- */
.rating-progress {
    margin-top: 4px !important;
    height: 4px !important;
    background: #f1f5f9 !important;
    border-radius: 4px !important;
    overflow: hidden !important;
}

.premium-progress {
    height: 100% !important;
    background: linear-gradient(90deg, #6366f1, #8b5cf6, #a855f7) !important;
    border-radius: 4px !important;
    transition: width 1s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
    position: relative !important;
}

.premium-progress::after {
    content: '' !important;
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent) !important;
    animation: shimmer 2s infinite !important;
}

@keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
}

/* --- STATUS PREMIUM --- */
.vip-status.premium-status {
    display: inline-flex !important;
    align-items: center !important;
    gap: 10px !important;
    padding: 10px 16px !important;
    border-radius: 999px !important;
    font-size: 13px !important;
    font-weight: 700 !important;
    border: 1px solid transparent !important;
    background: rgba(255,255,255,0.95) !important;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06) !important;
}

.vip-status.premium-status .dot-pulse {
    width: 10px !important;
    height: 10px !important;
    border-radius: 50% !important;
    display: inline-block !important;
}

.vip-status.premium-status.ok {
    border-color: rgba(16, 185, 129, 0.3) !important;
    background: rgba(16, 185, 129, 0.08) !important;
    color: #047857 !important;
}

.vip-status.premium-status.ok .dot-pulse {
    background: #10b981 !important;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4) !important;
    animation: pulse-green 2s infinite !important;
}

.vip-status.premium-status.warn {
    border-color: rgba(245, 158, 11, 0.3) !important;
    background: rgba(245, 158, 11, 0.08) !important;
    color: #92400e !important;
}

.vip-status.premium-status.warn .dot-pulse {
    background: #f59e0b !important;
    box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.4) !important;
    animation: pulse-yellow 2s infinite !important;
}

.vip-status.premium-status.bad {
    border-color: rgba(244, 63, 94, 0.3) !important;
    background: rgba(244, 63, 94, 0.08) !important;
    color: #be123c !important;
}

.vip-status.premium-status.bad .dot-pulse {
    background: #f43f5e !important;
    box-shadow: 0 0 0 0 rgba(244, 63, 94, 0.4) !important;
    animation: pulse-red 2s infinite !important;
}

@keyframes pulse-green {
    0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
    70% { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
    100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
}

@keyframes pulse-yellow {
    0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.4); }
    70% { box-shadow: 0 0 0 8px rgba(245, 158, 11, 0); }
    100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
}

@keyframes pulse-red {
    0% { box-shadow: 0 0 0 0 rgba(244, 63, 94, 0.4); }
    70% { box-shadow: 0 0 0 8px rgba(244, 63, 94, 0); }
    100% { box-shadow: 0 0 0 0 rgba(244, 63, 94, 0); }
}

