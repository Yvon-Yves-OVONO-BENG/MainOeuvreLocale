/* Slider */
.vip-directory-slider-hero .vip-jobs-bg-slider {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    background: #071421;
}

.vip-directory-slider-hero .vip-jobs-bg-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;

    background-size: cover;
    background-position: center 38%;
    background-repeat: no-repeat;

    transform: scale(1.045);

    transition:
        opacity 1.8s ease-in-out,
        visibility 1.8s ease-in-out,
        transform 9s ease;

    will-change: opacity, transform;
}

.vip-directory-slider-hero .vip-jobs-bg-slide.active {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
}

/* Overlay sombre et fondu inférieur */
.vip-directory-slider-hero .vip-jobs-slider-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;

    background:
        linear-gradient(
            180deg,
            rgba(2, 6, 23, .34) 0%,
            rgba(2, 6, 23, .47) 54%,
            rgba(2, 6, 23, .70) 82%,
