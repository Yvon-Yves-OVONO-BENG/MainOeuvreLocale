}

/* ===== GESTION DU FLOU MODALE - CORRECTION ===== */

/* Le flou s'applique au body, mais uniquement lorsque la modale est ouverte */
body.modal-open {
    overflow: hidden;
}

/* Créer un conteneur pour le flou */
.modal-open .vip-page {
    filter: blur(4px);
    transition: filter 0.3s ease;
}

/* La modale reste nette */
.modal-content {
    filter: none !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    position: relative;
    z-index: 1060;
}

/* Amélioration du backdrop */
.modal-backdrop.show {
    background-color: rgba(15, 23, 42, 0.35) !important;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 1 !important;
}

/* S'assurer que la modale et son contenu ne sont pas flous */
.modal {
    filter: none !important;
    backdrop-filter: none !important;
}

.modal-dialog,
.modal-content,
.modal-header,
.modal-body,
.modal-footer {
    filter: none !important;
    backdrop-filter: none !important;
}

/* Pour éviter que le flou s'applique au contenu de la modale */
#reviewsModal .modal-content {
    filter: none !important;
    backdrop-filter: none !important;
}

/* ===== OVERLAY AVEC FLOU ===== */

/* Cachez le backdrop par défaut et créez le vôtre */
.modal-backdrop {
    display: none !important;
}

.modal.show {
    background: rgba(15, 23, 42, 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
}

/* Le contenu de la modale n'est pas flou */
.modal-content {
    filter: none !important;
    backdrop-filter: none !important;
}

/* Le contenu principal devient flou en arrière-plan */
