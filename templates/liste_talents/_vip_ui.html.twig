/* ============================================
   HERO AVEC RECHERCHE EN HAUT À DROITE
   ============================================ */

.vip-hero {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--vip-line);
    border-radius: 30px;
    background:
        radial-gradient(820px circle at 10% 20%, rgba(37,99,235,.18), transparent 55%),
        radial-gradient(700px circle at 90% 20%, rgba(79,70,229,.14), transparent 56%),
