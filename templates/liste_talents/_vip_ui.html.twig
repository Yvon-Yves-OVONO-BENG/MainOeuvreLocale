{# <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"> #}
<style>
		:root{
			--vip-bg-1:#f8fbff;
			--vip-bg-2:#eef4ff;
			--vip-bg-3:#f7f9fc;
			--vip-ink:#0f172a;
			--vip-text:#334155;
			--vip-muted:#64748b;
			--vip-line:rgba(15,23,42,.08);
			--vip-line-strong:rgba(15,23,42,.14);
			--vip-card:rgba(255,255,255,.88);
			--vip-glass:rgba(255,255,255,.74);
			--vip-primary:#2563eb;
			--vip-primary-2:#4f46e5;
			--vip-success:#10b981;
			--vip-warning:#f59e0b;
			--vip-danger:#f43f5e;
			--vip-star:#f7b731;
			--vip-radius:24px;
			--vip-radius-sm:18px;
			--vip-shadow:0 18px 50px rgba(15,23,42,.08);
			--vip-shadow-sm:0 10px 28px rgba(15,23,42,.06);
			--vip-blur:blur(14px);
		}

		.vip-page{
			padding:18px 0 36px;
			min-height:calc(100vh - 1px);
			background:
				radial-gradient(900px circle at 8% 8%, rgba(37,99,235,.12), transparent 52%),
				radial-gradient(800px circle at 92% 10%, rgba(79,70,229,.10), transparent 52%),
				radial-gradient(800px circle at 20% 90%, rgba(16,185,129,.08), transparent 55%),
				linear-gradient(180deg, var(--vip-bg-1) 0%, var(--vip-bg-2) 48%, var(--vip-bg-3) 100%);
		}

		.vip-shell{
			max-width:1220px;
			margin:0 auto;
			padding:0 14px;
		}

		/* HERO */
		.vip-hero{
			position:relative;
			overflow:hidden;
			border:1px solid var(--vip-line);
			border-radius:30px;
			background:
				radial-gradient(820px circle at 10% 20%, rgba(37,99,235,.18), transparent 55%),
				radial-gradient(700px circle at 90% 20%, rgba(79,70,229,.14), transparent 56%),
				linear-gradient(135deg, rgba(255,255,255,.92), rgba(255,255,255,.72));
			backdrop-filter:var(--vip-blur);
			-webkit-backdrop-filter:var(--vip-blur);
			box-shadow:var(--vip-shadow);
		}
		.vip-hero::before{
			content:"";
			position:absolute;
			inset:auto -80px -80px auto;
			width:220px;
			height:220px;
			border-radius:50%;
			background:radial-gradient(circle, rgba(37,99,235,.12), transparent 68%);
		}
		.vip-hero-inner{
			position:relative;
			z-index:2;
			padding:22px 22px 18px;
			display:flex;
			gap:16px;
			align-items:flex-start;
			justify-content:space-between;
			flex-wrap:wrap;
		}
		.vip-title-wrap h3{
			margin:0;
			font-size:clamp(1.35rem, 2vw, 1.8rem);
			font-weight:1000;
			letter-spacing:-.04em;
			color:var(--vip-ink);
		}
		.vip-title-wrap p{
			margin:8px 0 0;
			max-width:760px;
			color:var(--vip-text);
			font-weight:700;
		}
		.vip-top-actions{
			display:flex;
			gap:10px;
			flex-wrap:wrap;
		}
		.vip-btn-soft{
			border-radius:14px !important;
			font-weight:950 !important;
			border:1px solid var(--vip-line-strong) !important;
			background:rgba(255,255,255,.82) !important;
			color:var(--vip-ink) !important;
			box-shadow:var(--vip-shadow-sm);
		}
		.vip-badges{
			width:100%;
			display:flex;
			gap:10px;
			flex-wrap:wrap;
			align-items:center;
			margin-top:2px;
		}
		.vip-pill{
			display:inline-flex;
			align-items:center;
			gap:8px;
			padding:9px 12px;
			border-radius:999px;
			border:1px solid var(--vip-line);
			background:rgba(255,255,255,.84);
			color:var(--vip-ink);
			font-size:12.5px;
			font-weight:950;
			box-shadow:var(--vip-shadow-sm);
		}
		.vip-pill.info{
			background:rgba(37,99,235,.08);
			border-color:rgba(37,99,235,.16);
			color:#1d4ed8;
		}
		.vip-pill.success{
			background:rgba(16,185,129,.09);
			border-color:rgba(16,185,129,.16);
			color:#047857;
		}
		.vip-search{
			display:flex;
			align-items:center;
			gap:8px;
			padding:7px 12px;
			min-width:250px;
			border-radius:999px;
			border:1px solid var(--vip-line-strong);
			background:rgba(255,255,255,.92);
			box-shadow:var(--vip-shadow-sm);
		}
		.vip-search i{
			color:var(--vip-muted);
			font-size:13px;
		}
		.vip-search input{
			border:0;
			outline:0;
			background:transparent;
			width:100%;
			font-size:13px;
			font-weight:850;
			color:var(--vip-ink);
		}
		.vip-search input::placeholder{
			color:rgba(15,23,42,.42);
		}

		/* EMPTY */
		.vip-empty{
			margin-top:14px;
			border:none;
			border-radius:20px;
			background:rgba(255,255,255,.84);
			box-shadow:var(--vip-shadow-sm);
			font-weight:800;
		}

		/* CARD */
		.vip-card{
			margin-top:14px;
			border:1px solid var(--vip-line);
			border-radius:28px;
			background:linear-gradient(180deg, rgba(255,255,255,.93), rgba(255,255,255,.82));
			box-shadow:var(--vip-shadow);
			overflow:hidden;
			position:relative;
		}
		.vip-card::after{
			content:"";
			position:absolute;
			top:0;
			left:0;
			right:0;
			height:5px;
			background:linear-gradient(90deg, var(--vip-primary), var(--vip-primary-2), #06b6d4);
			opacity:.95;
		}
		.vip-card-body{
			padding:20px;
		}
		.vip-card-footer{
			padding:14px 20px;
			border-top:1px solid var(--vip-line);
			background:rgba(248,250,252,.75);
		}

		/* header */
		.vip-head{
			display:flex;
			gap:14px;
			justify-content:space-between;
			align-items:flex-start;
			margin-bottom:14px;
			flex-wrap:wrap;
		}
		.vip-head-left{
			display:flex;
			gap:14px;
			align-items:center;
			min-width:0;
			flex:1 1 520px;
		}
		.vip-avatar{
			width:84px;
			height:84px;
			border-radius:22px;
			object-fit:cover;
			flex:0 0 84px;
			border:1px solid rgba(255,255,255,.75);
			box-shadow:0 14px 28px rgba(15,23,42,.14);
			background:#f1f5f9;
		}
		.vip-id{
			min-width:0;
		}
		.vip-name-row{
			display:flex;
			align-items:center;
			gap:10px;
			flex-wrap:wrap;
		}
		.vip-name{
			text-decoration:none;
			color:var(--vip-ink);
			font-size:1.15rem;
			font-weight:1000;
			letter-spacing:-.03em;
			line-height:1.2;
		}
		.vip-name:hover{
			color:var(--vip-primary);
		}
		.vip-subtitle{
			margin-top:6px;
			color:var(--vip-text);
			font-weight:800;
			display:flex;
			gap:10px 14px;
			flex-wrap:wrap;
		}
		.vip-verified{
			display:inline-flex;
			align-items:center;
			gap:8px;
			padding:7px 11px;
			border-radius:999px;
			font-size:12.2px;
			font-weight:950;
		}
		.vip-verified.ok{
			background:rgba(16,185,129,.10);
			color:#047857;
			border:1px solid rgba(16,185,129,.16);
		}
		.vip-verified.no{
			background:rgba(244,63,94,.10);
			color:#be123c;
			border:1px solid rgba(244,63,94,.16);
		}

		/* rating top */
		.vip-top-right{
			display:flex;
			flex-direction:column;
			align-items:flex-end;
			gap:10px;
			flex:0 0 auto;
		}
		.vip-rating-box{
			display:flex;
			align-items:center;
			gap:10px;
			padding:10px 12px;
			border-radius:18px;
			border:1px solid rgba(245,158,11,.18);
			background:linear-gradient(180deg, rgba(255,251,235,.96), rgba(255,247,214,.92));
			box-shadow:var(--vip-shadow-sm);
		}
		.vip-rating-meta{
			display:flex;
			flex-direction:column;
			line-height:1.05;
		}
		.vip-rating-score{
			font-size:1rem;
			font-weight:1000;
			color:var(--vip-ink);
		}
		.vip-rating-count{
			font-size:.78rem;
			font-weight:850;
			color:#8a6a16;
		}
		.mol-stars{
			display:inline-flex;
			gap:.28rem;
		}
		.mol-star{
			border:0;
			background:transparent;
			padding:0;
			cursor:pointer;
			opacity:1;
		}
		.mol-star i{
			font-size:18px;
			color:rgba(15,23,42,.15);
			transition:.16s ease;
		}
		.mol-star.is-on i{
			color:var(--vip-star);
		}
		.mol-star:disabled{
			cursor:not-allowed;
			opacity:.55;
		}

		/* status */
		.vip-status{
			display:inline-flex;
			align-items:center;
			gap:8px;
			padding:8px 11px;
			border-radius:999px;
			font-size:12.5px;
			font-weight:950;
			border:1px solid var(--vip-line);
			background:rgba(255,255,255,.84);
			color:var(--vip-ink);
		}
		.vip-status .dot{
			width:9px;
			height:9px;
			border-radius:999px;
			display:inline-block;
		}
		.vip-status.ok{
			background:rgba(16,185,129,.10);
			border-color:rgba(16,185,129,.16);
			color:#047857;
		}
		.vip-status.ok .dot{
			background:#10b981;
			box-shadow:0 0 0 6px rgba(16,185,129,.12);
		}
		.vip-status.warn{
			background:rgba(245,158,11,.10);
			border-color:rgba(245,158,11,.18);
			color:#92400e;
		}
		.vip-status.warn .dot{
			background:#f59e0b;
			box-shadow:0 0 0 6px rgba(245,158,11,.14);
		}
		.vip-status.bad{
			background:rgba(244,63,94,.10);
			border-color:rgba(244,63,94,.16);
			color:#be123c;
		}
		.vip-status.bad .dot{
			background:#f43f5e;
			box-shadow:0 0 0 6px rgba(244,63,94,.12);
		}

		/* details */
		.vip-grid{
			display:grid;
			grid-template-columns:repeat(4, minmax(0,1fr));
			gap:10px;
			margin-top:6px;
		}
		.vip-item{
			display:flex;
			align-items:center;
			gap:10px;
			padding:12px 13px;
			border-radius:18px;
			border:1px solid var(--vip-line);
			background:rgba(255,255,255,.76);
			min-width:0;
		}
		.vip-item i{
			color:var(--vip-primary);
			font-size:14px;
			width:18px;
			text-align:center;
		}
		.vip-item img{
			width:18px;
			height:18px;
			border-radius:999px;
			object-fit:cover;
		}
		.vip-item span{
			display:block;
			min-width:0;
			white-space:nowrap;
			overflow:hidden;
			text-overflow:ellipsis;
			color:var(--vip-ink);
			font-weight:850;
			font-size:.93rem;
		}
		.vip-item small{
			display:block;
			color:var(--vip-muted);
			font-size:.73rem;
			font-weight:800;
			text-transform:uppercase;
			letter-spacing:.04em;
			margin-bottom:2px;
		}

		.vip-badges-row{
			display:flex;
			flex-wrap:wrap;
			gap:10px;
			margin-top:14px;
		}
		.vip-soft-badge{
			display:inline-flex;
			align-items:center;
			gap:8px;
			padding:9px 12px;
			border-radius:999px;
			border:1px solid var(--vip-line);
			background:rgba(248,250,252,.9);
			color:var(--vip-ink);
			font-size:12.4px;
			font-weight:950;
		}
		.vip-soft-badge i{
			color:var(--vip-primary);
		}

		/* footer */
		.vip-footer-row{
			display:flex;
			gap:12px;
			flex-wrap:wrap;
			align-items:center;
			justify-content:space-between;
		}
		.vip-footer-left,
		.vip-footer-right{
			display:flex;
			gap:8px;
			flex-wrap:wrap;
			align-items:center;
		}
		.vip-btn{
			border-radius:14px !important;
			font-weight:950 !important;
			padding:.6rem .9rem !important;
		}
		.vip-btn-icon{
			min-width:44px;
		}
		.vip-btn-primary{
			background:linear-gradient(135deg, var(--vip-primary), var(--vip-primary-2)) !important;
			border:none !important;
			box-shadow:0 10px 20px rgba(37,99,235,.18);
		}
		.vip-btn-light{
			background:rgba(255,255,255,.9) !important;
			border:1px solid var(--vip-line-strong) !important;
			color:var(--vip-ink) !important;
		}
		.vip-btn-outline{
			border:1px solid rgba(37,99,235,.20) !important;
			color:var(--vip-primary) !important;
			background:rgba(37,99,235,.04) !important;
		}

		.pagination{
			gap:6px;
		}
		.pagination .page-link{
			border:none;
			border-radius:12px !important;
			color:var(--vip-ink);
			font-weight:900;
			box-shadow:var(--vip-shadow-sm);
		}
		.pagination .page-item.active .page-link{
			background:linear-gradient(135deg, var(--vip-primary), var(--vip-primary-2));
			color:#fff;
		}

		.mol-modal .modal-content{
			border:none;
			border-radius:22px;
			box-shadow:0 24px 60px rgba(15,23,42,.18);
		}
		.mol-modal .modal-header,
		.mol-modal .modal-footer{
			border-color:var(--vip-line);
		}
		.mol-modal .form-control{
			border-radius:14px;
		}
		.mol-icon{
			display:inline-flex;
			align-items:center;
			justify-content:center;
			width:34px;
			height:34px;
			border-radius:12px;
			background:rgba(37,99,235,.10);
			color:var(--vip-primary);
			margin-right:8px;
		}
		.mol-hint{
			font-size:.86rem;
			color:var(--vip-muted);
			margin-top:6px;
			font-weight:700;
		}

		@media (max-width: 991px){
			.vip-grid{
				grid-template-columns:repeat(2, minmax(0,1fr));
			}
		}
		@media (max-width: 576px){
			.vip-hero-inner,
			.vip-card-body,
			.vip-card-footer{
				padding-left:14px;
				padding-right:14px;
			}
			.vip-head-left{
				align-items:flex-start;
			}
			.vip-avatar{
				width:68px;
				height:68px;
				border-radius:18px;
				flex-basis:68px;
			}
			.vip-top-right{
				align-items:flex-start;
				width:100%;
			}
			.vip-rating-box{
				width:100%;
				justify-content:space-between;
				flex-wrap:wrap;
			}
			.vip-grid{
				grid-template-columns:1fr;
			}
			.vip-footer-row{
				flex-direction:column;
				align-items:stretch;
			}
			.vip-footer-left,
			.vip-footer-right{
				width:100%;
			}
		}
	</style>

