    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    background: #071421;
}

.vip-directory-bg-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transform: scale(1.06);
    transition:
        opacity 1.8s ease-in-out,
        visibility 1.8s ease-in-out,
        transform 8s ease;
    will-change: opacity, transform;
}

.vip-directory-bg-slide.active {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
}

.vip-directory-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
        linear-gradient(
            180deg,
            rgba(2, 6, 23, .40) 0%,
