/* ============================================
   RECHERCHE DYNAMIQUE PREMIUM
   ============================================ */

.vip-search-premium {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: 1;
    min-width: 280px;
    max-width: 100%;
}

.search-input-wrapper {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.95);
    border: 1.5px solid rgba(15, 23, 42, 0.06);
    border-radius: 14px;
    padding: 0 6px 0 16px;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
}

.search-input-wrapper:focus-within {
    border-color: #6366f1;
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.10), 0 4px 16px rgba(99, 102, 241, 0.08);
    background: #ffffff;
}

.search-input-wrapper:hover {
    border-color: rgba(99, 102, 241, 0.3);
}

.search-icon {
    color: #94a3b8;
    font-size: 15px;
    transition: color 0.3s ease;
    margin-right: 8px;
}

.search-input-wrapper:focus-within .search-icon {
    color: #6366f1;
}

.search-input-field {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    padding: 12px 0;
    font-size: 14px;
    font-weight: 500;
    color: #0f172a;
    min-width: 100px;
}

.search-input-field::placeholder {
    color: #94a3b8;
    font-weight: 400;
    font-size: 14px;
}

.search-input-field:focus {
    outline: none;
}

.search-clear-btn {
    background: none;
    border: none;
    color: #94a3b8;
    cursor: pointer;
    padding: 4px 8px;
    font-size: 16px;
    transition: all 0.2s ease;
    display: none;
    align-items: center;
    justify-content: center;
}

.search-clear-btn:hover {
    color: #ef4444;
    transform: scale(1.1);
}

.search-shortcut {
    display: flex;
    align-items: center;
    gap: 3px;
    padding-left: 12px;
    border-left: 1px solid rgba(15, 23, 42, 0.06);
}

.search-shortcut kbd {
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 10px;
    font-weight: 600;
    color: #64748b;
    font-family: inherit;
    line-height: 1.4;
}

/* Résultats compteur */
.search-results-count {
    display: flex;
    align-items: baseline;
    gap: 4px;
    padding: 4px 12px;
    background: rgba(99, 102, 241, 0.06);
    border-radius: 8px;
    white-space: nowrap;
    transition: all 0.3s ease;
}

.count-number {
    font-size: 18px;
    font-weight: 700;
    color: #6366f1;
    min-width: 20px;
    text-align: center;
}

.count-label {
    font-size: 12px;
    font-weight: 500;
    color: #94a3b8;
}

/* Animation du compteur */
.count-number {
    transition: all 0.3s ease;
}

.count-number.updating {
    transform: scale(1.2);
    color: #8b5cf6;
}

/* Responsive */
@media (max-width: 768px) {
    .vip-search-premium {
        flex-direction: column;
        align-items: stretch;
        gap: 10px;
        min-width: unset;
    }
    
    .search-input-wrapper {
        padding: 0 4px 0 12px;
    }
    
    .search-input-field {
        font-size: 13px;
        padding: 10px 0;
    }
    
    .search-shortcut {
        display: none;
    }
    
    .search-results-count {
        justify-content: center;
        padding: 4px 10px;
    }
    
    .count-number {
        font-size: 16px;
    }
}

@media (max-width: 480px) {
    .search-input-wrapper {
        border-radius: 12px;
        padding: 0 4px 0 10px;
    }
    
    .search-input-field {
        font-size: 12px;
        padding: 8px 0;
    }
    
    .search-icon {
        font-size: 13px;
        margin-right: 6px;
    }
    
    .count-number {
        font-size: 14px;
    }
}

