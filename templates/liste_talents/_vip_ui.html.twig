.ultra-link {
    display: inline-flex !important;
    align-items: center !important;
    color: #64748b !important;
    text-decoration: none !important;
    font-size: 11px !important;
    font-weight: 600 !important;
    padding: 2px 8px !important;
    border-radius: 12px !important;
    background: rgba(99, 102, 241, 0.06) !important;
    transition: all 0.3s ease !important;
    gap: 3px !important;
}

.ultra-link:hover {
    background: rgba(99, 102, 241, 0.12) !important;
    color: #6366f1 !important;
}

.ultra-count {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-width: 14px !important;
    height: 14px !important;
    padding: 0 4px !important;
    background: linear-gradient(135deg, #6366f1, #8b5cf6) !important;
    color: #fff !important;
    border-radius: 8px !important;
    font-size: 8px !important;
    font-weight: 700 !important;
}

/* Barre de progression ultra fine */
.rating-progress.ultra {
    width: 100% !important;
    height: 2px !important;
    background: #f1f5f9 !important;
    border-radius: 2px !important;
    overflow: hidden !important;
}

.premium-progress.ultra {
    height: 100% !important;
    background: linear-gradient(90deg, #6366f1, #8b5cf6, #a855f7) !important;
    border-radius: 2px !important;
    transition: width 0.8s ease !important;
}

/* Status ultra compact - DÉPLACÉ ICI */
.status-inline {
    display: flex !important;
    align-items: center !important;
}

.vip-status.premium-status.ultra {
    display: inline-flex !important;
    align-items: center !important;
    gap: 5px !important;
    padding: 4px 10px !important;
    border-radius: 999px !important;
    font-size: 10px !important;
    font-weight: 700 !important;
    border: 1px solid transparent !important;
    background: rgba(255,255,255,0.95) !important;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04) !important;
}

.vip-status.premium-status.ultra .dot-pulse.ultra {
    width: 6px !important;
    height: 6px !important;
    border-radius: 50% !important;
    display: inline-block !important;
}

.vip-status.premium-status.ultra.ok {
    border-color: rgba(16, 185, 129, 0.3) !important;
    background: rgba(16, 185, 129, 0.08) !important;
    color: #047857 !important;
}

.vip-status.premium-status.ultra.ok .dot-pulse.ultra {
    background: #10b981 !important;
    animation: pulse-green 2s infinite !important;
}

.vip-status.premium-status.ultra.warn {
    border-color: rgba(245, 158, 11, 0.3) !important;
    background: rgba(245, 158, 11, 0.08) !important;
    color: #92400e !important;
}

.vip-status.premium-status.ultra.warn .dot-pulse.ultra {
    background: #f59e0b !important;
    animation: pulse-yellow 2s infinite !important;
}

.vip-status.premium-status.ultra.bad {
    border-color: rgba(244, 63, 94, 0.3) !important;
    background: rgba(244, 63, 94, 0.08) !important;
    color: #be123c !important;
}

.vip-status.premium-status.ultra.bad .dot-pulse.ultra {
    background: #f43f5e !important;
    animation: pulse-red 2s infinite !important;
}

/* Animations */
@keyframes pulse-green {
    0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
    70% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
}

@keyframes pulse-yellow {
    0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.4); }
    70% { box-shadow: 0 0 0 6px rgba(245, 158, 11, 0); }
    100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
}

@keyframes pulse-red {
    0% { box-shadow: 0 0 0 0 rgba(244, 63, 94, 0.4); }
    70% { box-shadow: 0 0 0 6px rgba(244, 63, 94, 0); }
    100% { box-shadow: 0 0 0 0 rgba(244, 63, 94, 0); }
}

/* Responsive */
@media (max-width: 768px) {
    .vip-top-right {
        flex-direction: column !important;
        align-items: stretch !important;
        width: 100% !important;
    }
    
    .rating-ultra-compact {
        width: 100% !important;
