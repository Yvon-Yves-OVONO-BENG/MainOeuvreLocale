			font-weight:900;
		}
		
		#reviewsModal .modal-content{
    border:none;
    border-radius:20px;
    overflow:hidden;
}

#reviewsModal .modal-header{
    background:#fff;
    border-bottom:1px solid #edf2f7;
}


.mol-review-scores{
    background:#f8fafc;
    border-radius:15px;
    padding:15px;
    margin-top:15px;
}

.mol-criterion{
