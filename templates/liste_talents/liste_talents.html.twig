        /** Récupère et affiche un contact après contrôle du quota d'abonnement. */
        function showContact(type, userSlug, value) {
            // Vérifier s'il reste des contacts
            if (
                !canBypassContactLimit
                && remainingContacts !== null
                && remainingContacts <= 0
                && remainingContacts !== 99999
            ) {
                Swal.fire({
