	<script>
		document.addEventListener('DOMContentLoaded', () => {
			[
                'contactTalent',
                'commentTalent',
                'reviewsModal'
            ].forEach((id) => {
            
                const el = document.getElementById(id);
            
                if (el) {
                    document.body.appendChild(el);
                }
            });

			/** Met à jour l'état visuel des étoiles d'une note. */
			function renderStars(block, avg) {
				const n = Math.round(Number(avg) || 0);
				block.querySelectorAll('.mol-star').forEach((btn) => {
					const v = parseInt(btn.dataset.value, 10);
					btn.classList.toggle('is-on', v <= n);
				});
			}

			document.querySelectorAll('.mol-rating').forEach((block) => {
				renderStars(block, block.dataset.avg);
			});

			document.addEventListener('click', async (e) => {
				const btn = e.target.closest('.mol-star');
				if (!btn) return;

				const block = btn.closest('.mol-rating');
				const url = block?.dataset.rateUrl;
				if (!block || !url) return;

				const stars = parseInt(btn.dataset.value, 10);
				renderStars(block, stars);
				block.querySelectorAll('.mol-star').forEach(b => b.disabled = true);

				try {
					const form = new FormData();
					form.append('stars', String(stars));

					const res = await fetch(url, {
						method: 'POST',
						body: form,
						headers: { 'X-Requested-With': 'XMLHttpRequest' }
					});

					if (res.status === 401) {
						const data = await res.json().catch(() => null);
						window.location.href = (data && data.loginUrl) ? data.loginUrl : "{{ path('app_login') }}";
						return;
					}

					const data = await res.json();
					if (!data.ok) {
						alert(data.message || "Erreur lors du vote.");
						return;
					}

					const avgEl = block.querySelector('.mol-avg');
					const countEl = block.querySelector('.mol-count');

					if (avgEl) avgEl.textContent = (Number(data.avg) || 0).toFixed(1);
					if (countEl) countEl.textContent = (Number(data.voters) || 0);

					renderStars(block, data.avg);

				} catch (err) {
					console.error(err);
					alert("Impossible de voter. Réessayez.");
				} finally {
					block.querySelectorAll('.mol-star').forEach(b => b.disabled = false);
				}
			});
		});
	</script>

	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const input = document.getElementById('vipTalentSearch');
			if (!input) return;

			const cards = Array.from(document.querySelectorAll('.card'));
			const pagination = document.querySelector('nav[aria-label]');
			const emptyAlert = document.querySelector('.vip-empty, .alert.alert-info');

			/** Normalise un texte afin de rendre la recherche tolérante aux accents. */
			function normalizeText(text) {
				return (text || '')
					.toString()
					.normalize('NFD')
					.replace(/[\u0300-\u036f]/g, '')
					.toLowerCase()
					.trim();
			}

			/** Filtre les cartes visibles à partir du texte saisi. */
			function filterTalents() {
				const query = normalizeText(input.value);

				let visibleCount = 0;

				cards.forEach((card) => {
					const searchableNode = card.querySelector('.vip-search-data');
					const searchableText = normalizeText(
						searchableNode ? searchableNode.textContent : card.textContent
					);

					const matches = query === '' || searchableText.includes(query);

					card.style.display = matches ? '' : 'none';

					if (matches) {
						visibleCount++;
					}
				});

				if (pagination) {
					pagination.style.display = query !== '' ? 'none' : '';
				}

				if (emptyAlert) {
					if (cards.length > 0) {
						emptyAlert.style.display = visibleCount === 0 ? '' : 'none';
						if (visibleCount === 0) {
							emptyAlert.textContent = "Aucun talent ne correspond àvotre recherche.";
						}
					}
				}
			}

			input.addEventListener('input', filterTalents);

			// Si un texte existe déjàdans le champ au chargement
			filterTalents();
		});
	</script>
	
	<script>
    // Version optimisée avec event delegation ciblée
    document.addEventListener('DOMContentLoaded', function() {
       
        document.addEventListener('click', async function(e){

            const btn = e.target.closest('.show-user-reviews');

            if(!btn) return;

            e.preventDefault();

            const userSlug = btn.dataset.userSlug;
            const reviewsUrl = btn.dataset.reviewsUrl || btn.getAttribute('href');
            
            // CORRECTION : Rechercher dans vip-card OU card
            const card = btn.closest('.vip-card') || btn.closest('.card');
            
            // CORRECTION : Chercher le nom dans les bons éléments
            let userName = 'Utilisateur';
            
            // Méthode 1: Chercher dans le h6 qui contient le nom
            const h6Element = card?.querySelector('h6.fw-bold') || card?.querySelector('h6');
            
            if (h6Element) {
                // Cloner l'élément pour supprimer les badges
                const clone = h6Element.cloneNode(true);
                // Supprimer tous les badges (span avec classe badge)
                clone.querySelectorAll('.badge').forEach(el => el.remove());
                // Supprimer les espaces inutiles
                userName = clone.textContent?.trim() || 'Utilisateur';
            }
            
            // Méthode 2: Fallback - chercher dans .vip-name
            if (userName === 'Utilisateur') {
                const vipName = card?.querySelector('.vip-name');
                if (vipName) {
                    userName = vipName.textContent?.trim() || 'Utilisateur';
                }
            }

            const modalEl = document.getElementById('reviewsModal');
            
            // Mettre àjour le titre de la modale avec le nom de l'utilisateur
            const modalTitle = modalEl.querySelector('.modal-title');
            if (modalTitle) {
                modalTitle.innerHTML = `
                    <i class="fa fa-comments me-2"></i>
                    Avis de : <strong>${userName}</strong>
                `;
            }

            let modal = bootstrap.Modal.getInstance(modalEl);
            
            if(!modal){
                modal = new bootstrap.Modal(modalEl, {
                    backdrop: true,
                    keyboard: true,
                    focus: true
                });
            }

            const container = document.getElementById('reviewsContainer');

            container.innerHTML =
                '<div class="text-center py-4"><i class="fa fa-spinner fa-spin me-2"></i>Chargement...</div>';

            modal.show();
            
            setTimeout(() => {
                const modalDialog = modalEl.querySelector('.modal-dialog');
                if (modalDialog) {
                    modalDialog.style.marginTop = '5vh';
                    modalDialog.style.marginBottom = '5vh';
                }
            }, 50);

            setTimeout(() => {
                const backdrops = document.querySelectorAll('.modal-backdrop');
                if(backdrops.length > 1){
                    for(let i = 1; i < backdrops.length; i++){
                        backdrops[i].remove();
                    }
                }
            }, 100);

            try {

                const response = await fetch(reviewsUrl, {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    credentials: 'same-origin'
                });

                if (!response.ok) {
                    throw new Error(`Chargement des avis impossible (HTTP ${response.status})`);
                }

                const reviews = await response.json();

                if (!Array.isArray(reviews)) {
                    throw new Error('La réponse des avis est invalide.');
                }

                let html = '';

                if(reviews.length === 0){

                    html = `
                        <div class="alert alert-info">
                            Aucun avis disponible pour ${userName}.
                        </div>
                    `;

                } else {

                    reviews.forEach(item => {

                        let criteriaHtml = '';
                        let total = 0;
                    
                        if (item.criteria) {
                    
                            item.criteria.forEach(c => {
                    
                                total += Number(c.score);
                    
                                const score5 = (Number(c.score) / 2).toFixed(1);
                    
                                let emoji = '😐';
                    
                                if (c.score >= 10) emoji = '😍';
                                else if (c.score >= 9) emoji = '🤩';
                                else if (c.score >= 8) emoji = '😄';
                                else if (c.score >= 7) emoji = '😊';
                                else if (c.score >= 6) emoji = '🙂';
                                else if (c.score >= 5) emoji = '😐';
                                else if (c.score >= 4) emoji = '😕';
                                else if (c.score >= 3) emoji = '😣';
                                else if (c.score >= 2) emoji = '😠';
                                else emoji = '😡';
                    
                                criteriaHtml += `
                                    <div class="mol-criterion">
                                        <div class="mol-criterion-name">
                                            ${c.name}
                                        </div>
                                        <div class="mol-criterion-score">
                                            <span class="mol-emoji">
                                                ${emoji}
                                            </span>
                                            <span class="mol-score">
                                                ${score5}/5
                                            </span>
                                        </div>
                                    </div>
                                `;
                            });
                        }
                    
                        const average10 =
                            item.criteria && item.criteria.length > 0
                                ? (total / item.criteria.length)
                                : 0;
                    
                        const average5 = (average10 / 2).toFixed(1);
                    
                        html += `
                            <div class="border-bottom mb-4 pb-4">
                    
                                <div class="d-flex justify-content-between align-items-center mb-3">
                    
                                    <strong class="fs-6">
                                        ${item.author}
                                    </strong>
                    
                                    <div>
                                        <span class="badge bg-success me-2">
                                            ⭐ ${average5}/5
                                        </span>
                                        <small class="text-muted">
                                            ${item.date}
                                        </small>
                                    </div>
                    
                                </div>
                    
                                <div class="review-two-columns">
                    
                                    <div class="review-comment-col">
                                        <div class="mol-review-comment">
                                            <i class="fa fa-quote-left me-2"></i>
                                            ${item.comment || 'Aucun commentaire'}
                                        </div>
                                    </div>
                    
                                    <div class="review-criteria-col">
                                        <div class="mol-review-scores">
                                            ${criteriaHtml}
                                        </div>
                                    </div>
                    
                                </div>
                    
                            </div>
                        `;
                    });
                }

                container.innerHTML = html;

            } catch(error){

                console.error(error);

                container.innerHTML = `
                    <div class="alert alert-danger">
                        Impossible de charger les avis.
                    </div>
                `;
            }
        });

    });
</script>

