    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const input = document.getElementById('vipTalentSearch');
            const clearBtn = document.getElementById('searchClearBtn');
            const resultCount = document.getElementById('resultCount');
            
            if (!input) return;
        
            const cards = Array.from(document.querySelectorAll('.card'));
            const pagination = document.querySelector('nav[aria-label]');
            const emptyAlert = document.querySelector('.vip-empty, .alert.alert-info');
        
            /** Normalise le texte utilisé par le second filtre du répertoire. */
            function normalizeText(text) {
                return (text || '')
                    .toString()
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '')
                    .toLowerCase()
                    .trim();
            }
        
            /** Met à jour le compteur de profils visibles. */
            function updateResultCount(count) {
                if (resultCount) {
                    resultCount.classList.add('updating');
                    resultCount.textContent = count;
                    setTimeout(() => {
                        resultCount.classList.remove('updating');
                    }, 300);
                }
            }
        
            /** Applique le filtre instantané aux cartes déjà chargées. */
            function filterTalents() {
                const query = normalizeText(input.value);
                
                // Afficher/cacher le bouton clear
                if (clearBtn) {
                    clearBtn.style.display = query.length > 0 ? 'flex' : 'none';
                }
        
                let visibleCount = 0;
        
                cards.forEach((card) => {
                    const searchableNode = card.querySelector('.vip-search-data');
                    const searchableText = normalizeText(
                        searchableNode ? searchableNode.textContent : card.textContent
                    );
        
                    const matches = query === '' || searchableText.includes(query);
        
                    if (matches) {
                        card.style.display = '';
                        card.style.opacity = '1';
                        card.style.transform = 'translateY(0)';
                        card.style.transition = 'all 0.3s ease';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                        card.style.opacity = '0';
                        card.style.transform = 'translateY(10px)';
                        card.style.transition = 'all 0.3s ease';
                    }
                });
        
                // Mettre àjour le compteur
                updateResultCount(visibleCount);
        
                // Gérer la pagination
                if (pagination) {
                    pagination.style.display = query !== '' ? 'none' : '';
                }
        
                // Gérer le message "aucun résultat"
                if (emptyAlert) {
                    if (cards.length > 0) {
                        emptyAlert.style.display = visibleCount === 0 ? '' : 'none';
                        if (visibleCount === 0) {
                            emptyAlert.textContent = "Aucun profil ne correspond àvotre recherche.";
                        }
                    }
                }
            }
        
            // Événements
            let debounceTimer;
            input.addEventListener('input', function() {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(filterTalents, 150);
            });
            
            // Raccourci clavier Ctrl+K ou Cmd+K
            document.addEventListener('keydown', function(e) {
                if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                    e.preventDefault();
                    input.focus();
                    input.select();
                }
                if (e.key === 'Escape') {
                    input.blur();
                }
            });
        
            // Bouton clear
            if (clearBtn) {
                clearBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    input.value = '';
                    input.focus();
                    filterTalents();
                });
            }
        
            // Focus sur la recherche avec animation
            input.addEventListener('focus', function() {
                this.closest('.search-input-wrapper').classList.add('focused');
            });
        
            input.addEventListener('blur', function() {
                this.closest('.search-input-wrapper').classList.remove('focused');
            });
        
            // Initialisation
            filterTalents();
        });
    </script>


