    <script>
// ============================================
// FONCTIONS DE GESTION DES AMIS
// ============================================

/** Initialise et synchronise les boutons de relation entre utilisateurs. */
function initFriendButtons() {
    if (!window.MOL_FRIEND) return;

    /** Exécute une requête AJAX et exige une réponse JSON valide. */
    async function ajaxJson(url, options = {}) {
        const res = await fetch(url, {
            ...options,
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                ...(options.headers || {}),
            },
        });

        if (res.redirected) {
            window.location.href = res.url;
            return null;
        }

        if (!res.ok) {
            const text = await res.text().catch(() => '');
            throw new Error(`HTTP ${res.status} ${text}`);
        }

        const ct = res.headers.get('content-type') || '';
        return ct.includes('application/json') ? await res.json() : {};
    }

    /** Remplace l'identifiant sécurisé dans un modèle d'URL. */
    function tplUrl(tpl, id) {
        id = String(id || '').trim();

        if (!/^\d+$/.test(id)) {
            throw new Error('ID utilisateur invalide : ' + id);
        }

        return String(tpl)
            .replace('__ID__', encodeURIComponent(id))
            .replace(/\/0\b/, '/' + encodeURIComponent(id));
    }

    /** Active ou désactive l'état de chargement d'un bouton. */
    function setBtnLoading(btn, loading) {
        btn.disabled = loading;
        btn.classList.toggle('disabled', !!loading);
        btn.dataset.loading = loading ? '1' : '0';
    }

    /** Adapte le bouton d'amitié à l'état courant de la relation. */
    function updateFriendButton(btn, state, friendshipId) {
        btn.classList.remove('btn-primary', 'btn-danger', 'btn-secondary', 'btn-light');
        btn.disabled = false;

        if (friendshipId) btn.dataset.friendshipId = String(friendshipId);
        else delete btn.dataset.friendshipId;

        const labelEl = btn.querySelector('.label');
        if (!labelEl) return;

        btn.onclick = null;

        switch (state) {
            case 'none':
                btn.classList.add('btn-primary');
                labelEl.innerText = "Demande d’amitié";
                btn.onclick = () => sendFriendRequest(btn);
                break;
            case 'pending_sent':
                btn.classList.add('btn-danger');
                labelEl.innerText = "Annuler la demande";
                btn.onclick = () => cancelFriendRequest(btn);
                break;
            case 'pending_received':
                btn.classList.add('btn-secondary');
                labelEl.innerText = "Répondre àla demande";
                btn.onclick = () => promptAcceptReject(btn);
                break;
            case 'friends':
                btn.classList.add('btn-danger');
                labelEl.innerText = "Bloquer";
                btn.onclick = () => confirmBlock(btn);
                break;
            case 'blocked':
                btn.classList.add('btn-secondary');
                btn.disabled = true;
                labelEl.innerText = "Vous ne pouvez pas demander l’amitié";
                break;
            default:
                btn.classList.add('btn-primary');
                labelEl.innerText = "Demande d’amitié";
                btn.onclick = () => sendFriendRequest(btn);
        }
    }

    /** Charge l'état d'amitié du profil associé au bouton. */
    async function loadState(btn) {
        const userId = btn.dataset.user;
        const url = tplUrl(window.MOL_FRIEND.stateUrlTpl, userId);

        try {
            setBtnLoading(btn, true);
            const data = await ajaxJson(url);
            updateFriendButton(btn, data.state || 'none', data.friendshipId || null);
        } catch (e) {
            console.error(e);
            updateFriendButton(btn, 'none', null);
        } finally {
            setBtnLoading(btn, false);
        }
    }

    /** Envoie une demande d'amitié puis rafraîchit le bouton. */
    async function sendFriendRequest(btn) {
        const userId = btn.dataset.user;
        try {
            await ajaxJson(tplUrl(window.MOL_FRIEND.requestUrlTpl, userId), { method: 'POST' });
            await loadState(btn);
        } catch (e) {
            console.error(e);
            notify('error', 'Erreur', "Impossible d'envoyer la demande.");
        }
    }

    /** Annule une demande d'amitié après confirmation. */
    async function cancelFriendRequest(btn) {
        const userId = btn.dataset.user;
        const ok = await askConfirm('Annuler la demande ?', "La demande d’amitié sera supprimée.");
        if (!ok) return;

        try {
            await ajaxJson(tplUrl(window.MOL_FRIEND.cancelUrlTpl, userId), { method: 'POST' });
            await loadState(btn);
        } catch (e) {
            console.error(e);
            notify('error', 'Erreur', "Impossible d'annuler la demande.");
        }
    }

    /** Bloque l'utilisateur ciblé et recharge l'état de relation. */
    async function blockUser(btn) {
        const userId = btn.dataset.user;
        await ajaxJson(tplUrl(window.MOL_FRIEND.blockUrlTpl, userId), { method: 'POST' });
        await loadState(btn);
    }

    /** Demande une confirmation avant de bloquer un utilisateur. */
    async function confirmBlock(btn) {
        const ok = await askConfirm('Bloquer cet utilisateur ?', "Vous ne recevrez plus de demandes ni de messages de sa part.");
        if (ok) await blockUser(btn);
    }

    /** Accepte une demande d'amitié reçue. */
    async function acceptFriendship(btn, friendshipId) {
        await ajaxJson(tplUrl(window.MOL_FRIEND.acceptUrlTpl, friendshipId), { method: 'POST' });
        await loadState(btn);
    }

    /** Refuse une demande d'amitié reçue. */
    async function rejectFriendship(btn, friendshipId) {
        await ajaxJson(tplUrl(window.MOL_FRIEND.rejectUrlTpl, friendshipId), { method: 'POST' });
        await loadState(btn);
    }

    /** Présente les choix d'acceptation ou de refus. */
    async function promptAcceptReject(btn) {
        const friendshipId = btn.dataset.friendshipId;
        if (!friendshipId) return;

        if (window.Swal) {
            const r = await Swal.fire({
                icon: 'question',
                title: 'Demande d’amitié',
                text: 'Voulez-vous accepter cette demande ?',
                showDenyButton: true,
                showCancelButton: true,
                confirmButtonText: 'Accepter',
                denyButtonText: 'Refuser',
                cancelButtonText: 'Plus tard',
                confirmButtonColor: '#2563eb'
            });

            if (r.isConfirmed) await acceptFriendship(btn, friendshipId);
            else if (r.isDenied) await rejectFriendship(btn, friendshipId);
            return;
        }

        const ok = confirm('Accepter cette demande ?');
        if (ok) await acceptFriendship(btn, friendshipId);
    }

    /** Affiche une confirmation compatible avec ou sans SweetAlert. */
    function askConfirm(title, text) {
        if (window.Swal) {
            return Swal.fire({
                title: title,
                text: text,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Oui',
                cancelButtonText: 'Non',
                confirmButtonColor: '#dc2626'
            }).then(r => r.isConfirmed);
        }
        return Promise.resolve(confirm(title + '\n' + text));
    }

    /** Affiche une notification utilisateur cohérente avec l'interface. */
    function notify(type, title, message) {
        if (window.Swal) {
            Swal.fire({
                icon: type === 'error' ? 'error' : 'info',
                title: title,
                text: message,
                confirmButtonColor: '#2563eb'
            });
        } else {
            alert(message);
        }
    }

    // Initialiser tous les boutons
    document.querySelectorAll('.mol-friend-btn').forEach(loadState);
}

