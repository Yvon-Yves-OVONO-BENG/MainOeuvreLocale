<style>
  :root{
    --m-bg-1:#07111f;
    --m-bg-2:#0f1b33;
    --m-card:rgba(255,255,255,.10);
    --m-line:rgba(255,255,255,.12);
    --m-text:#edf2ff;
    --m-muted:rgba(237,242,255,.72);
    --m-primary:#7c3aed;
    --m-cyan:#06b6d4;
    --m-warning:#f59e0b;
    --m-shadow:0 30px 90px rgba(2,6,23,.45);
  }

  .m-shell{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:24px;
    color:var(--m-text);
    background:
      radial-gradient(1100px circle at 10% 10%, rgba(124,58,237,.22), transparent 38%),
      radial-gradient(900px circle at 90% 8%, rgba(6,182,212,.16), transparent 36%),
      radial-gradient(900px circle at 50% 100%, rgba(245,158,11,.10), transparent 34%),
      linear-gradient(180deg, var(--m-bg-1), var(--m-bg-2));
    overflow:hidden;
    position:relative;
  }

  .m-shell::before,
  .m-shell::after{
    content:"";
    position:absolute;
    border-radius:999px;
    filter:blur(40px);
    opacity:.25;
    pointer-events:none;
  }

  .m-shell::before{
    width:260px;
    height:260px;
    background:#7c3aed;
    top:8%;
    left:6%;
  }

  .m-shell::after{
    width:220px;
    height:220px;
    background:#06b6d4;
    bottom:10%;
    right:8%;
  }

  .m-card{
    width:100%;
    max-width:980px;
    border:1px solid var(--m-line);
    background:linear-gradient(180deg, rgba(255,255,255,.12), rgba(255,255,255,.08));
    box-shadow:var(--m-shadow);
    border-radius:34px;
    backdrop-filter:blur(18px);
    overflow:hidden;
    position:relative;
  }

  .m-grid{
    display:grid;
    grid-template-columns:1.1fr .9fr;
  }

  .m-left{
    padding:42px 38px;
  }

  .m-badge{
    display:inline-flex;
    align-items:center;
    gap:10px;
    padding:10px 16px;
    border-radius:999px;
    font-size:12px;
    font-weight:900;
    letter-spacing:.08em;
    text-transform:uppercase;
    background:rgba(255,255,255,.08);
    border:1px solid rgba(255,255,255,.10);
  }

  .m-title{
    margin:18px 0 10px;
    font-size:46px;
    line-height:1.02;
    font-weight:950;
    letter-spacing:-.05em;
  }

  .m-text{
    font-size:16px;
    line-height:1.8;
    color:var(--m-muted);
    max-width:560px;
  }

  .m-status{
    margin-top:24px;
    display:flex;
    flex-wrap:wrap;
    gap:12px;
  }

  .m-pill{
    display:inline-flex;
    align-items:center;
    gap:10px;
    padding:12px 16px;
    border-radius:18px;
    background:rgba(255,255,255,.07);
    border:1px solid rgba(255,255,255,.08);
    font-size:14px;
    font-weight:800;
  }

  .m-right{
    border-left:1px solid rgba(255,255,255,.08);
    padding:38px 30px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:
      radial-gradient(520px circle at 50% 50%, rgba(124,58,237,.16), transparent 46%);
  }

  .m-illustration{
    width:100%;
    max-width:300px;
    aspect-ratio:1/1;
    border-radius:32px;
    background:
      linear-gradient(180deg, rgba(255,255,255,.12), rgba(255,255,255,.06));
    border:1px solid rgba(255,255,255,.12);
    box-shadow:0 20px 60px rgba(2,6,23,.35);
    position:relative;
    display:flex;
    align-items:center;
    justify-content:center;
  }

  .m-core{
    width:132px;
    height:132px;
    border-radius:28px;
    background:linear-gradient(180deg, rgba(124,58,237,.38), rgba(6,182,212,.22));
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:58px;
    box-shadow:0 20px 50px rgba(124,58,237,.30);
  }

  .m-ring,
  .m-ring-2{
    position:absolute;
    border-radius:999px;
    border:1px solid rgba(255,255,255,.14);
  }

  .m-ring{
    width:210px;
    height:210px;
  }

  .m-ring-2{
    width:260px;
    height:260px;
    opacity:.55;
  }

  .m-footer{
    margin-top:28px;
    padding-top:18px;
    border-top:1px solid rgba(255,255,255,.08);
    color:rgba(237,242,255,.58);
    font-size:13px;
  }

  @media (max-width: 900px){
    .m-grid{
      grid-template-columns:1fr;
    }

    .m-right{
      border-left:none;
      border-top:1px solid rgba(255,255,255,.08);
      padding-top:28px;
      padding-bottom:34px;
    }

    .m-title{
      font-size:34px;
    }
  }
</style>