<style>
    :root{
        --nl-bg:#f4f7fb;
        --nl-surface:rgba(255,255,255,.92);
        --nl-surface-2:#ffffff;
        --nl-line:rgba(15,23,42,.08);
        --nl-line-strong:rgba(15,23,42,.12);
        --nl-text:#0f172a;
        --nl-muted:#64748b;
        --nl-primary:#2563eb;
        --nl-primary-2:#1d4ed8;
        --nl-success:#16a34a;
        --nl-danger:#dc2626;
        --nl-shadow:0 24px 70px rgba(15,23,42,.10);
        --nl-radius:30px;
    }

    body{
        background:
            radial-gradient(circle at top left, rgba(37,99,235,.10), transparent 30%),
            radial-gradient(circle at top right, rgba(29,78,216,.08), transparent 28%),
            linear-gradient(180deg, #f8fbff 0%, var(--nl-bg) 100%);
    }

    .nl-wrap{
        min-height:calc(100vh - 120px);
        display:flex;
        align-items:center;
        justify-content:center;
        padding:48px 16px;
    }

    .nl-card{
        width:100%;
        max-width:760px;
        background:var(--nl-surface);
        backdrop-filter:blur(18px);
        border:1px solid var(--nl-line);
        border-radius:var(--nl-radius);
        box-shadow:var(--nl-shadow);
        overflow:hidden;
    }

    .nl-hero{
        padding:34px 34px 28px;
        background:linear-gradient(135deg,#0f172a 0%, #1d4ed8 55%, #60a5fa 100%);
        color:#fff;
    }

    .nl-badge{
        display:inline-flex;
        align-items:center;
        gap:8px;
        padding:8px 14px;
        border-radius:999px;
        background:rgba(255,255,255,.14);
        font-size:12px;
        font-weight:700;
        letter-spacing:.05em;
        text-transform:uppercase;
    }

    .nl-hero h1{
        margin:18px 0 10px;
        font-size:30px;
        line-height:1.15;
        font-weight:800;
    }

    .nl-hero p{
        margin:0;
        color:rgba(255,255,255,.88);
        font-size:15px;
        line-height:1.75;
        max-width:560px;
    }

    .nl-body{
        padding:34px;
    }

    .nl-panel{
        padding:24px;
        border:1px solid var(--nl-line);
        border-radius:24px;
        background:linear-gradient(180deg,#fff,#f8fbff);
    }

    .nl-email{
        display:inline-flex;
        align-items:center;
        gap:10px;
        padding:10px 14px;
        border-radius:999px;
        background:#eef4ff;
        color:#1d4ed8;
        font-weight:700;
        margin-top:10px;
        word-break:break-all;
    }

    .nl-text{
        margin-top:18px;
        color:var(--nl-muted);
        font-size:15px;
        line-height:1.85;
    }

    .nl-actions{
        display:flex;
        flex-wrap:wrap;
        gap:14px;
        margin-top:26px;
    }

    .nl-btn{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        min-height:52px;
        padding:0 22px;
        border-radius:16px;
        border:none;
        text-decoration:none;
        font-weight:800;
        font-size:14px;
        transition:.25s ease;
        cursor:pointer;
    }

    .nl-btn-primary{
        background:linear-gradient(135deg,var(--nl-primary),var(--nl-primary-2));
        color:#fff;
        box-shadow:0 14px 30px rgba(37,99,235,.22);
    }

    .nl-btn-primary:hover{
        transform:translateY(-1px);
        color:#fff;
    }

    .nl-btn-danger{
        background:linear-gradient(135deg,#ef4444,#dc2626);
        color:#fff;
        box-shadow:0 14px 30px rgba(220,38,38,.18);
    }

    .nl-btn-danger:hover{
        transform:translateY(-1px);
        color:#fff;
    }

    .nl-btn-light{
        background:#fff;
        color:var(--nl-text);
        border:1px solid var(--nl-line-strong);
    }

    .nl-state{
        display:flex;
        align-items:flex-start;
        gap:14px;
        padding:18px 20px;
        border-radius:20px;
        margin-top:20px;
        font-size:14px;
        line-height:1.75;
    }

    .nl-state-success{
        background:rgba(22,163,74,.08);
        border:1px solid rgba(22,163,74,.18);
        color:#166534;
    }

    @media (max-width: 768px){
        .nl-hero,.nl-body{padding:24px;}
        .nl-hero h1{font-size:24px;}
        .nl-actions{flex-direction:column;}
        .nl-btn{width:100%;}
    }
</style>