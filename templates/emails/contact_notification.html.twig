<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
    <head>
        <meta charset="UTF-8">
        <title>{% trans %}Nouveau message de contact{% endtrans %}</title>
    </head>
    <body style="margin:0;padding:24px;background:#f4f7fb;font-family:Arial,Helvetica,sans-serif;color:#0f172a;">
        <div style="max-width:700px;margin:0 auto;background:#ffffff;border:1px solid #e5e7eb;border-radius:18px;overflow:hidden;">
            <div style="padding:20px 24px;background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#ffffff;">
                <h1 style="margin:0;font-size:22px;line-height:1.2;">
                    {% trans %}Nouveau message de contact{% endtrans %}
                </h1>
            </div>

            <div style="padding:24px;">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0"
                       style="border-collapse:collapse;">
                    <tr>
                        <td style="padding:10px 0;border-bottom:1px solid #eef2f7;font-size:14px;">
                            <strong>{% trans %}Nom :{% endtrans %}</strong>
                            {{ messageEntity.name }}
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:10px 0;border-bottom:1px solid #eef2f7;font-size:14px;">
                            <strong>{% trans %}Email :{% endtrans %}</strong>
                            {{ messageEntity.email }}
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:10px 0;border-bottom:1px solid #eef2f7;font-size:14px;">
                            <strong>{% trans %}Téléphone :{% endtrans %}</strong>
                            {% if messageEntity.phone %}
                                {{ messageEntity.phone }}
                            {% else %}
                                {% trans %}Non renseigné{% endtrans %}
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:10px 0;border-bottom:1px solid #eef2f7;font-size:14px;">
                            <strong>{% trans %}Sujet :{% endtrans %}</strong>
                            {{ subjectLabel|trans }}
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:10px 0;border-bottom:1px solid #eef2f7;font-size:14px;">
                            <strong>{% trans %}Date :{% endtrans %}</strong>
                            {{ messageEntity.createdAt|date('d/m/Y H:i') }}
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:16px 0 4px;font-size:14px;">
                            <strong>{% trans %}Message :{% endtrans %}</strong>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:0 0 8px;font-size:14px;line-height:1.8;color:#334155;white-space:pre-line;">
                            {{ messageEntity.message }}
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </body>
</html>