<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Nouveau message de contact</title>
</head>
<body style="margin:0;padding:24px;background:#f4f7fb;font-family:Arial,Helvetica,sans-serif;color:#0f172a;">
    <div style="max-width:700px;margin:0 auto;background:#ffffff;border:1px solid #e5e7eb;border-radius:18px;overflow:hidden;">
        <div style="padding:20px 24px;background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#ffffff;">
            <h1 style="margin:0;font-size:22px;line-height:1.2;">Nouveau message de contact</h1>
            <p style="margin:8px 0 0;font-size:13px;opacity:.92;">Snap Exam Pro</p>
        </div>

        <div style="padding:24px;">
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                <tr>
                    <td style="padding:10px 0;border-bottom:1px solid #eef2f7;font-size:14px;">
                        <strong>ID :</strong> #{{ messageEntity.id }}
                    </td>
                </tr>
                <tr>
                    <td style="padding:10px 0;border-bottom:1px solid #eef2f7;font-size:14px;">
                        <strong>Nom :</strong> {{ messageEntity.name }}
                    </td>
                </tr>
                <tr>
                    <td style="padding:10px 0;border-bottom:1px solid #eef2f7;font-size:14px;">
                        <strong>Email :</strong> {{ messageEntity.email }}
                    </td>
                </tr>
                <tr>
                    <td style="padding:10px 0;border-bottom:1px solid #eef2f7;font-size:14px;">
                        <strong>Téléphone :</strong> {{ messageEntity.phone ?: 'Non renseigné' }}
                    </td>
                </tr>
                <tr>
                    <td style="padding:10px 0;border-bottom:1px solid #eef2f7;font-size:14px;">
                        <strong>Sujet :</strong> {{ subjectLabel }}
                    </td>
                </tr>
                <tr>
                    <td style="padding:10px 0;border-bottom:1px solid #eef2f7;font-size:14px;">
                        <strong>Date :</strong> {{ messageEntity.createdAt|date('d/m/Y H:i') }}
                    </td>
                </tr>
                <tr>
                    <td style="padding:16px 0 4px;font-size:14px;">
                        <strong>Message :</strong>
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 0 8px;font-size:14px;line-height:1.8;color:#334155;white-space:pre-line;">
                        {{ messageEntity.message }}
                    </td>
                </tr>
            </table>
        </div>
    </div>
</body>
</html>