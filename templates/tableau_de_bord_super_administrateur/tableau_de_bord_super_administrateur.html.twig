<div id="saToastWrap" class="sa-toast-wrap"></div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
(function () {
  const root = document.documentElement;

  function saToast(message) {
    const wrap = document.getElementById('saToastWrap');
    const el = document.createElement('div');
    el.className = 'sa-toast';
    el.innerHTML = `<div class="font-semibold">Action console</div><div class="text-sm mt-1 text-slate-300">${message}</div>`;
    wrap.appendChild(el);
    setTimeout(() => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(8px)';
      el.style.transition = '.25s ease';
      setTimeout(() => el.remove(), 260);
    }, 2600);
  }

  function bindActions() {
    document.querySelectorAll('[data-sa-action]').forEach(btn => {
      btn.addEventListener('click', function () {
        const action = this.getAttribute('data-sa-action');
        saToast(`À brancher côté backend : ${action}`);
      });
    });
  }

  bindActions();

  const tabs = document.querySelectorAll('[data-tab-btn]');
  const panels = document.querySelectorAll('[data-tab-panel]');

  tabs.forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-tab-btn');
      tabs.forEach(b => b.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      const panel = document.querySelector(`[data-tab-panel="${key}"]`);
      if (panel) panel.classList.add('active');
    });
  });

  const sidebarBtn = document.getElementById('saOpenSidebar');
  const sidebar = document.getElementById('saSidebarMobile');
  const sidebarBackdrop = document.getElementById('saSidebarBackdrop');
  const closeSidebar = document.getElementById('saCloseSidebar');

  function openSidebar() {
    sidebar?.classList.add('open');
    sidebarBackdrop?.classList.add('open');
  }
  function closeSidebarFn() {
    sidebar?.classList.remove('open');
    sidebarBackdrop?.classList.remove('open');
  }

  sidebarBtn?.addEventListener('click', openSidebar);
  closeSidebar?.addEventListener('click', closeSidebarFn);
  sidebarBackdrop?.addEventListener('click', closeSidebarFn);

  const cmdModal = document.getElementById('saCommandModal');
  const cmdOpen = document.getElementById('saOpenCommand');
  const cmdClose = document.getElementById('saCloseCommand');
  const cmdInput = document.getElementById('saCommandInput');

  function openCommand() {
    cmdModal?.classList.add('open');
    setTimeout(() => cmdInput?.focus(), 30);
  }
  function closeCommand() {
    cmdModal?.classList.remove('open');
  }

  cmdOpen?.addEventListener('click', openCommand);
  cmdClose?.addEventListener('click', closeCommand);
  cmdModal?.addEventListener('click', function (e) {
    if (e.target === cmdModal) closeCommand();
  });

  document.addEventListener('keydown', function (e) {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      openCommand();
    }
    if (e.key === 'Escape') closeCommand();
    if (e.key === '/' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA') {
      e.preventDefault();
      document.getElementById('saGlobalSearch')?.focus();
    }
  });

  const globalSearch = document.getElementById('saGlobalSearch');
  const searchableItems = document.querySelectorAll('[data-search-item]');

  globalSearch?.addEventListener('input', function () {
    const q = this.value.trim().toLowerCase();
    searchableItems.forEach(el => {
      const hay = (el.getAttribute('data-search-item') || '').toLowerCase();
      if (!q || hay.includes(q)) {
        el.style.display = '';
      } else {
        el.style.display = 'none';
      }
    });
  });

  function updateClock() {
    const el = document.getElementById('saLiveClock');
    if (!el) return;
    const d = new Date();
    const hh = String(d.getHours()).padStart(2, '0');
    const mm = String(d.getMinutes()).padStart(2, '0');
    const ss = String(d.getSeconds()).padStart(2, '0');
    el.textContent = `${hh}:${mm}:${ss}`;
  }
  updateClock();
  setInterval(updateClock, 1000);

  document.querySelectorAll('[data-count]').forEach(el => {
    const raw = parseInt((el.getAttribute('data-count') || '0').replace(/\s+/g, ''), 10) || 0;
    const duration = 900;
    const start = performance.now();
    function tick(now) {
      const p = Math.min((now - start) / duration, 1);
      const v = Math.floor(raw * p);
      el.textContent = new Intl.NumberFormat('fr-FR').format(v);
      if (p < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  });

  const defaultMonths = ["Jan","Fév","Mar","Avr","Mai","Juin","Juil","Aoû","Sep","Oct","Nov","Déc"];

  const signupsRaw = {{ charts.signupsByMonth|default([])|json_encode|raw }};
  const signupsLabels = signupsRaw.length ? signupsRaw.map(x => x.ym) : defaultMonths;
  const signupsValues = signupsRaw.length ? signupsRaw.map(x => parseInt(x.c, 10) || 0) : [14, 19, 24, 28, 35, 46, 42, 58, 63, 69, 74, 88];

  const split = {{ charts.usersSplit|default({'company':34,'talent':48,'particulier':22,'staff':8})|json_encode|raw }};
  const jobs = {{ charts.jobsVsRecruits|default({'jobs':128,'recruited':76})|json_encode|raw }};
  const mod = {{ charts.moderation|default({'spam':12,'abuse':8,'fraud':6,'identity':4,'other':7})|json_encode|raw }};

  const revenueRaw = {{ charts.revenueSeries|default([])|json_encode|raw }};
  const revenueLabels = revenueRaw.length ? revenueRaw.map(x => x.label) : defaultMonths;
  const revenueValues = revenueRaw.length ? revenueRaw.map(x => parseInt(x.value, 10) || 0) : [420000, 560000, 640000, 720000, 980000, 1100000, 1210000, 1340000, 1460000, 1710000, 2030000, 2450000];

  const healthRaw = {{ charts.healthSeries|default([])|json_encode|raw }};
  const healthLabels = healthRaw.length ? healthRaw.map(x => x.label) : ["Lun","Mar","Mer","Jeu","Ven","Sam","Dim"];
  const latencyValues = healthRaw.length ? healthRaw.map(x => parseInt(x.latency, 10) || 0) : [180, 176, 191, 169, 174, 186, 182];
  const errorValues = healthRaw.length ? healthRaw.map(x => parseFloat(x.errors) || 0) : [0.22, 0.18, 0.31, 0.15, 0.19, 0.26, 0.24];

  const plans = {{ plansData|default([])|json_encode|raw }};
  const planLabels = plans.length ? plans.map(x => x.name) : ['Starter','Pro','Business','Enterprise'];
  const planValues = plans.length ? plans.map(x => parseInt(x.count, 10) || 0) : [64, 81, 29, 10];

  const gridColor = 'rgba(255,255,255,.07)';
  const labelColor = '#cfe0f8';

  const commonOptions = {
    responsive: true,
    plugins: {
      legend: { labels: { color: labelColor, boxWidth: 10, usePointStyle: true } },
      tooltip: {
        backgroundColor: 'rgba(8,12,24,.96)',
        borderColor: 'rgba(255,255,255,.10)',
        borderWidth: 1,
        titleColor: '#fff',
        bodyColor: '#dce8fa',
        padding: 12
      }
    },
    scales: {
      x: { ticks: { color: labelColor }, grid: { color: gridColor } },
      y: { ticks: { color: labelColor }, grid: { color: gridColor } }
    }
  };

  const elSignups = document.getElementById('chartSignups');
  if (elSignups) {
    new Chart(elSignups, {
      type: 'line',
      data: {
        labels: signupsLabels,
        datasets: [{
          label: 'Inscriptions',
          data: signupsValues,
          borderColor: '#6d7cff',
          backgroundColor: 'rgba(109,124,255,.18)',
          fill: true,
          tension: .35,
          pointRadius: 2,
          pointBackgroundColor: '#c5d1ff'
        }]
      },
      options: commonOptions
    });
  }

  const elSplit = document.getElementById('chartUsersSplit');
  if (elSplit) {
    new Chart(elSplit, {
      type: 'doughnut',
      data: {
        labels: ['Company', 'Talent', 'Particulier', 'Staff'],
        datasets: [{
          data: [split.company || 0, split.talent || 0, split.particulier || 0, split.staff || 0],
          backgroundColor: ['#6d7cff', '#26c6ff', '#1fd28b', '#f7b84b'],
          borderWidth: 0
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false } },
        cutout: '68%'
      }
    });
  }

  const elJobs = document.getElementById('chartJobs');
  if (elJobs) {
    new Chart(elJobs, {
      type: 'bar',
      data: {
        labels: ['Offres', 'Recrutés'],
        datasets: [{
          label: 'Volume',
          data: [jobs.jobs || 0, jobs.recruited || 0],
          backgroundColor: ['rgba(38,198,255,.75)', 'rgba(31,210,139,.75)'],
          borderRadius: 12,
          borderSkipped: false
        }]
      },
      options: commonOptions
    });
  }

  const elMod = document.getElementById('chartModeration');
  if (elMod) {
    new Chart(elMod, {
      type: 'radar',
      data: {
        labels: ['Spam', 'Abus', 'Fraude', 'Identité', 'Autres'],
        datasets: [{
          label: 'Signalements',
          data: [mod.spam || 0, mod.abuse || 0, mod.fraud || 0, mod.identity || 0, mod.other || 0],
          borderColor: '#ff6d8a',
          backgroundColor: 'rgba(255,109,138,.18)',
          pointBackgroundColor: '#ffd8e1'
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { labels: { color: labelColor } } },
        scales: {
          r: {
            grid: { color: gridColor },
            angleLines: { color: gridColor },
            pointLabels: { color: labelColor },
            ticks: { backdropColor: 'transparent', color: labelColor }
          }
        }
      }
    });
  }

  const elModSecurity = document.getElementById('chartModerationSecurity');
  if (elModSecurity) {
    new Chart(elModSecurity, {
      type: 'polarArea',
      data: {
        labels: ['Spam', 'Abus', 'Fraude', 'Identité', 'Autres'],
        datasets: [{
          data: [mod.spam || 0, mod.abuse || 0, mod.fraud || 0, mod.identity || 0, mod.other || 0],
          backgroundColor: ['rgba(109,124,255,.65)', 'rgba(38,198,255,.65)', 'rgba(255,109,138,.65)', 'rgba(247,184,75,.65)', 'rgba(31,210,139,.65)'],
          borderWidth: 0
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { labels: { color: labelColor } } },
        scales: {
          r: {
            grid: { color: gridColor },
            ticks: { backdropColor: 'transparent', color: labelColor },
            pointLabels: { color: labelColor }
          }
        }
      }
    });
  }

  const elRevenue = document.getElementById('chartRevenue');
  if (elRevenue) {
    new Chart(elRevenue, {
      type: 'line',
      data: {
        labels: revenueLabels,
        datasets: [{
          label: 'MRR',
          data: revenueValues,
          borderColor: '#1fd28b',
          backgroundColor: 'rgba(31,210,139,.16)',
          fill: true,
          tension: .35,
          pointRadius: 2
        }]
      },
      options: commonOptions
    });
  }

  const elPlans = document.getElementById('chartPlans');
  if (elPlans) {
    new Chart(elPlans, {
      type: 'doughnut',
      data: {
        labels: planLabels,
        datasets: [{
          data: planValues,
          backgroundColor: ['#6d7cff', '#26c6ff', '#1fd28b', '#f7b84b'],
          borderWidth: 0
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false } },
        cutout: '64%'
      }
    });
  }

  const elHealth = document.getElementById('chartHealth');
  if (elHealth) {
    new Chart(elHealth, {
      type: 'line',
      data: {
        labels: healthLabels,
        datasets: [
          {
            label: 'Latency ms',
            data: latencyValues,
            borderColor: '#26c6ff',
            backgroundColor: 'rgba(38,198,255,.14)',
            fill: true,
            tension: .35,
            yAxisID: 'y'
          },
          {
            label: 'Error rate %',
            data: errorValues,
            borderColor: '#ff6d8a',
            backgroundColor: 'rgba(255,109,138,.08)',
            tension: .35,
            yAxisID: 'y1'
          }
        ]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { labels: { color: labelColor, boxWidth: 10, usePointStyle: true } }
        },
        scales: {
          x: { ticks: { color: labelColor }, grid: { color: gridColor } },
          y: {
            position: 'left',
            ticks: { color: labelColor },
            grid: { color: gridColor }
          },
          y1: {
            position: 'right',
            ticks: { color: labelColor },
            grid: { drawOnChartArea: false, color: gridColor }
          }
        }
      }
    });
  }
})();
</script>
