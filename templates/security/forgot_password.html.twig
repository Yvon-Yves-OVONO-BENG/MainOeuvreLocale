{% extends 'baseLoginRegister.html.twig' %}

{% block title %}{% trans %}Mot de passe oublié – Main d'Oeuvre Locale{% endtrans %}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('css/auth/forgotPassword.css') }}?v=20260830-1">
{% endblock %}

{% block body %}

<section class="auth-wrap">
  <div class="auth-card">
    <a href="{{ path('accueil') }}" class="home-btn" data-turbo="false">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M3 10.5 12 3l9 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M5 10v10a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>{% trans %}Accueil{% endtrans %}</span>
    </a>

    <h1 class="auth-title">{% trans %}Mot de passe oublié{% endtrans %}</h1>
    <p class="auth-subtitle">
      {% trans %}Entrez votre email pour recevoir le lien de réinitialisation.{% endtrans %}
    </p>

    {# Retour explicite après l'envoi du courriel ou en cas d'incident. #}
    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div class="alert alert-{{ label }} forgot-flash" role="alert" aria-live="polite">
          {% if label == 'success' %}<i class="fa-solid fa-circle-check" aria-hidden="true"></i>{% endif %}
          {% if label == 'danger' %}<i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>{% endif %}
          <span>{{ message }}</span>
        </div>
      {% endfor %}
    {% endfor %}

    {{ form_start(form, {
	attr: {
		id: 'forgotPasswordForm',
		novalidate: 'novalidate',
		'data-turbo': 'false'
	}
	}) }}

      <div class="floating-field">
        <span class="field-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M4 7.5A2.5 2.5 0 0 1 6.5 5h11A2.5 2.5 0 0 1 20 7.5v9A2.5 2.5 0 0 1 17.5 19h-11A2.5 2.5 0 0 1 4 16.5v-9Z" stroke="currentColor" stroke-width="2"/>
            <path d="M5.5 7.5 12 12l6.5-4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>

        {{ form_widget(form.email, {
          attr: {
            class: 'form-control in',
            placeholder: ' ',
            autocomplete: 'email',
            required: 'required',
            autofocus: 'autofocus',
            id: 'forgot_email'
          }
        }) }}

        <label for="forgot_email" class="floating-label">
          {% trans %}Adresse email{% endtrans %}
        </label>
      </div>

      {{ form_errors(form.email) }}

      <input type="hidden" value="{{ csrfToken }}" name="csrfToken">

      <button class="btn-send" type="submit">
        {% trans %}Envoyer le lien{% endtrans %}
      </button>

      <div class="auth-links">
        <a href="{{ path('app_login') }}" class="muted-link">
          {% trans %}Retour à la connexion{% endtrans %}
        </a>

        <a href="{{ path('app_register') }}" class="muted-link">
          {% trans %}Créer un compte{% endtrans %}
        </a>
      </div>

    {{ form_end(form) }}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.floating-field .form-control.in').forEach(function (input) {
      const field = input.closest('.floating-field');

      if (!field) return;

      function refresh() {
        field.classList.toggle('has-value', (input.value || '').trim() !== '');
      }

      input.addEventListener('input', refresh);
      input.addEventListener('change', refresh);
      refresh();
    });

    const form = document.getElementById('forgotPasswordForm');
    const emailInput = document.getElementById('forgot_email');
    const submitBtn = form ? form.querySelector('.btn-send') : null;

    if (!form || !emailInput) return;

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    let message = document.getElementById('forgotEmailMessage');

    if (!message) {
      message = document.createElement('div');
      message.id = 'forgotEmailMessage';
      message.className = 'forgot-field-message';
      emailInput.closest('.floating-field').insertAdjacentElement('afterend', message);
    }

    function getBox() {
      return emailInput.closest('.floating-field') || emailInput.parentElement;
    }

    function shakeEmail(text) {
      const box = getBox();

      emailInput.classList.add('is-invalid');

      message.textContent = text || 'Adresse email requise';
      message.classList.add('show');

      if (box) {
        box.classList.remove('forgot-vibrate');
        void box.offsetWidth;
        box.classList.add('forgot-vibrate');

        setTimeout(function () {
          box.classList.remove('forgot-vibrate');
        }, 450);
      }

      if (navigator.vibrate) {
        navigator.vibrate([80, 40, 80]);
      }

      emailInput.focus();
    }

    function clearEmailError() {
      const box = getBox();

      emailInput.classList.remove('is-invalid');

      if (box) {
        box.classList.remove('forgot-vibrate');
      }

      message.textContent = '';
      message.classList.remove('show');
    }

    function validateForgotEmail() {
      const value = emailInput.value.trim();

      if (!value) {
        shakeEmail('Adresse email requise');
        return false;
      }

      if (!emailRegex.test(value)) {
        shakeEmail('Adresse email non valide');
        return false;
      }

      clearEmailError();
      return true;
    }

    emailInput.addEventListener('input', clearEmailError);
    emailInput.addEventListener('change', clearEmailError);

    if (submitBtn) {
      submitBtn.addEventListener('click', function (event) {
        if (!validateForgotEmail()) {
          event.preventDefault();
          event.stopImmediatePropagation();
        }
      }, true);
    }

    form.addEventListener('submit', function (event) {
      if (!validateForgotEmail()) {
        event.preventDefault();
        event.stopImmediatePropagation();
      }
    }, true);
  });
</script>

<script>
	(function () {
	function initForgotPasswordValidation() {
		const emailInput =
		document.getElementById('forgot_email') ||
		document.querySelector('input[type="email"]') ||
		document.querySelector('input[name$="[email]"]');

		if (!emailInput || emailInput.dataset.vibrateReady === '1') return;

		emailInput.dataset.vibrateReady = '1';

		const form = emailInput.closest('form');
		if (!form) return;

		form.setAttribute('novalidate', 'novalidate');

		const submitBtn = form.querySelector('button[type="submit"]');
		const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

		let message = document.getElementById('forgotEmailError');

		if (!message) {
		message = document.createElement('div');
		message.id = 'forgotEmailError';
		message.className = 'forgot-email-error';

		const field = emailInput.closest('.floating-field') || emailInput.parentElement;
		field.insertAdjacentElement('afterend', message);
		}

		function getFieldBox() {
		return emailInput.closest('.floating-field') || emailInput.parentElement;
		}

		function showError(text) {
		const box = getFieldBox();

		emailInput.classList.add('is-invalid');
		message.textContent = text;
		message.classList.add('show');

		if (box) {
			box.classList.remove('forgot-vibrate');
			void box.offsetWidth;
			box.classList.add('forgot-vibrate');

			setTimeout(function () {
			box.classList.remove('forgot-vibrate');
			}, 450);
		}

		if (navigator.vibrate) {
			navigator.vibrate([80, 40, 80]);
		}

		emailInput.focus({ preventScroll: true });
		}

		function clearError() {
		const box = getFieldBox();

		emailInput.classList.remove('is-invalid');

		if (box) {
			box.classList.remove('forgot-vibrate');
		}

		message.textContent = '';
		message.classList.remove('show');
		}

		function validateEmail() {
		const value = emailInput.value.trim();

		if (!value) {
			showError('Adresse email requise');
			return false;
		}

		if (!emailRegex.test(value)) {
			showError('Adresse email non valide');
			return false;
		}

		clearError();
		return true;
		}

		emailInput.addEventListener('input', clearError);
		emailInput.addEventListener('change', clearError);

		if (submitBtn) {
		submitBtn.addEventListener('click', function (event) {
			if (!validateEmail()) {
			event.preventDefault();
			event.stopPropagation();
			event.stopImmediatePropagation();
			}
		}, true);
		}

		form.addEventListener('submit', function (event) {
		if (!validateEmail()) {
			event.preventDefault();
			event.stopPropagation();
			event.stopImmediatePropagation();
		}
		}, true);
	}

	document.addEventListener('DOMContentLoaded', initForgotPasswordValidation);
	document.addEventListener('turbo:load', initForgotPasswordValidation);
	initForgotPasswordValidation();
	})();
</script>
{% endblock %}
