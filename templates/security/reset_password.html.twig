{% extends 'baseLoginRegister.html.twig' %}

{% block title %}
  {% trans %}Nouveau mot de passe{% endtrans %}
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('css/auth/resetPassword.css') }}">
{% endblock %}

{% block body %}


<section class="auth-wrap">
  <div class="auth-card">
    <a href="{{ path('accueil') }}" class="home-btn" data-turbo="false">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M3 10.5 12 3l9 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M5 10v10a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>{% trans %}Accueil{% endtrans %}</span>
    </a>

    <h1 class="auth-title">{% trans %}Nouveau mot de passe{% endtrans %}</h1>
    <p class="auth-subtitle">
      {% trans %}Saisissez et confirmez votre nouveau mot de passe.{% endtrans %}
    </p>

    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div class="alert alert-{{ label }}" role="alert">{{ message }}</div>
      {% endfor %}
    {% endfor %}

    {{ form_start(form, { attr: { novalidate: 'novalidate', 'data-turbo': 'false' } }) }}

      <div class="floating-field">
        <span class="field-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M7.5 10V8.2A4.5 4.5 0 0 1 12 3.7a4.5 4.5 0 0 1 4.5 4.5V10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <path d="M6.5 10h11A2.5 2.5 0 0 1 20 12.5v6A2.5 2.5 0 0 1 17.5 21h-11A2.5 2.5 0 0 1 4 18.5v-6A2.5 2.5 0 0 1 6.5 10Z" stroke="currentColor" stroke-width="2"/>
          </svg>
        </span>

        {{ form_widget(form.plainPassword.first, {
          attr: {
            class: 'form-control in',
            placeholder: ' ',
            autocomplete: 'new-password',
            required: 'required',
            minlength: '6',
            id: 'reset_password_first',
            'aria-label': 'Nouveau mot de passe'|trans
          }
        }) }}

        <label for="reset_password_first" class="floating-label">
          {% trans %}Nouveau mot de passe{% endtrans %}
        </label>

        <button type="button" class="password-toggle" aria-label="{% trans %}Afficher le mot de passe{% endtrans %}">
          <svg class="eye" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" stroke="currentColor" stroke-width="2"/>
          </svg>

          <svg class="eye-off" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 3l18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <path d="M10.6 10.6A2 2 0 0 0 13.4 13.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <path d="M9.9 5.2A9.8 9.8 0 0 1 12 5c6.5 0 10 7 10 7a18.5 18.5 0 0 1-3.1 4.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M6.1 6.8C3.5 8.6 2 12 2 12s3.5 7 10 7a9.7 9.7 0 0 0 4.2-.9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      {{ form_errors(form.plainPassword.first) }}

      <div class="floating-field">
        <span class="field-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M7.5 10V8.2A4.5 4.5 0 0 1 12 3.7a4.5 4.5 0 0 1 4.5 4.5V10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <path d="M6.5 10h11A2.5 2.5 0 0 1 20 12.5v6A2.5 2.5 0 0 1 17.5 21h-11A2.5 2.5 0 0 1 4 18.5v-6A2.5 2.5 0 0 1 6.5 10Z" stroke="currentColor" stroke-width="2"/>
            <path d="M9.5 16l1.7 1.7L15 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>

        {{ form_widget(form.plainPassword.second, {
          attr: {
            class: 'form-control in',
            placeholder: ' ',
            autocomplete: 'new-password',
            required: 'required',
            minlength: '6',
            id: 'reset_password_second',
            'aria-label': 'Répéter le mot de passe'|trans
          }
        }) }}

        <label for="reset_password_second" class="floating-label">
          {% trans %}Répéter le mot de passe{% endtrans %}
        </label>

        <button type="button" class="password-toggle" aria-label="{% trans %}Afficher le mot de passe{% endtrans %}">
          <svg class="eye" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" stroke="currentColor" stroke-width="2"/>
          </svg>

          <svg class="eye-off" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 3l18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <path d="M10.6 10.6A2 2 0 0 0 13.4 13.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <path d="M9.9 5.2A9.8 9.8 0 0 1 12 5c6.5 0 10 7 10 7a18.5 18.5 0 0 1-3.1 4.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M6.1 6.8C3.5 8.6 2 12 2 12s3.5 7 10 7a9.7 9.7 0 0 0 4.2-.9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      {{ form_errors(form.plainPassword.second) }}

      <input type="hidden" value="{{ csrfToken }}" name="csrfToken">

      <button class="btn-reset" type="submit">
        {% trans %}Valider{% endtrans %}
      </button>

      <div class="auth-links">
        <a href="{{ path('app_login') }}" class="muted-link" data-turbo="false">
          {% trans %}Retour à la connexion{% endtrans %}
        </a>
      </div>

    {{ form_end(form) }}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.floating-field .form-control.in').forEach(function (input) {
      const field = input.closest('.floating-field');

      if (!field) return;

      function refresh() {
        field.classList.toggle('has-value', (input.value || '').trim() !== '');
      }

      input.addEventListener('input', refresh);
      input.addEventListener('change', refresh);
      refresh();
    });

    document.querySelectorAll('.password-toggle').forEach(function (button) {
      button.addEventListener('click', function () {
        const field = button.closest('.floating-field');
        const input = field ? field.querySelector('input') : null;

        if (!input) return;

        const isPassword = input.type === 'password';

        input.type = isPassword ? 'text' : 'password';
        button.classList.toggle('is-visible', isPassword);

        button.setAttribute(
          'aria-label',
          isPassword ? 'Masquer le mot de passe' : 'Afficher le mot de passe'
        );
      });
    });
  });
</script>

<script>
(function () {
  function initResetPasswordValidation() {
    const pwd1 = document.getElementById('reset_password_first');
    const pwd2 = document.getElementById('reset_password_second');

    if (!pwd1 || !pwd2) return;

    const form = pwd1.closest('form');
    if (!form || form.dataset.resetVibrateReady === '1') return;

    form.dataset.resetVibrateReady = '1';
    form.setAttribute('novalidate', 'novalidate');

    const submitBtn = form.querySelector('button[type="submit"]');

    function getBox(input) {
      return input.closest('.floating-field') || input.parentElement;
    }

    function getMessage(input) {
      const id = input.id + '_message';
      let message = document.getElementById(id);

      if (!message) {
        message = document.createElement('div');
        message.id = id;
        message.className = 'reset-field-message';

        const box = getBox(input);
        if (box) {
          box.insertAdjacentElement('afterend', message);
        }
      }

      return message;
    }

    function showError(input, text) {
      const box = getBox(input);
      const message = getMessage(input);

      input.classList.add('is-invalid');

      message.textContent = text;
      message.classList.add('show');

      if (box) {
        box.classList.remove('reset-vibrate');
        void box.offsetWidth;
        box.classList.add('reset-vibrate');

        setTimeout(function () {
          box.classList.remove('reset-vibrate');
        }, 450);
      }
    }

    function clearError(input) {
      const box = getBox(input);
      const message = getMessage(input);

      input.classList.remove('is-invalid');

      if (box) {
        box.classList.remove('reset-vibrate');
      }

      message.textContent = '';
      message.classList.remove('show');
    }

    function validateResetPassword() {
      let valid = true;
      let firstInvalid = null;

      const value1 = pwd1.value.trim();
      const value2 = pwd2.value.trim();

      clearError(pwd1);
      clearError(pwd2);

      if (!value1) {
        showError(pwd1, 'Nouveau mot de passe requis');
        firstInvalid = firstInvalid || pwd1;
        valid = false;
      } else if (value1.length < 6) {
        showError(pwd1, 'Minimum 6 caractères');
        firstInvalid = firstInvalid || pwd1;
        valid = false;
      }

      if (!value2) {
        showError(pwd2, 'Répétez le mot de passe');
        firstInvalid = firstInvalid || pwd2;
        valid = false;
      } else if (value2.length < 6) {
        showError(pwd2, 'Minimum 6 caractères');
        firstInvalid = firstInvalid || pwd2;
        valid = false;
      }

      if (value1 && value2 && value1.length >= 6 && value2.length >= 6 && value1 !== value2) {
        showError(pwd1, 'Les mots de passe ne correspondent pas');
        showError(pwd2, 'Les mots de passe ne correspondent pas');
        firstInvalid = firstInvalid || pwd2;
        valid = false;
      }

      if (!valid) {
        if (navigator.vibrate) {
          navigator.vibrate([80, 40, 80]);
        }

        if (firstInvalid) {
          firstInvalid.focus({ preventScroll: true });
        }
      }

      return valid;
    }

    [pwd1, pwd2].forEach(function (input) {
      input.addEventListener('input', function () {
        clearError(input);
      });

      input.addEventListener('change', function () {
        clearError(input);
      });
    });

    if (submitBtn) {
      submitBtn.addEventListener('click', function (event) {
        if (!validateResetPassword()) {
          event.preventDefault();
          event.stopPropagation();
          event.stopImmediatePropagation();
        }
      }, true);
    }

    form.addEventListener('submit', function (event) {
      if (!validateResetPassword()) {
        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();
      }
    }, true);
  }

  document.addEventListener('DOMContentLoaded', initResetPasswordValidation);
  document.addEventListener('turbo:load', initResetPasswordValidation);
  initResetPasswordValidation();
})();
</script>
{% endblock %}