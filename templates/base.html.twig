<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}" prefix="og: https://ogp.me/ns#">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">

        <title>{% block title %}{% trans %}Main d’Œuvre Locale{% endtrans %}{% endblock %}</title>

        {# ==============================================================
           SEO GLOBAL — le domaine canonique doit rester unique partout.
           Les paramètres GET sont volontairement exclus de la canonique.
        ============================================================== #}
        {% set mol_site_url = 'https://www.maindoeuvrelocale.com' %}
        {% set mol_route = app.request.attributes.get('_route')|default('') %}
        {% set mol_canonical_url = mol_site_url ~ app.request.pathInfo %}
        {% set mol_page_title = block('title')|striptags|trim %}
        {% set mol_description = seo_description|default('Trouvez un emploi, une mission, un artisan, un prestataire ou un talent qualifié près de chez vous au Cameroun avec Main d’Œuvre Locale.') %}
        {% set mol_og_image = seo_image|default(mol_site_url ~ asset('images/og/maindoeuvrelocale-og.jpeg') ~ '?v=5') %}
        {# Une page publique doit rester indexable, même si le visiteur est connecté. #}
        {% set mol_is_private = mol_route starts with 'admin_'
            or mol_route starts with 'moderateur_'
            or mol_route starts with 'tableau_de_bord_'
            or mol_route starts with 'chat_'
            or mol_route starts with 'settings_'
            or mol_route starts with 'payment_'
            or mol_route starts with 'payments_'
            or mol_route starts with 'report_'
            or mol_route starts with 'onboarding_'
            or mol_route starts with 'profile_edit'
            or mol_route starts with 'mes_contacts'
            or mol_route starts with 'mes_favoris'
            or mol_route starts with 'friendship_'
        %}

        <meta name="description" content="{{ mol_description|striptags|trim|e('html_attr') }}">
        <meta name="robots" content="{{ mol_is_private ? 'noindex, nofollow, noarchive' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}">
        <meta name="author" content="Main d’Œuvre Locale">

        <link rel="canonical" href="{{ mol_canonical_url|e('html_attr') }}">
        <link rel="alternate" hreflang="{{ app.request.locale == 'en' ? 'en' : 'fr-CM' }}" href="{{ mol_canonical_url|e('html_attr') }}">
        <link rel="alternate" hreflang="x-default" href="{{ mol_canonical_url|e('html_attr') }}">

        <meta property="og:site_name" content="Main d’Œuvre Locale">
        <meta property="og:title" content="{{ mol_page_title|e('html_attr') }}">
        <meta property="og:description" content="{{ mol_description|striptags|trim|e('html_attr') }}">
        <meta property="og:type" content="{{ seo_og_type|default('website') }}">
        <meta property="og:url" content="{{ mol_canonical_url|e('html_attr') }}">
        <meta property="og:image" content="{{ mol_og_image }}">
        <meta property="og:image:url" content="{{ mol_og_image }}">
        <meta property="og:image:secure_url" content="{{ mol_og_image }}">
        <meta property="og:image:type" content="image/jpeg">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content="Main d’Œuvre Locale - plateforme de mise en relation locale">
        <meta property="og:locale" content="{{ app.request.locale == 'en' ? 'en_US' : 'fr_CM' }}">

        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ mol_page_title|e('html_attr') }}">
        <meta name="twitter:description" content="{{ mol_description|striptags|trim|e('html_attr') }}">
        <meta name="twitter:image" content="{{ mol_og_image }}">

        <link rel="image_src" href="{{ mol_og_image }}">

        {% if mol_route == 'accueil' %}
            <script type="application/ld+json">
            {
              "@context": "https://schema.org",
              "@graph": [
                {
                  "@type": "Organization",
                  "@id": "{{ mol_site_url }}/#organization",
                  "name": "Main d’Œuvre Locale",
                  "url": "{{ mol_site_url }}/",
                  "logo": "{{ mol_site_url ~ asset('build/assets/images/brand/logo.png') }}",
                  "description": {{ mol_description|json_encode|raw }}
                },
                {
                  "@type": "WebSite",
                  "@id": "{{ mol_site_url }}/#website",
                  "url": "{{ mol_site_url }}/",
                  "name": "Main d’Œuvre Locale",
                  "alternateName": ["Main d'oeuvre locale", "Main-d’œuvre Locale"],
                  "inLanguage": ["fr-CM", "en"]
                }
              ]
            }
            </script>
        {% endif %}

        {% block page_structured_data %}{% endblock %}
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
		<meta name="apple-mobile-web-app-capable" content="yes">
		<meta name="mobile-web-app-capable" content="yes">
		<meta name="HandheldFriendly" content="True">
		<meta name="MobileOptimized" content="320">

        <link rel="preload" as="image" href="{{ asset('build/assets/images/brand/logo.png') }}" fetchpriority="high">
        <link rel="preload" as="image" href="{{ asset('build/assets/images/brand/logoMobile.png') }}" media="(max-width: 767.98px)">

        <link rel="icon" href="{{ asset ('build/assets/favicon.ico') }}" type="image/x-icon">
        <link rel="shortcut icon" type="image/x-icon" href="{{ asset ('build/assets/favicon.ico') }}">

        <!-- Bootstrap CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
        
        <!-- Fallback local -->
        <link href="{{ asset('build/assets/plugins/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
        <link href="{{ asset('build/assets/css/icons.css') }}" rel="stylesheet">
        <link rel="stylesheet" href="{{ asset('css/base.css') }}">
        <link rel="stylesheet" href="{{ asset('css/navbar.css') }}">
        <link rel="stylesheet" href="{{ asset('css/search/smart-keyword-search.css') }}?v=20260805-3">

        {#
           CSS critique chargé avant le HTML de la navbar. Sans cette règle,
           les logos desktop et mobile peuvent apparaître ensemble pendant
           quelques millisecondes, avant le chargement du CSS complet.
        #}
        <style id="mol-critical-navbar-brand">
            .pm-navbar-pro .pm-brand-desktop {
                display: flex !important;
                align-items: center;
            }

            .pm-navbar-pro .pm-brand-mobile {
                display: none !important;
            }

            .pm-navbar-pro .pm-brand img {
                display: block;
                width: auto;
                max-width: 100%;
                object-fit: contain;
            }

            @media (max-width: 991.98px) {
                .pm-navbar-pro .pm-desktop-menu {
                    display: none !important;
                }
            }

            @media (max-width: 767.98px) {
                .pm-navbar-pro .pm-brand-desktop {
                    display: none !important;
                }

                .pm-navbar-pro .pm-brand-mobile {
                    display: flex !important;
                    align-items: center;
                    max-width: 70%;
                }

                .pm-navbar-pro .pm-brand-mobile img {
                    height: 32px !important;
                }
            }
        </style>
                

        <style id="mol-report-fixes-ui">
            .mol-swal-compact-confirm{max-width:92vw!important;border-radius:18px!important}
            .mol-swal-compact-confirm .swal2-title{font-size:1.25rem!important;line-height:1.25!important}
            .mol-friend-btn.btn-primary{background:linear-gradient(135deg,#1769e8,#1557c0)!important;border-color:#1769e8!important;color:#fff!important;box-shadow:0 7px 18px rgba(23,105,232,.20)!important}
            .mol-friend-btn.btn-danger{background:linear-gradient(135deg,#ef4444,#dc2626)!important;border-color:#dc2626!important;color:#fff!important;box-shadow:0 7px 18px rgba(220,38,38,.18)!important}
        </style>

        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {# {{ encore_entry_script_tags('app') }} #}

            {% block importmap %}
                {{ importmap('app') }}
            {% endblock %}

            <script>
                window.MOL_CHAT = {
                    baseUrl: "{{ app.request.basePath }}",
                    urls: {
                        conversations: "{{ path('chat_conversations') }}",
                        withUser: "{{ path('chat_with_user', {userId: 0}) }}".replace('/0', ''),

                        messages: "{{ path('chat_messages', {id: 0}) }}".replace('/0/', '/__ID__/'),
                        send: "{{ path('chat_send', {id: 0}) }}".replace('/0/', '/__ID__/'),
                        read: "{{ path('chat_mark_read', {id: 0}) }}".replace('/0/', '/__ID__/'),
                        typing: "{{ path('chat_typing', {id: 0}) }}".replace('/0/', '/__ID__/'),

                        
                        deleteConversation: "{{ path('chat_delete_conversation', {id: 0}) }}".replace('/0/', '/__ID__/'),
                        markUnread: "{{ path('chat_mark_unread', {id: 0}) }}".replace('/0/', '/__ID__/'),
                        mute: "{{ path('chat_mute', {id: 0}) }}".replace('/0/', '/__ID__/'),
                        archive: "{{ path('chat_archive', {id: 0}) }}".replace('/0/', '/__ID__/'),
                        report: "{{ path('chat_report', {id: 0}) }}".replace('/0/', '/__ID__/'),

                        sendFile: "{{ path('chat_conversation_send_file', {id: 0}) }}".replace('/0/', '/__ID__/'),
                        sendVoice: "{{ path('chat_conversation_send_voice', {id: 0}) }}".replace('/0/', '/__ID__/'),
                        react: "{{ path('message_reaction_toggle', {id: 0}) }}".replace('/0/', '/__ID__/'),
                        messageDelete: "{{ path('chat_message_delete', {id: 0}) }}".replace('/0/', '/__ID__/')
                    }
                };

                window.MOL_FRIEND = {
                    pendingListUrl: "{{ path('friendship_pending_list') }}",
                    friendsListUrl: "{{ path('friendship_friends_list') }}",

                    stateUrlTpl: "{{ path('friendship_state', { userId: 0 }) }}".replace('/0', '/__ID__'),
                    requestUrlTpl: "{{ path('friendship_request', { userId: 0 }) }}".replace('/0', '/__ID__'),
                    
                    cancelUrlTpl: "{{ path('friendship_cancel', { userId: 0 }) }}".replace('/0', '/__ID__'),
                    blockUrlTpl: "{{ path('friendship_block', { userId: 0 }) }}".replace('/0', '/__ID__'),

                    acceptUrlTpl: "{{ path('friendship_accept', { id: 0 }) }}".replace('/0', '/__ID__'),
                    rejectUrlTpl: "{{ path('friendship_reject', { id: 0 }) }}".replace('/0', '/__ID__')
                };

                window.MERCURE_HUB = "{{ app.request.server.get('MERCURE_PUBLIC_URL')|default('http://localhost:3000/.well-known/mercure') }}";

                window.MOL_CALL = {
                    meId: {{ app.user ? app.user.id : 'null' }},
                    meAvatar: "{{ app.user and app.user.personalProfile and app.user.personalProfile.photo
                        ? asset('uploads/profiles/' ~ app.user.personalProfile.photo)
                        : asset('uploads/profiles/avatar.png') }}",
                    mercureHub: window.MERCURE_HUB,
                    urls: {
                        start: "{{ path('chat_call_start', {id: 0}) }}".replace('/0/', '/__CONV__/'),
                        accept: "{{ path('chat_call_accept', {id: 0}) }}".replace('/0', '/__CALL__'),
                        decline: "{{ path('chat_call_decline', {id: 0}) }}".replace('/0', '/__CALL__'),
                        signal: "{{ path('chat_call_signal', {id: 0}) }}".replace('/0', '/__CALL__'),
                        end: "{{ path('chat_call_end', {id: 0}) }}".replace('/0', '/__CALL__')
                    }
                };

                window.MOL_PRESENCE = {
                    heartbeat: "{{ path('presence_heartbeat') }}",
                    offline: "{{ path('presence_offline') }}"
                };
            </script>

            {% if app.user %}
                <script>
                    window.MOL_CHAT = window.MOL_CHAT || {};

                    window.MOL_CHAT.meId = {{ app.user.id }};

                    window.MOL_CHAT.call = {
                        start: "{{ path('chat_call_start', { id: 0 }) }}".replace('/0/', '/__ID__/'),
                        accept: "{{ path('chat_call_accept', { id: 0 }) }}".replace('/0', '/__ID__'),
                        decline: "{{ path('chat_call_decline', { id: 0 }) }}".replace('/0', '/__ID__'),
                        signal: "{{ path('chat_call_signal', { id: 0 }) }}".replace('/0', '/__ID__'),
                        end: "{{ path('chat_call_end', { id: 0 }) }}".replace('/0', '/__ID__'),
                        incoming: "{{ path('chat_call_incoming') }}"
                    };
                </script>
            {% endif %}

            <script src="{{ asset('js/mol-base.js') }}" defer></script>
            <script src="{{ asset('js/search/smart-keyword-search.js') }}?v=20260805-3" defer></script>
        {% endblock %}

        {% set isHomePage= app.request.attributes.get('_route') == 'accueil' %}
    </head>

    <body class="{% block body_class %}{% endblock %}" data-mol-authenticated="{{ app.user ? '1' : '0' }}" data-mol-user-id="{{ app.user ? app.user.id : 'guest' }}">
        {% if app.user %}
            <script>
                // BFCache : force une validation serveur si une ancienne page privée est restaurée après logout.
                window.addEventListener('pageshow', function (event) {
                    if (event.persisted && document.body.dataset.molAuthenticated === '1') {
                        window.location.reload();
                    }
                });
            </script>
        {% endif %}
        <div class="app-shell">

            {{ include('includes/_navbar.html.twig') }}

            <!-- Flash messages -->
            <div class="pm-flash-container">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        {% set flashText = message is iterable ? (message.message ?? message.title ?? 'Notification') : message %}
            
                        <div class="pm-flash pm-flash-{% if label in ['error', 'danger'] %}danger{% elseif label == 'folder_code_guard' %}warning{% else %}{{ label }}{% endif %}">
                            <i class="fas
                                {% if label == 'success' %}
                                    fa-check-circle
                                {% elseif label in ['error', 'danger'] %}
                                    fa-exclamation-circle
                                {% elseif label in ['warning', 'folder_code_guard'] %}
                                    fa-exclamation-triangle
                                {% else %}
                                    fa-info-circle
                                {% endif %}
                            "></i>
                            <span>{{ flashText }}</span>
                        </div>
                        
                    {% endfor %}
                {% endfor %}
            </div>
            
            <!-- Main content -->
            <main class="main-content">
                {% block body %}{% endblock %}

                {#
                    Bouton Retour uniforme : il reste fixe pendant le scroll et se place
                    visuellement au niveau supérieur des héros / en-têtes de page.
                    Les écrans d'accueil, d'authentification et de choix initial de profil
                    sont volontairement exclus pour ne pas casser leur parcours.
                #}
                {% set molCurrentRoute = app.request.attributes.get('_route')|default('') %}
                {% set molBackExcludedRoutes = [
                    'accueil',
                    'app_login',
                    'app_register',
                    'app_register_submit',
                    'app_register_check_email',
                    'profile_type_choice'
                ] %}

                {% if molCurrentRoute not in molBackExcludedRoutes %}
                    {{ include('includes/_previous_page_button.html.twig') }}
                {% endif %}
            </main>
        </div>


        <!-- Footer SaaS VIP (clean) -->
        <footer class="mol-footer">
            <div class="container py-5">
                <div class="row g-4 align-items-start">
        
                {# Brand / pitch #}
                <div class="col-lg-4">
                    <a href="{{ path('accueil') }}" data-turbo="false" class="mol-footer-brand d-inline-flex align-items-center gap-2 text-decoration-none">
                        <img src="{{ asset ('build/assets/images/brand/logoFooter.png') }}" class="header-brand-img dark-logo" alt="logo main d'oeuvre" width="200">
                    </a>
        
                    <p class="text-white-50 mt-3 mb-3 mol-footer-desc">
                    {% trans %}La plateforme premium pour publier, trouver et gérer des annonces et profils en toute confiance.{% endtrans %}
                    </p>
        
                    <div class="d-flex gap-2 flex-wrap">
                    <span class="mol-chip">{% trans %}Rapide{% endtrans %}</span>
                    <span class="mol-chip">{% trans %}Sécurisé{% endtrans %}</span>
                    <span class="mol-chip">{% trans %}Support 24/7{% endtrans %}</span>
                    </div>
                </div>
        
                {# Navigation utile (réduite) #}
                <div class="col-6 col-lg-2">
                    <h6 class="mol-footer-title">{% trans %}Produit{% endtrans %}</h6>
                    <ul class="list-unstyled mol-footer-links">
                    <li><a href="{{ path('subscription_plans') }}" data-turbo="false">{% trans %}Plans d'abonnement{% endtrans %}</a></li>
                    <li><a href="{{ path('support_how_it_works') }}" data-turbo="false">{% trans %}Comment ça marche{% endtrans %}</a></li>
                    <li><a href="{{ path('support_boost_announcement') }}" data-turbo="false">{% trans %}Boost annonce{% endtrans %}</a></li>
                    </ul>
                </div>
        
                <div class="col-6 col-lg-2">
                    <h6 class="mol-footer-title">{% trans %}Support{% endtrans %}</h6>
                    <ul class="list-unstyled mol-footer-links">
                    <li><a href="{{ path('support_center') }}" data-turbo="false">{% trans %}Centre d’aide{% endtrans %}</a></li>
                    <li><a href="{{ path('support_faq') }}" data-turbo="false">{% trans %}FAQ{% endtrans %}</a></li>
                    <li><a href="{{ path('contact_page') }}" data-turbo="false">{% trans %}Contact{% endtrans %}</a></li>
                    </ul>
                </div>
        
                <div class="col-lg-4">
                    {% set offerAlertData = offer_alert_footer_data(app.user) %}
                    {% set currentOfferAlert = offerAlertData.subscription %}

                    <h6 class="mol-footer-title" id="offres-alertes">{% trans %}Alertes offres{% endtrans %}</h6>
                    <p class="mol-offer-alert-help">
                        {% trans %}Recevez par email les nouvelles offres publiées. Si votre compte possède une profession, les alertes seront automatiquement ciblées.{% endtrans %}
                    </p>

                    {% set offerAlertIsActive = app.user and currentOfferAlert and currentOfferAlert.isActive %}
                    <form
                        class="mol-offer-alert {{ offerAlertIsActive ? 'is-active' : '' }}"
                        method="post"
                        action="{{ offerAlertIsActive ? path('offer_alert_unsubscribe_account') : path('newsletter_subscribe') }}"
                        {% if offerAlertIsActive %}data-offer-alert-unsubscribe="1"{% endif %}
                    >
                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token(offerAlertIsActive ? 'offer_alert_unsubscribe_account' : 'newsletter_subscribe') }}"
                        >

                        <label class="visually-hidden" for="newsletter_email">
                            {% trans %}Email{% endtrans %}
                        </label>

                        <div class="mol-offer-alert-row">
                            <input
                                id="newsletter_email"
                                name="email"
                                type="email"
                                class="mol-input"
                                placeholder="{% trans %}Votre email{% endtrans %}"
                                value="{{ app.user ? app.user.email : '' }}"
                                autocomplete="email"
                                {{ app.user ? 'readonly' : '' }}
                                required
                            >

                            <button class="mol-btn mol-offer-alert-submit {{ offerAlertIsActive ? 'is-unsubscribe' : '' }}" type="submit">
                                {% if offerAlertIsActive %}
                                    <i class="fa-solid fa-bell-slash" aria-hidden="true"></i>
                                    {% trans %}Se désabonner{% endtrans %}
                                {% elseif currentOfferAlert and not currentOfferAlert.isActive %}
                                    {% trans %}Réactiver{% endtrans %}
                                {% else %}
                                    {% trans %}S’abonner{% endtrans %}
                                {% endif %}
                            </button>
                        </div>
                    </form>

                    {% if offerAlertIsActive %}
                        <div class="mol-offer-alert-active" role="status">
                            <span>
                                <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                                {% trans %}Alerte active{% endtrans %}
                                {% if currentOfferAlert.profession %}— {{ currentOfferAlert.profession.profession }}{% endif %}
                            </span>
                        </div>
                    {% endif %}

                    <style>
                        .mol-offer-alert-help {
                            margin: 7px 0 11px;
                            color: rgba(255, 255, 255, .60);
                            font-size: 12px;
                            line-height: 1.55;
                        }

                        .mol-offer-alert {
                            display: grid;
                            width: 100%;
                            gap: 8px;
                        }

                        .mol-offer-alert .mol-input {
                            width: 100%;
                            min-width: 0;
                            height: 46px;
                            padding: 0 13px;
                            border: 1px solid rgba(255, 255, 255, .11);
                            border-radius: 11px;
                            outline: 0;
                            background: rgba(4, 15, 31, .64);
                            color: #fff;
                            font-size: 12px;
                        }

                        .mol-offer-alert-row {
                            display: grid;
                            grid-template-columns: minmax(0, 1fr) auto;
                            align-items: stretch;
                            gap: 8px;
                            width: 100%;
                        }

                        .mol-offer-alert-submit {
                            position: static !important;
                            display: inline-flex;
                            align-items: center;
                            justify-content: center;
                            min-width: 112px;
                            height: 46px;
                            margin: 0 !important;
                            padding: 0 15px !important;
                            border: 0;
                            border-radius: 11px;
                            white-space: nowrap;
                        }

                        .mol-offer-alert-submit.is-unsubscribe {
                            gap: 8px;
                            background: rgba(255,255,255,.10) !important;
                            color: rgba(255,255,255,.86) !important;
                            border: 1px solid rgba(255,255,255,.16) !important;
                            box-shadow: none !important;
                        }

                        .mol-offer-alert-submit.is-unsubscribe:hover {
                            background: rgba(255,255,255,.15) !important;
                            color: #fff !important;
                        }

                        .mol-offer-alert-submit.is-unsubscribe:active {
                            transform: scale(.97);
                            transition: transform .10s ease;
                        }

                        .mol-offer-alert-submit.is-unsubscribe:hover i {
                            animation: molBellShake .42s ease-in-out;
                        }

                        .mol-offer-alert-submit.is-unsubscribe.is-submitting {
                            background: #c93434 !important;
                            border-color: #c93434 !important;
                            color: #fff !important;
                            cursor: wait;
                        }

                        @keyframes molBellShake {
                            0%,100% { transform: rotate(0); }
                            25% { transform: rotate(-10deg); }
                            50% { transform: rotate(10deg); }
                            75% { transform: rotate(-6deg); }
                        }

                        .mol-offer-alert-active {
                            display: flex;
                            align-items: center;
                            gap: 8px;
                            margin-top: 9px;
                            color: #b9ef85;
                            font-size: 11px;
                        }

                        .mol-offer-alert-active span {
                            min-width: 0;
                            overflow-wrap: anywhere;
                        }

                        @media (max-width: 575.98px) {
                            .mol-offer-alert-row {
                                grid-template-columns: minmax(0, 1fr);
                            }

                            .mol-offer-alert-submit {
                                width: 100%;
                                min-width: 0;
                            }

                            .mol-offer-alert-active {
                                align-items: center;
                                flex-direction: row;
                            }
                        }
                    </style>

                    <script>
                        (() => {
                            if (window.__MOL_OFFER_ALERT_UNSUBSCRIBE_CONFIRM__) return;
                            window.__MOL_OFFER_ALERT_UNSUBSCRIBE_CONFIRM__ = true;

                            document.addEventListener('submit', async (event) => {
                                const form = event.target instanceof HTMLFormElement
                                    ? event.target
                                    : null;

                                if (!form || form.dataset.offerAlertUnsubscribe !== '1' || form.dataset.confirmed === '1') {
                                    return;
                                }

                                event.preventDefault();
                                event.stopImmediatePropagation();

                                let confirmed = false;

                                if (window.Swal && typeof window.Swal.fire === 'function') {
                                    const result = await window.Swal.fire({
                                        icon: 'question',
                                        title: {{ 'Se désabonner des alertes ?'|trans|json_encode|raw }},
                                        text: {{ 'Vous ne recevrez plus les nouvelles offres par email.'|trans|json_encode|raw }},
                                        showCancelButton: true,
                                        confirmButtonText: {{ 'Confirmer'|trans|json_encode|raw }},
                                        cancelButtonText: {{ 'Annuler'|trans|json_encode|raw }},
                                        reverseButtons: true,
                                        focusCancel: true
                                    });
                                    confirmed = !!result.isConfirmed;
                                } else {
                                    confirmed = window.confirm({{ 'Êtes-vous sûr de vouloir vous désabonner ?'|trans|json_encode|raw }});
                                }

                                if (!confirmed) return;

                                const submitButton = form.querySelector('.mol-offer-alert-submit');
                                if (submitButton) {
                                    submitButton.classList.add('is-submitting');
                                    submitButton.disabled = true;
                                    submitButton.setAttribute('aria-busy', 'true');
                                    submitButton.innerHTML = '<i class="fa-solid fa-bell-slash" aria-hidden="true"></i> Désabonnement…';
                                }

                                form.dataset.confirmed = '1';
                                form.requestSubmit();
                            }, true);
                        })();
                    </script>
        
