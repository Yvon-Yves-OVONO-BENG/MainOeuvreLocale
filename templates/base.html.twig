        <script>
            (function () {
                window.pmOpenMobileMenu = function (event) {
                    if (event) {
                        event.preventDefault();
                        event.stopPropagation();
                    }

                    const mobileMenu = document.getElementById('pmMobileMenu');
                    const overlay = document.getElementById('pmOverlay');

                    if (mobileMenu) {
                        mobileMenu.classList.add('open');
                        mobileMenu.style.left = '0';
                        mobileMenu.style.visibility = 'visible';
                        mobileMenu.style.pointerEvents = 'auto';
                    }

                    if (overlay) {
                        overlay.classList.add('show');
                        overlay.style.opacity = '1';
                        overlay.style.visibility = 'visible';
                        overlay.style.pointerEvents = 'auto';
                    }

                    document.body.classList.add('pm-menu-open');
                    document.body.style.overflow = 'hidden';
                };

                window.pmCloseMobileMenu = function (event) {
                    if (event) {
                        event.preventDefault();
                        event.stopPropagation();
                        event.stopImmediatePropagation();
                    }

                    const mobileMenu = document.getElementById('pmMobileMenu');
                    const overlay = document.getElementById('pmOverlay');

                    if (mobileMenu) {
                        mobileMenu.classList.remove('open');
                        mobileMenu.style.left = '-100%';
                        mobileMenu.style.visibility = '';
                        mobileMenu.style.pointerEvents = '';
                    }

                    if (overlay) {
                        overlay.classList.remove('show');
                        overlay.style.opacity = '0';
                        overlay.style.visibility = 'hidden';
                        overlay.style.pointerEvents = 'none';
                    }

                    document.body.classList.remove('pm-menu-open');
                    document.body.style.overflow = '';
                };

                document.addEventListener('click', function (event) {
                    const target = event.target instanceof Element ? event.target : null;

                    if (!target) {
                        return;
                    }

                    const hamburger = target.closest('#pmHamburgerBtn');
                    const closeBtn = target.closest('#pmMobileClose');
                    const overlay = target.closest('#pmOverlay');

                    if (hamburger) {
                        window.pmOpenMobileMenu(event);
                        return;
                    }

                    if (closeBtn || overlay) {
                        window.pmCloseMobileMenu(event);
                    }
                }, true);

                document.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape') {
                        window.pmCloseMobileMenu(event);
                    }
                });

                document.addEventListener('turbo:before-cache', function () {
                    window.pmCloseMobileMenu();
                });
            })();
        </script>

