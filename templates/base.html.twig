        <script id="mol-chat-dropdown-position-final-fix">
            (() => {
                if (window.__MOL_CHAT_DROPDOWN_POSITION_FINAL_FIX__) return;
                window.__MOL_CHAT_DROPDOWN_POSITION_FINAL_FIX__ = true;

                const STATE = {
                    openMenu: null,
                    openToggle: null
                };

                function qs(id) {
                    return document.getElementById(id);
                }

                function clamp(value, min, max) {
                    return Math.max(min, Math.min(max, value));
                }

                function isChatDropdownToggle(el) {
                    return !!el?.closest?.(
                        '[data-mol-conversation-actions-toggle="1"], ' +
                        '#molChatToasts [id^="chatcoversationDropdown-"], ' +
                        '#molChatToasts [data-bs-toggle="dropdown"], ' +
                        '#molChatToasts [data-mol-chat-dropdown-toggle="1"], ' +
                        '#molChatThread #molChatThreadDropdown, ' +
                        '#molChatThread [data-bs-toggle="dropdown"], ' +
                        '#molChatThread [data-mol-chat-dropdown-toggle="1"]'
                    );
                }

                function getToggleFromEventTarget(target) {
                    return target.closest(
                        '[data-mol-conversation-actions-toggle="1"], ' +
                        '#molChatToasts [id^="chatcoversationDropdown-"], ' +
                        '#molChatToasts [data-bs-toggle="dropdown"], ' +
                        '#molChatToasts [data-mol-chat-dropdown-toggle="1"], ' +
                        '#molChatThread #molChatThreadDropdown, ' +
                        '#molChatThread [data-bs-toggle="dropdown"], ' +
                        '#molChatThread [data-mol-chat-dropdown-toggle="1"]'
                    );
                }

                function getConversationIdFromToggle(toggle) {
                    const toast = toggle.closest('#molChatToasts .toast');

                    if (toast?.id) {
                        return Number(String(toast.id).replace('molToast-', '')) || 0;
                    }

                    const thread = qs('molChatThread');

                    if (thread?.dataset?.conversationId) {
                        return Number(thread.dataset.conversationId) || 0;
                    }

                    const m = String(toggle.id || '').match(/(\d+)$/);
                    return m ? Number(m[1]) : 0;
                }

                function findMenuForToggle(toggle) {
                    if (!toggle) return null;

                    if (toggle.__molFinalMenu) {
                        return toggle.__molFinalMenu;
                    }

                    let menu = null;

                    if (toggle.id) {
                        menu = document.querySelector(`.dropdown-menu[aria-labelledby="${CSS.escape(toggle.id)}"]`);
                    }

                    if (!menu) {
                        menu = toggle.parentElement?.querySelector('.dropdown-menu') || null;
                    }

                    if (!menu) return null;

                    toggle.__molFinalMenu = menu;
                    menu.__molFinalToggle = toggle;

                    return menu;
                }

                function disableBootstrapDropdown(toggle, menu) {
                    try {
                        const Dropdown = window.bootstrap?.Dropdown;
                        const instance = Dropdown?.getInstance?.(toggle);
                        if (instance) instance.dispose();
                    } catch (_) {}

                    toggle.removeAttribute('data-bs-toggle');
                    toggle.removeAttribute('data-bs-auto-close');
                    toggle.setAttribute('data-mol-chat-dropdown-toggle', '1');

                    if (menu) {
                        menu.removeAttribute('data-bs-popper');
                        menu.removeAttribute('style');
                        menu.classList.remove('dropdown-menu-end');
                        menu.classList.add('mol-chat-fixed-menu');
                    }
                }

                function closeMenu() {
                    if (STATE.openMenu) {
                        STATE.openMenu.classList.remove('show');
                        STATE.openMenu.style.setProperty('display', 'none', 'important');
                        STATE.openMenu.style.removeProperty('left');
                        STATE.openMenu.style.removeProperty('top');
                        STATE.openMenu.style.removeProperty('visibility');
                    }

                    if (STATE.openToggle) {
                        STATE.openToggle.setAttribute('aria-expanded', 'false');
                    }

                    STATE.openMenu = null;
                    STATE.openToggle = null;
                }

                function placeMenu(toggle, menu) {
                    document.body.appendChild(menu);

                    menu.classList.add('mol-chat-fixed-menu');
                    menu.classList.add('show');

                    menu.style.setProperty('position', 'fixed', 'important');
                    menu.style.setProperty('display', 'block', 'important');
                    menu.style.setProperty('visibility', 'hidden', 'important');
                    menu.style.setProperty('transform', 'none', 'important');
                    menu.style.setProperty('left', '0px', 'important');
                    menu.style.setProperty('top', '0px', 'important');
                    menu.style.setProperty('right', 'auto', 'important');
                    menu.style.setProperty('bottom', 'auto', 'important');
                    menu.style.setProperty('box-sizing', 'border-box', 'important');
                    menu.style.setProperty('z-index', '2147483647', 'important');

                    const rect = toggle.getBoundingClientRect();
                    const surface = toggle.closest('#molChatPanel, #molChatToasts .toast');
                    const surfaceRect = surface?.getBoundingClientRect?.() || rect;
                    const visual = window.visualViewport;
                    const viewportLeft = visual?.offsetLeft || 0;
                    const viewportTop = visual?.offsetTop || 0;
                    const viewportWidth = visual?.width || document.documentElement.clientWidth || window.innerWidth;
                    const viewportHeight = visual?.height || document.documentElement.clientHeight || window.innerHeight;
                    const margin = 10;
                    const usableLeft = Math.max(viewportLeft + margin, surfaceRect.left + margin);
                    const usableRight = Math.min(viewportLeft + viewportWidth - margin, surfaceRect.right - margin);
                    const usableWidth = Math.max(160, usableRight - usableLeft);
                    const width = Math.max(160, Math.min(278, viewportWidth - (margin * 2), usableWidth));
                    const maxHeight = Math.max(120, viewportHeight - (margin * 2));

                    menu.style.setProperty('width', `${width}px`, 'important');
                    menu.style.setProperty('max-height', `${maxHeight}px`, 'important');

                    const height = Math.min(
                        Math.ceil(menu.scrollHeight || menu.getBoundingClientRect().height || 260),
                        maxHeight
                    );

                    const horizontalSpare = Math.max(0, usableWidth - width);
                    const rightInset = Math.min(44, horizontalSpare / 2);
                    let left = usableRight - rightInset - width;
                    let top = rect.bottom + 8;

                    if (top + height > viewportTop + viewportHeight - margin) {
                        top = rect.top - height - 8;
                    }

                    left = clamp(
                        left,
                        usableLeft,
                        Math.max(usableLeft, usableRight - width)
                    );
                    top = clamp(
                        top,
                        viewportTop + margin,
                        Math.max(viewportTop + margin, viewportTop + viewportHeight - height - margin)
                    );

                    menu.style.setProperty('left', `${left}px`, 'important');
                    menu.style.setProperty('top', `${top}px`, 'important');
                    menu.style.setProperty('visibility', 'visible', 'important');

                    toggle.setAttribute('aria-expanded', 'true');

                    STATE.openMenu = menu;
                    STATE.openToggle = toggle;
                }

                function getActionFromItem(item) {
                    if (!item) return '';

                    if (item.dataset.chatAction) return item.dataset.chatAction;

                    const onclick = item.getAttribute('onclick') || '';

                    const actions = [
                        'deleteConversation',
                        'markUnread',
                        'mute',
                        'archive',
                        'report'
                    ];

                    return actions.find(action => {
                        return onclick.includes(`'${action}'`) || onclick.includes(`"${action}"`);
                    }) || '';
                }

                window.MOLToggleConversationActions = function (event, toggle) {
                    if (event) {
                        event.preventDefault();
                        event.stopPropagation();
                        event.stopImmediatePropagation();
                    }

                    toggle = toggle || getToggleFromEventTarget(event?.target);
                    const menu = findMenuForToggle(toggle);

                    if (!toggle || !menu) return false;

                    const wasOpen = STATE.openMenu === menu && menu.classList.contains('show');

                    closeMenu();
                    if (wasOpen) return false;

                    disableBootstrapDropdown(toggle, menu);

                    const convId = getConversationIdFromToggle(toggle);
                    menu.dataset.conversationId = String(convId || 0);

                    placeMenu(toggle, menu);
                    return false;
                };

                document.addEventListener('click', (e) => {
                    const item = e.target.closest('.mol-chat-fixed-menu .dropdown-item');

                    if (!item) return;

                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();

                    const menu = item.closest('.mol-chat-fixed-menu');
                    const convId = Number(menu?.dataset?.conversationId || 0);

                    const callType = item.dataset.callType || '';
                    const action = getActionFromItem(item);

                    closeMenu();

                    if (callType) {
                        if (convId && typeof window.MOLStartConversationCall === 'function') {
                            window.MOLStartConversationCall(convId, callType);
                        }
                        return;
                    }

                    if (action) {
                        if (convId && typeof window.MOLChatRunAction === 'function') {
                            window.MOLChatRunAction(e, convId, action);
                        }
                    }
                }, true);

                document.addEventListener('click', (e) => {
                    if (!isChatDropdownToggle(e.target)) {
                        if (!e.target.closest('.mol-chat-fixed-menu')) {
                            closeMenu();
                        }
                        return;
                    }

                    const toggle = getToggleFromEventTarget(e.target);
                    window.MOLToggleConversationActions(e, toggle);
                }, true);

                window.addEventListener('resize', closeMenu);
                window.addEventListener('scroll', closeMenu, true);

                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape') closeMenu();
                });
            })();
        </script>

