        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const dd = document.querySelector('.mol-topbar-lang[data-mol-dd]');
                if (!dd) return;

                const btn = dd.querySelector('[data-mol-dd-btn]');
                const menu = dd.querySelector('[data-mol-dd-menu]');
                const closeItems = dd.querySelectorAll('[data-mol-dd-close]');

                if (!btn || !menu) return;

                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    const isOpen = dd.classList.toggle('is-open');
                    btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                });

                closeItems.forEach(function (item) {
                    item.addEventListener('click', function () {
                        dd.classList.remove('is-open');
                        btn.setAttribute('aria-expanded', 'false');
                    });
                });

                document.addEventListener('click', function (e) {
                    if (!dd.contains(e.target)) {
                        dd.classList.remove('is-open');
                        btn.setAttribute('aria-expanded', 'false');
                    }
                });
            });
        </script>

