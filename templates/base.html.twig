        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const button = document.querySelector('[data-notification-toggle]');

                if (!button) {
                    console.warn('Bouton notifications introuvable.');
                    return;
                }

                const icon = button.querySelector('i');
                const label = button.querySelector('span');

                const toggleUrl = button.dataset.toggleUrl;
                const statusUrl = button.dataset.statusUrl;
                const csrfToken = button.dataset.csrf;

                function applyNotificationState(data) {
                    if (!data || !data.success) {
                        return;
                    }

                    label.textContent = data.enabled
                        ? 'Désactiver les notifications'
                        : 'Réactiver les notifications';

                    icon.className = data.enabled
                        ? 'bi bi-bell-slash'
                        : 'bi bi-bell';

                    button.dataset.enabled = data.enabled ? '1' : '0';
                }

                async function loadStatus() {
                    try {
                        const response = await fetch(statusUrl, {
                            method: 'GET',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        const data = await response.json();
                        applyNotificationState(data);
                    } catch (error) {
                        console.error('Erreur chargement statut notifications :', error);
                    }
                }

                button.addEventListener('click', async () => {
                    button.disabled = true;

                    const formData = new FormData();
                    formData.append('_token', csrfToken);

                    try {
                        const response = await fetch(toggleUrl, {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        const data = await response.json();

                        if (!response.ok || !data.success) {
                            alert(data.message || 'Impossible de modifier les notifications.');
                            return;
                        }

                        applyNotificationState(data);

                        console.log(data.message);
                    } catch (error) {
                        console.error('Erreur toggle notifications :', error);
                        alert('Erreur JavaScript pendant la modification des notifications.');
                    } finally {
                        button.disabled = false;
                    }
                });

                loadStatus();
            });
        </script>

        <script>
            (function () {
                console.log('Module notifications chargé');

                document.addEventListener('click', async function (event) {
                    const button = event.target.closest('[data-action="disable_notifications"]');

                    if (!button) {
                        return;
                    }

                    event.preventDefault();

                    console.log('Clic sur bouton notifications');

                    const toggleUrl = button.dataset.toggleUrl;
                    const csrfToken = button.dataset.csrf;
                    const icon = button.querySelector('i');
                    const label = button.querySelector('span');

                    if (!toggleUrl) {
                        alert('URL toggle manquante sur le bouton.');
                        return;
                    }

                    if (!csrfToken) {
                        alert('Token CSRF manquant sur le bouton.');
                        return;
                    }

                    button.disabled = true;
                    button.classList.add('is-loading');

                    const formData = new FormData();
                    formData.append('_token', csrfToken);

                    try {
                        const response = await fetch(toggleUrl, {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        console.log('Réponse HTTP notifications :', response.status);

                        const data = await response.json();
                        console.log('Réponse JSON notifications :', data);

                        if (!response.ok || !data.success) {
                            alert(data.message || 'Impossible de modifier les notifications.');
                            return;
                        }

                        if (data.enabled === true) {
                            label.textContent = 'Désactiver les notifications';
                            icon.className = 'bi bi-bell-slash';
                            button.dataset.enabled = '1';
                        } else {
                            label.textContent = 'Réactiver les notifications';
                            icon.className = 'bi bi-bell';
                            button.dataset.enabled = '0';
                        }

                        alert(data.message);

                    } catch (error) {
                        console.error('Erreur JS notifications :', error);
                        alert('Erreur JavaScript : impossible de contacter le serveur.');
                    } finally {
                        button.disabled = false;
                        button.classList.remove('is-loading');
                    }
                });
            })();
        </script>

        <script id="mol-notification-toggle-fix">
            (() => {
                if (window.__MOL_NOTIFICATION_TOGGLE_FIX__) return;
                window.__MOL_NOTIFICATION_TOGGLE_FIX__ = true;

                function applyState(button, enabled) {
                    const icon = button.querySelector('i');
                    const label = button.querySelector('span');

                    button.dataset.enabled = enabled ? '1' : '0';

                    if (icon) {
                        icon.className = enabled ? 'bi bi-bell-slash' : 'bi bi-bell';
                    }

                    if (label) {
                        label.textContent = enabled
                            ? 'Désactiver les notifications'
                            : 'Réactiver les notifications';
                    }

                    localStorage.setItem('mol_chat_notifications_enabled', enabled ? '1' : '0');
                }

                function applyStateToAllButtons(enabled) {
                    document.querySelectorAll('[data-notification-toggle]').forEach((button) => {
                        applyState(button, enabled);
                    });
                }

                async function loadStatus(button) {
                    const statusUrl = button.dataset.statusUrl;

                    if (!statusUrl) return;

                    try {
                        const response = await fetch(statusUrl, {
                            method: 'GET',
                            credentials: 'same-origin',
                            cache: 'no-store',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        const data = await response.json().catch(() => ({}));

                        if (!response.ok) return;

                        const ok = data.success === true || data.ok === true;

                        if (ok && typeof data.enabled !== 'undefined') {
                            applyStateToAllButtons(!!data.enabled);
                        }
                    } catch (error) {
                        console.error('[MOL notifications] status error', error);
                    }
                }

                async function toggleNotifications(button) {
                    const toggleUrl = button.dataset.toggleUrl;
                    const csrfToken = button.dataset.csrf;

                    if (!toggleUrl) {
                        console.error('[MOL notifications] data-toggle-url manquant');
                        return;
                    }

                    button.disabled = true;
                    button.classList.add('is-loading');

                    const formData = new FormData();

                    if (csrfToken) {
                        formData.append('_token', csrfToken);
                    }

                    try {
                        const response = await fetch(toggleUrl, {
                            method: 'POST',
                            credentials: 'same-origin',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        const data = await response.json().catch(() => ({}));
                        const ok = data.success === true || data.ok === true;

                        if (!response.ok || !ok) {
                            throw new Error(data.message || data.error || 'Impossible de modifier les notifications.');
                        }

                        applyStateToAllButtons(!!data.enabled);

                        if (window.Swal && data.message) {
                            Swal.fire({
                                icon: 'success',
                                title: data.message,
                                timer: 1600,
                                showConfirmButton: false,
                                confirmButtonColor: '#2563eb'
                            });
                        }
                    } catch (error) {
                        console.error('[MOL notifications] toggle error', error);

                        if (window.Swal) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Action impossible',
                                text: error.message || 'Impossible de modifier les notifications.',
                                confirmButtonColor: '#2563eb'
                            });
                        } else {
                            alert(error.message || 'Impossible de modifier les notifications.');
                        }
                    } finally {
                        button.disabled = false;
                        button.classList.remove('is-loading');
                    }
                }

                document.addEventListener('click', async (event) => {
                    const button = event.target.closest('[data-notification-toggle]');

                    if (!button) return;

                    event.preventDefault();
                    event.stopPropagation();
                    event.stopImmediatePropagation();

                    await toggleNotifications(button);
                }, true);

                document.addEventListener('DOMContentLoaded', () => {
                    document.querySelectorAll('[data-notification-toggle]').forEach(loadStatus);
                });

                document.addEventListener('turbo:load', () => {
                    document.querySelectorAll('[data-notification-toggle]').forEach(loadStatus);
                });

                if (document.readyState !== 'loading') {
                    document.querySelectorAll('[data-notification-toggle]').forEach(loadStatus);
                }
            })();
        </script>

        <script>
(function () {
    function isSubmitButton(el) {
        return el &&
            (
                el.matches('button[type="submit"]') ||
                el.matches('button:not([type])') ||
                el.matches('input[type="submit"]')
            );
    }

    function findSubmitButtonFromClick(target) {
        const button = target.closest('button, input[type="submit"]');

        if (!isSubmitButton(button)) {
            return null;
        }

        return button;
    }

    function setLoading(button) {
        if (!button || button.dataset.loading === '1') {
            return;
        }

        button.dataset.loading = '1';

        if (button.tagName.toLowerCase() === 'button') {
            button.dataset.originalHtml = button.innerHTML;

            button.style.minWidth = button.offsetWidth + 'px';

            button.innerHTML =
                '<span class="mol-submit-spinner" aria-hidden="true"></span>' +
                '<span>' + (button.dataset.loadingText || 'Traitement...') + '</span>';
        }

        if (button.tagName.toLowerCase() === 'input') {
            button.dataset.originalValue = button.value;
            button.style.minWidth = button.offsetWidth + 'px';
            button.value = button.dataset.loadingText || 'Traitement...';
        }

        button.classList.add('mol-submit-loading');
        button.setAttribute('aria-busy', 'true');
    }

    function disableButton(button) {
        if (!button) {
            return;
        }

        button.disabled = true;
    }

    function resetLoading(button) {
        if (!button || button.dataset.loading !== '1') {
            return;
        }

        if (button.tagName.toLowerCase() === 'button' && button.dataset.originalHtml) {
            button.innerHTML = button.dataset.originalHtml;
        }

        if (button.tagName.toLowerCase() === 'input' && button.dataset.originalValue) {
            button.value = button.dataset.originalValue;
        }

        button.classList.remove('mol-submit-loading');
        button.removeAttribute('aria-busy');
        button.disabled = false;
        button.style.minWidth = '';

        delete button.dataset.loading;
        delete button.dataset.originalHtml;
        delete button.dataset.originalValue;
    }

    function resetAllLoadingButtons() {
        document.querySelectorAll('.mol-submit-loading').forEach(function (button) {
            resetLoading(button);
        });
    }

    /*
     * 1) Dès le clic : on affiche le spinner immédiatement.
     * On ne désactive pas encore le bouton ici, pour ne pas bloquer le submit natif.
     */
    document.addEventListener('click', function (event) {
        const button = findSubmitButtonFromClick(event.target);

        if (!button) {
            return;
        }

        const form = button.form;

        if (!form || form.dataset.noSubmitSpinner === '1') {
            return;
        }

        form.dataset.clickedSubmitButton = '1';
        form._molSubmitButton = button;

        setLoading(button);

        /*
         * Si le formulaire est invalide, l'événement submit ne partira pas.
         * Donc on restaure le bouton après un court délai.
         */
        window.setTimeout(function () {
            if (!form.dataset.formSubmitted) {
                resetLoading(button);
            }
        }, 1200);
    }, true);

    /*
     * 2) Au submit réel : on confirme le spinner et on désactive le bouton.
     */
    document.addEventListener('submit', function (event) {
        const form = event.target;

        if (!form || form.dataset.noSubmitSpinner === '1') {
            return;
        }

        const button =
            event.submitter ||
            form._molSubmitButton ||
            form.querySelector('button[type="submit"], button:not([type]), input[type="submit"]');

        if (!button) {
            return;
        }

        form.dataset.formSubmitted = '1';

        setLoading(button);

        /*
         * On désactive après le submit, pas avant.
         * Comme ça, on ne casse pas la soumission du formulaire.
         */
        window.setTimeout(function () {
            disableButton(button);
        }, 0);
    }, true);

    /*
     * 3) Avec Turbo / Ajax : on restaure si la page ne recharge pas complètement.
     */
    document.addEventListener('turbo:submit-end', function () {
        resetAllLoadingButtons();
    });

    document.addEventListener('turbo:frame-load', function () {
        resetAllLoadingButtons();
    });

    document.addEventListener('turbo:render', function () {
        resetAllLoadingButtons();
    });

    window.addEventListener('pageshow', function () {
        resetAllLoadingButtons();

        document.querySelectorAll('form').forEach(function (form) {
            delete form.dataset.formSubmitted;
            delete form.dataset.clickedSubmitButton;
            form._molSubmitButton = null;
        });
    });
})();
</script>

