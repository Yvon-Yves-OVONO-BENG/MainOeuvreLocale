<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="robots" content="noindex,nofollow">
    <meta name="theme-color" content="#08182d">
    <title>{{ status|default(500) }} • Incident technique • Main d’Œuvre Locale</title>
    <style>
        :root{--bg:#071426;--card:#0d1b30;--line:rgba(148,163,184,.18);--text:#f8fafc;--muted:#aebdd0;--blue:#2563eb;--cyan:#38bdf8;--soft:#132640;--danger:#fb7185}
        *{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:var(--bg);color:var(--text)}
        body{min-height:100vh;overflow-x:hidden;background:radial-gradient(circle at 2% 30%,rgba(56,189,248,.18) 0 0,transparent 24%),radial-gradient(circle at 97% 84%,rgba(37,99,235,.18) 0 0,transparent 25%),linear-gradient(135deg,#071426 0%,#07101e 58%,#050b14 100%)}
        body:before,body:after{content:"";position:fixed;border-radius:50%;pointer-events:none;filter:blur(2px)}body:before{width:210px;height:210px;left:-95px;top:18%;background:rgba(96,165,250,.15)}body:after{width:250px;height:250px;right:-115px;bottom:5%;background:rgba(37,99,235,.16)}
        .page{width:min(100%,840px);min-height:100vh;margin:auto;padding:18px 20px 28px}.brand{display:flex;align-items:center;gap:11px;padding:0 14px 14px;color:#fff;text-decoration:none;font-weight:850;font-size:15px}.brand-mark{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:linear-gradient(135deg,#3b82f6,#0ea5e9);box-shadow:0 12px 30px rgba(37,99,235,.28);font-size:19px}.card{position:relative;overflow:hidden;min-height:570px;border:1px solid var(--line);border-radius:32px;background:rgba(13,27,48,.93);box-shadow:0 35px 100px rgba(0,0,0,.34);backdrop-filter:blur(14px)}.card:before{content:"";position:absolute;inset:0 0 auto;height:5px;background:linear-gradient(90deg,#38bdf8,#2563eb,#60a5fa)}
        .body{display:flex;min-height:570px;flex-direction:column;align-items:center;justify-content:center;padding:52px 46px 34px;text-align:center}.badge{display:inline-flex;align-items:center;gap:7px;padding:8px 14px;border:1px solid rgba(147,197,253,.18);border-radius:999px;background:#eef6ff;color:#1d4ed8;font-size:11px;font-weight:900;letter-spacing:.055em;text-transform:uppercase}.icon{display:grid;place-items:center;width:80px;height:80px;margin-top:18px;border-radius:26px;background:linear-gradient(145deg,#60a5fa,#2563eb);box-shadow:0 22px 45px rgba(37,99,235,.30);font-size:34px}.eyebrow{margin-top:17px;color:#93c5fd;font-size:12px;font-weight:750}.title{margin:8px 0 10px;max-width:670px;font-size:clamp(31px,5vw,46px);line-height:1.04;letter-spacing:-.035em}.message{max-width:650px;margin:0;color:#c3cfdd;font-size:16px;line-height:1.75}.reference{display:inline-flex;align-items:center;gap:12px;margin-top:22px;padding:11px 14px;border:1px dashed rgba(147,197,253,.30);border-radius:12px;color:#b9c9da;font-size:11px}.reference code{color:#60a5fa;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-weight:800}.actions{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:24px}.btn{display:inline-flex;min-height:46px;align-items:center;justify-content:center;gap:8px;padding:0 18px;border:1px solid rgba(148,163,184,.22);border-radius:13px;background:#12233b;color:#eef6ff;text-decoration:none;font-size:13px;font-weight:800;cursor:pointer}.btn-primary{border-color:transparent;background:linear-gradient(135deg,#3b82f6,#2563eb);box-shadow:0 12px 28px rgba(37,99,235,.26)}.note{display:flex;width:100%;align-items:flex-start;gap:12px;margin-top:27px;padding-top:19px;border-top:1px solid rgba(148,163,184,.16);text-align:left}.note-icon{display:grid;flex:0 0 32px;height:32px;place-items:center;border-radius:10px;background:#eef6ff;color:#2563eb;font-weight:900}.note strong{display:block;font-size:11px}.note span{display:block;margin-top:3px;color:#8293a9;font-size:10px;line-height:1.5}
        @media(max-width:620px){.page{padding:12px}.brand{padding-left:5px}.card{border-radius:23px}.body{min-height:calc(100vh - 82px);padding:38px 20px 26px}.icon{width:68px;height:68px;border-radius:22px}.title{font-size:32px}.message{font-size:14px}.actions{width:100%}.btn{flex:1 1 100%}.reference{max-width:100%;flex-wrap:wrap;justify-content:center}.note{margin-top:22px}}
    </style>
</head>
<body>
<main class="page">
    <a class="brand" href="/" aria-label="Accueil Main d’Œuvre Locale">
        <span class="brand-mark" aria-hidden="true">M</span>
        <span>Main d’Œuvre Locale</span>
    </a>

    <section class="card" role="alert" aria-labelledby="incident-title">
        <div class="body">
            <span class="badge">Incident technique</span>
            <div class="icon" aria-hidden="true">!</div>
            <div class="eyebrow">Erreur {{ status|default(500) }} • {{ status|default(500) >= 500 ? 'Erreur interne' : 'Requête non aboutie' }}</div>
            <h1 class="title" id="incident-title">{{ title|default('Un incident technique est survenu') }}</h1>
            <p class="message">{{ message|default('Nous n’avons pas pu terminer cette action. L’erreur a été enregistrée automatiquement pour l’administration.') }}</p>

            <div class="reference">
                <span>Référence de l’incident</span>
                <code>{{ reference|default('MOL-ERROR') }}</code>
            </div>

            <div class="actions">
                <a class="btn btn-primary" href="/">Retour à l’accueil</a>
                <button class="btn" type="button" onclick="history.length > 1 ? history.back() : location.assign('/')">Retour à la page précédente</button>
            </div>

            <div class="note">
                <div class="note-icon">✓</div>
                <div>
                    <strong>Vous n’avez rien à transmettre à l’administrateur.</strong>
                    <span>L’erreur, l’URL, la route, le compte concerné et les informations techniques utiles ont déjà été enregistrés avec cette référence.</span>
                </div>
            </div>
        </div>
    </section>
</main>
</body>
</html>
