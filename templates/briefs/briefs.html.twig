{% extends 'base.html.twig' %}
{% block title %}{% trans %}Modèles de brief • Particulier{% endtrans %}{% endblock %}

{% block body %}

{% include "briefs/_vip_ui.html.twig" %}

<div class="bt-page py-4">
  <div class="container">

    {# HERO #}
    <section class="bt-card p-4 p-md-5 mb-4">
      <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-4">
        <div class="min-w-0">
          <div class="d-flex flex-wrap gap-2">
            <span class="bt-chip">🧩 {% trans %}Modèles de brief{% endtrans %}</span>
            <span class="bt-chip">⚡ {% trans %}Publication rapide{% endtrans %}</span>
            <span class="bt-chip">⭐ {% trans %}UX SaaS VIP{% endtrans %}</span>
          </div>

          <h1 class="mt-3 mb-2 fw-black" style="font-weight:900; color:#0f172a;">
            {% trans %}Démarre avec un brief prêt à l’emploi{% endtrans %}
          </h1>
          <p class="mb-0 text-muted" style="max-width: 70ch;">
            {% trans %}Choisis un modèle (Web, API, mobile, UI/UX, etc.), puis clique sur{% endtrans %}
            <strong>{% trans %}“Utiliser ce modèle”{% endtrans %}</strong>
            {% trans %}pour pré-remplir ton formulaire de mission : titre, description, budget et délai.{% endtrans %}
          </p>

          <div class="mt-3 d-flex flex-wrap gap-2">
            <a href="{{ path('job_new') }}" class="btn btn-outline-dark rounded-4 fw-bold px-3 py-2">
              ➕ {% trans %}Publier sans modèle{% endtrans %}
            </a>
            <a href="{{ path('tableau_de_bord') }}" class="btn btn-dark rounded-4 fw-bold px-3 py-2">
              ← {% trans %}Retour au tableau de bord{% endtrans %}
            </a>
          </div>
        </div>

        <div class="bt-soft p-3 p-md-4" style="min-width: 280px;">
          <div class="small text-muted">{% trans %}Conseil SaaS{% endtrans %}</div>
          <div class="mt-2 fw-bold text-dark">
            {% trans %}Un brief clair donne souvent de meilleures propositions et moins d’allers-retours en messagerie.{% endtrans %}
          </div>
          <ul class="small text-muted mt-2 mb-0 ps-3">
            <li>{% trans %}Objectif précis{% endtrans %}</li>
            <li>{% trans %}Budget réaliste{% endtrans %}</li>
            <li>{% trans %}Délai clair{% endtrans %}</li>
            <li>{% trans %}Livrables attendus{% endtrans %}</li>
          </ul>
        </div>
      </div>
    </section>

    {# GRID CARTES #}
    <section class="bt-card p-4">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
          <div class="fw-black" style="font-weight:900; color:#0f172a;">🎯 {% trans %}Choisir un modèle{% endtrans %}</div>
          <div class="small text-muted">{% trans %}Clique sur une carte pour accélérer la création de mission{% endtrans %}</div>
        </div>
        <div class="small text-muted">
          {{ templatesBriefs|length }} {% trans %}modèle{% endtrans %}{{ templatesBriefs|length > 1 ? 's' : '' }}
        </div>
      </div>

      <div class="row g-3">
        {% for t in templatesBriefs %}
          <div class="col-12 col-md-6 col-xl-4">
            <div class="bt-soft p-4 h-100 d-flex flex-column">
              <div class="d-flex align-items-start justify-content-between gap-3">
                <div class="d-flex align-items-start gap-3 min-w-0">
                  <div class="rounded-4 d-grid place-items-center flex-shrink-0"
                       style="width:52px;height:52px;background:#fff;border:1px solid rgba(15,23,42,.08);font-size:1.35rem;">
                    {{ t.icon }}
                  </div>

                  <div class="min-w-0">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                      <span class="bt-badge">{{ t.category }}</span>
                      {% if t.badge is defined and t.badge %}
                        <span class="badge rounded-pill text-bg-light border text-dark">{{ t.badge }}</span>
                      {% endif %}
                    </div>
                    <div class="fw-black mt-2 text-dark" style="font-weight:900;">{{ t.title }}</div>
                  </div>
                </div>
              </div>

              <p class="small text-muted mt-3 mb-3">{{ t.summary }}</p>

              <div class="d-grid gap-2 small mb-3">
                <div class="d-flex align-items-center justify-content-between">
                  <span class="text-muted">💰 {% trans %}Budget conseillé{% endtrans %}</span>
                  <span class="fw-bold text-dark">
                    {{ t.budget_min|number_format(0, ',', ' ') }} - {{ t.budget_max|number_format(0, ',', ' ') }} FCFA
                  </span>
                </div>
                <div class="d-flex align-items-center justify-content-between">
                  <span class="text-muted">⏳ {% trans %}Délai estimé{% endtrans %}</span>
                  <span class="fw-bold text-dark">{{ t.delay_days }} {% trans %}jour{% endtrans %}{{ t.delay_days > 1 ? 's' : '' }}</span>
                </div>
                <div class="d-flex align-items-center justify-content-between">
                  <span class="text-muted">🧠 {% trans %}Expérience{% endtrans %}</span>
                  <span class="fw-bold text-dark">{{ t.experience }}</span>
                </div>
              </div>

              <div class="mt-auto d-flex flex-wrap gap-2">
                <a href="{{ path('brief_templates_use', {slug: t.slug}) }}"
                   class="btn btn-dark rounded-4 fw-bold px-3 py-2">
                  ✅ {% trans %}Utiliser ce modèle{% endtrans %}
                </a>

                <button class="btn btn-outline-dark rounded-4 fw-bold px-3 py-2"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#brief-preview-{{ loop.index }}"
                        aria-expanded="false"
                        aria-controls="brief-preview-{{ loop.index }}">
                  👁️ {% trans %}Aperçu{% endtrans %}
                </button>
              </div>

              <div class="collapse mt-3" id="brief-preview-{{ loop.index }}">
                <div class="bg-white border rounded-4 p-3">
                  <div class="small text-muted mb-1">{% trans %}Titre pré-rempli{% endtrans %}</div>
                  <div class="fw-bold text-dark">{{ t.job_title }}</div>

                  <div class="small text-muted mt-3 mb-1">{% trans %}Extrait description{% endtrans %}</div>
                  <div class="small text-dark" style="white-space: pre-line;">
                    {{ t.description|slice(0, 180) ~ (t.description|length > 180 ? '…' : '') }}
                  </div>
                </div>
              </div>
            </div>
          </div>
        {% else %}
          <div class="col-12">
            <div class="text-center py-5">
              <div class="display-6 mb-2">📭</div>
              <div class="fw-black mb-1" style="font-weight:900;">{% trans %}Aucun modèle disponible{% endtrans %}</div>
              <div class="text-muted">{% trans %}Ajoute des modèles dans BriefTemplateCatalog.{% endtrans %}</div>
            </div>
          </div>
        {% endfor %}
      </div>
    </section>

  </div>
</div>
{% endblock %}