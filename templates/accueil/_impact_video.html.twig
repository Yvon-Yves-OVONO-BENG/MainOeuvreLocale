{% set molVideoLocale = app.request.locale == 'en' ? 'en' : 'fr' %}
<section class="mol-impact-video" aria-labelledby="mol-impact-title">
  <style>
    .mol-impact-video {
      padding: clamp(54px, 7vw, 92px) 0;
      background:
        radial-gradient(circle at 15% 15%, rgba(105,185,0,.12), transparent 34%),
        linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    }

    .mol-impact-video__shell {
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto;
    }

    .mol-impact-video__head {
      max-width: 780px;
      margin-bottom: 30px;
    }

    .mol-impact-video__eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 12px;
      border-radius: 999px;
      background: rgba(105,185,0,.12);
      color: #397100;
      font-weight: 800;
      font-size: .82rem;
      letter-spacing: .04em;
      text-transform: uppercase;
    }

    .mol-impact-video h2 {
      margin: 14px 0 10px;
      color: #0f172a;
      font-size: clamp(1.8rem, 4vw, 3rem);
      line-height: 1.08;
      font-weight: 900;
    }

    .mol-impact-video__lead {
      color: #475569;
      font-size: 1.05rem;
      line-height: 1.75;
    }

    .mol-impact-video__grid {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(320px, .85fr);
      gap: 24px;
      align-items: stretch;
    }

    .mol-impact-video__media {
      position: relative;
      min-height: 420px;
      overflow: hidden;
      border-radius: 28px;
      background: #0f172a;
      box-shadow: 0 24px 70px rgba(15,23,42,.18);
    }

    .mol-impact-video__media video {
      width: 100%;
      height: 100%;
      min-height: 420px;
      display: block;
      object-fit: cover;
    }

    .mol-impact-video__caption {
      position: absolute;
      left: 18px;
      right: 18px;
      bottom: 18px;
      padding: 14px 16px;
      border: 1px solid rgba(255,255,255,.22);
      border-radius: 18px;
      color: #fff;
      background: rgba(15,23,42,.72);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      pointer-events: none;
    }

    .mol-impact-video__quotes {
      display: grid;
      gap: 14px;
    }

    .mol-impact-quote {
      padding: 20px;
      border: 1px solid #e2e8f0;
      border-radius: 22px;
      background: rgba(255,255,255,.94);
      box-shadow: 0 12px 34px rgba(15,23,42,.07);
    }

    .mol-impact-quote strong {
      display: block;
      margin-bottom: 7px;
      color: #0f172a;
      font-size: .98rem;
    }

    .mol-impact-quote p {
      margin: 0;
      color: #475569;
      line-height: 1.62;
    }

    .mol-impact-video__slogan {
      margin-top: 28px;
      padding: 20px 22px;
      border-left: 5px solid #69b900;
      border-radius: 0 18px 18px 0;
      background: #f1f8e8;
      color: #1e3a0c;
      font-weight: 900;
      font-size: clamp(1rem, 2vw, 1.25rem);
    }

    @media (max-width: 900px) {
      .mol-impact-video__grid {
        grid-template-columns: 1fr;
      }

      .mol-impact-video__media,
      .mol-impact-video__media video {
        min-height: 330px;
      }
    }
  </style>

  <div class="mol-impact-video__shell">
    <header class="mol-impact-video__head">
      <span class="mol-impact-video__eyebrow">
        <i class="fa-solid fa-people-group" aria-hidden="true"></i>
        {% trans %}Impact local{% endtrans %}
      </span>
      <h2 id="mol-impact-title">{% trans %}Les compétences existent déjà. Rendons-les visibles.{% endtrans %}</h2>
      <p class="mol-impact-video__lead">
        {% trans %}Chaque jour, des professionnels compétents cherchent des opportunités pendant que des familles et des entreprises cherchent des personnes de confiance. Main-d’œuvre Locale rapproche ces deux réalités.{% endtrans %}
      </p>
    </header>

    <div class="mol-impact-video__grid">
      <div class="mol-impact-video__media">
        <video
          controls
          playsinline
          preload="metadata"
          poster="{{ asset('images/marketing/notre-histoire.jpeg') }}"
          aria-label="{% trans %}Vidéo sur l'impact de Main-d’œuvre Locale et témoignages{% endtrans %}"
        >
          <source src="{{ asset('videos/main-doeuvre-locale/impact-testimonials-' ~ molVideoLocale ~ '.webm') }}" type="video/webm">
          <source src="{{ asset('videos/main-doeuvre-locale/impact-testimonials-' ~ molVideoLocale ~ '.mp4') }}" type="video/mp4">
          {% trans %}Votre navigateur ne prend pas en charge la lecture vidéo.{% endtrans %}
        </video>
        <div class="mol-impact-video__caption">
          <strong>{% trans %}Une plateforme utile au quotidien{% endtrans %}</strong><br>
          <span>{% trans %}Artisans, familles, entreprises et diaspora connectés plus simplement.{% endtrans %}</span>
        </div>
      </div>

      <div class="mol-impact-video__quotes" aria-label="{% trans %}Témoignages{% endtrans %}">
        <article class="mol-impact-quote">
          <strong>{% trans %}Menuisier{% endtrans %}</strong>
          <p>{% trans %}Avant, seuls les gens du quartier connaissaient mon savoir-faire. Aujourd’hui, davantage de clients peuvent voir mes réalisations.{% endtrans %}</p>
        </article>

        <article class="mol-impact-quote">
          <strong>{% trans %}Peintre{% endtrans %}</strong>
          <p>{% trans %}Mon sérieux et les avis de mes clients rendent mon profil plus visible et m’apportent plus de demandes.{% endtrans %}</p>
        </article>

        <article class="mol-impact-quote">
          <strong>{% trans %}Particulier{% endtrans %}</strong>
          <p>{% trans %}Les notes et les avis m’aident à choisir un prestataire sérieux avec davantage de sérénité.{% endtrans %}</p>
        </article>

        <article class="mol-impact-quote">
          <strong>{% trans %}Employeur vivant à l’étranger{% endtrans %}</strong>
          <p>{% trans %}La visioconférence et les profils détaillés me permettent d’échanger avec des candidats au pays sans me déplacer.{% endtrans %}</p>
        </article>
      </div>
    </div>

    <div class="mol-impact-video__slogan">
      {% trans %}Main d’Œuvre Locale : parce que la richesse est déjà autour de nous.{% endtrans %}
    </div>
  </div>
</section>
