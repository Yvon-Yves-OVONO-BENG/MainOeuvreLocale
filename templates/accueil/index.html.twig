        <script>
        (function () {
            const slider = document.getElementById('phHeroSlider');
            if (!slider || slider.dataset.lazyBound === '1') return;
            slider.dataset.lazyBound = '1';
            const slides = Array.from(slider.querySelectorAll('[data-bg]'));
            const firstUrl = {{ asset('images/hero/talents/talent-background.png')|json_encode|raw }};

            function markReady() { slider.classList.add('is-media-ready'); }
            const firstImage = new Image();
            firstImage.decoding = 'async';
            firstImage.onload = markReady; firstImage.onerror = markReady; firstImage.src = firstUrl;
            if (firstImage.complete) markReady();

            function preloadSlide(slide) {
                if (!slide || slide.dataset.loaded === '1' || !slide.dataset.bg) return;
                slide.dataset.loaded = '1';
                const image = new Image(); image.decoding = 'async';
                image.onload = function () { slide.style.backgroundImage = 'url("' + slide.dataset.bg.replace(/"/g, '\\"') + '")'; };
                image.src = slide.dataset.bg;
            }

            // Les deux visuels suivants sont préparés tôt ; le reste est différé pour économiser la 4G.
            preloadSlide(slides[0]); preloadSlide(slides[1]);
            const loadRest = function () { slides.slice(2).forEach(function (slide, index) { setTimeout(function(){ preloadSlide(slide); }, index * 450); }); };
            if ('requestIdleCallback' in window) requestIdleCallback(loadRest, {timeout:1800}); else setTimeout(loadRest, 900);
        }());
        </script>

