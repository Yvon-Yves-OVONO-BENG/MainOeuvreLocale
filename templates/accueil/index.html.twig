<script>
    /**
     * Impose une seule animation de dix minutes sur la bande des offres.
     * Le contrôle protège aussi la vitesse contre une réinitialisation par le script global.
     */
    function enforceVerySlowJobsTicker() {
        document.querySelectorAll('.vip-jobs-ticker-hero').forEach(function (hero) {
            const track = hero.querySelector('.vip-jobs-ticker-track');

            if (!track) {
                return;
            }

            track.style.setProperty('animation-duration', '600s', 'important');

            hero.querySelectorAll('.vip-jobs-ticker-content').forEach(function (content) {
                content.style.setProperty('animation', 'none', 'important');
            });

            if (track.dataset.slowTickerObserved === '1') {
                return;
            }

            track.dataset.slowTickerObserved = '1';

            const observer = new MutationObserver(function () {
                const duration = track.style.getPropertyValue('animation-duration');
                const priority = track.style.getPropertyPriority('animation-duration');

                if (duration !== '80s' || priority !== 'important') {
                    track.style.setProperty('animation-duration', '80s', 'important');
                }
            });

            observer.observe(track, {
                attributes: true,
                attributeFilter: ['style']
            });
        });
    }

    /**
     * Applique le réglage après les scripts différés et les reconstructions Turbo.
     */
    function scheduleVerySlowJobsTicker() {
        window.requestAnimationFrame(function () {
            enforceVerySlowJobsTicker();
            window.setTimeout(enforceVerySlowJobsTicker, 250);
        });
    }

    document.addEventListener('DOMContentLoaded', scheduleVerySlowJobsTicker);
    document.addEventListener('turbo:load', scheduleVerySlowJobsTicker);
    window.addEventListener('load', scheduleVerySlowJobsTicker);
    window.addEventListener('pageshow', scheduleVerySlowJobsTicker);
</script>

<script>
    (function () {
        'use strict';

        /** Charge uniquement la section paginée et conserve l'utilisateur au bon endroit. */
        async function loadHomePageSection(link, section) {
            const sectionName = section.dataset.homeAjaxPagination;
            const requestedUrl = new URL(link.href, window.location.href);
            requestedUrl.searchParams.delete('partial');
            requestedUrl.searchParams.delete('home_section');
            const fetchUrl = new URL(requestedUrl.href);

            fetchUrl.hash = '';
            fetchUrl.searchParams.set('partial', '1');
            fetchUrl.searchParams.set('home_section', sectionName);

            section.setAttribute('aria-busy', 'true');
            section.style.opacity = '.62';
            section.style.pointerEvents = 'none';

            try {
                const response = await fetch(fetchUrl.toString(), {
                    headers: {
                        'Accept': 'text/html',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    credentials: 'same-origin'
                });

                if (!response.ok) {
                    throw new Error('Réponse de pagination invalide.');
                }

                const html = await response.text();
                const parsedDocument = new DOMParser().parseFromString(html, 'text/html');
                const replacement = parsedDocument.querySelector('[data-home-ajax-pagination="' + sectionName + '"]');

                if (!replacement) {
                    throw new Error('Section paginée introuvable.');
                }

                section.replaceWith(replacement);
                replacement.dispatchEvent(new CustomEvent('mol:home-content-updated', {bubbles: true}));
                window.history.pushState({ molHomePagination: true }, '', requestedUrl.toString());

                window.requestAnimationFrame(function () {
                    const offset = 88;
                    const top = Math.max(0, replacement.getBoundingClientRect().top + window.scrollY - offset);
                    window.scrollTo({ top: top, behavior: 'smooth' });

                    const activePage = replacement.querySelector('.active');
                    if (activePage) activePage.setAttribute('aria-current', 'page');
                });
            } catch (error) {
                window.location.assign(requestedUrl.toString());
            }
        }

        /** Intercepte les paginations de l'accueil sans perturber les clics spéciaux. */
        function handleHomePaginationClick(event) {
            const link = event.target.closest('[data-home-ajax-pagination] a');
            if (!link || event.defaultPrevented || event.button !== 0) return;
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            if (link.classList.contains('disabled') || link.classList.contains('active')) {
                event.preventDefault();
                return;
            }

            const section = link.closest('[data-home-ajax-pagination]');
            if (!section) return;

            event.preventDefault();
            loadHomePageSection(link, section);
        }

        document.addEventListener('click', handleHomePaginationClick);
        window.addEventListener('popstate', function () {
            window.location.reload();
        });
    }());
</script>

