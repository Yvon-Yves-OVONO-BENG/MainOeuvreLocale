{% extends 'base.html.twig' %}

{% block title %}
	{% trans %}Mes signalements de paiement{% endtrans %}
{% endblock %}

{% block body %}

{% include "talent/payment_dispute/_vip_ui_payment_dispute.html.twig" %}

	<div class="container-fluid py-4 pd-shell">
		<div class="pd-hero p-4 p-lg-5 mb-4">
			<div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3">
				<div class="d-flex align-items-start gap-3">
					<div class="pd-icon">💳</div>
					<div>
						<h1 class="h3 fw-bold mb-1">{% trans %}Mes signalements de paiement{% endtrans %}</h1>
						<div class="pd-soft">
							{% trans %}Suivez tous vos litiges de paiement et consultez l’évolution de leur traitement.{% endtrans %}
						</div>
					</div>
				</div>

				<div class="d-flex flex-wrap gap-2">
					<a href="{{ path('talent_payment_dispute_new') }}" class="btn btn-danger rounded-pill px-3">
						⚠️ {% trans %}Nouveau signalement{% endtrans %}
					</a>
					<a href="{{ path('talent_sanctions_index') }}" class="btn btn-outline-dark rounded-pill px-3">
						🛡️ {% trans %}Mes sanctions{% endtrans %}
					</a>
				</div>
			</div>
		</div>

		<div class="row g-3 mb-4">
			<div class="col-12 col-md-6 col-xl-2">
				<div class="pd-kpi p-3 h-100">
					<div class="pd-soft small">{% trans %}Total{% endtrans %}</div>
					<div class="fs-3 fw-bold">{{ totalCount|default(0) }}</div>
				</div>
			</div>
			<div class="col-12 col-md-6 col-xl-2">
				<div class="pd-kpi p-3 h-100">
					<div class="pd-soft small">{% trans %}Ouverts{% endtrans %}</div>
					<div class="fs-3 fw-bold text-danger">{{ openCount|default(0) }}</div>
				</div>
			</div>
			<div class="col-12 col-md-6 col-xl-2">
				<div class="pd-kpi p-3 h-100">
					<div class="pd-soft small">{% trans %}En revue{% endtrans %}</div>
					<div class="fs-3 fw-bold" style="color:#8a6d03;">{{ reviewCount|default(0) }}</div>
				</div>
			</div>
			<div class="col-12 col-md-6 col-xl-2">
				<div class="pd-kpi p-3 h-100">
					<div class="pd-soft small">{% trans %}Résolus{% endtrans %}</div>
					<div class="fs-3 fw-bold text-success">{{ resolvedCount|default(0) }}</div>
				</div>
			</div>
			<div class="col-12 col-md-6 col-xl-2">
				<div class="pd-kpi p-3 h-100">
					<div class="pd-soft small">{% trans %}Rejetés{% endtrans %}</div>
					<div class="fs-3 fw-bold">{{ rejectedCount|default(0) }}</div>
				</div>
			</div>
			<div class="col-12 col-md-6 col-xl-2">
				<div class="pd-kpi p-3 h-100">
					<div class="pd-soft small">{% trans %}Remboursés{% endtrans %}</div>
					<div class="fs-3 fw-bold text-primary">{{ refundedCount|default(0) }}</div>
				</div>
			</div>
		</div>

		<div class="pd-card">
			<div class="p-4 border-bottom">
				<div class="fw-bold">{% trans %}Historique détaillé{% endtrans %}</div>
				<div class="pd-soft small">{% trans %}Retrouvez chaque signalement, le motif, le paiement concerné et le statut actuel.{% endtrans %}</div>
			</div>

			{% if disputes|default([])|length > 0 %}
                {% for d in disputes %}
                    {% set status = d.getStatus() %}

                    <div class="pd-row">
                        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3">
                            <div class="flex-grow-1">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <span class="pd-pill
                                        {% if status == constant('App\\Entity\\PaymentDispute::STATUS_OPEN') %}pd-open{% endif %}
                                        {% if status == constant('App\\Entity\\PaymentDispute::STATUS_REVIEW') %}pd-review{% endif %}
                                        {% if status == constant('App\\Entity\\PaymentDispute::STATUS_RESOLVED') %}pd-resolved{% endif %}
                                        {% if status == constant('App\\Entity\\PaymentDispute::STATUS_REJECTED') %}pd-rejected{% endif %}
                                        {% if status == constant('App\\Entity\\PaymentDispute::STATUS_REFUNDED') %}pd-refunded{% endif %}
                                    ">
                                        {% if status == constant('App\\Entity\\PaymentDispute::STATUS_OPEN') %}
                                            {% trans %}Ouvert{% endtrans %}
                                        {% elseif status == constant('App\\Entity\\PaymentDispute::STATUS_REVIEW') %}
                                            {% trans %}En revue{% endtrans %}
                                        {% elseif status == constant('App\\Entity\\PaymentDispute::STATUS_RESOLVED') %}
                                            {% trans %}Résolu{% endtrans %}
                                        {% elseif status == constant('App\\Entity\\PaymentDispute::STATUS_REJECTED') %}
                                            {% trans %}Rejeté{% endtrans %}
                                        {% elseif status == constant('App\\Entity\\PaymentDispute::STATUS_REFUNDED') %}
                                            {% trans %}Remboursé{% endtrans %}
                                        {% else %}
                                            {{ status }}
                                        {% endif %}
                                    </span>

                                    <span class="pd-pill
                                        {% if d.getPriority() == constant('App\\Entity\\PaymentDispute::PRIORITY_LOW') %}pd-resolved{% endif %}
                                        {% if d.getPriority() == constant('App\\Entity\\PaymentDispute::PRIORITY_MEDIUM') %}pd-review{% endif %}
                                        {% if d.getPriority() == constant('App\\Entity\\PaymentDispute::PRIORITY_HIGH') %}pd-open{% endif %}
                                    ">
                                        {% trans %}Priorité{% endtrans %} :
                                        {% if d.getPriority() == constant('App\\Entity\\PaymentDispute::PRIORITY_LOW') %}
                                            {% trans %}Faible{% endtrans %}
                                        {% elseif d.getPriority() == constant('App\\Entity\\PaymentDispute::PRIORITY_MEDIUM') %}
                                            {% trans %}Moyenne{% endtrans %}
                                        {% elseif d.getPriority() == constant('App\\Entity\\PaymentDispute::PRIORITY_HIGH') %}
                                            {% trans %}Élevée{% endtrans %}
                                        {% else %}
                                            {{ d.getPriority() }}
                                        {% endif %}
                                    </span>
                                </div>

                                <div class="fw-bold mb-1">
                                    {% trans %}Motif du signalement{% endtrans %}
                                </div>
                                <div class="pd-soft mb-3">
                                    {{ d.getReason() }}
                                </div>

                                <div class="row g-2">
                                    <div class="col-12 col-md-6">
                                        <div class="small pd-soft">
                                            <strong>{% trans %}Paiement{% endtrans %} :</strong>
                                            #{{ d.getPayment().getId() }}
                                        </div>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <div class="small pd-soft">
                                            <strong>{% trans %}Facture{% endtrans %} :</strong>
                                            {% if d.getInvoice() %}
                                                {{ d.getInvoice().invoiceNumber ?? ('INV-' ~ d.getInvoice().getId()) }}
                                            {% else %}
                                                —
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>

                                {% if d.getAdminNote() %}
                                    <div class="mt-3">
                                        <div class="fw-semibold mb-1">{% trans %}Retour de l’administration{% endtrans %}</div>
                                        <div class="pd-soft">{{ d.getAdminNote() }}</div>
                                    </div>
                                {% endif %}
                            </div>

                            <div class="text-lg-end">
                                <div class="small pd-soft mb-1">
                                    {% trans %}Créé le{% endtrans %} {{ d.getCreatedAt()|date('d/m/Y H:i') }}
                                </div>

                                {% if d.getResolvedAt() %}
                                    <div class="small pd-soft mb-1">
                                        {% trans %}Traité le{% endtrans %} {{ d.getResolvedAt()|date('d/m/Y H:i') }}
                                    </div>
                                {% endif %}

                                {% if d.getHandledBy() %}
                                    <div class="small pd-soft">
                                        {% trans %}Pris en charge par{% endtrans %} {{ d.getHandledBy().fullName ?? d.getHandledBy().email }}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="p-4">
                    <div class="pd-empty">
                        <div class="fw-bold mb-1">{% trans %}Aucun signalement{% endtrans %}</div>
                        <div class="pd-soft mb-3">{% trans %}Vous n’avez encore déclaré aucun problème de paiement.{% endtrans %}</div>
                        <a href="{{ path('talent_payment_dispute_new') }}" class="btn btn-danger rounded-pill px-4">
                            ⚠️ {% trans %}Créer mon premier signalement{% endtrans %}
                        </a>
                    </div>
                </div>
            {% endif %}
		</div>
	</div>
{% endblock %}