				radial-gradient(1200px circle at 8% 10%, rgba(220,53,69,.12), transparent 42%),
				radial-gradient(1000px circle at 92% 8%, rgba(255,193,7,.12), transparent 38%),
				radial-gradient(1000px circle at 50% 100%, rgba(13,110,253,.08), transparent 45%),
				linear-gradient(180deg, #f8fafc, #fff7ed 48%, #f8fafc);
		}

		.san-hero{
