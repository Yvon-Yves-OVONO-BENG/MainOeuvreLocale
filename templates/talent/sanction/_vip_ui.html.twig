			box-shadow: 0 24px 70px rgba(15,23,42,.08);
			backdrop-filter: blur(12px);
			position: relative;
			overflow: hidden;
		}
		.san-hero::before{
			content:"";
			position:absolute;
			inset:0;
			background: radial-gradient(700px circle at top right, rgba(220,53,69,.10), transparent 42%);
			pointer-events:none;
		}

		.san-kpi{
			border-radius: 20px;
			border: 1px solid rgba(0,0,0,.06);
			background: rgba(255,255,255,.82);
			box-shadow: 0 18px 50px rgba(15,23,42,.06);
			backdrop-filter: blur(10px);
		}

		.san-icon{
			width: 48px;
			height: 48px;
			border-radius: 16px;
			display:grid;
			place-items:center;
			font-size: 22px;
			background: rgba(220,53,69,.10);
			border: 1px solid rgba(220,53,69,.16);
		}

		.san-card{
			border-radius: 22px;
			border: 1px solid rgba(0,0,0,.06);
			background: linear-gradient(180deg, rgba(255,255,255,.96), rgba(255,255,255,.86));
			box-shadow: 0 22px 60px rgba(15,23,42,.07);
			overflow: hidden;
		}

