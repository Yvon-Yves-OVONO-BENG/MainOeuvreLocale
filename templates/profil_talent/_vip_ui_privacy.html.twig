

<style>
  :root{
    --vip-bg:#f6f8fc; --vip-card:rgba(255,255,255,.92);
    --vip-stroke:rgba(15,23,42,.08); --vip-text:#0f172a;
    --vip-muted:rgba(15,23,42,.62); --vip-shadow:0 18px 45px rgba(15,23,42,.08);
    --vip-shadow2:0 10px 28px rgba(15,23,42,.06);
    --vip-radius:18px;
  }
  .vip-wrap{
    background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(246,248,252,.92));
    border: 1px solid var(--vip-stroke);
    border-radius: 22px;
    box-shadow: var(--vip-shadow);
    overflow:hidden;
  }
  .vip-head{
    padding:20px 22px;
    border-bottom:1px solid var(--vip-stroke);
    background: rgba(255,255,255,.75);
  }
  .vip-title{
    margin:0;
    font-weight:900;
    color:var(--vip-text);
  }
  .vip-sub{
    margin:6px 0 0;
    color:var(--vip-muted);
    font-weight:650;
  }
  .vip-body{
    padding:18px 22px 22px;
    background:var(--vip-bg);
  }
  .vip-card{
    background:var(--vip-card);
    border:1px solid var(--vip-stroke);
    border-radius:var(--vip-radius);
    box-shadow:var(--vip-shadow2);
    padding:16px;
  }
  .vip-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    padding:10px 14px;
    border-radius:12px;
    border:1px solid var(--vip-stroke);
    background:rgba(255,255,255,.9);
    color:var(--vip-text);
    font-weight:900;
    text-decoration:none;
  }
  .vip-btn-primary{
    border-color: rgba(13,110,253,.25);
    background: rgba(13,110,253,.12);
  }
  .vip-switch{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    flex-wrap:wrap;
    padding:14px;
    border-radius:14px;
    border:1px solid var(--vip-stroke);
    background:rgba(255,255,255,.7);
  }
  .vip-label{
    font-weight:900;
    color:var(--vip-text);
  }
  .vip-desc{
    color:var(--vip-muted);
    font-weight:650;
    margin-top:4px;
  }
</style>


<style>
  /* ===== Ajustement position page confidentialité ===== */
  @media (max-width: 991.98px){
    .container.py-4{
      padding-top: 50px !important;
    }
  }

  @media (max-width: 575.98px){
    .container.py-4{
      padding-top: 50px !important;
      padding-bottom: 16px !important;
    }

    .vip-head{
      padding: 16px 14px !important;
    }

    .vip-body{
      padding: 14px !important;
    }

    .vip-head .d-flex.justify-content-between{
      flex-direction: column !important;
      align-items: stretch !important;
      gap: 10px !important;
    }

    .vip-head .d-flex.gap-2.flex-wrap{
      width: 100%;
    }

    .vip-head .d-flex.gap-2.flex-wrap .vip-btn{
      width: 100%;
    }
  }
</style>