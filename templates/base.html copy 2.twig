                        menu.style.removeProperty('visibility');
                    });

                    document.querySelectorAll('#molChatPanelOptionsBtnFinal, #molChatPanelOptionsBtn, #molChatPanelOptionsBtnRescue').forEach((button) => {
                        button.setAttribute('aria-expanded', 'false');
                    });
