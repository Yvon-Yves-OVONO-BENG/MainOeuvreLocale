                            data-toggle-url="{{ path('app_notifications_toggle') }}"
                            data-status-url="{{ path('app_notifications_status') }}"
                            data-csrf="{{ csrf_token('notification_preference') }}"
                        >
                            <i class="bi bi-bell-slash"></i>
                            <span>Désactiver les notifications</span>
                        </button>

                        <button type="button" class="mol-panel-menu__item" data-action="message_sounds">
                            <i class="bi bi-volume-up"></i>
                            <span>Sons des messages</span>
                        </button>

                        <button type="button" class="mol-panel-menu__item" data-action="block_setting">
                            <i class="bi bi-slash-circle"></i>
                            <span>Réglages de blocage</span>
                        </button>

                        <div class="mol-panel-menu__divider"></div>

                        <button type="button" class="mol-panel-menu__item" data-action="create_group_chat" data-mol-create-group-trigger="1">
                            <i class="bi bi-people"></i>
                            <span>Groupes</span>
                        </button>
                    `;
                }

                function ensureMenu() {
                    menu = qs('molChatPanelMenuFinal');

                    if (!menu) {
                        menu = document.createElement('div');
                        menu.id = 'molChatPanelMenuFinal';
                        menu.setAttribute('role', 'menu');
                        menu.innerHTML = menuHtml();
                        document.body.appendChild(menu);
                    }

                    return menu;
                }

                function ensureButton() {
                    const panel = qs('molChatPanel');
                    const header = panel?.querySelector('.mol-chat-panel__header');

                    if (!panel || !header) return null;

                    let actions = header.querySelector('.mol-panel-actions');

                    if (!actions) {
                        actions = document.createElement('div');
                        actions.className = 'mol-panel-actions';
                        header.appendChild(actions);
                    }

                    button = qs('molChatPanelOptionsBtnFinal');

                    if (!button) {
                        button = document.createElement('button');
                        button.type = 'button';
                        button.id = 'molChatPanelOptionsBtnFinal';
                        button.setAttribute('aria-label', 'Options des messages');
                        button.setAttribute('aria-expanded', 'false');
                        button.innerHTML = '<i class="bi bi-three-dots"></i>';
                    }

                    const closeBtn =
                        header.querySelector('.mol-btn-icon[onclick*="MOLChatClose"]') ||
                        header.querySelector('button[aria-label="Fermer"]');

                    if (button.parentElement !== actions) {
                        if (closeBtn && closeBtn.parentElement === actions) {
                            actions.insertBefore(button, closeBtn);
                        } else {
                            actions.appendChild(button);
                        }
                    }

                    if (closeBtn && closeBtn.parentElement !== actions) {
                        actions.appendChild(closeBtn);
                    }

                    if (closeBtn && button.nextElementSibling !== closeBtn && closeBtn.parentElement === actions) {
                        actions.insertBefore(button, closeBtn);
                    }

                    return button;
                }

                function closeMenu() {
                    if (!menu) return;

                    menu.classList.remove('is-open');
                    menu.style.removeProperty('left');
                    menu.style.removeProperty('top');

                    if (button) {
                        button.setAttribute('aria-expanded', 'false');
                    }
                }

                function openMenu() {
                    ensureMenu();
                    ensureButton();
                    hideLegacyButtonsAndMenus();

                    if (!button || !menu) return;

                    menu.classList.add('is-open');
                    menu.style.visibility = 'hidden';
                    menu.style.left = '0px';
                    menu.style.top = '0px';

                    const rect = button.getBoundingClientRect();
                    const menuRect = menu.getBoundingClientRect();

                    const width = Math.ceil(menuRect.width || 280);
                    const height = Math.ceil(menuRect.height || 320);

                    let left = rect.right - width;
                    let top = rect.bottom + 10;

                    if (top + height > window.innerHeight - 10) {
                        top = rect.top - height - 10;
                    }

                    left = clamp(left, 10, Math.max(10, window.innerWidth - width - 10));
                    top = clamp(top, 10, Math.max(10, window.innerHeight - height - 10));

                    menu.style.left = left + 'px';
                    menu.style.top = top + 'px';
                    menu.style.visibility = 'visible';

                    button.setAttribute('aria-expanded', 'true');
                }

                function toggleMenu() {
                    ensureMenu();

                    if (menu.classList.contains('is-open')) {
                        closeMenu();
                    } else {
                        openMenu();
                    }
                }

                function notify(title, text = '') {
                    if (window.Swal) {
                        Swal.fire({
                            icon: 'info',
                            title,
                            text,
                            confirmButtonColor: '#2563eb',
                            backdrop: 'rgba(15, 23, 42, .42)'
                        });
                        return;
                    }

                    alert([title, text].filter(Boolean).join('\n'));
                }

                function openCreateGroupModal() {
                    closeMenu();

                    if (window.MolGroupChat && typeof window.MolGroupChat.open === 'function') {
                        window.MolGroupChat.open();
                        return true;
                    }

                    const modal = document.getElementById('molGroupChatModal');

                    if (modal) {
                        modal.hidden = false;

                        requestAnimationFrame(() => {
                            modal.classList.add('is-open');
                        });

                        return true;
                    }

                    if (window.Swal) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Module groupe introuvable',
                            text: 'La modale #molGroupChatModal est absente. Vérifie que chat/_group_chat_modal.html.twig est bien inclus.',
                            confirmButtonColor: '#2563eb'
                        });
                    } else {
                        alert('Module groupe introuvable : #molGroupChatModal absent.');
                    }

                    return false;
                }

                async function runAction(action) {
                    if (action === 'create_group_chat' || action === 'createGroup') {
                        openCreateGroupModal();
                        return;
                    }
                    closeMenu();

                    if (typeof window.MOLChatPanelAction === 'function') {
                        window.MOLChatPanelAction(action);
                        return;
                    }

                    if (action === 'mark_all_read') {
                        document.querySelectorAll('.mol-unread').forEach(el => el.remove());

                        if (typeof window.MOLChatRefreshList === 'function') {
                            await window.MOLChatRefreshList(qs('molChatSearch')?.value?.trim() || '');
                        }

                        notify('Messages mis à jour', 'Toutes les conversations ont été marquées comme lues.');
                        return;
                    }

                    if (action === 'chat_setting') {
                        notify('Paramètres du chat', 'Branche ici ta page ou ta modale de paramètres.');
                        return;
                    }

                    if (action === 'disable_notifications') {
                        const enabled = localStorage.getItem('mol_chat_notifications_enabled') !== '0';
                        localStorage.setItem('mol_chat_notifications_enabled', enabled ? '0' : '1');
                        notify(enabled ? 'Notifications désactivées' : 'Notifications activées');
                        return;
                    }

                    if (action === 'message_sounds') {
                        const enabled = localStorage.getItem('mol_chat_sounds_enabled') !== '0';
                        localStorage.setItem('mol_chat_sounds_enabled', enabled ? '0' : '1');
                        window.MOL_CHAT_SOUND_ENABLED = !enabled;
                        notify(enabled ? 'Sons désactivés' : 'Sons activés');
                        return;
                    }

                    if (action === 'block_setting') {
                        notify('Réglages de blocage', 'Branche ici ta page de blocage.');
                        return;
                    }

                    if (action === 'create_group_chat') {
                        notify('Groupes', 'Branche ici la création de groupe.');
                    }
                }

                function bootSinglePanelMenu() {
                    hideLegacyButtonsAndMenus();
                    ensureMenu();
                    ensureButton();
                }

                function scheduleBoot() {
                    clearTimeout(refreshTimer);
                    refreshTimer = setTimeout(bootSinglePanelMenu, 60);
                }

                document.addEventListener('click', (e) => {
                    const finalBtn = e.target.closest('#molChatPanelOptionsBtnFinal');

                    if (finalBtn) {
                        e.preventDefault();
                        e.stopPropagation();
                        e.stopImmediatePropagation();
                        toggleMenu();
                        return;
                    }

                    const actionBtn = e.target.closest('#molChatPanelMenuFinal [data-action]');

                    if (actionBtn) {
                        e.preventDefault();
                        e.stopPropagation();
                        e.stopImmediatePropagation();
                        runAction(actionBtn.dataset.action);
                        return;
                    }

                    if (
                        !e.target.closest('#molChatPanelMenuFinal') &&
                        !e.target.closest('#molChatPanelOptionsBtnFinal')
                    ) {
                        closeMenu();
                    }
                }, true);

                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape') closeMenu();
                });

                window.addEventListener('resize', closeMenu);
                window.addEventListener('scroll', closeMenu, true);

                if (window.MutationObserver) {
                    new MutationObserver(scheduleBoot).observe(document.body, {
                        childList: true,
                        subtree: true
                    });
                }

                document.addEventListener('DOMContentLoaded', bootSinglePanelMenu);
                document.addEventListener('turbo:load', bootSinglePanelMenu);

                if (document.readyState !== 'loading') {
                    bootSinglePanelMenu();
                }

                window.MOLChatPanelMenuFinal = {
                    open: openMenu,
                    close: closeMenu,
                    toggle: toggleMenu,
                    reinstall: bootSinglePanelMenu
                };
            })();
        </script>

        <script>
            window.MOLChatPanelAction = async function(action) {
                const urls = window.MOL_CHAT_PANEL_MENU?.urls || {};

                const map = {
                    mark_all_read: {
                        url: urls.markAllRead,
                        payload: {}
                    },
                    disable_notifications: {
                        url: urls.notifications,
                        payload: {
                            enabled: localStorage.getItem('mol_chat_notifications_enabled') === '0'
                        }
                    },
                    message_sounds: {
                        url: urls.sounds,
                        payload: {
                            enabled: localStorage.getItem('mol_chat_sounds_enabled') === '0'
                        }
                    },
                    block_setting: {
                        url: urls.blockSettings,
                        payload: {}
                    },
                    create_group_chat: {
                        url: urls.createGroup,
                        payload: {}
                    }
                };

                if (action === 'chat_setting') {
                    if (window.Swal) {
                        Swal.fire({
                            icon: 'info',
                            title: 'Paramètres du chat',
                            text: 'Paramètres du chat prêts à être branchés.',
                            confirmButtonColor: '#2563eb'
                        });
                    }
                    return;
                }

                const config = map[action];

                if (!config || !config.url) {
                    console.warn('[MOL CHAT PANEL] Action inconnue ou URL manquante :', action);
                    return;
                }

                const res = await fetch(config.url, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(config.payload || {})
                });

                const data = await res.json().catch(() => ({}));

                if (!res.ok || data.ok === false) {
                    throw new Error(data.message || data.error || 'Action impossible.');
                }

                if (action === 'disable_notifications') {
                    localStorage.setItem('mol_chat_notifications_enabled', data.enabled ? '1' : '0');
                }

                if (action === 'message_sounds') {
                    localStorage.setItem('mol_chat_sounds_enabled', data.enabled ? '1' : '0');
                    window.MOL_CHAT_SOUND_ENABLED = !!data.enabled;
                }

                if (action === 'mark_all_read') {
                    document.querySelectorAll('.mol-unread').forEach(el => el.remove());

                    if (typeof window.MOLChatRefreshList === 'function') {
                        await window.MOLChatRefreshList(document.getElementById('molChatSearch')?.value?.trim() || '');
                    }
                }

                if (data.redirectUrl) {
                    window.location.href = data.redirectUrl;
                    return;
                }

                if (data.message && window.Swal) {
                    Swal.fire({
                        icon: 'success',
                        title: data.message,
                        confirmButtonColor: '#2563eb',
                        timer: 1800,
                        showConfirmButton: false
                    });
                }
            };
        </script>

