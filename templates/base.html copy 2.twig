                async function bindEmojiPickerForToast(conversationId) {
                    await ensureEmojiLib();

                    const btn = qs(`molEmojiBtn-${conversationId}`);
                    const input = qs(`molToastInput-${conversationId}`);
                    if (!btn || !input || btn.__emojiBound) return;
                    btn.__emojiBound = true;

                    const Ctor =
                        typeof window.EmojiButton === 'function'
                            ? window.EmojiButton
                            : window.EmojiButton?.EmojiButton;

                    if (!Ctor) return;

                    const picker = new Ctor({
                        position: 'top-start',
                        autoHide: true,
                        theme: 'light',
                        rootElement: document.body,
                        zIndex: 2147483647
                    });

                    btn.addEventListener('click', (e) => {
                        e.preventDefault();
                        picker.togglePicker(btn);
                    });

                    picker.on('emoji', (selection) => {
                        const emoji = typeof selection === 'string' ? selection : selection?.emoji;
                        if (!emoji) return;

                        input.value = (input.value || '') + emoji;
                        input.dispatchEvent(new Event('input', { bubbles: true }));
                        input.focus();
                    });
                }

                async function openBubble(conv) {
                    const container = qs('molChatToasts');
                    if (!container) return;

                    const convId = Number(conv.id || 0);
                    if (!convId) return;

                    let toast = qs(`molToast-${convId}`);

                    if (!toast) {
                        container.insertAdjacentHTML('beforeend', toastTemplate({
                            id: convId,
                            name: conv.name,
                            avatar: conv.avatar || conv.avatarUrl || '',
                            online: conv.online,
                            presence: conv.presence || 'offline'
                        }));

                        toast = qs(`molToast-${convId}`);
                        if (!toast) return;

                        const ddToggle = toast.querySelector('[data-bs-toggle="dropdown"]');
                        if (ddToggle && window.bootstrap?.Dropdown) {
                            window.bootstrap.Dropdown.getOrCreateInstance(ddToggle, { autoClose: 'outside' });
                        }

                        const dropdown = toast.querySelector('.dropdown-menu');
                        if (dropdown && !toast.__callBound) {
                            toast.__callBound = true;
                            dropdown.addEventListener('click', (e) => {
                                const a = e.target.closest('[data-call-type]');
                                if (!a) return;
                                e.preventDefault();
                                window.MOLStartConversationCall?.(convId, a.dataset.callType);
                            });
                        }

                        await bindEmojiPickerForToast(convId);
                        initMercureConversation(convId);
                    }

                    if (window.bootstrap?.Toast) {
                        window.bootstrap.Toast.getOrCreateInstance(toast).show();
                    } else {
                        toast.classList.add('show');
                        toast.style.display = 'block';
                    }

                    await refreshBubble(convId);
                    handleComposerInput(convId);
                    renderReplyBox(convId);

                    setTimeout(() => qs(`molToastInput-${convId}`)?.focus(), 120);
                }

                async function uploadForm(endpointTemplate, conversationId, formData) {
                    const res = await fetch(molUrl(endpointTemplate, conversationId), {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: formData
                    });

                    const raw = await res.text();
                    let data = {};

                    try {
                        data = raw ? JSON.parse(raw) : {};
                    } catch (_) {
                        throw new Error('Réponse invalide du serveur.');
                    }

                    if (!res.ok || data.ok === false) {
                        throw new Error(data.error || ('HTTP ' + res.status));
                    }

                    return data;
                }

                async function sendText(conversationId, content) {
                    const reply = CHAT.replyState[conversationId] || null;

                    const res = await fetch(molUrl(window.MOL_CHAT.urls.send, conversationId), {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({
                            content,
                            replyToId: reply?.id || null
                        })
                    });

                    const raw = await res.text();
                    let data = {};

                    try {
                        data = raw ? JSON.parse(raw) : {};
                    } catch (e) {
                        data = {};
                    }

                    if (!res.ok || data.ok === false) {
                        throw new Error(data.error || data.message || ('HTTP ' + res.status));
                    }

                    return data;
                }

                async function sendToastText(conversationId) {
                    const input = qs(`molToastInput-${conversationId}`);

                    if (!input) return;

                    const content = input.value.trim();

                    if (!content) return;

                    input.value = '';
                    input.style.height = 'auto';
                    input.disabled = true;

                    handleComposerInput(conversationId);

                    try {
                        await sendText(conversationId, content);
                        clearReply(conversationId);
                        await refreshConversationEverywhere(conversationId);
                        await refreshList(qs('molChatSearch')?.value?.trim() || '');
                        onNewMessage(conversationId);
                    } catch (e) {
                        console.warn('Message envoyé ou erreur de refresh:', e);

                        await refreshConversationEverywhere(conversationId).catch(() => {});
                        await refreshList(qs('molChatSearch')?.value?.trim() || '').catch(() => {});
                    } finally {
                        input.disabled = false;
                        input.focus();
                    }
                }

                async function sendMobileText() {
                    const convId = Number(CHAT.currentMobileConversationId || 0);
                    const input = qs('molChatThreadInput');

                    if (!convId || !input) return;

                    const content = input.value.trim();

                    if (!content) return;

                    input.value = '';
                    input.disabled = true;

                    autoResize(input);
                    handleMobileComposerState();

                    try {
                        await sendText(convId, content);
                        clearReply(convId);
                        await refreshConversationEverywhere(convId);
                        await refreshList(qs('molChatSearch')?.value?.trim() || '');
                        onNewMessage(convId);
                    } catch (e) {
                        console.warn('Message envoyé ou erreur de refresh:', e);

                        await refreshConversationEverywhere(convId).catch(() => {});
                        await refreshList(qs('molChatSearch')?.value?.trim() || '').catch(() => {});
                    } finally {
                        input.disabled = false;
                        input.focus();
                    }
                }

                async function sendFile(conversationId, file) {
                    if (!file) return;
                    if (!window.MOL_CHAT?.urls?.sendFile) {
                        notify('error', "{% trans %}Configuration manquante{% endtrans %}", "{% trans %}URL d’envoi de fichier non configurée.{% endtrans %}");
                        return;
                    }

                    try {
                        const fd = new FormData();
                        fd.append('file', file);

                        const reply = CHAT.replyState[conversationId];
                        if (reply?.id) fd.append('replyToId', String(reply.id));

                        await uploadForm(window.MOL_CHAT.urls.sendFile, conversationId, fd);
                        clearReply(conversationId);
                        await refreshConversationEverywhere(conversationId);
                        await refreshList(qs('molChatSearch')?.value?.trim() || '');
                    } catch (e) {
                        console.error(e);
                        notify('error', "{% trans %}Envoi impossible{% endtrans %}", e?.message || "{% trans %}Impossible d’envoyer le fichier.{% endtrans %}");
                    }
                }

                async function toggleVoice(conversationId) {
                    const desktopBtn = qs(`molMicBtn-${conversationId}`);
                    const mobileBtn = CHAT.currentMobileConversationId === Number(conversationId) ? qs('molChatThreadMicBtn') : null;
                    const btn = mobileBtn || desktopBtn;
                    if (!btn) return;

                    const current = CHAT.voiceRecorders[conversationId];
                    if (current?.recorder?.state === 'recording') {
                        current.recorder.stop();
                        btn.classList.remove('is-recording');
                        return;
                    }

                    if (!navigator.mediaDevices?.getUserMedia || typeof MediaRecorder === 'undefined') {
                        notify('error', "{% trans %}Indisponible{% endtrans %}", "{% trans %}L’enregistrement vocal n’est pas supporté sur cet appareil.{% endtrans %}");
                        return;
                    }

                    if (!window.MOL_CHAT?.urls?.sendVoice) {
                        notify('error', "{% trans %}Configuration manquante{% endtrans %}", "{% trans %}URL d’envoi vocal non configurée.{% endtrans %}");
                        return;
                    }

                    try {
                        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                        const mimeType = MediaRecorder.isTypeSupported('audio/webm;codecs=opus')
                            ? 'audio/webm;codecs=opus'
                            : (MediaRecorder.isTypeSupported('audio/webm') ? 'audio/webm' : '');

                        const recorder = mimeType ? new MediaRecorder(stream, { mimeType }) : new MediaRecorder(stream);
                        const chunks = [];

                        recorder.ondataavailable = (e) => {
                            if (e.data && e.data.size > 0) chunks.push(e.data);
                        };

                        recorder.onstop = async () => {
                            btn.classList.remove('is-recording');
                            stream.getTracks().forEach(t => t.stop());

                            const blob = new Blob(chunks, { type: recorder.mimeType || 'audio/webm' });
                            if (!blob.size) return;

                            const ext = blob.type.includes('ogg') ? 'ogg' : blob.type.includes('mp4') ? 'm4a' : 'webm';
                            const file = new File([blob], `voice-${Date.now()}.${ext}`, { type: blob.type || 'audio/webm' });

                            try {
                                const fd = new FormData();
                                fd.append('voice', file);

                                const reply = CHAT.replyState[conversationId];
                                if (reply?.id) fd.append('replyToId', String(reply.id));

                                await uploadForm(window.MOL_CHAT.urls.sendVoice, conversationId, fd);
                                clearReply(conversationId);
                                await refreshConversationEverywhere(conversationId);
                                await refreshList(qs('molChatSearch')?.value?.trim() || '');
                            } catch (e) {
                                console.error(e);
                                notify('error', "{% trans %}Envoi impossible{% endtrans %}", e?.message || "{% trans %}Impossible d’envoyer le message vocal.{% endtrans %}");
                            }
                        };

                        CHAT.voiceRecorders[conversationId] = { recorder, stream };
                        recorder.start();
                        btn.classList.add('is-recording');
                    } catch (e) {
                        console.error(e);
                        notify('error', "{% trans %}Enregistrement impossible{% endtrans %}", "{% trans %}Impossible de démarrer l’enregistrement.{% endtrans %}");
                    }
                }

                function handleComposerInput(conversationId) {
                    const input = qs(`molToastInput-${conversationId}`);
                    const likeBtn = qs(`molLikeBtn-${conversationId}`);
                    const sendBtn = qs(`molSendBtn-${conversationId}`);
                    if (!input || !likeBtn || !sendBtn) return;

                    const hasContent = (input.value || '').replace(/\s/g, '').length > 0;
                    likeBtn.classList.toggle('mol-hidden', hasContent);
                    sendBtn.classList.toggle('mol-hidden', !hasContent);
                }

                function handleMobileComposerState() {
                    const input = qs('molChatThreadInput');
                    const likeBtn = qs('molChatThreadLikeBtn');
                    const sendBtn = qs('molChatThreadSend');
                    if (!input || !likeBtn || !sendBtn) return;

                    const hasContent = (input.value || '').replace(/\s/g, '').length > 0;
                    likeBtn.classList.toggle('mol-hidden', hasContent);
                    sendBtn.classList.toggle('mol-hidden', !hasContent);
                }

                async function sendLike(conversationId) {
                    const desktopBtn = qs(`molLikeBtn-${conversationId}`);
                    const mobileBtn = Number(CHAT.currentMobileConversationId || 0) === Number(conversationId)
                        ? qs('molChatThreadLikeBtn')
                        : null;

                    const buttons = [desktopBtn, mobileBtn].filter(Boolean);

                    if (!buttons.length) return;

                    if (buttons.some(btn => btn.dataset.sending === '1')) {
                        return;
                    }

                    buttons.forEach((btn) => {
                        btn.dataset.sending = '1';
                        btn.disabled = true;
                        btn.classList.add('is-sending');
                    });

                    try {
                        await sendText(conversationId, '👍');
                        clearReply(conversationId);
                        await refreshConversationEverywhere(conversationId);
                        await refreshList(qs('molChatSearch')?.value?.trim() || '');
                        onNewMessage(conversationId);
                    } catch (e) {
                        console.warn('Pouce envoyé ou erreur refresh:', e);

                        await refreshConversationEverywhere(conversationId).catch(() => {});
                        await refreshList(qs('molChatSearch')?.value?.trim() || '').catch(() => {});
                    } finally {
                        buttons.forEach((btn) => {
                            btn.dataset.sending = '0';
                            btn.disabled = false;
                            btn.classList.remove('is-sending');
                        });
                    }
                }

                function ensureCameraOverlay() {
                    let overlay = qs('molCameraOverlay');
                    if (overlay) return overlay;

                    document.body.insertAdjacentHTML('beforeend', `
                        <div id="molCameraOverlay" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.72);z-index:2147483647;align-items:center;justify-content:center;padding:20px;">
                            <div style="width:min(640px,100%);background:#fff;border-radius:24px;padding:14px;box-shadow:0 24px 60px rgba(15,23,42,.25);">
                                <video id="molCameraVideo" autoplay playsinline style="width:100%;border-radius:16px;background:#000;"></video>
                                <canvas id="molCameraCanvas" class="d-none"></canvas>
                                <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:12px;">
                                    <button type="button" id="molCameraCloseBtn" class="btn btn-light">Fermer</button>
                                    <button type="button" id="molCameraSnapBtn" class="btn btn-primary">Capturer</button>
                                </div>
                            </div>
                        </div>
                    `);

                    return qs('molCameraOverlay');
                }

                function isProbablyMobileDevice() {
                    return /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent);
                }

                async function openDesktopCamera(conversationId) {
                    const overlay = ensureCameraOverlay();
                    const video = qs('molCameraVideo');
                    const closeBtn = qs('molCameraCloseBtn');
                    const snapBtn = qs('molCameraSnapBtn');

                    CHAT.cameraConversationId = conversationId;
                    CHAT.cameraStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });

                    video.srcObject = CHAT.cameraStream;
                    overlay.style.display = 'flex';

                    closeBtn.onclick = closeDesktopCamera;
                    snapBtn.onclick = captureDesktopCamera;
                }

                function closeDesktopCamera() {
                    const overlay = qs('molCameraOverlay');
                    const video = qs('molCameraVideo');

                    if (CHAT.cameraStream) {
                        CHAT.cameraStream.getTracks().forEach(t => t.stop());
                        CHAT.cameraStream = null;
                    }

                    if (video) video.srcObject = null;
                    if (overlay) overlay.style.display = 'none';
                }

                async function captureDesktopCamera() {
                    const video = qs('molCameraVideo');
                    const canvas = qs('molCameraCanvas');
                    if (!video || !canvas || !CHAT.cameraConversationId) return;

                    canvas.width = video.videoWidth || 1280;
                    canvas.height = video.videoHeight || 720;

                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

                    const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.92));
                    if (!blob) return;

                    const file = new File([blob], `camera-${Date.now()}.jpg`, { type: 'image/jpeg' });
                    closeDesktopCamera();
                    await sendFile(CHAT.cameraConversationId, file);
                }

                async function handleCameraClick(conversationId) {
                    if (isProbablyMobileDevice()) {
                        const input = qs(`molCamera-${conversationId}`);

                        if (input) {
                            input.setAttribute('accept', 'image/*');
                            input.setAttribute('capture', 'environment');
                            input.click();
                        }

                        return;
                    }

                    try {
                        await openDesktopCamera(conversationId);
                    } catch (e) {
                        console.error(e);

                        notify(
                            'error',
                            "{% trans %}Caméra indisponible{% endtrans %}",
                            "{% trans %}Impossible d’ouvrir la caméra.{% endtrans %}"
                        );
                    }
                }

                async function startWithUser(userId) {
                    try {
                        const base = window.location.origin + (window.MOL_CHAT?.baseUrl || '');
                        const url = new URL(`/chat/conversation/with/${userId}`, base);

                        const res = await fetch(url.toString(), {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        if (!res.ok) throw new Error('HTTP ' + res.status);
                        const data = await res.json();
                        if (!data?.ok) return;

                        await refreshList(qs('molChatSearch')?.value?.trim() || '');
                        await openConversation(data.conversationId);
                    } catch (e) {
                        console.error('startWithUser error', e);
                    }
                }

                async function openConversation(conversationId) {
                    const item = document.querySelector(`.mol-chat-item[data-id="${conversationId}"]`);

                    const conv = item ? {
                        id: Number(item.dataset.id || 0),
                        name: item.dataset.name || 'Conversation',
                        avatar: item.dataset.avatar || '',
                        online: item.dataset.online === '1',
                        presence: item.dataset.presence || 'offline'
                    } : {
                        id: Number(conversationId || 0),
                        name: 'Conversation',
                        avatar: '',
                        online: false,
                        presence: 'offline'
                    };

                    if (!conv.id) return;

                    if (isMobileChat()) {
                        await openConversationMobile(conv);
                    } else {
                        await openBubble(conv);
                    }
                }

                function onToastKeydown(e, conversationId) {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        sendToastText(conversationId);
                    }
                }

                function showTyping(conversationId) {
                    const targets = [];
                    const bubbleBox = qs(`molToastMsgs-${conversationId}`);
                    const mobileBox = CHAT.currentMobileConversationId === Number(conversationId) ? qs('molChatThreadMsgs') : null;

                    if (bubbleBox) targets.push(bubbleBox);
                    if (mobileBox) targets.push(mobileBox);

                    targets.forEach(box => {
                        if (box.querySelector(`[data-mol-typing="${conversationId}"]`)) return;
                        const wrap = document.createElement('div');
                        wrap.className = 'd-flex mb-2';
                        wrap.setAttribute('data-mol-typing', String(conversationId));
                        wrap.innerHTML = `
                            <div class="mol-typing">
                                <div class="mol-dots">
                                    <span class="mol-dot"></span>
                                    <span class="mol-dot"></span>
                                    <span class="mol-dot"></span>
                                </div>
                                <div class="small text-secondary">écrit...</div>
                            </div>
                        `;
                        box.appendChild(wrap);
                        box.scrollTop = box.scrollHeight;
                    });
                }

                function hideTyping(conversationId) {
                    [qs(`molToastMsgs-${conversationId}`), qs('molChatThreadMsgs')].forEach(box => {
                        if (!box) return;
                        box.querySelectorAll(`[data-mol-typing="${conversationId}"]`).forEach(n => n.remove());
                    });
                }

                function notifyTyping(conversationId, typing) {
                    if (!window.MOL_CHAT?.urls?.typing) return;

                    fetch(molUrl(window.MOL_CHAT.urls.typing, conversationId), {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({ typing })
                    }).catch(() => {});
                }

                function handleTypingInput(conversationId) {
                    if (CHAT.typingTimers.has(conversationId)) {
                        clearTimeout(CHAT.typingTimers.get(conversationId));
                    }

                    if (!CHAT.typingState.get(conversationId)) {
                        CHAT.typingState.set(conversationId, true);
                        notifyTyping(conversationId, true);
                    }

                    const timer = setTimeout(() => {
                        CHAT.typingState.set(conversationId, false);
                        notifyTyping(conversationId, false);
                        CHAT.typingTimers.delete(conversationId);
                    }, 900);

                    CHAT.typingTimers.set(conversationId, timer);
                }

                function initMercureConversation(conversationId) {
                    const hub = window.MERCURE_HUB || window.MOL_CHAT?.mercureHub;
                    if (!hub || CHAT.chatMercure.has(conversationId)) return;

                    try {
                        const url = new URL(hub);
                        url.searchParams.append('topic', `chat/conversation/${conversationId}`);
                        url.searchParams.append('topic', `chat/conversation/${conversationId}/typing`);

                        const es = new EventSource(url.toString());

                        es.onmessage = async (event) => {
                            let data = null;
                            try {
                                data = JSON.parse(event.data);
                            } catch (_) {
                                return;
                            }

                            if (data?.typing !== undefined) {
                                if (data.typing) showTyping(data.conversationId || conversationId);
                                else hideTyping(data.conversationId || conversationId);
                                return;
                            }

                            if (data?.message || data?.conversationId) {
                                await refreshConversationEverywhere(conversationId);
                                await refreshList(qs('molChatSearch')?.value?.trim() || '');
                                onNewMessage(conversationId);
                            }
                        };

                        es.onerror = (e) => {
                            console.warn('Mercure conversation error', e);
                        };

                        CHAT.chatMercure.set(conversationId, es);
                    } catch (e) {
                        console.warn('Mercure init failed', e);
                    }
                }

                function ensureMobileThreadUi() {
