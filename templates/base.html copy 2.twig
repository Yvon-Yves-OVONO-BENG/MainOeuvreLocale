        <script>
            (() => {
                if (window.__MOL_CHAT_CLEAN_SAFE_PATCH__) return;
                window.__MOL_CHAT_CLEAN_SAFE_PATCH__ = true;

                const SAFE = {
                    menus: new Set(),
                    raf: null
                };

                function qs(id) {
                    return document.getElementById(id);
                }

                function qsa(selector, root = document) {
                    return Array.from(root.querySelectorAll(selector));
                }

                function isDesktop() {
                    return window.matchMedia && window.matchMedia('(min-width: 992px)').matches;
                }

                function clamp(value, min, max) {
                    return Math.max(min, Math.min(max, value));
                }

                function debounce(fn, wait = 180) {
                    let timer;
                    return (...args) => {
                        clearTimeout(timer);
                        timer = setTimeout(() => fn(...args), wait);
                    };
                }

                function getToastConvId(toast) {
                    if (!toast || !toast.id) return 0;
                    return Number(String(toast.id).replace('molToast-', '')) || 0;
                }

                function getThreadConvId() {
                    return Number(qs('molChatThread')?.dataset?.conversationId || 0);
                }

                function getToggleConversationId(toggle) {
                    const toast = toggle?.closest?.('#molChatToasts .toast');
                    if (toast) return getToastConvId(toast);

                    const thread = toggle?.closest?.('#molChatThread');
                    if (thread) return getThreadConvId();

                    const idMatch = String(toggle?.id || '').match(/(\d+)$/);
                    return idMatch ? Number(idMatch[1]) : 0;
                }

                function filterLocalConversations(query) {
                    const list = qs('molChatList');
                    if (!list) return;

                    const items = qsa('.mol-chat-item', list);
                    if (!items.length) return;

                    const q = String(query || '').trim().toLowerCase();
                    let visible = 0;

                    items.forEach((item) => {
                        const name = String(item.dataset.name || '').toLowerCase();
                        const text = String(item.textContent || '').toLowerCase();
                        const match = !q || name.includes(q) || text.includes(q);

                        item.style.display = match ? '' : 'none';
                        if (match) visible++;
                    });

                    let empty = qs('molChatSearchEmptyState');

                    if (!visible) {
                        if (!empty) {
                            empty = document.createElement('li');
                            empty.id = 'molChatSearchEmptyState';
                            empty.className = 'text-secondary small py-3';
                            empty.textContent = 'Aucune conversation trouvée.';
                            list.appendChild(empty);
                        }
                    } else if (empty) {
                        empty.remove();
                    }
                }

                function setDockShift() {
                    const panel = qs('molChatPanel');
                    let shift = 0;

                    if (isDesktop() && panel && panel.classList.contains('is-open')) {
                        shift = Math.ceil(panel.getBoundingClientRect().width || 390) + 16;
                    }

                    document.documentElement.style.setProperty('--mol-chat-dock-shift', shift + 'px');

                    const dock = qs('molChatToasts');
                    if (dock && isDesktop()) {
                        requestAnimationFrame(() => {
                            dock.scrollLeft = dock.scrollWidth;
                        });
                    }
                }

                function closePanelMenu() {
                    const menu = qs('molChatPanelMenu');
                    const btn = qs('molChatPanelOptionsBtn');

                    if (menu) menu.classList.remove('is-open');
                    if (btn) btn.setAttribute('aria-expanded', 'false');
                }

                function ensurePanelMenu() {
                    const panel = qs('molChatPanel');
                    const header = panel?.querySelector('.mol-chat-panel__header');
                    if (!panel || !header) return;

                    const closeBtn = header.querySelector('.mol-btn-icon[onclick*="MOLChatClose"]');
                    if (!closeBtn) return;

                    let actions = header.querySelector('.mol-panel-actions');
                    if (!actions) {
                        actions = document.createElement('div');
                        actions.className = 'mol-panel-actions';
                        header.appendChild(actions);
                    }

                    let optionsBtn = qs('molChatPanelOptionsBtn');
                    if (!optionsBtn) {
                        optionsBtn = document.createElement('button');
                        optionsBtn.type = 'button';
                        optionsBtn.id = 'molChatPanelOptionsBtn';
                        optionsBtn.className = 'mol-btn-icon';
                        optionsBtn.setAttribute('aria-label', 'Options');
                        optionsBtn.setAttribute('aria-expanded', 'false');
                        optionsBtn.innerHTML = '<i class="bi bi-three-dots"></i>';
                        actions.appendChild(optionsBtn);
                    }

                    if (closeBtn.parentElement !== actions) {
                        actions.appendChild(closeBtn);
                    }

                    let menu = qs('molChatPanelMenu');
                    if (!menu) {
                        menu = document.createElement('div');
                        menu.id = 'molChatPanelMenu';
                        menu.className = 'mol-panel-menu';
                        menu.innerHTML = `
                            <button type="button" class="mol-panel-menu__item" data-action="mark_all_read">
                                <i class="bi bi-check2-square"></i>
                                <span>Tout marquer comme lu</span>
                            </button>

                            <a href="{{ path('app_chat_settings') }}" class="mol-panel-menu__item text-decoration-none">
                                <i class="bi bi-gear"></i>
                                <span>Paramètres du chat</span>
                            </a>

                            <button
                                type="button"
                                class="mol-panel-menu__item"
                                data-notification-toggle
                                data-toggle-url="{{ path('app_notifications_toggle') }}"
                                data-status-url="{{ path('app_notifications_status') }}"
                                data-csrf="{{ csrf_token('notification_preference') }}"
                            >
                                <i class="bi bi-bell-slash"></i>
                                <span>Désactiver les notifications</span>
                            </button>

                            <button type="button" class="mol-panel-menu__item" data-action="message_sounds">
                                <i class="bi bi-volume-up"></i>
                                <span>Sons des messages</span>
                            </button>

                            <button type="button" class="mol-panel-menu__item" data-action="block_setting">
                                <i class="bi bi-slash-circle"></i>
                                <span>Réglages de blocage</span>
                            </button>

                            <div class="mol-panel-menu__divider"></div>

                            <button type="button" class="mol-panel-menu__item" data-action="create_group_chat" data-mol-create-group-trigger="1">
                                <i class="bi bi-people"></i>
                                <span>Groupes</span>
                            </button>
                                                    `;
                        document.body.appendChild(menu);
                    }

                    if (!optionsBtn.__molSafePanelBound) {
                        optionsBtn.__molSafePanelBound = true;

                        optionsBtn.addEventListener('click', (e) => {
                            e.preventDefault();
                            e.stopPropagation();

                            const isOpen = menu.classList.contains('is-open');
                            closePanelMenu();

                            if (isOpen) return;

                            const rect = optionsBtn.getBoundingClientRect();
                            const width = 250;
                            const left = clamp(rect.right - width, 10, window.innerWidth - width - 10);
                            const top = clamp(rect.bottom + 8, 10, window.innerHeight - 20);

                            menu.style.left = left + 'px';
                            menu.style.top = top + 'px';
                            menu.classList.add('is-open');
                            optionsBtn.setAttribute('aria-expanded', 'true');
                        });
                    }

                    if (!menu.__molSafePanelActionsBound) {
                        menu.__molSafePanelActionsBound = true;

                        menu.addEventListener('click', async (e) => {
                            const item = e.target.closest('[data-action]');
                            if (!item) return;

                            const action = item.dataset.action;
                            closePanelMenu();

                            if (typeof window.MOLChatPanelAction === 'function') {
                                window.MOLChatPanelAction(action);
                                return;
                            }

                            if (action === 'mark_all_read' && typeof window.MOLChatRefreshList === 'function') {
                                await window.MOLChatRefreshList(qs('molChatSearch')?.value?.trim() || '');
                                return;
                            }

                            console.log('[MOL CHAT PANEL ACTION]', action);
                        });
                    }
                }

                function enhanceComposerRow(row) {
                    if (!row || row.__molSafeComposerEnhanced) return;
                    row.__molSafeComposerEnhanced = true;

                    let toggle = row.querySelector('.mol-more-toggle');

                    if (!toggle) {
                        toggle = document.createElement('button');
                        toggle.type = 'button';
                        toggle.className = 'mol-more-toggle';
                        toggle.title = 'Plus d’options';
                        toggle.setAttribute('aria-label', 'Plus d’options');
                        toggle.setAttribute('aria-expanded', 'false');
                        toggle.innerHTML = '<i class="bi bi-chevron-right"></i>';
                        row.insertBefore(toggle, row.firstElementChild);
                    }

                    toggle.addEventListener('click', (e) => {
                        e.preventDefault();
                        e.stopPropagation();

                        const open = row.classList.toggle('is-open');
                        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                    });

                    const left = row.querySelector('.mol-bottombar__left');
                    if (left && !left.__molSafeCloseBound) {
                        left.__molSafeCloseBound = true;

                        left.addEventListener('click', (e) => {
                            if (!e.target.closest('button')) return;

                            setTimeout(() => {
                                row.classList.remove('is-open');
                                toggle.setAttribute('aria-expanded', 'false');
                            }, 120);
                        });
                    }

                    const input = row.querySelector('.mol-compose__input');
                    const likeBtn = row.querySelector('.mol-like-btn');
                    const sendBtn = row.querySelector('.mol-send-btn');

                    if (input && likeBtn && sendBtn && !input.__molSafeSyncBound) {
                        input.__molSafeSyncBound = true;

                        const sync = () => {
                            const hasContent = (input.value || '').replace(/\s/g, '').length > 0;
                            likeBtn.classList.toggle('mol-hidden', hasContent);
                            sendBtn.classList.toggle('mol-hidden', !hasContent);
                        };

                        input.addEventListener('input', sync);
                        input.addEventListener('keyup', sync);
                        sync();
                    }
                }

                function enhanceComposers(root = document) {
                    qsa('.mol-bottombar__row', root).forEach(enhanceComposerRow);
                }

                function closeAllPortalMenus(except = null) {
                    SAFE.menus.forEach((menu) => {
                        if (menu === except) return;

                        menu.classList.remove('show');
                        menu.style.display = 'none';
                        menu.style.left = '';
                        menu.style.top = '';
                        menu.style.visibility = '';

                        const toggle = menu.__molSafeToggle;
                        if (toggle) toggle.setAttribute('aria-expanded', 'false');
                    });
                }

                function getToggleMenu(toggle) {
                    if (!toggle) return null;
                    if (toggle.__molSafePortalMenu) return toggle.__molSafePortalMenu;

                    const menu =
                        toggle.parentElement?.querySelector('.dropdown-menu') ||
                        (toggle.id ? document.querySelector(`.dropdown-menu[aria-labelledby="${toggle.id}"]`) : null);

                    if (menu) {
                        toggle.__molSafePortalMenu = menu;
                        menu.__molSafeToggle = toggle;
                    }

                    return menu || null;
                }

                function placePortalMenu(toggle, menu) {
                    if (!toggle || !menu) return;

                    if (menu.parentElement !== document.body) {
                        document.body.appendChild(menu);
                    }

                    menu.classList.add('mol-chat-portal-menu');
                    menu.style.position = 'fixed';
                    menu.style.display = 'block';
                    menu.style.visibility = 'hidden';
                    menu.style.left = '0px';
                    menu.style.top = '0px';
                    menu.classList.add('show');

                    const rect = toggle.getBoundingClientRect();
                    const menuRect = menu.getBoundingClientRect();

                    const width = Math.max(240, Math.ceil(menuRect.width || 240));
                    const height = Math.max(220, Math.ceil(menuRect.height || 300));

                    let left = rect.right - width;
                    let top = rect.bottom + 8;

                    if (top + height > window.innerHeight - 10) {
                        top = rect.top - height - 8;
                    }

                    left = clamp(left, 10, Math.max(10, window.innerWidth - width - 10));
                    top = clamp(top, 10, Math.max(10, window.innerHeight - height - 10));

                    menu.style.left = left + 'px';
                    menu.style.top = top + 'px';
                    menu.style.visibility = 'visible';
                }

                function disposeBootstrapDropdown(toggle) {
                    try {
                        const Dropdown = window.bootstrap?.Dropdown;
                        if (!Dropdown) return;

                        const instance = Dropdown.getInstance(toggle);
                        if (instance) instance.dispose();
                    } catch (_) {}
                }

                function bindPortalDropdown(toggle) {
                    if (!toggle || toggle.__molSafePortalBound) return;

                    const menu = getToggleMenu(toggle);
                    if (!menu) return;

                    toggle.__molSafePortalBound = true;
                    menu.classList.add('mol-chat-portal-menu');
                    SAFE.menus.add(menu);

                    disposeBootstrapDropdown(toggle);

                    toggle.removeAttribute('data-bs-toggle');
                    toggle.removeAttribute('data-bs-auto-close');
                    toggle.setAttribute('data-mol-chat-dropdown-toggle', '1');

                    toggle.addEventListener('click', (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        e.stopImmediatePropagation();

                        const isOpen = menu.classList.contains('show');
                        closeAllPortalMenus(menu);

                        if (isOpen) {
                            menu.classList.remove('show');
                            menu.style.display = 'none';
                            toggle.setAttribute('aria-expanded', 'false');
                            return;
                        }

                        const convId = getToggleConversationId(toggle);
                        menu.dataset.conversationId = String(convId || 0);
                        menu.__molSafeToggle = toggle;

                        toggle.setAttribute('aria-expanded', 'true');
                        placePortalMenu(toggle, menu);
                    }, true);
                }

                function bindPortalDropdowns(root = document) {
                    qsa(
                        '#molChatToasts [data-bs-toggle="dropdown"], #molChatToasts [data-mol-chat-dropdown-toggle="1"], #molChatThread [data-bs-toggle="dropdown"], #molChatThread [data-mol-chat-dropdown-toggle="1"]',
                        root
                    ).forEach(bindPortalDropdown);
                }

                function getActionFromItem(item) {
                    if (!item) return '';

                    if (item.dataset.chatAction) return item.dataset.chatAction;

                    const onclick = item.getAttribute('onclick') || '';
                    const knownActions = [
                        'deleteConversation',
                        'markUnread',
                        'mute',
                        'archive',
                        'report'
                    ];

                    return knownActions.find((action) => {
                        return onclick.includes("'" + action + "'") || onclick.includes('"' + action + '"');
                    }) || '';
                }

                function bindPortalActions() {
                    if (document.__molSafePortalActionsBound) return;
                    document.__molSafePortalActionsBound = true;

                    document.addEventListener('click', (e) => {
                        const item = e.target.closest('.mol-chat-portal-menu .dropdown-item');
                        if (!item) return;

                        const menu = item.closest('.mol-chat-portal-menu');
                        const convId = Number(menu?.dataset?.conversationId || 0);
                        const callType = item.dataset.callType;
                        const chatAction = getActionFromItem(item);

                        if (!callType && !chatAction) {
                            closeAllPortalMenus();
                            return;
                        }

                        e.preventDefault();
                        e.stopPropagation();
                        e.stopImmediatePropagation();

                        closeAllPortalMenus();

                        if (callType) {
                            if (convId && typeof window.MOLStartConversationCall === 'function') {
                                window.MOLStartConversationCall(convId, callType);
                            }
                            return;
                        }

                        if (chatAction) {
                            if (convId && typeof window.MOLChatRunAction === 'function') {
                                window.MOLChatRunAction(e, convId, chatAction);
                            }
                        }
                    }, true);

                    document.addEventListener('click', (e) => {
                        if (e.target.closest('.mol-chat-portal-menu')) return;
                        if (e.target.closest('[data-mol-chat-dropdown-toggle="1"]')) return;
                        closeAllPortalMenus();
                        closePanelMenu();
                    });

                    document.addEventListener('keydown', (e) => {
                        if (e.key === 'Escape') {
                            closeAllPortalMenus();
                            closePanelMenu();
                        }
                    });

                    window.addEventListener('resize', () => {
                        closeAllPortalMenus();
                        closePanelMenu();
                        setDockShift();
                    });

                    window.addEventListener('scroll', () => {
                        closeAllPortalMenus();
                        closePanelMenu();
                    }, true);
                }

                function bindSearchFix() {
                    const input = qs('molChatSearch');
                    if (!input || input.__molSafeSearchBound) return;

                    input.__molSafeSearchBound = true;

                    const run = () => filterLocalConversations(input.value.trim());

                    input.addEventListener('input', run);
                    input.addEventListener('keyup', run);
                    input.addEventListener('search', run);
                }

                function patchRefreshList() {
                    if (typeof window.MOLChatRefreshList !== 'function') return;
                    if (window.MOLChatRefreshList.__molSafePatched) return;

                    const oldRefresh = window.MOLChatRefreshList;

                    const wrapped = async function(...args) {
                        const result = await oldRefresh.apply(this, args);
                        filterLocalConversations(qs('molChatSearch')?.value?.trim() || '');
                        scheduleEnhance();
                        setDockShift();
                        return result;
                    };

                    wrapped.__molSafePatched = true;
                    window.MOLChatRefreshList = wrapped;
                }

                function patchOpenClose() {
                    if (typeof window.MOLChatOpen === 'function' && !window.MOLChatOpen.__molSafePatched) {
                        const oldOpen = window.MOLChatOpen;

                        const wrapped = async function(...args) {
                            const result = await oldOpen.apply(this, args);
                            scheduleEnhance();
                            setDockShift();
                            return result;
                        };

                        wrapped.__molSafePatched = true;
                        window.MOLChatOpen = wrapped;
                    }

                    if (typeof window.MOLChatClose === 'function' && !window.MOLChatClose.__molSafePatched) {
                        const oldClose = window.MOLChatClose;

                        const wrapped = function(...args) {
                            const result = oldClose.apply(this, args);
                            closePanelMenu();
                            closeAllPortalMenus();
                            setDockShift();
                            return result;
                        };

                        wrapped.__molSafePatched = true;
                        window.MOLChatClose = wrapped;
                    }

                    if (typeof window.MOLChatOpenBubble === 'function' && !window.MOLChatOpenBubble.__molSafePatched) {
                        const oldOpenBubble = window.MOLChatOpenBubble;

                        const wrapped = async function(...args) {
                            setDockShift();
                            const result = await oldOpenBubble.apply(this, args);
                            scheduleEnhance();
                            setDockShift();
                            return result;
                        };

                        wrapped.__molSafePatched = true;
                        window.MOLChatOpenBubble = wrapped;
                    }

                    if (typeof window.MOLChatOpenConversationMobile === 'function' && !window.MOLChatOpenConversationMobile.__molSafePatched) {
                        const oldOpenMobile = window.MOLChatOpenConversationMobile;

                        const wrapped = async function(...args) {
                            const result = await oldOpenMobile.apply(this, args);
                            scheduleEnhance();
                            return result;
                        };

                        wrapped.__molSafePatched = true;
                        window.MOLChatOpenConversationMobile = wrapped;
                    }
                }

                function patchLikeButton() {
                    if (typeof window.MOLChatSendLike !== 'function') return;
                    if (window.MOLChatSendLike.__molSafePatched) return;

                    const oldLike = window.MOLChatSendLike;

                    const wrapped = async function(conversationId) {
                        const desktopBtn = qs(`molLikeBtn-${conversationId}`);
                        const threadBtn = getThreadConvId() === Number(conversationId) ? qs('molChatThreadLikeBtn') : null;
                        const buttons = [desktopBtn, threadBtn].filter(Boolean);

                        if (!buttons.length) return;
                        if (buttons.some(btn => btn.dataset.sending === '1')) return;

                        const oldHtml = new Map();

                        buttons.forEach((btn) => {
                            oldHtml.set(btn, btn.innerHTML);
                            btn.dataset.sending = '1';
                            btn.disabled = true;
                            btn.classList.add('is-sending');
                            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
                        });

                        try {
                            await oldLike(conversationId);
                        } finally {
                            buttons.forEach((btn) => {
                                btn.dataset.sending = '0';
                                btn.disabled = false;
                                btn.classList.remove('is-sending');
                                btn.innerHTML = oldHtml.get(btn) || '<i class="bi bi-hand-thumbs-up-fill"></i>';
                            });
                        }
                    };

                    wrapped.__molSafePatched = true;
                    window.MOLChatSendLike = wrapped;
                }

                function enhanceAll(root = document) {
                    ensurePanelMenu();
                    enhanceComposers(root);
                    bindPortalDropdowns(root);
                    bindSearchFix();
                    filterLocalConversations(qs('molChatSearch')?.value?.trim() || '');
                    setDockShift();
                }

                function scheduleEnhance(root = document) {
                    if (SAFE.raf) cancelAnimationFrame(SAFE.raf);

                    SAFE.raf = requestAnimationFrame(() => {
                        SAFE.raf = null;
                        enhanceAll(root);
                    });
                }

                function observeDom() {
                    if (!window.MutationObserver || document.__molSafeObserved) return;

                    document.__molSafeObserved = true;

                    const run = debounce(() => {
                        patchRefreshList();
                        patchOpenClose();
                        patchLikeButton();
                        scheduleEnhance(document);
                    }, 80);

                    new MutationObserver(run).observe(document.body, {
                        childList: true,
                        subtree: true
                    });
                }

                function boot() {
                    bindPortalActions();
                    patchRefreshList();
                    patchOpenClose();
                    patchLikeButton();
                    enhanceAll(document);
                    observeDom();

                    window.addEventListener('orientationchange', () => {
                        setTimeout(() => {
                            closeAllPortalMenus();
                            scheduleEnhance(document);
                            setDockShift();
                        }, 180);
                    });

                    if (window.visualViewport) {
                        window.visualViewport.addEventListener('resize', () => {
                            closeAllPortalMenus();
                            setDockShift();
                        });
                    }
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', boot);
                } else {
                    boot();
                }
            })();
        </script>

        <script>
            function initPmFlashMessages() {
                document.querySelectorAll('.pm-flash:not([data-flash-ready])').forEach(function (flash) {
                    flash.dataset.flashReady = '1';

                    setTimeout(function () {
                        flash.classList.add('pm-flash-hide');

                        setTimeout(function () {
                            flash.remove();
                        }, 400);
                    }, 4000);

                    flash.addEventListener('click', function () {
                        flash.classList.add('pm-flash-hide');

                        setTimeout(function () {
                            flash.remove();
                        }, 300);
                    });
                });
            }

            document.addEventListener('DOMContentLoaded', initPmFlashMessages);
            document.addEventListener('turbo:load', initPmFlashMessages);
        </script>


        <script>
            (function () {
                window.pmOpenMobileMenu = function (event) {
                    if (event) {
                        event.preventDefault();
                        event.stopPropagation();
                    }

                    const mobileMenu = document.getElementById('pmMobileMenu');
                    const overlay = document.getElementById('pmOverlay');

                    if (mobileMenu) {
                        mobileMenu.classList.add('open');
                        mobileMenu.style.left = '0';
                        mobileMenu.style.visibility = 'visible';
                        mobileMenu.style.pointerEvents = 'auto';
                    }

                    if (overlay) {
                        overlay.classList.add('show');
                        overlay.style.opacity = '1';
                        overlay.style.visibility = 'visible';
                        overlay.style.pointerEvents = 'auto';
                    }

                    document.body.classList.add('pm-menu-open');
                    document.body.style.overflow = 'hidden';
                };

                window.pmCloseMobileMenu = function (event) {
                    if (event) {
                        event.preventDefault();
                        event.stopPropagation();
                        event.stopImmediatePropagation();
                    }

                    const mobileMenu = document.getElementById('pmMobileMenu');
                    const overlay = document.getElementById('pmOverlay');

                    if (mobileMenu) {
                        mobileMenu.classList.remove('open');
                        mobileMenu.style.left = '-100%';
                        mobileMenu.style.visibility = '';
                        mobileMenu.style.pointerEvents = '';
                    }

                    if (overlay) {
                        overlay.classList.remove('show');
                        overlay.style.opacity = '0';
                        overlay.style.visibility = 'hidden';
                        overlay.style.pointerEvents = 'none';
                    }

                    document.body.classList.remove('pm-menu-open');
                    document.body.style.overflow = '';
                };

                document.addEventListener('click', function (event) {
                    const target = event.target instanceof Element ? event.target : null;

                    if (!target) {
                        return;
                    }

                    const hamburger = target.closest('#pmHamburgerBtn');
                    const closeBtn = target.closest('#pmMobileClose');
                    const overlay = target.closest('#pmOverlay');

                    if (hamburger) {
                        window.pmOpenMobileMenu(event);
                        return;
                    }

                    if (closeBtn || overlay) {
                        window.pmCloseMobileMenu(event);
                    }
                }, true);

                document.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape') {
                        window.pmCloseMobileMenu(event);
                    }
                });

                document.addEventListener('turbo:before-cache', function () {
                    window.pmCloseMobileMenu();
                });
            })();
        </script>

