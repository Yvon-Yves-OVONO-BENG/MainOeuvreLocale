        <script id="mol-chat-panel-submenu-module">
                (() => {
                    if (window.__MOL_CHAT_PANEL_SUBMENU_MODULE__) return;
                    window.__MOL_CHAT_PANEL_SUBMENU_MODULE__ = true;

                    const STORAGE_KEYS = {
                        notifications: 'mol_chat_panel_notifications_enabled',
                        sounds: 'mol_chat_panel_message_sounds_enabled'
                    };

                    const MODULE = {
                        menu: null,
                        button: null,
                        ready: false,
                        busyAction: null
                    };

                    const DEFAULT_CONFIG = {
                        urls: {
                            markAllRead: null,
                            notifications: null,
                            sounds: null,
                            blockSettings: null,
                            createGroup: null
                        },
                        callbacks: {
                            markAllRead: null,
                            chatSettings: null,
                            notifications: null,
                            sounds: null,
                            blockSettings: null,
                            createGroup: null
                        }
                    };

                    window.MOL_CHAT_PANEL_MENU = window.MOL_CHAT_PANEL_MENU || {};
                    window.MOL_CHAT_PANEL_MENU.urls = {
                        ...DEFAULT_CONFIG.urls,
                        ...(window.MOL_CHAT_PANEL_MENU.urls || {})
                    };
                    window.MOL_CHAT_PANEL_MENU.callbacks = {
                        ...DEFAULT_CONFIG.callbacks,
                        ...(window.MOL_CHAT_PANEL_MENU.callbacks || {})
                    };

                    function qs(id) {
                        return document.getElementById(id);
                    }

                    function clamp(value, min, max) {
                        return Math.max(min, Math.min(max, value));
                    }

                    function boolFromStorage(key, fallback) {
                        const value = localStorage.getItem(key);

                        if (value === null) return fallback;
                        return value === '1';
                    }

                    function saveBool(key, value) {
                        localStorage.setItem(key, value ? '1' : '0');
                    }

                    function getNotificationsEnabled() {
                        return boolFromStorage(STORAGE_KEYS.notifications, true);
                    }

                    function getSoundsEnabled() {
                        return boolFromStorage(STORAGE_KEYS.sounds, true);
                    }

                    function notify(type, title, text = '') {
                        if (window.Swal) {
                            Swal.fire({
                                icon: type || 'info',
                                title: title || '',
                                text: text || '',
                                confirmButtonColor: '#2563eb',
                                backdrop: 'rgba(15, 23, 42, .42)',
                                customClass: {
                                    popup: 'mol-swal-popup'
                                }
                            });
                            return;
                        }

                        alert([title, text].filter(Boolean).join('\n'));
                    }

                    function getCsrfToken() {
                        return (
                            document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') ||
                            window.MOL_CHAT?.csrfToken ||
                            window.MOL_CSRF_TOKEN ||
                            ''
                        );
                    }

                    async function fetchJson(url, payload = {}) {
                        if (!url) return null;

                        const headers = {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        };

                        const csrf = getCsrfToken();
                        if (csrf) headers['X-CSRF-TOKEN'] = csrf;

                        const res = await fetch(url, {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers,
                            body: JSON.stringify(payload)
                        });

                        const data = await res.json().catch(() => ({}));

                        if (!res.ok || data.ok === false) {
                            throw new Error(data.message || data.error || ('HTTP ' + res.status));
                        }

                        return data;
                    }

                    function createButtonIfNeeded() {
                        const panel = qs('molChatPanel');
                        const header = panel?.querySelector('.mol-chat-panel__header');

                        if (!panel || !header) return null;

                        let actions = header.querySelector('.mol-panel-actions');

                        if (!actions) {
                            actions = document.createElement('div');
                            actions.className = 'mol-panel-actions';
                            header.appendChild(actions);
                        }

                        let button = qs('molChatPanelOptionsBtn');

                        if (!button) {
                            button = document.createElement('button');
                            button.type = 'button';
                            button.id = 'molChatPanelOptionsBtn';
                            button.className = 'mol-btn-icon';
                            button.setAttribute('aria-label', 'Options des messages');
                            button.setAttribute('aria-expanded', 'false');
                            button.innerHTML = '<i class="bi bi-three-dots"></i>';
                            actions.appendChild(button);
                        } else if (button.parentElement !== actions) {
                            actions.appendChild(button);
                        }

                        const closeBtn = header.querySelector('.mol-btn-icon[onclick*="MOLChatClose"]');

                        if (closeBtn && closeBtn.parentElement !== actions) {
                            actions.appendChild(closeBtn);
                        }

                        MODULE.button = button;
                        return button;
                    }

                    function menuTemplate() {
                        const notificationsEnabled = getNotificationsEnabled();
                        const soundsEnabled = getSoundsEnabled();

                        return `
                            <button type="button" class="mol-panel-menu__item" data-mol-panel-action="markAllRead">
                                <i class="bi bi-check2-square"></i>
                                <span class="mol-panel-menu__label">Tout marquer comme lu</span>
                            </button>

                            <a href="{{ path('app_chat_settings') }}" class="mol-panel-menu__item text-decoration-none">
                                <i class="bi bi-gear"></i>
                                <span>Paramètres du chat</span>
                            </a>

                            <button
                                type="button"
                                class="mol-panel-menu__item"
                                data-notification-toggle
                                data-toggle-url="{{ path('app_notifications_toggle') }}"
                                data-status-url="{{ path('app_notifications_status') }}"
                                data-csrf="{{ csrf_token('notification_preference') }}"
                            >
                                <i class="bi bi-bell-slash"></i>
                                <span>Désactiver les notifications</span>
                            </button>

                            <button type="button" class="mol-panel-menu__item" data-mol-panel-action="sounds">
                                <i class="bi ${soundsEnabled ? 'bi-volume-up' : 'bi-volume-mute'}"></i>
                                <span class="mol-panel-menu__label">
                                    ${soundsEnabled ? 'Sons des messages' : 'Sons désactivés'}
                                </span>
                                <span class="mol-panel-menu__badge">${soundsEnabled ? 'ON' : 'OFF'}</span>
                            </button>

                            <button type="button" class="mol-panel-menu__item" data-mol-panel-action="blockSettings">
                                <i class="bi bi-slash-circle"></i>
                                <span class="mol-panel-menu__label">Réglages de blocage</span>
                            </button>

                            <div class="mol-panel-menu__divider"></div>

                            <button type="button" class="mol-panel-menu__item" data-action="create_group_chat" data-mol-create-group-trigger="1">
                                <i class="bi bi-people"></i>
                                <span>Groupes</span>
                            </button>
                        `;
                    }

                    function createMenuIfNeeded() {
                        let oldMenu = qs('molChatPanelMenu');

                        if (oldMenu) {
                            oldMenu.remove();
                        }

                        const menu = document.createElement('div');
                        menu.id = 'molChatPanelMenu';
                        menu.setAttribute('role', 'menu');
                        menu.setAttribute('aria-hidden', 'true');
                        menu.innerHTML = menuTemplate();

                        document.body.appendChild(menu);
                        MODULE.menu = menu;

                        return menu;
                    }

                    function refreshMenuContent() {
                        if (!MODULE.menu) return;

                        MODULE.menu.innerHTML = menuTemplate();
                    }

                    function isOpen() {
                        return !!MODULE.menu?.classList.contains('is-open');
                    }

                    function closeMenu() {
                        if (!MODULE.menu) return;

                        MODULE.menu.classList.remove('is-open');
                        MODULE.menu.setAttribute('aria-hidden', 'true');
                        MODULE.menu.style.removeProperty('left');
                        MODULE.menu.style.removeProperty('top');

                        if (MODULE.button) {
                            MODULE.button.setAttribute('aria-expanded', 'false');
                        }
                    }

                    function placeMenu() {
                        const button = MODULE.button;
                        const menu = MODULE.menu;

                        if (!button || !menu) return;

                        refreshMenuContent();

                        menu.classList.add('is-open');
                        menu.setAttribute('aria-hidden', 'false');
                        menu.style.visibility = 'hidden';
                        menu.style.left = '0px';
                        menu.style.top = '0px';

                        const rect = button.getBoundingClientRect();
                        const menuRect = menu.getBoundingClientRect();

                        const width = Math.ceil(menuRect.width || 280);
                        const height = Math.ceil(menuRect.height || 320);

                        let left = rect.right - width;
                        let top = rect.bottom + 10;

                        if (top + height > window.innerHeight - 10) {
                            top = rect.top - height - 10;
                        }

                        left = clamp(left, 10, Math.max(10, window.innerWidth - width - 10));
                        top = clamp(top, 10, Math.max(10, window.innerHeight - height - 10));

                        menu.style.left = left + 'px';
                        menu.style.top = top + 'px';
                        menu.style.visibility = 'visible';

                        button.setAttribute('aria-expanded', 'true');
                    }

                    function toggleMenu() {
                        if (isOpen()) {
                            closeMenu();
                            return;
                        }

                        placeMenu();
                    }

                    function setActionLoading(action, loading) {
                        MODULE.busyAction = loading ? action : null;

                        const item = MODULE.menu?.querySelector(`[data-mol-panel-action="${action}"]`);
                        if (!item) return;

                        item.classList.toggle('is-loading', loading);

                        if (loading) {
                            item.dataset.oldHtml = item.innerHTML;
                            item.innerHTML = `
                                <span class="mol-panel-menu__spinner"></span>
                                <span class="mol-panel-menu__label">Traitement...</span>
                            `;
                        } else if (item.dataset.oldHtml) {
                            item.innerHTML = item.dataset.oldHtml;
                            delete item.dataset.oldHtml;
                        }
                    }

                    async function runCallback(action, payload = {}) {
                        const cb = window.MOL_CHAT_PANEL_MENU?.callbacks?.[action];

                        if (typeof cb === 'function') {
                            return await cb(payload);
                        }

                        if (typeof window.MOLChatPanelAction === 'function') {
                            return await window.MOLChatPanelAction(action, payload);
                        }

                        return null;
                    }

                    async function refreshConversationsAfterAction() {
                        if (typeof window.MOLChatRefreshList === 'function') {
                            await window.MOLChatRefreshList(qs('molChatSearch')?.value?.trim() || '');
                        }
                    }

                    async function actionMarkAllRead() {
                        const url = window.MOL_CHAT_PANEL_MENU?.urls?.markAllRead;

                        if (url) {
                            await fetchJson(url);
                        } else {
                            await runCallback('markAllRead');
                        }

                        document.querySelectorAll('.mol-unread').forEach(el => el.remove());
                        await refreshConversationsAfterAction();

                        notify('success', 'Messages mis à jour', 'Toutes les conversations ont été marquées comme lues.');
                    }

                    async function actionChatSettings() {
                        const handled = await runCallback('chatSettings');

                        if (handled !== null && handled !== undefined) return;

                        notify('info', 'Paramètres du chat', 'Branche ici ta page ou ta fenêtre de paramètres.');
                    }

                    async function actionNotifications() {
                        const nextValue = !getNotificationsEnabled();
                        const url = window.MOL_CHAT_PANEL_MENU?.urls?.notifications;

                        if (url) {
                            await fetchJson(url, { enabled: nextValue });
                        } else {
                            await runCallback('notifications', { enabled: nextValue });
                        }

                        saveBool(STORAGE_KEYS.notifications, nextValue);
                        refreshMenuContent();

                        notify(
                            'success',
                            nextValue ? 'Notifications activées' : 'Notifications désactivées',
                            nextValue ? 'Vous recevrez les notifications du chat.' : 'Vous ne recevrez plus les notifications du chat.'
                        );
                    }

                    async function actionSounds() {
                        const nextValue = !getSoundsEnabled();
                        const url = window.MOL_CHAT_PANEL_MENU?.urls?.sounds;

                        if (url) {
                            await fetchJson(url, { enabled: nextValue });
                        } else {
                            await runCallback('sounds', { enabled: nextValue });
                        }

                        saveBool(STORAGE_KEYS.sounds, nextValue);
                        window.MOL_CHAT_SOUND_ENABLED = nextValue;
                        refreshMenuContent();

                        notify(
                            'success',
                            nextValue ? 'Sons activés' : 'Sons désactivés',
                            nextValue ? 'Les sons des messages sont activés.' : 'Les sons des messages sont désactivés.'
                        );
                    }

                    async function actionBlockSettings() {
                        const url = window.MOL_CHAT_PANEL_MENU?.urls?.blockSettings;

                        if (url) {
                            window.location.href = url;
                            return;
                        }

                        const handled = await runCallback('blockSettings');

                        if (handled !== null && handled !== undefined) return;

                        notify('info', 'Réglages de blocage', 'Branche ici ta page de blocage ou ta modale.');
                    }

                    async function actionCreateGroup() {
                        const url = window.MOL_CHAT_PANEL_MENU?.urls?.createGroup;

                        if (url) {
                            window.location.href = url;
                            return;
                        }

                        const handled = await runCallback('createGroup');

                        if (handled !== null && handled !== undefined) return;

                        notify('info', 'Groupes', 'Branche ici ta création de groupe.');
                    }

                    const ACTIONS = {
                        markAllRead: actionMarkAllRead,
                        chatSettings: actionChatSettings,
                        notifications: actionNotifications,
                        sounds: actionSounds,
                        blockSettings: actionBlockSettings,
                        createGroup: actionCreateGroup
                    };

                    async function runAction(action) {
                        if (!action || MODULE.busyAction) return;

                        const fn = ACTIONS[action];
                        if (typeof fn !== 'function') return;

                        try {
                            setActionLoading(action, true);
                            closeMenu();
                            await fn();
                        } catch (e) {
                            console.error('[MOL CHAT PANEL MENU]', e);
                            notify('error', 'Action impossible', e?.message || 'Une erreur est survenue.');
                        } finally {
                            setActionLoading(action, false);
                            refreshMenuContent();
                        }
                    }

                    function bindEvents() {
                        if (MODULE.ready) return;
                        MODULE.ready = true;

                        document.addEventListener('click', (e) => {
                            const button = e.target.closest('#molChatPanelOptionsBtn');

                            if (button) {
                                e.preventDefault();
                                e.stopPropagation();
                                toggleMenu();
                                return;
                            }

                            const item = e.target.closest('#molChatPanelMenu [data-mol-panel-action]');

                            if (item) {
                                e.preventDefault();
                                e.stopPropagation();

                                const action = item.dataset.molPanelAction;
                                runAction(action);
                                return;
                            }

                            if (!e.target.closest('#molChatPanelMenu')) {
                                closeMenu();
                            }
                        }, true);

                        document.addEventListener('keydown', (e) => {
                            if (e.key === 'Escape') closeMenu();
                        });

                        window.addEventListener('resize', closeMenu);
                        window.addEventListener('scroll', closeMenu, true);
                    }

                    function bootPanelSubmenu() {
                        createButtonIfNeeded();
                        createMenuIfNeeded();
                        bindEvents();
                    }

                    document.addEventListener('DOMContentLoaded', bootPanelSubmenu);
                    document.addEventListener('turbo:load', bootPanelSubmenu);

                    if (document.readyState !== 'loading') {
                        bootPanelSubmenu();
                    }

                    window.MOLChatPanelMenu = {
                        open: placeMenu,
                        close: closeMenu,
                        toggle: toggleMenu,
                        refresh: refreshMenuContent,
                        runAction
                    };
                })();
