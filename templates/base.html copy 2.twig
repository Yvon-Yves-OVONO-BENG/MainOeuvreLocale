                                </div>
                            </div>

                            <div style="display:flex;flex-direction:column;flex:1 1 auto;min-height:0;overflow:hidden;">
                                <div id="molChatThreadMsgs" class="p-3" style="overflow:auto;background:rgba(2,6,23,.02);flex:1 1 auto;min-height:0;">
                                    <div class="text-center small text-secondary my-2">Chargement...</div>
                                </div>

                                <div id="molChatThreadReplyBox" class="mol-reply-box"></div>

                                <div class="mol-bottombar" style="flex:0 0 auto;">
                                    <div class="mol-bottombar__row">
                                        <div class="mol-bottombar__left">
                                            <button class="mol-circle-btn" type="button" id="molChatThreadCameraBtn" title="{% trans %}Prendre une photo{% endtrans %}">
