        <script>
            (() => {
                if (window.__MOL_CHAT_SUITE_BOOTED__) return;
                window.__MOL_CHAT_SUITE_BOOTED__ = true;

                const CHAT = {
                    replyState: {},
                    voiceRecorders: {},
                    activeContext: null,
                    reactionPicker: null,
                    reactionReady: false,
                    reactionPickerBound: false,
                    reactionTarget: null,
                    emojiLoading: null,
                    cameraStream: null,
                    cameraConversationId: null,
                    chatMercure: new Map(),
                    currentMobileConversationId: null,
                    mobileThreadReady: false,
                    typingTimers: new Map(),
                    typingState: new Map(),
                };

                const CALL = {
                    current: null,
                    peer: null,
                    localStream: null,
                    remoteStream: null,
                    mercureIncoming: null,
                    mercureCall: null,
                    isMuted: false,
                    isCameraEnabled: true,
                    isSpeakerOn: false,
                    currentFacingMode: 'user',
                    timerInterval: null,
                    startedAt: null,
                };

                function qs(id) {
                    return document.getElementById(id);
                }

                function debounce(fn, wait = 250) {
                    let t;
                    return (...args) => {
                        clearTimeout(t);
                        t = setTimeout(() => fn(...args), wait);
                    };
                }

                function escapeHtml(s) {
                    return String(s ?? '')
                        .replaceAll('&', '&amp;')
                        .replaceAll('<', '&lt;')
                        .replaceAll('>', '&gt;')
                        .replaceAll('"', '&quot;')
                        .replaceAll("'", '&#039;');
                }

                function notify(type, title, text = '') {
                    if (window.Swal) {
                        Swal.fire({
                            icon: type || 'info',
                            title: title || '',
                            text: text || '',
                            confirmButtonColor: '#2563eb',
                            background: '#ffffff',
                            backdrop: 'rgba(2,6,23,.45)',
                            borderRadius: 18
                        });
                        return;
                    }
                    alert([title, text].filter(Boolean).join('\n'));
                }

                async function askText(title, label = '') {
                    if (window.Swal) {
                        const result = await Swal.fire({
                            title,
                            input: 'text',
                            inputLabel: label,
                            showCancelButton: true,
                            confirmButtonText: 'OK',
                            cancelButtonText: 'Annuler',
                            confirmButtonColor: '#2563eb'
                        });
                        return result.isConfirmed ? (result.value || '') : null;
                    }

                    const value = window.prompt(title);
                    return value === null ? null : value;
                }

                async function askConfirm(title, text = '') {
                    if (window.Swal) {
                        const result = await Swal.fire({
                            icon: 'question',
                            title,
                            text,
                            showCancelButton: true,
                            confirmButtonText: 'Continuer',
                            cancelButtonText: 'Annuler',
                            confirmButtonColor: '#2563eb'
                        });
                        return !!result.isConfirmed;
                    }
                    return window.confirm([title, text].filter(Boolean).join('\n'));
                }

                function isMobileChat() {
                    return window.matchMedia && window.matchMedia('(max-width: 991.98px)').matches;
                }

                function formatClock(str) {
                    if (!str) return '';
                    const m = String(str).match(/(\d{2}):(\d{2})/);
                    return m ? `${m[1]}:${m[2]}` : String(str);
                }

                function formatDateTime(str) {
                    if (!str) return '';
                    const d = new Date(String(str).replace(' ', 'T'));
                    if (Number.isNaN(d.getTime())) return String(str);

                    const now = new Date();
                    const sameDay =
                        d.getDate() === now.getDate() &&
                        d.getMonth() === now.getMonth() &&
                        d.getFullYear() === now.getFullYear();

                    const time = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

                    if (sameDay) return time;

                    const y = new Date(now);
                    y.setDate(now.getDate() - 1);
                    const isYesterday =
                        d.getDate() === y.getDate() &&
                        d.getMonth() === y.getMonth() &&
                        d.getFullYear() === y.getFullYear();

                    if (isYesterday) return `Hier ${time}`;

                    return `${d.toLocaleDateString([], { day: 'numeric', month: 'short' })} ${time}`;
                }

                function bytesToSize(bytes) {
                    const n = Number(bytes || 0);
                    if (!n) return '';
                    const units = ['o', 'Ko', 'Mo', 'Go'];
                    let i = 0;
                    let value = n;
                    while (value >= 1024 && i < units.length - 1) {
                        value /= 1024;
                        i++;
                    }
                    return `${value.toFixed(value >= 10 || i === 0 ? 0 : 1)} ${units[i]}`;
                }

                function fileIcon(name = '') {
                    const ext = String(name).split('.').pop()?.toLowerCase() || '';
                    if (['jpg', 'jpeg', 'png', 'gif', 'webp', 'svg', 'bmp'].includes(ext)) return 'bi-image';
                    if (['pdf'].includes(ext)) return 'bi-file-earmark-pdf';
                    if (['doc', 'docx'].includes(ext)) return 'bi-file-earmark-word';
                    if (['xls', 'xlsx', 'csv'].includes(ext)) return 'bi-file-earmark-excel';
                    if (['zip', 'rar', '7z', 'tar', 'gz'].includes(ext)) return 'bi-file-earmark-zip';
                    if (['mp3', 'wav', 'ogg', 'm4a', 'aac'].includes(ext)) return 'bi-file-earmark-music';
                    if (['mp4', 'avi', 'mov', 'webm', 'mkv'].includes(ext)) return 'bi-file-earmark-play';
                    return 'bi-file-earmark';
                }

                function requireChatConfig() {
                    return !!(window.MOL_CHAT && window.MOL_CHAT.urls);
                }

                function molUrl(template, id) {
                    const t = String(template || '');
                    const s = String(id);

                    if (!t) throw new Error('URL template missing');
                    if (t.includes('__ID__')) return t.replace('__ID__', s);
                    if (t.includes('__CONV__')) return t.replace('__CONV__', s);
                    if (t.includes('__CALL__')) return t.replace('__CALL__', s);
                    if (t.includes('/0/')) return t.replace('/0/', `/${s}/`);
                    if (t.endsWith('/0')) return t.slice(0, -2) + '/' + s;
                    return t;
                }

                function absUrl(path) {
                    const p = String(path || '');
                    if (!p) return '';
                    if (/^https?:\/\//i.test(p)) return p;
                    const base = window.location.origin + (window.MOL_CHAT?.baseUrl || '');
                    return new URL(p.startsWith('/') ? p : '/' + p, base).toString();
                }

                function getPresenceMeta(input = 'offline') {
                    let presence = 'offline';

                    if (typeof input === 'string') {
                        presence = input;
                    } else if (input && typeof input === 'object') {
                        presence = input.presence || (input.online === true ? 'online' : 'offline');
                    }

                    presence = String(presence || 'offline').trim().toLowerCase();

                    if (presence === 'online') {
                        return {
                            online: true,
                            presence: 'online',
                            dotClass: 'mol-presence-online',
                            pillClass: 'online',
                            avatarStatusClass: 'is-online',
                            label: '{% trans %}Connecté(e){% endtrans %}',
                        };
                    }

                    if (presence === 'recently_offline') {
                        return {
                            online: false,
                            presence: 'recently_offline',
                            dotClass: 'mol-presence-recently-offline',
                            pillClass: 'offline',
                            avatarStatusClass: 'is-recently-offline',
                            label: '{% trans %}Vient de se déconnecter{% endtrans %}',
                        };
                    }

                    return {
                        online: false,
                        presence: 'offline',
                        dotClass: 'mol-presence-offline',
                        pillClass: 'offline',
                        avatarStatusClass: 'is-offline',
                        label: '{% trans %}Déconnecté(e){% endtrans %}',
                    };
                }

                function autoResize(el) {
                    if (!el) return;
                    el.style.height = 'auto';
                    el.style.height = Math.min(el.scrollHeight, 110) + 'px';
                }

                async function ensureEmojiLib() {
                    if (window.EmojiButton) return;
                    if (CHAT.emojiLoading) return CHAT.emojiLoading;

                    CHAT.emojiLoading = new Promise((resolve, reject) => {
                        const s = document.createElement('script');
                        s.src = 'https://cdn.jsdelivr.net/npm/@joeattardi/emoji-button@4.6.4/dist/index.min.js';
                        s.async = true;
                        s.onload = resolve;
                        s.onerror = reject;
                        document.head.appendChild(s);
                    });

                    return CHAT.emojiLoading;
                }

                async function ensureReactionPicker() {
                    await ensureEmojiLib();

                    if (CHAT.reactionReady && CHAT.reactionPicker) {
                        return;
                    }

                    const Ctor =
                        typeof window.EmojiButton === 'function'
                            ? window.EmojiButton
                            : window.EmojiButton?.EmojiButton;

                    if (!Ctor) {
                        throw new Error('EmojiButton indisponible');
                    }

                    CHAT.reactionPicker = new Ctor({
                        position: 'top-start',
                        autoHide: true,
                        theme: 'light',
                        rootElement: document.body,
                        zIndex: 2147483647
                    });

                    CHAT.reactionPicker.on('emoji', async (selection) => {
                        const emoji = typeof selection === 'string'
                            ? selection
                            : selection?.emoji;

                        const target = CHAT.reactionTarget;

                        if (!emoji || !target?.messageId || !target?.conversationId) {
                            return;
                        }

                        try {
                            await sendReaction(
                                target.messageId,
                                emoji,
                                target.conversationId
                            );
                        } catch (e) {
                            console.error('reaction error', e);
                            notify('error', 'Réaction impossible', 'Impossible d’ajouter cette réaction.');
                        } finally {
                            CHAT.reactionTarget = null;
                        }
                    });

                    CHAT.reactionReady = true;
                }

                function ensureContextMenu() {
                    let menu = qs('molMsgContextMenu');
                    if (menu) return menu;

                    document.body.insertAdjacentHTML('beforeend', `
                        <div id="molMsgContextMenu" class="mol-msg-menu">
                            <button type="button" data-action="reply"><i class="bi bi-reply"></i><span>{% trans %}Répondre{% endtrans %}</span></button>
                            <button type="button" data-action="copy"><i class="bi bi-copy"></i><span>{% trans %}Copier{% endtrans %}</span></button>
                            <button type="button" data-action="delete"><i class="bi bi-trash"></i><span>{% trans %}Supprimer{% endtrans %}</span></button>
                        </div>
                    `);

                    menu = qs('molMsgContextMenu');

                    menu.addEventListener('click', async (e) => {
                        const btn = e.target.closest('[data-action]');
                        if (!btn || !CHAT.activeContext) return;

                        const { action } = btn.dataset;
                        const ctx = CHAT.activeContext;
                        hideContextMenu();

                        if (action === 'reply') {
                            prepareReply(ctx.conversationId, ctx.message);
                            return;
                        }

                        if (action === 'copy') {
                            const text = ctx.message?.content || '';
                            if (!text) return;
                            try {
                                await navigator.clipboard.writeText(text);
                            } catch (_) {}
                            return;
                        }

                        if (action === 'delete' && ctx.message?.mine) {
                            await deleteMessage(ctx.message.id, ctx.conversationId);
                        }
                    });

                    document.addEventListener('click', hideContextMenu);
                    document.addEventListener('scroll', hideContextMenu, true);
                    window.addEventListener('resize', hideContextMenu);

                    return menu;
                }

                function showContextMenu(x, y, conversationId, message) {
                    const menu = ensureContextMenu();
                    CHAT.activeContext = { conversationId, message };

                    const deleteBtn = menu.querySelector('[data-action="delete"]');
                    if (deleteBtn) deleteBtn.style.display = message?.mine ? '' : 'none';

                    menu.style.left = `${x}px`;
                    menu.style.top = `${y}px`;
                    menu.classList.add('is-open');
                }

                function renderReplyPreview(conversationId) {
                    const reply = CHAT.replyState[conversationId] || null;

                    const desktopBox = qs(`molReplyBox-${conversationId}`);
                    const desktopAuthor = qs(`molReplyAuthor-${conversationId}`);
                    const desktopText = qs(`molReplyText-${conversationId}`);

                    const isMobile = Number(CHAT.currentMobileConversationId || 0) === Number(conversationId);
                    const mobileBox = qs('molChatReplyBox');
                    const mobileAuthor = qs('molChatReplyAuthor');
                    const mobileText = qs('molChatReplyText');

                    const apply = (box, authorEl, textEl) => {
                        if (!box || !authorEl || !textEl) return;

                        if (!reply) {
                            box.hidden = true;
                            box.classList.remove('is-active');
                            authorEl.textContent = '';
                            textEl.textContent = '';
                            return;
                        }

                        box.hidden = false;
                        box.classList.add('is-active');
                        authorEl.textContent = reply.authorName || 'Réponse';
                        textEl.textContent = reply.content || '';
                    };

                    apply(desktopBox, desktopAuthor, desktopText);

                    if (isMobile) {
                        apply(mobileBox, mobileAuthor, mobileText);
                    }
                }

                function hideContextMenu() {
                    const menu = qs('molMsgContextMenu');
                    if (menu) menu.classList.remove('is-open');
                    CHAT.activeContext = null;
                }

                function getMessagePreviewForReply(message) {
                    const type = String(message?.type || 'text');
                    const rawContent = String(message?.content || '').trim();

                    if (rawContent) {
                        return rawContent;
                    }

                    if (type === 'voice' || type === 'audio') {
                        return 'Message vocal';
                    }

                    if (type === 'image') {
                        return 'Photo';
                    }

                    if (type === 'video') {
                        return 'Vidéo';
                    }

                    if (type === 'file') {
                        return message?.meta?.filename ||
                            message?.meta?.originalName ||
                            message?.attachmentName ||
                            'Fichier';
                    }

                    if (type === 'call') {
                        return 'Appel';
                    }

                    return 'Message';
                }

                function prepareReply(conversationId, message) {
                    CHAT.replyState[conversationId] = {
                        id: Number(message.id || 0),
                        authorName: message.authorName || (message.mine ? 'Vous' : 'Contact'),
                        content: getMessagePreviewForReply(message),
                        type: message.type || 'text'
                    };

                    renderReplyBox(conversationId);

                    const input = qs(`molToastInput-${conversationId}`);

                    if (input) {
                        input.focus();
                    }

                    if (Number(CHAT.currentMobileConversationId || 0) === Number(conversationId)) {
                        qs('molChatThreadInput')?.focus();
                    }
                }

                function clearReply(conversationId) {
                    delete CHAT.replyState[conversationId];
                    renderReplyBox(conversationId);
                }

                function renderReplyBox(conversationId) {
                    const state = CHAT.replyState[conversationId] || null;

                    const render = (box) => {
                        if (!box) return;

                        if (!state) {
                            box.classList.remove('is-active');
                            box.innerHTML = '';
                            return;
                        }

                        box.classList.add('is-active');
                        box.innerHTML = `
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="mol-reply-box__title">${escapeHtml(state.authorName || 'Réponse')}</div>
                                <div class="mol-reply-box__text">${escapeHtml(state.content || 'Message sélectionné')}</div>
                            </div>

                            <button type="button" class="mol-reply-close" onclick="MOLClearReply(${Number(conversationId)})">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        `;
                    };

                    render(qs(`molReplyBox-${conversationId}`));

                    if (Number(CHAT.currentMobileConversationId || 0) === Number(conversationId)) {
                        render(qs('molChatThreadReplyBox'));
                    }
                }

                async function loadConversations(q = '') {
                    if (!requireChatConfig()) throw new Error('MOL_CHAT config missing');

                    const url = new URL(window.MOL_CHAT.urls.conversations, window.location.origin + (window.MOL_CHAT.baseUrl || ''));
                    if (q) url.searchParams.set('q', q);
                    url.searchParams.set('_ts', Date.now());

                    const res = await fetch(url.toString(), {
                        method: 'GET',
                        credentials: 'same-origin',
                        cache: 'no-store',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Cache-Control': 'no-cache'
                        }
                    });

                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return await res.json();
                }

                function renderConversations(items) {
                    const list = qs('molChatList');
                    if (!list) return;

                    if (!items || !items.length) {
                        list.innerHTML = `<li class="text-secondary small py-3">{% trans %}Aucune conversation trouvée.{% endtrans %}</li>`;
                        return;
                    }

                    list.innerHTML = items.map(c => {
                        const presence = getPresenceMeta(c.presence || 'offline');
                        const avatarUrl = safeAvatarUrl(c.avatarUrl || c.avatar || '');
                        const timeLabel = formatDateTime(c.lastMessageAt);
                        const unreadCount = Number(c.unreadCount ?? 0);
                        const unread = unreadCount > 0 ? `<span class="mol-unread">${unreadCount}</span>` : '';

                        return `
                            <li class="mol-chat-item"
                                data-id="${Number(c.id || 0)}"
                                data-user-id="${Number(c.userId || 0)}"
                                data-name="${escapeHtml(c.name || 'Conversation')}"
                                data-avatar="${escapeHtml(avatarUrl)}"
                                data-online="${presence.online ? '1' : '0'}"
                                data-presence="${presence.presence}">
                                <div class="position-relative" style="width:46px;height:46px;flex:0 0 46px;">
                                    <img src="${avatarUrl}" alt="${escapeHtml(c.name || 'Conversation')}">
                                    <span class="mol-presence-dot ${presence.dotClass}"></span>
                                </div>

                                <div class="overflow-hidden flex-grow-1">
                                    <div class="fw-bold text-truncate" style="font-size:.93rem;">${escapeHtml(c.name || 'Conversation')}</div>
                                    <div class="small text-secondary text-truncate">${escapeHtml(c.lastMessage || '{% trans %}Aucun message{% endtrans %}')}</div>
                                    <div class="mt-1">
                                        <span class="mol-presence-pill ${presence.pillClass}">
                                            <span class="mol-presence-pill__dot"></span>
                                            ${presence.label}
                                        </span>
                                    </div>
                                </div>

                                <div class="d-flex flex-column align-items-end gap-1 ms-auto">
                                    <div class="small text-secondary text-nowrap">${escapeHtml(timeLabel)}</div>
                                    ${unread}
                                </div>
                            </li>
                        `;
                    }).join('');
                }

                async function refreshRenderedPresence() {
                    const items = [...document.querySelectorAll('.mol-chat-item[data-user-id]')];
                    if (!items.length) return;

                    const template = "{{ path('presence_user_status', {id: 0}) }}";

                    for (const item of items) {
                        const userId = Number(item.dataset.userId || 0);
                        if (!userId) continue;

                        try {
                            const url = molUrl(template, userId) + '?_ts=' + Date.now();
                            const res = await fetch(url, {
                                credentials: 'same-origin',
                                cache: 'no-store',
                                headers: {
                                    'X-Requested-With': 'XMLHttpRequest',
                                    'Cache-Control': 'no-cache'
                                }
                            });

                            if (!res.ok) continue;
                            const data = await res.json();
                            if (!data?.ok) continue;

                            const meta = getPresenceMeta(data.presence || 'offline');

                            item.dataset.online = meta.online ? '1' : '0';
                            item.dataset.presence = meta.presence;

                            const dot = item.querySelector('.mol-presence-dot');
                            if (dot) dot.className = `mol-presence-dot ${meta.dotClass}`;

                            const pill = item.querySelector('.mol-presence-pill');
                            if (pill) {
                                pill.className = `mol-presence-pill ${meta.pillClass}`;
                                pill.innerHTML = `<span class="mol-presence-pill__dot"></span>${meta.label}`;
                            }

                            const toast = qs(`molToast-${item.dataset.id}`);
                            if (toast) {
                                const toastDot = toast.querySelector('.mol-avatar-status-dot');
                                if (toastDot) toastDot.className = `mol-avatar-status-dot ${meta.avatarStatusClass}`;
                            }
                        } catch (_) {}
                    }
                }

                async function refreshList(q = '') {
                    try {
                        const data = await loadConversations(q);
                        const items = data.items || data.conversations || [];
                        renderConversations(items);
                        await refreshRenderedPresence();
                    } catch (e) {
                        const list = qs('molChatList');
                        if (list) {
                            list.innerHTML = `<li class="text-danger small py-3">{% trans %}Erreur de chargement.{% endtrans %}</li>`;
                        }
                        console.error('Chat load error', e);
                    }
                }

                async function openPanel() {
                    const panel = qs('molChatPanel');
                    if (!panel) return;

                    panel.classList.add('is-open');
                    panel.setAttribute('aria-hidden', 'false');
                    document.body.classList.add('mol-chat-open');
                    await refreshList(qs('molChatSearch')?.value?.trim() || '');
                }

                function closePanel() {
                    const panel = qs('molChatPanel');
                    if (!panel) return;

                    panel.classList.remove('is-open');
                    panel.setAttribute('aria-hidden', 'true');
                    document.body.classList.remove('mol-chat-open');
                    closeConversationMobile();
                }

                async function fetchMessages(conversationId) {
                    if (!requireChatConfig()) throw new Error('MOL_CHAT config missing');

                    let url = molUrl(window.MOL_CHAT.urls.messages, conversationId);
                    url += (url.includes('?') ? '&' : '?') + `_ts=${Date.now()}`;

                    const res = await fetch(url, {
                        credentials: 'same-origin',
                        cache: 'no-store',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Cache-Control': 'no-cache'
                        }
                    });

                    const raw = await res.text();
                    if (!res.ok) {
                        console.error('Messages HTTP error', res.status, raw);
                        throw new Error('HTTP ' + res.status);
                    }

                    return raw ? JSON.parse(raw) : {};
                }

                function renderReplyQuote(replyTo) {
                    if (!replyTo || !replyTo.id) {
                        return '';
                    }

                    return `
                        <div class="mol-msg-reply-quote" data-scroll-message="${Number(replyTo.id)}">
                            <div class="mol-msg-reply-quote__author">
                                ${escapeHtml(replyTo.authorName || 'Message')}
                            </div>
                            <div class="mol-msg-reply-quote__text">
                                ${escapeHtml(replyTo.content || '')}
                            </div>
                        </div>
                    `;
                }

                function renderMessageActions(m) {
                    const id = Number(m.id || 0);

                    if (!id) {
                        return '';
                    }

                    return `
                        <span class="mol-msg-actions-pro">
                            <button type="button"
                                    title="Répondre"
                                    aria-label="Répondre"
                                    data-chat-reply="${id}">
                                <i class="bi bi-reply-fill"></i>
                            </button>

                            <button type="button"
                                    title="Emoji"
                                    aria-label="Emoji"
                                    data-chat-react="${id}">
                                <i class="bi bi-emoji-smile"></i>
                            </button>
                        </span>
                    `;
                }

                function renderReplyBanner(message) {
                    if (!message.replyTo) return '';

                    const name = escapeHtml(message.replyTo.authorName || '{% trans %}Contact{% endtrans %}');
                    const text = message.mine
                        ? `{% trans %}Vous avez répondu à{% endtrans %} ${name}`
                        : `${name} {% trans %}vous a répondu{% endtrans %}`;

                    return `
                        <div class="mol-reply-banner">
                            <i class="bi bi-reply-fill"></i>
                            <span>${text}</span>
                        </div>
                    `;
                }

                function renderAttachment(m) {
                    const meta = m.meta || {};
                    const filename = meta.filename || meta.originalName || m.attachmentName || m.content || '';
                    const attachmentUrl = m.attachmentUrl ? absUrl(m.attachmentUrl) : '';
                    const mimeType = String(meta.mimeType || '').toLowerCase();
                    const icon = fileIcon(filename);
                    const size = bytesToSize(meta.size || meta.filesize);

                    if (!attachmentUrl) return '';

                    const isImage = mimeType.startsWith('image/') || /\.(jpg|jpeg|png|gif|webp|svg|bmp)$/i.test(filename);
                    const isVideo = mimeType.startsWith('video/') || /\.(mp4|webm|mov|avi|mkv)$/i.test(filename);
                    const isAudio = m.type === 'voice' || mimeType.startsWith('audio/') || /\.(mp3|wav|ogg|m4a|aac|webm)$/i.test(filename);

                    if (isImage) {
                        return `
                            <div class="mol-inline-media">
                                <a href="${attachmentUrl}" target="_blank" rel="noopener noreferrer">
                                    <img src="${attachmentUrl}" alt="${escapeHtml(filename || 'Image')}" class="mol-chat-image" loading="lazy">
                                </a>
                                <div class="mol-inline-filebar">
                                    <div class="mol-inline-filebar__main">
                                        <div class="mol-inline-filebar__name">${escapeHtml(filename || '{% trans %}Image{% endtrans %}')}</div>
                                    </div>
                                    <a class="mol-inline-filebar__download" href="${attachmentUrl}" download="${escapeHtml(filename || 'image')}">
                                        <i class="bi bi-download"></i>
                                    </a>
                                </div>
                            </div>
                        `;
                    }

                    if (isVideo) {
                        return `
                            <div class="mol-inline-media">
                                <video controls preload="metadata" class="mol-chat-video">
                                    <source src="${attachmentUrl}" type="${escapeHtml(mimeType || 'video/mp4')}">
                                </video>
                                <div class="mol-inline-filebar">
                                    <div class="mol-inline-filebar__main">
                                        <div class="mol-inline-filebar__name">${escapeHtml(filename || '{% trans %}Vidéo{% endtrans %}')}</div>
                                        ${size ? `<div class="mol-inline-filebar__meta">${escapeHtml(size)}</div>` : ''}
                                    </div>
                                    <a class="mol-inline-filebar__download" href="${attachmentUrl}" download="${escapeHtml(filename || 'video')}">
                                        <i class="bi bi-download"></i>
                                    </a>
                                </div>
                            </div>
                        `;
                    }

                    if (isAudio) {
                        return `
                            <div class="mol-inline-audio">
                                <audio controls preload="metadata" class="mol-chat-audio">
                                    <source src="${attachmentUrl}" type="${escapeHtml(mimeType || 'audio/webm')}">
                                </audio>
                                <div class="mol-inline-filebar">
                                    <div class="mol-inline-filebar__main">
                                        <div class="mol-inline-filebar__name">${escapeHtml(filename || '{% trans %}Audio{% endtrans %}')}</div>
                                    </div>
                                    <a class="mol-inline-filebar__download" href="${attachmentUrl}" download="${escapeHtml(filename || 'audio')}">
                                        <i class="bi bi-download"></i>
                                    </a>
                                </div>
                            </div>
                        `;
                    }

                    return `
                        <div class="mol-inline-file">
                            <div class="mol-inline-file__icon">
                                <i class="bi ${icon}"></i>
                            </div>
                            <div class="mol-inline-file__main">
                                <div class="mol-inline-file__name">${escapeHtml(filename || '{% trans %}Fichier{% endtrans %}')}</div>
                                <div class="mol-inline-file__meta">${escapeHtml(size || '{% trans %}Fichier{% endtrans %}')}</div>
                            </div>
                            <a class="mol-inline-file__download" href="${attachmentUrl}" download="${escapeHtml(filename || 'file')}">
                                <i class="bi bi-download"></i>
                            </a>
                        </div>
                    `;
                }

                function renderReactions(reactions) {
                    if (!reactions || !reactions.length) return '';
                    return `
                        <div class="mol-msg-reactions">
                            ${reactions.map(r => `
                                <span class="mol-msg-reaction-chip">
                                    <span>${escapeHtml(r.emoji)}</span>
                                    <span>${Number(r.total ?? r.count ?? 1)}</span>
                                </span>
                            `).join('')}
                        </div>
                    `;
                }

                function safeMessageAvatar(url) {
                    const fallback = "{{ asset('uploads/profiles/avatar.png') }}";
                    let value = String(url || '').trim();

                    if (
                        !value ||
                        value === 'null' ||
                        value === 'undefined' ||
                        value.endsWith('/null') ||
                        value.endsWith('/undefined') ||
                        value.endsWith('/uploads/profiles/')
                    ) {
                        value = fallback;
                    }

                    if (/^https?:\/\//i.test(value) || value.startsWith('data:image/')) {
                        return value;
                    }

                    return value.startsWith('/') ? value : '/' + value;
                }

                function getMessagePreviewForReply(message) {
                    const type = String(message.type || 'text');

                    if (type === 'voice' || type === 'audio') {
                        return 'Message vocal';
                    }

                    if (type === 'file') {
                        return message.meta?.filename ||
                            message.meta?.originalName ||
                            message.attachmentName ||
                            message.content ||
                            'Fichier';
                    }

                    if (type === 'image') {
                        return 'Image';
                    }

                    if (type === 'video') {
                        return 'Vidéo';
                    }

                    if (type === 'call') {
                        return message.content || 'Appel';
                    }

                    return message.content || 'Message';
                }
                

                function renderMessages(items, conversationId = 0) {
                    const visibleItems = (items || []).filter(m => !(
                        m.deleted === true ||
                        m.isDeleted === true ||
                        Number(m.deleted) === 1
                    ));

                    if (!visibleItems.length) {
                        return `<div class="text-center small text-secondary my-2">{% trans %}Aucun message{% endtrans %}</div>`;
                    }

                    return visibleItems.map(m => {
                        const mine = !!m.mine;
                        const content = escapeHtml(m.content || '');
                        const time = escapeHtml(m.createdAt || '');
                        const avatar = safeAvatarUrl(
                            m.avatarUrl || (mine ? window.MOL_CHAT_ME?.avatar : getConversationContactAvatar(conversationId))
                        );

                        const replyQuote = renderReplyQuote(m.replyTo);
                        const actions = renderMessageActions(m);
                        const attachment = renderAttachment(m);
                        const reactions = renderReactions(m.reactions || []);

                        if (m.type === 'system') {
                            return `
                                <div class="mol-system-line">
                                    <div class="mol-system-badge">
                                        <i class="bi bi-info-circle"></i>
                                        <span>${content}</span>
                                    </div>
                                </div>
                            `;
                        }

                        const statusIcon = !mine ? '' : (
                            m.readAt
                                ? '<i class="bi bi-check2-all text-success mol-check"></i>'
                                : m.deliveredAt
                                    ? '<i class="bi bi-check2-all text-secondary mol-check"></i>'
                                    : '<i class="bi bi-check2 text-secondary mol-check"></i>'
                        );

                        let bodyHtml = '';

                        if (m.type === 'text' || !m.type) {
                            bodyHtml = `<div class="mol-msg-body">${content}</div>`;
                        } else if (m.type === 'call') {
                            bodyHtml = `
                                <div class="mol-msg-body">
                                    <i class="bi bi-telephone-fill me-2"></i>
                                    ${content || '{% trans %}Appel{% endtrans %}'}
                                </div>
                            `;
                        } else if (
                            m.type === 'file' ||
                            m.type === 'voice' ||
                            m.type === 'audio' ||
                            m.type === 'image' ||
                            m.type === 'video'
                        ) {
                            bodyHtml = '';
                        } else {
                            bodyHtml = `<div class="mol-msg-body">${content}</div>`;
                        }

                        const authorName = escapeHtml(
                            m.authorName || (mine ? '{% trans %}Vous{% endtrans %}' : '{% trans %}Contact{% endtrans %}')
                        );

                        const safeContent = escapeHtml(getMessagePreviewForReply(m));
                        const type = escapeHtml(m.type || 'text');
                        const messageId = Number(m.id || 0);

                        return `
                            <div class="mol-msg-row d-flex align-items-end mb-2 ${mine ? 'justify-content-end' : 'justify-content-start'}"
                                data-message-id="${messageId}"
                                data-conversation-id="${Number(conversationId || 0)}"
                                data-mine="${mine ? '1' : '0'}"
                                data-content="${safeContent}"
                                data-author-name="${authorName}"
                                data-type="${type}">

                                <span class="mol-msg-swipe-hint reply">
                                    <i class="bi bi-reply"></i> {% trans %}Répondre{% endtrans %}
                                </span>

                                <span class="mol-msg-swipe-hint delete">
                                    <i class="bi bi-trash"></i> {% trans %}Supprimer{% endtrans %}
                                </span>

                                ${!mine ? `
                                    <img src="${escapeHtml(avatar)}"
                                        class="mol-msg-avatar"
                                        alt=""
                                        onerror="this.onerror=null;this.src='{{ asset('uploads/profiles/avatar.png') }}';">
                                ` : ''}

                                <div class="mol-msg-bubble-wrap ${mine ? 'mine' : 'other'}">
                                    <div style="position:relative;">
                                        <div class="mol-msg-card ${mine ? 'mine' : 'other'}">
                                            ${replyQuote}
                                            ${bodyHtml}
                                            ${attachment}
                                        </div>

                                        ${reactions}

                                        <div class="mol-msg-meta ${mine ? 'text-end' : 'text-start'}">
                                            ${time} ${statusIcon} ${actions}
                                        </div>
                                    </div>
                                </div>

                                ${mine ? `
                                    <img src="${escapeHtml(avatar)}"
                                        class="mol-msg-avatar"
                                        alt=""
                                        onerror="this.onerror=null;this.src='{{ asset('uploads/profiles/avatar.png') }}';">
                                ` : ''}
                            </div>
                        `;
                    }).join('');
                }

                function getMessagePayloadFromRow(row) {
                    const type = row.dataset.type || 'text';

                    let content = row.dataset.content || '';

                    if (!content) {
                        if (type === 'voice') {
                            content = 'Message vocal';
                        } else if (type === 'file') {
                            content = 'Fichier';
                        } else {
                            content = 'Message';
                        }
                    }

                    return {
                        id: Number(row.dataset.messageId || 0),
                        mine: row.dataset.mine === '1',
                        content,
                        authorName: row.dataset.authorName || '',
                        type
                    };
                }

                function bindMessageInteractions(box, conversationId) {
                    if (!box) return;

                    box.dataset.conversationId = String(conversationId || 0);

                    if (box.__molInteractionsBound) return;

                    box.__molInteractionsBound = true;

                    box.addEventListener('click', async (event) => {
                        const currentConversationId = Number(
                            box.dataset.conversationId ||
                            CHAT.currentMobileConversationId ||
                            conversationId ||
                            0
                        );

                        if (!currentConversationId) {
                            return;
                        }

                        const replyBtn = event.target.closest('[data-chat-reply]');

                        if (replyBtn) {
                            event.preventDefault();
                            event.stopPropagation();

                            const row = replyBtn.closest('.mol-msg-row');

                            if (!row) return;

                            prepareReply(currentConversationId, getMessagePayloadFromRow(row));
                            return;
                        }

                        const reactBtn = event.target.closest('[data-chat-react]');

                        if (reactBtn) {
                            event.preventDefault();
                            event.stopPropagation();

                            await openReactionPicker(
                                event,
                                Number(reactBtn.dataset.chatReact),
                                reactBtn
                            );
                        }
                    });
                }

                async function refreshBubble(conversationId) {
                    const box = qs(`molToastMsgs-${conversationId}`);
                    if (!box) return;

                    try {
                        box.innerHTML = `<div class="text-center small text-secondary my-2">{% trans %}Chargement...{% endtrans %}</div>`;
                        const data = await fetchMessages(conversationId);
                        box.innerHTML = renderMessages(data.items || [], conversationId);
                        bindMessageInteractions(box, conversationId);
                        box.scrollTop = box.scrollHeight;
                    } catch (e) {
                        console.error('refresh bubble error', e);
                        box.innerHTML = `<div class="text-center small text-danger my-2">{% trans %}Erreur chargement messages{% endtrans %}</div>`;
                    }
                }

                async function refreshMobileThread(conversationId) {
                    const box = qs('molChatThreadMsgs');

                    if (!box || Number(CHAT.currentMobileConversationId || 0) !== Number(conversationId)) {
                        return;
                    }

                    try {
                        box.innerHTML = `<div class="text-center small text-secondary my-2">{% trans %}Chargement...{% endtrans %}</div>`;

                        const data = await fetchMessages(conversationId);

                        box.innerHTML = renderMessages(data.items || [], conversationId);
                        box.scrollTop = box.scrollHeight;

                        bindMessageInteractions(box, conversationId);
                    } catch (e) {
                        console.error('refresh mobile thread error', e);

                        box.innerHTML = `<div class="text-center small text-danger my-2">{% trans %}Erreur chargement messages{% endtrans %}</div>`;
                    }
                }

                async function refreshConversationEverywhere(conversationId) {
                    await Promise.all([
                        refreshBubble(conversationId),
                        refreshMobileThread(conversationId)
                    ]);
                }

                async function deleteMessage(messageId, conversationId) {
                    if (!messageId) return;

                    const template = window.MOL_CHAT?.urls?.messageDelete || "{{ path('chat_message_delete', {id: 0}) }}";

                    try {
                        const url = molUrl(template, messageId);
                        const res = await fetch(url, {
                            method: 'DELETE',
                            credentials: 'same-origin',
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });

                        if (!res.ok) throw new Error('HTTP ' + res.status);

                        await refreshConversationEverywhere(conversationId);
                        await refreshList(qs('molChatSearch')?.value?.trim() || '');
                    } catch (e) {
                        console.error('delete message error', e);
                        notify('error', "{% trans %}Suppression impossible{% endtrans %}", "{% trans %}Impossible de supprimer le message.{% endtrans %}");
                    }
                }

                async function sendReaction(messageId, emoji, conversationId) {
                    const tpl = window.MOL_CHAT?.urls?.react;
                    if (!tpl) return;

                    const res = await fetch(molUrl(tpl, messageId), {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({ emoji })
                    });

                    const data = await res.json().catch(() => ({}));
                    if (!res.ok || data.ok === false) throw new Error(data.error || ('HTTP ' + res.status));

                    await refreshConversationEverywhere(conversationId);
                    await refreshList(qs('molChatSearch')?.value?.trim() || '');
                }

                async function openReactionPicker(event, messageId, triggerElement = null) {
                    event.preventDefault();
                    event.stopPropagation();

                    await ensureReactionPicker();

                    const trigger =
                        triggerElement ||
                        event.target.closest('[data-chat-react]') ||
                        event.target;

                    const toast = trigger.closest('.toast');
                    const thread = trigger.closest('#molChatThread');
                    const row = trigger.closest('.mol-msg-row');

                    const conversationId = Number(
                        toast?.id?.replace('molToast-', '') ||
                        thread?.dataset?.conversationId ||
                        row?.dataset?.conversationId ||
                        CHAT.currentMobileConversationId ||
                        0
                    );

                    if (!conversationId || !messageId || !CHAT.reactionPicker) {
                        return;
                    }

                    CHAT.reactionTarget = {
                        messageId: Number(messageId),
                        conversationId: Number(conversationId)
                    };

                    CHAT.reactionPicker.togglePicker(trigger);
                }

                function getConversationIdFromPrivateElement(element) {
                    const row = element.closest('.mol-msg-row');
                    const toast = element.closest('#molChatToasts .toast');
                    const thread = element.closest('#molChatThread');

                    return Number(
                        toast?.id?.replace('molToast-', '') ||
                        thread?.dataset?.conversationId ||
                        row?.dataset?.conversationId ||
                        element.closest('[data-conversation-id]')?.dataset?.conversationId ||
                        CHAT.currentMobileConversationId ||
                        0
                    );
                }

                function inputFileForConversation(conversationId, kind) {
                    if (kind === 'camera') {
                        return qs(`molCamera-${conversationId}`) ||
                            (Number(CHAT.currentMobileConversationId || 0) === Number(conversationId) ? qs('molChatThreadCamera') : null);
                    }

                    return qs(`molFile-${conversationId}`) ||
                        (Number(CHAT.currentMobileConversationId || 0) === Number(conversationId) ? qs('molChatThreadFile') : null);
                }

                function bindPrivateChatLikeGroup() {
                    if (document.__molPrivateChatLikeGroupBound) return;
                    document.__molPrivateChatLikeGroupBound = true;

                    document.addEventListener('click', async (event) => {
                        const inPrivateChat =
                            event.target.closest('#molChatToasts') ||
                            event.target.closest('#molChatThread');

                        if (!inPrivateChat) {
                            return;
                        }

                        const cameraBtn =
                            event.target.closest('[data-private-camera]') ||
                            event.target.closest('[onclick*="MOLHandleCameraClick"]') ||
                            event.target.closest('#molChatThreadCameraBtn');

                        if (cameraBtn) {
                            event.preventDefault();
                            event.stopPropagation();
                            event.stopImmediatePropagation();

                            const conversationId = getConversationIdFromPrivateElement(cameraBtn);
                            if (!conversationId) return;

                            if (isProbablyMobileDevice()) {
                                const input = inputFileForConversation(conversationId, 'camera');

                                if (input) {
                                    input.setAttribute('accept', 'image/*');
                                    input.setAttribute('capture', 'environment');
                                    input.click();
                                }

                                return;
                            }

                            await handleCameraClick(conversationId);
                            return;
                        }

                        const fileBtn =
                            event.target.closest('[data-private-file]') ||
                            event.target.closest('[onclick*="molFile-"]') ||
                            event.target.closest('#molChatThreadAttachBtn');

                        if (fileBtn) {
                            event.preventDefault();
                            event.stopPropagation();
                            event.stopImmediatePropagation();

                            const conversationId = getConversationIdFromPrivateElement(fileBtn);
                            if (!conversationId) return;

                            const input = inputFileForConversation(conversationId, 'file');

                            if (input) {
                                input.click();
                            }

                            return;
                        }

                        const voiceBtn =
                            event.target.closest('[data-private-voice]') ||
                            event.target.closest('[onclick*="MOLChatToastToggleVoice"]') ||
                            event.target.closest('#molChatThreadMicBtn');

                        if (voiceBtn) {
                            event.preventDefault();
                            event.stopPropagation();
                            event.stopImmediatePropagation();

                            const conversationId = getConversationIdFromPrivateElement(voiceBtn);
                            if (!conversationId) return;

                            await toggleVoice(conversationId);
                            return;
                        }

                        const replyBtn = event.target.closest('[data-chat-reply]');

                        if (replyBtn) {
                            const row = replyBtn.closest('.mol-msg-row');
                            const conversationId = getConversationIdFromPrivateElement(replyBtn);

                            if (!row || !conversationId) return;

                            event.preventDefault();
                            event.stopPropagation();
                            event.stopImmediatePropagation();

                            prepareReply(conversationId, getMessagePayloadFromRow(row));
                            return;
                        }

                        const reactBtn = event.target.closest('[data-chat-react]');

                        if (reactBtn) {
                            const conversationId = getConversationIdFromPrivateElement(reactBtn);
                            const messageId = Number(reactBtn.dataset.chatReact || 0);

                            if (!conversationId || !messageId) return;

                            event.preventDefault();
                            event.stopPropagation();
                            event.stopImmediatePropagation();

                            try {
                                await openReactionPicker(event, messageId, reactBtn);
                            } catch (error) {
                                console.error(error);
                                notify('error', 'Emoji impossible', 'Impossible d’ouvrir les réactions.');
                            }
                        }
                    }, true);

                    document.addEventListener('change', async (event) => {
                        const input = event.target;

                        if (!(input instanceof HTMLInputElement)) return;

                        const id = String(input.id || '');

                        const isDesktopFile = /^molFile-\d+$/.test(id);
                        const isDesktopCamera = /^molCamera-\d+$/.test(id);
                        const isMobileFile = id === 'molChatThreadFile';
                        const isMobileCamera = id === 'molChatThreadCamera';

                        if (!isDesktopFile && !isDesktopCamera && !isMobileFile && !isMobileCamera) {
                            return;
                        }

                        event.preventDefault();
                        event.stopPropagation();
                        event.stopImmediatePropagation();

                        const conversationId = Number(
                            id.match(/\d+$/)?.[0] ||
                            CHAT.currentMobileConversationId ||
                            0
                        );

                        const file = input.files?.[0];

                        if (!conversationId || !file) {
                            input.value = '';
                            return;
                        }

                        try {
                            await sendFile(conversationId, file);
                        } catch (error) {
                            console.error(error);
                            notify('error', 'Envoi impossible', error?.message || 'Impossible d’envoyer le fichier.');
                        } finally {
                            input.value = '';
                        }
                    }, true);
                }

                function bindGlobalMessageActions() {
                    if (document.__molGlobalMsgActionsBound) return;
                    document.__molGlobalMsgActionsBound = true;

                    document.addEventListener('click', async (event) => {
                        const replyBtn = event.target.closest('[data-chat-reply]');
                        const reactBtn = event.target.closest('[data-chat-react]');

                        if (!replyBtn && !reactBtn) {
                            return;
                        }

                        const row = event.target.closest('.mol-msg-row');
                        const toast = event.target.closest('#molChatToasts .toast');
                        const thread = event.target.closest('#molChatThread');

                        if (!row || (!toast && !thread)) {
                            return;
                        }

                        const conversationId = Number(
                            toast?.id?.replace('molToast-', '') ||
                            thread?.dataset?.conversationId ||
                            CHAT.currentMobileConversationId ||
                            0
                        );

                        if (!conversationId) {
                            return;
                        }

                        event.preventDefault();
                        event.stopPropagation();
                        event.stopImmediatePropagation();

                        if (replyBtn) {
                            prepareReply(conversationId, getMessagePayloadFromRow(row));
                            return;
                        }

                        if (reactBtn) {
                            await openReactionPicker(
                                event,
