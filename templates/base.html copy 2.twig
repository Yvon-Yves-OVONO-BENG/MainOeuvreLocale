                                            </button>

                                            <input id="molChatThreadCamera" type="file" accept="image/*" capture="environment" class="d-none">

                                            <button class="mol-circle-btn" type="button" id="molChatThreadAttachBtn" title="{% trans %}Joindre un fichier{% endtrans %}">
                                                <i class="bi bi-paperclip"></i>
                                            </button>

                                            <input id="molChatThreadFile" type="file" class="d-none">

                                            <button id="molChatThreadMicBtn" class="mol-circle-btn" type="button" title="{% trans %}Enregistrer un vocal{% endtrans %}">
                                                <i class="bi bi-mic-fill"></i>
