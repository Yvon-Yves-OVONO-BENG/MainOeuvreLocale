                        button.setAttribute('data-mol-create-group-trigger', '1');
                    });
                }

                document.addEventListener('click', (event) => {
                    const button = event.target.closest('[data-mol-create-group-trigger], [data-action="create_group_chat"], [data-mol-panel-action="createGroup"]');

                    if (!button) return;

                    event.preventDefault();
                    event.stopPropagation();
                    event.stopImmediatePropagation();

                    openGroupModal();
                }, true);

                patchButtons();

                document.addEventListener('DOMContentLoaded', () => patchButtons());
                document.addEventListener('turbo:load', () => patchButtons());

                if (window.MutationObserver) {
                    new MutationObserver(() => patchButtons()).observe(document.body, {
                        childList: true,
                        subtree: true
                    });
                }

                window.MOLOpenCreateGroupModal = openGroupModal;
            })();
        </script>

    {% include 'chat/_include.html.twig' %}
    </body>
</html>