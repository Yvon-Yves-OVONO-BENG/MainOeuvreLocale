                function callSetTypeUi(type) {
                    const isVideo = type === 'video';
                    qs('molCallTypeText').textContent = isVideo ? 'Appel vidéo' : 'Appel audio';
                    qs('molCallTypeIcon').className = isVideo ? 'bi bi-camera-video-fill' : 'bi bi-telephone-fill';
                    qs('molCallCenterIcon').className = isVideo ? 'bi bi-camera-video-fill' : 'bi bi-telephone-fill';
                }

                function callSetStatus(text, sub = '') {
                    if (qs('molCallStatus')) qs('molCallStatus').textContent = text || '';
                    if (qs('molCallTopStatus')) qs('molCallTopStatus').textContent = text || '';
                    if (qs('molCallSubStatus')) qs('molCallSubStatus').textContent = sub || '';
                }

                function callSetCallerUi({ name = 'Appel', avatar = '/uploads/profiles/avatar.png' } = {}) {
                    if (qs('molCallName')) qs('molCallName').textContent = name;
                    if (qs('molCallTopName')) qs('molCallTopName').textContent = name;
                    if (qs('molCallAvatar')) qs('molCallAvatar').src = avatar;
                    if (qs('molCallAvatarTop')) qs('molCallAvatarTop').src = avatar;
                }

                function callStartTimer() {
                    callStopTimer();
                    CALL.startedAt = Date.now();
                    qs('molCallTimer').textContent = '00:00';

                    CALL.timerInterval = setInterval(() => {
                        const diff = Math.floor((Date.now() - CALL.startedAt) / 1000);
                        const mm = String(Math.floor(diff / 60)).padStart(2, '0');
                        const ss = String(diff % 60).padStart(2, '0');
                        qs('molCallTimer').textContent = `${mm}:${ss}`;
                    }, 1000);
                }

                function callStopTimer() {
                    if (CALL.timerInterval) {
                        clearInterval(CALL.timerInterval);
                        CALL.timerInterval = null;
                    }
                    if (qs('molCallTimer')) qs('molCallTimer').textContent = '00:00';
                }

                function callOverlayOpen() {
                    qs('molCallOverlay')?.classList.remove('d-none');
                    document.body.style.overflow = 'hidden';
                }

                function callOverlayClose() {
                    qs('molCallOverlay')?.classList.add('d-none');
                    document.body.style.overflow = '';
                }

                function callUpdateMiniStates() {
                    qs('molCallMiniMic').textContent = CALL.isMuted ? 'Coupé' : 'Actif';
                    qs('molCallMiniCam').textContent = CALL.isCameraEnabled ? 'Active' : 'Désactivée';
                    qs('molCallMiniSpeaker').textContent = CALL.isSpeakerOn ? 'Amplifiée' : 'Normale';
                    qs('molCallMiniFacing').textContent = CALL.currentFacingMode === 'user' ? 'Frontale' : 'Dorsale';
                }

                function callUpdateToolStates() {
                    const muteBtn = qs('molCallMuteBtn');
                    const speakerBtn = qs('molCallSpeakerBtn');
                    const videoBtn = qs('molCallVideoToggleBtn');

                    if (muteBtn) {
                        muteBtn.classList.toggle('is-muted', CALL.isMuted);
                        muteBtn.innerHTML = CALL.isMuted
                            ? '<i class="bi bi-mic-mute-fill"></i>'
                            : '<i class="bi bi-mic-fill"></i>';
                    }

                    if (speakerBtn) {
                        speakerBtn.classList.toggle('is-active', CALL.isSpeakerOn);
                        speakerBtn.innerHTML = CALL.isSpeakerOn
                            ? '<i class="bi bi-volume-up-fill"></i>'
                            : '<i class="bi bi-volume-down-fill"></i>';
                    }

                    if (videoBtn) {
                        videoBtn.classList.toggle('is-muted', !CALL.isCameraEnabled);
                        videoBtn.innerHTML = CALL.isCameraEnabled
                            ? '<i class="bi bi-camera-video-fill"></i>'
                            : '<i class="bi bi-camera-video-off-fill"></i>';
                    }

                    callUpdateMiniStates();
                }

                function callSetPhase(phase) {
                    const acceptBtn = qs('molCallAcceptBtn');
                    const declineBtn = qs('molCallDeclineBtn');
                    const endBtn = qs('molCallEndBtn');

                    const tools = [
                        qs('molCallMuteBtn'),
                        qs('molCallSpeakerBtn'),
                        qs('molCallVideoToggleBtn'),
                        qs('molCallSwitchCameraBtn'),
                        qs('molCallFullscreenBtn'),
                        qs('molCallPipBtn')
                    ];

                    if (acceptBtn) acceptBtn.style.display = phase === 'incoming' ? '' : 'none';
                    if (declineBtn) declineBtn.style.display = (phase === 'incoming' || phase === 'outgoing') ? '' : 'none';
                    if (endBtn) endBtn.style.display = phase === 'incall' ? '' : 'none';

                    tools.forEach(btn => {
                        if (btn) btn.disabled = phase !== 'incall';
                    });

                    if (qs('molCallVideoToggleBtn')) {
                        qs('molCallVideoToggleBtn').disabled = phase !== 'incall' || CALL.current?.type !== 'video';
                    }
                    if (qs('molCallSwitchCameraBtn')) {
                        qs('molCallSwitchCameraBtn').disabled = phase !== 'incall' || CALL.current?.type !== 'video';
                    }

                    callUpdateToolStates();
                }

                async function callEnsureLocalMedia(isVideo) {
                    if (CALL.localStream) {
                        const hasAudio = CALL.localStream.getAudioTracks().length > 0;
                        const hasVideo = CALL.localStream.getVideoTracks().length > 0;
                        if (hasAudio && (!isVideo || hasVideo)) return CALL.localStream;
                    }

                    if (CALL.localStream) {
                        CALL.localStream.getTracks().forEach(t => t.stop());
                        CALL.localStream = null;
                    }

                    CALL.localStream = await navigator.mediaDevices.getUserMedia({
                        audio: true,
                        video: isVideo ? { facingMode: { ideal: CALL.currentFacingMode } } : false
                    });

                    qs('molLocalVideo').srcObject = CALL.localStream;
                    CALL.isMuted = false;
                    CALL.isCameraEnabled = !!isVideo;
                    callUpdateToolStates();

                    return CALL.localStream;
                }

                function callCreatePeer(callId, isVideo) {
                    if (CALL.peer) {
                        CALL.peer.close();
                        CALL.peer = null;
                    }

                    const pc = new RTCPeerConnection({
                        iceServers: [{ urls: 'stun:stun.l.google.com:19302' }]
                    });

                    pc.onicecandidate = async (event) => {
                        if (!event.candidate) return;

                        await fetch(molUrl(window.MOL_CALL.urls.signal, callId), {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: JSON.stringify({
                                type: 'candidate',
                                data: event.candidate
                            })
                        });
                    };

                    pc.ontrack = (event) => {
                        const [stream] = event.streams;
                        if (!stream) return;
                        CALL.remoteStream = stream;
                        qs('molRemoteVideo').srcObject = stream;
                    };

                    pc.onconnectionstatechange = () => {
                        const state = pc.connectionState;
                        if (state === 'connected') {
                            callSetStatus('Appel en cours', 'Connexion établie');
                            callStartTimer();
                            callSetPhase('incall');
                        } else if (state === 'connecting') {
                            callSetStatus('Connexion en cours...', 'Établissement de la liaison');
                        } else if (state === 'failed' || state === 'disconnected' || state === 'closed') {
                            callSetStatus('Appel terminé', 'Connexion fermée');
                        }
                    };

                    CALL.peer = pc;
                    return pc;
                }

                async function callAttachLocalTracks(pc, stream) {
                    const senders = pc.getSenders();
                    stream.getTracks().forEach(track => {
                        const exists = senders.find(sender => sender.track && sender.track.id === track.id);
                        if (!exists) pc.addTrack(track, stream);
                    });
                }

                async function callSwitchCamera() {
                    if (!CALL.current || CALL.current.type !== 'video') return;

                    try {
                        CALL.currentFacingMode = CALL.currentFacingMode === 'user' ? 'environment' : 'user';

                        const fresh = await navigator.mediaDevices.getUserMedia({
                            audio: false,
                            video: { facingMode: { ideal: CALL.currentFacingMode } }
                        });

                        const newTrack = fresh.getVideoTracks()[0];
                        if (!newTrack) return;

                        const oldTrack = CALL.localStream?.getVideoTracks()[0];
                        if (CALL.peer) {
                            const sender = CALL.peer.getSenders().find(s => s.track && s.track.kind === 'video');
                            if (sender) await sender.replaceTrack(newTrack);
                        }

                        if (CALL.localStream) {
                            if (oldTrack) {
                                CALL.localStream.removeTrack(oldTrack);
                                oldTrack.stop();
                            }
                            CALL.localStream.addTrack(newTrack);
                            qs('molLocalVideo').srcObject = CALL.localStream;
                        } else {
                            CALL.localStream = fresh;
                            qs('molLocalVideo').srcObject = fresh;
                        }

                        CALL.isCameraEnabled = true;
                        callUpdateToolStates();
                        callSetStatus('Caméra changée', CALL.currentFacingMode === 'user' ? 'Caméra frontale activée' : 'Caméra dorsale activée');
                    } catch (e) {
                        console.warn(e);
                        callSetStatus('Caméra inchangée', 'Le navigateur a refusé le changement');
                    }
                }

                async function callToggleCamera() {
                    if (!CALL.current || CALL.current.type !== 'video') return;
                    const track = CALL.localStream?.getVideoTracks()?.[0];
                    if (!track) return;

                    CALL.isCameraEnabled = !CALL.isCameraEnabled;
                    track.enabled = CALL.isCameraEnabled;
                    callUpdateToolStates();

                    callSetStatus(
                        CALL.isCameraEnabled ? 'Caméra activée' : 'Caméra désactivée',
                        CALL.isCameraEnabled ? 'Votre vidéo est visible' : 'Votre vidéo est masquée'
                    );
                }

                function callToggleMute() {
                    const track = CALL.localStream?.getAudioTracks()?.[0];
                    if (!track) return;

                    CALL.isMuted = !CALL.isMuted;
                    track.enabled = !CALL.isMuted;
                    callUpdateToolStates();

                    callSetStatus(
                        CALL.isMuted ? 'Micro coupé' : 'Micro activé',
                        CALL.isMuted ? 'Votre interlocuteur ne vous entend plus' : 'Votre micro est actif'
                    );
                }

                async function callToggleSpeaker() {
                    CALL.isSpeakerOn = !CALL.isSpeakerOn;
                    const remote = qs('molRemoteVideo');

                    try {
                        if (remote && typeof remote.setSinkId === 'function') {
                            await remote.setSinkId('default');
                        }
                    } catch (_) {}

                    if (remote) remote.volume = CALL.isSpeakerOn ? 1 : .85;
                    callUpdateToolStates();

                    callSetStatus(
                        CALL.isSpeakerOn ? 'Haut-parleur activé' : 'Haut-parleur normal',
                        'Le routage final dépend du navigateur'
                    );
                }

                async function callToggleFullscreen() {
                    const shell = qs('molCallOverlay');
                    if (!shell) return;

                    try {
                        if (!document.fullscreenElement) await shell.requestFullscreen();
                        else await document.exitFullscreen();
                    } catch (_) {}
                }

                async function callTogglePip() {
                    const video = qs('molRemoteVideo');
                    if (!video || !document.pictureInPictureEnabled) return;

                    try {
                        if (document.pictureInPictureElement) await document.exitPictureInPicture();
                        else await video.requestPictureInPicture();
                    } catch (_) {}
                }

                function callGetConversationUiMeta(conversationId) {
                    const item = document.querySelector(`.mol-chat-item[data-id="${conversationId}"]`);
                    if (item) {
                        return {
                            name: item.dataset.name || 'Conversation',
                            avatar: item.dataset.avatar || '/uploads/profiles/avatar.png'
                        };
                    }

                    const toast = qs(`molToast-${conversationId}`);
                    if (toast) {
                        const img = toast.querySelector('img');
                        const name = toast.querySelector('.fw-bold')?.textContent?.trim() || 'Conversation';
                        return {
                            name,
                            avatar: img?.src || '/uploads/profiles/avatar.png'
                        };
                    }

                    return {
                        name: 'Conversation',
                        avatar: '/uploads/profiles/avatar.png'
                    };
                }

                async function callSubscribeTopic(callId) {
                    if (!window.MOL_CALL?.mercureHub) return;

                    if (CALL.mercureCall) {
                        CALL.mercureCall.close();
                        CALL.mercureCall = null;
                    }

                    const url = new URL(window.MOL_CALL.mercureHub);
                    url.searchParams.set('topic', `/chat/call/${callId}`);

                    CALL.mercureCall = new EventSource(url.toString());

                    CALL.mercureCall.onmessage = async (event) => {
                        const payload = JSON.parse(event.data);
                        if (!CALL.current || CALL.current.id !== payload.callId) return;

                        if (payload.event === 'accepted') {
                            callSetStatus('Appel accepté', 'Initialisation WebRTC');
                            callSetPhase('incall');

                            if (CALL.current.role === 'caller') {
                                const isVideo = CALL.current.type === 'video';
                                const stream = await callEnsureLocalMedia(isVideo);
                                const pc = callCreatePeer(CALL.current.id, isVideo);
                                await callAttachLocalTracks(pc, stream);

                                const offer = await pc.createOffer();
                                await pc.setLocalDescription(offer);

                                await fetch(molUrl(window.MOL_CALL.urls.signal, CALL.current.id), {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json',
                                        'X-Requested-With': 'XMLHttpRequest'
                                    },
                                    body: JSON.stringify({
                                        type: 'offer',
                                        data: offer
                                    })
                                });
                            }

                            return;
                        }

                        if (payload.event === 'declined') {
                            callSetStatus('Appel refusé', 'Votre correspondant a refusé l’appel');
                            setTimeout(() => cleanupCall(true), 900);
                            return;
                        }

                        if (payload.event === 'ended') {
                            callSetStatus('Appel terminé', 'La communication a été fermée');
                            setTimeout(() => cleanupCall(true), 600);
                            return;
                        }

                        if (payload.event === 'signal') {
                            if (payload.fromUserId === window.MOL_CALL.meId) return;

                            const pc = CALL.peer || callCreatePeer(CALL.current.id, CALL.current.type === 'video');

                            if (payload.signalType === 'offer') {
                                const stream = await callEnsureLocalMedia(CALL.current.type === 'video');
                                await callAttachLocalTracks(pc, stream);

                                await pc.setRemoteDescription(new RTCSessionDescription(payload.data));
                                const answer = await pc.createAnswer();
                                await pc.setLocalDescription(answer);

                                await fetch(molUrl(window.MOL_CALL.urls.signal, CALL.current.id), {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json',
                                        'X-Requested-With': 'XMLHttpRequest'
                                    },
                                    body: JSON.stringify({
                                        type: 'answer',
                                        data: answer
                                    })
                                });

                                callSetStatus('Connexion en cours...', 'Réponse envoyée');
                                callSetPhase('incall');
                                return;
                            }

                            if (payload.signalType === 'answer') {
                                await pc.setRemoteDescription(new RTCSessionDescription(payload.data));
                                callSetStatus('Connexion établie', 'Appel en cours');
                                callStartTimer();
                                return;
                            }

                            if (payload.signalType === 'candidate' && payload.data) {
                                try {
                                    await pc.addIceCandidate(new RTCIceCandidate(payload.data));
                                } catch (_) {}
                            }
                        }
                    };

                    CALL.mercureCall.onerror = (e) => {
                        console.warn('call topic error', e);
                    };
                }

                async function startConversationCall(conversationId, type) {
                    if (!window.MOL_CALL?.urls?.start) return;

                    try {
                        const ui = callGetConversationUiMeta(conversationId);

                        callSetCallerUi(ui);
                        callSetTypeUi(type);
                        callSetStatus(
                            type === 'video' ? 'Appel vidéo en cours de sonnerie...' : 'Appel audio en cours de sonnerie...',
                            'Notification de l’autre participant...'
                        );
                        callSetPhase('outgoing');
                        callOverlayOpen();

                        const res = await fetch(molUrl(window.MOL_CALL.urls.start, conversationId), {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: JSON.stringify({ type })
                        });

                        const data = await res.json();
                        if (!res.ok || !data.ok) {
                            callOverlayClose();
                            notify('error', "{% trans %}Appel impossible{% endtrans %}", data.error || "Impossible de démarrer l'appel.");
                            return;
                        }

                        CALL.current = {
                            id: data.callId,
                            conversationId,
                            type,
                            role: 'caller'
                        };

                        await callSubscribeTopic(data.callId);
                    } catch (e) {
                        console.error(e);
                        callOverlayClose();
                        notify('error', "{% trans %}Appel impossible{% endtrans %}", "{% trans %}Erreur lors du lancement de l’appel.{% endtrans %}");
                    }
                }

                async function acceptIncomingCall() {
                    if (!CALL.current || !window.MOL_CALL?.urls?.accept) return;

                    try {
                        const res = await fetch(molUrl(window.MOL_CALL.urls.accept, CALL.current.id), {
                            method: 'POST',
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });

                        const data = await res.json();
                        if (!res.ok || !data.ok) {
                            notify('error', "{% trans %}Appel impossible{% endtrans %}", "{% trans %}Impossible d’accepter l’appel.{% endtrans %}");
                            return;
                        }

                        await callSubscribeTopic(CALL.current.id);
                        callSetStatus('Appel accepté', 'Connexion en cours...');
                        callSetPhase('incall');
                    } catch (e) {
                        console.error(e);
                        notify('error', "{% trans %}Erreur{% endtrans %}", "{% trans %}Erreur lors de l’acceptation.{% endtrans %}");
                    }
                }

                async function declineIncomingCall() {
                    if (!CALL.current) return;

                    try {
                        if (window.MOL_CALL?.urls?.decline) {
                            await fetch(molUrl(window.MOL_CALL.urls.decline, CALL.current.id), {
                                method: 'POST',
                                headers: { 'X-Requested-With': 'XMLHttpRequest' }
                            });
                        }
                    } catch (_) {}

                    cleanupCall(true);
                }

                async function endCurrentCall() {
                    if (!CALL.current) return;

                    try {
                        if (window.MOL_CALL?.urls?.end) {
                            await fetch(molUrl(window.MOL_CALL.urls.end, CALL.current.id), {
                                method: 'POST',
                                headers: { 'X-Requested-With': 'XMLHttpRequest' }
                            });
                        }
                    } catch (_) {}

                    cleanupCall(true);
                }

                function cleanupCall(hide = true) {
                    if (CALL.peer) {
                        CALL.peer.close();
                        CALL.peer = null;
                    }

                    if (CALL.localStream) {
                        CALL.localStream.getTracks().forEach(t => t.stop());
                        CALL.localStream = null;
                    }

                    if (CALL.remoteStream) {
                        CALL.remoteStream.getTracks().forEach(t => t.stop());
                        CALL.remoteStream = null;
                    }

                    if (CALL.mercureCall) {
                        CALL.mercureCall.close();
                        CALL.mercureCall = null;
                    }

                    CALL.current = null;
                    CALL.isMuted = false;
                    CALL.isCameraEnabled = true;
                    CALL.isSpeakerOn = false;
                    CALL.currentFacingMode = 'user';

                    callStopTimer();
                    qs('molLocalVideo').srcObject = null;
                    qs('molRemoteVideo').srcObject = null;
                    callUpdateToolStates();
                    callSetPhase('idle');
                    callSetStatus('En attente...', 'Prêt pour un nouvel appel');
                    callSetCallerUi({ name: 'Appel', avatar: '/uploads/profiles/avatar.png' });
                    callSetTypeUi('audio');

                    if (hide) callOverlayClose();
                }

                function subscribeIncomingCalls() {
                    if (!window.MOL_CALL?.meId || !window.MOL_CALL?.mercureHub) return;

                    if (CALL.mercureIncoming) {
                        CALL.mercureIncoming.close();
                        CALL.mercureIncoming = null;
                    }

                    const url = new URL(window.MOL_CALL.mercureHub);
                    url.searchParams.set('topic', `/chat/user/${window.MOL_CALL.meId}/incoming-call`);

                    CALL.mercureIncoming = new EventSource(url.toString());

                    CALL.mercureIncoming.onmessage = (event) => {
                        const payload = JSON.parse(event.data);
                        if (payload.event !== 'incoming_call') return;

                        CALL.current = {
                            id: payload.callId,
                            conversationId: payload.conversationId,
                            type: payload.type,
                            role: 'callee'
                        };

                        callSetCallerUi({
                            name: payload.fromName || 'Appel entrant',
                            avatar: payload.fromAvatar || '/uploads/profiles/avatar.png'
                        });

                        callSetTypeUi(payload.type || 'audio');
                        callSetStatus(
                            payload.type === 'video' ? 'Appel vidéo entrant...' : 'Appel audio entrant...',
                            'Décrochez ou refusez'
                        );
                        callSetPhase('incoming');
                        callOverlayOpen();
                    };

                    CALL.mercureIncoming.onerror = (e) => {
                        console.warn('incoming-call error', e);
                    };
                }

                function bindCallUi() {
                    qs('molCallAcceptBtn')?.addEventListener('click', acceptIncomingCall);
                    qs('molCallDeclineBtn')?.addEventListener('click', declineIncomingCall);
                    qs('molCallEndBtn')?.addEventListener('click', endCurrentCall);
                    qs('molCallCloseBtn')?.addEventListener('click', endCurrentCall);
                    qs('molCallMuteBtn')?.addEventListener('click', callToggleMute);
                    qs('molCallSpeakerBtn')?.addEventListener('click', callToggleSpeaker);
                    qs('molCallVideoToggleBtn')?.addEventListener('click', callToggleCamera);
                    qs('molCallSwitchCameraBtn')?.addEventListener('click', callSwitchCamera);
                    qs('molCallFullscreenBtn')?.addEventListener('click', callToggleFullscreen);
                    qs('molCallPipBtn')?.addEventListener('click', callTogglePip);
                }

                function boot() {
                    bindSearchInput();
                    bindConversationClick();
                    bindPrivateChatLikeGroup();
                    bindGlobalMessageActions();
                    ensureContextMenu();

                    initFriendButtons();
                    bindCallUi();
                    subscribeIncomingCalls();
                    callUpdateToolStates();
                    callSetPhase('idle');

                    heartbeat();

                    setInterval(() => {
                        heartbeat();
                        if (qs('molChatPanel')?.classList.contains('is-open')) {
                            refreshList(qs('molChatSearch')?.value?.trim() || '');
                        }
                    }, 25000);

                    setInterval(() => {
                        refreshRenderedPresence();
                    }, 15000);

                    document.addEventListener('visibilitychange', () => {
                        if (document.visibilityState === 'visible') {
                            heartbeat();
                            if (qs('molChatPanel')?.classList.contains('is-open')) {
                                refreshList(qs('molChatSearch')?.value?.trim() || '');
                            }
                        }
                    });

                    window.addEventListener('pagehide', goOffline);
                    window.addEventListener('beforeunload', goOffline);

                    updateLayoutVars();
                    window.addEventListener('resize', updateLayoutVars);
                    window.addEventListener('orientationchange', () => setTimeout(updateLayoutVars, 250));

                    if (window.visualViewport) {
                        window.visualViewport.addEventListener('resize', updateLayoutVars);
                        window.visualViewport.addEventListener('scroll', updateLayoutVars);
                    }

                    document.addEventListener('focusin', (e) => {
                        if (e.target.closest('#molChatThreadInput, [id^="molToastInput-"]')) {
                            setTimeout(updateLayoutVars, 120);
                        }
                    });
                }

                window.MOLRequireChatConfig = requireChatConfig;
                window.MOLChatOpen = openPanel;
                window.MOLChatClose = closePanel;
                window.MOLChatRefreshList = refreshList;
                window.MOLChatLoadConversations = loadConversations;
                window.MOLChatRenderConversations = renderConversations;
                window.MOLChatFetchMessages = fetchMessages;
                window.MOLChatRenderBubbleMessages = renderMessages;
                window.MOLChatRefreshBubble = refreshBubble;
                window.MOLChatOpenBubble = openBubble;
                window.MOLChatOpenConversation = openConversation;
                window.MOLChatStartWith = startWithUser;

                window.MOLBindEmojiPickerForToast = bindEmojiPickerForToast;
                window.MOLEnsureEmojiLib = ensureEmojiLib;
                window.MOLOpenReactionPicker = openReactionPicker;

                window.MOLHandleComposerInput = handleComposerInput;
                window.MOLChatToastSend = sendToastText;
                window.MOLChatToastSendFile = sendFile;
                window.MOLChatToastToggleVoice = toggleVoice;
                window.MOLChatSendLike = sendLike;
                window.MOLHandleCameraClick = handleCameraClick;
                window.MOLToastKeydown = onToastKeydown;
                window.MOLAutoResize = autoResize;

                window.MOLClearReply = clearReply;
                window.MOLHandleTypingInput = handleTypingInput;
                window.MOLShowTyping = showTyping;
                window.MOLHideTyping = hideTyping;
                window.MOLOnNewMessage = onNewMessage;

                window.MOLChatIsMobile = isMobileChat;
                window.MOLChatOpenConversationMobile = openConversationMobile;
                window.MOLChatCloseConversationMobile = closeConversationMobile;

                window.MOLChatRunAction = runAction;

                window.MOLStartConversationCall = startConversationCall;
                window.showEmail = showEmail;
                window.showPhone = showPhone;

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', boot);
                } else {
                    boot();
                }
            })();
        </script>

