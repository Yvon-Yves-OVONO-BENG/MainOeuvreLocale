                                reactBtn
                            );
                        }
                    }, true);
                }

                const MOL_DEFAULT_AVATAR = window.MOL_CHAT_ASSETS?.defaultAvatar || '/uploads/profiles/avatar.png';
                const MOL_PROFILE_BASE = window.MOL_CHAT_ASSETS?.profilesBase || '/uploads/profiles/';

                function isBadAvatarUrl(value) {
                    const v = String(value || '').trim();

                    if (
                        !v ||
                        v === 'null' ||
                        v === 'undefined' ||
                        v === window.location.href
                    ) {
                        return true;
                    }

                    let path = v;

                    try {
                        path = new URL(v, window.location.origin).pathname;
                    } catch (_) {
                        path = v.split('?')[0].split('#')[0];
                    }

                    return (
                        path === '/' ||
                        path.endsWith('/null') ||
                        path.endsWith('/undefined') ||
                        path.endsWith('/uploads/profiles/') ||
                        path.endsWith('/uploads/profiles/null') ||
                        path.endsWith('/uploads/profiles/undefined')
                    );
                }

                function buildProfileAvatarUrl(photo) {
                    let value = String(photo || '').trim();

                    if (isBadAvatarUrl(value)) {
                        return MOL_DEFAULT_AVATAR;
                    }

                    if (value.startsWith('data:image/') || value.startsWith('blob:')) {
                        return value;
                    }

                    value = value.replaceAll('\\', '/');

                    if (/^https?:\/\//i.test(value)) {
                        try {
                            const url = new URL(value);

                            if (!url.pathname.includes('/uploads/profiles/')) {
                                return value;
                            }

                            value = url.pathname;
                        } catch (_) {
                            return value;
                        }
                    }

                    value = value.replace(/^\/?maindoeuvrelocale\/public\/uploads\/profiles\//, '');
                    value = value.replace(/^\/?maindoeuvrelocale\/uploads\/profiles\//, '');
                    value = value.replace(/^\/?public\/uploads\/profiles\//, '');
                    value = value.replace(/^\/?uploads\/profiles\//, '');
                    value = value.replace(/^\/?profiles\//, '');
                    value = value.replace(/^\/+/, '');

                    if (!value || value === 'null' || value === 'undefined') {
                        return MOL_DEFAULT_AVATAR;
                    }

                    const encoded = value
                        .split('/')
                        .filter(Boolean)
                        .map(part => encodeURIComponent(decodeURIComponent(part)))
                        .join('/');

                    return MOL_PROFILE_BASE.replace(/\/?$/, '/') + encoded;
                }

                function safeAvatarUrl(url, fallback = MOL_DEFAULT_AVATAR) {
                    return buildProfileAvatarUrl(isBadAvatarUrl(url) ? fallback : url);
                }

                function getConversationContactAvatar(conversationId) {
                    const item = document.querySelector(`.mol-chat-item[data-id="${conversationId}"]`);

                    const dataAvatar = item?.dataset?.avatar || '';
                    if (!isBadAvatarUrl(dataAvatar)) {
                        return safeAvatarUrl(dataAvatar);
                    }

                    const listImg = item?.querySelector('img');
                    const listSrc = listImg?.getAttribute('src') || listImg?.src || '';
                    if (!isBadAvatarUrl(listSrc)) {
                        return safeAvatarUrl(listSrc);
                    }

                    const toastImg = document.querySelector(`#molToast-${conversationId} .mol-avatar-wrap img`);
                    const toastSrc = toastImg?.getAttribute('src') || toastImg?.src || '';
                    if (!isBadAvatarUrl(toastSrc)) {
                        return safeAvatarUrl(toastSrc);
                    }

                    const thread = qs('molChatThread');
                    const threadConvId = Number(thread?.dataset?.conversationId || 0);

                    if (threadConvId === Number(conversationId)) {
                        const threadImg = qs('molChatThreadAvatar');
                        const threadSrc = threadImg?.getAttribute('src') || threadImg?.src || '';

                        if (!isBadAvatarUrl(threadSrc)) {
                            return safeAvatarUrl(threadSrc);
                        }
                    }

                    return MOL_DEFAULT_AVATAR;
                }




