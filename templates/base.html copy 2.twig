        <script id="mol-chat-panel-menu-rescue-script">
            (() => {
                if (window.__MOL_CHAT_PANEL_MENU_RESCUE__) return;
                window.__MOL_CHAT_PANEL_MENU_RESCUE__ = true;

                let button = null;
