        <link href="{{ asset('build/assets/css/icons.css') }}" rel="stylesheet">
        <link rel="stylesheet" href="{{ asset('css/base.css') }}">
                
        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {# {{ encore_entry_script_tags('app') }} #}

            {% block importmap %}
                {{ importmap('app') }}
            {% endblock %}

            <script>
                window.MOL_CHAT = {
                    baseUrl: "{{ app.request.basePath }}",
                    urls: {
                        conversations: "{{ path('chat_conversations') }}",
                        withUser: "{{ path('chat_with_user', {userId: 0}) }}".replace('/0', ''),

                        messages: "{{ path('chat_messages', {id: 0}) }}".replace('/0/', '/__ID__/'),
                        send: "{{ path('chat_send', {id: 0}) }}".replace('/0/', '/__ID__/'),
                        read: "{{ path('chat_mark_read', {id: 0}) }}".replace('/0/', '/__ID__/'),
                        typing: "{{ path('chat_typing', {id: 0}) }}".replace('/0/', '/__ID__/'),

                        callVideo: "{{ path('chat_call_video', {id: 0}) }}".replace('/0/', '/__ID__/'),
                        callAudio: "{{ path('chat_call_audio', {id: 0}) }}".replace('/0/', '/__ID__/'),

                        deleteConversation: "{{ path('chat_delete_conversation', {id: 0}) }}".replace('/0/', '/__ID__/'),
                        markUnread: "{{ path('chat_mark_unread', {id: 0}) }}".replace('/0/', '/__ID__/'),
                        mute: "{{ path('chat_mute', {id: 0}) }}".replace('/0/', '/__ID__/'),
                        archive: "{{ path('chat_archive', {id: 0}) }}".replace('/0/', '/__ID__/'),
                        report: "{{ path('chat_report', {id: 0}) }}".replace('/0/', '/__ID__/'),

                        sendFile: "{{ path('chat_conversation_send_file', {id: 0}) }}".replace('/0/', '/__ID__/'),
                        sendVoice: "{{ path('chat_conversation_send_voice', {id: 0}) }}".replace('/0/', '/__ID__/'),
                        react: "{{ path('message_reaction_toggle', {id: 0}) }}".replace('/0/', '/__ID__/'),
                        messageDelete: "{{ path('chat_message_delete', {id: 0}) }}".replace('/0/', '/__ID__/')
                    }
                };

                window.MOL_FRIEND = {
                    pendingListUrl: "{{ path('friendship_pending_list') }}",
                    friendsListUrl: "{{ path('friendship_friends_list') }}",

                    stateUrlTpl: "{{ path('friendship_state', { userId: 0 }) }}".replace('/0', '/__ID__'),
                    requestUrlTpl: "{{ path('friendship_request', { userId: 0 }) }}".replace('/0', '/__ID__'),
                    
                    cancelUrlTpl: "{{ path('friendship_cancel', { userId: 0 }) }}".replace('/0', '/__ID__'),
                    blockUrlTpl: "{{ path('friendship_block', { userId: 0 }) }}".replace('/0', '/__ID__'),

                    acceptUrlTpl: "{{ path('friendship_accept', { id: 0 }) }}".replace('/0', '/__ID__'),
                    rejectUrlTpl: "{{ path('friendship_reject', { id: 0 }) }}".replace('/0', '/__ID__')
                };

                window.MERCURE_HUB = "{{ app.request.server.get('MERCURE_PUBLIC_URL')|default('http://localhost:3000/.well-known/mercure') }}";

                window.MOL_CALL = {
                    meId: {{ app.user ? app.user.id : 'null' }},
                    meAvatar: "{{ app.user and app.user.personalProfile and app.user.personalProfile.photo
                        ? asset('uploads/profiles/' ~ app.user.personalProfile.photo)
                        : asset('uploads/profiles/avatar.png') }}",
                    mercureHub: window.MERCURE_HUB,
                    urls: {
                        start: "{{ path('chat_call_start', {id: 0}) }}".replace('/0/', '/__CONV__/'),
                        accept: "{{ path('chat_call_accept', {id: 0}) }}".replace('/0', '/__CALL__'),
                        decline: "{{ path('chat_call_decline', {id: 0}) }}".replace('/0', '/__CALL__'),
                        signal: "{{ path('chat_call_signal', {id: 0}) }}".replace('/0', '/__CALL__'),
                        end: "{{ path('chat_call_end', {id: 0}) }}".replace('/0', '/__CALL__')
                    }
                };

                window.MOL_PRESENCE = {
                    heartbeat: "{{ path('presence_heartbeat') }}",
                    offline: "{{ path('presence_offline') }}"
                };
            </script>

            <script src="{{ asset('js/mol-base.js') }}" defer></script>
        {% endblock %}

        {% set isHomePage= app.request.attributes.get('_route') == 'accueil' %}
    </head>

    <body class="{% block body_class %}{% endblock %}">
        <div class="app-shell">

            <!-- Navbar principale -->
            <div class="pm-navbar">
                <div class="container">
                    <div class="pm-navbar-inner">
                        <a href="{{ path('accueil') }}" class="menu-brand" data-turbo="false">
                            {# {% include 'partials/_logo.html.twig' %} #}
                            <img src="{{ asset ('build/assets/images/brand/logo.svg') }}" class="header-brand-img desktop-logo" alt="logo">
                            
                        </a>

                        <ul class="pm-menu d-none d-lg-flex">
                            <li><a class="pm-menu-link {{ app.request.attributes.get('_route') == 'accueil' ? 'active' : '' }}" href="{{ path('accueil') }}" data-turbo="false"><i class="fas fa-home"></i> {% trans %}Accueil{% endtrans %}</a></li>
                            <li><a class="pm-menu-link {{ app.request.attributes.get('_route') == 'marketing_story' ? 'active' : '' }}" href="{{ path('marketing_story') }}" data-turbo="false"><i class="fas fa-info-circle"></i> {% trans %}À propos{% endtrans %}</a></li>
                            <li>
                                <a class="pm-menu-link {{ app.request.attributes.get('_route') == 'liste_jobs' ? 'active' : '' }}" href="{{ path('liste_jobs') }}" data-turbo="false">
                                    <i class="fas fa-briefcase"></i>
                                    {% trans %}Missions{% endtrans %}
                                </a>
                            </li>
                            <li class="pm-has-submenu pm-profiles-desktop">
                                <a
                                    class="pm-menu-link {{ app.request.attributes.get('_route') in ['reputation_companies', 'reputation_particuliers', 'liste_talents'] ? 'active' : '' }}"
                                    href="javascript:void(0);"
                                    data-turbo="false"
                                    aria-expanded="false"
                                >
                                    
                                    <i class="fa fa-users"></i> 
                                    {% trans %}Profils{% endtrans %}
                                    <span class="fa fa-caret-down m-0 pm-submenu-caret"></span>
                                </a>

                                <ul class="sub-menu">
                                    <li>
                                        <a href="{{ path('reputation_companies') }}" data-turbo="false">
                                            {% trans %}Compagnies{% endtrans %}
                                        </a>
                                    </li>
                                    <li>
                                        <a href="{{ path('reputation_particuliers') }}" data-turbo="false">
                                            {% trans %}Particuliers{% endtrans %}
                                        </a>
                                    </li>
                                    <li>
                                        <a href="{{ path('liste_talents') }}" data-turbo="false">
                                            {% trans %}Talents{% endtrans %}
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li><a class="pm-menu-link {{ app.request.attributes.get('_route') starts with 'pricing' ? 'active' : '' }}" href="{{ path('pricing_index') }}" data-turbo="false"><i class="fas fa-tags"></i> {% trans %}Plans{% endtrans %}</a></li>
                            <li><a class="pm-menu-link {{ app.request.attributes.get('_route') == 'contact_page' ? 'active' : '' }}" href="{{ path('contact_page') }}" data-turbo="false"><i class="fas fa-envelope"></i> {% trans %}Contact{% endtrans %}</a></li>
                        </ul>

                        <div class="pm-buttons d-none d-lg-flex">

                            <div class="mol-dd mol-topbar-lang" data-mol-dd>
                                <button type="button" class="mol-dd-btn mol-lang-btn" data-mol-dd-btn aria-expanded="false">
                                    {% if app.request.locale == 'fr' %}
                                        <img src="{{ asset('build/assets/fr.png') }}" alt="fr" class="country" width="20" height="15">
                                        <span>FR</span>
                                    {% else %}
                                        <img src="{{ asset('build/assets/en.png') }}" alt="en" class="country" width="20" height="15">
                                        <span>EN</span>
                                    {% endif %}
                                    <i class="fa fa-angle-down"></i>
                                </button>

                                <div class="mol-dd-menu" data-mol-dd-menu>
                                    {% for locale in locales %}
                                        <a
                                            class="mol-dd-item d-flex align-items-center gap-2 px-3 py-2"
                                            data-mol-dd-close
                                            data-turbo="false"
                                            href="{{ path('change_locale', {'locale': locale}) }}"
                                        >
                                            <img src="{{ asset('build/assets/' ~ locale ~ '.png') }}" alt="{{ locale }}" width="20" height="15">
                                            {% if locale == 'fr' %}
                                                {% trans %}Français{% endtrans %}
                                            {% else %}
                                                {% trans %}Anglais{% endtrans %}
                                            {% endif %}
                                        </a>
                                    {% endfor %}
                                </div>
                            </div>

                            {% if app.user %}
                                <li class="mol-dd mol-account-dd" data-mol-dd >
                                    <a href="javascript:void(0);" class="pm-menu-link mol-dd-btn mol-account-btn" data-mol-dd-btn aria-expanded="false">
                                        <span class="mol-account-btn-icon">
                                            <i class="fa fa-user-circle"></i>
                                        </span>
                                        <span class="mol-account-btn-text">{% trans %}Mon compte{% endtrans %}</span>
                                        <span class="mol-account-btn-caret">
                                            <i class="fa fa-angle-down"></i>
                                        </span>
                                    </a>

                                    <div class="mol-dd-menu mol-account-menu" data-mol-dd-menu>
                                        <div class="mol-dd-head mol-account-head">
                                            <div class="mol-account-user">
                                                <div class="mol-account-avatar">
                                                    {% if app.user and app.user.photo is defined and app.user.photo %}
                                                        <img src="{{ asset('uploads/users/' ~ app.user.photo) }}" alt="{{ app.user.email }}">
                                                    {% else %}
                                                        <span>{{ app.user.email|slice(0, 1)|upper }}</span>
                                                    {% endif %}
                                                </div>

                                                <div class="mol-account-meta">
                                                    <p class="mol-dd-title m-0">{% trans %}Espace membre{% endtrans %}</p>
                                                    <p class="mol-dd-sub m-0">{{ app.user.email }}</p>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mol-account-links">
                                            <a href="{{ path('tableau_de_bord') }}" data-turbo="false" class="mol-dd-item mol-account-item">
                                                <span class="mol-account-item-icon">
                                                    <i class="fa fa-home"></i>
                                                </span>
                                                <span class="mol-account-item-content">
                                                    <span class="mol-account-item-title">{% trans %}Tableau de bord{% endtrans %}</span>
                                                    <small>{% trans %}Vue générale de votre activité{% endtrans %}</small>
                                                </span>
                                            </a>

                                            <a href="{{ path('profile_edit') }}" data-turbo="false" class="mol-dd-item mol-account-item">
                                                <span class="mol-account-item-icon">
                                                    <i class="fa fa-id-card"></i>
                                                </span>
                                                <span class="mol-account-item-content">
                                                    <span class="mol-account-item-title">{% trans %}Mon profil{% endtrans %}</span>
                                                    <small>{% trans %}Informations personnelles et photo{% endtrans %}</small>
                                                </span>
                                            </a>

                                            <a href="{{ path('settings_index', { tab: 'security' }) }}" data-turbo="false" class="mol-dd-item mol-account-item">
                                                <span class="mol-account-item-icon">
                                                    <i class="fa fa-lock"></i>
                                                </span>
                                                <span class="mol-account-item-content">
                                                    <span class="mol-account-item-title">{% trans %}Sécurité{% endtrans %}</span>
                                                    <small>{% trans %}Modifier mon mot de passe{% endtrans %}</small>
                                                </span>
                                            </a>

                                            <a href="{{ path('settings_index') }}" data-turbo="false" class="mol-dd-item mol-account-item">
                                                <span class="mol-account-item-icon">
                                                    <i class="fa fa-cog"></i>
                                                </span>
                                                <span class="mol-account-item-content">
                                                    <span class="mol-account-item-title">{% trans %}Paramètres{% endtrans %}</span>
                                                    <small>{% trans %}Préférences et configuration{% endtrans %}</small>
                                                </span>
                                            </a>

                                            
                                        </div>

                                        <div class="mol-account-footer">
                                            <a class="mol-dd-item mol-account-item mol-account-item-danger" href="{{ path('app_logout') }}" data-turbo="false">
                                                <span class="mol-account-item-icon">
                                                    <i class="fa fa-power-off"></i>
                                                </span>
                                                <span class="mol-account-item-content">
                                                    <span class="mol-account-item-title">{% trans %}Fermer ma session{% endtrans %}</span>
                                                    <small>{% trans %}Quitter votre espace membre{% endtrans %}</small>
                                                </span>
                                            </a>
                                        </div>
                                    </div>
                                </li>
                            {% else %}
                                <a class="pm-btn pm-btn-soft" href="{{ path('app_login') }}" data-turbo="false">
                                    <i class="fas fa-sign-in-alt"></i>
                                    {% trans %}Connexion{% endtrans %}
                                </a>

                                <a class="pm-btn pm-btn-green" href="{{ path('app_register') }}" data-turbo="false">
                                    <i class="fas fa-user-plus"></i>
                                    {% trans %}Inscription{% endtrans %}
                                </a>
                            {% endif %}

                        </div>

                        <button class="pm-hamburger d-lg-none" id="pmHamburgerBtn">
                            <i class="fas fa-bars"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Menu mobile -->
            <div class="pm-mobile-menu" id="pmMobileMenu">
                <div class="pm-mobile-header">
                    <img src="{{ asset('build/assets/images/brand/logo.svg') }}" alt="" height="35">
                    
                    
                    <button
                        type="button"
                        class="pm-mobile-close"
                        id="pmMobileClose"
                        aria-label="{{ 'Fermer le menu'|trans }}"
                        onclick="pmCloseMobileMenu(event)"
                    >
                        <i class="fas fa-times"></i>
                    </button>
                    
                </div>
                <ul class="pm-mobile-nav">
                    <li><a class="pm-mobile-link" href="{{ path('accueil') }}" data-turbo="false"><i class="fas fa-home"></i> {% trans %}Accueil{% endtrans %}</a></li>
