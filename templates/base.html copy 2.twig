                    thread = wrap.firstElementChild;
                    list.parentElement.appendChild(thread);

                    qs('molChatThreadBack')?.addEventListener('click', closeConversationMobile);
                    qs('molChatThreadClose')?.addEventListener('click', closePanel);

                    const ddToggle = qs('molChatThreadDropdown');
                    if (ddToggle && window.bootstrap?.Dropdown) {
                        window.bootstrap.Dropdown.getOrCreateInstance(ddToggle, { autoClose: 'outside' });
                    }

                    const dropdown = thread.querySelector('.dropdown-menu');
                    if (dropdown && !thread.__molDropdownBound) {
                        thread.__molDropdownBound = true;

                        dropdown.addEventListener('click', (e) => {
                            const currentConvId = Number(CHAT.currentMobileConversationId || 0);

                            const callLink = e.target.closest('[data-call-type]');
                            if (callLink) {
                                e.preventDefault();
                                window.MOLStartConversationCall?.(currentConvId, callLink.dataset.callType);
                                return;
                            }

                            const actionLink = e.target.closest('[data-chat-action]');
                            if (actionLink) {
                                e.preventDefault();
                                window.MOLChatRunAction?.(e, currentConvId, actionLink.dataset.chatAction);
                            }
                        });
                    }

                    const input = qs('molChatThreadInput');
                    input?.addEventListener('input', () => {
                        handleMobileComposerState();
                        autoResize(input);
                        if (CHAT.currentMobileConversationId) handleTypingInput(CHAT.currentMobileConversationId);
                    });

                    input?.addEventListener('keydown', (e) => {
                        if (e.key === 'Enter' && !e.shiftKey) {
                            e.preventDefault();
                            sendMobileText();
                        }
                    });

                    qs('molChatThreadSend')?.addEventListener('click', sendMobileText);

                    qs('molChatThreadLikeBtn')?.addEventListener('click', async () => {
                        if (CHAT.currentMobileConversationId) {
                            await sendLike(CHAT.currentMobileConversationId);
                        }
                    });

                    qs('molChatThreadAttachBtn')?.addEventListener('click', () => qs('molChatThreadFile')?.click());

                    qs('molChatThreadFile')?.addEventListener('change', async () => {
                        const file = qs('molChatThreadFile')?.files?.[0];
                        if (CHAT.currentMobileConversationId && file) {
                            await sendFile(CHAT.currentMobileConversationId, file);
                        }
                        if (qs('molChatThreadFile')) qs('molChatThreadFile').value = '';
                    });

                    qs('molChatThreadCameraBtn')?.addEventListener('click', async () => {
                        if (!CHAT.currentMobileConversationId) return;
                        if (isProbablyMobileDevice()) {
                            qs('molChatThreadCamera')?.click();
                        } else {
                            await handleCameraClick(CHAT.currentMobileConversationId);
                        }
                    });

                    qs('molChatThreadCamera')?.addEventListener('change', async () => {
                        const file = qs('molChatThreadCamera')?.files?.[0];
                        if (CHAT.currentMobileConversationId && file) {
                            await sendFile(CHAT.currentMobileConversationId, file);
                        }
                        if (qs('molChatThreadCamera')) qs('molChatThreadCamera').value = '';
                    });

                    qs('molChatThreadMicBtn')?.addEventListener('click', async () => {
                        if (CHAT.currentMobileConversationId) {
                            await toggleVoice(CHAT.currentMobileConversationId);
                        }
                    });

                    ensureEmojiLib().then(() => {
                        const btn = qs('molChatThreadEmojiBtn');
                        const input = qs('molChatThreadInput');

                        if (!btn || !input || btn.__emojiBound) return;
                        btn.__emojiBound = true;

                        const Ctor =
                            typeof window.EmojiButton === 'function'
                                ? window.EmojiButton
                                : window.EmojiButton?.EmojiButton;

                        if (!Ctor) return;

                        const picker = new Ctor({
                            position: 'top-start',
                            autoHide: true,
                            theme: 'light',
                            rootElement: document.body,
                            zIndex: 2147483647
                        });

                        btn.addEventListener('click', (e) => {
                            e.preventDefault();
                            picker.togglePicker(btn);
                        });

                        picker.on('emoji', (selection) => {
                            const emoji = typeof selection === 'string' ? selection : selection?.emoji;
                            if (!emoji) return;
                            input.value = (input.value || '') + emoji;
                            input.dispatchEvent(new Event('input', { bubbles: true }));
                            input.focus();
                        });
                    }).catch(() => {});

                    CHAT.mobileThreadReady = true;
                    return thread;
                }

                async function openConversationMobile(conv) {
                    const thread = ensureMobileThreadUi();
                    if (!thread) return;

                    CHAT.currentMobileConversationId = Number(conv.id || 0);

                    qs('molChatList')?.classList.add('d-none');
                    qs('molChatSearch')?.closest('.mol-chat-search-wrap')?.classList.add('d-none');

                    thread.classList.remove('d-none');
                    thread.dataset.conversationId = String(CHAT.currentMobileConversationId);

                    qs('molChatThreadAvatar').src = safeAvatarUrl(conv.avatar || '');
                    qs('molChatThreadName').textContent = conv.name || 'Conversation';

                    const presence = getPresenceMeta(conv.presence || (conv.online ? 'online' : 'offline'));
                    qs('molChatThreadStatus').textContent = presence.label;

                    handleMobileComposerState();
                    renderReplyBox(CHAT.currentMobileConversationId);
                    initMercureConversation(CHAT.currentMobileConversationId);
                    await refreshMobileThread(CHAT.currentMobileConversationId);

                    setTimeout(() => {
                        autoResize(qs('molChatThreadInput'));
                        qs('molChatThreadInput')?.focus();
                    }, 120);
                }

                function closeConversationMobile() {
                    CHAT.currentMobileConversationId = null;
                    qs('molChatThread')?.classList.add('d-none');
                    qs('molChatList')?.classList.remove('d-none');
                    qs('molChatSearch')?.closest('.mol-chat-search-wrap')?.classList.remove('d-none');
                    if (qs('molChatThreadReplyBox')) {
                        qs('molChatThreadReplyBox').classList.remove('is-active');
                        qs('molChatThreadReplyBox').innerHTML = '';
                    }
                }

                async function conversationAction(conversationId, action, payload = {}) {
                    const url = window.MOL_CHAT?.urls?.[action];

                    if (!url) {
                        return {
                            ok: true,
                            localOnly: true,
                            action
                        };
                    }

                    const res = await fetch(molUrl(url, conversationId), {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify(payload)
                    });

                    const data = await res.json().catch(() => ({}));

                    if (!res.ok || data.ok === false) {
                        throw new Error(data.message || data.error || ('HTTP ' + res.status));
                    }

                    return data;
                }

                async function runAction(event, conversationId, action) {
                    event.preventDefault();

                    try {
                        let payload = {};

                        if (action === 'report') {
                            const reason = await askText(
                                "{% trans %}Raison du signalement{% endtrans %}",
                                "{% trans %}Décrivez brièvement le problème{% endtrans %}"
                            );

                            if (reason === null) return false;

                            payload.reason = reason;
                        }

                        if (action === 'deleteConversation') {
                            const ok = await askConfirm(
                                "{% trans %}Supprimer la conversation ?{% endtrans %}",
                                "{% trans %}Cette action masquera ou supprimera cette conversation selon votre logique serveur.{% endtrans %}"
                            );

                            if (!ok) return false;
                        }

                        const data = await conversationAction(conversationId, action, payload);

                        if (action === 'deleteConversation') {
                            qs(`molToast-${conversationId}`)?.remove();
                            document.querySelector(`.mol-chat-item[data-id="${conversationId}"]`)?.remove();

                            if (CHAT.currentMobileConversationId === Number(conversationId)) {
                                closeConversationMobile();
                            }

                            notify('success', "{% trans %}Conversation supprimée{% endtrans %}");
                        }

                        if (action === 'markUnread') {
                            const item = document.querySelector(`.mol-chat-item[data-id="${conversationId}"]`);

                            if (item && !item.querySelector('.mol-unread')) {
                                const badgeWrap = item.querySelector('.d-flex.flex-column.align-items-end') || item;
                                badgeWrap.insertAdjacentHTML('beforeend', `<span class="mol-unread">1</span>`);
                            }

                            notify('success', "{% trans %}Conversation marquée comme non lue{% endtrans %}");
                        }

                        if (action === 'mute') {
                            localStorage.setItem(`mol_chat_muted_${conversationId}`, '1');
                            notify('success', "{% trans %}Conversation mise en sourdine{% endtrans %}");
                        }

                        if (action === 'archive') {
                            qs(`molToast-${conversationId}`)?.remove();
                            document.querySelector(`.mol-chat-item[data-id="${conversationId}"]`)?.style.setProperty('display', 'none', 'important');

                            if (CHAT.currentMobileConversationId === Number(conversationId)) {
                                closeConversationMobile();
                            }

                            notify('success', "{% trans %}Conversation archivée{% endtrans %}");
                        }

                        if (action === 'report') {
                            notify('success', "{% trans %}Signalement envoyé{% endtrans %}");
                        }

                        if (!data?.localOnly && !['deleteConversation', 'archive'].includes(action)) {
                            await refreshConversationEverywhere(conversationId);
                            await refreshList(qs('molChatSearch')?.value?.trim() || '');
                        }

                        if (data?.message) {
                            notify('success', data.message);
                        }

                        return false;
                    } catch (e) {
                        console.error(e);

                        notify(
                            'error',
                            "{% trans %}Action impossible{% endtrans %}",
                            e.message || "{% trans %}Une erreur est survenue.{% endtrans %}"
                        );

                        return false;
                    }
                }

                function playPopSound() {
                    try {
                        const ctx = new (window.AudioContext || window.webkitAudioContext)();
                        const o = ctx.createOscillator();
                        const g = ctx.createGain();
                        o.type = 'sine';
                        o.frequency.value = 880;
                        g.gain.value = 0.03;
                        o.connect(g);
                        g.connect(ctx.destination);
                        o.start();
                        setTimeout(() => {
                            o.stop();
                            ctx.close();
                        }, 60);
                    } catch (_) {}
                }

                function vibrate() {
                    if ('vibrate' in navigator) {
                        navigator.vibrate([20, 30, 20]);
                    }
                }

                function onNewMessage(conversationId, { playSound = false, useVibrate = false } = {}) {
                    window.MolMessageSounds?.playSelected();
                    if (playSound) playPopSound();
                    if (useVibrate) vibrate();

                    const toast = qs(`molToast-${conversationId}`);
                    if (toast) {
                        toast.style.animation = 'none';
                        void toast.offsetHeight;
                        toast.style.animation = 'molPulse .25s ease-out';
                    }
                }

                async function heartbeat() {
                    const url = "{{ path('presence_heartbeat') }}";
                    try {
                        await fetch(url, {
                            method: 'POST',
                            credentials: 'same-origin',
                            keepalive: true,
                            cache: 'no-store',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'Cache-Control': 'no-cache'
                            }
                        });
                    } catch (_) {}
                }

                function goOffline() {
                    const url = "{{ path('presence_offline') }}";
                    try {
                        if (navigator.sendBeacon) {
                            navigator.sendBeacon(url, new URLSearchParams());
                            return;
                        }
                    } catch (_) {}

                    fetch(url, {
                        method: 'POST',
                        credentials: 'same-origin',
                        keepalive: true,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    }).catch(() => {});
                }

                function updateLayoutVars() {
                    const vv = window.visualViewport;
                    const vh = vv ? vv.height : window.innerHeight;
                    document.documentElement.style.setProperty('--mol-chat-vh', `${vh}px`);

                    const topbar = document.querySelector('.mol-topbar');
                    const h = topbar ? Math.ceil(topbar.getBoundingClientRect().height) : 0;
                    document.documentElement.style.setProperty('--mol-topbar-h', `${h}px`);

                    const mobileMsgs = qs('molChatThreadMsgs');
                    if (mobileMsgs) mobileMsgs.scrollTop = mobileMsgs.scrollHeight;
                    document.querySelectorAll('[id^="molToastMsgs-"]').forEach(el => el.scrollTop = el.scrollHeight);
                }

                function filterRenderedConversations(query) {
                    const list = qs('molChatList');
                    if (!list) return;

                    const items = [...list.querySelectorAll('.mol-chat-item')];
                    if (!items.length) return;

                    const q = String(query || '').trim().toLowerCase();
                    let visibleCount = 0;

                    items.forEach((item) => {
                        const name = String(item.dataset.name || '').toLowerCase();
                        const text = String(item.textContent || '').toLowerCase();
                        const match = !q || name.includes(q) || text.includes(q);

                        item.style.display = match ? '' : 'none';
                        if (match) visibleCount++;
                    });

                    let emptyState = qs('molChatSearchEmptyState');

                    if (!visibleCount) {
                        if (!emptyState) {
                            emptyState = document.createElement('li');
                            emptyState.id = 'molChatSearchEmptyState';
                            emptyState.className = 'text-secondary small py-3';
                            emptyState.textContent = 'Aucune conversation trouvée.';
                            list.appendChild(emptyState);
                        }
                    } else if (emptyState) {
                        emptyState.remove();
                    }
                }

                function bindSearchInput() {
                    const input = qs('molChatSearch');
                    if (!input || input.__molBound) return;
                    input.__molBound = true;

                    const serverSearch = debounce(async () => {
                        try {
                            await refreshList(input.value.trim());
                            filterRenderedConversations(input.value.trim());
                        } catch (e) {
                            console.error('search error', e);
                        }
                    }, 250);

                    input.addEventListener('input', () => {
                        const q = input.value.trim();

                        /* filtre immédiat sur ce qui est déjà affiché */
                        filterRenderedConversations(q);

                        /* puis sync serveur */
                        serverSearch();
                    });

                    input.addEventListener('search', () => {
                        const q = input.value.trim();
                        filterRenderedConversations(q);
                        serverSearch();
                    });
                }

                function bindConversationClick() {
                    if (document.body.__molConvBound) return;
                    document.body.__molConvBound = true;

                    document.addEventListener('click', async (e) => {
                        const item = e.target.closest('.mol-chat-item');
                        if (!item) return;

                        e.preventDefault();

                        const conv = {
                            id: Number(item.dataset.id || 0),
                            name: item.dataset.name || 'Conversation',
                            avatar: item.dataset.avatar || '',
                            online: item.dataset.online === '1',
                            presence: item.dataset.presence || 'offline'
                        };

                        if (isMobileChat()) {
                            await openConversationMobile(conv);
                        } else {
                            await openBubble(conv);
                        }
                    });
                }

                function initFriendButtons() {
                    if (!window.MOL_FRIEND) return;

                    async function ajaxJson(url, options = {}) {
                        const res = await fetch(url, {
                            ...options,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                ...(options.headers || {}),
                            },
                        });

                        if (res.redirected) {
                            window.location.href = res.url;
                            return null;
                        }

                        if (!res.ok) {
                            const text = await res.text().catch(() => '');
                            throw new Error(`HTTP ${res.status} ${text}`);
                        }

                        const ct = res.headers.get('content-type') || '';
                        return ct.includes('application/json') ? await res.json() : {};
                    }

                    function tplUrl(tpl, id) {
                        id = String(id || '').trim();

                        if (!/^\d+$/.test(id)) {
                            throw new Error('ID utilisateur invalide : ' + id);
                        }

                        return String(tpl)
                            .replace('__ID__', encodeURIComponent(id))
                            .replace(/\/0\b/, '/' + encodeURIComponent(id));
                    }

                    function setBtnLoading(btn, loading) {
                        btn.disabled = loading;
                        btn.classList.toggle('disabled', !!loading);
                        btn.dataset.loading = loading ? '1' : '0';
                    }

                    function updateFriendButton(btn, state, friendshipId) {
                        btn.classList.remove('btn-primary', 'btn-danger', 'btn-secondary', 'btn-light');
                        btn.disabled = false;

                        if (friendshipId) btn.dataset.friendshipId = String(friendshipId);
                        else delete btn.dataset.friendshipId;

                        const labelEl = btn.querySelector('.label');
                        if (!labelEl) return;

                        btn.onclick = null;

                        switch (state) {
                            case 'none':
                                btn.classList.add('btn-primary');
                                labelEl.innerText = "Demande d’amitié";
                                btn.onclick = () => sendFriendRequest(btn);
                                break;
                            case 'pending_sent':
                                btn.classList.add('btn-danger');
                                labelEl.innerText = "Annuler la demande";
                                btn.onclick = () => cancelFriendRequest(btn);
                                break;
                            case 'pending_received':
                                btn.classList.add('btn-secondary');
                                labelEl.innerText = "Répondre à la demande";
                                btn.onclick = () => promptAcceptReject(btn);
                                break;
                            case 'friends':
                                btn.classList.add('btn-danger');
                                labelEl.innerText = "Bloquer";
                                btn.onclick = () => confirmBlock(btn);
                                break;
                            case 'blocked':
                                btn.classList.add('btn-secondary');
                                btn.disabled = true;
                                labelEl.innerText = "Vous ne pouvez pas demander l’amitié";
                                break;
                            default:
                                btn.classList.add('btn-primary');
                                labelEl.innerText = "Demande d’amitié";
                                btn.onclick = () => sendFriendRequest(btn);
                        }
                    }

                    async function loadState(btn) {
                        const userId = btn.dataset.user;
                        const url = tplUrl(window.MOL_FRIEND.stateUrlTpl, userId);

                        try {
                            setBtnLoading(btn, true);
                            const data = await ajaxJson(url);
                            updateFriendButton(btn, data.state || 'none', data.friendshipId || null);
                        } catch (e) {
                            console.error(e);
                            updateFriendButton(btn, 'none', null);
                        } finally {
                            setBtnLoading(btn, false);
                        }
                    }

                    async function sendFriendRequest(btn) {
                        const userId = btn.dataset.user;
                        try {
                            await ajaxJson(tplUrl(window.MOL_FRIEND.requestUrlTpl, userId), { method: 'POST' });
                            await loadState(btn);
                        } catch (e) {
                            console.error(e);
                            notify('error', 'Erreur', "Impossible d'envoyer la demande.");
                        }
                    }

                    async function cancelFriendRequest(btn) {
                        const userId = btn.dataset.user;
                        const ok = await askConfirm('Annuler la demande ?', "La demande d’amitié sera supprimée.");
                        if (!ok) return;

                        try {
                            await ajaxJson(tplUrl(window.MOL_FRIEND.cancelUrlTpl, userId), { method: 'POST' });
                            await loadState(btn);
                        } catch (e) {
                            console.error(e);
                            notify('error', 'Erreur', "Impossible d'annuler la demande.");
                        }
                    }

                    async function blockUser(btn) {
                        const userId = btn.dataset.user;
                        await ajaxJson(tplUrl(window.MOL_FRIEND.blockUrlTpl, userId), { method: 'POST' });
                        await loadState(btn);
                    }

                    async function confirmBlock(btn) {
                        const ok = await askConfirm('Bloquer cet utilisateur ?', "Vous ne recevrez plus de demandes ni de messages de sa part.");
                        if (ok) await blockUser(btn);
                    }

                    async function acceptFriendship(btn, friendshipId) {
                        await ajaxJson(tplUrl(window.MOL_FRIEND.acceptUrlTpl, friendshipId), { method: 'POST' });
                        await loadState(btn);
                    }

                    async function rejectFriendship(btn, friendshipId) {
                        await ajaxJson(tplUrl(window.MOL_FRIEND.rejectUrlTpl, friendshipId), { method: 'POST' });
                        await loadState(btn);
                    }

                    async function promptAcceptReject(btn) {
                        const friendshipId = btn.dataset.friendshipId;
                        if (!friendshipId) return;

                        if (window.Swal) {
                            const r = await Swal.fire({
                                icon: 'question',
                                title: 'Demande d’amitié',
                                text: 'Voulez-vous accepter cette demande ?',
                                showDenyButton: true,
                                showCancelButton: true,
                                confirmButtonText: 'Accepter',
                                denyButtonText: 'Refuser',
                                cancelButtonText: 'Plus tard',
                                confirmButtonColor: '#2563eb'
                            });

                            if (r.isConfirmed) await acceptFriendship(btn, friendshipId);
                            else if (r.isDenied) await rejectFriendship(btn, friendshipId);
                            return;
                        }

                        const ok = confirm('Accepter cette demande ?');
                        if (ok) await acceptFriendship(btn, friendshipId);
                    }

                    document.querySelectorAll('.mol-friend-btn').forEach(loadState);
                }

