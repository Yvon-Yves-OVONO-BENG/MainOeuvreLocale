        <script id="mol-chat-minimize-final-fix">
            (() => {
                if (window.__MOL_CHAT_MINIMIZE_FINAL_FIX__) return;
                window.__MOL_CHAT_MINIMIZE_FINAL_FIX__ = true;

                function getToastFromMinimizeButton(btn) {
                    return btn?.closest?.('#molChatToasts .toast, #molChatToasts .mol-chat-toast') || null;
                }

                function getMinimizeButton(target) {
                    return target.closest(
                        '#molChatToasts a[href^="#molToastBody-"], ' +
                        '#molChatToasts [data-bs-toggle="collapse"], ' +
                        '#molChatToasts [data-mol-role="minimize"]'
                    );
                }

                function setMinimizeIcon(btn, minimized) {
                    const icon = btn?.querySelector?.('i');
                    if (!icon) return;

                    icon.classList.remove('bi-dash-lg', 'bi-plus-lg');
                    icon.classList.add(minimized ? 'bi-plus-lg' : 'bi-dash-lg');
                }

                function minimizeToast(toast, btn) {
                    if (!toast) return;

                    const body = toast.querySelector('.toast-body');
                    const minimized = !toast.classList.contains('mol-toast-mini');

                    toast.classList.toggle('mol-toast-mini', minimized);

                    if (body) {
                        body.classList.toggle('show', !minimized);
                        body.classList.toggle('collapse', false);

                        if (minimized) {
                            body.style.setProperty('display', 'none', 'important');
                            body.setAttribute('aria-hidden', 'true');
                        } else {
                            body.style.removeProperty('display');
                            body.removeAttribute('aria-hidden');
                        }
                    }

                    setMinimizeIcon(btn, minimized);

                    try {
                        if (typeof window.dispatchEvent === 'function') {
                            window.dispatchEvent(new Event('resize'));
                        }
                    } catch (_) {}
                }

                document.addEventListener('click', (e) => {
                    const btn = getMinimizeButton(e.target);
                    if (!btn) return;

                    const toast = getToastFromMinimizeButton(btn);
                    if (!toast) return;

                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();

                    btn.removeAttribute('data-bs-toggle');
                    btn.removeAttribute('data-bs-target');
                    btn.setAttribute('href', '#');
                    btn.setAttribute('data-mol-role', 'minimize');

                    minimizeToast(toast, btn);
                }, true);

                document.querySelectorAll('#molChatToasts .toast, #molChatToasts .mol-chat-toast').forEach((toast) => {
                    const btn =
                        toast.querySelector('a[href^="#molToastBody-"]') ||
                        toast.querySelector('[data-bs-toggle="collapse"]') ||
                        toast.querySelector('[data-mol-role="minimize"]');

                    if (!btn) return;

                    btn.removeAttribute('data-bs-toggle');
                    btn.removeAttribute('data-bs-target');
                    btn.setAttribute('href', '#');
                    btn.setAttribute('data-mol-role', 'minimize');
                    setMinimizeIcon(btn, toast.classList.contains('mol-toast-mini'));
                });
            })();
        </script>

        <script id="mol-chat-live-search-filter">
            (() => {
                if (window.__MOL_CHAT_LIVE_SEARCH_FILTER__) return;
                window.__MOL_CHAT_LIVE_SEARCH_FILTER__ = true;

                function qs(id) {
                    return document.getElementById(id);
                }

                function normalizeText(value) {
                    return String(value || '')
                        .toLowerCase()
                        .normalize('NFD')
                        .replace(/[\u0300-\u036f]/g, '')
                        .trim();
                }

                function getConversationSearchText(item) {
                    if (!item) return '';

                    const parts = [
                        item.dataset.name,
                        item.dataset.presence,
                        item.textContent
                    ];

                    return normalizeText(parts.filter(Boolean).join(' '));
                }

                function ensureEmptyState(list) {
                    let empty = qs('molChatSearchEmptyState');

                    if (!empty) {
                        empty = document.createElement('li');
                        empty.id = 'molChatSearchEmptyState';
                        empty.className = 'text-secondary small py-3 text-center';
                        empty.textContent = 'Aucune conversation trouvée.';
                        list.appendChild(empty);
                    }

                    return empty;
                }

                function removeEmptyState() {
                    qs('molChatSearchEmptyState')?.remove();
                }

                function filterChatConversations() {
                    const input = qs('molChatSearch');
                    const list = qs('molChatList');

                    if (!input || !list) return;

                    const query = normalizeText(input.value);
                    const items = Array.from(list.querySelectorAll('.mol-chat-item'));

                    if (!items.length) {
                        removeEmptyState();
                        return;
                    }

                    let visibleCount = 0;

                    items.forEach((item) => {
                        const searchableText = getConversationSearchText(item);
                        const isVisible = !query || searchableText.includes(query);

                        item.style.display = isVisible ? '' : 'none';

                        if (isVisible) {
                            visibleCount++;
                        }
                    });

                    const empty = ensureEmptyState(list);
                    empty.style.display = visibleCount === 0 ? '' : 'none';
                }

                function bindLiveSearch() {
                    const input = qs('molChatSearch');

                    if (!input || input.__molLiveSearchReady) return;

                    input.__molLiveSearchReady = true;

                    input.setAttribute('autocomplete', 'off');

                    input.addEventListener('input', filterChatConversations);
                    input.addEventListener('keyup', filterChatConversations);
                    input.addEventListener('search', filterChatConversations);
                    input.addEventListener('paste', () => {
                        setTimeout(filterChatConversations, 0);
                    });

                    filterChatConversations();
                }

                function observeConversationList() {
                    const list = qs('molChatList');

                    if (!list || list.__molLiveSearchObserved || !window.MutationObserver) return;

                    list.__molLiveSearchObserved = true;

                    new MutationObserver(() => {
                        filterChatConversations();
                    }).observe(list, {
                        childList: true,
                        subtree: true
                    });
                }

                function patchChatRender() {
                    if (typeof window.MOLChatRenderConversations === 'function' && !window.MOLChatRenderConversations.__molLiveSearchPatched) {
                        const oldRender = window.MOLChatRenderConversations;

                        const wrapped = function(...args) {
                            const result = oldRender.apply(this, args);

                            setTimeout(() => {
                                bindLiveSearch();
                                observeConversationList();
                                filterChatConversations();
                            }, 0);

                            return result;
                        };

                        wrapped.__molLiveSearchPatched = true;
                        window.MOLChatRenderConversations = wrapped;
                    }

                    if (typeof window.MOLChatRefreshList === 'function' && !window.MOLChatRefreshList.__molLiveSearchPatched) {
                        const oldRefresh = window.MOLChatRefreshList;

                        const wrapped = async function(...args) {
                            const result = await oldRefresh.apply(this, args);

                            setTimeout(() => {
                                bindLiveSearch();
                                observeConversationList();
                                filterChatConversations();
                            }, 0);

                            return result;
                        };

                        wrapped.__molLiveSearchPatched = true;
                        window.MOLChatRefreshList = wrapped;
                    }
                }

                function bootLiveSearch() {
                    bindLiveSearch();
                    observeConversationList();
                    patchChatRender();
                    filterChatConversations();
                }

                document.addEventListener('DOMContentLoaded', bootLiveSearch);
                document.addEventListener('turbo:load', bootLiveSearch);

                if (document.readyState !== 'loading') {
                    bootLiveSearch();
                }
            })();
        </script>


