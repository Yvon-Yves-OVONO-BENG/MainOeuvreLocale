{# templates/subscription/success.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Abonnement réussi !{% endblock %}

{% block body %}
<div class="success-page">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-lg-6 col-md-8 col-11">
                <div class="success-card">
                    <!-- Décoration de fond -->
                    <div class="card-decoration">
                        <div class="circle circle-1"></div>
                        <div class="circle circle-2"></div>
                        <div class="circle circle-3"></div>
                    </div>

                    <div class="card-body text-center position-relative">
                        <!-- Badge Premium -->
                        <div class="premium-badge">
                            <i class="fas fa-crown"></i>
                            <span>Abonnement actif</span>
                        </div>

                        <!-- Icône de succès avec animation -->
                        <div class="success-icon-wrapper">
                            <div class="success-ring">
                                <div class="success-ring-inner">
                                    <i class="fas fa-check-circle"></i>
                                </div>
                            </div>
                            <div class="success-pulse"></div>
                            <div class="success-pulse-2"></div>
                        </div>

                        <h2 class="success-title">
                            🎉 Abonnement réussi !
                        </h2>
                        
                        <p class="success-text">
                            Votre abonnement a été activé avec succès. 
                            Vous avez maintenant accès à toutes les fonctionnalités premium.
                        </p>

                        <!-- Confetti animés -->
                        <div class="confetti-container">
                            <div class="confetti confetti-1"></div>
                            <div class="confetti confetti-2"></div>
                            <div class="confetti confetti-3"></div>
                            <div class="confetti confetti-4"></div>
                            <div class="confetti confetti-5"></div>
                            <div class="confetti confetti-6"></div>
                        </div>

                        <!-- Bouton avec spinner -->
                        <div class="success-actions">
                            <a href="{{ path('tableau_de_bord') }}" 
                               class="btn btn-primary btn-lg success-btn"
                               data-loading-text="<i class='fas fa-spinner fa-spin me-2'></i> Chargement...">
                                <i class="fas fa-arrow-right me-2"></i> 
                                Accéder au tableau de bord
                            </a>
                        </div>

                        <!-- Informations supplémentaires -->
                        <div class="success-footer">
                            <p class="text-muted small">
                                <i class="fas fa-envelope me-1"></i>
                                Un email de confirmation vous a été envoyé.
                            </p>
                            <p class="text-muted small">
                                <i class="fas fa-headset me-1"></i>
                                Besoin d'aide ? 
                                <a href="#" class="text-primary">Contactez-nous</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* ============================================
   PAGE DE SUCCÈS PREMIUM
   ============================================ */

.success-page {
    min-height: 100vh;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    position: relative;
    overflow: hidden;
}

/* Fond animé */
.success-page::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at 30% 50%, rgba(16, 185, 129, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 70% 80%, rgba(37, 99, 235, 0.06) 0%, transparent 50%);
    animation: bgFloat 20s ease-in-out infinite;
    pointer-events: none;
}

@keyframes bgFloat {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    33% { transform: translate(2%, -2%) rotate(2deg); }
    66% { transform: translate(-2%, 2%) rotate(-2deg); }
}

/* ============================================
   CARTE DE SUCCÈS
   ============================================ */

.success-card {
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 28px;
    padding: 0;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35),
                0 0 0 1px rgba(255, 255, 255, 0.05) inset;
    position: relative;
    overflow: hidden;
    animation: cardSlideUp 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    transform: translateY(40px);
    opacity: 0;
}

@keyframes cardSlideUp {
    to {
        transform: translateY(0);
        opacity: 1;
    }
}

.success-card .card-body {
    padding: 40px 32px 32px;
    position: relative;
    z-index: 2;
}

/* ============================================
   DÉCORATION DE FOND
   ============================================ */

.card-decoration {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    overflow: hidden;
}

.card-decoration .circle {
    position: absolute;
    border-radius: 50%;
    opacity: 0.05;
}

.card-decoration .circle-1 {
    width: 300px;
    height: 300px;
    top: -150px;
    right: -150px;
    background: linear-gradient(135deg, #10b981, #059669);
    animation: floatCircle 8s ease-in-out infinite;
}

.card-decoration .circle-2 {
    width: 200px;
    height: 200px;
    bottom: -100px;
    left: -100px;
    background: linear-gradient(135deg, #2563eb, #4f46e5);
    animation: floatCircle 10s ease-in-out infinite reverse;
}

.card-decoration .circle-3 {
    width: 120px;
    height: 120px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: linear-gradient(135deg, #8b5cf6, #6366f1);
    animation: floatCircle 12s ease-in-out infinite;
}

@keyframes floatCircle {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(20px, -20px) scale(1.1); }
}

/* ============================================
   BADGE PREMIUM
   ============================================ */

.premium-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: linear-gradient(135deg, #10b981, #059669);
    border-radius: 999px;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: 0 4px 15px rgba(16, 185, 129, 0.35);
    margin-bottom: 20px;
    animation: badgePulse 3s ease-in-out infinite;
}

@keyframes badgePulse {
    0%, 100% { box-shadow: 0 4px 15px rgba(16, 185, 129, 0.35); }
    50% { box-shadow: 0 4px 30px rgba(16, 185, 129, 0.55); }
}

/* ============================================
   ICÔNE DE SUCCÈS ANIMÉE
   ============================================ */

.success-icon-wrapper {
    position: relative;
    display: inline-block;
    margin-bottom: 24px;
}

.success-ring {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    padding: 4px;
    background: linear-gradient(135deg, #10b981, #34d399, #059669);
    animation: spinRing 6s linear infinite;
    display: flex;
    align-items: center;
    justify-content: center;
}

@keyframes spinRing {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.success-ring-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 56px;
    color: #10b981;
}

.success-ring-inner i {
    animation: successPop 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes successPop {
    0% { transform: scale(0); opacity: 0; }
    50% { transform: scale(1.3); }
    100% { transform: scale(1); opacity: 1; }
}

/* Pulsations */
.success-pulse {
    position: absolute;
    top: -10px;
    left: -10px;
    right: -10px;
    bottom: -10px;
    border-radius: 50%;
    border: 2px solid rgba(16, 185, 129, 0.2);
    animation: pulseRing 2s ease-in-out infinite;
}

.success-pulse-2 {
    position: absolute;
    top: -22px;
    left: -22px;
    right: -22px;
    bottom: -22px;
    border-radius: 50%;
    border: 2px solid rgba(16, 185, 129, 0.1);
    animation: pulseRing 2s ease-in-out infinite 0.5s;
}

@keyframes pulseRing {
    0% { transform: scale(0.95); opacity: 1; }
    100% { transform: scale(1.2); opacity: 0; }
}

/* ============================================
   TITRE ET TEXTE
   ============================================ */

.success-title {
    font-size: 28px;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 8px;
    letter-spacing: -0.02em;
}

.success-text {
    font-size: 15px;
    color: #64748b;
    line-height: 1.6;
    margin: 0 0 24px;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
}

/* ============================================
   CONFETTI ANIMÉS
   ============================================ */

.confetti-container {
    position: relative;
    height: 40px;
    margin: 8px 0 16px;
    pointer-events: none;
}

.confetti {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    animation: confettiFall 3s ease-in-out infinite;
}

.confetti-1 {
    left: 10%;
    background: #ef4444;
    animation-delay: 0s;
}

.confetti-2 {
    left: 25%;
    background: #f59e0b;
    animation-delay: 0.5s;
}

.confetti-3 {
    left: 40%;
    background: #10b981;
    animation-delay: 1s;
}

.confetti-4 {
    left: 55%;
    background: #3b82f6;
    animation-delay: 1.5s;
}

.confetti-5 {
    left: 70%;
    background: #8b5cf6;
    animation-delay: 2s;
}

.confetti-6 {
    left: 85%;
    background: #ec4899;
    animation-delay: 2.5s;
}

@keyframes confettiFall {
    0% { transform: translateY(-20px) rotate(0deg) scale(0); opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { transform: translateY(40px) rotate(720deg) scale(1); opacity: 0; }
}

/* ============================================
   BOUTON AVEC SPINNER
   ============================================ */

.success-actions {
    margin-top: 8px;
}

.success-btn {
    border-radius: 16px;
    padding: 14px 32px;
    font-weight: 700;
    font-size: 16px;
    transition: all 0.3s ease;
    box-shadow: 0 8px 30px rgba(37, 99, 235, 0.25);
    min-width: 240px;
}

.success-btn:hover:not(.loading) {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 12px 40px rgba(37, 99, 235, 0.35);
}

.success-btn.loading {
    pointer-events: none !important;
    opacity: 0.85 !important;
    cursor: wait !important;
}

.success-btn.loading i:not(.fa-spinner) {
    display: none !important;
}

/* ============================================
   FOOTER
   ============================================ */

.success-footer {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid #f1f5f9;
}

.success-footer p {
    margin: 4px 0;
    font-size: 13px;
    color: #94a3b8;
}

.success-footer a {
    text-decoration: none;
    font-weight: 600;
}

/* ============================================
   RESPONSIVE
   ============================================ */

@media (max-width: 768px) {
    .success-card .card-body {
        padding: 28px 20px 24px;
    }
    
    .success-ring {
        width: 96px;
        height: 96px;
    }
    
    .success-ring-inner {
        font-size: 44px;
    }
    
    .success-title {
        font-size: 22px;
    }
    
    .success-text {
        font-size: 14px;
    }
    
    .success-btn {
        padding: 12px 24px;
        font-size: 14px;
        min-width: auto;
        width: 100%;
    }
    
    .confetti-container {
        height: 30px;
    }
    
    .premium-badge {
        font-size: 10px;
        padding: 6px 12px;
    }
}

@media (max-width: 576px) {
    .success-card {
        border-radius: 20px;
    }
    
    .success-card .card-body {
        padding: 24px 16px 20px;
    }
    
    .success-ring {
        width: 80px;
        height: 80px;
    }
    
    .success-ring-inner {
        font-size: 38px;
    }
    
    .success-title {
        font-size: 19px;
    }
    
    .success-text {
        font-size: 13px;
    }
}
</style>

{# ✅ JavaScript pour le spinner #}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const btn = document.querySelector('.success-btn');
    
    if (btn) {
        btn.addEventListener('click', function(e) {
            // Ne pas ajouter de spinner si déjà en chargement
            if (this.classList.contains('loading')) {
                e.preventDefault();
                return;
            }
            
            // Sauvegarder l'URL
            const href = this.href;
            const loadingText = this.dataset.loadingText || 
                               '<i class="fas fa-spinner fa-spin me-2"></i> Chargement...';
            
            // Ajouter la classe loading
            this.classList.add('loading');
            
            // Remplacer le contenu par le spinner
            this.innerHTML = loadingText;
            
            // Rediriger après un court délai pour montrer le spinner
            setTimeout(function() {
                window.location.href = href;
            }, 300);
        });
    }
});
</script>
{% endblock %}