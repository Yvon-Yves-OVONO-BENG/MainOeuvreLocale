{# templates/subscription/plans.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{% trans %}Nos plans d'abonnement | Main-d'œuvre locale{% endtrans %}{% endblock %}

{% block body %}
<section class="subscription-plans">
    <div class="container">
        {# En-tête amélioré #}
        <div class="text-center mb-5">
            <span class="badge bg-primary bg-opacity-10 text-primary px-4 py-2 rounded-pill mb-3">
                <i class="fas fa-crown me-2"></i> Plans d'abonnement
            </span>
            <h1 class="display-4 fw-bold mb-3">Choisissez votre abonnement</h1>
            <p class="text-muted lead">Des solutions adaptées à tous les besoins</p>
            
            {# Affichage du pays détecté avec style amélioré #}
            {% if user_currency != 'XOF' %}
            <div class="currency-badge">
                <i class="fas fa-globe-europe me-2"></i>
                Prix convertis en {{ currency_symbol }} 
                <span class="badge bg-info ms-2">Depuis FCFA</span>
            </div>
            {% endif %}
        </div>

        <div class="row g-4 justify-content-center">
            {% for plan in plans %}
                {% set meta = {
                    'decouverte': {
                        'icon': 'fa-seedling',
                        'color': '#10b981',
                        'bgColor': 'rgba(16,185,129,0.08)',
                        'badge': 'Gratuit',
                        'badgeIcon': 'fa-gift',
                        'btnClass': 'btn-outline-success',
                        'btnText': 'Commencer gratuitement',
                        'btnIcon': 'fa-user-plus',
                        'featured': false,
                        'borderColor': '#10b981',
                        'btnAction': 'app_register'
                    },
                    'pro': {
                        'icon': 'fa-rocket',
                        'color': '#3b82f6',
                        'bgColor': 'rgba(59,130,246,0.08)',
                        'badge': 'Populaire',
                        'badgeIcon': 'fa-fire',
                        'btnClass': 'btn-primary',
                        'btnText': 'Choisir Pro',
                        'btnIcon': 'fa-arrow-right',
                        'featured': true,
                        'borderColor': '#3b82f6',
                        'btnAction': 'subscription_choose'
                    },
                    'premium': {
                        'icon': 'fa-crown',
                        'color': '#f59e0b',
                        'bgColor': 'rgba(245,158,11,0.08)',
                        'badge': 'Premium',
                        'badgeIcon': 'fa-star',
                        'btnClass': 'btn-warning',
                        'btnText': 'Passer Premium',
                        'btnIcon': 'fa-bolt',
                        'featured': false,
                        'borderColor': '#f59e0b',
                        'btnAction': 'subscription_choose'
                    }
                } %}

                {% set planMeta = meta[plan.slug] ?? {
                    'icon': 'fa-circle',
                    'color': '#64748b',
                    'bgColor': 'rgba(100,116,139,0.08)',
                    'badge': plan.name,
                    'badgeIcon': 'fa-tag',
                    'btnClass': 'btn-outline-secondary',
                    'btnText': 'Choisir',
                    'btnIcon': 'fa-arrow-right',
                    'featured': false,
                    'borderColor': '#64748b',
                    'btnAction': 'subscription_choose'
                } %}

                <div class="col-md-6 col-lg-4">
                    <div class="plan-card {% if planMeta.featured %}plan-featured{% endif %} {% if currentPlan and currentPlan.id == plan.id %}plan-active{% endif %}">
                        
                        {# Badge du plan #}
                        {% if planMeta.featured %}
                            <div class="plan-popular-badge">
                                <i class="fas fa-fire me-1"></i> {{ planMeta.badge }}
                            </div>
                        {% elseif plan.slug == 'premium' %}
                            <div class="plan-premium-badge">
                                <i class="fas fa-star me-1"></i> Premium
                            </div>
                        {% endif %}
                        
                        {# En-tête de la carte #}
                        <div class="plan-header">
                            <div class="plan-icon" style="background: {{ planMeta.bgColor }}; color: {{ planMeta.color }};">
                                <i class="fas {{ planMeta.icon }}"></i>
                            </div>
                            <h3 class="plan-name">{{ plan.name }}</h3>
                            <p class="plan-description">{{ plan.description }}</p>
                        </div>

                        {# Sélecteur de durée pour plans payants #}
                        {% if plan.price > 0 %}
                            <div class="duration-selector-wrapper">
                                <label class="duration-label">
                                    <i class="far fa-clock me-1"></i> Durée
                                </label>
                                <select class="form-select duration-select" data-plan-id="{{ plan.id }}">
                                    {% for duration in plan.durations %}
                                        <option value="{{ duration.id }}" 
                                                data-price="{{ currency_converter.formatPrice(duration.price) }}"
                                                data-price-fcfa="{{ duration.price }}">
                                            {{ duration.label }}
                                            {% if duration.discount > 0 %}
                                                <span class="discount-badge">-{{ duration.discount }}%</span>
                                            {% endif %}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% endif %}

                        {# Affichage du prix #}
                        <div class="plan-price" id="price-display-{{ plan.id }}">
                            {% if plan.price > 0 %}
                                <div class="price-main">
                                    <span class="amount">{{ currency_converter.formatPrice(plan.durations|first.price) }}</span>
                                </div>
                                {% if user_currency != 'XOF' %}
                                    <div class="price-fcfa">
                                        ≈ {{ plan.durations|first.price|number_format(0, ',', ' ') }} FCFA
                                    </div>
                                {% endif %}
                            {% else %}
                                <div class="price-free">
                                    <span class="amount">Gratuit</span>
                                    <div class="price-period">Pour toujours</div>
                                </div>
                            {% endif %}
                        </div>

                        {# Liste des fonctionnalités #}
                        <div class="plan-features-wrapper">
                            <ul class="plan-features">
                                {% for feature in plan.features %}
                                    <li>
                                        <i class="fas fa-check-circle" style="color: {{ planMeta.color }};"></i>
                                        <span>{{ feature }}</span>
                                    </li>
                                {% endfor %}
                                {% if plan.canVideoCall %}
                                    <li>
                                        <i class="fas fa-video" style="color: {{ planMeta.color }};"></i>
                                        <span>Appels vidéo illimités</span>
                                    </li>
                                {% endif %}
                            </ul>
                        </div>

                        {# Bouton d'action #}
                        <div class="plan-action">
                            {% if currentPlan and currentPlan.id == plan.id %}
                                <button class="btn btn-current-plan" disabled>
                                    <i class="fas fa-check-circle me-2"></i> Plan actif
                                </button>
                            {% elseif plan.slug == 'decouverte' %}
                                <a href="{{ path('app_register') }}" 
                                   class="btn {{ planMeta.btnClass }} plan-btn" 
                                   data-turbo="false"
                                   data-loading-text="<i class='fas fa-spinner fa-spin me-2'></i> Redirection...">
                                    <i class="fas {{ planMeta.btnIcon }} me-2"></i> {{ planMeta.btnText }}
                                </a>
                            {% else %}
                                <a href="{{ path('subscription_choose', {slug: plan.slug}) }}" 
                                   class="btn {{ planMeta.btnClass }} plan-btn choose-plan-btn {% if planMeta.featured %}btn-featured{% endif %}"
                                   data-turbo="false"
                                   data-plan-slug="{{ plan.slug }}"
                                   data-duration-select=".duration-select[data-plan-id='{{ plan.id }}']"
                                   data-loading-text="<i class='fas fa-spinner fa-spin me-2'></i> Chargement...">
                                    <i class="fas {{ planMeta.btnIcon }} me-2"></i> {{ planMeta.btnText }}
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<style>
/* ========== VARIABLES ========== */
:root {
    --plan-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    --plan-shadow: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
    --plan-shadow-hover: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);
    --plan-shadow-featured: 0 20px 60px -10px rgba(59,130,246,0.3);
}

/* ========== SECTION PRINCIPALE ========== */
.subscription-plans {
    background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 50%, #f0fdf4 100%);
    min-height: 100vh;
    padding: 60px 0;
}

/* ========== BADGE DE DEVISE ========== */
.currency-badge {
    display: inline-flex;
    align-items: center;
    background: white;
    border: 1px solid #e2e8f0;
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 0.9rem;
    color: #64748b;
    box-shadow: var(--plan-shadow);
    margin-top: 15px;
}

.currency-badge .badge {
    font-size: 0.75rem;
    padding: 4px 10px;
}

/* ========== CARTE DE PLAN ========== */
.plan-card {
    background: white;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: var(--plan-shadow);
    transition: var(--plan-transition);
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    border: 1px solid #e2e8f0;
}

.plan-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--plan-shadow-hover);
}

/* Carte en vedette */
.plan-featured {
    border: 2px solid #3b82f6;
    box-shadow: var(--plan-shadow-featured);
    transform: scale(1.02);
}

.plan-featured:hover {
    transform: scale(1.02) translateY(-8px);
}

/* Carte active */
.plan-active {
    border: 2px solid #10b981;
    box-shadow: 0 10px 40px rgba(16,185,129,0.15);
}

/* ========== BADGES ========== */
.plan-popular-badge {
    position: absolute;
    top: 0;
    right: 0;
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    color: white;
    padding: 8px 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-radius: 0 20px 0 20px;
    box-shadow: 0 2px 10px rgba(59,130,246,0.3);
}

.plan-premium-badge {
    position: absolute;
    top: 0;
    right: 0;
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: white;
    padding: 8px 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-radius: 0 20px 0 20px;
    box-shadow: 0 2px 10px rgba(245,158,11,0.3);
}

/* ========== EN-TÊTE DU PLAN ========== */
.plan-header {
    padding: 32px 28px 20px;
    text-align: center;
}

.plan-icon {
    width: 70px;
    height: 70px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
    font-size: 28px;
    transition: var(--plan-transition);
}

.plan-card:hover .plan-icon {
    transform: scale(1.1) rotate(-5deg);
}

.plan-name {
    font-size: 1.5rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 8px;
}

.plan-description {
    font-size: 0.9rem;
    color: #64748b;
    line-height: 1.5;
    margin: 0;
}

/* ========== SÉLECTEUR DE DURÉE ========== */
.duration-selector-wrapper {
    padding: 0 28px 20px;
    border-bottom: 1px solid #f1f5f9;
}

.duration-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
    display: block;
}

.duration-selector-wrapper .form-select {
    border-radius: 12px;
    border: 2px solid #e2e8f0;
    padding: 12px 16px;
    font-weight: 500;
    color: #1e293b;
    background-color: #f8fafc;
    cursor: pointer;
    transition: var(--plan-transition);
    font-size: 0.9rem;
}

.duration-selector-wrapper .form-select:hover {
    border-color: #94a3b8;
    background-color: white;
}

.duration-selector-wrapper .form-select:focus {
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
    background-color: white;
}

/* ========== AFFICHAGE DU PRIX ========== */
.plan-price {
    padding: 24px 28px;
    text-align: center;
    border-bottom: 1px solid #f1f5f9;
    background: linear-gradient(135deg, #f8fafc, #f1f5f9);
}

.price-main {
    margin-bottom: 4px;
}

.plan-price .amount {
    font-size: 2.5rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1;
}

.plan-price .price-period {
    font-size: 0.85rem;
    color: #94a3b8;
    margin-top: 4px;
    font-weight: 500;
}

.price-fcfa {
    font-size: 0.8rem;
    color: #94a3b8;
    margin-top: 6px;
    font-weight: 500;
}

.price-free {
    padding: 10px 0;
}

.price-free .amount {
    font-size: 2.5rem;
    font-weight: 800;
    color: #10b981;
    line-height: 1;
}

.price-free .price-period {
    font-size: 0.85rem;
    color: #94a3b8;
    margin-top: 4px;
}

/* ========== LISTE DES FONCTIONNALITÉS ========== */
.plan-features-wrapper {
    padding: 20px 28px;
    flex: 1;
}

.plan-features {
    list-style: none;
    padding: 0;
    margin: 0;
}

.plan-features li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 0;
    font-size: 0.9rem;
    color: #475569;
    border-bottom: 1px solid #f8fafc;
    line-height: 1.4;
}

.plan-features li:last-child {
    border-bottom: none;
}

.plan-features li i {
    flex-shrink: 0;
    font-size: 1rem;
    width: 20px;
    text-align: center;
    margin-top: 2px;
}

/* ========== BOUTON D'ACTION ========== */
.plan-action {
    padding: 20px 28px 28px;
}

.plan-action .btn {
    border-radius: 14px;
    padding: 14px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: var(--plan-transition);
    width: 100%;
    position: relative;
    overflow: hidden;
}

.plan-action .btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
}

/* Bouton Featured */
.btn-featured {
    background: linear-gradient(135deg, #3b82f6, #2563eb) !important;
    border: none !important;
    color: white !important;
    box-shadow: 0 4px 15px rgba(59,130,246,0.3);
}

.btn-featured:hover {
    box-shadow: 0 8px 25px rgba(59,130,246,0.4) !important;
}

/* Bouton plan actif */
.btn-current-plan {
    background: linear-gradient(135deg, #10b981, #059669) !important;
    border: none !important;
    color: white !important;
    opacity: 0.9;
    cursor: default;
    border-radius: 14px;
    padding: 14px;
    font-weight: 600;
    font-size: 0.95rem;
    width: 100%;
}

/* ========== ÉTATS DE CHARGEMENT ========== */
.plan-btn.loading {
    pointer-events: none !important;
    opacity: 0.8 !important;
    cursor: wait !important;
}

.plan-btn.loading i:not(.fa-spinner) {
    display: none !important;
}

/* ========== RESPONSIVE ========== */
@media (max-width: 992px) {
    .subscription-plans {
        padding: 40px 0;
    }
    
    .plan-featured {
        transform: none;
    }
    
    .plan-featured:hover {
        transform: translateY(-8px);
    }
}

@media (max-width: 768px) {
    .subscription-plans {
        padding: 30px 0;
    }
    
    .plan-card {
        border-radius: 16px;
    }
    
    .plan-header {
        padding: 24px 20px 16px;
    }
    
    .plan-icon {
        width: 56px;
        height: 56px;
        font-size: 22px;
        border-radius: 14px;
    }
    
    .plan-name {
        font-size: 1.3rem;
    }
    
    .duration-selector-wrapper {
        padding: 0 20px 16px;
    }
    
    .plan-price {
        padding: 16px 20px;
    }
    
    .plan-price .amount {
        font-size: 2rem;
    }
    
    .plan-features-wrapper {
        padding: 16px 20px;
    }
    
    .plan-features li {
        font-size: 0.85rem;
        padding: 8px 0;
    }
    
    .plan-action {
        padding: 16px 20px 20px;
    }
    
    .plan-action .btn {
        padding: 12px;
        font-size: 0.9rem;
    }
}

/* ========== ANIMATIONS ========== */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.plan-card {
    animation: fadeInUp 0.6s ease-out forwards;
}

.plan-card:nth-child(2) {
    animation-delay: 0.1s;
}

.plan-card:nth-child(3) {
    animation-delay: 0.2s;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Gestion du changement de durée
    const durationSelects = document.querySelectorAll('.duration-select');
    
    durationSelects.forEach(function(select) {
        select.addEventListener('change', function() {
            const planId = this.dataset.planId;
            const selectedOption = this.options[this.selectedIndex];
            const price = selectedOption.dataset.price;
            const priceFCFA = selectedOption.dataset.priceFcfa;
            
            // Mettre à jour l'affichage du prix
            const priceDisplay = document.getElementById('price-display-' + planId);
            if (priceDisplay) {
                const amountSpan = priceDisplay.querySelector('.amount');
                const fcfaSpan = priceDisplay.querySelector('.price-fcfa');
                
                if (amountSpan) {
                    amountSpan.textContent = price;
                }
                
                // Mettre à jour le prix en FCFA si présent
                if (fcfaSpan) {
                    fcfaSpan.textContent = '≈ ' + new Intl.NumberFormat('fr-FR').format(priceFCFA) + ' FCFA';
                }
            }
            
            // Animation du prix
            if (priceDisplay) {
                priceDisplay.style.transform = 'scale(1.05)';
                setTimeout(() => {
                    priceDisplay.style.transform = 'scale(1)';
                }, 200);
            }
        });
    });
    
    // Gestion du clic sur "Choisir"
    const chooseButtons = document.querySelectorAll('.choose-plan-btn');
    
    chooseButtons.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            
            if (this.classList.contains('loading')) {
                return;
            }
            
            const planSlug = this.dataset.planSlug;
            const durationSelect = document.querySelector(this.dataset.durationSelect);
            
            if (!durationSelect) {
                window.location.href = this.getAttribute('href');
                return;
            }
            
            const selectedOption = durationSelect.options[durationSelect.selectedIndex];
            const durationId = selectedOption.value;
            
            // Ajouter le spinner
            this.classList.add('loading');
            const originalHtml = this.innerHTML;
            this.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Chargement...';
            
            // Rediriger avec la durée sélectionnée
            setTimeout(() => {
                window.location.href = this.getAttribute('href') + '?duration=' + encodeURIComponent(durationId);
            }, 300);
        });
    });
    
    // Spinner sur tous les boutons
    const buttons = document.querySelectorAll('.plan-btn');
    buttons.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            if (this.classList.contains('loading')) {
                e.preventDefault();
                return;
            }
            
            const loadingText = this.dataset.loadingText || '<i class="fas fa-spinner fa-spin me-2"></i> Chargement...';
            this.classList.add('loading');
            this.innerHTML = loadingText;
        });
    });
});
</script>
{% endblock %}