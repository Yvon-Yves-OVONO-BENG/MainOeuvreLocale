<style>
  :root{
    --ctr-bg:#f5f7ff;
    --ctr-surface:rgba(255,255,255,.84);
    --ctr-surface-strong:rgba(255,255,255,.97);
    --ctr-line:rgba(15,23,42,.08);
    --ctr-line-strong:rgba(15,23,42,.14);
    --ctr-text:#0f172a;
    --ctr-muted:rgba(15,23,42,.60);
    --ctr-primary:#4f46e5;
    --ctr-primary-2:#2563eb;
    --ctr-ok:#10b981;
    --ctr-warn:#f59e0b;
    --ctr-danger:#ef4444;
    --ctr-shadow:0 22px 80px rgba(15,23,42,.10);
    --ctr-shadow-sm:0 14px 34px rgba(15,23,42,.07);
    --ctr-r:22px;
  }

  .ctr-shell{
    min-height:100vh;
    padding:24px;
    background:
      radial-gradient(circle at top right, rgba(79,70,229,.08), transparent 24%),
      radial-gradient(circle at top left, rgba(6,182,212,.06), transparent 18%),
      linear-gradient(180deg, var(--ctr-bg), #fff 72%);
  }

  .ctr-container{max-width:1440px;margin:0 auto;}
  .ctr-grid{display:grid;gap:18px}
  .ctr-grid-3{grid-template-columns:repeat(3,minmax(0,1fr))}

  .ctr-card{
    background:var(--ctr-surface);
    backdrop-filter:blur(16px);
    border:1px solid rgba(255,255,255,.55);
    border-radius:var(--ctr-r);
    box-shadow:var(--ctr-shadow-sm);
  }

  .ctr-card-inner{padding:22px}

  .ctr-head{
    background:
      radial-gradient(circle at right top, rgba(79,70,229,.10), transparent 34%),
      linear-gradient(180deg, rgba(255,255,255,.96), rgba(255,255,255,.90));
    border:1px solid var(--ctr-line);
    box-shadow:var(--ctr-shadow);
  }

  .ctr-head-top{
    display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;
  }

  .ctr-kicker{
    display:inline-flex;align-items:center;gap:8px;
    padding:8px 12px;border-radius:999px;
    background:rgba(79,70,229,.08);color:var(--ctr-primary);
    border:1px solid rgba(79,70,229,.12);
    font-size:.72rem;font-weight:900;text-transform:uppercase;letter-spacing:.08em;
  }

  .ctr-title{
    margin:12px 0 0;
    font-size:clamp(1.35rem, 2vw, 2rem);
    line-height:1.08;font-weight:900;color:var(--ctr-text);letter-spacing:-.02em;
  }

  .ctr-text{
    margin:8px 0 0;max-width:840px;line-height:1.65;color:var(--ctr-muted);font-size:.96rem;
  }

  .ctr-nav{
    display:flex;flex-wrap:wrap;gap:10px;margin-top:18px;
  }

  .ctr-btn{
    appearance:none;border:none;display:inline-flex;align-items:center;justify-content:center;gap:8px;
    border-radius:16px;padding:12px 16px;font-weight:800;font-size:.88rem;text-decoration:none;cursor:pointer;
    transition:transform .18s ease, box-shadow .18s ease, background .18s ease;
  }

  .ctr-btn:hover{transform:translateY(-1px);text-decoration:none;}
  .ctr-btn-primary{
    color:#fff;background:linear-gradient(135deg, var(--ctr-primary), var(--ctr-primary-2));
    box-shadow:0 14px 34px rgba(79,70,229,.22);
  }
  .ctr-btn-soft{
    color:var(--ctr-text);background:rgba(255,255,255,.94);border:1px solid var(--ctr-line);
  }

  .ctr-dot{
    width:8px;height:8px;border-radius:999px;background:rgba(79,70,229,.22);flex:0 0 auto;
  }
  .ctr-btn-primary .ctr-dot{
    background:rgba(255,255,255,.95);
    box-shadow:0 0 0 4px rgba(255,255,255,.18);
  }

  .ctr-kpi .label{
    font-size:.76rem;font-weight:900;text-transform:uppercase;letter-spacing:.07em;color:var(--ctr-muted);
  }
  .ctr-kpi .value{
    margin-top:8px;font-size:1.72rem;font-weight:900;color:var(--ctr-text);letter-spacing:-.02em;
  }
  .ctr-kpi .hint{
    margin-top:7px;font-size:.87rem;color:var(--ctr-muted);line-height:1.5;
  }

  .ctr-title-sm{margin:0;font-size:1rem;font-weight:900;color:var(--ctr-text);}
  .ctr-subtitle{margin-top:4px;color:var(--ctr-muted);font-size:.92rem;line-height:1.55;}

  .ctr-separator{
    height:1px;margin:16px 0;
    background:linear-gradient(90deg, transparent, var(--ctr-line-strong), transparent);
  }

  .ctr-card-list{display:grid;gap:14px}
  .ctr-mini-card{
    padding:16px;border:1px solid var(--ctr-line);border-radius:18px;background:var(--ctr-surface-strong);transition:.18s ease;
  }
  .ctr-mini-card:hover{transform:translateY(-1px);box-shadow:var(--ctr-shadow-sm);}

  .ctr-row-title{font-weight:900;color:var(--ctr-text);line-height:1.35;}
  .ctr-row-sub{margin-top:5px;font-size:.84rem;color:var(--ctr-muted);}

  .ctr-table-wrap{overflow:auto}
  .ctr-table{width:100%;border-collapse:separate;border-spacing:0 10px}
  .ctr-table th{
    padding:0 14px 6px;font-size:.76rem;color:var(--ctr-muted);text-transform:uppercase;letter-spacing:.07em;white-space:nowrap;
  }
  .ctr-table td{
    padding:14px;background:var(--ctr-surface-strong);color:var(--ctr-text);
    border-top:1px solid var(--ctr-line);border-bottom:1px solid var(--ctr-line);vertical-align:middle;
  }
  .ctr-table td:first-child{border-left:1px solid var(--ctr-line);border-radius:16px 0 0 16px;}
  .ctr-table td:last-child{border-right:1px solid var(--ctr-line);border-radius:0 16px 16px 0;}

  .ctr-input{
    width:100%;border:1px solid var(--ctr-line);background:rgba(255,255,255,.95);
    border-radius:16px;padding:13px 14px;color:var(--ctr-text);outline:none;transition:.18s ease;
  }
  .ctr-input:focus{
    border-color:rgba(79,70,229,.34);box-shadow:0 0 0 4px rgba(79,70,229,.10);
  }

  .ctr-badge{
    display:inline-flex;align-items:center;gap:6px;padding:7px 10px;border-radius:999px;
    font-size:.73rem;font-weight:900;border:1px solid transparent;white-space:nowrap;
  }

  .ctr-badge.success,.ctr-badge.connected{background:rgba(16,185,129,.12);color:#047857;border-color:rgba(16,185,129,.18);}
  .ctr-badge.warning{background:rgba(245,158,11,.12);color:#b45309;border-color:rgba(245,158,11,.18);}
  .ctr-badge.failed,.ctr-badge.disabled{background:rgba(239,68,68,.10);color:#b91c1c;border-color:rgba(239,68,68,.15);}
  .ctr-badge.neutral{background:rgba(15,23,42,.05);color:#334155;border-color:rgba(15,23,42,.08);}

  @media (max-width:1100px){
    .ctr-grid-3{grid-template-columns:1fr;}
  }

  @media (max-width:720px){
    .ctr-shell{padding:16px}
    .ctr-card-inner{padding:16px}
  }
</style>