{% extends 'base.html.twig' %}
{% block title %}Admin • Broadcast{% endblock %}

{% block body %}
<script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-[calc(100vh-1px)] bg-[radial-gradient(1200px_circle_at_12%_10%,rgba(99,102,241,.12),transparent_55%),radial-gradient(900px_circle_at_90%_12%,rgba(16,185,129,.10),transparent_52%),linear-gradient(180deg,#f8fafc,#eef2ff_50%,#f8fafc)]">
  <div class="mx-auto max-w-5xl px-4 py-6 space-y-4">

    <div class="rounded-3xl border border-slate-200/70 bg-white/70 backdrop-blur-xl shadow-[0_18px_55px_rgba(2,6,23,.10)] overflow-hidden">
      <div class="p-5 border-b border-slate-200/70 bg-white/60 flex items-start justify-between gap-3">
        <div>
          <div class="text-xs font-semibold text-slate-500">{% trans %}Communication{% endtrans %}</div>
          <div class="text-2xl font-black tracking-tight text-slate-900">📢 Broadcast</div>
          <div class="mt-1 text-sm font-medium text-slate-600">{% trans %}Notifier une audience (tous / par rôle / actifs).{% endtrans %}</div>
        </div>
        <a href="{{ path('tableau_de_bord') }}" class="rounded-2xl bg-slate-900 px-3 py-2 text-xs font-extrabold text-white hover:opacity-95">← {% trans %}Tableau de bord{% endtrans %}</a>
      </div>

      <div class="p-5 space-y-4">
        <div class="grid gap-3 md:grid-cols-3">
          <div>
            <label class="text-[11px] font-extrabold text-slate-600">{% trans %}Audience{% endtrans %}</label>
            <select id="role" class="mt-1 w-full rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold outline-none">
              <option value="">{% trans %}Tous{% endtrans %}</option>
              {% for r in rolesList %}
                <option value="{{ r }}">{{ r }}</option>
              {% endfor %}
            </select>
          </div>

          <div class="flex items-end gap-2">
            <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
              <input id="onlyActive" type="checkbox" checked class="h-4 w-4 rounded border-slate-300">
              {% trans %}Uniquement actifs{% endtrans %}
            </label>
          </div>

          <div class="flex items-end justify-end">
            <button id="btnPreview" type="button"
                    class="rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-extrabold text-slate-800 hover:bg-slate-50">
              👁️ {% trans %}Preview destinataires{% endtrans %}
            </button>
          </div>
        </div>

        <div class="rounded-3xl border border-slate-200 bg-white p-4">
          <label class="text-[11px] font-extrabold text-slate-600">{% trans %}Sujet{% endtrans %}</label>
          <input id="subject" class="mt-1 w-full rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold outline-none"
                 placeholder="{% trans %}Ex: Mise à jour importante…{% endtrans %}">
          <label class="mt-3 block text-[11px] font-extrabold text-slate-600">{% trans %}Message{% endtrans %}</label>
          <textarea id="body" rows="6"
                    class="mt-1 w-full rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold outline-none"
                    placeholder="{% trans %}Tape ton message…{% endtrans %}"></textarea>

          <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
            <div class="text-xs font-semibold text-slate-500">
              {% trans %}Destinataires :{% endtrans %} <span id="recipients" class="font-black text-slate-900">—</span>
              <span id="hint" class="ml-2 text-slate-400"></span>
            </div>
            <button id="btnSend" type="button"
                    class="rounded-2xl bg-gradient-to-br from-indigo-600 to-blue-600 px-4 py-2.5 text-xs font-extrabold text-white hover:opacity-95">
              🚀 {% trans %}Envoyer broadcast{% endtrans %}
            </button>
          </div>
        </div>

        <div id="toastHost" class="fixed right-4 top-4 z-[9999] space-y-2"></div>
      </div>
    </div>

  </div>
</div>

<script>
(() => {
  const CSRF = {{ csrf|json_encode|raw }};
  const toastHost = document.getElementById('toastHost');

  function toast(msg, kind='info') {
    const el = document.createElement('div');
    el.className = 'rounded-2xl border bg-white/90 backdrop-blur px-4 py-3 shadow-[0_18px_55px_rgba(2,6,23,.12)] text-sm font-semibold ' +
      (kind === 'error' ? 'border-rose-200 text-rose-700' :
       kind === 'ok' ? 'border-emerald-200 text-emerald-700' :
       'border-slate-200 text-slate-700');
    el.textContent = msg;
    toastHost.appendChild(el);
    setTimeout(() => el.remove(), 2600);
  }

  async function postJson(url, body) {
    const res = await fetch(url, {
      method:'POST',
      headers:{ 'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest','X-CSRF-TOKEN':CSRF },
      body: JSON.stringify(body||{})
    });
    const data = await res.json().catch(()=>({}));
    if(!res.ok || data.ok === false) throw new Error(data.error || '{{ "Erreur"|trans }}');
    return data;
  }

  const role = document.getElementById('role');
  const onlyActive = document.getElementById('onlyActive');
  const subject = document.getElementById('subject');
  const body = document.getElementById('body');
  const recipients = document.getElementById('recipients');
  const hint = document.getElementById('hint');

  async function preview() {
    const payload = { role: role.value, onlyActive: onlyActive.checked };
    const data = await postJson('{{ path('admin_broadcast_preview') }}', payload);
    recipients.textContent = String(data.count);
    hint.textContent = data.hint ? `(${data.hint})` : '';
  }

  document.getElementById('btnPreview')?.addEventListener('click', async () => {
    try { await preview(); toast('{{ "Preview OK ✅"|trans }}','ok'); } catch(e){ toast(e.message,'error'); }
  });

  document.getElementById('btnSend')?.addEventListener('click', async () => {
    const payload = {
      role: role.value,
      onlyActive: onlyActive.checked,
      subject: subject.value.trim(),
      body: body.value.trim()
    };

    try {
      const data = await postJson('{{ path('admin_broadcast_send') }}', payload);
      toast(`{{ "Broadcast envoyé ✅"|trans }} (${data.sent} {{ "destinataires"|trans }})`, 'ok');
    } catch (e) {
      toast(e.message || '{{ "Erreur"|trans }}', 'error');
    }
  });

  // Auto preview (facultatif)
  preview().catch(()=>{});
})();
</script>
{% endblock %}