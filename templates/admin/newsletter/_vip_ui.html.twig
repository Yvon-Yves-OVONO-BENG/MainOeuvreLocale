<style>
    :root{
        --nad-bg:#f4f7fb;
        --nad-surface:rgba(255,255,255,.92);
        --nad-surface-2:#ffffff;
        --nad-line:rgba(15,23,42,.08);
        --nad-line-strong:rgba(15,23,42,.12);
        --nad-text:#0f172a;
        --nad-muted:#64748b;
        --nad-primary:#2563eb;
        --nad-primary-2:#1d4ed8;
        --nad-success:#16a34a;
        --nad-danger:#dc2626;
        --nad-warning:#f59e0b;
        --nad-shadow:0 24px 70px rgba(15,23,42,.10);
        --nad-radius:28px;
    }

    body{
        background:
            radial-gradient(circle at top left, rgba(37,99,235,.10), transparent 32%),
            linear-gradient(180deg, #f8fbff 0%, var(--nad-bg) 100%);
    }

    .nad-shell{
        padding:28px 16px 40px;
    }

    .nad-wrap{
        max-width:1400px;
        margin:0 auto;
    }

    .nad-head{
        display:flex;
        flex-wrap:wrap;
        align-items:flex-end;
        justify-content:space-between;
        gap:18px;
        margin-bottom:24px;
    }

    .nad-title h1{
        margin:0;
        font-size:30px;
        line-height:1.1;
        color:var(--nad-text);
        font-weight:900;
    }

    .nad-title p{
        margin:10px 0 0;
        color:var(--nad-muted);
        font-size:14px;
        line-height:1.8;
    }

    .nad-search{
        min-width:290px;
        max-width:420px;
        width:100%;
    }

    .nad-input{
        width:100%;
        height:52px;
        border-radius:16px;
        border:1px solid var(--nad-line-strong);
        background:rgba(255,255,255,.92);
        padding:0 16px;
        font-size:14px;
        outline:none;
        box-shadow:0 8px 20px rgba(15,23,42,.04);
    }

    .nad-grid{
        display:grid;
        grid-template-columns:repeat(3, minmax(0, 1fr));
        gap:18px;
        margin-bottom:22px;
    }

    .nad-stat{
        background:var(--nad-surface);
        border:1px solid var(--nad-line);
        border-radius:24px;
        padding:22px;
        box-shadow:var(--nad-shadow);
        backdrop-filter:blur(18px);
    }

    .nad-stat small{
        display:block;
        color:var(--nad-muted);
        font-size:12px;
        font-weight:800;
        letter-spacing:.05em;
        text-transform:uppercase;
        margin-bottom:10px;
    }

    .nad-stat strong{
        display:block;
        color:var(--nad-text);
        font-size:30px;
        line-height:1;
        font-weight:900;
    }

    .nad-card{
        background:var(--nad-surface);
        border:1px solid var(--nad-line);
        border-radius:var(--nad-radius);
        box-shadow:var(--nad-shadow);
        overflow:hidden;
    }

    .nad-card-head{
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:16px;
        padding:22px 24px;
        border-bottom:1px solid var(--nad-line);
    }

    .nad-card-head h2{
        margin:0;
        font-size:18px;
        font-weight:800;
        color:var(--nad-text);
    }

    .nad-card-head span{
        color:var(--nad-muted);
        font-size:13px;
    }

    .nad-table-wrap{
        overflow:auto;
    }

    .nad-table{
        width:100%;
        border-collapse:separate;
        border-spacing:0;
        min-width:900px;
    }

    .nad-table thead th{
        text-align:left;
        font-size:12px;
        letter-spacing:.05em;
        text-transform:uppercase;
        color:#64748b;
        padding:16px 20px;
        background:#f8fbff;
        border-bottom:1px solid var(--nad-line);
    }

    .nad-table tbody td{
        padding:16px 20px;
        border-bottom:1px solid var(--nad-line);
        color:var(--nad-text);
        font-size:14px;
        vertical-align:middle;
    }

    .nad-table tbody tr:hover{
        background:rgba(37,99,235,.025);
    }

    .nad-email{
        font-weight:800;
        color:var(--nad-text);
    }

    .nad-badge{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        min-height:30px;
        padding:0 12px;
        border-radius:999px;
        font-size:12px;
        font-weight:800;
        letter-spacing:.02em;
    }

    .nad-badge-success{
        background:rgba(22,163,74,.10);
        color:#166534;
        border:1px solid rgba(22,163,74,.14);
    }

    .nad-badge-danger{
        background:rgba(220,38,38,.08);
        color:#991b1b;
        border:1px solid rgba(220,38,38,.12);
    }

    .nad-source{
        display:inline-flex;
        align-items:center;
        min-height:30px;
        padding:0 12px;
        border-radius:999px;
        background:#eef4ff;
        color:#1d4ed8;
        border:1px solid rgba(37,99,235,.10);
        font-size:12px;
        font-weight:800;
    }

    .nad-empty{
        padding:50px 24px;
        text-align:center;
        color:var(--nad-muted);
        font-size:15px;
    }

    .nad-pager{
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:14px;
        padding:16px 22px;
        border-top:1px solid var(--nad-line);
        background:#fbfdff;
    }

    .nad-pager-info{
        color:var(--nad-muted);
        font-size:12px;
        font-weight:750;
    }

    .nad-pager-actions{
        display:flex;
        align-items:center;
        gap:8px;
    }

    .nad-pager button{
        min-height:38px;
        border:1px solid var(--nad-line-strong);
        border-radius:11px;
        background:#fff;
        padding:0 13px;
        color:#334155;
        font-size:12px;
        font-weight:800;
        cursor:pointer;
    }

    .nad-pager button:disabled{
        opacity:.42;
        cursor:not-allowed;
    }

    .nad-pager-page{
        min-width:42px;
        text-align:center;
        color:var(--nad-primary);
        font-size:12px;
        font-weight:900;
    }

    @media (max-width: 992px){
        .nad-grid{
            grid-template-columns:1fr;
        }
    }

    @media (max-width: 575.98px){
        .nad-pager{
            align-items:stretch;
            flex-direction:column;
        }

        .nad-pager-actions{
            justify-content:space-between;
        }
    }
</style>
