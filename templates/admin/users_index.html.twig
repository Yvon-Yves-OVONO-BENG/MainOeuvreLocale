{% extends 'base.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{% trans %}Admin • Utilisateurs{% endtrans %}{% endblock %}
{% block body %}
<script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-[calc(100vh-1px)] bg-[radial-gradient(1100px_circle_at_12%_10%,rgba(99,102,241,.12),transparent_55%),radial-gradient(900px_circle_at_90%_12%,rgba(6,182,212,.10),transparent_52%),linear-gradient(180deg,#f8fafc,#eef2ff_50%,#f8fafc)]">
  <div class="mx-auto max-w-7xl px-4 py-6 space-y-4">

    <div class="rounded-3xl border border-slate-200/70 bg-white/70 backdrop-blur-xl shadow-[0_18px_55px_rgba(2,6,23,.10)] overflow-hidden">
      <div class="p-5 border-b border-slate-200/70 bg-white/60">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <div class="text-xs font-semibold text-slate-500">{% trans %}Admin{% endtrans %}</div>
            <div class="text-2xl font-black tracking-tight text-slate-900">👥 {% trans %}Tous les utilisateurs{% endtrans %}</div>
            <div class="mt-1 text-sm font-medium text-slate-600">{% trans %}Recherche, filtres, actions rapides (blocage/déblocage).{% endtrans %}</div>
          </div>

          <div class="flex flex-wrap gap-2">
            <a href="{{ path('tableau_de_bord') }}"
               class="inline-flex items-center gap-2 rounded-2xl bg-slate-900 px-3 py-2 text-xs font-extrabold text-white hover:opacity-95">
              ← {% trans %}Tableau de bord{% endtrans %}
            </a>
          </div>
        </div>

        <form class="mt-4 grid gap-3 lg:grid-cols-12" method="get">
          <div class="lg:col-span-5">
            <label class="text-[11px] font-extrabold text-slate-600">{% trans %}Recherche{% endtrans %}</label>
            <input name="q" value="{{ filters.q }}"
                   class="mt-1 w-full rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold outline-none"
                   placeholder="{{ 'email…'|trans }}">
          </div>

          <div class="lg:col-span-3">
            <label class="text-[11px] font-extrabold text-slate-600">{% trans %}Rôle{% endtrans %}</label>
            <select name="role" class="mt-1 w-full rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold outline-none">
              <option value="">{% trans %}Tous{% endtrans %}</option>
              {% for r in rolesList %}
                <option value="{{ r }}" {{ filters.role == r ? 'selected' : '' }}>{{ r }}</option>
              {% endfor %}
            </select>
          </div>

          <div class="lg:col-span-2">
            <label class="text-[11px] font-extrabold text-slate-600">{% trans %}Statut{% endtrans %}</label>
            <select name="status" class="mt-1 w-full rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold outline-none">
              <option value="">{% trans %}Tous{% endtrans %}</option>
              <option value="active" {{ filters.status == 'active' ? 'selected' : '' }}>{% trans %}Actifs{% endtrans %}</option>
              <option value="blocked" {{ filters.status == 'blocked' ? 'selected' : '' }}>{% trans %}Bloqués{% endtrans %}</option>
            </select>
          </div>

          <div class="lg:col-span-2 flex items-end gap-2">
            <select name="perPage" class="w-full rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold outline-none">
              {% for n in [10,20,30,50,100] %}
                <option value="{{ n }}" {{ perPage == n ? 'selected' : '' }}>{{ n }}/{{ 'page'|trans }}</option>
              {% endfor %}
            </select>
          </div>

          <div class="lg:col-span-12 flex flex-wrap items-center justify-between gap-2 pt-1">
            <div class="text-xs font-semibold text-slate-500">
              {% trans %}Total :{% endtrans %} <span class="font-black text-slate-900">{{ total }}</span>
            </div>

            <div class="flex flex-wrap gap-2">
              <button class="inline-flex items-center gap-2 rounded-2xl bg-gradient-to-br from-indigo-600 to-blue-600 px-4 py-2 text-xs font-extrabold text-white hover:opacity-95">
                🔎 {% trans %}Filtrer{% endtrans %}
              </button>
              <a href="{{ path('admin_users_index') }}"
                 class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2 text-xs font-extrabold text-slate-800 hover:bg-slate-50">
                ✨ {% trans %}Réinitialiser{% endtrans %}
              </a>
            </div>
          </div>
        </form>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead class="bg-slate-50/60">
            <tr class="text-left text-[11px] uppercase tracking-wider text-slate-500">
              <th class="px-5 py-3 font-extrabold">{% trans %}Utilisateur{% endtrans %}</th>
              <th class="px-5 py-3 font-extrabold">{% trans %}Rôle{% endtrans %}</th>
              <th class="px-5 py-3 font-extrabold">{% trans %}Statut{% endtrans %}</th>
              <th class="px-5 py-3 font-extrabold">{% trans %}Créé{% endtrans %}</th>
              <th class="px-5 py-3 font-extrabold">{% trans %}Actions{% endtrans %}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200/70">
            {% for u in items %}
              {% set role = (u.roles|default([])|first)|default('ROLE_USER') %}
              <tr class="hover:bg-indigo-50/20">
                <td class="px-5 py-3">
                  <div class="flex items-center gap-3">
                    <img class="h-9 w-9 rounded-2xl border border-slate-200 bg-slate-50 object-cover"
                         src="{{ asset('uploads/profiles/' ~ (u.personalProfile.photo ?? 'default.png')) }}"
                         alt="">
                    <div>
                      <div class="font-bold text-slate-900">{{ u.email }}</div>
                      <div class="text-xs font-semibold text-slate-500">Réf. {{ u.slug|slice(0, 12)|upper }}</div>
                    </div>
                  </div>
                </td>

                <td class="px-5 py-3">
                  <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[11px] font-extrabold text-slate-700">
                    {{ role }}
                  </span>
                </td>

                <td class="px-5 py-3">
                  {% if u.isActive %}
                    <span class="inline-flex items-center gap-2 rounded-full border border-emerald-200/70 bg-emerald-50 px-2.5 py-1 text-[11px] font-extrabold text-emerald-700">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> {% trans %}Actif{% endtrans %}
                    </span>
                  {% else %}
                    <span class="inline-flex items-center gap-2 rounded-full border border-rose-200/70 bg-rose-50 px-2.5 py-1 text-[11px] font-extrabold text-rose-700">
                      <span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span> {% trans %}Bloqué{% endtrans %}
                    </span>
                  {% endif %}
                </td>

                <td class="px-5 py-3 text-xs font-semibold text-slate-500">
                  {{ u.createdAt ? u.createdAt|date('d/m/Y H:i') : '—' }}
                </td>

                <td class="px-5 py-3">
                  <div class="flex flex-wrap gap-2">
                    <a href="{{ path('admin_users_show', {slug: u.slug}) }}"
                       class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-3 py-2 text-xs font-extrabold text-slate-800 hover:bg-slate-50">
                      👁️ {% trans %}Voir{% endtrans %}
                    </a>

                    <button type="button"
                            class="js-toggle inline-flex items-center gap-2 rounded-2xl px-3 py-2 text-xs font-extrabold text-white hover:opacity-95
                            {{ u.isActive ? 'bg-rose-500' : 'bg-emerald-600' }}"
                            data-url="{{ path('admin_users_toggle_active', {slug: u.slug}) }}">
                      {{ u.isActive ? '⛔' : '✅' }}
                    </button>
                  </div>
                </td>
              </tr>
            {% else %}
              <tr><td colspan="5" class="px-5 py-10 text-center text-sm font-semibold text-slate-500">{% trans %}Aucun utilisateur.{% endtrans %}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <div class="px-5 py-4 border-t border-slate-200/70 bg-white/60 flex items-center justify-between gap-2">
        <div class="text-xs font-semibold text-slate-500">{% trans %}Page{% endtrans %} <span class="font-black text-slate-900">{{ page }}</span> / {{ pages }}</div>

        {% set prev = page > 1 ? page - 1 : 1 %}
        {% set next = page < pages ? page + 1 : pages %}

        <div class="flex items-center gap-2">
          <a class="rounded-2xl border border-slate-200 bg-white px-3 py-2 text-xs font-extrabold text-slate-800 hover:bg-slate-50 {{ page <= 1 ? 'opacity-40 pointer-events-none' : '' }}"
             href="{{ path('admin_users_index', filters|merge({'page': prev, 'perPage': perPage})) }}">← {% trans %}Préc{% endtrans %}</a>

          <a class="rounded-2xl border border-slate-200 bg-white px-3 py-2 text-xs font-extrabold text-slate-800 hover:bg-slate-50 {{ page >= pages ? 'opacity-40 pointer-events-none' : '' }}"
             href="{{ path('admin_users_index', filters|merge({'page': next, 'perPage': perPage})) }}">{% trans %}Suiv{% endtrans %} →</a>
        </div>
      </div>
    </div>

    <div id="toastHost" class="fixed right-4 top-4 z-[9999] space-y-2"></div>
  </div>
</div>

<script>
(() => {
  const CSRF = {{ csrf|json_encode|raw }};
  const toastHost = document.getElementById('toastHost');

  function toast(msg, kind='info') {
    const el = document.createElement('div');
    el.className = 'rounded-2xl border bg-white/90 backdrop-blur px-4 py-3 shadow-[0_18px_55px_rgba(2,6,23,.12)] text-sm font-semibold ' +
      (kind === 'error' ? 'border-rose-200 text-rose-700' :
       kind === 'ok' ? 'border-emerald-200 text-emerald-700' :
       'border-slate-200 text-slate-700');
    el.textContent = msg;
    toastHost.appendChild(el);
    setTimeout(() => el.remove(), 2600);
  }

  async function post(url) {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'X-Requested-With':'XMLHttpRequest', 'X-CSRF-TOKEN': CSRF }
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok || data.ok === false) throw new Error(data.error || {{ 'Erreur'|trans|json_encode|raw }});
    return data;
  }

  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.js-toggle');
    if (!btn) return;

    btn.disabled = true;
    try {
      await post(btn.dataset.url);
      toast({{ 'Statut mis à jour ✅'|trans|json_encode|raw }}, 'ok');
      window.location.reload();
    } catch (err) {
      toast(err.message || {{ 'Erreur'|trans|json_encode|raw }}, 'error');
      btn.disabled = false;
    }
  });
})();
</script>
{% endblock %}
