{% extends 'base.html.twig' %}
{% block title %}{% trans %}Admin • File modération{% endtrans %}{% endblock %}

{% block body %}
<script src="https://cdn.tailwindcss.com"></script>
{% set CSRF = csrf|default(csrf_token('admin_moderation')) %}

<div class="min-h-[calc(100vh-1px)] bg-[radial-gradient(1100px_circle_at_12%_10%,rgba(244,63,94,.10),transparent_55%),radial-gradient(900px_circle_at_90%_12%,rgba(6,182,212,.10),transparent_52%),linear-gradient(180deg,#f8fafc,#fff7ed_45%,#f8fafc)]">
  <div class="mx-auto max-w-7xl px-4 py-6 space-y-4">

    <div class="overflow-hidden rounded-3xl border border-slate-200/70 bg-white/70 shadow-[0_18px_55px_rgba(2,6,23,.10)] backdrop-blur-xl">
      <div class="border-b border-slate-200/70 bg-white/60 p-5">
        <div class="flex items-start justify-between gap-3">
          <div>
            <div class="text-xs font-semibold text-slate-500">{% trans %}Triage{% endtrans %}</div>
            <div class="text-2xl font-black tracking-tight text-slate-900">🧹 {% trans %}File modération{% endtrans %}</div>
            <div class="mt-1 text-sm font-medium text-slate-600">{% trans %}Ouvert → traitement → résolution.{% endtrans %}</div>
          </div>
          <a href="{{ path('tableau_de_bord') }}" class="rounded-2xl bg-slate-900 px-3 py-2 text-xs font-extrabold text-white hover:opacity-95">← {% trans %}Tableau de bord{% endtrans %}</a>
        </div>

        <form class="mt-4 grid gap-3 lg:grid-cols-12" method="get">
          <div class="lg:col-span-5">
            <label class="text-[11px] font-extrabold text-slate-600">{% trans %}Recherche{% endtrans %}</label>
            <input
              name="q"
              value="{{ filters.q|default('') }}"
              class="mt-1 w-full rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold outline-none"
              placeholder="{% trans %}email, raison, catégorie…{% endtrans %}"
            >
          </div>

          <div class="lg:col-span-3">
            <label class="text-[11px] font-extrabold text-slate-600">{% trans %}Type{% endtrans %}</label>
            <select name="type" class="mt-1 w-full rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold outline-none">
              <option value="">{% trans %}Tous{% endtrans %}</option>
              {% for t in typesList|default([]) %}
                <option value="{{ t }}" {{ filters.type|default('') == t ? 'selected' : '' }}>
                  {{ t }}
                </option>
              {% endfor %}
            </select>
          </div>

          <div class="lg:col-span-2">
            <label class="text-[11px] font-extrabold text-slate-600">{% trans %}Statut{% endtrans %}</label>
            <select name="status" class="mt-1 w-full rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold outline-none">
              <option value="">{% trans %}Tous{% endtrans %}</option>
              <option value="open" {{ filters.status|default('open') == 'open' ? 'selected' : '' }}>{% trans %}Ouvert{% endtrans %}</option>
              <option value="resolved" {{ filters.status|default('') == 'resolved' ? 'selected' : '' }}>{% trans %}Résolu{% endtrans %}</option>
              <option value="canceled" {{ filters.status|default('') == 'canceled' ? 'selected' : '' }}>{% trans %}Annulé{% endtrans %}</option>
            </select>
          </div>

          <div class="lg:col-span-2 flex items-end gap-2">
            <button class="w-full rounded-2xl bg-gradient-to-br from-rose-500 to-orange-500 px-4 py-2.5 text-xs font-extrabold text-white hover:opacity-95">
              🔎 {% trans %}Filtrer{% endtrans %}
            </button>
          </div>
        </form>

        <div class="mt-4 flex flex-wrap items-center justify-between gap-2 rounded-3xl border border-slate-200 bg-white/70 p-3">
          <div class="text-xs font-semibold text-slate-600">
            {% trans %}Sélection :{% endtrans %}
            <span id="selCount" class="font-black text-slate-900">0</span>
          </div>

          <div class="flex flex-wrap gap-2">
            <button type="button" data-bulk="resolved" class="rounded-2xl border border-emerald-200/70 bg-emerald-50 px-3 py-2 text-xs font-extrabold text-emerald-700 hover:bg-emerald-100/60">
              ✅ {% trans %}Résolu{% endtrans %}
            </button>
            <button type="button" data-bulk="canceled" class="rounded-2xl border border-slate-200 bg-white px-3 py-2 text-xs font-extrabold text-slate-800 hover:bg-slate-50">
              🧹 {% trans %}Annulé{% endtrans %}
            </button>
            <button type="button" data-bulk="open" class="rounded-2xl border border-amber-200/70 bg-amber-50 px-3 py-2 text-xs font-extrabold text-amber-700 hover:bg-amber-100/60">
              🔄 {% trans %}Réouvrir{% endtrans %}
            </button>
          </div>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead class="bg-slate-50/60">
            <tr class="text-left text-[11px] uppercase tracking-wider text-slate-500">
              <th class="px-5 py-3 font-extrabold"><input id="checkAll" type="checkbox"></th>
              <th class="px-5 py-3 font-extrabold">{% trans %}Cas{% endtrans %}</th>
              <th class="px-5 py-3 font-extrabold">{% trans %}Reporter{% endtrans %}</th>
              <th class="px-5 py-3 font-extrabold">{% trans %}Compte signalé{% endtrans %}</th>
              <th class="px-5 py-3 font-extrabold">{% trans %}Catégorie{% endtrans %}</th>
              <th class="px-5 py-3 font-extrabold">{% trans %}Statut{% endtrans %}</th>
              <th class="px-5 py-3 font-extrabold">{% trans %}Date{% endtrans %}</th>
              <th class="px-5 py-3 font-extrabold">{% trans %}Actions{% endtrans %}</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-200/70">
            {% for r in items %}
              {% set categoryName =
                r.categorie
                  ? (attribute(r.categorie, 'name') is defined and r.categorie.name
                      ? r.categorie.name
                      : (attribute(r.categorie, 'label') is defined and r.categorie.label
                          ? r.categorie.label
                          : (attribute(r.categorie, 'title') is defined and r.categorie.title
                              ? r.categorie.title
                              : '—')))
                  : '—'
              %}

              <tr class="hover:bg-rose-50/10" data-status-url="{{ path('admin_moderation_set_status', {id: r.id}) }}">
                <td class="px-5 py-3">
                  <input class="rowCheck" type="checkbox" value="{{ r.id }}">
                </td>

                <td class="px-5 py-3">
                  <div class="font-bold text-slate-900">#{{ r.id }}</div>
                  <div class="mt-1 line-clamp-2 text-xs font-semibold text-slate-500">
                    {{ r.reason|default('') }}
                  </div>
                </td>

                <td class="px-5 py-3">
                  <div class="font-bold text-slate-900">
                    {{ r.reporter ? r.reporter.email : '—' }}
                  </div>
                </td>

                <td class="px-5 py-3">
                  <div class="font-bold text-slate-900">
                    {{ r.targetUser ? r.targetUser.email : '—' }}
                  </div>
                </td>

                <td class="px-5 py-3">
                  <span class="rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[11px] font-extrabold text-slate-700">
                    {{ categoryName }}
                  </span>
                </td>

                <td class="px-5 py-3">
                  <span class="stBadge rounded-full border px-2.5 py-1 text-[11px] font-extrabold
                    {{ r.status == 'resolved'
                      ? 'border-emerald-200/70 bg-emerald-50 text-emerald-700'
                      : (r.status == 'canceled'
                        ? 'border-slate-200 bg-white text-slate-700'
                        : 'border-amber-200/70 bg-amber-50 text-amber-700') }}">
                    {{ r.status|default('open')|trans }}
                  </span>
                </td>

                <td class="px-5 py-3">
                  <div class="text-xs font-semibold text-slate-600">
                    {{ r.createdAt ? r.createdAt|date('d/m/Y H:i') : '—' }}
                  </div>
                </td>

                <td class="px-5 py-3">
                  <div class="flex flex-wrap gap-2">
                    <button
                      type="button"
                      data-status="resolved"
                      class="rounded-2xl border border-emerald-200/70 bg-emerald-50 px-3 py-2 text-xs font-extrabold text-emerald-700 hover:bg-emerald-100/60"
                    >
                      ✅
                    </button>

                    <button
                      type="button"
                      data-status="canceled"
                      class="rounded-2xl border border-slate-200 bg-white px-3 py-2 text-xs font-extrabold text-slate-800 hover:bg-slate-50"
                    >
                      🧹
                    </button>

                    <button
                      type="button"
                      data-status="open"
                      class="rounded-2xl border border-amber-200/70 bg-amber-50 px-3 py-2 text-xs font-extrabold text-amber-700 hover:bg-amber-100/60"
                    >
                      🔄
                    </button>
                  </div>
                </td>
              </tr>
            {% else %}
              <tr>
                <td colspan="8" class="px-5 py-10 text-center text-sm font-semibold text-slate-500">
                  {% trans %}Aucun cas.{% endtrans %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <div class="flex items-center justify-between gap-2 border-t border-slate-200/70 bg-white/60 px-5 py-4">
        <div class="text-xs font-semibold text-slate-500">
          {% trans %}Total :{% endtrans %}
          <span class="font-black text-slate-900">{{ total }}</span>
        </div>

        {% set prev = page > 1 ? page - 1 : 1 %}
        {% set next = page < pages ? page + 1 : pages %}

        <div class="flex gap-2">
          <a
            class="rounded-2xl border border-slate-200 bg-white px-3 py-2 text-xs font-extrabold text-slate-800 hover:bg-slate-50 {{ page <= 1 ? 'pointer-events-none opacity-40' : '' }}"
            href="{{ path('admin_moderation_queue', filters|merge({'page': prev, 'perPage': perPage})) }}"
          >
            ← {% trans %}Préc{% endtrans %}
          </a>

          <a
            class="rounded-2xl border border-slate-200 bg-white px-3 py-2 text-xs font-extrabold text-slate-800 hover:bg-slate-50 {{ page >= pages ? 'pointer-events-none opacity-40' : '' }}"
            href="{{ path('admin_moderation_queue', filters|merge({'page': next, 'perPage': perPage})) }}"
          >
            {% trans %}Suiv{% endtrans %} →
          </a>
        </div>
      </div>
    </div>

    <div id="toastHost" class="fixed right-4 top-4 z-[9999] space-y-2"></div>
  </div>
</div>

<script>
(() => {
  const CSRF = {{ CSRF|json_encode|raw }};
  const toastHost = document.getElementById('toastHost');

  const toast = (message, kind = 'info') => {
    const el = document.createElement('div');
    el.className =
      'rounded-2xl border bg-white/90 px-4 py-3 text-sm font-semibold shadow-[0_18px_55px_rgba(2,6,23,.12)] backdrop-blur ' +
      (kind === 'error'
        ? 'border-rose-200 text-rose-700'
        : kind === 'ok'
          ? 'border-emerald-200 text-emerald-700'
          : 'border-slate-200 text-slate-700');

    el.textContent = message;
    toastHost.appendChild(el);
    setTimeout(() => el.remove(), 2600);
  };

  const checkAll = document.getElementById('checkAll');
  const selCount = document.getElementById('selCount');

  const rowChecks = () => Array.from(document.querySelectorAll('.rowCheck'));

  const refreshSelection = () => {
    selCount.textContent = String(rowChecks().filter(c => c.checked).length);
  };

  checkAll?.addEventListener('change', () => {
    rowChecks().forEach(c => { c.checked = checkAll.checked; });
    refreshSelection();
  });

  document.addEventListener('change', (e) => {
    if (e.target?.classList?.contains('rowCheck')) {
      refreshSelection();
    }
  });

  async function postJson(url, body) {
    const res = await fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest',
        'X-CSRF-TOKEN': CSRF
      },
      body: JSON.stringify(body || {})
    });

    const data = await res.json().catch(() => ({}));

    if (!res.ok || data.ok === false) {
      throw new Error(data.error || '{{ "Erreur"|trans|e("js") }}');
    }

    return data;
  }

  function applyBadgeStyle(badge, status) {
    badge.className = 'stBadge rounded-full border px-2.5 py-1 text-[11px] font-extrabold ' +
      (status === 'resolved'
        ? 'border-emerald-200/70 bg-emerald-50 text-emerald-700'
        : status === 'canceled'
          ? 'border-slate-200 bg-white text-slate-700'
          : 'border-amber-200/70 bg-amber-50 text-amber-700');

    badge.textContent = status;
  }

  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('button[data-status]');
    if (!btn) return;

    const tr = btn.closest('tr[data-status-url]');
    if (!tr) return;

    btn.disabled = true;

    try {
      const status = btn.dataset.status;
      await postJson(tr.dataset.statusUrl, { status });

      const badge = tr.querySelector('.stBadge');
      if (badge) {
        applyBadgeStyle(badge, status);
      }

      toast('{{ "Statut mis à jour ✅"|trans|e("js") }}', 'ok');
    } catch (err) {
      toast(err.message || '{{ "Erreur"|trans|e("js") }}', 'error');
    } finally {
      btn.disabled = false;
    }
  });

  document.querySelectorAll('button[data-bulk]').forEach(button => {
    button.addEventListener('click', async () => {
      const status = button.dataset.bulk;
      const ids = rowChecks()
        .filter(c => c.checked)
        .map(c => parseInt(c.value, 10))
        .filter(Boolean);

      if (!ids.length) {
        toast('{{ "Sélectionne au moins un cas."|trans|e("js") }}', 'error');
        return;
      }

      button.disabled = true;

      try {
        const data = await postJson('{{ path('admin_moderation_bulk') }}', { ids, status });
        toast(`{{ "OK :"|trans|e("js") }} ${data.count} {{ "mis à jour ✅"|trans|e("js") }}`, 'ok');
        window.location.reload();
      } catch (err) {
        toast(err.message || '{{ "Erreur"|trans|e("js") }}', 'error');
        button.disabled = false;
      }
    });
  });

  refreshSelection();
})();
</script>
{% endblock %}