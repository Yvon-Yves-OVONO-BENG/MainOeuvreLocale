<style>
  :root{
    --vip-bg:#f4f7ff;
    --vip-bg-soft:#eef3ff;
    --vip-surface:rgba(255,255,255,.82);
    --vip-surface-strong:rgba(255,255,255,.96);
    --vip-surface-solid:#ffffff;
    --vip-line:rgba(15,23,42,.08);
    --vip-line-strong:rgba(15,23,42,.14);
    --vip-text:#0f172a;
    --vip-text-soft:#334155;
    --vip-muted:rgba(15,23,42,.60);

    --vip-primary:#4f46e5;
    --vip-primary-2:#2563eb;
    --vip-cyan:#06b6d4;
    --vip-ok:#10b981;
    --vip-warn:#f59e0b;
    --vip-danger:#ef4444;

    --vip-shadow:0 22px 80px rgba(15,23,42,.10);
    --vip-shadow-sm:0 14px 34px rgba(15,23,42,.07);
    --vip-shadow-xs:0 8px 18px rgba(15,23,42,.05);

    --vip-r:22px;
    --vip-r2:30px;
    --vip-r3:18px;
  }

  .vip-shell{
    min-height:100vh;
    padding:24px;
    background:
      radial-gradient(circle at top right, rgba(79,70,229,.08), transparent 24%),
      radial-gradient(circle at top left, rgba(37,99,235,.07), transparent 22%),
      linear-gradient(180deg, var(--vip-bg), #fff 72%);
  }

  .vip-container{
    max-width:1440px;
    margin:0 auto;
  }

  .vip-grid{display:grid;gap:18px}
  .vip-grid-4{grid-template-columns:repeat(4,minmax(0,1fr))}
  .vip-grid-main{grid-template-columns:minmax(0,1.18fr) minmax(320px,.82fr)}
  .vip-grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}

  .vip-card{
    background:var(--vip-surface);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border:1px solid rgba(255,255,255,.55);
    border-radius:var(--vip-r);
    box-shadow:var(--vip-shadow-sm);
    position:relative;
  }

  .vip-card::before{
    content:"";
    position:absolute;
    inset:0;
    border-radius:inherit;
    pointer-events:none;
    background:linear-gradient(180deg, rgba(255,255,255,.30), rgba(255,255,255,0));
    opacity:.85;
  }

  .vip-card-inner{
    position:relative;
    z-index:1;
    padding:22px;
  }

  .vip-page-head{
    background:
      radial-gradient(circle at right top, rgba(79,70,229,.10), transparent 34%),
      linear-gradient(180deg, rgba(255,255,255,.96), rgba(255,255,255,.90));
    border:1px solid var(--vip-line);
    box-shadow:var(--vip-shadow);
    overflow:visible;
  }

  .vip-page-head-top{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:16px;
    flex-wrap:wrap;
  }

  .vip-page-head-main{
    min-width:260px;
    flex:1 1 620px;
  }

  .vip-page-kicker{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:8px 12px;
    border-radius:999px;
    background:rgba(79,70,229,.08);
    color:var(--vip-primary);
    border:1px solid rgba(79,70,229,.12);
    font-size:.72rem;
    font-weight:900;
    text-transform:uppercase;
    letter-spacing:.08em;
  }

  .vip-page-head-title{
    margin:12px 0 0;
    font-size:clamp(1.35rem, 2vw, 2rem);
    line-height:1.08;
    font-weight:900;
    letter-spacing:-.02em;
    color:var(--vip-text);
  }

  .vip-page-head-text{
    margin:8px 0 0;
    max-width:820px;
    line-height:1.65;
    color:var(--vip-muted);
    font-size:.96rem;
  }

  .vip-page-head-side{
    display:flex;
    align-items:center;
    gap:10px;
    flex-wrap:wrap;
  }

  .vip-page-head-actions{
    margin-top:18px;
  }

  .vip-toolbar{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:12px;
    flex-wrap:wrap;
  }

  .vip-section-title{
    margin:0;
    font-size:1rem;
    font-weight:900;
    color:var(--vip-text);
    letter-spacing:-.01em;
  }

  .vip-section-subtitle{
    margin-top:4px;
    color:var(--vip-muted);
    font-size:.92rem;
    line-height:1.55;
  }

  .vip-separator{
    height:1px;
    margin:16px 0;
    background:linear-gradient(90deg, transparent, var(--vip-line-strong), transparent);
  }

  .vip-actions{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    margin-top:18px;
  }

  .vip-btn{
    appearance:none;
    border:none;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    border-radius:16px;
    padding:12px 16px;
    font-weight:800;
    font-size:.88rem;
    text-decoration:none;
    cursor:pointer;
    transition:transform .18s ease, box-shadow .18s ease, background .18s ease, border-color .18s ease;
    position:relative;
  }

  .vip-btn:hover{
    transform:translateY(-1px);
    text-decoration:none;
  }

  .vip-btn-primary{
    color:#fff;
    background:linear-gradient(135deg, var(--vip-primary), var(--vip-primary-2));
    box-shadow:0 14px 34px rgba(79,70,229,.22);
  }

  .vip-btn-soft{
    color:var(--vip-text);
    background:rgba(255,255,255,.94);
    border:1px solid var(--vip-line);
    box-shadow:var(--vip-shadow-xs);
  }

  .vip-btn-soft:hover{
    background:#fff;
  }

  .vip-btn-danger{
    color:#b91c1c;
    background:rgba(239,68,68,.06);
    border:1px solid rgba(239,68,68,.16);
  }

  .vip-btn-xs{
    padding:8px 12px;
    font-size:.77rem;
    border-radius:13px;
  }

  .vip-kpi{
    overflow:hidden;
  }

  .vip-kpi .label{
    font-size:.76rem;
    font-weight:900;
    text-transform:uppercase;
    letter-spacing:.07em;
    color:var(--vip-muted);
  }

  .vip-kpi .value{
    margin-top:8px;
    font-size:1.72rem;
    font-weight:900;
    color:var(--vip-text);
    letter-spacing:-.02em;
  }

  .vip-kpi .hint{
    margin-top:7px;
    font-size:.87rem;
    color:var(--vip-muted);
    line-height:1.5;
  }

  .vip-kpi-accent::after{
    content:"";
    position:absolute;
    inset:auto 0 0 0;
    height:4px;
    background:linear-gradient(90deg, var(--vip-primary), var(--vip-cyan));
    opacity:.95;
  }

  .vip-filters{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    width:100%;
    align-items:flex-start;
  }

  .vip-input,
  .vip-select,
  .vip-textarea{
    width:100%;
    border:1px solid var(--vip-line);
    background:rgba(255,255,255,.95);
    border-radius:16px;
    padding:13px 14px;
    color:var(--vip-text);
    outline:none;
    transition:.18s ease;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.55);
  }

  .vip-input::placeholder,
  .vip-textarea::placeholder{
    color:rgba(15,23,42,.45);
  }

  .vip-input:focus,
  .vip-select:focus,
  .vip-textarea:focus{
    border-color:rgba(79,70,229,.34);
    box-shadow:0 0 0 4px rgba(79,70,229,.10);
  }

  .vip-label{
    display:block;
    margin-bottom:8px;
    color:var(--vip-text);
    font-size:.82rem;
    font-weight:900;
  }

  .vip-help{
    font-size:.82rem;
    color:var(--vip-muted);
    line-height:1.6;
  }

  .vip-form-grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:14px;
  }

  .vip-table-wrap{overflow:auto}

  .vip-table{
    width:100%;
    border-collapse:separate;
    border-spacing:0 10px;
  }

  .vip-table th{
    padding:0 14px 6px;
    font-size:.76rem;
    color:var(--vip-muted);
    text-transform:uppercase;
    letter-spacing:.07em;
    white-space:nowrap;
  }

  .vip-table td{
    padding:14px;
    background:var(--vip-surface-strong);
    color:var(--vip-text);
    border-top:1px solid var(--vip-line);
    border-bottom:1px solid var(--vip-line);
    vertical-align:middle;
  }

  .vip-table td:first-child{
    border-left:1px solid var(--vip-line);
    border-radius:16px 0 0 16px;
  }

  .vip-table td:last-child{
    border-right:1px solid var(--vip-line);
    border-radius:0 16px 16px 0;
  }

  .vip-id{
    font-weight:900;
    color:var(--vip-text);
  }

  .vip-row-title{
    font-weight:900;
    color:var(--vip-text);
    line-height:1.35;
  }

  .vip-row-sub{
    margin-top:5px;
    font-size:.84rem;
    color:var(--vip-muted);
  }

  .vip-row-actions{
    display:flex;
    gap:8px;
    justify-content:flex-end;
    flex-wrap:wrap;
  }

  .vip-badge{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:7px 10px;
    border-radius:999px;
    font-size:.73rem;
    font-weight:900;
    border:1px solid transparent;
    white-space:nowrap;
  }

  .vip-badge-neutral{
    background:rgba(15,23,42,.05);
    color:#334155;
    border-color:rgba(15,23,42,.08);
  }

  .vip-badge.open{
    background:rgba(239,68,68,.10);
    color:#b91c1c;
    border-color:rgba(239,68,68,.15);
  }

  .vip-badge.pending{
    background:rgba(245,158,11,.12);
    color:#b45309;
    border-color:rgba(245,158,11,.18);
  }

  .vip-badge.resolved{
    background:rgba(16,185,129,.12);
    color:#047857;
    border-color:rgba(16,185,129,.18);
  }

  .vip-badge.closed{
    background:rgba(15,23,42,.08);
    color:#334155;
    border-color:rgba(15,23,42,.10);
  }

  .vip-badge.low{
    background:rgba(6,182,212,.10);
    color:#0f766e;
    border-color:rgba(6,182,212,.15);
  }

  .vip-badge.medium{
    background:rgba(59,130,246,.10);
    color:#1d4ed8;
    border-color:rgba(59,130,246,.15);
  }

  .vip-badge.high{
    background:rgba(245,158,11,.12);
    color:#b45309;
    border-color:rgba(245,158,11,.18);
  }

  .vip-badge.critical{
    background:rgba(239,68,68,.10);
    color:#b91c1c;
    border-color:rgba(239,68,68,.15);
  }

  .vip-card-list{
    display:grid;
    gap:14px;
  }

  .vip-mini-card{
    padding:16px;
    border:1px solid var(--vip-line);
    border-radius:18px;
    background:var(--vip-surface-strong);
    transition:.18s ease;
  }

  .vip-mini-card:hover{
    transform:translateY(-1px);
    box-shadow:var(--vip-shadow-sm);
  }

  .vip-chip{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:8px 12px;
    border-radius:999px;
    border:1px solid var(--vip-line);
    background:#fff;
    color:var(--vip-text);
    font-weight:800;
    font-size:.8rem;
    cursor:pointer;
  }

  .vip-chip.is-active{
    background:linear-gradient(135deg, var(--vip-primary), var(--vip-primary-2));
    color:#fff;
    border-color:transparent;
  }

  .vip-preview{
    min-height:340px;
    padding:18px;
    border:1px solid var(--vip-line);
    border-radius:20px;
    background:linear-gradient(180deg, #fff, #fbfcff);
    white-space:pre-wrap;
  }

  .vip-preview-label{
    font-size:.76rem;
    color:var(--vip-muted);
    font-weight:900;
    text-transform:uppercase;
    letter-spacing:.07em;
  }

  .vip-preview-title{
    margin-top:8px;
    font-size:1rem;
    font-weight:900;
    color:var(--vip-text);
  }

  .vip-preview-body{
    margin-top:8px;
    line-height:1.72;
    color:var(--vip-text);
  }

  .vip-alert{
    display:flex;
    gap:10px;
    align-items:flex-start;
    padding:14px 16px;
    border-radius:18px;
    border:1px solid var(--vip-line);
    background:rgba(255,255,255,.88);
    box-shadow:var(--vip-shadow-xs);
    color:var(--vip-text);
  }

  .vip-alert-success{
    background:rgba(16,185,129,.08);
    border-color:rgba(16,185,129,.16);
  }

  .vip-alert-danger,
  .vip-alert-error{
    background:rgba(239,68,68,.08);
    border-color:rgba(239,68,68,.16);
  }

  .vip-alert-warning{
    background:rgba(245,158,11,.10);
    border-color:rgba(245,158,11,.16);
  }

  .vip-empty{
    padding:18px;
    text-align:center;
    border:1px dashed var(--vip-line-strong);
    border-radius:16px;
    background:rgba(255,255,255,.66);
    color:var(--vip-muted);
  }

  .vip-detail-grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:14px;
  }

  .vip-detail-item{
    padding:16px;
    border:1px solid var(--vip-line);
    border-radius:18px;
    background:var(--vip-surface-strong);
  }

  .vip-detail-item-full{
    grid-column:1 / -1;
  }

  .vip-detail-label{
    margin-bottom:8px;
    font-size:.76rem;
    font-weight:900;
    text-transform:uppercase;
    letter-spacing:.07em;
    color:var(--vip-muted);
  }

  .vip-detail-value{
    color:var(--vip-text);
    font-weight:700;
    line-height:1.55;
  }

  .vip-detail-title{
    font-size:1.04rem;
    font-weight:900;
    line-height:1.45;
  }

  .vip-detail-description{
    padding:16px;
    border:1px solid var(--vip-line);
    border-radius:16px;
    background:linear-gradient(180deg, #fff, #fbfcff);
    color:var(--vip-text);
    line-height:1.75;
    white-space:pre-wrap;
  }

  .vip-form .form-error-message,
  .vip-form ul{
    margin:.45rem 0 0;
    padding-left:1rem;
    color:#b91c1c;
    font-size:.84rem;
  }

  .vip-template-card{
    cursor:pointer;
  }

  .vip-template-card-top{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:12px;
  }

  .vip-template-main{
    min-width:0;
    flex:1 1 auto;
  }

  .vip-template-title{
    font-size:1rem;
    font-weight:900;
    color:var(--vip-text);
    line-height:1.4;
  }

  .vip-template-subject{
    margin-top:6px;
    color:var(--vip-muted);
    line-height:1.5;
    word-break:break-word;
  }

  .vip-template-bottom{
    margin-top:12px;
    display:flex;
    gap:8px;
    flex-wrap:wrap;
  }

  .vip-faq-question{
    font-size:1rem;
    font-weight:900;
    color:var(--vip-text);
    line-height:1.45;
  }

  .vip-faq-answer{
    margin-top:8px;
    color:var(--vip-muted);
    line-height:1.7;
  }

  @media (max-width:1100px){
    .vip-grid-4,
    .vip-grid-main,
    .vip-grid-2,
    .vip-form-grid,
    .vip-detail-grid{
      grid-template-columns:1fr;
    }

    .vip-detail-item-full{
      grid-column:auto;
    }
  }

  @media (max-width:720px){
    .vip-shell{padding:16px}
    .vip-card-inner{padding:16px}
    .vip-row-actions{justify-content:flex-start}
    .vip-actions{margin-top:14px}
    .vip-page-head-actions .vip-actions,
    .vip-page-head-actions{
      margin-top:14px;
    }
  }

  .vip-actions-nav{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
  }

  .vip-btn-current{
    position:relative;
    box-shadow:
      0 14px 34px rgba(79,70,229,.22),
      0 0 0 3px rgba(79,70,229,.10);
  }

  .vip-btn-current .vip-btn-dot{
    width:8px;
    height:8px;
    border-radius:999px;
    background:rgba(255,255,255,.95);
    box-shadow:0 0 0 4px rgba(255,255,255,.18);
    flex:0 0 auto;
  }

  .vip-btn-soft .vip-btn-dot{
    width:8px;
    height:8px;
    border-radius:999px;
    background:rgba(79,70,229,.22);
    flex:0 0 auto;
  }

  
</style>