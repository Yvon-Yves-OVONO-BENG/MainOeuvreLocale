{% extends 'base.html.twig' %}

{% block title %}{% trans %}KYC rules{% endtrans %}{% endblock %}

{% block body %}
<div class="container py-4">
  <div class="rounded-4 p-4 p-lg-5 border bg-white shadow-sm">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div>
        <div class="text-uppercase small text-muted fw-bold">{% trans %}Compliance{% endtrans %}</div>
        <h1 class="fw-bold mb-1">{% trans %}KYC Validation Rules{% endtrans %}</h1>
        <div class="text-muted">{% trans %}Règles de contrôle et de validation des profils.{% endtrans %}</div>
      </div>
      <a href="{{ path('admin_ops_index') }}" class="btn btn-dark rounded-pill px-4">
        {% trans %}Retour Ops Center{% endtrans %}
      </a>
    </div>

    <div class="row g-3 mt-3">
      {% for rule in rules %}
        <div class="col-12 col-lg-6">
          <div class="rounded-4 border p-4 h-100 bg-light-subtle">
            <div class="mb-2">
              <span class="badge rounded-pill text-bg-dark">{{ rule.severity }}</span>
            </div>
            <h5 class="fw-bold">{{ rule.title }}</h5>
            <p class="text-muted mb-0">{{ rule.description }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
{% endblock %}