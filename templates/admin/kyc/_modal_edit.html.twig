<div class="border-b border-slate-200/70 bg-[linear-gradient(180deg,rgba(255,255,255,.95),rgba(248,250,252,.92))] px-6 py-5">
  <div class="flex items-start justify-between gap-3">
    <div>
      <div class="text-xs font-semibold text-slate-500">{% trans %}Règles KYC{% endtrans %}</div>
      <div class="text-2xl font-black tracking-tight text-slate-900">✏️ {% trans %}Modifier la règle{% endtrans %}</div>
      <div class="mt-1 text-sm font-medium text-slate-600">{{ rule.label }}</div>
    </div>

    <button type="button"
        class="self-start inline-flex h-6 w-6 items-center justify-center rounded-md border border-slate-200/70 bg-white text-[10px] font-bold text-slate-400 shadow-[0_1px_6px_rgba(2,6,23,.04)] transition hover:bg-slate-50 hover:border-slate-300 hover:text-slate-600"
        data-kyc-close
        aria-label="{% trans %}Fermer{% endtrans %}">
      ✕
    </button>
  </div>
</div>

<div class="p-6">
  {{ form_start(form, {'attr': {'class': 'space-y-5', 'data-kyc-edit-form': '1'}}) }}
    <div class="grid gap-4 md:grid-cols-2">
      <div>
        <label class="mb-1 block text-xs font-extrabold uppercase tracking-wide text-slate-600">{% trans %}Clé technique{% endtrans %}</label>
        {{ form_widget(form.ruleKey, {'attr': {'class': 'w-full rounded-2xl border border-slate-200 bg-white px-3 py-3 text-sm font-semibold outline-none'}}) }}
        <div class="mt-1 text-xs text-rose-600">{{ form_errors(form.ruleKey) }}</div>
      </div>

      <div>
        <label class="mb-1 block text-xs font-extrabold uppercase tracking-wide text-slate-600">{% trans %}Libellé{% endtrans %}</label>
        {{ form_widget(form.label, {'attr': {'class': 'w-full rounded-2xl border border-slate-200 bg-white px-3 py-3 text-sm font-semibold outline-none'}}) }}
        <div class="mt-1 text-xs text-rose-600">{{ form_errors(form.label) }}</div>
      </div>
    </div>

    <div>
      <label class="mb-1 block text-xs font-extrabold uppercase tracking-wide text-slate-600">{% trans %}Description{% endtrans %}</label>
      {{ form_widget(form.description, {'attr': {'class': 'min-h-[150px] w-full rounded-2xl border border-slate-200 bg-white px-3 py-3 text-sm font-semibold outline-none'}}) }}
      <div class="mt-1 text-xs text-rose-600">{{ form_errors(form.description) }}</div>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      <div>
        <label class="mb-1 block text-xs font-extrabold uppercase tracking-wide text-slate-600">{% trans %}Groupe{% endtrans %}</label>
        {{ form_widget(form.groupName, {'attr': {'class': 'w-full rounded-2xl border border-slate-200 bg-white px-3 py-3 text-sm font-semibold outline-none'}}) }}
        <div class="mt-1 text-xs text-rose-600">{{ form_errors(form.groupName) }}</div>
      </div>

      <div>
        <label class="mb-1 block text-xs font-extrabold uppercase tracking-wide text-slate-600">{% trans %}Niveau{% endtrans %}</label>
        {{ form_widget(form.level, {'attr': {'class': 'w-full rounded-2xl border border-slate-200 bg-white px-3 py-3 text-sm font-semibold outline-none'}}) }}
        <div class="mt-1 text-xs text-rose-600">{{ form_errors(form.level) }}</div>
      </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-slate-50/70 px-4 py-3">
      <label class="inline-flex items-center gap-3 text-sm font-semibold text-slate-700">
        {{ form_widget(form.enabled, {'attr': {'class': 'h-4 w-4 rounded border-slate-300'}}) }}
        <span>{% trans %}Activer cette règle{% endtrans %}</span>
      </label>
      <div class="text-xs text-rose-600">{{ form_errors(form.enabled) }}</div>
    </div>

    {{ form_rest(form) }}

    <div class="flex flex-wrap gap-3 pt-2">
      <button type="submit"
              class="inline-flex items-center gap-2 rounded-2xl bg-gradient-to-br from-indigo-600 to-blue-600 px-5 py-3 text-sm font-extrabold text-white hover:opacity-95">
        ✅ {% trans %}Enregistrer{% endtrans %}
      </button>

      <button type="button"
              class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-extrabold text-slate-800 hover:bg-slate-50"
              data-kyc-close>
        {% trans %}Annuler{% endtrans %}
      </button>
    </div>
  {{ form_end(form) }}
</div>