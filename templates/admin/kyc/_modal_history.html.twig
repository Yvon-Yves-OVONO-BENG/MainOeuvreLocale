<div class="border-b border-slate-200/70 bg-[linear-gradient(180deg,rgba(255,255,255,.95),rgba(248,250,252,.92))] px-6 py-5">
  <div class="flex items-start justify-between gap-3">
    <div>
      <div class="text-xs font-semibold text-slate-500">{% trans %}Règles KYC{% endtrans %}</div>
      <div class="text-2xl font-black tracking-tight text-slate-900">📜 {% trans %}Historique{% endtrans %}</div>
      <div class="mt-1 text-sm font-medium text-slate-600">{{ rule.label }}</div>
    </div>

    <button type="button"
        class="self-start inline-flex h-6 w-6 items-center justify-center rounded-md border border-slate-200/70 bg-white text-[10px] font-bold text-slate-400 shadow-[0_1px_6px_rgba(2,6,23,.04)] transition hover:bg-slate-50 hover:border-slate-300 hover:text-slate-600"
        data-kyc-close
        aria-label="{% trans %}Fermer{% endtrans %}">
    ✕
  </button>
  </div>
</div>

<div class="p-6">
  <div class="space-y-3">
    {% for item in history %}
      {% set tone =
        item.tone == 'rose' ? 'border-rose-200/70 bg-rose-50 text-rose-700'
        : (item.tone == 'indigo' ? 'border-indigo-200/70 bg-indigo-50 text-indigo-700'
        : (item.tone == 'amber' ? 'border-amber-200/70 bg-amber-50 text-amber-700'
        : (item.tone == 'emerald' ? 'border-emerald-200/70 bg-emerald-50 text-emerald-700'
        : 'border-slate-200 bg-white text-slate-700')))
      %}
      <div class="rounded-2xl border p-4 {{ tone }}">
        <div class="text-[11px] font-extrabold uppercase tracking-wide opacity-80">{{ item.label }}</div>
        <div class="mt-1 text-sm font-black">{{ item.value }}</div>
      </div>
    {% endfor %}
  </div>

  <div class="mt-5 flex justify-end">
    <button type="button"
            class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-extrabold text-slate-800 hover:bg-slate-50"
            data-kyc-close>
      {% trans %}Fermer{% endtrans %}
    </button>
  </div>
</div>