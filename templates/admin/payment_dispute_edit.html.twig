{% extends 'base.html.twig' %}
{% block title %}{% trans %}Admin • Modifier litige{% endtrans %}{% endblock %}

{% block body %}
<script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-[calc(100vh-1px)] bg-[radial-gradient(1200px_circle_at_12%_10%,rgba(99,102,241,.14),transparent_55%),radial-gradient(900px_circle_at_90%_12%,rgba(6,182,212,.12),transparent_52%),linear-gradient(180deg,#f8fafc,#eef2ff_50%,#f8fafc)]">
  <div class="mx-auto max-w-4xl px-4 py-6">
    <section class="overflow-hidden rounded-3xl border border-slate-200/70 bg-white/80 shadow-[0_18px_55px_rgba(2,6,23,.10)] backdrop-blur-xl">
      <div class="border-b border-slate-200/70 bg-white/60 p-5">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <div class="text-xs font-semibold text-slate-500">{% trans %}Finance{% endtrans %}</div>
            <div class="text-2xl font-black tracking-tight text-slate-900">📝 {% trans %}Modifier le litige{% endtrans %} #{{ dispute.id }}</div>
          </div>

          <div class="flex flex-wrap gap-2">
            <a href="{{ path('admin_payment_dispute_show', {id: dispute.id}) }}"
               class="rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-extrabold text-slate-800 hover:bg-slate-50">
              👁️ {% trans %}Détails{% endtrans %}
            </a>
            <a href="{{ path('admin_payment_dispute_index') }}"
               class="rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-extrabold text-slate-800 hover:bg-slate-50">
              ← {% trans %}Retour liste{% endtrans %}
            </a>
          </div>
        </div>
      </div>

      <div class="p-5">
        {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
          {{ form_row(form.payment) }}
          {{ form_row(form.invoice) }}
          {{ form_row(form.reason) }}
          {{ form_row(form.priority) }}
          {{ form_row(form.status) }}
          {{ form_row(form.adminNote) }}

          <button class="rounded-2xl bg-gradient-to-br from-indigo-600 to-blue-600 px-5 py-3 text-sm font-extrabold text-white hover:opacity-95">
            {% trans %}Enregistrer les modifications{% endtrans %}
          </button>
        {{ form_end(form) }}
      </div>
    </section>
  </div>
</div>
{% endblock %}