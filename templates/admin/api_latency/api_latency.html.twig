{% extends 'base.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{% trans %}Performance API{% endtrans %}{% endblock %}

{% block body %}
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="min-h-screen bg-slate-50">
	<div class="mx-auto max-w-7xl px-4 py-6">
		<div class="mb-6">
			<h1 class="text-3xl font-black text-slate-900">⚡ {% trans %}Performance API{% endtrans %}</h1>
			<p class="mt-2 text-sm text-slate-500">
				{% trans %}Surveillance de la latence moyenne, des endpoints lents et des requêtes récentes.{% endtrans %}
			</p>
		</div>

		<div class="grid gap-4 md:grid-cols-4">
			<div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
				<div class="text-xs uppercase tracking-wider text-slate-400">{% trans %}Latence moyenne 24h{% endtrans %}</div>
				<div class="mt-2 text-3xl font-black text-slate-900">{{ avgLatency24h }}ms</div>
			</div>

			<div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
				<div class="text-xs uppercase tracking-wider text-slate-400">{% trans %}Pic max 24h{% endtrans %}</div>
				<div class="mt-2 text-3xl font-black text-slate-900">{{ maxLatency24h }}ms</div>
			</div>

			<div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
				<div class="text-xs uppercase tracking-wider text-slate-400">{% trans %}Requêtes lentes 24h{% endtrans %}</div>
				<div class="mt-2 text-3xl font-black text-slate-900">{{ slowRequests24h }}</div>
			</div>

			<div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
				<div class="text-xs uppercase tracking-wider text-slate-400">{% trans %}Requêtes API 24h{% endtrans %}</div>
				<div class="mt-2 text-3xl font-black text-slate-900">{{ requests24h }}</div>
			</div>
		</div>

		<div class="mt-6 grid gap-6 xl:grid-cols-12">
			<div class="xl:col-span-7 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
				<div class="mb-4">
					<div class="text-lg font-bold text-slate-900">{% trans %}Évolution de la latence{% endtrans %}</div>
					<div class="text-sm text-slate-500">{% trans %}Latence moyenne par jour sur 7 jours{% endtrans %}</div>
				</div>
				<div class="h-[320px]">
					<canvas id="latencyChart"></canvas>
				</div>
			</div>

			<div class="xl:col-span-5 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
				<div class="mb-4">
					<div class="text-lg font-bold text-slate-900">{% trans %}Top endpoints lents{% endtrans %}</div>
					<div class="text-sm text-slate-500">{% trans %}Moyenne sur les dernières 24h{% endtrans %}</div>
				</div>

				<div class="space-y-3">
					{% for item in topSlowEndpoints %}
						<div class="rounded-2xl border border-slate-200 bg-slate-50 p-3">
							<div class="flex items-start justify-between gap-3">
								<div>
									<div class="font-semibold text-slate-900">{{ item.method }} {{ item.path }}</div>
									<div class="mt-1 text-xs text-slate-500">
										{{ item.hits }} hits • max {{ item.max_latency }}ms
									</div>
								</div>
								<span class="inline-flex rounded-full border border-slate-200 bg-white px-2.5 py-1 text-xs font-bold text-slate-700">
									{{ item.avg_latency }}ms
								</span>
							</div>
						</div>
					{% else %}
						<div class="text-sm text-slate-400">{% trans %}Aucune donnée disponible{% endtrans %}</div>
					{% endfor %}
				</div>
			</div>
		</div>

		<div class="mt-6 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
			<div class="mb-4 text-lg font-bold text-slate-900">{% trans %}Dernières requêtes API{% endtrans %}</div>

			<div class="overflow-x-auto">
				<table class="min-w-full text-sm">
					<thead>
						<tr class="text-left text-slate-500">
							<th class="px-3 py-2">{% trans %}Méthode{% endtrans %}</th>
							<th class="px-3 py-2">Path</th>
							<th class="px-3 py-2">{% trans %}Route{% endtrans %}</th>
							<th class="px-3 py-2">{% trans %}Code{% endtrans %}</th>
							<th class="px-3 py-2">{% trans %}Temps{% endtrans %}</th>
							<th class="px-3 py-2">{% trans %}Date{% endtrans %}</th>
						</tr>
					</thead>
					<tbody>
						{% for log in latestLogs %}
							<tr class="border-t border-slate-100">
								<td class="px-3 py-3 font-semibold text-slate-800">{{ log.method }}</td>
								<td class="px-3 py-3 text-slate-700">{{ log.path }}</td>
								<td class="px-3 py-3 text-slate-500">{{ log.routeName ?? '-' }}</td>
								<td class="px-3 py-3 text-slate-700">{{ log.statusCode }}</td>
								<td class="px-3 py-3">
									<span class="{% if log.responseTimeMs >= 500 %}text-rose-600{% elseif log.responseTimeMs >= 250 %}text-amber-600{% else %}text-emerald-600{% endif %} font-bold">
										{{ log.responseTimeMs }}ms
									</span>
								</td>
								<td class="px-3 py-3 text-slate-500">{{ log.createdAt ? log.createdAt|date('d/m/Y H:i:s') : '-' }}</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="6" class="px-3 py-6 text-center text-slate-400">
									{% trans %}Aucune donnée de latence disponible{% endtrans %}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>

<script>
(function () {
	const raw = {{ latencySeries|json_encode|raw }};
	const labels = raw.map(item => item.dte);
	const values = raw.map(item => parseInt(item.avg_latency, 10) || 0);

	const el = document.getElementById('latencyChart');
	if (!el) return;

	new Chart(el, {
		type: 'line',
		data: {
			labels,
			datasets: [{
				label: 'Latency ms',
				data: values,
				tension: 0.35,
				fill: true,
				borderColor: '#06b6d4',
				backgroundColor: 'rgba(6,182,212,.12)',
				pointRadius: 3,
				pointHoverRadius: 5,
				borderWidth: 2
			}]
		},
		options: {
			responsive: true,
			maintainAspectRatio: false,
			plugins: {
				legend: {
					display: true
				}
			},
			scales: {
				x: {
					grid: {
						display: false
					}
				},
				y: {
					beginAtZero: true,
					grid: {
						color: 'rgba(15,23,42,.06)'
					}
				}
			}
		}
	});
})();
</script>
{% endblock %}