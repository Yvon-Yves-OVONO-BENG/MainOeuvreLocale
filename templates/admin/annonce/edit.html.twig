{% extends 'base.html.twig' %}

{% block title %}Modifier l’annonce — Modération{% endblock %}

{% block body %}
<script src="{{ asset('js/annonce/form.js') }}" defer></script>

<style>
    .anedit-page{--navy:#071a38;--blue:#155eef;width:calc(100% - 32px);max-width:1520px;margin:0 auto;padding:48px 0 72px;color:#14213a}.anedit-hero{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;padding:30px;border-radius:26px;background:linear-gradient(125deg,#06172f,#123e83 58%,#087b9f);color:#fff;box-shadow:0 24px 65px rgba(6,23,47,.2)}.anedit-kicker{display:inline-flex;gap:7px;align-items:center;padding:7px 11px;border:1px solid rgba(255,255,255,.22);border-radius:999px;background:rgba(255,255,255,.1);font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.08em}.anedit-hero h1{margin:10px 0 5px;font-size:clamp(25px,4vw,38px);font-weight:950;letter-spacing:-.04em}.anedit-hero p{margin:0;color:rgba(255,255,255,.74)}.anedit-back{display:inline-flex;align-items:center;gap:8px;padding:11px 15px;border:1px solid rgba(255,255,255,.25);border-radius:13px;background:rgba(255,255,255,.1);color:#fff;text-decoration:none;font-weight:850}.anedit-layout{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:20px;margin-top:20px}.anedit-card{border:1px solid #e0e8f2;border-radius:23px;background:#fff;box-shadow:0 17px 48px rgba(16,42,84,.08);overflow:hidden}.anedit-head{padding:20px 22px;border-bottom:1px solid #e8edf4}.anedit-head h2{margin:0;color:#102a54;font-size:18px;font-weight:950}.anedit-head p{margin:5px 0 0;color:#74839a;font-size:12px}.anedit-body{padding:24px}.anedit-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.anedit-full{grid-column:1/-1}.anedit-grid label{display:block;margin:0 0 7px;color:#263b5d;font-size:12px;font-weight:900}.anedit-grid input:not([type=checkbox]),.anedit-grid select,.anedit-grid textarea{width:100%;min-height:48px;border:1px solid #d9e2ee;border-radius:13px;background:#f8fafd;padding:11px 13px;outline:0}.anedit-grid textarea{min-height:150px;resize:vertical}.anedit-grid input:focus,.anedit-grid select:focus,.anedit-grid textarea:focus{border-color:#76a7ff;background:#fff;box-shadow:0 0 0 4px rgba(21,94,239,.09)}.anedit-errors{color:#c52b41;font-size:11px}.anedit-switch{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:15px;border:1px solid #dce7f1;border-radius:16px;background:#f8fbfe}.anedit-switch strong,.anedit-switch small{display:block}.anedit-switch small{margin-top:4px;color:#718097;font-size:11px}.anedit-switch input{width:21px;height:21px}.anedit-actions{display:flex;justify-content:flex-end;gap:10px;flex-wrap:wrap;margin-top:22px;padding-top:18px;border-top:1px solid #e8edf4}.anedit-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:45px;padding:0 17px;border:0;border-radius:13px;text-decoration:none;font-size:12px;font-weight:900}.anedit-cancel{background:#eef2f7;color:#526278}.anedit-save{background:linear-gradient(135deg,#155eef,#087b9f);color:#fff;box-shadow:0 10px 24px rgba(21,94,239,.22)}.anedit-side{padding:20px}.anedit-side h3{color:#102a54;font-size:16px;font-weight:950}.anedit-owner{margin:13px 0;padding:13px;border-radius:14px;background:#f2f7ff;color:#425575;font-size:12px;overflow-wrap:anywhere}.anedit-status{display:grid;gap:9px}.anedit-pill{display:flex;align-items:center;gap:8px;padding:10px;border-radius:12px;background:#f7f9fc;color:#56657b;font-size:11px}.anedit-pill i{width:20px;color:#155eef;text-align:center}@media(max-width:860px){.anedit-page{width:calc(100% - 24px);padding-top:32px}.anedit-layout{grid-template-columns:1fr}.anedit-grid{grid-template-columns:1fr}.anedit-full{grid-column:auto}}@media(max-width:560px){.anedit-page{width:calc(100% - 20px);padding:24px 0 55px}.anedit-hero{padding:22px 18px}.anedit-body{padding:17px}.anedit-actions{flex-direction:column-reverse}.anedit-btn{width:100%}}
</style>

<main class="anedit-page">
    <section class="anedit-hero">
        <div>
            <span class="anedit-kicker"><i class="fa-solid fa-shield-halved"></i> Modération</span>
            <h1>Modifier l’annonce</h1>
            <p>Corrigez les informations sans changer l’auteur de la publication.</p>
        </div>
        <a class="anedit-back" href="{{ path('admin_annonces_moderation') }}" data-turbo="false"><i class="fa-solid fa-arrow-left"></i> Retour à la modération</a>
    </section>

    <div class="anedit-layout">
        <section class="anedit-card">
            <header class="anedit-head">
                <h2>{{ annonce.titre }}</h2>
                <p>Annonce #{{ annonce.id }} — créée le {{ annonce.dateCreation|date('d/m/Y à H:i') }}</p>
            </header>
            <div class="anedit-body">
                {{ form_start(form, {'attr': {'data-turbo': 'false'}}) }}
                    <div class="anedit-grid">
                        <div class="anedit-full">
                            {{ form_label(form.titre) }}
                            {{ form_widget(form.titre) }}
                            <div class="anedit-errors">{{ form_errors(form.titre) }}</div>
                        </div>
                        <div>
                            {{ form_label(form.categorie) }}
                            {{ form_widget(form.categorie, {'attr': {'class': 'form-select js-annonce-categorie', 'data-professions-url': path('api_professions_by_category', {'id': 0})}}) }}
                            <div class="anedit-errors">{{ form_errors(form.categorie) }}</div>
                        </div>
                        <div>
                            {{ form_label(form.profession) }}
                            {{ form_widget(form.profession, {'attr': {'class': 'form-select js-annonce-profession'}}) }}
                            <div class="anedit-errors">{{ form_errors(form.profession) }}</div>
                        </div>
                        <div>
                            {{ form_label(form.ville) }}
                            {{ form_widget(form.ville) }}
                            <div class="anedit-errors">{{ form_errors(form.ville) }}</div>
                        </div>
                        <div>
                            {{ form_label(form.salaireJournalier) }}
                            {{ form_widget(form.salaireJournalier) }}
                            <div class="anedit-errors">{{ form_errors(form.salaireJournalier) }}</div>
                        </div>
                        <div class="anedit-full">
                            {{ form_label(form.description) }}
                            {{ form_widget(form.description) }}
                            <div class="anedit-errors">{{ form_errors(form.description) }}</div>
                        </div>
                        <div class="anedit-full">
                            <div class="anedit-switch">
                                <div><strong>Affichage demandé</strong><small>Désactiver ce choix retire aussi l’annonce de la publication.</small></div>
                                {{ form_widget(form.afficherMaintenant) }}
                            </div>
                            <div class="anedit-errors">{{ form_errors(form.afficherMaintenant) }}</div>
                        </div>
                    </div>
                    <div class="anedit-actions">
                        <a class="anedit-btn anedit-cancel" href="{{ path('admin_annonces_moderation') }}">Annuler</a>
                        <button class="anedit-btn anedit-save" type="submit"><i class="fa-solid fa-floppy-disk"></i> Enregistrer les modifications</button>
                    </div>
                {{ form_end(form) }}
            </div>
        </section>

        <aside class="anedit-card anedit-side">
            <h3>Informations de contrôle</h3>
            <div class="anedit-owner">
                <strong>Auteur</strong><br>
                {{ annonce.user.personalProfile ? annonce.user.personalProfile.fullName : annonce.user.email }}<br>
                <small>{{ annonce.user.email }}</small>
            </div>
            <div class="anedit-status">
                <div class="anedit-pill"><i class="fa-solid fa-eye"></i>{{ annonce.afficherMaintenant ? 'Affichage demandé' : 'Hors affichage' }}</div>
                <div class="anedit-pill"><i class="fa-solid fa-circle-check"></i>{{ annonce.publier ? 'Actuellement publiée' : 'Non publiée' }}</div>
                <div class="anedit-pill"><i class="fa-solid fa-user-shield"></i>{{ annonce.publiePar ? 'Publiée par ' ~ annonce.publiePar.email : 'Aucun validateur' }}</div>
            </div>
        </aside>
    </div>
</main>
{% endblock %}
