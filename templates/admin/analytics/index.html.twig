{% extends 'base.html.twig' %}
{% block title %}{% trans %}Admin • Analytics{% endtrans %}{% endblock %}

{% block body %}
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="min-h-[calc(100vh-1px)] bg-[radial-gradient(1200px_circle_at_12%_10%,rgba(99,102,241,.14),transparent_55%),radial-gradient(900px_circle_at_90%_12%,rgba(6,182,212,.12),transparent_52%),radial-gradient(900px_circle_at_22%_88%,rgba(16,185,129,.10),transparent_55%),linear-gradient(180deg,#f8fafc,#eef2ff_50%,#f8fafc)] text-slate-900">
  <div class="mx-auto max-w-[1440px] px-4 py-6 lg:py-8 space-y-6">

    <section class="overflow-hidden rounded-3xl border border-slate-200/70 bg-white/70 backdrop-blur-xl shadow-[0_18px_55px_rgba(2,6,23,.10)]">
      <div class="bg-[radial-gradient(900px_circle_at_15%_10%,rgba(99,102,241,.16),transparent_60%),radial-gradient(800px_circle_at_90%_30%,rgba(6,182,212,.12),transparent_60%),linear-gradient(180deg,rgba(255,255,255,.90),rgba(255,255,255,.72))] p-5">
        <div class="flex flex-col gap-4 xl:flex-row xl:items-start xl:justify-between">
          <div>
            <div class="text-sm font-semibold text-slate-500">{% trans %}Pilotage • Performance • Finance • Risque{% endtrans %}</div>
            <h1 class="mt-1 text-2xl sm:text-3xl font-black tracking-tight text-slate-900">📊 {% trans %}Centre Analytics{% endtrans %}</h1>
            <p class="mt-2 max-w-3xl text-sm font-medium text-slate-600">
              {% trans %}Vision consolidée de la plateforme avec indicateurs intelligents, deltas, risques et tendances.{% endtrans %}
            </p>

            <div class="mt-4 flex flex-wrap gap-2">
              <span class="inline-flex items-center gap-2 rounded-full border border-indigo-200/70 bg-indigo-50 px-3 py-1.5 text-[11px] font-extrabold text-indigo-700">
                👥 {% trans %}Utilisateurs{% endtrans %} : {{ summary.users|number_format(0, ',', ' ') }}
              </span>
              <span class="inline-flex items-center gap-2 rounded-full border border-cyan-200/70 bg-cyan-50 px-3 py-1.5 text-[11px] font-extrabold text-cyan-700">
                📣 {% trans %}Offres actives{% endtrans %} : {{ summary.activeJobs|number_format(0, ',', ' ') }}
              </span>
              <span class="inline-flex items-center gap-2 rounded-full border border-emerald-200/70 bg-emerald-50 px-3 py-1.5 text-[11px] font-extrabold text-emerald-700">
                💰 {% trans %}Revenus{% endtrans %} : {{ summary.revenue|number_format(0, ',', ' ') }}
              </span>
              <span class="inline-flex items-center gap-2 rounded-full border border-rose-200/70 bg-rose-50 px-3 py-1.5 text-[11px] font-extrabold text-rose-700">
                🚨 {% trans %}Risques{% endtrans %} : {{ summary.openReports + summary.pendingJobReports + summary.openDisputes }}
              </span>
            </div>
          </div>

          <div class="flex flex-wrap gap-2">
            <a href="{{ path('tableau_de_bord') }}"
               class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-extrabold text-slate-800 shadow-[0_10px_30px_rgba(2,6,23,.06)] hover:bg-slate-50">
              ← {% trans %}Tableau de bord{% endtrans %}
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="rounded-3xl border border-slate-200/70 bg-white/70 p-4 shadow-[0_18px_55px_rgba(2,6,23,.10)] backdrop-blur-xl">
      <form method="get" class="grid gap-3 lg:grid-cols-[220px,220px,1fr]">
        <select name="range" class="rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold text-slate-800 outline-none">
          <option value="7d" {{ range == '7d' ? 'selected' : '' }}>{% trans %}7 jours{% endtrans %}</option>
          <option value="30d" {{ range == '30d' ? 'selected' : '' }}>{% trans %}30 jours{% endtrans %}</option>
          <option value="90d" {{ range == '90d' ? 'selected' : '' }}>{% trans %}90 jours{% endtrans %}</option>
          <option value="12m" {{ range == '12m' ? 'selected' : '' }}>{% trans %}12 mois{% endtrans %}</option>
        </select>

        <select name="segment" class="rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold text-slate-800 outline-none">
          <option value="global" {{ segment == 'global' ? 'selected' : '' }}>{% trans %}Global{% endtrans %}</option>
          <option value="users" {{ segment == 'users' ? 'selected' : '' }}>{% trans %}Users{% endtrans %}</option>
          <option value="jobs" {{ segment == 'jobs' ? 'selected' : '' }}>{% trans %}Jobs{% endtrans %}</option>
          <option value="finance" {{ segment == 'finance' ? 'selected' : '' }}>{% trans %}Finance{% endtrans %}</option>
          <option value="risk" {{ segment == 'risk' ? 'selected' : '' }}>{% trans %}Risk{% endtrans %}</option>
        </select>

        <div class="flex justify-end">
          <button class="inline-flex items-center gap-2 rounded-2xl bg-gradient-to-br from-indigo-600 to-blue-600 px-5 py-2.5 text-sm font-extrabold text-white hover:opacity-95">
            🔎 {% trans %}Actualiser{% endtrans %}
          </button>
        </div>
      </form>
    </section>

    <section class="grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
      {% set globalCards = [
        {'label':'Nouveaux users','value':users.kpis.newUsers, 'delta':users.kpis.newUsersDelta, 'tone':'indigo'},
        {'label':'Nouvelles offres','value':jobs.kpis.newJobs, 'delta':jobs.kpis.newJobsDelta, 'tone':'cyan'},
        {'label':'Paiements','value':finance.kpis.paymentsCount, 'delta':finance.kpis.paymentsDelta, 'tone':'emerald'},
        {'label':'Abonnements','value':finance.kpis.newSubscriptions, 'delta':finance.kpis.newSubscriptionsDelta, 'tone':'violet'},
        {'label':'Signalements','value':risk.reports.kpis.newReports + risk.jobReports.kpis.newJobReports, 'delta':risk.reports.kpis.newReportsDelta, 'tone':'rose'}
      ] %}

      {% for c in globalCards %}
        {% set tone = c.tone %}
        <div class="rounded-3xl border p-4 shadow-[0_12px_35px_rgba(2,6,23,.08)]
          {{ tone == 'indigo' ? 'border-indigo-200/70 bg-indigo-50/70' :
             (tone == 'cyan' ? 'border-cyan-200/70 bg-cyan-50/70' :
             (tone == 'emerald' ? 'border-emerald-200/70 bg-emerald-50/70' :
             (tone == 'violet' ? 'border-violet-200/70 bg-violet-50/70' :
             'border-rose-200/70 bg-rose-50/70'))) }}">
          <div class="text-xs font-semibold text-slate-600">{{ c.label|trans }}</div>
          <div class="mt-1 text-3xl font-black tracking-tight text-slate-900">{{ c.value|number_format(0, ',', ' ') }}</div>
          <div class="mt-2 text-xs font-extrabold {{ c.delta >= 0 ? 'text-emerald-700' : 'text-rose-700' }}">
            {{ c.delta >= 0 ? '+' : '' }}{{ c.delta }}%
          </div>
        </div>
      {% endfor %}
    </section>

    <section class="rounded-3xl border border-slate-200/70 bg-white/70 p-2 shadow-[0_18px_55px_rgba(2,6,23,.10)] backdrop-blur-xl">
      <div class="flex flex-wrap gap-2">
        {% set tabs = [
          {'id':'tab-global','label':'Global'},
          {'id':'tab-users','label':'Users'},
          {'id':'tab-jobs','label':'Jobs'},
          {'id':'tab-finance','label':'Finance'},
          {'id':'tab-risk','label':'Risk'}
        ] %}
        {% for t in tabs %}
          <button type="button"
                  data-tab-target="{{ t.id }}"
                  class="js-analytics-tab inline-flex items-center gap-2 rounded-2xl px-4 py-2.5 text-sm font-extrabold transition {{ loop.first ? 'bg-slate-900 text-white' : 'bg-white text-slate-700 border border-slate-200 hover:bg-slate-50' }}">
            {{ t.label|trans }}
          </button>
        {% endfor %}
      </div>
    </section>

    <section id="tab-global" class="analytics-panel space-y-4">
      <div class="grid gap-4 xl:grid-cols-2">
        <div class="rounded-3xl border border-slate-200/70 bg-white/70 overflow-hidden">
          <div class="px-5 py-4 border-b bg-white/60 text-sm font-extrabold text-slate-900">📈 {% trans %}Croissance utilisateurs{% endtrans %}</div>
          <div class="p-4"><div class="rounded-2xl border border-slate-200 bg-white p-3 h-[320px]"><canvas id="signupsChart"></canvas></div></div>
        </div>
        <div class="rounded-3xl border border-slate-200/70 bg-white/70 overflow-hidden">
          <div class="px-5 py-4 border-b bg-white/60 text-sm font-extrabold text-slate-900">💰 {% trans %}Revenus{% endtrans %}</div>
          <div class="p-4"><div class="rounded-2xl border border-slate-200 bg-white p-3 h-[320px]"><canvas id="revenueChart"></canvas></div></div>
        </div>
      </div>

      <div class="grid gap-4 xl:grid-cols-3">
        {% for a in alerts %}
          <div class="rounded-3xl border p-4
            {{ a.level == 'high' ? 'border-rose-200/70 bg-rose-50' :
               (a.level == 'medium' ? 'border-amber-200/70 bg-amber-50' :
               'border-slate-200 bg-white') }}">
            <div class="text-sm font-extrabold
              {{ a.level == 'high' ? 'text-rose-700' :
                 (a.level == 'medium' ? 'text-amber-700' : 'text-slate-800') }}">
              {{ a.title }}
            </div>
            <div class="mt-1 text-xs font-semibold text-slate-600">{{ a.description }}</div>
          </div>
        {% endfor %}
      </div>
    </section>

    <section id="tab-users" class="analytics-panel hidden space-y-4">
      <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-3xl border border-slate-200/70 bg-white/70 p-4"><div class="text-xs font-semibold text-slate-500">{% trans %}Total{% endtrans %}</div><div class="mt-1 text-3xl font-black">{{ users.kpis.totalUsers|number_format(0, ',', ' ') }}</div></div>
        <div class="rounded-3xl border border-emerald-200/70 bg-emerald-50/70 p-4"><div class="text-xs font-semibold text-emerald-700">{% trans %}Actifs{% endtrans %}</div><div class="mt-1 text-3xl font-black text-emerald-900">{{ users.kpis.activeUsers|number_format(0, ',', ' ') }}</div></div>
        <div class="rounded-3xl border border-cyan-200/70 bg-cyan-50/70 p-4"><div class="text-xs font-semibold text-cyan-700">{% trans %}Vérifiés{% endtrans %}</div><div class="mt-1 text-3xl font-black text-cyan-900">{{ users.kpis.verifiedUsers|number_format(0, ',', ' ') }}</div></div>
      </div>

      <div class="grid gap-4 xl:grid-cols-2">
        <div class="rounded-3xl border border-slate-200/70 bg-white/70 overflow-hidden">
          <div class="px-5 py-4 border-b bg-white/60 text-sm font-extrabold text-slate-900">🧩 {% trans %}Répartition rôles{% endtrans %}</div>
          <div class="p-4 space-y-3">
            {% for key, value in users.roleStats %}
              <div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-white px-4 py-3">
                <span class="text-sm font-semibold text-slate-700">{{ key|trans }}</span>
                <span class="font-black text-slate-900">{{ value }}</span>
              </div>
            {% endfor %}
          </div>
        </div>

        <div class="rounded-3xl border border-slate-200/70 bg-white/70 overflow-hidden">
          <div class="px-5 py-4 border-b bg-white/60 text-sm font-extrabold text-slate-900">🆕 {% trans %}Dernières inscriptions{% endtrans %}</div>
          <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
              <tbody class="divide-y divide-slate-200/70">
                {% for u in users.recentUsers %}
                  <tr>
                    <td class="px-5 py-3 font-bold text-slate-900">{{ u.email }}</td>
                    <td class="px-5 py-3 text-slate-700">{{ u.createdAt ? u.createdAt|date('d/m/Y H:i') : '—' }}</td>
                  </tr>
                {% else %}
                  <tr><td colspan="2" class="px-5 py-8 text-center text-sm font-semibold text-slate-500">{% trans %}Aucune donnée.{% endtrans %}</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section id="tab-jobs" class="analytics-panel hidden space-y-4">
      <div class="grid gap-4 md:grid-cols-4">
        <div class="rounded-3xl border border-slate-200/70 bg-white/70 p-4"><div class="text-xs font-semibold text-slate-500">{% trans %}Total offres{% endtrans %}</div><div class="mt-1 text-3xl font-black">{{ jobs.kpis.totalJobs|number_format(0, ',', ' ') }}</div></div>
        <div class="rounded-3xl border border-cyan-200/70 bg-cyan-50/70 p-4"><div class="text-xs font-semibold text-cyan-700">{% trans %}Actives{% endtrans %}</div><div class="mt-1 text-3xl font-black text-cyan-900">{{ jobs.kpis.activeJobs|number_format(0, ',', ' ') }}</div></div>
        <div class="rounded-3xl border border-rose-200/70 bg-rose-50/70 p-4"><div class="text-xs font-semibold text-rose-700">{% trans %}Expirées{% endtrans %}</div><div class="mt-1 text-3xl font-black text-rose-900">{{ jobs.kpis.expiredJobs|number_format(0, ',', ' ') }}</div></div>
        <div class="rounded-3xl border border-indigo-200/70 bg-indigo-50/70 p-4"><div class="text-xs font-semibold text-indigo-700">{% trans %}Nouvelles{% endtrans %}</div><div class="mt-1 text-3xl font-black text-indigo-900">{{ jobs.kpis.newJobs|number_format(0, ',', ' ') }}</div></div>
      </div>

      <div class="grid gap-4 xl:grid-cols-2">
        <div class="rounded-3xl border border-slate-200/70 bg-white/70 overflow-hidden">
          <div class="px-5 py-4 border-b bg-white/60 text-sm font-extrabold text-slate-900">📣 {% trans %}Publications d’offres{% endtrans %}</div>
          <div class="p-4"><div class="rounded-2xl border border-slate-200 bg-white p-3 h-[320px]"><canvas id="jobsChart"></canvas></div></div>
        </div>
        <div class="rounded-3xl border border-slate-200/70 bg-white/70 overflow-hidden">
          <div class="px-5 py-4 border-b bg-white/60 text-sm font-extrabold text-slate-900">🌍 {% trans %}Top villes{% endtrans %}</div>
          <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
              <tbody class="divide-y divide-slate-200/70">
                {% for row in jobs.topCities %}
                  <tr><td class="px-5 py-3 font-bold text-slate-900">{{ row.city }}</td><td class="px-5 py-3 text-slate-700 font-semibold">{{ row.total }}</td></tr>
                {% else %}
                  <tr><td colspan="2" class="px-5 py-8 text-center text-sm font-semibold text-slate-500">{% trans %}Aucune donnée.{% endtrans %}</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section id="tab-finance" class="analytics-panel hidden space-y-4">
      <div class="grid gap-4 md:grid-cols-4">
        <div class="rounded-3xl border border-emerald-200/70 bg-emerald-50/70 p-4"><div class="text-xs font-semibold text-emerald-700">{% trans %}Paiements{% endtrans %}</div><div class="mt-1 text-3xl font-black text-emerald-900">{{ finance.kpis.paymentsCount|number_format(0, ',', ' ') }}</div></div>
        <div class="rounded-3xl border border-amber-200/70 bg-amber-50/70 p-4"><div class="text-xs font-semibold text-amber-700">{% trans %}Revenus{% endtrans %}</div><div class="mt-1 text-3xl font-black text-amber-900">{{ finance.kpis.revenueTotal|number_format(0, ',', ' ') }}</div></div>
        <div class="rounded-3xl border border-indigo-200/70 bg-indigo-50/70 p-4"><div class="text-xs font-semibold text-indigo-700">{% trans %}Factures{% endtrans %}</div><div class="mt-1 text-3xl font-black text-indigo-900">{{ finance.kpis.invoicesCount|number_format(0, ',', ' ') }}</div></div>
        <div class="rounded-3xl border border-violet-200/70 bg-violet-50/70 p-4"><div class="text-xs font-semibold text-violet-700">{% trans %}Abonnements actifs{% endtrans %}</div><div class="mt-1 text-3xl font-black text-violet-900">{{ finance.kpis.activeSubscriptions|number_format(0, ',', ' ') }}</div></div>
      </div>

      <div class="grid gap-4 xl:grid-cols-3">
        <div class="rounded-3xl border border-slate-200/70 bg-white/70 overflow-hidden">
          <div class="px-5 py-4 border-b bg-white/60 text-sm font-extrabold text-slate-900">💳 {% trans %}Paiements{% endtrans %}</div>
          <div class="p-4"><div class="rounded-2xl border border-slate-200 bg-white p-3 h-[280px]"><canvas id="paymentsChart"></canvas></div></div>
        </div>
        <div class="rounded-3xl border border-slate-200/70 bg-white/70 overflow-hidden">
          <div class="px-5 py-4 border-b bg-white/60 text-sm font-extrabold text-slate-900">🧾 {% trans %}Factures{% endtrans %}</div>
          <div class="p-4"><div class="rounded-2xl border border-slate-200 bg-white p-3 h-[280px]"><canvas id="invoicesChart"></canvas></div></div>
        </div>
        <div class="rounded-3xl border border-slate-200/70 bg-white/70 overflow-hidden">
          <div class="px-5 py-4 border-b bg-white/60 text-sm font-extrabold text-slate-900">📦 {% trans %}Abonnements{% endtrans %}</div>
          <div class="p-4"><div class="rounded-2xl border border-slate-200 bg-white p-3 h-[280px]"><canvas id="subscriptionsChart"></canvas></div></div>
        </div>
      </div>

      <div class="grid gap-4 xl:grid-cols-2">
        <div class="rounded-3xl border border-slate-200/70 bg-white/70 overflow-hidden">
          <div class="px-5 py-4 border-b bg-white/60 text-sm font-extrabold text-slate-900">🏦 {% trans %}Top fournisseurs{% endtrans %}</div>
          <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
              <tbody class="divide-y divide-slate-200/70">
                {% for row in finance.topProviders %}
                  <tr><td class="px-5 py-3 font-bold text-slate-900">{{ row.provider ?: '—' }}</td><td class="px-5 py-3 text-slate-700 font-semibold">{{ row.total }}</td></tr>
                {% else %}
                  <tr><td colspan="2" class="px-5 py-8 text-center text-sm font-semibold text-slate-500">{% trans %}Aucune donnée.{% endtrans %}</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>

        <div class="rounded-3xl border border-slate-200/70 bg-white/70 overflow-hidden">
          <div class="px-5 py-4 border-b bg-white/60 text-sm font-extrabold text-slate-900">📦 {% trans %}Top plans{% endtrans %}</div>
          <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
              <tbody class="divide-y divide-slate-200/70">
                {% for row in finance.topPlans %}
                  <tr><td class="px-5 py-3 font-bold text-slate-900">{{ row.planName ?: '—' }}</td><td class="px-5 py-3 text-slate-700 font-semibold">{{ row.total }}</td></tr>
                {% else %}
                  <tr><td colspan="2" class="px-5 py-8 text-center text-sm font-semibold text-slate-500">{% trans %}Aucune donnée.{% endtrans %}</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section id="tab-risk" class="analytics-panel hidden space-y-4">
      <div class="grid gap-4 md:grid-cols-4">
        <div class="rounded-3xl border border-rose-200/70 bg-rose-50/70 p-4"><div class="text-xs font-semibold text-rose-700">{% trans %}Comptes signalés ouverts{% endtrans %}</div><div class="mt-1 text-3xl font-black text-rose-900">{{ risk.reports.kpis.openReports|number_format(0, ',', ' ') }}</div></div>
        <div class="rounded-3xl border border-fuchsia-200/70 bg-fuchsia-50/70 p-4"><div class="text-xs font-semibold text-fuchsia-700">{% trans %}Offres signalées pending{% endtrans %}</div><div class="mt-1 text-3xl font-black text-fuchsia-900">{{ risk.jobReports.kpis.pendingJobReports|number_format(0, ',', ' ') }}</div></div>
        <div class="rounded-3xl border border-amber-200/70 bg-amber-50/70 p-4"><div class="text-xs font-semibold text-amber-700">{% trans %}Litiges ouverts{% endtrans %}</div><div class="mt-1 text-3xl font-black text-amber-900">{{ finance.disputes.kpis.openDisputes|number_format(0, ',', ' ') }}</div></div>
        <div class="rounded-3xl border border-cyan-200/70 bg-cyan-50/70 p-4"><div class="text-xs font-semibold text-cyan-700">{% trans %}Litiges remboursés{% endtrans %}</div><div class="mt-1 text-3xl font-black text-cyan-900">{{ finance.disputes.kpis.refundedDisputes|number_format(0, ',', ' ') }}</div></div>
      </div>

      <div class="grid gap-4 xl:grid-cols-3">
        <div class="rounded-3xl border border-slate-200/70 bg-white/70 overflow-hidden">
          <div class="px-5 py-4 border-b bg-white/60 text-sm font-extrabold text-slate-900">🚨 {% trans %}Signalements comptes{% endtrans %}</div>
          <div class="p-4"><div class="rounded-2xl border border-slate-200 bg-white p-3 h-[260px]"><canvas id="reportsChart"></canvas></div></div>
        </div>
        <div class="rounded-3xl border border-slate-200/70 bg-white/70 overflow-hidden">
          <div class="px-5 py-4 border-b bg-white/60 text-sm font-extrabold text-slate-900">🚩 {% trans %}Signalements offres{% endtrans %}</div>
          <div class="p-4"><div class="rounded-2xl border border-slate-200 bg-white p-3 h-[260px]"><canvas id="jobReportsChart"></canvas></div></div>
        </div>
        <div class="rounded-3xl border border-slate-200/70 bg-white/70 overflow-hidden">
          <div class="px-5 py-4 border-b bg-white/60 text-sm font-extrabold text-slate-900">💸 {% trans %}Litiges{% endtrans %}</div>
          <div class="p-4"><div class="rounded-2xl border border-slate-200 bg-white p-3 h-[260px]"><canvas id="disputesChart"></canvas></div></div>
        </div>
      </div>

      <div class="grid gap-4 xl:grid-cols-2">
        <div class="rounded-3xl border border-slate-200/70 bg-white/70 overflow-hidden">
          <div class="px-5 py-4 border-b bg-white/60 text-sm font-extrabold text-slate-900">👤 {% trans %}Comptes les plus signalés{% endtrans %}</div>
          <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
              <tbody class="divide-y divide-slate-200/70">
                {% for row in risk.reports.topReportedUsers %}
                  <tr><td class="px-5 py-3 font-bold text-slate-900">{{ row.email ?: '—' }}</td><td class="px-5 py-3 text-slate-700 font-semibold">{{ row.total }}</td></tr>
                {% else %}
                  <tr><td colspan="2" class="px-5 py-8 text-center text-sm font-semibold text-slate-500">{% trans %}Aucune donnée.{% endtrans %}</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>

        <div class="rounded-3xl border border-slate-200/70 bg-white/70 overflow-hidden">
          <div class="px-5 py-4 border-b bg-white/60 text-sm font-extrabold text-slate-900">📣 {% trans %}Offres les plus signalées{% endtrans %}</div>
          <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
              <tbody class="divide-y divide-slate-200/70">
                {% for row in risk.jobReports.topReportedJobs %}
                  <tr><td class="px-5 py-3 font-bold text-slate-900">{{ row.title ?: '—' }}</td><td class="px-5 py-3 text-slate-700 font-semibold">{{ row.total }}</td></tr>
                {% else %}
                  <tr><td colspan="2" class="px-5 py-8 text-center text-sm font-semibold text-slate-500">{% trans %}Aucune donnée.{% endtrans %}</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

  </div>
</div>

<script>
(() => {
  const charts = {
    signups: {{ users.charts.signups|json_encode|raw }},
    jobs: {{ jobs.charts.jobs|json_encode|raw }},
    payments: {{ finance.charts.payments|json_encode|raw }},
    revenue: {{ finance.charts.revenue|json_encode|raw }},
    invoices: {{ finance.charts.invoices|json_encode|raw }},
    subscriptions: {{ finance.charts.subscriptions|json_encode|raw }},
    disputes: {{ finance.charts.disputes|json_encode|raw }},
    reports: {{ risk.reports.charts.reports|json_encode|raw }},
    jobReports: {{ risk.jobReports.charts.jobReports|json_encode|raw }}
  };

  const baseOptions = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { display: true },
      tooltip: { intersect: false, mode: 'index' }
    },
    interaction: { intersect: false, mode: 'index' },
    scales: {
      x: { grid: { display: false } },
      y: { beginAtZero: true, grid: { color: 'rgba(15,23,42,.06)' } }
    }
  };

  const mount = (id, type, label, rows) => {
    const el = document.getElementById(id);
    if (!el || !rows) return;

    new Chart(el, {
      type,
      data: {
        labels: rows.map(x => x.label),
        datasets: [{
          label,
          data: rows.map(x => x.value),
          tension: 0.35,
          fill: type === 'line',
          pointRadius: 2,
          pointHoverRadius: 4,
          borderWidth: 2
        }]
      },
      options: baseOptions
    });
  };

  mount('signupsChart', 'line', '{{ "Inscriptions"|trans }}', charts.signups);
  mount('jobsChart', 'bar', '{{ "Offres"|trans }}', charts.jobs);
  mount('paymentsChart', 'bar', '{{ "Paiements"|trans }}', charts.payments);
  mount('revenueChart', 'line', '{{ "Revenus"|trans }}', charts.revenue);
  mount('invoicesChart', 'bar', '{{ "Factures"|trans }}', charts.invoices);
  mount('subscriptionsChart', 'bar', '{{ "Abonnements"|trans }}', charts.subscriptions);
  mount('disputesChart', 'bar', '{{ "Litiges"|trans }}', charts.disputes);
  mount('reportsChart', 'bar', '{{ "Signalements comptes"|trans }}', charts.reports);
  mount('jobReportsChart', 'bar', '{{ "Signalements offres"|trans }}', charts.jobReports);

  const tabs = Array.from(document.querySelectorAll('.js-analytics-tab'));
  const panels = Array.from(document.querySelectorAll('.analytics-panel'));

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tabTarget;

      tabs.forEach(t => {
        t.className = 'js-analytics-tab inline-flex items-center gap-2 rounded-2xl px-4 py-2.5 text-sm font-extrabold transition bg-white text-slate-700 border border-slate-200 hover:bg-slate-50';
      });

      tab.className = 'js-analytics-tab inline-flex items-center gap-2 rounded-2xl px-4 py-2.5 text-sm font-extrabold transition bg-slate-900 text-white';

      panels.forEach(panel => {
        panel.classList.toggle('hidden', panel.id !== target);
      });
    });
  });
})();
</script>
{% endblock %}