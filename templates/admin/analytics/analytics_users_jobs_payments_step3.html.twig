{% extends 'base.html.twig' %}
{% block title %}{% trans %}Admin • Analytics plateforme{% endtrans %}{% endblock %}

{% block body %}
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="min-h-[calc(100vh-1px)] bg-[radial-gradient(1200px_circle_at_12%_10%,rgba(99,102,241,.14),transparent_55%),radial-gradient(900px_circle_at_90%_12%,rgba(6,182,212,.12),transparent_52%),linear-gradient(180deg,#f8fafc,#eef2ff_50%,#f8fafc)]">
  <div class="mx-auto max-w-7xl px-4 py-6 space-y-5">

    <section class="overflow-hidden rounded-3xl border border-slate-200/70 bg-white/70 backdrop-blur-xl shadow-[0_18px_55px_rgba(2,6,23,.10)]">
      <div class="p-5 bg-[radial-gradient(900px_circle_at_15%_10%,rgba(99,102,241,.16),transparent_60%),radial-gradient(800px_circle_at_90%_30%,rgba(6,182,212,.12),transparent_60%),linear-gradient(180deg,rgba(255,255,255,.90),rgba(255,255,255,.72))]">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
          <div>
            <div class="text-sm font-semibold text-slate-500">{% trans %}Analytics • Utilisateurs • Offres • Paiements{% endtrans %}</div>
            <h1 class="mt-1 text-2xl sm:text-3xl font-black tracking-tight text-slate-900">📊 {% trans %}Vue réelle plateforme{% endtrans %}</h1>
            <p class="mt-2 max-w-3xl text-sm font-medium text-slate-600">
              {% trans %}Statistiques réelles des comptes, des offres et des transactions.{% endtrans %}
            </p>
          </div>

          <div class="flex flex-wrap gap-2">
            <a href="{{ path('tableau_de_bord') }}"
               class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-extrabold text-slate-800 hover:bg-slate-50">
              ← {% trans %}Tableau de bord{% endtrans %}
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="rounded-3xl border border-slate-200/70 bg-white/70 p-4 shadow-[0_18px_55px_rgba(2,6,23,.10)] backdrop-blur-xl">
      <form method="get" class="flex flex-wrap gap-3">
        <select name="range" class="rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold text-slate-800 outline-none">
          <option value="7d" {{ range == '7d' ? 'selected' : '' }}>{% trans %}7 jours{% endtrans %}</option>
          <option value="30d" {{ range == '30d' ? 'selected' : '' }}>{% trans %}30 jours{% endtrans %}</option>
          <option value="90d" {{ range == '90d' ? 'selected' : '' }}>{% trans %}90 jours{% endtrans %}</option>
          <option value="12m" {{ range == '12m' ? 'selected' : '' }}>{% trans %}12 mois{% endtrans %}</option>
        </select>

        <button class="rounded-2xl bg-gradient-to-br from-indigo-600 to-blue-600 px-4 py-2.5 text-sm font-extrabold text-white hover:opacity-95">
          {% trans %}Actualiser{% endtrans %}
        </button>
      </form>
    </section>

    <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      <div class="rounded-3xl border border-slate-200/70 bg-white/70 p-4 shadow-[0_12px_35px_rgba(2,6,23,.08)]">
        <div class="text-xs font-semibold text-slate-500">{% trans %}Total utilisateurs{% endtrans %}</div>
        <div class="mt-1 text-3xl font-black tracking-tight text-slate-900">{{ userKpis.totalUsers|number_format(0, ',', ' ') }}</div>
      </div>

      <div class="rounded-3xl border border-cyan-200/70 bg-cyan-50/70 p-4 shadow-[0_12px_35px_rgba(2,6,23,.08)]">
        <div class="text-xs font-semibold text-cyan-700">{% trans %}Offres actives{% endtrans %}</div>
        <div class="mt-1 text-3xl font-black tracking-tight text-cyan-900">{{ jobKpis.activeJobs|number_format(0, ',', ' ') }}</div>
      </div>

      <div class="rounded-3xl border border-emerald-200/70 bg-emerald-50/70 p-4 shadow-[0_12px_35px_rgba(2,6,23,.08)]">
        <div class="text-xs font-semibold text-emerald-700">{% trans %}Transactions{% endtrans %}</div>
        <div class="mt-1 text-3xl font-black tracking-tight text-emerald-900">{{ paymentKpis.totalPayments|number_format(0, ',', ' ') }}</div>
      </div>

      <div class="rounded-3xl border border-indigo-200/70 bg-indigo-50/70 p-4 shadow-[0_12px_35px_rgba(2,6,23,.08)]">
        <div class="text-xs font-semibold text-indigo-700">{% trans %}Revenus période{% endtrans %}</div>
        <div class="mt-1 text-3xl font-black tracking-tight text-indigo-900">{{ paymentKpis.revenueTotal|number_format(0, ',', ' ') }}</div>
      </div>
    </section>

    <section class="grid gap-4 xl:grid-cols-2">
      <div class="rounded-3xl border border-slate-200/70 bg-white/70 shadow-[0_18px_55px_rgba(2,6,23,.10)] overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-200/70 bg-white/60">
          <div class="text-sm font-extrabold text-slate-900">📈 {% trans %}Inscriptions utilisateurs{% endtrans %}</div>
        </div>
        <div class="p-4">
          <div class="rounded-2xl border border-slate-200 bg-white p-3 h-[320px]">
            <canvas id="signupsChart"></canvas>
          </div>
        </div>
      </div>

      <div class="rounded-3xl border border-slate-200/70 bg-white/70 shadow-[0_18px_55px_rgba(2,6,23,.10)] overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-200/70 bg-white/60">
          <div class="text-sm font-extrabold text-slate-900">📣 {% trans %}Publications d’offres{% endtrans %}</div>
        </div>
        <div class="p-4">
          <div class="rounded-2xl border border-slate-200 bg-white p-3 h-[320px]">
            <canvas id="jobsChart"></canvas>
          </div>
        </div>
      </div>
    </section>

    <section class="grid gap-4 xl:grid-cols-2">
      <div class="rounded-3xl border border-slate-200/70 bg-white/70 shadow-[0_18px_55px_rgba(2,6,23,.10)] overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-200/70 bg-white/60">
          <div class="text-sm font-extrabold text-slate-900">💳 {% trans %}Volume paiements{% endtrans %}</div>
        </div>
        <div class="p-4">
          <div class="rounded-2xl border border-slate-200 bg-white p-3 h-[320px]">
            <canvas id="paymentsChart"></canvas>
          </div>
        </div>
      </div>

      <div class="rounded-3xl border border-slate-200/70 bg-white/70 shadow-[0_18px_55px_rgba(2,6,23,.10)] overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-200/70 bg-white/60">
          <div class="text-sm font-extrabold text-slate-900">💰 {% trans %}Revenus{% endtrans %}</div>
        </div>
        <div class="p-4">
          <div class="rounded-2xl border border-slate-200 bg-white p-3 h-[320px]">
            <canvas id="revenueChart"></canvas>
          </div>
        </div>
      </div>
    </section>

    <section class="grid gap-4 xl:grid-cols-2">
      <div class="rounded-3xl border border-slate-200/70 bg-white/70 shadow-[0_18px_55px_rgba(2,6,23,.10)] overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-200/70 bg-white/60">
          <div class="text-sm font-extrabold text-slate-900">🏦 {% trans %}Top fournisseurs{% endtrans %}</div>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead class="bg-slate-50/60">
              <tr class="text-left text-[11px] uppercase tracking-wider text-slate-500">
                <th class="px-5 py-3 font-extrabold">{% trans %}Fournisseur{% endtrans %}</th>
                <th class="px-5 py-3 font-extrabold">{% trans %}Transactions{% endtrans %}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200/70">
              {% for row in topProviders %}
                <tr>
                  <td class="px-5 py-3 font-bold text-slate-900">{{ row.provider ?: '—' }}</td>
                  <td class="px-5 py-3 text-slate-700 font-semibold">{{ row.total }}</td>
                </tr>
              {% else %}
                <tr><td colspan="2" class="px-5 py-8 text-center text-sm font-semibold text-slate-500">{% trans %}Aucune donnée.{% endtrans %}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>

      <div class="rounded-3xl border border-slate-200/70 bg-white/70 shadow-[0_18px_55px_rgba(2,6,23,.10)] overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-200/70 bg-white/60">
          <div class="text-sm font-extrabold text-slate-900">🕒 {% trans %}Derniers paiements{% endtrans %}</div>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead class="bg-slate-50/60">
              <tr class="text-left text-[11px] uppercase tracking-wider text-slate-500">
                <th class="px-5 py-3 font-extrabold">{% trans %}Utilisateur{% endtrans %}</th>
                <th class="px-5 py-3 font-extrabold">{% trans %}Montant{% endtrans %}</th>
                <th class="px-5 py-3 font-extrabold">{% trans %}Date{% endtrans %}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200/70">
              {% for p in recentPayments %}
                <tr>
                  <td class="px-5 py-3 font-bold text-slate-900">{{ p.user ? p.user.email : '—' }}</td>
                  <td class="px-5 py-3 text-slate-700 font-semibold">{{ p.amount }} {{ p.currency }}</td>
                  <td class="px-5 py-3 text-xs font-semibold text-slate-500">{{ p.paidAt ? p.paidAt|date('d/m/Y H:i') : '—' }}</td>
                </tr>
              {% else %}
                <tr><td colspan="3" class="px-5 py-8 text-center text-sm font-semibold text-slate-500">{% trans %}Aucune donnée.{% endtrans %}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </section>

  </div>
</div>

<script>
(() => {
  const signupsData = {{ charts.signups|json_encode|raw }};
  const jobsData = {{ charts.jobs|json_encode|raw }};
  const paymentsData = {{ charts.payments|json_encode|raw }};
  const revenueData = {{ charts.revenue|json_encode|raw }};

  const baseOptions = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { display: true },
      tooltip: { intersect: false, mode: 'index' }
    },
    interaction: { intersect: false, mode: 'index' },
    scales: {
      x: { grid: { display: false } },
      y: { beginAtZero: true, grid: { color: 'rgba(15,23,42,.06)' } }
    }
  };

  const signupsEl = document.getElementById('signupsChart');
  if (signupsEl) {
    new Chart(signupsEl, {
      type: 'line',
      data: {
        labels: signupsData.map(x => x.label),
        datasets: [{
          label: '{{ "Inscriptions"|trans }}',
          data: signupsData.map(x => x.value),
          tension: 0.35,
          fill: true,
          pointRadius: 2,
          pointHoverRadius: 4,
          borderWidth: 2
        }]
      },
      options: baseOptions
    });
  }

  const jobsEl = document.getElementById('jobsChart');
  if (jobsEl) {
    new Chart(jobsEl, {
      type: 'bar',
      data: {
        labels: jobsData.map(x => x.label),
        datasets: [{
          label: '{{ "Offres"|trans }}',
          data: jobsData.map(x => x.value),
          borderWidth: 1
        }]
      },
      options: baseOptions
    });
  }

  const paymentsEl = document.getElementById('paymentsChart');
  if (paymentsEl) {
    new Chart(paymentsEl, {
      type: 'bar',
      data: {
        labels: paymentsData.map(x => x.label),
        datasets: [{
          label: '{{ "Paiements"|trans }}',
          data: paymentsData.map(x => x.value),
          borderWidth: 1
        }]
      },
      options: baseOptions
    });
  }

  const revenueEl = document.getElementById('revenueChart');
  if (revenueEl) {
    new Chart(revenueEl, {
      type: 'line',
      data: {
        labels: revenueData.map(x => x.label),
        datasets: [{
          label: '{{ "Revenus"|trans }}',
          data: revenueData.map(x => x.value),
          tension: 0.35,
          fill: true,
          pointRadius: 2,
          pointHoverRadius: 4,
          borderWidth: 2
        }]
      },
      options: baseOptions
    });
  }
})();
</script>
{% endblock %}