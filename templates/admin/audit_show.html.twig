{% extends 'base.html.twig' %}
{% block title %}{% trans %}Admin • Log{% endtrans %} #{{ log.id }}{% endblock %}

{% block body %}
<script src="https://cdn.tailwindcss.com"></script>

{% set device = log.deviceType ? (attribute(log.deviceType,'name') ?? attribute(log.deviceType,'label') ?? attribute(log.deviceType,'libelle') ?? ('#' ~ log.deviceType.id)) : '—' %}
{% set os = log.operatingSystem ? (attribute(log.operatingSystem,'name') ?? attribute(log.operatingSystem,'label') ?? attribute(log.operatingSystem,'libelle') ?? ('#' ~ log.operatingSystem.id)) : '—' %}
{% set br = log.browser ? (attribute(log.browser,'name') ?? attribute(log.browser,'label') ?? attribute(log.browser,'libelle') ?? ('#' ~ log.browser.id)) : '—' %}
{% set country = log.country ? (attribute(log.country,'name') ?? attribute(log.country,'label') ?? attribute(log.country,'libelle') ?? ('#' ~ log.country.id)) : '—' %}

<div class="min-h-[calc(100vh-1px)] bg-[linear-gradient(180deg,#f8fafc,#eef2ff_50%,#f8fafc)]">
  <div class="mx-auto max-w-4xl px-4 py-6 space-y-4">

    <div class="rounded-3xl border border-slate-200/70 bg-white/70 backdrop-blur-xl shadow-[0_18px_55px_rgba(2,6,23,.10)] overflow-hidden">
      <div class="p-5 border-b border-slate-200/70 bg-white/60 flex items-start justify-between gap-3">
        <div>
          <div class="text-xs font-semibold text-slate-500">{% trans %}Détail log{% endtrans %}</div>
          <div class="text-xl font-black tracking-tight text-slate-900">🧾 {% trans %}UserLog{% endtrans %} #{{ log.id }}</div>
          <div class="mt-1 text-sm font-medium text-slate-600">
            {{ log.logedAt ? log.logedAt|date('d/m/Y H:i:s') : '—' }}
          </div>
        </div>

        <a href="{{ path('admin_audit_index') }}"
           class="inline-flex items-center gap-2 rounded-2xl bg-slate-900 px-3 py-2 text-xs font-extrabold text-white shadow-[0_12px_35px_rgba(2,6,23,.14)] hover:opacity-95">
          ← {% trans %}Retour{% endtrans %}
        </a>
      </div>

      <div class="p-5 space-y-4">
        <div class="grid gap-3 sm:grid-cols-2">
          <div class="rounded-2xl border border-slate-200 bg-white p-4">
            <div class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">{% trans %}Utilisateur{% endtrans %}</div>
            <div class="mt-1 font-bold text-slate-900">{{ log.user ? log.user.email : '—' }}</div>
            <div class="text-xs font-semibold text-slate-500">ID: {{ log.user ? log.user.id : '—' }}</div>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-4">
            <div class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">{% trans %}IP / Ville / Pays{% endtrans %}</div>
            <div class="mt-1 font-bold text-slate-900">{{ log.ip ?? '—' }}</div>
            <div class="text-xs font-semibold text-slate-500">{{ log.ville ?? '—' }} • {{ country }}</div>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-4">
            <div class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">{% trans %}Appareil{% endtrans %}</div>
            <div class="mt-1 font-bold text-slate-900">{{ device }}</div>
            <div class="text-xs font-semibold text-slate-500">{{ os }} • {{ br }}</div>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-4">
            <div class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">{% trans %}Session{% endtrans %}</div>
            <div class="mt-1 font-bold text-slate-900">
              {% if log.disconnectedAt %}{% trans %}Déconnectée{% endtrans %}{% else %}{% trans %}Active{% endtrans %}{% endif %}
            </div>
            <div class="text-xs font-semibold text-slate-500">
              {% if log.disconnectedAt %}{{ log.disconnectedAt|date('d/m/Y H:i:s') }}{% else %}—{% endif %}
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-4">
          <div class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">{% trans %}Action{% endtrans %}</div>
          <div class="mt-2">
            {% if log.action %}
              <span class="inline-flex items-center rounded-full border border-indigo-200/70 bg-indigo-50 px-2.5 py-1 text-[11px] font-extrabold text-indigo-700">
                {{ log.action }}
              </span>
            {% else %}
              <span class="text-sm font-semibold text-slate-500">—</span>
            {% endif %}
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-4">
          <div class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">{% trans %}User Agent{% endtrans %}</div>
          <div class="mt-2 text-xs font-semibold text-slate-700 break-all">{{ log.userAgent ?? '' }}</div>
        </div>
      </div>
    </div>

  </div>
</div>
{% endblock %}