{% extends 'base.html.twig' %}

{% block title %}{% trans %}Admin • Bannissements{% endtrans %}{% endblock %}

{% block body %}
  {% include 'admin/moderation/_vip_ui.html.twig' %}

  <div class="mod-shell" data-moderation-page="bans">
    <div class="mod-container mod-grid">

      <section class="mod-card mod-page-head">
        <div class="mod-card-inner">
          <div class="mod-page-head-top">
            <div class="mod-page-main">
              <div class="mod-kicker">{% trans %}Modération • Bannissements{% endtrans %}</div>
              <h1 class="mod-page-title">{% trans %}Sanctions & bannissements{% endtrans %}</h1>
              <p class="mod-page-text">{% trans %}Vue sensible pour gérer les suspensions temporaires, permanentes et le suivi des décisions disciplinaires.{% endtrans %}</p>
            </div>
          </div>

          <div class="mod-page-actions">
            {% include 'admin/moderation/_nav.html.twig' %}
          </div>
        </div>
      </section>

      <section class="mod-card">
        <div class="mod-card-inner">
          <div class="mod-filters">
            <div style="flex:2 1 340px;">
              <input type="search" class="mod-input" placeholder="{% trans %}Rechercher un compte banni...{% endtrans %}" data-mod-search="bans">
            </div>
            <div style="flex:1 1 220px;">
              <select class="mod-select" data-mod-ban-status="bans">
                <option value="">{% trans %}Tous les statuts{% endtrans %}</option>
                <option value="active">{% trans %}Active{% endtrans %}</option>
              </select>
            </div>
          </div>

          <div class="mod-separator"></div>

          <div class="mod-card-list">
            {% for ban in bans %}
              <article class="mod-mini-card js-mod-ban"
                       data-mod-text="{{ (ban.user ~ ' ' ~ ban.email ~ ' ' ~ ban.reason ~ ' ' ~ ban.by)|lower }}"
                       data-mod-status="{{ ban.status|lower }}">
                <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;">
                  <div>
                    <div class="mod-row-title">{{ ban.user }}</div>
                    <div class="mod-row-sub">{{ ban.email }}</div>
                    <div class="mod-row-sub">{% trans %}Motif :{% endtrans %} {{ ban.reason }}</div>
                    <div class="mod-row-sub">{% trans %}Décidé par :{% endtrans %} {{ ban.by }}</div>
                  </div>

                  <div style="display:flex;gap:8px;flex-wrap:wrap;">
                    <span class="mod-badge {{ ban.level }}">{{ ban.level|capitalize }}</span>
                    <span class="mod-badge {{ ban.status }}">{{ ban.status|capitalize }}</span>
                  </div>
                </div>

                <div class="mod-separator"></div>

                <div class="mod-row-sub">
                  {% trans %}Début :{% endtrans %} {{ ban.startAt|date('d/m/Y H:i') }} •
                  {% trans %}Fin :{% endtrans %} {{ ban.endAt ? ban.endAt|date('d/m/Y H:i') : 'Indéfinie'|trans }}
                </div>
              </article>
            {% endfor %}
          </div>
        </div>
      </section>

    </div>
  </div>

  <script src="{{ asset('js/admin-content-moderation.js') }}"></script>
{% endblock %}