<style>
  :root{
    --mod-bg:#f5f7ff;
    --mod-surface:rgba(255,255,255,.84);
    --mod-surface-strong:rgba(255,255,255,.96);
    --mod-line:rgba(15,23,42,.08);
    --mod-line-strong:rgba(15,23,42,.14);
    --mod-text:#0f172a;
    --mod-muted:rgba(15,23,42,.60);
    --mod-primary:#4f46e5;
    --mod-primary-2:#2563eb;
    --mod-danger:#ef4444;
    --mod-warn:#f59e0b;
    --mod-ok:#10b981;
    --mod-cyan:#06b6d4;
    --mod-shadow:0 22px 80px rgba(15,23,42,.10);
    --mod-shadow-sm:0 14px 34px rgba(15,23,42,.07);
    --mod-r:22px;
  }

  .mod-shell{
    min-height:100vh;
    padding:24px;
    background:
      radial-gradient(circle at top right, rgba(79,70,229,.08), transparent 24%),
      radial-gradient(circle at top left, rgba(239,68,68,.06), transparent 18%),
      linear-gradient(180deg, var(--mod-bg), #fff 72%);
  }

  .mod-container{max-width:1440px;margin:0 auto;}
  .mod-grid{display:grid;gap:18px}
  .mod-grid-4{grid-template-columns:repeat(4,minmax(0,1fr))}
  .mod-grid-main{grid-template-columns:minmax(0,1.18fr) minmax(320px,.82fr)}

  .mod-card{
    background:var(--mod-surface);
    backdrop-filter:blur(16px);
    border:1px solid rgba(255,255,255,.55);
    border-radius:var(--mod-r);
    box-shadow:var(--mod-shadow-sm);
  }

  .mod-card-inner{padding:22px}

  .mod-page-head{
    background:
      radial-gradient(circle at right top, rgba(79,70,229,.10), transparent 34%),
      linear-gradient(180deg, rgba(255,255,255,.96), rgba(255,255,255,.90));
    border:1px solid var(--mod-line);
    box-shadow:var(--mod-shadow);
  }

  .mod-page-head-top{
    display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;
  }

  .mod-page-main{min-width:260px;flex:1 1 620px;}

  .mod-kicker{
    display:inline-flex;align-items:center;gap:8px;
    padding:8px 12px;border-radius:999px;
    background:rgba(79,70,229,.08);color:var(--mod-primary);
    border:1px solid rgba(79,70,229,.12);
    font-size:.72rem;font-weight:900;text-transform:uppercase;letter-spacing:.08em;
  }

  .mod-page-title{
    margin:12px 0 0;
    font-size:clamp(1.35rem, 2vw, 2rem);
    line-height:1.08;font-weight:900;color:var(--mod-text);letter-spacing:-.02em;
  }

  .mod-page-text{
    margin:8px 0 0;max-width:820px;line-height:1.65;color:var(--mod-muted);font-size:.96rem;
  }

  .mod-page-actions{margin-top:18px;}

  .mod-nav{
    display:flex;flex-wrap:wrap;gap:10px;
  }

  .mod-btn{
    appearance:none;border:none;display:inline-flex;align-items:center;justify-content:center;gap:8px;
    border-radius:16px;padding:12px 16px;font-weight:800;font-size:.88rem;text-decoration:none;cursor:pointer;
    transition:transform .18s ease, box-shadow .18s ease, background .18s ease;
  }

  .mod-btn:hover{transform:translateY(-1px);text-decoration:none;}
  .mod-btn-primary{
    color:#fff;background:linear-gradient(135deg, var(--mod-primary), var(--mod-primary-2));
    box-shadow:0 14px 34px rgba(79,70,229,.22);
  }
  .mod-btn-soft{
    color:var(--mod-text);background:rgba(255,255,255,.94);border:1px solid var(--mod-line);
  }
  .mod-btn-danger{
    color:#b91c1c;background:rgba(239,68,68,.06);border:1px solid rgba(239,68,68,.16);
  }
  .mod-btn-xs{padding:8px 12px;font-size:.77rem;border-radius:13px;}

  .mod-dot{
    width:8px;height:8px;border-radius:999px;background:rgba(79,70,229,.22);flex:0 0 auto;
  }
  .mod-btn-primary .mod-dot{
    background:rgba(255,255,255,.95);
    box-shadow:0 0 0 4px rgba(255,255,255,.18);
  }

  .mod-toolbar{
    display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;
  }

  .mod-title{margin:0;font-size:1rem;font-weight:900;color:var(--mod-text);}
  .mod-subtitle{margin-top:4px;color:var(--mod-muted);font-size:.92rem;line-height:1.55;}

  .mod-separator{
    height:1px;margin:16px 0;
    background:linear-gradient(90deg, transparent, var(--mod-line-strong), transparent);
  }

  .mod-kpi .label{
    font-size:.76rem;font-weight:900;text-transform:uppercase;letter-spacing:.07em;color:var(--mod-muted);
  }
  .mod-kpi .value{
    margin-top:8px;font-size:1.72rem;font-weight:900;color:var(--mod-text);letter-spacing:-.02em;
  }
  .mod-kpi .hint{
    margin-top:7px;font-size:.87rem;color:var(--mod-muted);line-height:1.5;
  }

  .mod-filters{
    display:flex;flex-wrap:wrap;gap:10px;width:100%;align-items:flex-start;
  }

  .mod-input,.mod-select{
    width:100%;border:1px solid var(--mod-line);background:rgba(255,255,255,.95);
    border-radius:16px;padding:13px 14px;color:var(--mod-text);outline:none;transition:.18s ease;
  }

  .mod-input:focus,.mod-select:focus{
    border-color:rgba(79,70,229,.34);box-shadow:0 0 0 4px rgba(79,70,229,.10);
  }

  .mod-badge{
    display:inline-flex;align-items:center;gap:6px;padding:7px 10px;border-radius:999px;
    font-size:.73rem;font-weight:900;border:1px solid transparent;white-space:nowrap;
  }

  .mod-badge.pending{background:rgba(245,158,11,.12);color:#b45309;border-color:rgba(245,158,11,.18);}
  .mod-badge.reviewing{background:rgba(59,130,246,.10);color:#1d4ed8;border-color:rgba(59,130,246,.15);}
  .mod-badge.approved{background:rgba(16,185,129,.12);color:#047857;border-color:rgba(16,185,129,.18);}
  .mod-badge.rejected{background:rgba(239,68,68,.10);color:#b91c1c;border-color:rgba(239,68,68,.15);}
  .mod-badge.low{background:rgba(6,182,212,.10);color:#0f766e;border-color:rgba(6,182,212,.15);}
  .mod-badge.medium{background:rgba(59,130,246,.10);color:#1d4ed8;border-color:rgba(59,130,246,.15);}
  .mod-badge.high{background:rgba(245,158,11,.12);color:#b45309;border-color:rgba(245,158,11,.18);}
  .mod-badge.critical{background:rgba(239,68,68,.10);color:#b91c1c;border-color:rgba(239,68,68,.15);}
  .mod-badge.active{background:rgba(16,185,129,.12);color:#047857;border-color:rgba(16,185,129,.18);}
  .mod-badge.temporary{background:rgba(245,158,11,.12);color:#b45309;border-color:rgba(245,158,11,.18);}
  .mod-badge.permanent{background:rgba(239,68,68,.10);color:#b91c1c;border-color:rgba(239,68,68,.15);}
  .mod-badge.neutral{background:rgba(15,23,42,.05);color:#334155;border-color:rgba(15,23,42,.08);}

  .mod-table-wrap{overflow:auto}
  .mod-table{width:100%;border-collapse:separate;border-spacing:0 10px}
  .mod-table th{
    padding:0 14px 6px;font-size:.76rem;color:var(--mod-muted);text-transform:uppercase;letter-spacing:.07em;white-space:nowrap;
  }
  .mod-table td{
    padding:14px;background:rgba(255,255,255,.96);color:var(--mod-text);
    border-top:1px solid var(--mod-line);border-bottom:1px solid var(--mod-line);vertical-align:middle;
  }
  .mod-table td:first-child{border-left:1px solid var(--mod-line);border-radius:16px 0 0 16px;}
  .mod-table td:last-child{border-right:1px solid var(--mod-line);border-radius:0 16px 16px 0;}

  .mod-row-title{font-weight:900;color:var(--mod-text);line-height:1.35;}
  .mod-row-sub{margin-top:5px;font-size:.84rem;color:var(--mod-muted);}
  .mod-row-actions{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;}

  .mod-card-list{display:grid;gap:14px}
  .mod-mini-card{
    padding:16px;border:1px solid var(--mod-line);border-radius:18px;background:rgba(255,255,255,.96);transition:.18s ease;
  }
  .mod-mini-card:hover{transform:translateY(-1px);box-shadow:var(--mod-shadow-sm);}

  @media (max-width:1100px){
    .mod-grid-4,.mod-grid-main{grid-template-columns:1fr;}
  }

  @media (max-width:720px){
    .mod-shell{padding:16px}
    .mod-card-inner{padding:16px}
  }
</style>