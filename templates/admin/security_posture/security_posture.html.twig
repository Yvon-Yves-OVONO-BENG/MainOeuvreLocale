{% extends 'base.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{% trans %}Posture de sécurité{% endtrans %}{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-50">
	<div class="mx-auto max-w-7xl px-4 py-6">
		<div class="mb-6">
			<h1 class="text-3xl font-black text-slate-900">🛡️ {% trans %}Posture de sécurité{% endtrans %}</h1>
			<p class="mt-2 text-sm text-slate-500">
				{% trans %}Vue globale du niveau de confiance de la plateforme et des leviers d’amélioration prioritaires.{% endtrans %}
			</p>
		</div>

		<div class="grid gap-6 xl:grid-cols-12">
			<div class="xl:col-span-4 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
				<div class="flex items-center justify-between">
					<div>
						<div class="text-lg font-bold text-slate-900">{% trans %}Securité posture{% endtrans %}</div>
						<div class="text-sm text-slate-500">{% trans %}Niveau global de confiance plateforme{% endtrans %}</div>
					</div>

					<span class="inline-flex rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-extrabold text-slate-700">
						{{ securityPosture.label }}
					</span>
				</div>

				<div class="mt-6 flex justify-center">
					<div
						class="relative flex h-40 w-40 items-center justify-center rounded-full"
						style="
							background:
								conic-gradient(
									#6366f1 calc({{ securityPosture.score }} * 1%),
									#e2e8f0 0
								);
						"
					>
						<div class="flex h-28 w-28 flex-col items-center justify-center rounded-full bg-white shadow-inner">
							<div class="text-4xl font-black text-slate-900">{{ securityPosture.score }}</div>
							<div class="text-xs text-slate-400">/100</div>
						</div>
					</div>
				</div>

				<div class="mt-6 text-sm text-slate-600">
					{% trans %}Le score est calculé à partir du 2FA staff, du KYC entreprises, de la couverture d’audit, des incidents ouverts et de la file de vérifications.{% endtrans %}
				</div>
			</div>

			<div class="xl:col-span-5 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
				<div class="mb-4">
					<div class="text-lg font-bold text-slate-900">{% trans %}Détail des piliers{% endtrans %}</div>
					<div class="text-sm text-slate-500">{% trans %}Sous-métriques utilisées dans le score global{% endtrans %}</div>
				</div>

				<div class="space-y-5">
					{% for metric in securityPosture.metrics %}
						<div>
							<div class="mb-1 flex items-center justify-between text-sm">
								<span class="text-slate-600">{{ metric.label }}</span>
								<div class="text-right">
									<b class="text-slate-900">{{ metric.rate }}%</b>
									<span class="ml-2 text-xs text-slate-400">{{ metric.value }}</span>
								</div>
							</div>

							<div class="h-2.5 overflow-hidden rounded-full bg-slate-200">
								<span
									class="block h-full rounded-full"
									style="
										width: {{ metric.rate }}%;
										background: linear-gradient(90deg, #ef4444 0%, #f59e0b 55%, #10b981 100%);
									"
								></span>
							</div>
						</div>
					{% endfor %}
				</div>
			</div>

			<div class="xl:col-span-3 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
				<div class="mb-4">
					<div class="text-lg font-bold text-slate-900">{% trans %}Actions recommandées{% endtrans %}</div>
					<div class="text-sm text-slate-500">{% trans %}Ce qu’il faut améliorer maintenant{% endtrans %}</div>
				</div>

				<div class="space-y-3">
					{% for item in securityPosture.recommendations %}
						<div class="rounded-2xl border border-slate-200 bg-slate-50 p-3 text-sm text-slate-700">
							{{ item }}
						</div>
					{% endfor %}
				</div>
			</div>
		</div>

		<div class="mt-6 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
			<div class="mb-4">
				<div class="text-lg font-bold text-slate-900">{% trans %}Données brutes{% endtrans %}</div>
				<div class="text-sm text-slate-500">{% trans %}Valeurs utilisées dans le calcul{% endtrans %}</div>
			</div>

			<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
				<div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
					<div class="text-xs uppercase text-slate-400">{% trans %}2FA staff{% endtrans %}</div>
					<div class="mt-2 text-2xl font-black text-slate-900">
						{{ securityPosture.raw.staffWith2fa }}/{{ securityPosture.raw.staffCount }}
					</div>
				</div>

				<div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
					<div class="text-xs uppercase text-slate-400">{% trans %}KYC entreprises{% endtrans %}</div>
					<div class="mt-2 text-2xl font-black text-slate-900">
						{{ securityPosture.raw.verifiedCompanies }}/{{ securityPosture.raw.companiesCount }}
					</div>
				</div>

				<div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
					<div class="text-xs uppercase text-slate-400">{% trans %}Logs 24h{% endtrans %}</div>
					<div class="mt-2 text-2xl font-black text-slate-900">
						{{ securityPosture.raw.logs24h }}
					</div>
				</div>

				<div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
					<div class="text-xs uppercase text-slate-400">{% trans %}Incidents ouverts{% endtrans %}</div>
					<div class="mt-2 text-2xl font-black text-slate-900">
						{{ securityPosture.raw.openIncidents }}
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
{% endblock %}