{% extends 'base.html.twig' %}
{% block title %}Régie publicitaire{% endblock %}
{% block body %}
<div class="container py-5">
  <h1 class="h3 mb-4">Régie publicitaire</h1>
  <div class="row g-4 mb-4">
    <div class="col-lg-5"><form method="post" class="card card-body"><input type="hidden" name="_token" value="{{ csrf_token('advertising_admin') }}"><input type="hidden" name="kind" value="space"><h2 class="h5">Nouvel emplacement</h2><input class="form-control mb-2" name="code" placeholder="home-main" required><input class="form-control mb-2" name="name" placeholder="Nom" required><input class="form-control mb-2" name="position" value="home"><input class="form-control mb-2" type="number" min="0" name="dailyPrice" placeholder="Tarif journalier"><button class="btn btn-dark">Créer</button></form></div>
    <div class="col-lg-7"><form method="post" class="card card-body"><input type="hidden" name="_token" value="{{ csrf_token('advertising_admin') }}"><input type="hidden" name="kind" value="campaign"><h2 class="h5">Nouvelle campagne</h2><select class="form-select mb-2" name="space" required>{% for s in spaces %}<option value="{{ s.id }}">{{ s.name }}</option>{% endfor %}</select><input class="form-control mb-2" type="number" name="advertiser" placeholder="ID annonceur" required><input class="form-control mb-2" name="title" placeholder="Titre" required><input class="form-control mb-2" name="image" placeholder="URL de l'image" required><input class="form-control mb-2" type="url" name="targetUrl" placeholder="Lien cible" required><div class="row g-2 mb-2"><div class="col"><input class="form-control" type="datetime-local" name="startsAt" required></div><div class="col"><input class="form-control" type="datetime-local" name="endsAt" required></div></div><button class="btn btn-dark">Enregistrer</button></form></div>
  </div>
  <div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Campagne</th><th>Emplacement</th><th>État</th><th>Impressions</th><th>Clics</th><th>Actions</th></tr></thead><tbody>{% for c in campaigns %}<tr><td>{{ c.title }}</td><td>{{ c.space.name }}</td><td>{{ c.status }}</td><td>{{ c.impressions }}</td><td>{{ c.clicks }}</td><td><form method="post" class="d-flex gap-1"><input type="hidden" name="_token" value="{{ csrf_token('advertising_status_' ~ c.id) }}"><button formaction="{{ path('admin_advertising_status',{id:c.id,status:'active'}) }}" class="btn btn-sm btn-success">Activer</button><button formaction="{{ path('admin_advertising_status',{id:c.id,status:'paused'}) }}" class="btn btn-sm btn-secondary">Pause</button></form></td></tr>{% else %}<tr><td colspan="6">Aucune campagne.</td></tr>{% endfor %}</tbody></table></div></div>
</div>
{% endblock %}
