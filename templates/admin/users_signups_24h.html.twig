{% extends 'base.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{% trans %}Admin • Inscriptions des dernières 24 heures{% endtrans %}{% endblock %}

{% block body %}
<script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-[calc(100vh-1px)] bg-[radial-gradient(1100px_circle_at_12%_10%,rgba(99,102,241,.13),transparent_55%),radial-gradient(900px_circle_at_90%_12%,rgba(6,182,212,.10),transparent_52%),linear-gradient(180deg,#f8fafc,#eef2ff_50%,#f8fafc)]">
    <div class="mx-auto max-w-7xl space-y-4 px-4 py-6 sm:px-6">
        <section class="overflow-hidden rounded-3xl border border-indigo-200/70 bg-white/80 shadow-[0_18px_55px_rgba(2,6,23,.10)] backdrop-blur-xl">
            <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-start sm:justify-between">
                <div>
                    <h1 class="mt-1 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">✨ {% trans %}Inscriptions des dernières 24 heures{% endtrans %}</h1>
                    <p class="mt-2 text-sm font-semibold text-slate-600">{% trans %}Comptes créés pendant les 24 heures précédant l’instant présent.{% endtrans %}</p>
                </div>

                <div class="flex flex-wrap gap-2">
                    <a href="{{ path('tableau_de_bord') }}" class="inline-flex items-center gap-2 rounded-2xl bg-slate-900 px-4 py-2.5 text-xs font-extrabold text-white hover:opacity-90">← {% trans %}Tableau de bord{% endtrans %}</a>
                    <a href="{{ path('admin_users_online') }}" class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-extrabold text-slate-700 hover:bg-slate-50">👥 {% trans %}Connectés{% endtrans %}</a>
                </div>
            </div>
        </section>

        <section class="rounded-3xl border border-slate-200/70 bg-white/80 p-4 shadow-[0_12px_35px_rgba(2,6,23,.08)] backdrop-blur-xl">
            <form method="get" class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:items-end">
                <div>
                    <label for="signup-search" class="text-[11px] font-extrabold uppercase tracking-wide text-slate-600">{% trans %}Rechercher par email{% endtrans %}</label>
                    <input id="signup-search" name="q" value="{{ q }}" class="mt-1 w-full rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-800 outline-none focus:border-indigo-400 focus:ring-4 focus:ring-indigo-100" placeholder="{{ 'Adresse email…'|trans }}">
                </div>
                <select name="perPage" class="rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-bold text-slate-700 outline-none">
                    {% for size in [10, 20, 50, 100] %}<option value="{{ size }}" {{ perPage == size ? 'selected' : '' }}>{{ size }} / {% trans %}page{% endtrans %}</option>{% endfor %}
                </select>
                <button class="rounded-2xl bg-indigo-600 px-5 py-2.5 text-sm font-extrabold text-white hover:bg-indigo-700">{% trans %}Filtrer{% endtrans %}</button>
            </form>
        </section>

        <section class="overflow-hidden rounded-3xl border border-slate-200/70 bg-white/80 shadow-[0_18px_55px_rgba(2,6,23,.10)] backdrop-blur-xl">
            <header class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200/70 bg-white/60 px-5 py-4">
                <div><h2 class="text-sm font-black text-slate-900">{% trans %}Nouveaux comptes{% endtrans %}</h2><p class="text-xs font-semibold text-slate-500">{% trans %}Triés du plus récent au plus ancien{% endtrans %}</p></div>
                <span class="rounded-full bg-indigo-100 px-3 py-1.5 text-xs font-black text-indigo-800">{{ total|number_format(0, ',', ' ') }} {% trans %}inscription(s){% endtrans %}</span>
            </header>

            <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead class="bg-slate-50/80"><tr class="text-left text-[11px] font-extrabold uppercase tracking-wider text-slate-500"><th class="px-5 py-3">{% trans %}Utilisateur{% endtrans %}</th><th class="px-5 py-3">{% trans %}Rôle{% endtrans %}</th><th class="px-5 py-3">{% trans %}Inscrit le{% endtrans %}</th><th class="px-5 py-3">{% trans %}Statut{% endtrans %}</th><th class="px-5 py-3 text-right">{% trans %}Action{% endtrans %}</th></tr></thead>
                    <tbody class="divide-y divide-slate-200/70">
                        {% for u in items %}
                            {% set mainRole = u.roles|filter(role => role != 'ROLE_USER')|first|default('ROLE_USER') %}
                            <tr class="transition hover:bg-indigo-50/40">
                                <td class="px-5 py-3"><div class="flex items-center gap-3"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-indigo-500 to-cyan-600 font-black text-white shadow-sm">{{ u.email|slice(0, 1)|upper }}</span><div class="min-w-0"><div class="max-w-[280px] truncate font-extrabold text-slate-900">{{ u.email }}</div><div class="text-xs font-semibold text-slate-500">Réf. {{ u.slug|slice(0, 12)|upper }}</div></div></div></td>
                                <td class="px-5 py-3"><span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-extrabold text-indigo-700">{{ mainRole|replace({'ROLE_': '', '_': ' '})|title }}</span></td>
                                <td class="whitespace-nowrap px-5 py-3 font-semibold text-slate-600">{{ u.createdAt ? u.createdAt|date('d/m/Y H:i:s') : '—' }}</td>
                                <td class="px-5 py-3">{% if u.isActive %}<span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-black text-emerald-800">{% trans %}Actif{% endtrans %}</span>{% else %}<span class="rounded-full bg-rose-100 px-2.5 py-1 text-xs font-black text-rose-800">{% trans %}Inactif{% endtrans %}</span>{% endif %}</td>
                                <td class="px-5 py-3 text-right"><a href="{{ path('admin_users_show', {slug: u.slug}) }}" class="inline-flex rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-extrabold text-slate-700 hover:bg-slate-50">{% trans %}Voir{% endtrans %}</a></td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5" class="px-5 py-12 text-center"><div class="text-3xl">✨</div><div class="mt-2 font-extrabold text-slate-700">{% trans %}Aucune inscription durant les dernières 24 heures.{% endtrans %}</div></td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% include 'admin/_users_activity_pagination.html.twig' with {routeName: 'admin_users_signups_24h'} %}
        </section>
    </div>
</div>
{% endblock %}
