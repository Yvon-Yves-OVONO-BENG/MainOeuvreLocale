    font-weight: 500;
    color: var(--gray-600);
    background: transparent;
    list-style: none; /* Important */
}

/* ... le reste des styles ... */
</style>
{% endblock %}

{% block body %}
<div class="professions-card">
    <!-- HEADER PREMIUM -->
    <div class="card-header-premium">
        <div class="header-title">
            <div class="icon-wrapper">
                <i class="fas fa-briefcase"></i>
            </div>
            <span>Gestion des Professions</span>
            <span style="font-size:0.7rem; font-weight:400; color:var(--gray-400); background:var(--gray-100); padding:0.1rem 0.6rem; border-radius:20px;">
                <span id="totalCount">0</span>
            </span>
        </div>
        <div class="header-actions">
            <a href="{{ path('admin_categories_index') }}"
               class="btn-premium btn-premium-navigation">
                <i class="fas fa-tags"></i>
                <span>Catégories</span>
            </a>
            <button class="btn-premium btn-premium-primary" onclick="openCreateModal()">
                <i class="fas fa-plus"></i>
                <span>Nouvelle Profession</span>
            </button>
        </div>
    </div>

    <div style="padding: 1.25rem 1.5rem;">
        <!-- RECHERCHE PREMIUM -->
        <div class="search-wrapper">
            <i class="fas fa-search search-icon"></i>
            <input
                type="search"
                id="searchInput"
                class="search-input"
                placeholder="Rechercher par nom, description ou catégorie..."
                oninput="loadData(true)"
                autocomplete="off"
            >
            <span class="search-shortcut">⌘K</span>
        </div>

        <!-- TOOLBAR PREMIUM -->
        <div class="toolbar-premium" id="toolbar">
            <button class="btn-premium btn-premium-danger btn-premium-sm" onclick="deleteSelected()">
                <i class="fas fa-trash-alt"></i>
                <span>Supprimer</span>
            </button>
            <div class="selected-info">
                <span class="count-badge" id="selectedCount">0</span>
                <span>sélectionnée(s)</span>
            </div>
        </div>

        <!-- TABLEAU PREMIUM -->
        <div class="table-responsive">
            <table class="table-premium">
                <thead>
                    <tr>
                        <th style="width:40px;">
                            <label class="checkbox-premium">
                                <input type="checkbox" id="selectAll" onchange="toggleSelectAll()">
                                <span class="checkmark"></span>
                            </label>
                        </th>
                        <th style="width:60px;">Photo</th>
                        <th>Nom</th>
                        <th>Description</th>
                        <th>Catégorie</th>
                        <th style="text-align:center; width:70px;">Jobs</th>
                        <th style="width:100px; text-align:center;">Actions</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    <!-- Data will be loaded here -->
                </tbody>
            </table>
        </div>

        <!-- PAGINATION PREMIUM -->
        <div class="pagination-premium" id="pagination"></div>
    </div>
</div>

<!-- Modal Personnalisé -->
<div id="professionModal" class="modal-custom">
    <div class="modal-dialog-custom">
        <div class="modal-header-custom">
            <h5 class="modal-title" id="professionModalLabel">
                <i class="fas fa-plus-circle me-2"></i>Nouvelle Profession
            </h5>
            <button type="button" class="btn-close-custom" onclick="closeModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <form id="professionForm"
              enctype="multipart/form-data"
              onsubmit="saveProfession(event)"
              data-no-submit-spinner="1"
              data-turbo="false">
            <div class="modal-body-custom">
                <input type="hidden" id="professionId" name="id" value="">
                
                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label for="professionNom" class="form-label">
                                <i class="fas fa-briefcase me-1"></i>Nom de la profession <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="professionNom" name="nom" 
                                   placeholder="Ex: Développeur Web, Designer UX..." required>
                            <div class="invalid-feedback">
                                Veuillez saisir un nom de profession
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="professionCategorie" class="form-label">
                                <i class="fas fa-tag me-1"></i>Catégorie
                            </label>
                            <select class="form-select" id="professionCategorie" name="categorie">
                                <option value="">Sélectionner une catégorie</option>
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label for="professionDescription" class="form-label">
                                <i class="fas fa-align-left me-1"></i>Description
                            </label>
                            <textarea class="form-control" id="professionDescription" name="description" 
                                      rows="4" placeholder="Description de la profession (optionnel)"></textarea>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label" for="professionPhoto">
                                <i class="fas fa-camera me-1"></i>Photo
                                <span class="text-danger">*</span>
                            </label>
                            
                            <!-- Zone d'upload -->
                            <div
                                class="photo-upload-zone"
                                id="photoUploadZone"
                                role="button"
                                tabindex="0"
                                aria-describedby="professionPhotoHelp professionPhotoError"
                                onclick="$('#professionPhoto').click()"
                            >
                                <i class="fas fa-cloud-upload-alt"></i>
                                <p class="mb-1">Cliquez pour uploader</p>
                                <small class="text-muted" id="professionPhotoHelp">JPG, PNG ou GIF (max 2 Mo). Obligatoire à la création.</small>
                            </div>
                            
                            <!-- Preview -->
                            <div class="text-center mt-3" id="photoPreviewContainer" style="display: none;">
                                <img alt="Preview" class="photo-preview" id="photoPreview">
                                <button type="button" class="btn btn-sm btn-outline-danger mt-2" 
                                        onclick="removePhoto()">
                                    <i class="fas fa-times me-1"></i>Supprimer la photo
                                </button>
                            </div>
                            
                            <input type="file" class="d-none" id="professionPhoto" name="photo"
                                   accept="image/jpeg,image/png,image/gif" onchange="previewPhoto(this)"
                                   aria-invalid="false" aria-describedby="professionPhotoHelp professionPhotoError">
                            <div class="profession-photo-error" id="professionPhotoError" role="alert" aria-live="polite"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn btn-secondary" onclick="closeModal()">
                    <i class="fas fa-times me-1"></i>Annuler
                </button>
                <button type="submit" class="btn btn-primary" id="btnSaveProfession">
                    <i class="fas fa-save me-1"></i>Enregistrer
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

