

<style>
  :root{
    --vip-text:#0f172a;
    --vip-muted:rgba(15,23,42,.62);
    --vip-stroke:rgba(15,23,42,.08);
    --vip-shell-shadow:0 18px 45px rgba(15,23,42,.08);
    --vip-card-shadow:0 10px 28px rgba(15,23,42,.06);
    --vip-blue:#0d6efd;
    --vip-green:#20c997;
  }

  html, body{
    max-width:100%;
    overflow-x:hidden;
  }

  .vip-page{
    padding-top: 32px;
    padding-bottom: 24px;
  }

  .vip-shell{
    background:
      radial-gradient(900px circle at 10% 0%, rgba(13,110,253,.10), transparent 55%),
      radial-gradient(900px circle at 90% 10%, rgba(32,201,151,.10), transparent 55%),
      linear-gradient(180deg, rgba(255,255,255,.96), rgba(255,255,255,.88));
    border: 1px solid rgba(0,0,0,.06);
    border-radius: 22px;
    box-shadow: var(--vip-shell-shadow);
    overflow: hidden;
  }

  .vip-head{
    padding: 20px 20px 14px;
    border-bottom: 1px solid rgba(0,0,0,.06);
    background: linear-gradient(180deg, rgba(255,255,255,.96), rgba(255,255,255,.72));
  }

  .vip-head-top{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:12px;
    flex-wrap:wrap;
  }

  .vip-head-actions{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
  }

  .vip-title{
    font-weight: 900;
    letter-spacing: -.02em;
    color: var(--vip-text);
    margin: 0;
    line-height: 1.1;
  }

  .vip-sub{
    color: var(--vip-muted);
    font-size: .95rem;
    margin-top: 6px;
    line-height: 1.45;
  }

  .vip-total{
    color: var(--vip-muted);
    font-size: .92rem;
    font-weight: 700;
  }

  .vip-body{
    padding: 16px 18px 18px;
  }

  .vip-table-wrap{
    overflow-x:auto;
    -webkit-overflow-scrolling:touch;
  }

  .vip-table-pad{
    background: rgba(255,255,255,.92);
    border: 1px solid rgba(0,0,0,.06);
    border-radius: 16px;
    padding: 10px;
    box-shadow: var(--vip-card-shadow);
  }

  table.dataTable{
    width:100% !important;
    margin:0 !important;
  }

  table.dataTable thead th{
    background: rgba(13,110,253,.06) !important;
    border-bottom: 1px solid rgba(0,0,0,.06) !important;
    font-weight: 800 !important;
    color: rgba(33,37,41,.88) !important;
    white-space: nowrap;
  }

  table.dataTable tbody td{
    vertical-align: middle !important;
    border-top: 1px solid rgba(0,0,0,.04) !important;
  }

  .vip-profile{
    display:flex;
    align-items:center;
    gap:12px;
    min-width: 280px;
  }

  .vip-avatar{
    width:52px;
    height:52px;
    border-radius:16px;
    object-fit:cover;
    flex:0 0 52px;
    border:1px solid rgba(0,0,0,.08);
    background:#fff;
    box-shadow: 0 6px 16px rgba(15,23,42,.08);
  }

  .vip-avatar-fallback{
    width:52px;
    height:52px;
    border-radius:16px;
    display:flex;
    align-items:center;
    justify-content:center;
    flex:0 0 52px;
    font-weight:900;
    color:#0f172a;
    background: linear-gradient(135deg, rgba(13,110,253,.14), rgba(32,201,151,.12));
    border:1px solid rgba(13,110,253,.16);
    box-shadow: 0 6px 16px rgba(15,23,42,.06);
  }

  .vip-name{
    font-weight: 800;
    color: var(--vip-text);
    line-height: 1.25;
    margin-bottom: 2px;
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  .vip-meta{
    color: var(--vip-muted);
    font-size: .86rem;
    line-height: 1.35;
  }

  .stars{
    display:inline-flex;
    gap:2px;
    font-size:1rem;
    letter-spacing:1px;
    white-space:nowrap;
  }

  .star-on{
    filter: drop-shadow(0 6px 10px rgba(0,0,0,.08));
  }

  .btn-vip{
    border-radius: 999px;
    padding: .58rem .9rem;
    font-weight: 800;
    border: 1px solid rgba(0,0,0,.08);
    background: rgba(255,255,255,.94);
    transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
    white-space: nowrap;
  }

  .btn-vip:hover{
    box-shadow: 0 10px 20px rgba(0,0,0,.06);
    transform: translateY(-1px);
  }

  .btn-primary-soft{
    color: #0d6efd;
    background: rgba(13,110,253,.08);
    border-color: rgba(13,110,253,.18);
  }

  .muted{
    color: rgba(33,37,41,.65);
  }

  /* DataTables controls */
  .dataTables_wrapper .dataTables_length{
    float:left;
    margin-bottom: 12px;
  }

  .dataTables_wrapper .dataTables_filter{
    float:right;
    text-align:right;
    margin-bottom: 12px;
  }

  .dataTables_wrapper .dataTables_filter label,
  .dataTables_wrapper .dataTables_length label{
    font-weight: 700;
    color: rgba(33,37,41,.76);
  }

  .dataTables_wrapper .dataTables_filter input{
    border: 1px solid rgba(0,0,0,.10);
    border-radius: 999px;
    padding: 8px 12px;
    outline: none;
    margin-left: .5rem;
    background: #fff;
    min-width: 220px;
  }

  .dataTables_wrapper .dataTables_length select{
    border-radius: 999px;
    border: 1px solid rgba(0,0,0,.10);
    padding: 6px 10px;
    background:#fff;
  }

  .dataTables_wrapper .dataTables_info,
  .dataTables_wrapper .dataTables_paginate{
    margin-top: 12px !important;
  }

  .dataTables_wrapper .pagination .page-link{
    border-radius: 999px !important;
    margin: 0 2px;
  }

  /* MOBILE */
  @media (max-width: 991.98px){
    .vip-page{
      padding-top: max(50px, env(safe-area-inset-top) + 50px) !important;
      padding-bottom: max(24px, env(safe-area-inset-bottom) + 16px) !important;
    }

    .container{
      padding-left: 12px !important;
      padding-right: 12px !important;
    }

    .vip-head-top{
      flex-direction: column;
      align-items: stretch;
    }

    .vip-head-actions{
      width:100%;
      flex-direction: column;
    }

    .vip-head-actions .btn-vip{
      width:100%;
      justify-content:center;
    }

    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter{
      float:none !important;
      width:100% !important;
      text-align:left !important;
    }

    .dataTables_wrapper .dataTables_filter input{
      width:100% !important;
      min-width: 0 !important;
      margin-left:0 !important;
      margin-top:8px !important;
      box-sizing:border-box !important;
    }

    .dataTables_wrapper .dataTables_length select{
      width:100% !important;
      margin-top:8px !important;
    }

    .vip-profile{
      min-width: 230px;
    }

    th:nth-child(3),
    td:nth-child(3){
      min-width: 150px;
      white-space: nowrap;
    }

    th:nth-child(4),
    td:nth-child(4){
      min-width: 150px;
      white-space: nowrap;
    }

    th:nth-child(5),
    td:nth-child(5){
      min-width: 170px;
      white-space: nowrap;
    }
  }

  @media (max-width: 575.98px){
    .vip-page{
      padding-top: max(50px, env(safe-area-inset-top) + 50px) !important;
    }

    .vip-shell{
      border-radius: 18px;
    }

    .vip-head{
      padding: 14px 12px 12px;
    }

    .vip-body{
      padding: 12px 10px 12px;
    }

    .vip-title{
      font-size: 1.18rem;
    }

    .vip-sub{
      font-size: .88rem;
    }

    .vip-table-pad{
      padding: 6px;
      border-radius: 14px;
    }

    .vip-profile{
      min-width: 210px;
      gap:10px;
    }

    .vip-avatar,
    .vip-avatar-fallback{
      width:46px;
      height:46px;
      flex:0 0 46px;
      border-radius:14px;
    }

    .vip-name{
      font-size: .93rem;
    }

    .vip-meta{
      font-size: .8rem;
    }

    .btn-vip{
      padding: .55rem .8rem;
      font-size: .84rem;
    }

    .dataTables_wrapper .dataTables_paginate{
      overflow-x:auto !important;
      white-space: nowrap !important;
      padding-bottom: 4px !important;
    }
  }


  .stars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-size: 1rem;
    line-height: 1;
}

.star-on {
    color: #f5b301;
}

.star-off {
    color: #cbd5e1;
}

.vip-review-comment {
    max-width: 360px;
    color: #475569;
    font-size: 0.85rem;
    line-height: 1.5;
    white-space: normal;
    overflow-wrap: anywhere;
}
</style>