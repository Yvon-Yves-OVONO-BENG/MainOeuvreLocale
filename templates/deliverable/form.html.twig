{% extends 'base.html.twig' %}
{% block title %}{{ mode == 'edit' ? 'Modifier'|trans : 'Nouveau'|trans }} {{ 'livrable'|trans }}{% endblock %}

{% block body %}
<script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-[calc(100vh-80px)] bg-gradient-to-b from-slate-50 via-white to-slate-50">
  <div class="mx-auto max-w-3xl px-4 py-6">

    <div class="rounded-3xl border border-slate-200 bg-white/70 backdrop-blur-xl shadow-[0_18px_60px_rgba(15,23,42,.08)] overflow-hidden">
      <div class="p-6 sm:p-7 bg-gradient-to-r from-indigo-50 via-white to-emerald-50">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-700 shadow-sm">
              ✅ {% trans %}Checklist{% endtrans %}
            </div>
            <h1 class="mt-3 text-2xl sm:text-3xl font-black tracking-tight text-slate-900">
              {{ mode == 'edit' ? 'Modifier le livrable'|trans : 'Créer un livrable'|trans }}
            </h1>
            <p class="mt-1 text-sm text-slate-600">
              {% trans %}Un titre clair, une description utile, et éventuellement une date limite.{% endtrans %}
            </p>
          </div>

          <a href="{{ path('deliverable_index') }}"
             class="rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50 transition">
            {% trans %}← Retour{% endtrans %}
          </a>
        </div>
      </div>

      <div class="p-6 sm:p-7">
        {{ form_start(form) }}

        <div class="grid gap-4">
          <div class="rounded-2xl border border-slate-200 bg-white p-4">
            <div class="text-xs font-black text-slate-700 mb-2">{% trans %}Titre{% endtrans %}</div>
            {{ form_widget(form.title, {'attr': {'class':'w-full rounded-xl border-slate-200 focus:border-slate-900 focus:ring-slate-900'}}) }}
            {{ form_errors(form.title) }}
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-4">
            <div class="text-xs font-black text-slate-700 mb-2">{% trans %}Description{% endtrans %}</div>
            {{ form_widget(form.description, {'attr': {'class':'w-full rounded-xl border-slate-200 focus:border-slate-900 focus:ring-slate-900'}}) }}
            {{ form_errors(form.description) }}
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-4">
            <div class="text-xs font-black text-slate-700 mb-2">{% trans %}Date limite{% endtrans %}</div>
            {{ form_widget(form.dueAt, {'attr': {'class':'w-full rounded-xl border-slate-200 focus:border-slate-900 focus:ring-slate-900'}}) }}
            {{ form_errors(form.dueAt) }}
          </div>

          <div class="flex items-center justify-end gap-2">
            <a href="{{ path('deliverable_index') }}"
               class="rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50 transition">
              {% trans %}Annuler{% endtrans %}
            </a>
            <button type="submit"
                    class="rounded-2xl bg-slate-900 px-5 py-2.5 text-sm font-black text-white shadow hover:shadow-lg hover:-translate-y-[1px] transition">
              {{ mode == 'edit' ? 'Enregistrer'|trans : 'Créer'|trans }} ✅
            </button>
          </div>
        </div>

        {{ form_end(form) }}
      </div>
    </div>

  </div>
</div>
{% endblock %}