{#
    Bouton Retour global, fixe et discret.
    Il utilise l'historique du navigateur et un fallback sûr selon l'état de connexion.
#}
<div class="mol-context-back-wrap" id="molContextBackWrap">
    <button
        type="button"
        class="mol-context-back-button"
        id="molContextBackButton"
        data-fallback-url="{{ app.user ? path('tableau_de_bord') : path('accueil') }}"
        aria-label="{% trans %}Retour à la page précédente{% endtrans %}"
        title="{% trans %}Retour à la page précédente{% endtrans %}"
    >
        <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none">
            <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>{% trans %}Retour{% endtrans %}</span>
    </button>
</div>

<style>
    .mol-context-back-wrap {
        position: fixed !important;
        top: 84px;
        right: max(12px, calc((100vw - 1320px) / 2 + 14px));
        left: auto;
        z-index: 1060;
        width: auto;
        margin: 0;
        padding: 0;
        pointer-events: none;
    }

    .mol-context-back-button {
        pointer-events: auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 35px;
        padding: 7px 12px 7px 9px;
        border: 1px solid rgba(30, 64, 175, .12);
        border-radius: 999px;
        background: rgba(255, 255, 255, .88);
        color: #234f86;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .10);
        font: 750 12px/1 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        letter-spacing: .01em;
        text-decoration: none;
        cursor: pointer;
        -webkit-backdrop-filter: blur(12px);
        backdrop-filter: blur(12px);
        transition: transform .18s ease, box-shadow .18s ease, background .18s ease, border-color .18s ease;
    }

    .mol-context-back-button:hover {
        transform: translateX(-2px);
        background: rgba(255, 255, 255, .98);
        border-color: rgba(37, 99, 235, .24);
        box-shadow: 0 10px 28px rgba(15, 23, 42, .13);
    }

    .mol-context-back-button:active {
        transform: translateX(-1px) scale(.97);
    }

    .mol-context-back-button:focus-visible {
        outline: 3px solid rgba(37, 99, 235, .20);
        outline-offset: 2px;
    }

    .mol-context-back-button svg {
        flex: 0 0 auto;
    }

    @media (max-width: 767.98px) {
        .mol-context-back-wrap {
            top: 72px;
            right: 10px;
            left: auto;
        }

        .mol-context-back-button {
            min-height: 33px;
            padding: 6px 10px 6px 8px;
            font-size: 11px;
            box-shadow: 0 6px 18px rgba(15, 23, 42, .10);
        }
    }

    @media print {
        .mol-context-back-wrap {
            display: none !important;
        }
    }
</style>

<script>
(function () {
    'use strict';

    /**
     * Retourne à l'écran précédent sans créer une nouvelle entrée d'historique.
     */
    function handleGlobalBack() {
        const button = document.getElementById('molContextBackButton');
        if (!button || button.dataset.backBound === '1') return;

        button.dataset.backBound = '1';
        button.addEventListener('click', function () {
            if (window.history.length > 1) {
                window.history.back();
                return;
            }

            window.location.assign(button.dataset.fallbackUrl || '/');
        });
    }

    handleGlobalBack();
    document.addEventListener('DOMContentLoaded', handleGlobalBack);
    document.addEventListener('turbo:load', handleGlobalBack);
    document.addEventListener('turbo:render', handleGlobalBack);
    window.addEventListener('pageshow', handleGlobalBack);
})();
</script>
