<!-- Navbar principale - Complète et corrigée -->
<nav 
    class="pm-navbar-pro {% if app.request.attributes.get('_route') == 'accueil' %}pm-navbar-home{% endif %} {% if app.request.attributes.get('_route') != 'accueil' %}scrolled{% endif %}"  
    role="navigation" 
    aria-label="Navigation principale"
    id="mainNavbar"
    style="
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        width: 100%;
        height: 76px;
        min-height: 76px;
        z-index: 3000;
        margin: 0;
        padding: 0 24px;
        {% if app.request.attributes.get('_route') == 'accueil' %}
            background: transparent;
            border-bottom: 1px solid rgba(255, 255, 255, 0.12);
        {% else %}
            background: #ffffff;
            border-bottom: 1px solid rgba(15, 23, 42, 0.06);
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
        {% endif %}
        overflow: visible;
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    "
>
    <div class="pm-navbar-inner" style="width:100%;max-width:1320px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:20px;">
        
        <!-- Logo Desktop -->
        <a href="{{ path('accueil') }}"
           class="pm-brand pm-brand-desktop"
           data-turbo="false"
           style="align-items:center;gap:10px;text-decoration:none;flex-shrink:0;">
        
            <img
                src="{{ asset('build/assets/images/brand/logo.png') }}"
                alt="Main d’Œuvre Locale"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                style="height:40px;width:auto;{% if app.request.attributes.get('_route') == 'accueil' %}filter:brightness(0) invert(1);{% else %}filter:none;{% endif %}transition:filter 0.35s ease;"
            >
        </a>
        
        <!-- Logo Mobile -->
        <a href="{{ path('accueil') }}"
           class="pm-brand pm-brand-mobile"
           data-turbo="false"
           style="align-items:center;gap:10px;text-decoration:none;flex-shrink:0;">
        
            <img
                src="{{ asset('build/assets/images/brand/logoMobile.png') }}"
                alt="Main d’Œuvre Locale"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                style="height:40px;width:auto;{% if app.request.attributes.get('_route') == 'accueil' %}filter:brightness(0) invert(1);{% else %}filter:none;{% endif %}transition:filter 0.35s ease;"
            >
        </a>

        <!-- Menu Desktop -->
        <ul class="pm-desktop-menu" style="display:flex;align-items:center;gap:4px;margin:0;padding:0;list-style:none;flex:1;justify-content:center;">
            <li style="list-style:none;margin:0;padding:0;">
                <a class="pm-menu-link {% if app.request.attributes.get('_route') == 'accueil' %}active{% endif %}" 
                   href="{{ path('accueil') }}" 
                   data-turbo="false" 
                   style="display:flex;align-items:center;gap:6px;padding:8px 14px;border-radius:999px;font-size:14px;font-weight:500;text-decoration:none;transition:all 0.2s ease;background:transparent;{% if app.request.attributes.get('_route') == 'accueil' %}color:#ffffff !important;{% else %}color:#1f2937 !important;{% endif %}{% if app.request.attributes.get('_route') == 'accueil' %}background:rgba(255,255,255,0.20) !important;{% elseif app.request.attributes.get('_route') == 'accueil' %}background:rgba(37,99,235,0.10) !important;{% endif %}">
                    <i class="fas fa-home" style="font-size:13px;{% if app.request.attributes.get('_route') == 'accueil' %}color:#ffffff;{% else %}color:#1f2937;{% endif %}"></i> {% trans %}ACCUEIL{% endtrans %}
                </a>
            </li>
            <li style="list-style:none;margin:0;padding:0;">
                <a class="pm-menu-link {% if app.request.attributes.get('_route') == 'liste_jobs' %}active{% endif %}" 
                   href="{{ path('liste_jobs') }}" 
                   data-turbo="false" 
                   style="display:flex;align-items:center;gap:6px;padding:8px 14px;border-radius:999px;font-size:14px;font-weight:500;text-decoration:none;transition:all 0.2s ease;background:transparent;{% if app.request.attributes.get('_route') == 'accueil' %}color:#ffffff !important;{% else %}color:#1f2937 !important;{% endif %}{% if app.request.attributes.get('_route') == 'liste_jobs' and app.request.attributes.get('_route') == 'accueil' %}background:rgba(255,255,255,0.20) !important;{% elseif app.request.attributes.get('_route') == 'liste_jobs' %}background:rgba(37,99,235,0.10) !important;{% endif %}">
                    <i class="fas fa-briefcase" style="font-size:13px;{% if app.request.attributes.get('_route') == 'accueil' %}color:#ffffff;{% else %}color:#1f2937;{% endif %}"></i> {% trans %}MISSIONS{% endtrans %}
                </a>
            </li>
            <li style="list-style:none;margin:0;padding:0;">
                <a class="pm-menu-link {% if app.request.attributes.get('_route') == 'liste_talents' %}active{% endif %}" 
                   href="{{ path('liste_talents') }}" 
                   data-turbo="false" 
                   style="display:flex;align-items:center;gap:6px;padding:8px 14px;border-radius:999px;font-size:14px;font-weight:500;text-decoration:none;transition:all 0.2s ease;background:transparent;{% if app.request.attributes.get('_route') == 'accueil' %}color:#ffffff !important;{% else %}color:#1f2937 !important;{% endif %}{% if app.request.attributes.get('_route') == 'liste_talents' and app.request.attributes.get('_route') == 'accueil' %}background:rgba(255,255,255,0.20) !important;{% elseif app.request.attributes.get('_route') == 'liste_talents' %}background:rgba(37,99,235,0.10) !important;{% endif %}">
                    <i class="fas fa-star" style="font-size:13px;{% if app.request.attributes.get('_route') == 'accueil' %}color:#ffffff;{% else %}color:#1f2937;{% endif %}"></i>{% trans %}TALENTS{% endtrans %}
                </a>
            </li>
            <li style="list-style:none;margin:0;padding:0;position:relative;" class="pm-dropdown">
                <a class="pm-menu-link pm-dropdown-toggle {% if app.request.attributes.get('_route') in ['reputation_companies', 'reputation_particuliers'] %}active{% endif %}" 
                   href="javascript:void(0);" 
                   style="display:flex;align-items:center;gap:6px;padding:8px 14px;border-radius:999px;font-size:14px;font-weight:500;text-decoration:none;transition:all 0.2s ease;background:transparent;cursor:pointer;{% if app.request.attributes.get('_route') == 'accueil' %}color:#ffffff !important;{% else %}color:#1f2937 !important;{% endif %}{% if app.request.attributes.get('_route') in ['reputation_companies', 'reputation_particuliers'] and app.request.attributes.get('_route') == 'accueil' %}background:rgba(255,255,255,0.20) !important;{% elseif app.request.attributes.get('_route') in ['reputation_companies', 'reputation_particuliers'] %}background:rgba(37,99,235,0.10) !important;{% endif %}">
                    <i class="fas fa-users" style="font-size:13px;{% if app.request.attributes.get('_route') == 'accueil' %}color:#ffffff;{% else %}color:#1f2937;{% endif %}"></i> {% trans %}EMPLOYEURS{% endtrans %}
                    <i class="fas fa-chevron-down" style="font-size:10px;margin-left:2px;transition:transform 0.25s ease;{% if app.request.attributes.get('_route') == 'accueil' %}color:#ffffff;{% else %}color:#1f2937;{% endif %}"></i>
                </a>
                <ul class="pm-dropdown-menu" style="position:absolute;top:calc(100% + 8px);left:50%;transform:translateX(-50%) translateY(8px);min-width:200px;padding:8px;background:#ffffff;border:1px solid rgba(15,23,42,0.08);border-radius:14px;box-shadow:0 18px 40px rgba(15,23,42,0.12);opacity:0;visibility:hidden;pointer-events:none;transition:all 0.25s ease;z-index:4000;list-style:none;margin:0;">
                    <li style="list-style:none;margin:0;padding:0;">
                        <a href="{{ path('reputation_companies') }}" data-turbo="false" style="display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:10px;color:#1f2937;text-decoration:none;font-size:14px;font-weight:500;transition:all 0.2s ease;">
                            <i class="fas fa-building" style="color:#2563eb;width:18px;"></i> {% trans %}COMPAGNIES{% endtrans %}
                        </a>
                    </li>
                    <li style="list-style:none;margin:0;padding:0;">
                        <a href="{{ path('reputation_particuliers') }}" data-turbo="false" style="display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:10px;color:#1f2937;text-decoration:none;font-size:14px;font-weight:500;transition:all 0.2s ease;">
                            <i class="fas fa-user-circle" style="color:#2563eb;width:18px;"></i> {% trans %}PARTICULIERS{% endtrans %}
                        </a>
                    </li>
                    
                </ul>
            </li>

            {# A PROPOS : placé entre EMPLOYEURS et CONTACT #}
            <li style="list-style:none;margin:0;padding:0;position:relative;" class="pm-dropdown pm-about-dropdown">
                <a class="pm-menu-link pm-dropdown-toggle {% if app.request.attributes.get('_route') in ['marketing_story', 'marketing_vision', 'marketing_mission', 'marketing_services'] %}active{% endif %}"
                   href="javascript:void(0);"
                   aria-haspopup="true"
                   aria-expanded="false"
                   style="display:flex;align-items:center;gap:6px;padding:8px 14px;border-radius:999px;font-size:14px;font-weight:500;text-decoration:none;transition:all 0.2s ease;background:transparent;cursor:pointer;{% if app.request.attributes.get('_route') == 'accueil' %}color:#ffffff !important;{% else %}color:#1f2937 !important;{% endif %}{% if app.request.attributes.get('_route') in ['marketing_story', 'marketing_vision', 'marketing_mission', 'marketing_services'] %}background:rgba(37,99,235,0.10) !important;{% endif %}">
                    <i class="fas fa-info-circle" style="font-size:13px;{% if app.request.attributes.get('_route') == 'accueil' %}color:#ffffff;{% else %}color:#1f2937;{% endif %}"></i>
                    {% trans %}A PROPOS{% endtrans %}
                    <i class="fas fa-chevron-down" style="font-size:10px;margin-left:2px;transition:transform 0.25s ease;{% if app.request.attributes.get('_route') == 'accueil' %}color:#ffffff;{% else %}color:#1f2937;{% endif %}"></i>
                </a>

                <ul class="pm-dropdown-menu" style="position:absolute;top:calc(100% + 8px);left:50%;transform:translateX(-50%) translateY(8px);min-width:220px;padding:8px;background:#ffffff;border:1px solid rgba(15,23,42,0.08);border-radius:14px;box-shadow:0 18px 40px rgba(15,23,42,0.12);opacity:0;visibility:hidden;pointer-events:none;transition:all 0.25s ease;z-index:4000;list-style:none;margin:0;">
                    <li style="list-style:none;margin:0;padding:0;">
                        <a href="{{ path('marketing_story') }}" data-turbo="false" style="display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:10px;color:#1f2937;text-decoration:none;font-size:14px;font-weight:500;transition:all 0.2s ease;">
                            <i class="fas fa-book-open" style="color:#2563eb;width:18px;"></i> {% trans %}NOTRE HISTOIRE{% endtrans %}
                        </a>
                    </li>
                    <li style="list-style:none;margin:0;padding:0;">
                        <a href="{{ path('marketing_vision') }}" data-turbo="false" style="display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:10px;color:#1f2937;text-decoration:none;font-size:14px;font-weight:500;transition:all 0.2s ease;">
                            <i class="fas fa-eye" style="color:#2563eb;width:18px;"></i> {% trans %}NOTRE VISION{% endtrans %}
                        </a>
                    </li>
                    <li style="list-style:none;margin:0;padding:0;">
                        <a href="{{ path('marketing_mission') }}" data-turbo="false" style="display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:10px;color:#1f2937;text-decoration:none;font-size:14px;font-weight:500;transition:all 0.2s ease;">
                            <i class="fas fa-bullseye" style="color:#2563eb;width:18px;"></i> {% trans %}NOTRE MISSION{% endtrans %}
                        </a>
                    </li>
                    <li style="list-style:none;margin:0;padding:0;">
                        <a href="{{ path('marketing_services') }}" data-turbo="false" style="display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:10px;color:#1f2937;text-decoration:none;font-size:14px;font-weight:500;transition:all 0.2s ease;">
                            <i class="fas fa-concierge-bell" style="color:#2563eb;width:18px;"></i> {% trans %}NOS SERVICES{% endtrans %}
                        </a>
                    </li>
                </ul>
            </li>

            <li style="list-style:none;margin:0;padding:0;">
                <a class="pm-menu-link {% if app.request.attributes.get('_route') starts with 'subscription_' %}active{% endif %}"
                   href="{{ path('subscription_plans') }}"
                   data-turbo="false"
                   style="display:flex;align-items:center;gap:5px;padding:8px 10px;border-radius:999px;font-size:13px;font-weight:500;text-decoration:none;transition:all 0.2s ease;background:transparent;{% if app.request.attributes.get('_route') == 'accueil' %}color:#ffffff !important;{% else %}color:#1f2937 !important;{% endif %}{% if app.request.attributes.get('_route') starts with 'subscription_' %}background:rgba(37,99,235,0.10) !important;{% endif %}">
                    <i class="fas fa-tags" style="font-size:12px;{% if app.request.attributes.get('_route') == 'accueil' %}color:#ffffff;{% else %}color:#1f2937;{% endif %}"></i> {% trans %}ABONNEMENT{% endtrans %}
                </a>
            </li>
            
            <li style="list-style:none;margin:0;padding:0;">
                <a class="pm-menu-link {% if app.request.attributes.get('_route') == 'contact_page' %}active{% endif %}" 
                   href="{{ path('contact_page') }}" 
                   data-turbo="false" 
                   style="display:flex;align-items:center;gap:6px;padding:8px 14px;border-radius:999px;font-size:14px;font-weight:500;text-decoration:none;transition:all 0.2s ease;background:transparent;{% if app.request.attributes.get('_route') == 'accueil' %}color:#ffffff !important;{% else %}color:#1f2937 !important;{% endif %}{% if app.request.attributes.get('_route') == 'contact_page' and app.request.attributes.get('_route') == 'accueil' %}background:rgba(255,255,255,0.20) !important;{% elseif app.request.attributes.get('_route') == 'contact_page' %}background:rgba(37,99,235,0.10) !important;{% endif %}">
                    <i class="fas fa-envelope" style="font-size:13px;{% if app.request.attributes.get('_route') == 'accueil' %}color:#ffffff;{% else %}color:#1f2937;{% endif %}"></i> {% trans %}CONTACT{% endtrans %}
                </a>
            </li>
        </ul>

        <!-- Actions Desktop -->
        <div class="pm-desktop-actions" style="display:flex;align-items:center;gap:10px;flex-shrink:0;">
            <!-- Langue - Déroulant -->
            <div class="pm-lang-selector" style="position:relative;">
                <button class="pm-lang-btn" style="display:flex;align-items:center;gap:6px;padding:6px 12px;border-radius:999px;border:1px solid {% if app.request.attributes.get('_route') == 'accueil' %}rgba(255,255,255,0.25){% else %}rgba(15,23,42,0.15){% endif %};background:{% if app.request.attributes.get('_route') == 'accueil' %}rgba(255,255,255,0.08){% else %}rgba(255,255,255,0.9){% endif %};color:{% if app.request.attributes.get('_route') == 'accueil' %}#ffffff{% else %}#1f2937{% endif %};font-size:13px;font-weight:500;cursor:pointer;transition:all 0.2s ease;">
                    <img src="{{ asset('build/assets/' ~ app.request.locale ~ '.png') }}" alt="FR" style="width:18px;height:13px;border-radius:2px;">
                    <span>{{ app.request.locale|upper }}</span>
                    <i class="fas fa-chevron-down" style="font-size:10px;transition:transform 0.25s ease;"></i>
                </button>
                <div class="pm-lang-dropdown" style="position:absolute;top:calc(100% + 8px);right:0;min-width:180px;padding:6px;background:#ffffff;border:1px solid rgba(15,23,42,0.08);border-radius:14px;box-shadow:0 18px 40px rgba(15,23,42,0.12);opacity:0;visibility:hidden;pointer-events:none;transform:translateY(8px);transition:all 0.25s ease;z-index:4000;">
                    {% for locale in locales %}
                        <a href="{{ path('change_locale', {'locale': locale}) }}" data-turbo="false" style="display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:10px;color:#1f2937;text-decoration:none;font-size:13px;font-weight:500;transition:all 0.2s ease;{% if locale == app.request.locale %}background:#eff6ff;color:#2563eb;{% endif %}">
                            <img src="{{ asset('build/assets/' ~ locale ~ '.png') }}" alt="{{ locale }}" style="width:18px;height:13px;border-radius:2px;">
                            <span>{% if locale == 'fr' %}{% trans %}Français{% endtrans %}{% else %}{% trans %}Anglais{% endtrans %}{% endif %}</span>
                            {% if locale == app.request.locale %}
                                <i class="fas fa-check" style="margin-left:auto;color:#2563eb;font-size:12px;"></i>
                            {% endif %}
                        </a>
                    {% endfor %}
                </div>
            </div>

            <!-- Compte Utilisateur -->
            {% if app.user %}
                <div class="pm-user-dropdown" style="position:relative;">
                    <button type="button" class="pm-user-btn" aria-haspopup="true" aria-expanded="false">
                        <span class="pm-user-btn-avatar" aria-hidden="true">
                            <i class="fas fa-user"></i>
                        </span>

                        <span class="pm-user-btn-label">{% trans %}Mon compte{% endtrans %}</span>

                        <span class="pm-user-btn-chevron" aria-hidden="true">
                            <i class="fas fa-chevron-down"></i>
                        </span>
                    </button>
                    <div class="pm-user-dropdown-menu" aria-hidden="true" style="position:absolute;top:calc(100% + 8px);right:0;width:280px;padding:8px;background:#ffffff;border:1px solid rgba(15,23,42,0.08);border-radius:16px;box-shadow:0 18px 40px rgba(15,23,42,0.12);opacity:0;visibility:hidden;pointer-events:none;transform:translateY(8px);transition:all 0.25s ease;z-index:4000;">
                        <div style="padding:12px;margin-bottom:6px;border-radius:12px;background:#f8fafc;border:1px solid rgba(15,23,42,0.06);">
                            <div style="display:flex;align-items:center;gap:12px;">
                                <div style="width:44px;height:44px;border-radius:50%;overflow:hidden;background:linear-gradient(135deg,#2563eb,#4f46e5);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#ffffff;font-weight:700;font-size:18px;">
                                    {% if app.user.photo is defined and app.user.photo %}
                                        <img src="{{ asset('uploads/users/' ~ app.user.photo) }}" alt="{{ app.user.email }}" style="width:100%;height:100%;object-fit:cover;">
                                    {% else %}
                                        <span>{{ app.user.email|slice(0, 1)|upper }}</span>
                                    {% endif %}
                                </div>
                                <div style="min-width:0;">
                                    <p style="margin:0;font-size:14px;font-weight:700;color:#0f172a;">{{ app.user.email }}</p>
                                    <span style="font-size:12px;color:#64748b;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{% trans %}Espace membre{% endtrans %}</span>
                                </div>
                            </div>
                        </div>
                        <div style="padding:4px 0;">
                            <a href="{{ path('tableau_de_bord') }}" data-turbo="false" style="display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:10px;color:#1f2937;text-decoration:none;font-size:13px;font-weight:500;transition:all 0.2s ease;">
                                <i class="fas fa-tachometer-alt" style="width:20px;color:#2563eb;"></i> {% trans %}Tableau de bord{% endtrans %}
                            </a>
                            <a href="{{ path('profile_edit') }}" data-turbo="false" style="display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:10px;color:#1f2937;text-decoration:none;font-size:13px;font-weight:500;transition:all 0.2s ease;">
                                <i class="fas fa-id-card" style="width:20px;color:#2563eb;"></i> {% trans %}Mon profil{% endtrans %}
                            </a>
                            <a href="{{ path('settings_index', { tab: 'security' }) }}" data-turbo="false" style="display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:10px;color:#1f2937;text-decoration:none;font-size:13px;font-weight:500;transition:all 0.2s ease;">
                                <i class="fas fa-lock" style="width:20px;color:#2563eb;"></i> {% trans %}Sécurité{% endtrans %}
                            </a>
                            <a href="{{ path('settings_index') }}" data-turbo="false" style="display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:10px;color:#1f2937;text-decoration:none;font-size:13px;font-weight:500;transition:all 0.2s ease;">
                                <i class="fas fa-cog" style="width:20px;color:#2563eb;"></i> {% trans %}Paramètres{% endtrans %}
                            </a>
                        </div>
                        <div style="padding:4px 0;border-top:1px solid rgba(15,23,42,0.06);margin-top:4px;">
                            <a href="{{ path('app_logout') }}" data-mol-chat-reset-session data-turbo="false" style="display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:10px;color:#dc2626;text-decoration:none;font-size:13px;font-weight:500;transition:all 0.2s ease;">
                                <i class="fas fa-sign-out-alt" style="width:20px;"></i> {% trans %}Déconnexion{% endtrans %}
                            </a>
                        </div>
                    </div>
                </div>
            {% else %}
                <a href="{{ path('app_login') }}" data-turbo="false" class="mol-auth-btn mol-auth-login">
                    <span class="mol-btn-content">
                        <i class="fas fa-sign-in-alt"></i>
                        <span>{% trans %}Connexion{% endtrans %}</span>
                    </span>
                    <i class="fas fa-spinner fa-spin mol-btn-spinner"></i>
                </a>
                
                <a href="{{ path('app_register') }}" data-turbo="false" class="mol-auth-btn mol-auth-register">
                    <span class="mol-btn-content">
                        <i class="fas fa-user-plus"></i>
                        <span>{% trans %}Inscription{% endtrans %}</span>
                    </span>
                    <i class="fas fa-spinner fa-spin mol-btn-spinner"></i>
                </a>
                                
            {% endif %}

            <!-- Hamburger -->
            <button id="pmHamburgerBtn" aria-label="Menu" style="display:none;width:42px;height:42px;border:1px solid {% if app.request.attributes.get('_route') == 'accueil' %}rgba(255,255,255,0.25){% else %}rgba(15,23,42,0.15){% endif %};border-radius:12px;background:{% if app.request.attributes.get('_route') == 'accueil' %}rgba(255,255,255,0.08){% else %}rgba(255,255,255,0.9){% endif %};color:{% if app.request.attributes.get('_route') == 'accueil' %}#ffffff{% else %}#1f2937{% endif %};cursor:pointer;flex-direction:column;align-items:center;justify-content:center;gap:4px;padding:0;transition:all 0.2s ease;">
                <span style="display:block;width:20px;height:2px;background:{% if app.request.attributes.get('_route') == 'accueil' %}#ffffff{% else %}#1f2937{% endif %};border-radius:2px;transition:all 0.3s ease;"></span>
                <span style="display:block;width:20px;height:2px;background:{% if app.request.attributes.get('_route') == 'accueil' %}#ffffff{% else %}#1f2937{% endif %};border-radius:2px;transition:all 0.3s ease;"></span>
                <span style="display:block;width:20px;height:2px;background:{% if app.request.attributes.get('_route') == 'accueil' %}#ffffff{% else %}#1f2937{% endif %};border-radius:2px;transition:all 0.3s ease;"></span>
            </button>
        </div>
    </div>
