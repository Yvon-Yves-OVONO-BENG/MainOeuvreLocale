            /* Conserve les photos et la taille des badges, avec un fond transparent. */
            .mol-job-card .mol-job-author,
            .mol-job-card .mol-job-author-empty,
            .mol-job-card .mol-publication-badge {
                background: transparent !important;
                border-color: transparent !important;
                box-shadow: none !important;
                backdrop-filter: none !important;
                -webkit-backdrop-filter: none !important;
            }
          </style>
