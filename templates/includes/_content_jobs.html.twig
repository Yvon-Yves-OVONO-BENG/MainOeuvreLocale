<style>
    .mol-job-card {
    position: relative;
    overflow: hidden;
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 14px 35px rgba(0, 55, 110, .10);
    transition: .25s ease;
    height: 100%;
    }

    .mol-job-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 45px rgba(0, 55, 110, .16);
    }

    .mol-job-cover {
        position: relative;
        height: 145px;
        overflow: visible;
        border-radius: 8px 8px 0 0;
    }

    .mol-job-cover > img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        position: relative;
        z-index: 2;
    }

    /* Fallback métier : reste lisible même si la photo métier est absente ou cassée. */
    .mol-job-cover-fallback {
        position: absolute;
        inset: 0;
        z-index: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 16px;
        text-align: center;
        background: linear-gradient(145deg, #eef6ff, #f4fbef);
        color: #0b4fa3;
    }

    .mol-job-cover-fallback i { font-size: 32px; }
    .mol-job-cover-fallback span {
        max-width: 100%;
        font-size: 11px;
        line-height: 1.25;
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    .mol-job-cover.is-media-error > img { display: none; }

    /* Skeleton léger pendant le lazy-loading des visuels d'offres. */
    .mol-job-cover.has-media::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 1;
        border-radius: inherit;
        background: linear-gradient(100deg, #edf2f7 25%, #f8fafc 42%, #edf2f7 60%);
        background-size: 220% 100%;
        animation: molJobImageSkeleton 1.15s linear infinite;
        transition: opacity .2s ease;
        pointer-events: none;
    }

    .mol-job-cover.has-media > img {
        opacity: 0;
        transition: opacity .22s ease;
    }

    .mol-job-cover.has-media.is-loaded::before { opacity: 0; animation: none; }
    .mol-job-cover.has-media.is-loaded > img { opacity: 1; }

    @keyframes molJobImageSkeleton {
        from { background-position: 100% 0; }
        to { background-position: -120% 0; }
    }


    /* Photo de l'auteur de l'annonce */
    .mol-job-author {
        position: absolute;
        left: 16px;
        bottom: -24px;
        width: 56px;
        height: 56px;
        border: 4px solid #fff;
        border-radius: 14px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 8px 22px rgba(0, 51, 120, .18);
        z-index: 5;
    }

    .mol-job-author img,
    .mol-job-author-empty {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .mol-job-author-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef7ff;
        color: #0b4fa3;
    }

    /* Corps */
    .mol-job-body {
        padding: 36px 16px 16px;
        background: #fff;
    }

    .mol-job-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
    }

    .mol-job-title {
        display: block;
        color: #05245c;
        font-size: 15px;
        font-weight: 900;
        line-height: 1.35;
        text-decoration: none;
    }

    .mol-job-title:hover {
        color: #55b900;
    }

    .mol-job-meta {
        margin-top: 9px;
        display: flex;
        align-items: center;
        gap: 6px;
        color: #64748b;
        font-size: 13px;
    }

    .mol-job-meta i {
        color: #f5b400;
    }

    /* Bouton Détail */
    .mol-job-view {
        flex: 0 0 auto;
        max-width: 92px;
        padding: 9px 14px;
        border-radius: 999px;
        background: linear-gradient(135deg, #55b900, #35a000);
        color: #fff;
        font-size: 11px;
        font-weight: 900;
        text-transform: uppercase;
        text-decoration: none;
        letter-spacing: .25px;
        white-space: nowrap;
        box-shadow: 0 8px 18px rgba(85, 185, 0, .28);
    }

    .mol-job-view:hover {
        background: linear-gradient(135deg, #4aa600, #2f8f00);
        color: #fff;
    }

    /* Footer vert doux */
    .mol-job-footer {
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: linear-gradient(135deg, #eaf8df, #dff4d0);
        border-top: 1px solid rgba(85, 185, 0, .22);
    }

    .mol-job-price {
        min-height: 50px;
        padding: 8px 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        color: #246400;
        font-size: 12px;
        font-weight: 800;
        text-align: center;
    }

    .mol-job-price + .mol-job-price {
        border-left: 1px solid rgba(85, 185, 0, .22);
    }

    .mol-job-price i {
        font-size: 17px;
        color: #55b900;
    }

    /* Sécurité anti-débordement */
    .mol-job-title,
    .mol-job-meta span,
    .mol-job-price span {
        overflow-wrap: anywhere;
    }

    /* Mobile */
    @media (max-width: 575px) {
        .mol-job-cover {
            height: 118px;
        }

        .mol-job-body {
            padding: 34px 12px 14px;
        }

        .mol-job-head {
            display: block;
        }

        .mol-job-title {
            font-size: 13px;
            line-height: 1.32;
            padding-right: 0;
        }

        .mol-job-view {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-top: 12px;
            width: 100%;
            max-width: 100%;
            padding: 9px 10px;
            font-size: 10px;
        }

        .mol-job-footer {
            grid-template-columns: 1fr;
        }

        .mol-job-price + .mol-job-price {
            border-left: 0;
            border-top: 1px solid rgba(85, 185, 0, .22);
        }
    }
        
    
    
    .mol-job-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        background: linear-gradient(135deg, #eaf8df, #dff4d0);
        border-top: 1px solid rgba(85, 185, 0, .22);
        padding: 10px 12px;
    }

    .mol-job-price {
        min-height: auto;
        padding: 0;
        justify-content: flex-start;
    }

    .mol-job-view {
        flex: 0 0 auto;
        max-width: none;
        padding: 8px 13px;
    }

    @media (max-width: 575px) {
        .mol-job-footer {
            flex-direction: column;
            align-items: stretch;
        }

        .mol-job-view {
            width: 100%;
            text-align: center;
        }
    } 

    /* =========================================================
    TITRE SUR UNE SEULE LIGNE + CARTES SANS ESPACE VIDE
    ========================================================= */

    .mol-job-card {
        display: flex;
        flex-direction: column;
    }

    .mol-publication-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        z-index: 6;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(5, 36, 92, .18) !important;
        border: 1px solid rgba(255, 255, 255, .70);
        backdrop-filter: blur(1px);
        -webkit-backdrop-filter: blur(1px);
        color: #fff;
        box-shadow: 0 8px 20px rgba(5, 36, 92, .22);
        font-size: 9px;
        font-weight: 900;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    /* Le titre reste toujours sur une seule ligne */
    .mol-job-title {
        display: block;
        width: 100%;
        min-width: 0;

        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        overflow-wrap: normal;
    }

    /* Corps compact */
    .mol-job-body {
        flex: 0 0 auto;
        padding-bottom: 12px;
    }

    /* Le footer reste collé en bas de la carte */
    .mol-job-footer {
        margin-top: auto;
        flex-shrink: 0;
    }
</style>
<script>
(function () {
    function bindJobImageSkeletons(root) {
        (root || document).querySelectorAll('.mol-job-cover.has-media').forEach(function (cover) {
            if (cover.dataset.imageSkeletonBound === '1') return;
            cover.dataset.imageSkeletonBound = '1';
            const image = cover.querySelector(':scope > img');
            if (!image) { cover.classList.add('is-loaded'); return; }
            const done = function () { cover.classList.add('is-loaded'); };
            if (image.complete) { if (!image.naturalWidth) cover.classList.add('is-media-error'); done(); }
            else { image.addEventListener('load', done, {once:true}); image.addEventListener('error', function(){ cover.classList.add('is-media-error'); done(); }, {once:true}); }
        });
    }
    document.addEventListener('DOMContentLoaded', function(){ bindJobImageSkeletons(document); });
    document.addEventListener('turbo:load', function(){ bindJobImageSkeletons(document); });
    document.addEventListener('mol:home-content-updated', function(event){ bindJobImageSkeletons(event.target || document); });
})();
</script>

<!-- CONTENT -->
        {% set isHomeJobsSection = routeName|default('liste_jobs') == 'accueil' %}
