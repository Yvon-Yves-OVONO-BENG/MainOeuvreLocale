            border: 1px solid rgba(255, 255, 255, .45);
            border-radius: 999px;
            background: rgba(15, 23, 42, .18);
            backdrop-filter: blur(3px);
            -webkit-backdrop-filter: blur(3px);
            color: #fff;
            text-shadow: 0 1px 3px rgba(0, 0, 0, .85);
            font-size: 10px;
            font-weight: 700;
            line-height: 1.3;
            pointer-events: none;
        }
        .mol-job-card .mol-card-type-badge i { flex-shrink: 0; }
        @media (max-width: 575px) {
            .mol-job-card .mol-card-type-badge {
                top: 8px; left: 8px; max-width: calc(100% - 16px);
                padding: 5px 7px; gap: 4px; font-size: 9px;
            }
