                    <div class="row g-4 mt-1">
                        {% for j in jobs %}
                            <div class="col-6 col-lg-3">
                                <article class="mol-job-card">

                                    {% set professionName = j.profession ? j.profession.profession : j.title %}
                                    {% set professionKey = professionName|default('')|lower %}
                                    {% set professionIcon = 'fa-briefcase' %}
                                    {% if 'jardin' in professionKey or 'agri' in professionKey %}{% set professionIcon = 'fa-seedling' %}
                                    {% elseif 'web' in professionKey or 'site' in professionKey or 'dévelop' in professionKey or 'develop' in professionKey or 'informat' in professionKey %}{% set professionIcon = 'fa-laptop-code' %}
                                    {% elseif 'maçon' in professionKey or 'macon' in professionKey or 'btp' in professionKey or 'construction' in professionKey %}{% set professionIcon = 'fa-helmet-safety' %}
                                    {% elseif 'menuis' in professionKey or 'charpent' in professionKey %}{% set professionIcon = 'fa-hammer' %}
                                    {% elseif 'plomb' in professionKey %}{% set professionIcon = 'fa-faucet-drip' %}
                                    {% elseif 'élect' in professionKey or 'elect' in professionKey %}{% set professionIcon = 'fa-bolt' %}
                                    {% elseif 'chauff' in professionKey or 'conduct' in professionKey %}{% set professionIcon = 'fa-car' %}
                                    {% elseif 'ménage' in professionKey or 'menage' in professionKey or 'nettoy' in professionKey %}{% set professionIcon = 'fa-broom' %}
                                    {% elseif 'cuisin' in professionKey or 'restaur' in professionKey %}{% set professionIcon = 'fa-utensils' %}
                                    {% elseif 'coiff' in professionKey or 'beauté' in professionKey or 'beaute' in professionKey %}{% set professionIcon = 'fa-scissors' %}
                                    {% elseif 'sécur' in professionKey or 'secur' in professionKey %}{% set professionIcon = 'fa-shield-halved' %}
                                    {% elseif 'administr' in professionKey or 'secret' in professionKey or 'assistant' in professionKey %}{% set professionIcon = 'fa-file-lines' %}
                                    {% elseif 'vente' in professionKey or 'commerce' in professionKey %}{% set professionIcon = 'fa-store' %}
                                    {% endif %}

                                    <div class="mol-job-cover{{ j.profession and j.profession.photo ? ' has-media' : '' }}">
                            <span class="mol-card-type-badge"><i class="fa-solid fa-briefcase" aria-hidden="true"></i><span>{% trans %}Offre d'emploi{% endtrans %}</span></span>
                                        <div class="mol-job-cover-fallback">
                                            <i class="fa-solid {{ professionIcon }}"></i>
                                            <span>{{ professionName|default(j.title) }}</span>
                                        </div>
                                        {% if j.profession and j.profession.photo %}
                                            <img src="{{ asset('uploads/professions/' ~ j.profession.photo) }}" alt="{{ professionName|default(j.title) }}" loading="lazy" decoding="async" fetchpriority="low">
                                        {% endif %}

                                        <div class="mol-job-author">
                                            {% if j.createdBy.personalProfile.photo is defined and j.createdBy.personalProfile.photo %}
                                                <img src="{{ asset('uploads/profiles/' ~ j.createdBy.personalProfile.photo) }}" alt="Photo de {{ j.createdBy.personalProfile.nom|default('l’utilisateur') }}" loading="lazy" decoding="async" fetchpriority="low">
                                            {% else %}
                                                <div class="mol-job-author-empty" aria-label="Photo de profil indisponible">
                                                    <i class="fa fa-user" aria-hidden="true"></i>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>

                                    <div class="mol-job-body">
                                        {% set fullTitle = j.title ?? ('Offre'|trans) %}
                                        {% set displayedTitle = fullTitle %}
                                        
                                        {# Maximum conseillé pour la largeur actuelle des cartes #}
                                        {% if fullTitle|length > 34 %}
                                            {% set displayedTitle = fullTitle|slice(0, 34)|trim ~ '…' %}
                                        {% endif %}
                                        
                                        <a
                                            href="{{ path('job_detail', { slug: j.slug }) }}"
                                            class="mol-job-title"
                                            title="{{ fullTitle }}"
                                            aria-label="{{ fullTitle }}"
                                        >
                                            {{ displayedTitle }}
                                        </a>

                                        <div class="mol-job-meta">
                                            <i class="fa fa-map-marker"></i>
                                            <span>{{ j.city }}</span>
                                        </div>
                                        
                                    </div>

                                    <div class="mol-job-footer">
                                        <div class="mol-job-price">
                                            <i class="fa fa-calendar"></i>
                                            <span>{{ j.createdAt ? j.createdAt|ago : 'récemment'|trans }}</span>
                                        </div>

                                        <a href="{{ path('job_detail', { slug: j.slug }) }}" class="mol-job-view" data-turbo="false">
                                            {% trans %}Voir l'annonce{% endtrans %}
                                        </a>
                                    </div>

                                </article>
                            </div>
                        {% endfor %}
                    </div>
               
      
                <!-- Pagination -->
                {% if pages > 1 %}
                  {% set currentRouteName = routeName|default('liste_jobs') %}
                  {% set currentRouteParams = routeParams|default({}) %}
                  {% set paginationAnchor = currentRouteName == 'accueil' ? '#missions' : '' %}
                  {% set prev = page - 1 %}
                  {% set next = page + 1 %}
      
                  <div class="vip-pager">
                    <a class="vip-pagebtn {{ page == 1 ? 'disabled' : '' }}"
                      {% if currentRouteName == 'accueil' %}data-turbo="false"{% endif %}
                      href="{{ path(currentRouteName, currentRouteParams|merge(app.request.query.all|merge({'page': (prev < 1 ? 1 : prev)}))) }}{{ paginationAnchor }}">
                      {% trans %}Précédent{% endtrans %}
                    </a>
      
                    {% for p in 1..pages %}
                      {% if p == 1 or p == pages or (p >= page-1 and p <= page+1) %}
                        <a class="vip-pagebtn {{ p == page ? 'active' : '' }}"
                          {% if currentRouteName == 'accueil' %}data-turbo="false"{% endif %}
                          href="{{ path(currentRouteName, currentRouteParams|merge(app.request.query.all|merge({'page': p}))) }}{{ paginationAnchor }}">
                          {{ p }}
                        </a>
                      {% elseif p == page-2 or p == page+2 %}
                        <span class="vip-pagebtn" style="opacity:.55;">…</span>
                      {% endif %}
                    {% endfor %}
      
                    <a class="vip-pagebtn {{ page == pages ? 'disabled' : '' }}"
                      {% if currentRouteName == 'accueil' %}data-turbo="false"{% endif %}
                      href="{{ path(currentRouteName, currentRouteParams|merge(app.request.query.all|merge({'page': (next > pages ? pages : next)}))) }}{{ paginationAnchor }}">
                      {% trans %}Suivant{% endtrans %}
                    </a>
                  </div>
                {% endif %}
              </div>
      
          </div>
        </section>

