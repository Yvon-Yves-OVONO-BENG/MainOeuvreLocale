<script id="mol-block-settings-modal-script">
(() => {
    if (window.__MOL_BLOCK_SETTINGS_MODULE__) return;
    window.__MOL_BLOCK_SETTINGS_MODULE__ = true;

    let previousPanelAction = window.MOLChatPanelAction || null;
    let lastFocusedElement = null;

    function modal() {
        return document.getElementById('molBlockSettingsModal');
    }

    function qsa(selector, root = document) {
        return Array.from(root.querySelectorAll(selector));
    }

    function escapeHtml(value) {
        return String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#039;');
    }

    function notify(type, title, text = '') {
        if (window.Swal) {
            Swal.fire({
                icon: type || 'info',
                title: title || '',
                text: text || '',
                timer: type === 'success' ? 1700 : undefined,
                showConfirmButton: type !== 'success',
                confirmButtonColor: '#dc2626',
                backdrop: 'rgba(15,23,42,.38)'
            });
            return;
        }

        alert([title, text].filter(Boolean).join('\n'));
    }

    function cleanupBootstrapBackdrops() {
        /*
         * Corrige le bug de page grisée :
         * si une ancienne modale Bootstrap a laissé un backdrop sans modale visible,
         * on nettoie le backdrop et les classes body.
         */
        const hasVisibleBootstrapModal = !!document.querySelector('.modal.show');

        if (!hasVisibleBootstrapModal) {
            document.querySelectorAll('.modal-backdrop').forEach((backdrop) => backdrop.remove());
            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('overflow');
            document.body.style.removeProperty('padding-right');
        }
    }

    function closeAnyPanelMenu() {
        try {
            window.MOLChatPanelMenu?.close?.();
        } catch (_) {}

        document
            .querySelectorAll('#molChatPanelMenuFinal, #molChatPanelMenu, #molChatPanelMenuRescue, .mol-chat-menu, .mol-panel-menu')
            .forEach((menu) => {
                menu.classList.remove('is-open', 'show');
                menu.setAttribute('aria-hidden', 'true');
                if (menu.id === 'molChatPanelMenuRescue') {
                    menu.style.display = 'none';
                }
            });

        document
            .querySelectorAll('#molChatPanelOptionsBtnFinal, #molChatPanelOptionsBtn, #molChatPanelOptionsBtnRescue, [aria-expanded="true"]')
            .forEach((button) => {
                if (
                    button.matches('#molChatPanelOptionsBtnFinal, #molChatPanelOptionsBtn, #molChatPanelOptionsBtnRescue') ||
                    button.matches('[data-mol-menu-toggle], [data-mol-chat-dropdown-toggle], [data-bs-toggle="dropdown"]')
                ) {
                    button.setAttribute('aria-expanded', 'false');
                }
            });
    }

    function openModal() {
        const m = modal();
        if (!m) return;

        cleanupBootstrapBackdrops();
        closeAnyPanelMenu();

        lastFocusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;

        m.hidden = false;
        m.setAttribute('aria-hidden', 'false');
        document.body.classList.add('mol-block-modal-open');

        requestAnimationFrame(() => {
            m.classList.add('is-open');
            const firstInput = m.querySelector('input[name="identifier"]');
            if (firstInput) setTimeout(() => firstInput.focus(), 160);
        });

        loadStatus();
    }

    function closeModal() {
        const m = modal();
        if (!m) return;

        m.classList.remove('is-open');
        m.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('mol-block-modal-open');

        setTimeout(() => {
            m.hidden = true;
            cleanupBootstrapBackdrops();
            try {
                lastFocusedElement?.focus?.();
            } catch (_) {}
        }, 180);
    }

    function unblockUrl(id) {
        const m = modal();
        const template = m?.dataset.unblockUrlTemplate || '';

        return template
            .replace('/0', '/' + encodeURIComponent(id))
            .replace('=0', '=' + encodeURIComponent(id));
    }

    function applySettings(settings = {}) {
        const m = modal();
        if (!m) return;

        qsa('[data-block-setting]', m).forEach((input) => {
            input.checked = !!settings[input.dataset.blockSetting];
        });
    }

    function getFilteredBlockedUsers(items = []) {
        const m = modal();
        const query = String(m?.querySelector('[data-mol-block-search]')?.value || '').trim().toLowerCase();

        if (!query) return items;

        return items.filter((item) => {
            return [item.label, item.identifier, item.reason]
                .filter(Boolean)
                .join(' ')
                .toLowerCase()
                .includes(query);
        });
    }

    function renderBlockedUsers(items = []) {
        const list = document.getElementById('molBlockedUsersList');
        if (!list) return;

        const filtered = getFilteredBlockedUsers(items);
        list.dataset.rawItems = JSON.stringify(items || []);

        if (!filtered.length) {
            list.innerHTML = `<div class="mol-block-empty">${items.length ? 'Aucun résultat.' : 'Aucun utilisateur bloqué.'}</div>`;
            return;
        }

        list.innerHTML = filtered.map((item) => `
            <div class="mol-blocked-item">
                <div>
                    <strong>${escapeHtml(item.label || item.identifier || 'Utilisateur bloqué')}</strong>
                    <small>${escapeHtml(item.identifier || '')}</small>
                    ${item.reason ? `<small>Raison : ${escapeHtml(item.reason)}</small>` : ''}
                </div>

                <button type="button" class="mol-block-btn mol-block-btn--danger-soft" data-mol-unblock="${Number(item.id)}">
                    Débloquer
                </button>
            </div>
        `).join('');
    }

    async function loadStatus() {
        const m = modal();
        if (!m) return;

        try {
            const response = await fetch(m.dataset.statusUrl, {
                method: 'GET',
                credentials: 'same-origin',
                cache: 'no-store',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                }
            });

            const data = await response.json().catch(() => ({}));

            if (!response.ok || data.success !== true) {
                throw new Error(data.message || 'Impossible de charger les réglages.');
            }

            applySettings(data.settings || {});
            renderBlockedUsers(data.blockedUsers || []);
        } catch (error) {
            console.error('[MOL BLOCK SETTINGS] status error', error);
            renderBlockedUsers([]);
        }
    }

    async function saveSettings() {
        const m = modal();
        if (!m) return;

        const button = m.querySelector('[data-mol-block-save]');
        const formData = new FormData();

        formData.append('_token', m.dataset.csrf || '');

        qsa('[data-block-setting]', m).forEach((input) => {
            formData.append(input.dataset.blockSetting, input.checked ? '1' : '0');
        });

        try {
            button?.classList.add('is-loading');
            if (button) button.disabled = true;

            const response = await fetch(m.dataset.saveUrl, {
                method: 'POST',
                credentials: 'same-origin',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                }
            });

            const data = await response.json().catch(() => ({}));

            if (!response.ok || data.success !== true) {
                throw new Error(data.message || 'Impossible d’enregistrer les réglages.');
            }

            notify('success', 'Réglages enregistrés', data.message || 'Les réglages de blocage ont été mis à jour.');
            closeModal();
        } catch (error) {
            showError(error.message || 'Impossible d’enregistrer les réglages.');
        } finally {
            button?.classList.remove('is-loading');
            if (button) button.disabled = false;
        }
    }

    async function blockUser(form) {
        const m = modal();
        if (!m) return;

        const identifier = String(form.querySelector('[name="identifier"]')?.value || '').trim();

        if (!identifier) {
            showError('Saisissez un identifiant, email ou username.');
            form.querySelector('[name="identifier"]')?.focus();
            return;
        }

        const formData = new FormData(form);
        formData.append('_token', m.dataset.csrf || '');

        const button = form.querySelector('[type="submit"]');

        try {
            button?.classList.add('is-loading');
            if (button) button.disabled = true;

            const response = await fetch(m.dataset.blockUrl, {
                method: 'POST',
                credentials: 'same-origin',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                }
            });

            const data = await response.json().catch(() => ({}));

            if (!response.ok || data.success !== true) {
                throw new Error(data.message || 'Impossible de bloquer cet utilisateur.');
            }

            form.reset();
            await loadStatus();
            notify('success', 'Utilisateur bloqué', data.message || 'La liste de blocage a été mise à jour.');
        } catch (error) {
            showError(error.message || 'Impossible de bloquer cet utilisateur.');
        } finally {
            button?.classList.remove('is-loading');
            if (button) button.disabled = false;
        }
    }

    async function unblockUser(id) {
        const m = modal();
        if (!m || !id) return;

        const formData = new FormData();
        formData.append('_token', m.dataset.csrf || '');

        try {
            const response = await fetch(unblockUrl(id), {
                method: 'POST',
                credentials: 'same-origin',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                }
            });

            const data = await response.json().catch(() => ({}));

            if (!response.ok || data.success !== true) {
                throw new Error(data.message || 'Impossible de débloquer cet utilisateur.');
            }

            await loadStatus();
            notify('success', 'Utilisateur débloqué', data.message || 'L’utilisateur a été retiré de la liste.');
        } catch (error) {
            showError(error.message || 'Impossible de débloquer cet utilisateur.');
        }
    }

    function showError(message) {
        notify('error', 'Action impossible', message);
    }

    function installBridge() {
        previousPanelAction = window.MOLChatPanelAction || previousPanelAction;

        window.MOLChatPanelAction = async function(action, payload = {}) {
            if (action === 'block_setting' || action === 'blockSettings') {
                closeAnyPanelMenu();
                openModal();
                return true;
            }

            if (typeof previousPanelAction === 'function' && previousPanelAction !== window.MOLChatPanelAction) {
                return await previousPanelAction(action, payload);
            }

            return null;
        };
    }

    document.addEventListener('click', async (event) => {
        const directButton = event.target.closest(
            '[data-mol-block-settings-open], ' +
            '[data-action="block_setting"], ' +
            '[data-action="blockSettings"], ' +
            '[data-mol-panel-action="block_setting"], ' +
            '[data-mol-panel-action="blockSettings"]'
        );

        if (directButton) {
            event.preventDefault();
            event.stopPropagation();
            event.stopImmediatePropagation();
            openModal();
            return;
        }

        const closeButton = event.target.closest('[data-mol-block-close]');
        if (closeButton && modal()?.contains(closeButton)) {
            event.preventDefault();
            closeModal();
            return;
        }

        const refreshButton = event.target.closest('[data-mol-block-refresh]');
        if (refreshButton && modal()?.contains(refreshButton)) {
            event.preventDefault();
            await loadStatus();
            return;
        }

        const saveButton = event.target.closest('[data-mol-block-save]');
        if (saveButton && modal()?.contains(saveButton)) {
            event.preventDefault();
            await saveSettings();
            return;
        }

        const unblockButton = event.target.closest('[data-mol-unblock]');
        if (unblockButton && modal()?.contains(unblockButton)) {
            event.preventDefault();
            await unblockUser(unblockButton.dataset.molUnblock);
        }
    }, true);

    document.addEventListener('submit', async (event) => {
        const form = event.target.closest('[data-mol-block-add-form]');

        if (!form || !modal()?.contains(form)) return;

        event.preventDefault();
        await blockUser(form);
    });

    document.addEventListener('input', (event) => {
        const search = event.target.closest('[data-mol-block-search]');
        if (!search || !modal()?.contains(search)) return;

        const list = document.getElementById('molBlockedUsersList');
        const raw = list?.dataset?.rawItems || '[]';

        try {
            renderBlockedUsers(JSON.parse(raw));
        } catch (_) {
            renderBlockedUsers([]);
        }
    });

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && modal() && !modal().hidden) {
            closeModal();
        }
    });

    document.addEventListener('turbo:before-cache', () => {
        closeModal();
        cleanupBootstrapBackdrops();
    });

    document.addEventListener('DOMContentLoaded', installBridge);
    document.addEventListener('turbo:load', installBridge);

    if (document.readyState !== 'loading') {
        installBridge();
    }

    window.MolBlockSettings = {
        open: openModal,
        close: closeModal,
        reload: loadStatus,
        cleanup: cleanupBootstrapBackdrops
    };
})();
</script>