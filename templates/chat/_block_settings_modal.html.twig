{# templates/chat/_block_settings_modal.html.twig #}
{#
    Modale propre de réglages de blocage.

    Important : cette version n'utilise PAS la modale Bootstrap.
    Elle évite donc le bug de page grisée avec un backdrop Bootstrap bloqué.

    Bouton menu compatible :
    <button type="button" class="mol-panel-menu__item" data-mol-panel-action="block_setting" data-mol-block-settings-open>
        <i class="bi bi-slash-circle"></i>
        <span>Réglages de blocage</span>
    </button>
#}

<div
    id="molBlockSettingsModal"
    class="mol-block-modal"
    hidden
    aria-hidden="true"
    data-status-url="{{ path('app_chat_block_settings_status') }}"
    data-save-url="{{ path('app_chat_block_settings_save') }}"
    data-block-url="{{ path('app_chat_block_settings_block_user') }}"
    data-unblock-url-template="{{ path('app_chat_block_settings_unblock_user', { id: 0 }) }}"
    data-csrf="{{ csrf_token('chat_block_settings') }}"
>
    <div class="mol-block-modal__backdrop" data-mol-block-close></div>

    <section
        class="mol-block-modal__dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="molBlockSettingsTitle"
    >
        <header class="mol-block-modal__header">
            <div>
                <div class="mol-block-modal__badge">
                    <i class="bi bi-shield-lock"></i>
                    <span>{% trans %}Sécurité du chat{% endtrans %}</span>
                </div>

                <h2 id="molBlockSettingsTitle" class="mol-block-modal__title">
                    {% trans %}Réglages de blocage{% endtrans %}
                </h2>

                <p class="mol-block-modal__subtitle">
                    {% trans %}Contrôlez qui peut vous contacter, ce qui peut être envoyé, et les utilisateurs bloqués.{% endtrans %}
                </p>
            </div>

            <button
                type="button"
                class="mol-block-modal__close"
                data-mol-block-close
                aria-label="{{ 'Fermer'|trans }}"
            >
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        <div class="mol-block-layout">
            <div class="mol-block-panel">
                <h3>{% trans %}Protection automatique{% endtrans %}</h3>

                <label class="mol-block-switch">
                    <input type="checkbox" data-block-setting="blockUnknownUsers">
                    <span></span>
                    <div>
                        <strong>{% trans %}Bloquer les utilisateurs inconnus{% endtrans %}</strong>
                        <small>{% trans %}Empêche les nouveaux contacts non autorisés d’ouvrir une conversation.{% endtrans %}</small>
                    </div>
                </label>

                <label class="mol-block-switch">
                    <input type="checkbox" data-block-setting="blockCalls">
                    <span></span>
                    <div>
                        <strong>{% trans %}Bloquer les appels{% endtrans %}</strong>
                        <small>{% trans %}Désactive les appels audio et vidéo entrants.{% endtrans %}</small>
                    </div>
                </label>

                <label class="mol-block-switch">
                    <input type="checkbox" data-block-setting="blockFiles">
                    <span></span>
                    <div>
                        <strong>{% trans %}Bloquer les fichiers{% endtrans %}</strong>
                        <small>{% trans %}Empêche la réception des pièces jointes.{% endtrans %}</small>
                    </div>
                </label>

                <label class="mol-block-switch">
                    <input type="checkbox" data-block-setting="blockLinks">
                    <span></span>
                    <div>
                        <strong>{% trans %}Bloquer les liens{% endtrans %}</strong>
                        <small>{% trans %}Filtre les messages contenant des liens externes.{% endtrans %}</small>
                    </div>
                </label>

                <label class="mol-block-switch">
                    <input type="checkbox" data-block-setting="profanityFilter">
                    <span></span>
                    <div>
                        <strong>{% trans %}Filtre anti-insultes{% endtrans %}</strong>
                        <small>{% trans %}Filtre automatiquement les contenus agressifs ou abusifs.{% endtrans %}</small>
                    </div>
                </label>

                <label class="mol-block-switch">
                    <input type="checkbox" data-block-setting="hideBlockedConversations">
                    <span></span>
                    <div>
                        <strong>{% trans %}Masquer les conversations bloquées{% endtrans %}</strong>
                        <small>{% trans %}Les conversations bloquées ne remontent plus dans la liste.{% endtrans %}</small>
                    </div>
                </label>
            </div>

            <div class="mol-block-panel">
                <div class="mol-block-panel__top">
                    <h3>{% trans %}Utilisateurs bloqués{% endtrans %}</h3>

                    <button type="button" class="mol-block-refresh" data-mol-block-refresh>
                        <i class="bi bi-arrow-clockwise"></i>
                        <span>{% trans %}Actualiser{% endtrans %}</span>
                    </button>
                </div>

                <form class="mol-block-add" data-mol-block-add-form autocomplete="off">
                    <div class="mol-block-field">
                        <label>{% trans %}Identifiant, email ou username{% endtrans %}</label>
                        <input type="text" name="identifier" placeholder="exemple@email.com" required>
                    </div>

                    <div class="mol-block-field">
                        <label>{% trans %}Nom affiché{% endtrans %}</label>
                        <input type="text" name="label" placeholder="{{ 'Nom visible dans la liste'|trans }}">
                    </div>

                    <div class="mol-block-field">
                        <label>{% trans %}Raison{% endtrans %}</label>
                        <input type="text" name="reason" placeholder="{{ 'Spam, harcèlement, contenu indésirable...'|trans }}">
                    </div>

                    <button type="submit" class="mol-block-btn mol-block-btn--dark">
                        <i class="bi bi-person-slash"></i>
                        <span>{% trans %}Bloquer{% endtrans %}</span>
                    </button>
                </form>

                <div class="mol-block-search">
                    <i class="bi bi-search"></i>
                    <input type="search" data-mol-block-search placeholder="{{ 'Rechercher un utilisateur bloqué...'|trans }}">
                </div>

                <div class="mol-blocked-list" id="molBlockedUsersList">
                    <div class="mol-block-empty">
                        {% trans %}Aucun utilisateur bloqué.{% endtrans %}
                    </div>
                </div>
            </div>
        </div>

        <footer class="mol-block-modal__footer">
            <button type="button" class="mol-block-btn mol-block-btn--ghost" data-mol-block-close>
                {% trans %}Annuler{% endtrans %}
            </button>

            <button type="button" class="mol-block-btn mol-block-btn--primary" data-mol-block-save>
                <i class="bi bi-check2-circle"></i>
                <span>{% trans %}Enregistrer les réglages{% endtrans %}</span>
            </button>
        </footer>
    </section>
</div>

<style id="mol-block-settings-modal-style">
