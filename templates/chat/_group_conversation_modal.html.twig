<div id="molGroupRoomModal" class="mol-group-room" hidden>
    <div class="mol-group-room__backdrop" data-group-room-close></div>

    <section class="mol-group-room__shell">
        <aside class="mol-group-room__groups">
            <div class="mol-group-room__groups-head">
                <div>
                    <strong>Groupes</strong>
                    <span>Navigation rapide</span>
                </div>
                <button type="button" data-group-list-refresh>
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>

            <div id="molGroupRoomGroupsList" class="mol-group-room__groups-list">
                <div class="mol-group-room__empty">Chargement...</div>
            </div>
        </aside>
        <aside class="mol-group-room__sidebar">
            <div class="mol-group-room__brand">
                <div class="mol-group-room__avatar">
                    <i class="bi bi-people-fill"></i>
                </div>

                <div>
                    <div class="mol-group-room__eyebrow">Groupe actif</div>
                    <h2 id="molGroupRoomName">Groupe</h2>
                    <p id="molGroupRoomDescription">Chargement...</p>
                </div>
            </div>

            <div class="mol-group-room__stats">
                <div>
                    <strong id="molGroupRoomMembersCount">0</strong>
                    <span>Membres</span>
                </div>

                <div>
                    <strong id="molGroupRoomVisibility">Privé</strong>
                    <span>Visibilité</span>
                </div>
            </div>

            <div class="mol-group-room__action-card">
                <div class="mol-group-room__action-title">
                    <i class="bi bi-share"></i>
                    Recommander ce groupe
                </div>

                <button type="button" data-open-group-recommend-modal>
                    <i class="bi bi-stars"></i>
                    Choisir parmi mes amis
                </button>

                <small>Choisis un ami dans ta liste. Il devra ensuite demander à intégrer le groupe.</small>
            </div>

            <div class="mol-group-room__side-title">
                <span>Membres</span>
                <button type="button" data-group-room-refresh>
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>

            <div id="molGroupRoomMembers" class="mol-group-room__members">
                <div class="mol-group-room__empty">Chargement des membres...</div>
            </div>
        </aside>

        <main class="mol-group-room__main">
            <header class="mol-group-room__header">
                <button type="button" class="mol-group-room__mobile-members" data-group-room-toggle-members>
                    <i class="bi bi-people"></i>
                </button>

                <div class="mol-group-room__header-main">
                    <div class="mol-group-room__title-row">
                        <h3 id="molGroupRoomHeaderName">Conversation groupe</h3>
                        <span id="molGroupRoomOwnerBadge">Créateur</span>
                    </div>
                    <div id="molGroupRoomHeaderMeta" class="mol-group-room__meta">Messages, fichiers, images, vocaux, PDF, Word</div>
                </div>

                <button type="button" class="mol-group-room__call-btn" data-group-call-start title="Appel de groupe">
                    <i class="bi bi-camera-video-fill"></i>
                </button>

                <button type="button" class="mol-group-room__close" data-group-room-close>
                    <i class="bi bi-x-lg"></i>
                </button>
            </header>

            <div id="molGroupRoomMessages" class="mol-group-room__messages">
                <div class="mol-group-room__empty">Chargement des messages...</div>
            </div>

            <footer class="mol-group-room__composer">
                <input id="molGroupRoomFile" type="file" hidden
                    accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.zip,.rar,.txt,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document">

                <input id="molGroupRoomImage" type="file" hidden
                    accept="video/*"
                    capture="environment">

                <input id="molGroupRoomAudio" type="file" hidden
                    accept="audio/*"
                    capture>

                <div id="molGroupReplyPreview" class="mol-group-reply-preview" hidden>
                    <div>
                        <strong id="molGroupReplyAuthor">Réponse</strong>
                        <span id="molGroupReplyText">Message sélectionné</span>
                    </div>
                    <button type="button" data-cancel-group-reply>
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <button type="button" class="mol-group-room__tool" title="Fichier" data-group-room-file>
                    <i class="bi bi-paperclip"></i>
                </button>

                <button type="button" class="mol-group-room__tool" title="Filmer avec la caméra" data-group-room-camera>
                    <i class="bi bi-camera-video"></i>
                </button>

                <button type="button" class="mol-group-room__tool" title="Enregistrer un audio" data-group-room-microphone>
                    <i class="bi bi-mic-fill"></i>
                </button>

                <button type="button" class="mol-group-room__tool" title="Emoji" data-group-room-emoji>
                    <i class="bi bi-emoji-smile"></i>
                </button>

                <textarea id="molGroupRoomInput" rows="1" placeholder="Écrire dans le groupe..."></textarea>

                <button type="button" class="mol-group-room__send" data-group-room-send>
                    <i class="bi bi-send-fill"></i>
                </button>

                <emoji-picker
                    id="molGroupEmojiPicker"
                    class="mol-group-emoji-picker"
                    hidden
                ></emoji-picker>

                <emoji-picker
                    id="molGroupReactionPicker"
                    class="mol-group-reaction-picker"
                    hidden
                ></emoji-picker>
            </footer>
        </main>
    </section>
</div>

<div id="molGroupRecorderModal" class="mol-group-recorder" hidden>
    <div class="mol-group-recorder__backdrop" data-group-recorder-cancel></div>

    <section class="mol-group-recorder__box">
        <header>
            <div>
                <span id="molGroupRecorderBadge">Enregistrement</span>
                <h3 id="molGroupRecorderTitle">Caméra</h3>
                <p id="molGroupRecorderHint">Préparation...</p>
            </div>

            <button type="button" data-group-recorder-cancel>
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        <video id="molGroupRecorderVideo" autoplay muted playsinline hidden></video>

        <div id="molGroupRecorderAudioView" class="mol-group-recorder__audio" hidden>
            <i class="bi bi-mic-fill"></i>
            <strong>Micro actif</strong>
            <span id="molGroupRecorderTimer">00:00</span>
        </div>

        <footer>
            <button type="button" class="mol-group-recorder__secondary" data-group-recorder-cancel>
                Annuler
            </button>

            <button type="button" class="mol-group-recorder__danger" data-group-recorder-stop>
                <i class="bi bi-stop-fill"></i>
                Terminer et envoyer
            </button>
        </footer>
    </section>
</div>

<div id="molGroupCallModal" class="mol-group-call" hidden>
    <div class="mol-group-call__backdrop"></div>

    <section class="mol-group-call__box">
        <header>
            <div>
                <span>Appel de groupe</span>
                <h3 id="molGroupCallTitle">Appel en cours</h3>
                <p id="molGroupCallStatus">Caméra et micro prêts.</p>
            </div>

            <button type="button" data-group-call-end>
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        <div class="mol-group-call__stage">
            <video id="molGroupCallLocalVideo" autoplay muted playsinline></video>

            <div id="molGroupCallCameraOff" class="mol-group-call__camera-off" hidden>
                <i class="bi bi-camera-video-off-fill"></i>
                <span>Caméra désactivée</span>
            </div>

            <div class="mol-group-call__waiting">
                <i class="bi bi-people-fill"></i>
                <span>Appel groupe démarré</span>
            </div>
        </div>

        <footer>
            <button type="button" data-group-call-toggle-mic title="Activer/Désactiver micro">
                <i class="bi bi-mic-fill"></i>
            </button>

            <button type="button" data-group-call-toggle-camera title="Activer/Désactiver caméra">
                <i class="bi bi-camera-video-fill"></i>
            </button>

            <button type="button" class="is-danger" data-group-call-end title="Raccrocher">
                <i class="bi bi-telephone-x-fill"></i>
            </button>
        </footer>
    </section>
</div>

<div id="molGroupRecommendModal" class="mol-group-recommend-modal" hidden>
    <div class="mol-group-recommend-modal__backdrop" data-close-group-recommend></div>

    <section class="mol-group-recommend-modal__dialog">
        <header class="mol-group-recommend-modal__header">
            <div>
                <div class="mol-group-recommend-modal__badge">
                    <i class="bi bi-stars"></i>
                    Recommandation
                </div>

                <h3>Recommander le groupe</h3>
                <p>Choisis un ami à qui recommander ce groupe.</p>
            </div>

            <button type="button" data-close-group-recommend>
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        <div class="mol-group-recommend-modal__note">
            <label>Message optionnel</label>
            <input id="molGroupRecommendNote" type="text" placeholder="Ex : Ce groupe peut t’intéresser...">
        </div>

        <div id="molGroupRecommendFriendsList" class="mol-group-recommend-friends">
            <div class="mol-group-room__empty">Chargement de vos amis...</div>
        </div>
    </section>
</div>

<style>
    .mol-group-room[hidden] {
        display: none !important;
    }

    .mol-group-room {
        position: fixed;
        inset: 0;
        z-index: 2147483647;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 18px;
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .mol-group-room__backdrop {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at top right, rgba(37,99,235,.30), transparent 34%),
            radial-gradient(circle at bottom left, rgba(14,165,233,.18), transparent 34%),
            rgba(15,23,42,.70);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
    }

    .mol-group-room__shell {
        position: relative;
        width: min(1180px, 100%);
        height: min(820px, calc(100vh - 32px));
        display: grid;
        grid-template-columns: 330px minmax(0, 1fr);
        overflow: hidden;
        border-radius: 32px;
        background: rgba(255,255,255,.98);
        border: 1px solid rgba(226,232,240,.95);
        box-shadow: 0 34px 110px rgba(15,23,42,.36);
        opacity: 0;
        transform: translateY(18px) scale(.975);
        transition: .22s ease;
    }

    .mol-group-room.is-open .mol-group-room__shell {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    .mol-group-room__sidebar {
        display: flex;
        flex-direction: column;
        min-height: 0;
        padding: 22px;
        background:
            linear-gradient(180deg, #f8fafc, #ffffff);
        border-right: 1px solid rgba(148,163,184,.18);
    }

    .mol-group-room__brand {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        margin-bottom: 18px;
    }

    .mol-group-room__avatar {
        width: 58px;
        height: 58px;
        min-width: 58px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #2563eb, #38bdf8);
        color: #fff;
        font-size: 24px;
        box-shadow: 0 18px 34px rgba(37,99,235,.26);
    }

    .mol-group-room__eyebrow {
        color: #2563eb;
        font-size: 11px;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 5px;
    }

    .mol-group-room h2,
    .mol-group-room h3 {
        margin: 0;
        color: #0f172a;
        font-weight: 950;
        letter-spacing: -.03em;
    }

    .mol-group-room h2 {
        font-size: 20px;
        line-height: 1.1;
    }

    .mol-group-room h3 {
        font-size: 17px;
    }

    .mol-group-room p,
    .mol-group-room__meta {
        color: #64748b;
        font-size: 12px;
        line-height: 1.55;
        margin: 6px 0 0;
    }

    .mol-group-room__stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 18px;
    }

    .mol-group-room__stats div {
        padding: 14px;
        border-radius: 20px;
        background: #fff;
        border: 1px solid rgba(148,163,184,.18);
        box-shadow: 0 12px 28px rgba(15,23,42,.045);
    }

    .mol-group-room__stats strong {
        display: block;
        color: #0f172a;
        font-size: 17px;
        font-weight: 950;
    }

    .mol-group-room__stats span {
        display: block;
        color: #64748b;
        font-size: 11px;
        font-weight: 800;
        margin-top: 3px;
    }

    .mol-group-room__side-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: #334155;
        font-size: 12px;
        font-weight: 950;
        margin-bottom: 10px;
    }

    .mol-group-room__side-title button {
        width: 30px;
        height: 30px;
        border: 0;
        border-radius: 11px;
        background: #eef4ff;
        color: #2563eb;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .mol-group-room__members {
        display: grid;
        gap: 9px;
        overflow: auto;
        padding-right: 4px;
        min-height: 0;
    }

    .mol-group-member {
        display: grid;
        grid-template-columns: 38px minmax(0, 1fr) auto;
        align-items: center;
        gap: 10px;
        padding: 10px;
        border-radius: 18px;
        background: #fff;
        border: 1px solid rgba(148,163,184,.16);
    }

    .mol-group-member__avatar {
        width: 38px;
        height: 38px;
        border-radius: 14px;
        background: #eef4ff;
        color: #2563eb;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 950;
        font-size: 13px;
    }

    .mol-group-member__name {
        color: #0f172a;
        font-size: 12px;
        font-weight: 950;
        line-height: 1.2;
    }

    .mol-group-member__role {
        color: #64748b;
        font-size: 11px;
        margin-top: 2px;
    }

    .mol-group-member__remove {
        width: 32px;
        height: 32px;
        border: 0;
        border-radius: 12px;
        background: #fee2e2;
        color: #b91c1c;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .mol-group-room__main {
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 0;
        background:
            radial-gradient(circle at top right, rgba(37,99,235,.06), transparent 28%),
            #ffffff;
    }

    .mol-group-room__header {
        height: 74px;
        min-height: 74px;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 18px;
        border-bottom: 1px solid rgba(148,163,184,.18);
        background: rgba(255,255,255,.92);
        backdrop-filter: blur(10px);
    }

    .mol-group-room__header-main {
        min-width: 0;
        flex: 1;
    }

    .mol-group-room__title-row {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    #molGroupRoomOwnerBadge {
        display: inline-flex;
        align-items: center;
        height: 22px;
        padding: 0 9px;
        border-radius: 999px;
        background: #eef4ff;
        color: #2563eb;
        font-size: 11px;
        font-weight: 900;
    }

    .mol-group-room__close,
    .mol-group-room__mobile-members {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border: 0;
        border-radius: 15px;
        background: #f8fafc;
        color: #0f172a;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: inset 0 0 0 1px rgba(148,163,184,.22);
    }

    .mol-group-room__mobile-members {
        display: none;
    }

    .mol-group-room__messages {
        flex: 1;
        min-height: 0;
        overflow: auto;
        padding: 18px;
        background: rgba(248,250,252,.65);
    }

    .mol-group-msg {
        display: flex;
        align-items: flex-end;
        gap: 8px;
        margin-bottom: 12px;
    }

    .mol-group-msg.is-mine {
        justify-content: flex-end;
    }

    .mol-group-msg__bubble {
        width: fit-content;
        max-width: min(560px, 78%);
        border-radius: 22px;
        padding: 11px 13px;
        background: #fff;
        border: 1px solid rgba(148,163,184,.18);
        box-shadow: 0 10px 25px rgba(15,23,42,.055);
    }

    .mol-group-msg.is-mine .mol-group-msg__bubble {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: #fff;
        border-color: transparent;
    }

    .mol-group-msg__author {
        font-size: 11px;
        font-weight: 950;
        color: #2563eb;
        margin-bottom: 4px;
    }

    .mol-group-msg.is-mine .mol-group-msg__author {
        color: rgba(255,255,255,.86);
    }

    .mol-group-msg__content {
        font-size: 13px;
        line-height: 1.55;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .mol-group-msg__meta {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 6px;
        font-size: 10px;
        color: #94a3b8;
    }

    .mol-group-msg.is-mine .mol-group-msg__meta {
        color: rgba(255,255,255,.72);
    }

    .mol-group-msg__delete {
        border: 0;
        background: transparent;
        color: inherit;
        opacity: .75;
        cursor: pointer;
        padding: 0;
    }

    .mol-group-file {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 220px;
        padding: 10px;
        border-radius: 16px;
        background: rgba(15,23,42,.04);
        text-decoration: none;
        color: inherit;
    }

    .mol-group-msg.is-mine .mol-group-file {
        background: rgba(255,255,255,.16);
    }

    .mol-group-file i {
        font-size: 24px;
    }

    .mol-group-file strong {
        display: block;
        font-size: 12px;
