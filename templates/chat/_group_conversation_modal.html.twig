        box-shadow: 0 12px 22px rgba(37,99,235,.22);
    }

    .mol-group-room__empty {
        padding: 20px;
        text-align: center;
        border-radius: 18px;
        color: #64748b;
        background: #f8fafc;
        border: 1px dashed rgba(148,163,184,.34);
        font-size: 12px;
        font-weight: 750;
    }

    @media (max-width: 860px) {
        .mol-group-room {
            padding: 0;
        }

        .mol-group-room__shell {
            width: 100%;
            height: 100%;
            border-radius: 0;
            grid-template-columns: 1fr;
        }

        .mol-group-room__sidebar {
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 4;
            width: min(330px, 88vw);
            transform: translateX(-105%);
            transition: .22s ease;
            box-shadow: 24px 0 60px rgba(15,23,42,.20);
        }

        .mol-group-room.members-open .mol-group-room__sidebar {
            transform: translateX(0);
        }

        .mol-group-room__mobile-members {
            display: inline-flex;
        }

        .mol-group-msg__bubble {
            max-width: 86%;
        }
    }


    .mol-group-room__action-card {
        display: grid;
        gap: 10px;
        padding: 13px;
        margin-bottom: 14px;
        border-radius: 20px;
        background:
            linear-gradient(180deg, #ffffff, #f8fafc);
        border: 1px solid rgba(148, 163, 184, .18);
        box-shadow: 0 12px 26px rgba(15, 23, 42, .045);
    }

    .mol-group-room__action-title {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #0f172a;
        font-size: 12px;
        font-weight: 950;
    }

    .mol-group-room__action-title i {
        color: #2563eb;
    }

    .mol-group-room__action-card form {
        display: grid;
        gap: 8px;
    }

    .mol-group-room__action-card input {
        width: 100%;
        height: 38px;
        border: 1px solid rgba(148, 163, 184, .25);
        border-radius: 13px;
        background: #f8fafc;
        color: #0f172a;
        outline: none;
        padding: 0 11px;
        font-size: 12px;
        font-weight: 650;
    }

    .mol-group-room__action-card input:focus {
        background: #fff;
        border-color: rgba(37, 99, 235, .45);
