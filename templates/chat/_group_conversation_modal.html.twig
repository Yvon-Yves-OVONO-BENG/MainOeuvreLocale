        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .mol-group-room__tool {
        background: #eef4ff;
        color: #2563eb;
    }

    .mol-group-room__send {
        width: 48px;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
