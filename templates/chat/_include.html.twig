{# templates/chat/_include.html.twig #}
{# La messagerie reste masquée tant que le nouveau compte n'a pas terminé le choix de profil. #}
{% if app.user and app.request.attributes.get('_route') != 'profile_type_choice' %}
    <script>
        window.MOL_CHAT = window.MOL_CHAT || {};
        window.MOL_CHAT.baseUrl = "{{ app.request.basePath }}";
    </script>

    {% include 'chat/_bootstrap.html.twig' %}
    {% include 'chat/_panel.html.twig' %}

    {# Message d'accueil indépendant du label du bouton : aucun script du tchat ne peut le masquer. #}
    <div id="molColombeWelcomeMessage" class="mol-colombe-welcome-message" aria-hidden="true" hidden>
        <button
            type="button"
            id="molColombeWelcomeClose"
            class="mol-colombe-welcome-close"
            aria-label="{% trans %}Fermer le message de Colombe{% endtrans %}"
            title="{% trans %}Fermer{% endtrans %}"
        >
            <span aria-hidden="true">&times;</span>
        </button>

        <strong>{% trans %}Bonjour ! Je suis Colombe, votre messagerie instantanée.{% endtrans %}</strong>
        <small>{% trans %}Mon petit bec me dit que le bon contact vous attend peut-être ici dans le tchat 😊{% endtrans %}</small>
    </div>

    {% include 'chat/_message_sounds_modal.html.twig' %}
    {% include 'chat/_block_settings_modal.html.twig' %}
