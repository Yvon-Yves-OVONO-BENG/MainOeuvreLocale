<script id="mol-message-sounds-premium-script">
(() => {
    if (window.__MOL_MESSAGE_SOUNDS_PREMIUM__) return;
    window.__MOL_MESSAGE_SOUNDS_PREMIUM__ = true;

    const SOUND_LABELS = {
        crystal: 'Crystal',
        pop: 'Pop',
        pulse: 'Pulse',
        soft_bell: 'Soft Bell',
        digital_drop: 'Digital Drop',
        silent: 'Silencieux'
    };

    const STORAGE_SOUND = 'mol_message_sound';
    const STORAGE_ENABLED = 'mol_chat_sounds_enabled';

    let audioContext = null;
    let oldPanelAction = window.MOLChatPanelAction || null;

    function qs(selector, root = document) {
        return root.querySelector(selector);
    }

    function qsa(selector, root = document) {
        return Array.from(root.querySelectorAll(selector));
    }

    function modal() {
        return document.getElementById('molMessageSoundsModal');
    }

    function getSelectedSound() {
        const currentModal = modal();
        const checked = currentModal?.querySelector('input[name="mol_message_sound"]:checked');

        return checked?.value || localStorage.getItem(STORAGE_SOUND) || 'crystal';
    }

    function setSelectedSound(sound) {
        const currentModal = modal();
        if (!currentModal) return;

        const safeSound = SOUND_LABELS[sound] ? sound : 'crystal';
        const radio = currentModal.querySelector(`input[name="mol_message_sound"][value="${safeSound}"]`);

        if (radio) {
            radio.checked = true;
        }

        localStorage.setItem(STORAGE_SOUND, safeSound);
        localStorage.setItem(STORAGE_ENABLED, safeSound === 'silent' ? '0' : '1');

        refreshSelectedUi();
    }

    function refreshSelectedUi() {
        const currentModal = modal();
        if (!currentModal) return;

        qsa('[data-sound-card]', currentModal).forEach((card) => {
            const input = card.querySelector('input[type="radio"]');
            card.classList.toggle('is-selected', !!input?.checked);
        });

        const sound = getSelectedSound();
        const label = document.getElementById('molSoundCurrentLabel');

        if (label) {
            label.textContent = SOUND_LABELS[sound] || 'Crystal';
        }

        updateMenuSoundButton(sound);
    }

    function updateMenuSoundButton(sound = null) {
        const selectedSound = sound || localStorage.getItem(STORAGE_SOUND) || 'crystal';
        const enabled = selectedSound !== 'silent' && localStorage.getItem(STORAGE_ENABLED) !== '0';

        qsa('[data-action="message_sounds"], [data-mol-panel-action="sounds"]').forEach((button) => {
            const icon = button.querySelector('i');
            const label = button.querySelector('span');

            if (icon) {
                icon.className = enabled ? 'bi bi-volume-up' : 'bi bi-volume-mute';
            }

            if (label) {
                label.textContent = enabled
                    ? `Sons des messages`
                    : 'Sons désactivés';
            }

            button.dataset.sound = selectedSound;
            button.dataset.enabled = enabled ? '1' : '0';
        });
    }

    async function loadStatus() {
        const currentModal = modal();
        if (!currentModal) return;

        const statusUrl = currentModal.dataset.statusUrl;

        if (!statusUrl) {
            setSelectedSound(localStorage.getItem(STORAGE_SOUND) || 'crystal');
            return;
        }

        try {
            const response = await fetch(statusUrl, {
                method: 'GET',
                credentials: 'same-origin',
                cache: 'no-store',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            const data = await response.json().catch(() => ({}));

            if (!response.ok || data.success !== true) {
                setSelectedSound(localStorage.getItem(STORAGE_SOUND) || 'crystal');
                return;
            }

            const sound = data.enabled === false ? 'silent' : (data.sound || 'crystal');
            setSelectedSound(sound);
        } catch (error) {
            console.error('[MOL MESSAGE SOUNDS] status error', error);
            setSelectedSound(localStorage.getItem(STORAGE_SOUND) || 'crystal');
        }
    }

    function openModal() {
        const currentModal = modal();
        if (!currentModal) return;

        currentModal.hidden = false;

        requestAnimationFrame(() => {
            currentModal.classList.add('is-open');
        });

        loadStatus();
    }

    function closeModal() {
        const currentModal = modal();
        if (!currentModal) return;

        currentModal.classList.remove('is-open');

        setTimeout(() => {
            currentModal.hidden = true;
        }, 180);
    }

    function ensureAudioContext() {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;

        if (!AudioContextClass) {
            return null;
        }

        if (!audioContext) {
            audioContext = new AudioContextClass();
        }

        if (audioContext.state === 'suspended') {
            audioContext.resume().catch(() => {});
        }

        return audioContext;
    }

    function playTone(ctx, frequency, start, duration, type = 'sine', gainValue = 0.045) {
        const oscillator = ctx.createOscillator();
        const gain = ctx.createGain();

        oscillator.type = type;
        oscillator.frequency.setValueAtTime(frequency, start);

        gain.gain.setValueAtTime(0.0001, start);
        gain.gain.linearRampToValueAtTime(gainValue, start + 0.012);
        gain.gain.exponentialRampToValueAtTime(0.0001, start + duration);

        oscillator.connect(gain);
        gain.connect(ctx.destination);

        oscillator.start(start);
        oscillator.stop(start + duration);
    }

    function playSound(sound) {
        if (!sound || sound === 'silent') {
            return;
        }

        const ctx = ensureAudioContext();

        if (!ctx) {
            return;
        }

        const now = ctx.currentTime + 0.025;

        if (sound === 'crystal') {
            playTone(ctx, 1046.5, now, .16, 'sine', .040);
            playTone(ctx, 1318.5, now + .10, .22, 'triangle', .036);
            return;
        }

        if (sound === 'pop') {
            playTone(ctx, 880, now, .10, 'square', .030);
            playTone(ctx, 1174.66, now + .075, .11, 'triangle', .026);
            return;
        }

        if (sound === 'pulse') {
            playTone(ctx, 622.25, now, .09, 'sawtooth', .026);
            playTone(ctx, 739.99, now + .12, .09, 'sawtooth', .026);
            playTone(ctx, 932.33, now + .24, .12, 'triangle', .030);
            return;
        }

        if (sound === 'soft_bell') {
            playTone(ctx, 783.99, now, .20, 'sine', .030);
            playTone(ctx, 987.77, now + .16, .24, 'sine', .026);
            return;
        }

        if (sound === 'digital_drop') {
            playTone(ctx, 1244.51, now, .075, 'square', .026);
            playTone(ctx, 932.33, now + .085, .085, 'triangle', .025);
            playTone(ctx, 698.46, now + .18, .12, 'sine', .026);
        }
    }

    async function saveSound() {
        const currentModal = modal();
        if (!currentModal) return;

        const saveButton = currentModal.querySelector('[data-mol-sound-save]');
        const saveUrl = currentModal.dataset.saveUrl;
        const csrf = currentModal.dataset.csrf;
        const sound = getSelectedSound();
        const enabled = sound !== 'silent';

        if (!saveUrl) {
            setSelectedSound(sound);
            closeModal();
            return;
        }

        const formData = new FormData();
        formData.append('_token', csrf || '');
        formData.append('sound', sound);
        formData.append('enabled', enabled ? '1' : '0');

        try {
            saveButton?.classList.add('is-loading');
            if (saveButton) saveButton.disabled = true;

            const response = await fetch(saveUrl, {
                method: 'POST',
                credentials: 'same-origin',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            const data = await response.json().catch(() => ({}));

            if (!response.ok || data.success !== true) {
                throw new Error(data.message || 'Impossible d’enregistrer le son.');
            }

            const savedSound = data.enabled === false ? 'silent' : (data.sound || sound);

            setSelectedSound(savedSound);
            updateMenuSoundButton(savedSound);

            if (window.Swal) {
                Swal.fire({
                    icon: 'success',
                    title: 'Son enregistré',
                    text: data.message || 'Le son des messages a été mis à jour.',
                    timer: 1500,
                    showConfirmButton: false,
                    confirmButtonColor: '#2563eb'
                });
            }

            closeModal();
        } catch (error) {
            console.error('[MOL MESSAGE SOUNDS] save error', error);

            if (window.Swal) {
                Swal.fire({
                    icon: 'error',
                    title: 'Erreur',
                    text: error.message || 'Impossible d’enregistrer le son.',
                    confirmButtonColor: '#2563eb'
                });
            } else {
                alert(error.message || 'Impossible d’enregistrer le son.');
            }
        } finally {
            saveButton?.classList.remove('is-loading');
            if (saveButton) saveButton.disabled = false;
        }
    }

    function closeAnyPanelMenu() {
        document.querySelectorAll('#molChatPanelMenuFinal, #molChatPanelMenu, #molChatPanelMenuRescue').forEach((menu) => {
            menu.classList.remove('is-open', 'show');
            menu.style.removeProperty('left');
            menu.style.removeProperty('top');
        });

        document.querySelectorAll('#molChatPanelOptionsBtnFinal, #molChatPanelOptionsBtn, #molChatPanelOptionsBtnRescue').forEach((button) => {
            button.setAttribute('aria-expanded', 'false');
        });
    }

    function bindUiEvents() {
        document.addEventListener('change', (event) => {
            const input = event.target.closest('input[name="mol_message_sound"]');

            if (!input || !modal()?.contains(input)) {
                return;
            }

            setSelectedSound(input.value);
        });

        document.addEventListener('click', async (event) => {
            const currentModal = modal();

            const closeButton = event.target.closest('[data-mol-sound-close]');
            if (closeButton && currentModal?.contains(closeButton)) {
                event.preventDefault();
                closeModal();
                return;
            }

            const previewButton = event.target.closest('[data-mol-preview-sound]');
            if (previewButton && currentModal?.contains(previewButton)) {
                event.preventDefault();
                event.stopPropagation();

                const sound = previewButton.dataset.molPreviewSound || 'crystal';
                setSelectedSound(sound);
                playSound(sound);
                return;
            }

            const previewCurrent = event.target.closest('[data-mol-preview-current]');
            if (previewCurrent && currentModal?.contains(previewCurrent)) {
                event.preventDefault();
                playSound(getSelectedSound());
                return;
            }

            const saveButton = event.target.closest('[data-mol-sound-save]');
            if (saveButton && currentModal?.contains(saveButton)) {
                event.preventDefault();
                await saveSound();
            }
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && modal() && !modal().hidden) {
                closeModal();
            }
        });
    }

    function installPanelActionBridge() {
        oldPanelAction = window.MOLChatPanelAction || oldPanelAction;

        window.MOLChatPanelAction = async function(action, payload = {}) {
            if (action === 'message_sounds' || action === 'sounds') {
                closeAnyPanelMenu();
                openModal();
                return true;
            }

            if (typeof oldPanelAction === 'function' && oldPanelAction !== window.MOLChatPanelAction) {
                return await oldPanelAction(action, payload);
            }

            return null;
        };
    }

    function boot() {
        bindUiEvents();
        installPanelActionBridge();
        loadStatus();
        updateMenuSoundButton(localStorage.getItem(STORAGE_SOUND) || 'crystal');
    }

    document.addEventListener('DOMContentLoaded', boot);
    document.addEventListener('turbo:load', () => {
        installPanelActionBridge();
        loadStatus();
        updateMenuSoundButton(localStorage.getItem(STORAGE_SOUND) || 'crystal');
    });

    if (document.readyState !== 'loading') {
        boot();
    }

    window.MolMessageSounds = {
        open: openModal,
        close: closeModal,
        play(sound) {
            playSound(sound || getSelectedSound());
        },
        playSelected() {
            const sound = localStorage.getItem(STORAGE_SOUND) || getSelectedSound();

            if (localStorage.getItem(STORAGE_ENABLED) === '0' || sound === 'silent') {
                return;
            }

            playSound(sound);
        },
        getCurrent() {
            return localStorage.getItem(STORAGE_SOUND) || getSelectedSound();
        }
    };
})();
</script>