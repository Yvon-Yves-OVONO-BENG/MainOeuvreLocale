                <div class="mol-sound-card__name">Crystal</div>
                <div class="mol-sound-card__text">Son clair, premium, propre et discret.</div>
                <div class="mol-sound-card__check"></div>
            </label>

            <label class="mol-sound-card" data-sound-card>
