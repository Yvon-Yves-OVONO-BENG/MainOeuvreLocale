    class="mol-sound-modal"
    hidden
    data-status-url="{{ path('app_message_sounds_status') }}"
    data-save-url="{{ path('app_message_sounds_save') }}"
    data-csrf="{{ csrf_token('message_sound_preference') }}"
>
    <div class="mol-sound-modal__backdrop" data-mol-sound-close></div>

    <section class="mol-sound-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="molMessageSoundsTitle">
        <header class="mol-sound-modal__header">
            <div>
                <div class="mol-sound-modal__badge">
                    <i class="bi bi-soundwave"></i>
                    Expérience audio
                </div>

                <h2 id="molMessageSoundsTitle" class="mol-sound-modal__title">
                    Sons des messages
                </h2>

                <p class="mol-sound-modal__subtitle">
                    Choisis le son joué quand un nouveau message arrive. Tu peux préécouter avant d’enregistrer.
                </p>
            </div>

            <button type="button" class="mol-sound-modal__close" data-mol-sound-close aria-label="Fermer">
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        <div class="mol-sound-modal__hero">
            <div class="mol-sound-modal__hero-icon">
                <i class="bi bi-volume-up-fill"></i>
            </div>

            <div>
