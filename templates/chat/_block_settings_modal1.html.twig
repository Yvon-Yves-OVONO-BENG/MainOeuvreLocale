<script>
    (() => {
        if (window.__MOL_BLOCK_SETTINGS_MODAL_READY__) return;
        window.__MOL_BLOCK_SETTINGS_MODAL_READY__ = true;

        const STORAGE_KEY = 'mol_chat_blocked_users_v1';

        const STATE = {
            items: [],
            loading: false,
            search: '',
            initialized: false
        };

        window.MOL_BLOCK_SETTINGS = window.MOL_BLOCK_SETTINGS || {};

        window.MOL_BLOCK_SETTINGS.urls = {
            list: null,
            create: null,
            toggle: null,
            unblock: null,
            delete: null,
            ...(window.MOL_BLOCK_SETTINGS.urls || {})
        };

        window.MOL_BLOCK_SETTINGS.me = {
            identifier: "{{ app.user ? app.user.userIdentifier|e('js') : '' }}",
            label: "{{ app.user ? app.user.userIdentifier|e('js') : '' }}",
            ...(window.MOL_BLOCK_SETTINGS.me || {})
        };

        function qs(id) {
            return document.getElementById(id);
        }

        function escapeHtml(value) {
            return String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }

        function uid() {
            if (window.crypto?.randomUUID) {
                return window.crypto.randomUUID();
            }

            return 'local-' + Date.now() + '-' + Math.random().toString(16).slice(2);
        }

        function nowIso() {
            return new Date().toISOString();
        }

        function getCsrf() {
            return (
                qs('molBlockSettingsModal')?.dataset?.csrf ||
                document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') ||
                window.MOL_CHAT?.csrfToken ||
                window.MOL_CSRF_TOKEN ||
                ''
            );
        }

        function molUrl(template, id) {
            const t = String(template || '');
            const s = encodeURIComponent(String(id || ''));

            if (!t) return '';
            if (t.includes('__ID__')) return t.replace('__ID__', s);
            if (t.includes('/0/')) return t.replace('/0/', '/' + s + '/');
            if (t.endsWith('/0')) return t.slice(0, -2) + '/' + s;
            return t;
        }

        async function fetchJson(url, options = {}) {
            const headers = {
                'X-Requested-With': 'XMLHttpRequest',
                ...(options.headers || {})
            };

            const csrf = getCsrf();

            if (csrf) {
                headers['X-CSRF-TOKEN'] = csrf;
            }

            const res = await fetch(url, {
                credentials: 'same-origin',
                cache: 'no-store',
                ...options,
                headers
            });

            const raw = await res.text();
            let data = {};

            try {
                data = raw ? JSON.parse(raw) : {};
            } catch (_) {
                data = {};
            }

            if (!res.ok || data.ok === false) {
                throw new Error(data.message || data.error || 'HTTP ' + res.status);
            }

            return data;
        }

        function normalizeItem(item) {
            const identifier =
                item.identifier ||
                item.blockedIdentifier ||
                item.blocked_identifier ||
                item.email ||
                item.username ||
                '';

            const label =
                item.label ||
                item.name ||
                item.fullName ||
                identifier ||
                'Utilisateur bloqué';

            return {
                id: item.id || item.uuid || uid(),
                identifier: String(identifier || '').trim(),
                label: String(label || '').trim(),
                reason: String(item.reason || '').trim(),
                active: item.active !== false && item.isActive !== false,
                createdAt: item.createdAt || item.created_at || nowIso(),
                updatedAt: item.updatedAt || item.updated_at || nowIso()
            };
        }

        function loadLocalItems() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                const parsed = raw ? JSON.parse(raw) : [];
                return Array.isArray(parsed) ? parsed.map(normalizeItem) : [];
            } catch (_) {
                return [];
            }
        }

        function saveLocalItems(items) {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
        }

        async function loadItems() {
            const url = window.MOL_BLOCK_SETTINGS?.urls?.list;

            if (url) {
                const data = await fetchJson(url, {
                    method: 'GET'
                });

                const items = data.items || data.blockedUsers || data.blocked || [];
                STATE.items = Array.isArray(items) ? items.map(normalizeItem) : [];
                return STATE.items;
            }

            STATE.items = loadLocalItems();
            return STATE.items;
        }

        async function createItem(payload) {
            const url = window.MOL_BLOCK_SETTINGS?.urls?.create;

            if (url) {
                const data = await fetchJson(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (data.item) {
                    STATE.items.unshift(normalizeItem(data.item));
                } else {
                    await loadItems();
                }

                return;
            }

            const identifier = String(payload.identifier || '').trim().toLowerCase();

            if (!identifier) {
                throw new Error('Identifiant obligatoire.');
            }

            const exists = STATE.items.some((item) => {
                return item.identifier.toLowerCase() === identifier;
            });

            if (exists) {
                throw new Error('Cet utilisateur est déjà dans votre liste de blocage.');
            }

            const item = normalizeItem({
                id: uid(),
                identifier: payload.identifier,
                label: payload.label || payload.identifier,
                reason: payload.reason || '',
                active: true,
                createdAt: nowIso(),
                updatedAt: nowIso()
            });

            STATE.items.unshift(item);
            saveLocalItems(STATE.items);
        }

        async function toggleItem(id) {
            const item = STATE.items.find((entry) => String(entry.id) === String(id));

            if (!item) return;

            const url = window.MOL_BLOCK_SETTINGS?.urls?.toggle;

            if (url) {
                await fetchJson(molUrl(url, id), {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        active: !item.active
                    })
                });

                await loadItems();
                return;
            }

            item.active = !item.active;
            item.updatedAt = nowIso();
            saveLocalItems(STATE.items);
        }

        async function unblockItem(id) {
            const item = STATE.items.find((entry) => String(entry.id) === String(id));

            if (!item) return;

            const ok = await confirmAction(
                'Débloquer cet utilisateur ?',
                'Il pourra de nouveau vous contacter selon vos règles de messagerie.'
            );

            if (!ok) return;

            const url = window.MOL_BLOCK_SETTINGS?.urls?.unblock || window.MOL_BLOCK_SETTINGS?.urls?.delete;

            if (url) {
                await fetchJson(molUrl(url, id), {
                    method: window.MOL_BLOCK_SETTINGS?.urls?.delete ? 'DELETE' : 'POST'
                });

                await loadItems();
                return;
            }

            STATE.items = STATE.items.filter((entry) => String(entry.id) !== String(id));
            saveLocalItems(STATE.items);
        }

        function notify(type, title, text = '') {
            if (window.Swal) {
                Swal.fire({
                    icon: type || 'info',
                    title: title || '',
                    text: text || '',
                    timer: type === 'success' ? 1700 : undefined,
                    showConfirmButton: type !== 'success',
                    confirmButtonColor: '#2563eb',
                    backdrop: 'rgba(15,23,42,.38)'
                });

                return;
            }

            const old = document.querySelector('.mol-block-toast');

            if (old) old.remove();

            const toast = document.createElement('div');
            toast.className = 'mol-block-toast ' + (type || 'info');
            toast.innerHTML = `
                <i class="bi ${type === 'error' ? 'bi-exclamation-triangle-fill' : 'bi-check-circle-fill'}"></i>
                <div>
                    <strong>${escapeHtml(title || '')}</strong>
                    ${text ? `<span>${escapeHtml(text)}</span>` : ''}
                </div>
            `;

            document.body.appendChild(toast);

            requestAnimationFrame(() => toast.classList.add('is-open'));

            setTimeout(() => {
                toast.classList.remove('is-open');
                setTimeout(() => toast.remove(), 220);
            }, 2600);
        }

        async function confirmAction(title, text = '') {
            if (window.Swal) {
                const result = await Swal.fire({
                    icon: 'question',
                    title,
                    text,
                    showCancelButton: true,
                    confirmButtonText: 'Continuer',
                    cancelButtonText: 'Annuler',
                    confirmButtonColor: '#ef4444',
                    cancelButtonColor: '#64748b',
                    backdrop: 'rgba(15,23,42,.38)'
                });

                return !!result.isConfirmed;
            }

            return window.confirm([title, text].filter(Boolean).join('\n'));
        }

        function closeChatMenus() {
            try {
                window.MOLChatPanelMenu?.close?.();
            } catch (_) {}

            document
                .querySelectorAll('#molChatPanelMenuFinal, #molChatPanelMenu, #molChatPanelMenuRescue, .mol-chat-menu, .mol-panel-menu')
                .forEach((menu) => {
                    menu.classList.remove('is-open', 'show');
                    menu.setAttribute('aria-hidden', 'true');

                    if (menu.id === 'molChatPanelMenuRescue') {
                        menu.style.display = 'none';
                    }
                });

            document
                .querySelectorAll('#molChatPanelOptionsBtnFinal, #molChatPanelOptionsBtn, #molChatPanelOptionsBtnRescue, [aria-expanded="true"]')
                .forEach((button) => {
                    button.setAttribute('aria-expanded', 'false');
                });
        }

        function ensureFallbackBackdrop() {
            let backdrop = qs('molBlockSettingsBackdrop');

            if (!backdrop) {
                backdrop = document.createElement('div');
                backdrop.id = 'molBlockSettingsBackdrop';
                backdrop.className = 'modal-backdrop fade show';
                backdrop.style.zIndex = '2147483646';
                document.body.appendChild(backdrop);

                backdrop.addEventListener('click', closeModal);
            }

            return backdrop;
        }

        function removeFallbackBackdrop() {
            qs('molBlockSettingsBackdrop')?.remove();
        }

        async function openModal() {
            const modal = qs('molBlockSettingsModal');

            if (!modal) {
                console.warn('[MOL] Modale de blocage introuvable : #molBlockSettingsModal');
                return;
            }

            closeChatMenus();

            if (window.bootstrap?.Modal) {
                window.bootstrap.Modal.getOrCreateInstance(modal).show();
            } else {
                ensureFallbackBackdrop();
                modal.classList.add('show');
                modal.style.display = 'block';
                modal.removeAttribute('aria-hidden');
                document.body.classList.add('modal-open');
            }

            await refresh();
            setTimeout(() => qs('molBlockIdentifier')?.focus(), 160);
        }

        function closeModal() {
            const modal = qs('molBlockSettingsModal');

            if (!modal) return;

            if (window.bootstrap?.Modal) {
                window.bootstrap.Modal.getOrCreateInstance(modal).hide();
                return;
            }

            modal.classList.remove('show');
            modal.style.display = 'none';
            modal.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('modal-open');
            removeFallbackBackdrop();
        }

        function getFilteredItems() {
            const q = String(STATE.search || '').trim().toLowerCase();

            if (!q) {
                return STATE.items;
            }

            return STATE.items.filter((item) => {
                return [
                    item.identifier,
                    item.label,
                    item.reason,
                    item.active ? 'actif active blocked bloqué bloque' : 'inactive désactivé desactive'
                ].join(' ').toLowerCase().includes(q);
            });
        }

        function updateStats() {
            const total = STATE.items.length;
            const active = STATE.items.filter((item) => item.active).length;
            const inactive = total - active;

            if (qs('molBlockTotalCount')) qs('molBlockTotalCount').textContent = String(total);
            if (qs('molBlockActiveCount')) qs('molBlockActiveCount').textContent = String(active);
            if (qs('molBlockInactiveCount')) qs('molBlockInactiveCount').textContent = String(inactive);
        }

        function initials(value) {
            const text = String(value || '?').trim();
            const parts = text.split(/\s+/).filter(Boolean);

            if (parts.length >= 2) {
                return (parts[0][0] + parts[1][0]).toUpperCase();
            }

            return text.slice(0, 2).toUpperCase();
        }

        function renderList() {
            const list = qs('molBlockList');

            if (!list) return;

            const items = getFilteredItems();

            updateStats();

            if (!items.length) {
                list.innerHTML = `
                    <div class="mol-block-empty">
                        <div class="mol-block-empty-icon">
                            <i class="bi ${STATE.search ? 'bi-search' : 'bi-shield-check'}"></i>
                        </div>
                        <strong>${STATE.search ? 'Aucun résultat' : 'Aucun utilisateur bloqué'}</strong>
                        <span>${STATE.search ? 'Essayez avec un autre mot-clé.' : 'Les personnes bloquées apparaîtront ici.'}</span>
                    </div>
                `;

                return;
            }

            list.innerHTML = items.map((item) => {
                const safeId = escapeHtml(item.id);
                const statusClass = item.active ? 'active' : 'inactive';
                const statusText = item.active ? 'Bloqué' : 'Désactivé';

                return `
                    <div class="mol-block-item" data-mol-block-item="${safeId}">
                        <div class="mol-block-avatar">
                            ${escapeHtml(initials(item.label || item.identifier))}
                        </div>

                        <div class="mol-block-item-main">
                            <div class="mol-block-item-top">
                                <div class="mol-block-name">${escapeHtml(item.label || item.identifier)}</div>
                                <span class="mol-block-pill ${statusClass}">
                                    <i class="bi ${item.active ? 'bi-slash-circle-fill' : 'bi-pause-circle'}"></i>
                                    ${statusText}
                                </span>
                            </div>

                            <div class="mol-block-identifier">
                                ${escapeHtml(item.identifier)}
                            </div>

                            ${item.reason ? `
                                <div class="mol-block-reason">
                                    ${escapeHtml(item.reason)}
                                </div>
                            ` : ''}
                        </div>

                        <div class="mol-block-actions">
                            <button
                                type="button"
                                class="mol-block-action"
                                title="${item.active ? 'Désactiver le blocage' : 'Réactiver le blocage'}"
                                data-mol-block-toggle="${safeId}"
                            >
                                <i class="bi ${item.active ? 'bi-toggle-on' : 'bi-toggle-off'}"></i>
                            </button>

                            <button
                                type="button"
                                class="mol-block-action danger"
                                title="Débloquer"
                                data-mol-block-unblock="${safeId}"
                            >
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        async function refresh() {
            if (STATE.loading) return;

            STATE.loading = true;

            const refreshBtn = qs('molBlockRefreshBtn');

            if (refreshBtn) {
                refreshBtn.disabled = true;
                refreshBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Actualisation...';
            }

            try {
                await loadItems();
                renderList();
            } catch (error) {
                console.error('[MOL BLOCK SETTINGS]', error);
                notify('error', 'Chargement impossible', error?.message || 'Impossible de charger les utilisateurs bloqués.');
                STATE.items = loadLocalItems();
                renderList();
            } finally {
                STATE.loading = false;

                if (refreshBtn) {
                    refreshBtn.disabled = false;
                    refreshBtn.innerHTML = '<i class="bi bi-arrow-clockwise"></i> Actualiser';
                }
            }
        }

        function setAddLoading(loading) {
            const btn = document.querySelector('.mol-block-add-btn');

            if (!btn) return;

            btn.classList.toggle('is-loading', loading);
            btn.disabled = loading;

            if (loading) {
                btn.dataset.oldHtml = btn.innerHTML;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Blocage...';
            } else if (btn.dataset.oldHtml) {
                btn.innerHTML = btn.dataset.oldHtml;
                delete btn.dataset.oldHtml;
            }
        }

        async function handleAdd(event) {
            event.preventDefault();

            const identifierInput = qs('molBlockIdentifier');
            const labelInput = qs('molBlockLabel');
            const reasonInput = qs('molBlockReason');

            const identifier = String(identifierInput?.value || '').trim();
            const label = String(labelInput?.value || '').trim();
            const reason = String(reasonInput?.value || '').trim();

            if (!identifier) {
                notify('error', 'Identifiant obligatoire', 'Saisissez un email, un identifiant, un pseudo ou un téléphone.');
                identifierInput?.focus();
                return;
            }

            const meIdentifier = String(window.MOL_BLOCK_SETTINGS?.me?.identifier || '').trim().toLowerCase();

            if (meIdentifier && identifier.toLowerCase() === meIdentifier) {
                notify('error', 'Action impossible', 'Vous ne pouvez pas vous bloquer vous-même.');
                return;
            }

            setAddLoading(true);

            try {
                await createItem({
                    identifier,
                    label,
                    reason
                });

                identifierInput.value = '';
                labelInput.value = '';
                reasonInput.value = '';

                renderList();
                notify('success', 'Utilisateur bloqué', 'La personne a été ajoutée à votre liste de blocage.');
            } catch (error) {
                console.error('[MOL BLOCK SETTINGS ADD]', error);
                notify('error', 'Blocage impossible', error?.message || 'Impossible de bloquer cet utilisateur.');
            } finally {
                setAddLoading(false);
            }
        }

        function bindEvents() {
            if (STATE.initialized) return;

            STATE.initialized = true;

            qs('molBlockAddForm')?.addEventListener('submit', handleAdd);

            qs('molBlockRefreshBtn')?.addEventListener('click', refresh);

            qs('molBlockSearch')?.addEventListener('input', (event) => {
                STATE.search = event.target.value || '';
                renderList();
            });

            document.addEventListener('click', async (event) => {
                const closeBtn = event.target.closest('[data-mol-block-close]');

                if (closeBtn) {
                    closeModal();
                    return;
                }

                const toggleBtn = event.target.closest('[data-mol-block-toggle]');

                if (toggleBtn) {
                    event.preventDefault();

                    try {
                        await toggleItem(toggleBtn.dataset.molBlockToggle);
                        renderList();
                        notify('success', 'Blocage mis à jour', 'Le statut de blocage a été modifié.');
                    } catch (error) {
                        console.error('[MOL BLOCK SETTINGS TOGGLE]', error);
                        notify('error', 'Action impossible', error?.message || 'Impossible de modifier ce blocage.');
                    }

                    return;
                }

                const unblockBtn = event.target.closest('[data-mol-block-unblock]');

                if (unblockBtn) {
                    event.preventDefault();

                    try {
                        await unblockItem(unblockBtn.dataset.molBlockUnblock);
                        renderList();
                        notify('success', 'Utilisateur débloqué', 'La personne a été retirée de votre liste de blocage.');
                    } catch (error) {
                        console.error('[MOL BLOCK SETTINGS UNBLOCK]', error);
                        notify('error', 'Déblocage impossible', error?.message || 'Impossible de débloquer cet utilisateur.');
                    }
                }
            });

            /*
             * Capture globale : ouvre cette modale avant les anciens scripts qui faisaient seulement notify().
             */
            window.addEventListener('click', (event) => {
                const trigger = event.target.closest(
                    '[data-mol-block-settings-open], ' +
                    '[data-mol-panel-action="blockSettings"], ' +
                    '[data-mol-panel-action="block_setting"], ' +
                    '[data-action="block_setting"], ' +
                    '[data-action="blockSettings"]'
                );

                if (!trigger) return;

                event.preventDefault();
                event.stopPropagation();
                event.stopImmediatePropagation();

                openModal();
            }, true);

            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && qs('molBlockSettingsModal')?.classList.contains('show')) {
                    closeModal();
                }
            });

            document.addEventListener('turbo:before-cache', closeModal);
        }

        function boot() {
            bindEvents();
            loadItems()
                .then(renderList)
                .catch(() => {
                    STATE.items = loadLocalItems();
                    renderList();
                });
        }

        window.MolBlockSettings = {
            open: openModal,
            close: closeModal,
            refresh,
            getItems: () => STATE.items.slice(),
            add: createItem,
            toggle: toggleItem,
            unblock: unblockItem
        };

        document.addEventListener('DOMContentLoaded', boot);
        document.addEventListener('turbo:load', boot);

        if (document.readyState !== 'loading') {
            boot();
        }
    })();
</script>