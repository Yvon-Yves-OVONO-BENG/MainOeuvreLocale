<div
    class="modal fade mol-block-settings-modal"
    id="molBlockSettingsModal"
    tabindex="-1"
    aria-labelledby="molBlockSettingsModalTitle"
    aria-hidden="true"
    data-csrf="{{ csrf_token('chat_block_settings') }}"
>
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content mol-block-modal-content">
            <div class="mol-block-modal-head">
                <div class="mol-block-title-wrap">
                    <div class="mol-block-title-icon">
                        <i class="bi bi-slash-circle-fill"></i>
                    </div>

                    <div>
                        <h5 class="modal-title" id="molBlockSettingsModalTitle">
                            {% trans %}Réglages de blocage{% endtrans %}
                        </h5>
                        <p>
                            {% trans %}Gérez les personnes bloquées. Les utilisateurs bloqués ne peuvent plus vous envoyer de messages dans le chat.{% endtrans %}
                        </p>
                    </div>
                </div>

                <button
                    type="button"
                    class="mol-block-close"
                    data-bs-dismiss="modal"
                    data-mol-block-close
                    aria-label="{{ 'Fermer'|trans }}"
                >
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="mol-block-modal-body">
                <div class="mol-block-hero">
                    <div class="mol-block-hero-main">
                        <div class="mol-block-hero-icon">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>

                        <div>
                            <strong>{% trans %}Protection de votre messagerie{% endtrans %}</strong>
                            <span>{% trans %}Bloquez un utilisateur par email, identifiant, pseudo ou téléphone selon votre logique serveur.{% endtrans %}</span>
                        </div>
                    </div>

                    <button type="button" class="mol-block-refresh" id="molBlockRefreshBtn">
                        <i class="bi bi-arrow-clockwise"></i>
                        {% trans %}Actualiser{% endtrans %}
                    </button>
                </div>

                <div class="mol-block-stats">
                    <div class="mol-block-stat">
                        <span id="molBlockTotalCount">0</span>
                        <small>{% trans %}Bloqués{% endtrans %}</small>
                    </div>

                    <div class="mol-block-stat">
                        <span id="molBlockActiveCount">0</span>
                        <small>{% trans %}Actifs{% endtrans %}</small>
                    </div>

                    <div class="mol-block-stat">
                        <span id="molBlockInactiveCount">0</span>
                        <small>{% trans %}Désactivés{% endtrans %}</small>
                    </div>
                </div>

                <form id="molBlockAddForm" class="mol-block-form" autocomplete="off">
                    <div class="mol-block-form-grid">
                        <div class="mol-block-field mol-block-field-main">
                            <label for="molBlockIdentifier">
                                {% trans %}Utilisateur à bloquer{% endtrans %}
                            </label>

                            <div class="mol-block-input-wrap">
                                <i class="bi bi-person-x"></i>
                                <input
                                    id="molBlockIdentifier"
                                    type="text"
                                    placeholder="{{ 'Email, identifiant, pseudo ou téléphone'|trans }}"
                                    required
                                >
                            </div>
                        </div>

                        <div class="mol-block-field">
                            <label for="molBlockLabel">
                                {% trans %}Nom affiché{% endtrans %}
                            </label>

                            <div class="mol-block-input-wrap">
                                <i class="bi bi-tag"></i>
                                <input
                                    id="molBlockLabel"
                                    type="text"
                                    placeholder="{{ 'Optionnel'|trans }}"
                                >
                            </div>
                        </div>

                        <div class="mol-block-field mol-block-field-reason">
                            <label for="molBlockReason">
                                {% trans %}Raison{% endtrans %}
                            </label>

                            <div class="mol-block-input-wrap">
                                <i class="bi bi-chat-square-text"></i>
                                <input
                                    id="molBlockReason"
                                    type="text"
                                    placeholder="{{ 'Spam, harcèlement, contenu indésirable...'|trans }}"
                                >
                            </div>
                        </div>

                        <button type="submit" class="mol-block-add-btn">
                            <i class="bi bi-plus-lg"></i>
                            {% trans %}Bloquer{% endtrans %}
                        </button>
                    </div>
                </form>

                <div class="mol-block-search">
                    <i class="bi bi-search"></i>
                    <input
                        id="molBlockSearch"
                        type="search"
                        placeholder="{{ 'Rechercher dans les utilisateurs bloqués...'|trans }}"
                    >
                </div>

                <div id="molBlockList" class="mol-block-list">
                    <div class="mol-block-empty">
                        <div class="mol-block-empty-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <strong>{% trans %}Aucun utilisateur bloqué{% endtrans %}</strong>
                        <span>{% trans %}Les personnes bloquées apparaîtront ici.{% endtrans %}</span>
                    </div>
                </div>
            </div>

            <div class="mol-block-modal-footer">
                <button
                    type="button"
                    class="mol-block-footer-btn mol-block-footer-btn-light"
                    data-bs-dismiss="modal"
                    data-mol-block-close
                >
                    {% trans %}Fermer{% endtrans %}
                </button>
            </div>
        </div>
    </div>
</div>

