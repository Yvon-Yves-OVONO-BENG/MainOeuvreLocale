        color: #0f172a;
        outline: none;
        font-size: 13px;
        font-weight: 600;
        transition: .16s ease;
    }

    .mol-group-field input,
    .mol-group-field select {
        height: 48px;
        padding: 0 14px;
    }

    .mol-group-field textarea {
        min-height: 108px;
        resize: vertical;
        padding: 14px;
    }

    .mol-group-field input:focus,
    .mol-group-field textarea:focus,
    .mol-group-field select:focus {
        border-color: rgba(37, 99, 235, .48);
        background: #fff;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, .08);
    }

    .mol-group-check {
        display: grid;
        grid-template-columns: 44px minmax(0, 1fr);
        gap: 12px;
        align-items: center;
        padding: 13px;
        border-radius: 18px;
        background: #fff;
        border: 1px solid rgba(148, 163, 184, .18);
        cursor: pointer;
    }

    .mol-group-check input {
        display: none;
    }

    .mol-group-check > span {
        width: 42px;
        height: 25px;
        border-radius: 999px;
        background: #cbd5e1;
        position: relative;
        transition: .16s ease;
    }

    .mol-group-check > span::after {
        content: "";
