<div
    id="molGroupChatModal"
    class="mol-group-modal"
    hidden
    aria-hidden="true"
    data-create-url="{{ path('chat_group_create') }}"
    data-mine-url="{{ path('chat_group_mine') }}"
    data-discover-url="{{ path('chat_group_discover') }}"
    data-recommended-url="{{ path('chat_group_recommended_for_me') }}"
    data-join-requests-url="{{ path('chat_group_join_requests') }}"
    data-request-join-url-template="{{ path('chat_group_request_join', { id: 0 }) }}"
    data-approve-url-template="{{ path('chat_group_approve_join_request', { id: 0 }) }}"
    data-reject-url-template="{{ path('chat_group_reject_join_request', { id: 0 }) }}"
    data-detail-url-template="{{ path('chat_group_detail', { id: 0 }) }}"
    data-messages-url-template="{{ path('chat_group_messages', { id: 0 }) }}"
    data-send-url-template="{{ path('chat_group_send', { id: 0 }) }}"
    data-send-file-url-template="{{ path('chat_group_send_file', { id: 0 }) }}"
    data-delete-message-url-template="{{ path('chat_group_delete_message', { id: 0 }) }}"
    data-remove-member-url-template="{{ path('chat_group_remove_member', { id: 0, memberId: 0 }) }}"
    data-invite-url-template="{{ path('chat_group_invite', { id: 0 }) }}"
    data-recommend-url-template="{{ path('chat_group_recommend', { id: 0 }) }}"
    data-recommendable-friends-url-template="{{ path('chat_group_recommendable_friends', { id: 0 }) }}"
    data-toggle-reaction-url-template="{{ path('chat_group_toggle_reaction', { id: 0 }) }}"
    data-presence-url-template="{{ path('chat_group_presence_ping', { id: 0 }) }}"
>
    <div class="mol-group-modal__backdrop" data-group-close></div>

    <section
        class="mol-group-modal__dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="molGroupChatModalTitle"
    >
        <header class="mol-group-modal__header">
            <div>
                <div class="mol-group-modal__badge">
                    <i class="bi bi-people-fill"></i>
                    <span>{% trans %}Groupe premium{% endtrans %}</span>
                </div>

                <h2 id="molGroupChatModalTitle">
                    {% trans %}Créer un groupe{% endtrans %}
                </h2>

                <p>
                    {% trans %}Créez un groupe, invitez des membres, validez les demandes d’intégration et échangez messages, images, vocaux, PDF, Word et fichiers.{% endtrans %}
                </p>
            </div>

            <button
                type="button"
                class="mol-group-modal__close"
                data-group-close
                aria-label="{{ 'Fermer'|trans }}"
            >
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        <nav class="mol-group-tabs" aria-label="{{ 'Navigation des groupes'|trans }}">
            <button type="button" class="mol-group-tab is-active" data-group-tab="mine">
                <i class="bi bi-collection"></i>
                <span>{% trans %}Mes groupes{% endtrans %}</span>
            </button>

            <button type="button" class="mol-group-tab" data-group-tab="discover">
                <i class="bi bi-compass"></i>
                <span>{% trans %}Découvrir{% endtrans %}</span>
            </button>

            <button type="button" class="mol-group-tab" data-group-tab="requests">
                <i class="bi bi-person-check"></i>
                <span>{% trans %}Demandes{% endtrans %}</span>
            </button>

            <button type="button" class="mol-group-tab" data-group-tab="recommended">
                <i class="bi bi-stars"></i>
                <span>{% trans %}Recommandés{% endtrans %}</span>
            </button>

            <button type="button" class="mol-group-tab" data-group-tab="create">
                <i class="bi bi-plus-circle"></i>
                <span>{% trans %}Créer{% endtrans %}</span>
            </button>
        </nav>

        <div class="mol-group-section is-active" data-group-section="mine">
            <div class="mol-group-section-head">
                <h3>{% trans %}Mes groupes{% endtrans %}</h3>
                <button type="button" class="mol-group-refresh" data-group-refresh="mine">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>{% trans %}Actualiser{% endtrans %}</span>
                </button>
            </div>

            <div id="molMyGroupsList" class="mol-group-list">
                <div class="mol-group-empty">{% trans %}Chargement de vos groupes...{% endtrans %}</div>
            </div>
        </div>

        <div class="mol-group-section" data-group-section="discover">
            <div class="mol-group-section-head">
                <h3>{% trans %}Découvrir des groupes{% endtrans %}</h3>
                <button type="button" class="mol-group-refresh" data-group-refresh="discover">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>{% trans %}Actualiser{% endtrans %}</span>
                </button>
            </div>

            <div id="molDiscoverGroupsList" class="mol-group-list">
                <div class="mol-group-empty">{% trans %}Chargement des groupes disponibles...{% endtrans %}</div>
            </div>
        </div>

        <div class="mol-group-section" data-group-section="requests">
            <div class="mol-group-section-head">
                <h3>{% trans %}Demandes d’intégration{% endtrans %}</h3>
                <button type="button" class="mol-group-refresh" data-group-refresh="requests">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>{% trans %}Actualiser{% endtrans %}</span>
                </button>
            </div>

            <div id="molGroupRequestsList" class="mol-group-list">
                <div class="mol-group-empty">{% trans %}Chargement des demandes...{% endtrans %}</div>
            </div>
        </div>

        <div class="mol-group-section" data-group-section="recommended">
            <div class="mol-group-section-head">
                <h3>{% trans %}Groupes recommandés{% endtrans %}</h3>
                <button type="button" class="mol-group-refresh" data-group-refresh="recommended">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>{% trans %}Actualiser{% endtrans %}</span>
                </button>
            </div>

            <div id="molRecommendedGroupsList" class="mol-group-list">
                <div class="mol-group-empty">{% trans %}Chargement des recommandations...{% endtrans %}</div>
            </div>
        </div>

        <div class="mol-group-section" data-group-section="create">
            <form id="molCreateGroupForm" class="mol-group-form" autocomplete="off">
                <div class="mol-group-grid">
                    <div class="mol-group-field mol-group-field--wide">
                        <label>{% trans %}Nom du groupe{% endtrans %}</label>
                        <input type="text" name="name" placeholder="{{ 'Ex : Équipe recrutement Douala'|trans }}" required maxlength="140">
                    </div>

                    <div class="mol-group-field mol-group-field--wide">
                        <label>{% trans %}Description{% endtrans %}</label>
                        <textarea name="description" placeholder="{{ 'Décrivez l’objectif du groupe...'|trans }}"></textarea>
                    </div>

                    <div class="mol-group-field">
                        <label>{% trans %}Visibilité{% endtrans %}</label>
                        <select name="visibility">
                            <option value="private">{% trans %}Privé{% endtrans %}</option>
                            <option value="recommended">{% trans %}Recommandable{% endtrans %}</option>
                            <option value="public">{% trans %}Public avec validation{% endtrans %}</option>
                        </select>
                    </div>

                    <div class="mol-group-field">
                        <label>{% trans %}Inviter des membres{% endtrans %}</label>
                        <input type="text" name="invitees" placeholder="email1@test.com, email2@test.com">
                    </div>

                    <label class="mol-group-check">
                        <input type="checkbox" name="approvalRequired" value="1" checked>
                        <span></span>
                        <div>
                            <strong>{% trans %}Validation obligatoire{% endtrans %}</strong>
                            <small>{% trans %}Les utilisateurs devront être validés avant d’intégrer le groupe.{% endtrans %}</small>
                        </div>
                    </label>

                    <label class="mol-group-check">
                        <input type="checkbox" name="allowFiles" value="1" checked>
                        <span></span>
                        <div>
                            <strong>{% trans %}Autoriser les fichiers{% endtrans %}</strong>
                            <small>{% trans %}Les membres peuvent envoyer des pièces jointes.{% endtrans %}</small>
                        </div>
                    </label>

                    <label class="mol-group-check">
                        <input type="checkbox" name="allowVoice" value="1" checked>
                        <span></span>
                        <div>
                            <strong>{% trans %}Autoriser les vocaux{% endtrans %}</strong>
                            <small>{% trans %}Les membres peuvent envoyer des messages vocaux.{% endtrans %}</small>
                        </div>
                    </label>
                </div>

                <div class="mol-group-premium-row">
                    <div>
                        <strong>{% trans %}Espace groupe SaaS premium{% endtrans %}</strong>
                        <span>{% trans %}Messagerie, fichiers, demandes, recommandations et modération sont centralisés dans une interface propre.{% endtrans %}</span>
                    </div>
                    <i class="bi bi-shield-check"></i>
                </div>

                <footer class="mol-group-modal__footer">
                    <button type="button" class="mol-group-btn mol-group-btn--ghost" data-group-close>
                        {% trans %}Annuler{% endtrans %}
                    </button>

                    <button type="submit" class="mol-group-btn mol-group-btn--primary">
                        <i class="bi bi-plus-circle"></i>
                        <span>{% trans %}Créer le groupe{% endtrans %}</span>
                    </button>
                </footer>
            </form>
        </div>
    </section>
</div>

<style id="mol-group-chat-modal-style">
