    }

    .mol-group-tab.is-active {
        background: #fff;
        color: #2563eb;
        box-shadow: 0 8px 20px rgba(15, 23, 42, .08);
    }

    .mol-group-section {
        display: none;
    }

    .mol-group-section.is-active {
        display: block;
    }

    .mol-group-section-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .mol-group-section-head h3 {
        margin: 0;
        color: #0f172a;
        font-size: 16px;
        font-weight: 950;
    }

    .mol-group-refresh {
        height: 36px;
        border: 0;
        border-radius: 12px;
        padding: 0 12px;
        background: #eef2ff;
        color: #1d4ed8;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        font-weight: 900;
        cursor: pointer;
    }

    .mol-group-form {
        display: grid;
        gap: 18px;
    }

    .mol-group-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .mol-group-field--wide,
