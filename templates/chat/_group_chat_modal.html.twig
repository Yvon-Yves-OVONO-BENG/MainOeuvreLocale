    }

    .mol-group-modal__footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 18px;
        border-top: 1px solid rgba(148, 163, 184, .18);
    }

    .mol-group-btn,
    .mol-group-small-btn {
        border: 0;
        display: inline-flex;
        align-items: center;
