        .mol-group-card {
            grid-template-columns: 44px minmax(0, 1fr);
        }

        .mol-group-card__actions {
            grid-column: 1 / -1;
            justify-content: flex-end;
        }

        .mol-group-card__avatar {
            width: 44px;
            height: 44px;
            border-radius: 15px;
        }

        .mol-group-modal__footer {
            flex-direction: column-reverse;
        }

        .mol-group-btn {
            width: 100%;
        }
    }
</style>

<script id="mol-group-chat-modal-script">
(() => {
    if (window.__MOL_GROUP_CHAT_MODAL_READY__) return;
    window.__MOL_GROUP_CHAT_MODAL_READY__ = true;

    const STATE = {
        activeTab: 'mine',
        loadedTabs: new Set(),
        lastFocused: null
    };

    function modal() {
        return document.getElementById('molGroupChatModal');
    }

    function form() {
        return document.getElementById('molCreateGroupForm');
    }

    function escapeHtml(value) {
        return String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#039;');
    }

    function closeAnyPanelMenu() {
        try {
            window.MOLChatPanelMenu?.close?.();
        } catch (_) {}

        document
            .querySelectorAll('#molChatPanelMenuFinal, #molChatPanelMenu, #molChatPanelMenuRescue, .mol-chat-menu, .mol-panel-menu')
            .forEach((menu) => {
                menu.classList.remove('is-open', 'show');
                menu.setAttribute('aria-hidden', 'true');
                if (menu.id === 'molChatPanelMenuRescue') {
                    menu.style.display = 'none';
                }
            });

        document
            .querySelectorAll('#molChatPanelOptionsBtnFinal, #molChatPanelOptionsBtn, #molChatPanelOptionsBtnRescue, [aria-expanded="true"]')
            .forEach((button) => button.setAttribute('aria-expanded', 'false'));
    }

    function cleanupBootstrapBackdrops() {
        const hasVisibleBootstrapModal = !!document.querySelector('.modal.show');

        if (!hasVisibleBootstrapModal) {
            document.querySelectorAll('.modal-backdrop').forEach((backdrop) => backdrop.remove());
            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('overflow');
            document.body.style.removeProperty('padding-right');
        }
    }

    function notify(type, title, text = '') {
        if (window.Swal) {
            Swal.fire({
                icon: type || 'info',
                title: title || '',
                text: text || '',
                timer: type === 'success' ? 1700 : undefined,
                showConfirmButton: type !== 'success',
                confirmButtonColor: '#2563eb',
                backdrop: 'rgba(15,23,42,.38)'
            });
            return;
        }

        alert([title, text].filter(Boolean).join('\n'));
    }

    function urlFromTemplate(template, id) {
        return String(template || '')
            .replace('/0/', '/' + encodeURIComponent(id) + '/')
            .replace('/0', '/' + encodeURIComponent(id))
            .replace('=0', '=' + encodeURIComponent(id));
    }

    async function fetchJson(url, options = {}) {
        if (!url) {
            throw new Error('URL manquante.');
        }

        const response = await fetch(url, {
            credentials: 'same-origin',
            cache: 'no-store',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json',
                ...(options.headers || {})
            },
            ...options
        });

        const data = await response.json().catch(() => ({}));

        if (!response.ok || data.ok === false) {
            throw new Error(data.message || data.error || 'Erreur serveur.');
        }

        return data;
    }

    function setButtonLoading(button, loading, loadingText = 'Chargement...') {
        if (!button) return;

        if (loading) {
            button.dataset.oldHtml = button.innerHTML;
            button.classList.add('is-loading');
            button.disabled = true;
            button.innerHTML = `<span class="spinner-border spinner-border-sm"></span><span>${escapeHtml(loadingText)}</span>`;
            return;
        }

        button.classList.remove('is-loading');
        button.disabled = false;

        if (button.dataset.oldHtml) {
            button.innerHTML = button.dataset.oldHtml;
            delete button.dataset.oldHtml;
        }
    }

    async function openModal(tab = 'mine') {
        const m = modal();
        if (!m) return;

        cleanupBootstrapBackdrops();
        closeAnyPanelMenu();

        STATE.lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;

        m.hidden = false;
        m.setAttribute('aria-hidden', 'false');
        document.body.classList.add('mol-group-modal-open');

        requestAnimationFrame(() => {
            m.classList.add('is-open');
        });

        await setActiveTab(tab || 'mine');
    }

    function closeModal() {
        const m = modal();
        if (!m) return;

        m.classList.remove('is-open');
        m.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('mol-group-modal-open');

        setTimeout(() => {
            m.hidden = true;
            cleanupBootstrapBackdrops();
            try {
                STATE.lastFocused?.focus?.();
            } catch (_) {}
        }, 180);
    }

    async function setActiveTab(tab) {
        const m = modal();
        if (!m) return;

        STATE.activeTab = tab;

        m.querySelectorAll('[data-group-tab]').forEach((button) => {
            button.classList.toggle('is-active', button.dataset.groupTab === tab);
        });

        m.querySelectorAll('[data-group-section]').forEach((section) => {
            section.classList.toggle('is-active', section.dataset.groupSection === tab);
        });

        if (tab === 'mine') await loadMyGroups();
        if (tab === 'discover') await loadDiscoverGroups();
        if (tab === 'requests') await loadJoinRequests();
        if (tab === 'recommended') await loadRecommendedGroups();
        if (tab === 'create') setTimeout(() => form()?.querySelector('[name="name"]')?.focus(), 120);
    }

    function getGroupLabel(group = {}) {
        return group.name || group.title || 'Groupe';
    }

    function renderGroups(containerId, groups, mode) {
        const container = document.getElementById(containerId);
        if (!container) return;

        if (!groups.length) {
            container.innerHTML = `<div class="mol-group-empty">Aucun groupe à afficher.</div>`;
            return;
        }

        container.innerHTML = groups.map((group) => {
            const id = Number(group.id || 0);
            let actions = '';

            if (mode === 'mine') {
                actions = `
                    <button type="button" class="mol-group-small-btn mol-group-small-btn--primary" data-open-group="${id}">
                        <i class="bi bi-chat-dots"></i>
                        <span>Ouvrir</span>
                    </button>
                `;
            }

            if (mode === 'discover' || mode === 'recommended') {
                actions = group.requestPending
                    ? `
                        <button type="button" class="mol-group-small-btn mol-group-small-btn--ghost" disabled>
                            <i class="bi bi-hourglass-split"></i>
                            <span>En attente</span>
                        </button>
                    `
                    : `
                        <button type="button" class="mol-group-small-btn mol-group-small-btn--dark" data-request-join="${id}">
                            <i class="bi bi-person-plus"></i>
                            <span>Intégrer le groupe</span>
                        </button>
                    `;
            }

            return `
                <article class="mol-group-card">
                    <div class="mol-group-card__avatar">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <div>
                        <div class="mol-group-card__title">${escapeHtml(getGroupLabel(group))}</div>

                        <div class="mol-group-card__meta">
                            ${Number(group.memberCount || group.membersCount || 0)} membre(s) · Créateur : ${escapeHtml(group.ownerName || group.owner || 'Utilisateur')}
                        </div>

                        ${group.description ? `<div class="mol-group-card__desc">${escapeHtml(group.description)}</div>` : ''}
                        ${group.recommendedBy ? `<div class="mol-group-card__desc">Recommandé par ${escapeHtml(group.recommendedBy)}</div>` : ''}
                        ${group.note ? `<div class="mol-group-card__desc">“${escapeHtml(group.note)}”</div>` : ''}
                    </div>

                    <div class="mol-group-card__actions">
                        ${actions}
                    </div>
                </article>
            `;
        }).join('');
    }

    async function loadMyGroups() {
        const m = modal();
        const container = document.getElementById('molMyGroupsList');
        if (!m || !container) return;

        container.innerHTML = `<div class="mol-group-empty">Chargement de vos groupes...</div>`;

        try {
            const data = await fetchJson(m.dataset.mineUrl);
            renderGroups('molMyGroupsList', data.items || data.groups || [], 'mine');
        } catch (error) {
            console.error('[MOL GROUP] mine error', error);
            container.innerHTML = `<div class="mol-group-empty">Impossible de charger vos groupes.</div>`;
        }
    }

    async function loadDiscoverGroups() {
        const m = modal();
        const container = document.getElementById('molDiscoverGroupsList');

        if (!m || !container) return;

        container.innerHTML = `<div class="mol-group-empty">Chargement des groupes disponibles...</div>`;

        try {
            console.log('[MOL GROUP] discover URL =', m.dataset.discoverUrl);

            const data = await fetchJson(m.dataset.discoverUrl);

            console.log('[MOL GROUP] discover response =', data);

            renderGroups('molDiscoverGroupsList', data.items || data.groups || [], 'discover');
        } catch (error) {
            console.error('[MOL GROUP] discover error =', error);

            container.innerHTML = `
                <div class="mol-group-empty">
                    Impossible de charger les groupes.<br>
                    <small>${escapeHtml(error.message || 'Erreur inconnue')}</small>
                </div>
            `;
        }
    }

    async function loadRecommendedGroups() {
        const m = modal();
        const container = document.getElementById('molRecommendedGroupsList');
        if (!m || !container) return;

        container.innerHTML = `<div class="mol-group-empty">Chargement des recommandations...</div>`;

        try {
            const data = await fetchJson(m.dataset.recommendedUrl);
            renderGroups('molRecommendedGroupsList', data.items || data.groups || [], 'recommended');
        } catch (error) {
            console.error('[MOL GROUP] recommended error', error);
            container.innerHTML = `<div class="mol-group-empty">Impossible de charger les recommandations.</div>`;
        }
    }

    async function loadJoinRequests() {
        const m = modal();
        const container = document.getElementById('molGroupRequestsList');
        if (!m || !container) return;

        container.innerHTML = `<div class="mol-group-empty">Chargement des demandes...</div>`;

        try {
            const data = await fetchJson(m.dataset.joinRequestsUrl);
            const items = data.items || data.requests || [];

            if (!items.length) {
                container.innerHTML = `<div class="mol-group-empty">Aucune demande en attente.</div>`;
                return;
            }

            container.innerHTML = items.map((item) => `
                <article class="mol-group-card">
                    <div class="mol-group-card__avatar">
                        <i class="bi bi-person-check"></i>
                    </div>

                    <div>
                        <div class="mol-group-card__title">${escapeHtml(item.requesterName || item.userName || 'Utilisateur')}</div>
                        <div class="mol-group-card__meta">
                            Demande pour : ${escapeHtml(item.groupName || 'Groupe')} · ${escapeHtml(item.createdAt || '')}
                        </div>
                        ${item.message ? `<div class="mol-group-card__desc">${escapeHtml(item.message)}</div>` : ''}
                    </div>

                    <div class="mol-group-card__actions">
                        <button type="button"
                            class="mol-group-small-btn mol-group-small-btn--primary"
                            data-approve-request="${Number(item.id)}">
                        <i class="bi bi-person-check-fill"></i>
                        <span>Accepter</span>
                    </button>

                    <button type="button"
                            class="mol-group-small-btn mol-group-small-btn--danger"
                            data-reject-request="${Number(item.id)}">
                        <i class="bi bi-person-x-fill"></i>
                        <span>Refuser</span>
                    </button>
                    </div>
                </article>
            `).join('');
        } catch (error) {
            console.error('[MOL GROUP] requests error', error);
            container.innerHTML = `<div class="mol-group-empty">Impossible de charger les demandes.</div>`;
        }
    }

    async function createGroup() {
        const m = modal();
        const f = form();
        if (!m || !f) return;

        const submit = f.querySelector('button[type="submit"]');
        const formData = new FormData(f);

        try {
            setButtonLoading(submit, true, 'Création...');

            const data = await fetchJson(m.dataset.createUrl, {
                method: 'POST',
                body: formData
            });

            f.reset();
            notify('success', 'Groupe créé', data.message || 'Le groupe a été créé avec succès.');
            await setActiveTab('mine');
        } catch (error) {
            console.error('[MOL GROUP] create error', error);
            notify('error', 'Action impossible', error.message || 'Impossible de créer le groupe.');
        } finally {
            setButtonLoading(submit, false);
        }
    }

    async function requestJoin(groupId) {
        const m = modal();
        if (!m) return;

        const url = urlFromTemplate(m.dataset.requestJoinUrlTemplate, groupId);

        await fetchJson(url, {
            method: 'POST',
            body: new FormData()
        });

        await Promise.allSettled([loadDiscoverGroups(), loadRecommendedGroups()]);
        notify('success', 'Demande envoyée', 'Le créateur devra valider votre intégration.');
    }

    async function reviewRequest(requestId, type) {
        const m = modal();
        if (!m) return;

        const template = type === 'approve'
            ? m.dataset.approveUrlTemplate
            : m.dataset.rejectUrlTemplate;

        const url = urlFromTemplate(template, requestId);

        await fetchJson(url, {
            method: 'POST',
            body: new FormData()
        });

        await Promise.allSettled([loadJoinRequests(), loadMyGroups()]);
        notify('success', type === 'approve' ? 'Demande acceptée' : 'Demande refusée');
    }

    function installBridge() {
        const previousPanelAction = window.MOLChatPanelAction;

        window.MOLChatPanelAction = async function(action, payload = {}) {
            if (
                action === 'groups' ||
                action === 'create_group_chat' ||
                action === 'createGroup' ||
                action === 'group_chat'
            ) {
                await openModal('discover');
                return true;
            }

            if (typeof previousPanelAction === 'function' && previousPanelAction !== window.MOLChatPanelAction) {
                return await previousPanelAction(action, payload);
            }

            return null;
        };
    }

    document.addEventListener('click', async (event) => {
        const opener = event.target.closest(
            '[data-mol-group-chat-open], ' +
            '[data-mol-create-group-trigger], ' +
            '[data-action="create_group_chat"], ' +
            '[data-action="groups"], ' +
            '[data-mol-panel-action="groups"], ' +
            '[data-mol-panel-action="createGroup"], ' +
            '[data-mol-panel-action="create_group_chat"]'
        );

        if (opener) {
            event.preventDefault();
            event.stopPropagation();
            event.stopImmediatePropagation();
            await openModal('discover');
            return;
        }

        const close = event.target.closest('[data-group-close]');
        if (close && modal()?.contains(close)) {
            event.preventDefault();
            closeModal();
            return;
        }

        const tab = event.target.closest('[data-group-tab]');
        if (tab && modal()?.contains(tab)) {
            event.preventDefault();
            await setActiveTab(tab.dataset.groupTab);
            return;
        }

        const refresh = event.target.closest('[data-group-refresh]');
        if (refresh && modal()?.contains(refresh)) {
            event.preventDefault();
            await setActiveTab(refresh.dataset.groupRefresh || STATE.activeTab);
            return;
        }

        const requestJoinButton = event.target.closest('[data-request-join]');
        if (requestJoinButton && modal()?.contains(requestJoinButton)) {
            event.preventDefault();
            try {
                await requestJoin(requestJoinButton.dataset.requestJoin);
            } catch (error) {
                notify('error', 'Demande impossible', error.message || 'Impossible d’envoyer la demande.');
            }
            return;
        }

        const approveButton = event.target.closest('[data-approve-request]');
        if (approveButton && modal()?.contains(approveButton)) {
            event.preventDefault();
            try {
                await reviewRequest(approveButton.dataset.approveRequest, 'approve');
            } catch (error) {
                notify('error', 'Action impossible', error.message || 'Impossible d’accepter la demande.');
            }
            return;
        }

        const rejectButton = event.target.closest('[data-reject-request]');
        if (rejectButton && modal()?.contains(rejectButton)) {
            event.preventDefault();
            try {
                await reviewRequest(rejectButton.dataset.rejectRequest, 'reject');
            } catch (error) {
                notify('error', 'Action impossible', error.message || 'Impossible de refuser la demande.');
            }
            return;
        }

        const openGroupButton = event.target.closest('[data-open-group]');
        if (openGroupButton && modal()?.contains(openGroupButton)) {
            event.preventDefault();

            if (window.MolGroupConversation?.open) {
                closeModal();
                window.MolGroupConversation.open(openGroupButton.dataset.openGroup);
                return;
            }

            notify('info', 'Groupe sélectionné', 'Branche ici la fenêtre de conversation du groupe.');
        }
    }, true);

    document.addEventListener('submit', async (event) => {
        const f = event.target.closest('#molCreateGroupForm');
        if (!f || !modal()?.contains(f)) return;

        event.preventDefault();
        await createGroup();
    });

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && modal() && !modal().hidden) {
            closeModal();
        }
    });

    document.addEventListener('turbo:before-cache', () => {
        closeModal();
        cleanupBootstrapBackdrops();
    });

    document.addEventListener('DOMContentLoaded', installBridge);
    document.addEventListener('turbo:load', installBridge);

    if (document.readyState !== 'loading') {
        installBridge();
    }

    window.MolGroupChat = {
        open: openModal,
        close: closeModal,
        setTab: setActiveTab,
        reload() {
            if (STATE.activeTab === 'mine') return loadMyGroups();
            if (STATE.activeTab === 'discover') return loadDiscoverGroups();
            if (STATE.activeTab === 'requests') return loadJoinRequests();
            if (STATE.activeTab === 'recommended') return loadRecommendedGroups();
            return Promise.resolve();
        },
        cleanup: cleanupBootstrapBackdrops
    };
})();
</script>
