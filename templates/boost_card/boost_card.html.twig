{% extends 'base.html.twig' %}
{% trans_default_domain 'messages' %}
{% block title %}{% trans %}Paiement par carte{% endtrans %}{% endblock %}

{% block body %}
{% include 'boost_card/_vip_ui.html.twig' %}

<section class="sptb pay-page">
  <div class="container py-4 checkout-wrap">

    <div class="checkout-hero mb-4">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
          <div class="text-uppercase small text-muted">{% trans %}Paiement{% endtrans %}</div>
          <h2 class="checkout-title mb-1">{% trans %}Finaliser votre paiement{% endtrans %}</h2>
          <div class="checkout-soft">
            {% trans %}Paiement par carte via Stripe — rapide, simple et sécurisé.{% endtrans %}
          </div>
          <div class="mt-3">
            <span class="secure-pill">
              <i class="fa fa-shield"></i> {% trans %}Paiement ultra sécurisé (chiffrement SSL){% endtrans %}
            </span>
          </div>
        </div>

        <div class="top-actions d-flex gap-2">
          <a href="{{ path('payment_boost', {plan: plan, montant: montant}) }}"
             class="btn btn-outline-dark px-3">
            <i class="fa fa-arrow-left me-2"></i> {% trans %}Retour{% endtrans %}
          </a>
        </div>
      </div>
    </div>

    <div class="checkout-card">
      <div class="row g-0">

        <div class="col-12 col-lg-7">
          <div class="pay-panel">

            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
              <div class="fw-bold">
                <i class="fa fa-credit-card text-primary me-2"></i> {% trans %}Détails de la carte{% endtrans %}
              </div>
              <div class="small text-muted">
                <i class="fa fa-lock me-1"></i> {% trans %}Données protégées{% endtrans %}
              </div>
            </div>

            <div class="mb-2 field-label">{% trans %}Carte{% endtrans %}</div>
            <div class="stripe-field">
              <div id="card-element"></div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-2">
              <div class="text-muted small">
                {% trans %}Type détecté :{% endtrans %} <span id="card-brand" class="cardbrand">—</span>
              </div>
              <div class="text-muted small">
                <i class="fa fa-check-circle text-success me-1"></i> {% trans %}Vérification automatique{% endtrans %}
              </div>
            </div>

            <div id="card-error" class="text-danger small mt-2"></div>

            <button id="payBtn" class="btn btn-primary pay-btn w-100 mt-3">
              <i class="fa fa-lock me-2"></i> {% trans with {'%amount%': montant|number_format(0, '.', ' ')} %}Payer %amount% XAF{% endtrans %}
            </button>

            <div class="mini-note">
              <i class="fa fa-info-circle me-1"></i>
              {% trans %}Vous serez redirigé automatiquement après confirmation du paiement.{% endtrans %}
            </div>

          </div>
        </div>

        <div class="col-12 col-lg-5">
          <div class="summary">
            <div class="summary-inner">

              <div class="fw-bold mb-2">
                <i class="fa fa-receipt text-primary me-2"></i> {% trans %}Résumé{% endtrans %}
              </div>

              <div class="sum-box">
                <div class="sum-row">
                  <span>{% trans %}Boost profil{% endtrans %}</span>
                  <span class="text-muted">{{ plan }}</span>
                </div>
                <div class="sum-row">
                  <span>{% trans %}Durée{% endtrans %}</span>
                  <span class="text-muted">{% trans %}30 jours{% endtrans %}</span>
                </div>
                <div class="sum-row">
                  <span>{% trans %}Frais{% endtrans %}</span>
                  <span class="text-muted">0 XAF</span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3">
                  <div class="text-muted fw-bold">{% trans %}Total{% endtrans %}</div>
                  <div class="sum-total">{{ montant|number_format(0, '.', ' ') }} XAF</div>
                </div>
              </div>

              <div class="mini-note">
                <i class="fa fa-shield me-1"></i>
                {% trans %}Paiement traité par Stripe. Vos informations bancaires ne sont pas stockées sur Main-d’œuvre locale.{% endtrans %}
              </div>

            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<script src="https://js.stripe.com/v3/"></script>
<script>
    document.addEventListener('DOMContentLoaded', async () => {
        const stripe = Stripe("{{ stripePublicKey }}");
        const elements = stripe.elements();

        const card = elements.create('card', {
          hidePostalCode: true,
          style: {
              base: {
              fontSize: '16px',
              color: '#0f172a',
              '::placeholder': { color: 'rgba(15,23,42,.45)' }
              },
              invalid: { color: '#dc3545' }
          }
        });

        fetch('/boost-stripe-intent', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                plan: 'premium',
                montant: 5000
            })
        })
        .then(response => response.json())
        .then(data => {
            if (!data.ok) {
                alert(data.message);
                return;
            }

            console.log(data.clientSecret);
        });

        card.mount('#card-element');

        const brandEl = document.getElementById('card-brand');
        const errorEl = document.getElementById('card-error');
        const btn = document.getElementById('payBtn');

        card.on('change', (event) => {
        brandEl.textContent = event.brand ? event.brand.toUpperCase() : '—';
        errorEl.textContent = event.error ? event.error.message : '';
        });

        btn.addEventListener('click', async () => {
        btn.disabled = true;
        btn.innerHTML = {{ '<i class="fa fa-spinner fa-spin me-2"></i> Traitement...'|trans|json_encode|raw }};
        errorEl.textContent = '';

        const res = await fetch("{{ path('boost_stripe_intent') }}", {
            method: "POST",
            headers: {
            "Content-Type": "application/json",
            "X-Requested-With": "XMLHttpRequest"
            },
            body: JSON.stringify({
            plan: "{{ plan }}",
            montant: {{ montant }}
            })
        });

        const data = await res.json();
        if (!data.clientSecret) {
            errorEl.textContent = {{ "Impossible d'initialiser le paiement."|trans|json_encode|raw }};
            btn.disabled = false;
            btn.innerHTML = {{ ('<i class="fa fa-lock me-2"></i> ' ~ ('Payer %amount% XAF'|trans({'%amount%': montant|number_format(0, ".", " ")})))|json_encode|raw }};
            return;
        }

        const result = await stripe.confirmCardPayment(data.clientSecret, {
            payment_method: { card }
        });

        if (result.error) {
            errorEl.textContent = result.error.message || {{ 'Paiement échoué.'|trans|json_encode|raw }};
            btn.disabled = false;
            btn.innerHTML = {{ ('<i class="fa fa-lock me-2"></i> ' ~ ('Payer %amount% XAF'|trans({'%amount%': montant|number_format(0, ".", " ")})))|json_encode|raw }};
            return;
        }

        window.location.href = "{{ path('boost_payment_success') }}";
        });
  });
</script>



{% endblock %}