        /* =========================
        FILE UPLOAD
        ========================= */
        async function MOLChatToastSendFile(id, file) {
            if (!file) return;

            try {
                if (!window.MOL_CHAT?.urls?.sendFile) {
                    throw new Error("URL d’envoi de fichier non configurée.");
                }

                const url = molUrl(window.MOL_CHAT.urls.sendFile, id);
                console.log('[send file] final URL =', url);

                const fd = new FormData();
                fd.append('file', file);

                const replyState = typeof MOL_REPLY_STATE !== 'undefined' ? MOL_REPLY_STATE[id] : null;
                if (replyState?.id) {
                    fd.append('replyToId', String(replyState.id));
                }

                const res = await fetch(url, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: fd
                });

                const rawText = await res.text();
                let data = {};

                try {
                    data = rawText ? JSON.parse(rawText) : {};
                } catch (e) {
                    console.error('[send file] réponse non JSON =', rawText);
                    throw new Error('Réponse invalide du serveur.');
                }

                if (!res.ok || data.ok === false) {
                    console.error('[send file] erreur =', {
                        status: res.status,
                        url,
                        response: data
                    });
                    throw new Error(data.error || 'upload_failed');
                }

                if (typeof MOLClearReply === 'function') {
                    MOLClearReply(id);
                }

                if (typeof MOLChatRefreshBubble === 'function') {
                    await MOLChatRefreshBubble(id);
                }

                if (typeof window.MOLChatRefreshList === 'function') {
                    await window.MOLChatRefreshList();
                }

            } catch (e) {
                console.error(e);
                alert(e?.message || "Échec de l'envoi du fichier.");
            }
        }

    </script>

