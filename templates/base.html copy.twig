    <script>
    
        const MOL_TYPING_TIMERS = new Map();
            const MOL_TYPING_STATE = new Map();

            function MOLNotifyTyping(conversationId, typing){
            const url = molUrl(window.MOL_CHAT.urls.typing, conversationId);

            fetch(url, {
                method: 'POST',
                headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ typing })
            }).catch(() => {});
        }

        function MOLHandleTypingInput(conversationId){

            // déjà en train d'écrire → reset timer uniquement
            if(MOL_TYPING_TIMERS.has(conversationId)){
                clearTimeout(MOL_TYPING_TIMERS.get(conversationId));
            }

            // si pas encore déclaré "typing"
            if(!MOL_TYPING_STATE.get(conversationId)){
                MOL_TYPING_STATE.set(conversationId, true);
                MOLNotifyTyping(conversationId, true);
            }

            // stop typing après silence
            const timer = setTimeout(() => {
                MOL_TYPING_STATE.set(conversationId, false);
                MOLNotifyTyping(conversationId, false);
                MOL_TYPING_TIMERS.delete(conversationId);
            }, 900);

            MOL_TYPING_TIMERS.set(conversationId, timer);
        }

    
    </script>

    {# MERCURE  #}
    <script>
    
        function MOLInitMercure(conversationId){

            if(!window.MERCURE_HUB){
                console.warn("Mercure hub non défini");
                return;
            }

            const url = new URL(window.MERCURE_HUB);

            /* ✅ écouter messages */
            url.searchParams.append('topic', `chat/conversation/${conversationId}`);

            /* ✅ écouter typing */
            url.searchParams.append('topic', `chat/conversation/${conversationId}/typing`);

            const es = new EventSource(url);

            es.onmessage = (event) => {
                const data = JSON.parse(event.data);

                console.log("Mercure event:", data);

                /* Typing event */
                if(data.typing !== undefined){
                if(data.typing){
                    MOLShowTyping(data.conversationId);
                }else{
                    MOLHideTyping(data.conversationId);
                }
                return;
                }

                /* Nouveau message */
                if(data.message){
                MOLChatRefreshBubble(data.conversationId);
                MOLOnNewMessage?.(data.conversationId);
                }
            };

            es.onerror = (e) => console.warn("Mercure error", e);

            return es;
        }
    </script>

    {# JS FRIENDSHIP  #}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            loadFriendshipStates();
        });

        function tplUrl(tpl, id) {
            // remplace "/0" par "/{id}" (marche avec routes /xxx/0)
            return String(tpl).replace(/\/0\b/, '/' + id);
        }

        async function ajaxJson(url, options = {}) {
            const res = await fetch(url, {
                ...options,
                headers: {
                'X-Requested-With': 'XMLHttpRequest',
                ...(options.headers || {}),
                },
            });

            // Si Symfony redirige vers login
            if (res.redirected) {
                window.location.href = res.url;
                return null;
            }

            if (!res.ok) {
                const text = await res.text().catch(() => '');
                throw new Error(`HTTP ${res.status} ${text}`);
            }

            // Certains endpoints peuvent renvoyer vide -> on sécurise
            const ct = res.headers.get('content-type') || '';
            if (!ct.includes('application/json')) return {};
            return await res.json();
        }

        async function loadFriendshipStates() {
            const buttons = document.querySelectorAll('.mol-friend-btn');
            if (!buttons.length) return;

            await Promise.all([...buttons].map(btn => loadFriendshipStateForButton(btn)));
        }

        async function loadFriendshipStateForButton(btn) {
            const userId = btn.dataset.user;
            const url = tplUrl(window.MOL_FRIEND.stateUrlTpl, userId);

            try {
                setBtnLoading(btn, true);

                const data = await ajaxJson(url);
                updateFriendButton(btn, data.state || 'none', data.friendshipId || null);

            } catch (e) {
                console.error(e);
                updateFriendButton(btn, 'none', null);
            } finally {
                setBtnLoading(btn, false);
            }
        }

        function setBtnLoading(btn, isLoading) {
            btn.dataset.loading = isLoading ? '1' : '0';
            btn.disabled = isLoading;
            btn.classList.toggle('disabled', isLoading);
        }

        function updateFriendButton(btn, state, friendshipId) {
            btn.classList.remove('btn-primary', 'btn-danger', 'btn-secondary', 'btn-light');
            btn.disabled = false;

            // stocke friendshipId si présent (utile pour accept/reject)
            if (friendshipId) btn.dataset.friendshipId = String(friendshipId);
            else delete btn.dataset.friendshipId;

            const labelEl = btn.querySelector('.label');
            if (!labelEl) return;

            // reset handler
            btn.onclick = null;

            switch (state) {
                case 'none':
                    btn.classList.add('btn-primary');
                    labelEl.innerText = "Demande d’amitié";
                    btn.onclick = () => sendFriendRequest(btn);
                    break;

                case 'pending_sent':
                    btn.classList.add('btn-danger');
                    labelEl.innerText = "Annuler la demande";
                    btn.onclick = () => cancelFriendRequest(btn);
                    break;

                case 'pending_received':
                    btn.classList.add('btn-secondary');
                    labelEl.innerText = "Répondre à la demande";
                    btn.onclick = () => promptAcceptReject(btn);
                    break;

                case 'friends':
                    btn.classList.add('btn-danger');
                    labelEl.innerText = "Bloquer";
                    btn.onclick = () => confirmBlock(btn);
                    break;

                case 'blocked':
                    btn.classList.add('btn-secondary');
                    btn.disabled = true;
                    labelEl.innerText = "Vous ne pouvez pas demander l’amitié";
                    break;

                default:
                    btn.classList.add('btn-primary');
                    labelEl.innerText = "Demande d’amitié";
                    btn.onclick = () => sendFriendRequest(btn);
                    break;
            }

        }

        // =========================================================
        // ACTIONS
        // =========================================================

        async function sendFriendRequest(btn) {
            const userId = btn.dataset.user;
            const url = tplUrl(window.MOL_FRIEND.requestUrlTpl, userId);

            try {
                await ajaxJson(url, { method: 'POST' });

                if (window.Swal) {
                Swal.fire({ icon: 'success', title: 'Demande envoyée', timer: 1200, showConfirmButton: false });
                }

                await loadFriendshipStateForButton(btn);
            } catch (e) {
                console.error(e);
                if (window.Swal) Swal.fire({ icon:'error', title:'Erreur', text:"Impossible d'envoyer la demande." });
            }
        }

        async function cancelFriendRequest(btn) {
            const userId = btn.dataset.user;
            const url = tplUrl(window.MOL_FRIEND.cancelUrlTpl, userId);

            try {
                if (window.Swal) {
                const r = await Swal.fire({
                    icon: 'warning',
                    title: 'Annuler la demande ?',
                    text: "La demande d’amitié sera supprimée.",
                    showCancelButton: true,
                    confirmButtonText: 'Oui, annuler',
                    cancelButtonText: 'Non'
                });
                if (!r.isConfirmed) return;
                }

                await ajaxJson(url, { method: 'POST' });
                await loadFriendshipStateForButton(btn);
            } catch (e) {
                console.error(e);
                if (window.Swal) Swal.fire({ icon:'error', title:'Erreur', text:"Impossible d'annuler la demande." });
            }
        }

        async function confirmBlock(btn) {
            const userId = btn.dataset.user;
            if (!window.Swal) return blockUser(btn);

            const r = await Swal.fire({
                icon: 'warning',
                title: 'Bloquer cet utilisateur ?',
                text: "Vous ne recevrez plus de demandes ni de messages de sa part.",
                showCancelButton: true,
                confirmButtonText: 'Bloquer',
                cancelButtonText: 'Annuler'
            });

            if (r.isConfirmed) await blockUser(btn);
        }

        async function blockUser(btn) {
            const userId = btn.dataset.user;
            const url = tplUrl(window.MOL_FRIEND.blockUrlTpl, userId);
            await ajaxJson(url, { method: 'POST' });
            await loadFriendshipStateForButton(btn);
        }

        async function promptAcceptReject(btn) {
            const friendshipId = btn.dataset.friendshipId;
            if (!friendshipId) {
                console.warn('friendshipId manquant.');
                return;
            }

            if (!window.Swal) return acceptFriendship(btn, friendshipId);

            const r = await Swal.fire({
                icon: 'question',
                title: 'Demande d’amitié',
                text: 'Voulez-vous accepter cette demande ?',
                showDenyButton: true,
                showCancelButton: true,
                confirmButtonText: 'Accepter',
                denyButtonText: 'Refuser',
                cancelButtonText: 'Plus tard'
            });

            if (r.isConfirmed) await acceptFriendship(btn, friendshipId);
            else if (r.isDenied) await rejectFriendship(btn, friendshipId);
        }

        async function acceptFriendship(btn, friendshipId) {
            const url = tplUrl(window.MOL_FRIEND.acceptUrlTpl, friendshipId);
            await ajaxJson(url, { method: 'POST' });
            await loadFriendshipStateForButton(btn);
        }

        async function rejectFriendship(btn, friendshipId) {
            const url = tplUrl(window.MOL_FRIEND.rejectUrlTpl, friendshipId);
            await ajaxJson(url, { method: 'POST' });
            await loadFriendshipStateForButton(btn);
        }


    </script>
    

