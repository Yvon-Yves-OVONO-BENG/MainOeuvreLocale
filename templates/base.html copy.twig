    <script>
        function MOLAutoResize(el){
            el.style.height = 'auto';
            el.style.height = Math.min(el.scrollHeight, 110) + 'px';
        }

        function MOLToastKeydown(e, id){
            // Enter = envoyer, Shift+Enter = nouvelle ligne
            if(e.key === 'Enter' && !e.shiftKey){
                e.preventDefault();
                MOLChatToastSend(id);
            }
        }

        /* =========================
        EMOJI PICKER (library)
        ========================= */

        function MOLToggleEmoji(id){
            const pop = document.getElementById(`molEmojiPop-${id}`);
            if(!pop) return;

            pop.classList.toggle('show');

            // Fermer si clic dehors (optionnel, propre)
            if(pop.classList.contains('show')){
                const onDocClick = (e) => {
                if(!pop.contains(e.target) && e.target.closest(`[onclick="MOLToggleEmoji(${id})"]`) == null){
                    pop.classList.remove('show');
                    document.removeEventListener('click', onDocClick, true);
                }
                };
                setTimeout(() => document.addEventListener('click', onDocClick, true), 0);
            }
        }

        /**
        * Branche un emoji-picker à un toastId.
        * À appeler quand tu injectes/crées le toast dans le DOM.
        */
        function MOLAutoResize(el){
            el.style.height = 'auto';
            el.style.height = Math.min(el.scrollHeight, 110) + 'px';
        }

        function MOLToastKeydown(e, id){
            if(e.key === 'Enter' && !e.shiftKey){
                e.preventDefault();
                MOLChatToastSend(id);
            }
        }

        /* =========================
        EMOJI BUTTON (library)
        ========================= */

        const MOL_EMOJI_PICKERS = new Map();

        async function MOLBindEmojiPickerForToast(id){
            const btn = document.getElementById(`molEmojiBtn-${id}`);
            if(!btn){
                console.warn('[emoji] bouton introuvable', id);
                return;
            }

            // Déjà bindé → on sort
            if (MOL_EMOJI_PICKERS.has(id)) return;

            try{
                await MOLEnsureEmojiLib();
            }catch(e){
                console.error('[emoji] chargement lib impossible', e);
                return;
            }

            // ✅ Compat: selon build, ça peut être function ou namespace
            const Ctor =
                (typeof window.EmojiButton === 'function' ? window.EmojiButton : null) ||
                (window.EmojiButton && typeof window.EmojiButton.EmojiButton === 'function' ? window.EmojiButton.EmojiButton : null);

            if(!Ctor){
                console.error('[emoji] EmojiButton toujours indisponible après chargement', window.EmojiButton);
                return;
            }

            const picker = new Ctor({
                position: 'top-start',
                autoHide: true,
                theme: 'light'
            });

            picker.on('emoji', selection => {
                MOLInsertEmoji(id, selection.emoji);
            });

            btn.addEventListener('click', () => {
                picker.togglePicker(btn);
            });

            MOL_EMOJI_PICKERS.set(id, picker);
        }


        function MOLInsertEmoji(id, emoji){
