                    width: 52px;
                    height: 52px;
                    border-radius: 999px;
                    object-fit: cover;
                    border: 3px solid rgba(255,255,255,.92);
                    box-shadow: 0 12px 28px rgba(2,6,23,.14);
                    background: #e2e8f0;
                }

                .mol-call-top-name{
                    font-size: 1rem;
                    font-weight: 900;
                    line-height: 1.1;
                    color: #0f172a;
                }

                .mol-call-top-status{
                    margin-top: 4px;
                    font-size: .86rem;
                    color: #64748b;
                    font-weight: 700;
                }

                .mol-call-top-right{
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    flex-wrap: wrap;
                    justify-content: flex-end;
                }

                .mol-call-chip{
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    height: 38px;
                    padding: 0 14px;
                    border-radius: 999px;
                    background: rgba(255,255,255,.82);
                    border: 1px solid rgba(15,23,42,.08);
                    color: #0f172a;
                    font-size: .85rem;
                    font-weight: 800;
                    box-shadow: 0 10px 24px rgba(2,6,23,.08);
                }

                .mol-call-close{
                    width: 42px;
                    height: 42px;
                    border: 0;
                    border-radius: 999px;
                    background: rgba(15,23,42,.06);
                    color: #0f172a;
                    box-shadow: 0 10px 24px rgba(2,6,23,.08);
                }

                .mol-call-main{
                    position: relative;
                    z-index: 1;
                    display: grid;
                    grid-template-columns: 360px 1fr;
                    gap: 18px;
                    padding: 18px;
                    flex: 1 1 auto;
                    min-height: 0;
                }

                .mol-call-side{
                    display: flex;
                    flex-direction: column;
                    gap: 16px;
                    min-height: 0;
                }

                .mol-call-hero{
                    position: relative;
                    border-radius: 28px;
                    background:
                        radial-gradient(700px circle at 20% 0%, rgba(59,130,246,.14), transparent 45%),
                        radial-gradient(700px circle at 80% 0%, rgba(16,185,129,.10), transparent 45%),
                        linear-gradient(180deg, #f8fafc, #eef2ff);
                    border: 1px solid rgba(15,23,42,.08);
                    padding: 26px 20px 22px;
                    text-align: center;
                    overflow: hidden;
                    min-height: 380px;
                    display: flex;
                    flex-direction: column;
                    justify-content: center;
                    box-shadow: 0 18px 48px rgba(2,6,23,.08);
                }

                .mol-call-ring-wrap{
                    position: relative;
                    width: 190px;
                    height: 190px;
                    margin: 0 auto 18px;
                    display: grid;
                    place-items: center;
                }

                .mol-call-pulse,
                .mol-call-pulse-2,
                .mol-call-pulse-3{
                    position: absolute;
                    inset: 0;
                    border-radius: 999px;
                    border: 2px solid rgba(37,99,235,.16);
                    animation: molCallPulse 2.2s infinite ease-out;
                }

                .mol-call-pulse-2{ animation-delay: .45s; }
                .mol-call-pulse-3{ animation-delay: .9s; }

                @keyframes molCallPulse{
                    0%   { transform: scale(.76); opacity: .0; }
                    20%  { opacity: .75; }
                    100% { transform: scale(1.25); opacity: 0; }
                }

                .mol-call-avatar-big{
                    position: relative;
                    z-index: 2;
                    width: 126px;
                    height: 126px;
                    border-radius: 999px;
                    object-fit: cover;
                    border: 5px solid rgba(255,255,255,.96);
                    box-shadow: 0 24px 50px rgba(2,6,23,.16);
                    background: #e2e8f0;
                }

                .mol-call-center-badge{
                    position: absolute;
                    right: 18px;
                    bottom: 20px;
                    z-index: 3;
                    width: 54px;
                    height: 54px;
                    border-radius: 999px;
                    display: grid;
                    place-items: center;
                    color: #fff;
                    background: linear-gradient(135deg, #2563eb, #60a5fa);
                    box-shadow: 0 18px 40px rgba(37,99,235,.28);
                    font-size: 1.2rem;
                    animation: molPhoneSwing 1.15s ease-in-out infinite;
                }

                @keyframes molPhoneSwing{
                    0%   { transform: rotate(0deg); }
                    15%  { transform: rotate(18deg); }
                    30%  { transform: rotate(-14deg); }
                    45%  { transform: rotate(12deg); }
                    60%  { transform: rotate(-8deg); }
                    75%  { transform: rotate(4deg); }
                    100% { transform: rotate(0deg); }
                }

                .mol-call-name{
                    font-size: 1.35rem;
                    font-weight: 950;
                    color: #0f172a;
                    line-height: 1.1;
                }

                .mol-call-status{
                    margin-top: 8px;
                    color: #64748b;
                    font-size: .95rem;
                    font-weight: 700;
                }

                .mol-call-substatus{
                    margin-top: 6px;
                    font-size: .82rem;
                    color: #94a3b8;
                    font-weight: 700;
                }

                .mol-call-quick{
                    display: grid;
                    grid-template-columns: repeat(2, 1fr);
                    gap: 10px;
                }

                .mol-call-mini{
                    border-radius: 22px;
                    background: rgba(255,255,255,.82);
                    border: 1px solid rgba(15,23,42,.08);
                    padding: 14px;
                    box-shadow: 0 14px 34px rgba(2,6,23,.06);
                }

                .mol-call-mini-title{
                    font-size: .72rem;
                    text-transform: uppercase;
                    letter-spacing: .06em;
                    font-weight: 900;
                    color: #94a3b8;
                    margin-bottom: 6px;
                }

                .mol-call-mini-value{
                    font-size: .95rem;
                    font-weight: 900;
                    color: #0f172a;
                }

                .mol-call-stage{
                    position: relative;
                    min-height: 0;
                    border-radius: 30px;
                    overflow: hidden;
                    background:
                        radial-gradient(1200px circle at 10% 0%, rgba(59,130,246,.12), transparent 45%),
                        radial-gradient(900px circle at 90% 0%, rgba(16,185,129,.10), transparent 45%),
