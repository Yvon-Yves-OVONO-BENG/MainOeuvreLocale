                    border: 1px solid rgba(255,255,255,.26);
                    box-shadow:
                        0 30px 90px rgba(0,0,0,.28),
                        inset 0 1px 0 rgba(255,255,255,.55);
                    position: relative;
                    display: flex;
                    flex-direction: column;
                }

                .mol-call-shell::before{
                    content: "";
                    position: absolute;
                    inset: 0;
                    pointer-events: none;
                    background:
                        radial-gradient(900px circle at 15% 0%, rgba(59,130,246,.10), transparent 40%),
                        radial-gradient(900px circle at 85% 0%, rgba(16,185,129,.08), transparent 40%);
                }

                .mol-call-top{
                    position: relative;
