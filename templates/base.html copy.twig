            function MOLHandleComposerInput(conversationId) {
                const input = document.getElementById(`molToastInput-${conversationId}`);
                const likeBtn = document.getElementById(`molLikeBtn-${conversationId}`);
                const sendBtn = document.getElementById(`molSendBtn-${conversationId}`);

                if (!input || !likeBtn || !sendBtn) return;

                const raw = input.value || '';
                const hasContent = raw.replace(/\s/g, '').length > 0;

                likeBtn.classList.toggle('mol-hidden', hasContent);
                sendBtn.classList.toggle('mol-hidden', !hasContent);
