                                                onclick="MOLChatToastSend(${id})">
                                            <i class="bi bi-send-fill"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            async function MOLEnsureEmojiLib() {
                if (window.EmojiButton && (typeof window.EmojiButton === 'function' || typeof window.EmojiButton === 'object')) {
                    return Promise.resolve();
                }

                if (window.__MOL_EMOJI_LOADING__) {
                    return window.__MOL_EMOJI_LOADING__;
                }

                window.__MOL_EMOJI_LOADING__ = new Promise((resolve, reject) => {
                    const s = document.createElement('script');
                    s.src = 'https://cdn.jsdelivr.net/npm/@joeattardi/emoji-button@4.6.4/dist/index.min.js';
                    s.async = true;
                    s.onload = () => resolve();
                    s.onerror = () => reject(new Error('emoji-button load failed'));
                    document.head.appendChild(s);
                });

                return window.__MOL_EMOJI_LOADING__;
            }

            window.MOLBindEmojiPickerForToast = async function(conversationId) {
                await MOLEnsureEmojiLib();

                const btn = document.getElementById(`molEmojiBtn-${conversationId}`);
                const input = document.getElementById(`molToastInput-${conversationId}`);

                if (!btn || !input || btn.__emojiBound) return;
                btn.__emojiBound = true;

                const picker = new window.EmojiButton({
                    position: 'top-start',
                    autoHide: true,
                    theme: 'light',
                    rootElement: document.body,
                    zIndex: 2147483647
                });

                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    picker.togglePicker(btn);
                });

                picker.on('emoji', (selection) => {
                    const emoji = typeof selection === 'string' ? selection : selection?.emoji;
                    if (!emoji) return;

                    input.value = (input.value || '') + emoji;
                    input.dispatchEvent(new Event('input', { bubbles: true }));
                    MOLHandleComposerInput(conversationId);
                    input.focus();
                });
            };

            async function MOLChatOpenBubble(conv) {
                const container = document.getElementById('molChatToasts');
                if (!container) return;

                const convId = Number(conv.id);
                const existing = document.getElementById(`molToast-${convId}`);

                if (existing) {
                    const dropdown = existing.querySelector('.dropdown-menu');

                    if (dropdown && !existing.__callBound) {
                        existing.__callBound = true;

                        dropdown.addEventListener('click', (e) => {
                            const a = e.target.closest('[data-call-type]');
                            if (!a) return;

                            e.preventDefault();
                            if (typeof window.MOLStartConversationCall === 'function') {
                                window.MOLStartConversationCall(convId, a.dataset.callType);
                            }
                        });
                    }

                    if (window.bootstrap?.Toast) {
                        window.bootstrap.Toast.getOrCreateInstance(existing).show();
                    } else {
                        existing.classList.add('show');
                        existing.style.display = 'block';
                    }

                    await MOLChatRefreshBubble(convId);
                    MOLHandleComposerInput(convId);
                    MOLRenderReplyBox(convId);
                    return;
                }

                container.insertAdjacentHTML('beforeend', MOLChatToastTemplate({
                    id: convId,
                    name: conv.name,
                    avatar: MOLAbsUrl(conv.avatar || conv.avatarUrl || ''),
                    online: conv.online,
                    presence: conv.presence || 'offline'
                }));

                const el = document.getElementById(`molToast-${convId}`);
                if (!el) return;

                const ddToggle = el.querySelector('[data-bs-toggle="dropdown"]');
                if (ddToggle && window.bootstrap?.Dropdown) {
                    window.bootstrap.Dropdown.getOrCreateInstance(ddToggle, { autoClose: 'outside' });
                }

                const dropdown = el.querySelector('.dropdown-menu');
                if (dropdown && !el.__callBound) {
                    el.__callBound = true;
                    dropdown.addEventListener('click', (e) => {
                        const a = e.target.closest('[data-call-type]');
                        if (!a) return;

                        e.preventDefault();
                        if (typeof window.MOLStartConversationCall === 'function') {
                            window.MOLStartConversationCall(convId, a.dataset.callType);
                        }
                    });
                }

                if (window.bootstrap?.Toast) {
                    window.bootstrap.Toast.getOrCreateInstance(el).show();
                } else {
                    el.classList.add('show');
                    el.style.display = 'block';
                }

                if (typeof window.MOLBindEmojiPickerForToast === 'function') {
                    await window.MOLBindEmojiPickerForToast(convId);
                }

                await MOLChatRefreshBubble(convId);
                MOLHandleComposerInput(convId);
                MOLRenderReplyBox(convId);

                if (typeof window.MOLInitMercure === 'function') {
                    window.MOLInitMercure(convId);
                }

                setTimeout(() => document.getElementById(`molToastInput-${convId}`)?.focus(), 120);
            }

            async function MOLChatToastSend(conversationId) {
                const input = document.getElementById(`molToastInput-${conversationId}`);
                if (!input) return;

                const content = input.value.trim();
                if (!content) return;

                const replyState = MOL_REPLY_STATE[conversationId] || null;
                input.disabled = true;

                try {
                    const url = molUrl(window.MOL_CHAT.urls.send, conversationId);
                    const res = await fetch(url, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({
                            content,
                            replyToId: replyState?.id || null
                        })
                    });

                    if (!res.ok) {
                        throw new Error('HTTP ' + res.status);
                    }

                    input.value = '';
                    MOLHandleComposerInput(conversationId);
                    MOLClearReply(conversationId);
                    await MOLChatRefreshBubble(conversationId);

                    if (typeof window.MOLOnNewMessage === 'function') {
                        window.MOLOnNewMessage(conversationId);
                    }

                    if (typeof window.MOLChatRefreshList === 'function') {
                        await window.MOLChatRefreshList();
                    }
                } catch (e) {
                    alert("{% trans %}Erreur réseau: impossible d’envoyer.{% endtrans %}");
                } finally {
                    input.disabled = false;
                    input.focus();
                }
            }

            async function MOLChatUploadForm(conversationId, endpointTemplate, formData) {
                const url = molUrl(endpointTemplate, conversationId);
                console.log('[chat upload] final URL =', url);

                const res = await fetch(url, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData
                });

                const rawText = await res.text();
                let data = {};

                try {
                    data = rawText ? JSON.parse(rawText) : {};
                } catch (e) {
                    console.error('[chat upload] réponse non JSON :', rawText);
                    throw new Error('Réponse invalide du serveur.');
                }

                if (!res.ok || data.ok === false) {
                    console.error('[chat upload] error', {
                        status: res.status,
                        url,
                        response: data
                    });

                    throw new Error(data.error || ('HTTP ' + res.status));
                }

                return data;
            }

            async function MOLChatToastSendFile(conversationId, file) {
                if (!file) return;

                if (!window.MOL_CHAT?.urls?.sendFile) {
                    alert("{% trans %}URL d’envoi de fichier non configurée.{% endtrans %}");
                    return;
                }

                try {
                    const finalUrl = molUrl(window.MOL_CHAT.urls.sendFile, conversationId);
                    console.log('[send file] template =', window.MOL_CHAT.urls.sendFile);
                    console.log('[send file] final URL =', finalUrl);
                    console.log('[send file] file =', {
                        name: file.name,
                        type: file.type,
                        size: file.size
                    });

                    const formData = new FormData();
                    formData.append('file', file);

                    const replyState = MOL_REPLY_STATE[conversationId];
                    if (replyState?.id) {
                        formData.append('replyToId', String(replyState.id));
                    }

                    await MOLChatUploadForm(conversationId, window.MOL_CHAT.urls.sendFile, formData);

                    MOLClearReply(conversationId);
                    await MOLChatRefreshBubble(conversationId);

                    if (typeof window.MOLChatRefreshList === 'function') {
                        await window.MOLChatRefreshList();
                    }
                } catch (e) {
                    console.error('send file error', e);
                    alert(e?.message || "{% trans %}Impossible d’envoyer le fichier.{% endtrans %}");
                }
            }

            async function MOLChatToastToggleVoice(conversationId) {
                const btn = document.getElementById(`molMicBtn-${conversationId}`);
                if (!btn) return;

                const current = MOL_VOICE_RECORDERS[conversationId];

                if (current?.recorder?.state === 'recording') {
                    current.recorder.stop();
                    btn.classList.remove('is-recording');
                    return;
                }

                if (!navigator.mediaDevices?.getUserMedia || typeof MediaRecorder === 'undefined') {
                    alert("{% trans %}L’enregistrement vocal n’est pas supporté sur cet appareil.{% endtrans %}");
                    return;
                }

                if (!window.MOL_CHAT?.urls?.sendVoice) {
                    alert("{% trans %}URL d’envoi vocal non configurée.{% endtrans %}");
                    return;
                }

                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    const mimeType = MediaRecorder.isTypeSupported('audio/webm;codecs=opus')
                        ? 'audio/webm;codecs=opus'
                        : (MediaRecorder.isTypeSupported('audio/webm') ? 'audio/webm' : '');

                    const recorder = mimeType ? new MediaRecorder(stream, { mimeType }) : new MediaRecorder(stream);
                    const chunks = [];

                    recorder.ondataavailable = (e) => {
                        if (e.data && e.data.size > 0) {
                            chunks.push(e.data);
                        }
                    };

                    recorder.onstop = async () => {
                        btn.classList.remove('is-recording');
                        stream.getTracks().forEach(t => t.stop());

                        const blob = new Blob(chunks, { type: recorder.mimeType || 'audio/webm' });
                        if (!blob.size) return;

                        const ext = blob.type.includes('ogg') ? 'ogg' : blob.type.includes('mp4') ? 'm4a' : 'webm';
                        const filename = `voice-${Date.now()}.${ext}`;
                        const file = new File([blob], filename, { type: blob.type || 'audio/webm' });

                        try {
                            const finalUrl = molUrl(window.MOL_CHAT.urls.sendVoice, conversationId);
                            console.log('[send voice] template =', window.MOL_CHAT.urls.sendVoice);
                            console.log('[send voice] final URL =', finalUrl);

                            const formData = new FormData();
                            formData.append('voice', file);

                            const replyState = MOL_REPLY_STATE[conversationId];
                            if (replyState?.id) {
                                formData.append('replyToId', String(replyState.id));
                            }

                            await MOLChatUploadForm(conversationId, window.MOL_CHAT.urls.sendVoice, formData);

                            MOLClearReply(conversationId);
                            await MOLChatRefreshBubble(conversationId);

                            if (typeof window.MOLChatRefreshList === 'function') {
                                await window.MOLChatRefreshList();
                            }
                        } catch (e) {
                            console.error('send voice error', e);
                            alert(e?.message || "{% trans %}Impossible d’envoyer le message vocal.{% endtrans %}");
                        }
                    };

                    MOL_VOICE_RECORDERS[conversationId] = { recorder, stream };
                    recorder.start();
                    btn.classList.add('is-recording');
                } catch (e) {
                    console.error('voice record error', e);
                    alert("{% trans %}Impossible de démarrer l’enregistrement.{% endtrans %}");
                }
            }

            async function MOLChatRefreshList(q = '') {
                try {
                    const data = await MOLChatLoadConversations(q);
                    const items = data.items || data.conversations || [];
                    MOLChatRenderConversations(items);
