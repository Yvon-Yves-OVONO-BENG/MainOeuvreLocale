    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('molCallCloseBtn')?.addEventListener('click', () => {
                cleanupCall(true);
            });
            const modalEl = document.getElementById('molCallModal');
            if (!modalEl) return;

            modalEl.addEventListener('hidden.bs.modal', () => {
                document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
                document.body.classList.remove('modal-open');
                document.body.style.removeProperty('padding-right');
                document.body.style.removeProperty('overflow');
            });
        });
    </script>

        <script>
            (function () {
                if (window.__MOL_PRESENCE_BOOTED__) return;
                window.__MOL_PRESENCE_BOOTED__ = true;

                const HEARTBEAT_URL = '{{ path('presence_heartbeat') }}';
                const OFFLINE_URL   = '{{ path('presence_offline') }}';

                let heartbeatTimer = null;

                function postPresence(url, useBeacon = false) {
                    if (useBeacon && navigator.sendBeacon) {
                        try {
                            const ok = navigator.sendBeacon(url, new URLSearchParams());
                            if (ok) return Promise.resolve(true);
                        } catch (e) {}
                    }

                    return fetch(url, {
                        method: 'POST',
                        credentials: 'same-origin',
                        keepalive: true,
                        cache: 'no-store',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Cache-Control': 'no-cache'
                        }
                    }).catch(() => {});
                }

                function sendHeartbeat() {
                    return postPresence(HEARTBEAT_URL);
                }

                function sendOffline() {
                    return postPresence(OFFLINE_URL, true);
                }

                function refreshChatPresenceIfNeeded() {
                    const panel = document.getElementById('molChatPanel');

                    if (panel && panel.classList.contains('is-open') && typeof window.MOLChatRefreshList === 'function') {
                        window.MOLChatRefreshList(
                            document.getElementById('molChatSearch')?.value?.trim() || ''
                        );
                    }
                }

                function startPresence() {
                    sendHeartbeat();

                    if (heartbeatTimer) {
                        clearInterval(heartbeatTimer);
                    }

                    heartbeatTimer = setInterval(() => {
                        sendHeartbeat();
                        refreshChatPresenceIfNeeded();
                    }, 25000);
                }

                window.addEventListener('load', startPresence);
                window.addEventListener('pageshow', startPresence);

                document.addEventListener('visibilitychange', () => {
                    if (document.visibilityState === 'visible') {
                        sendHeartbeat();
                        refreshChatPresenceIfNeeded();
                    }
                });

                window.addEventListener('pagehide', sendOffline);
                window.addEventListener('beforeunload', sendOffline);
            })();
        </script>

        <script>
            (function () {
                const HEARTBEAT_URL = '{{ path('presence_heartbeat') }}';
                const OFFLINE_URL   = '{{ path('presence_offline') }}';

                let heartbeatTimer = null;

                function postPresence(url) {
                    return fetch(url, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        keepalive: true
                    }).catch(() => {});
                }

                function sendHeartbeat() {
                    postPresence(HEARTBEAT_URL);
                }

                function sendOffline() {
                    try {
                        const data = new URLSearchParams();
                        navigator.sendBeacon(OFFLINE_URL, data);
                    } catch (e) {
                        postPresence(OFFLINE_URL);
                    }
                }

                function startPresence() {
                    sendHeartbeat();

                    if (heartbeatTimer) {
                        clearInterval(heartbeatTimer);
                    }

                    heartbeatTimer = setInterval(sendHeartbeat, 25000);
                }

                window.addEventListener('load', startPresence);

                document.addEventListener('visibilitychange', function () {
                    if (document.visibilityState === 'visible') {
                        sendHeartbeat();

                        if (typeof MOLChatRefreshList === 'function') {
                            MOLChatRefreshList();
                        }
                    }
                });

                window.addEventListener('pagehide', sendOffline);
                window.addEventListener('beforeunload', sendOffline);

                setInterval(function () {
                    if (typeof MOLChatRefreshList === 'function') {
                        MOLChatRefreshList();
                    }
                }, 30000);
            })();
        </script>
        

        <script>
(function () {
  function setChatViewportHeight() {
    const vv = window.visualViewport;
    const vh = vv ? vv.height : window.innerHeight;
    const topbar = parseFloat(
      getComputedStyle(document.documentElement).getPropertyValue('--mol-topbar-h')
    ) || 0;

    const panel = document.querySelector('.mol-chat-panel');
    if (panel) {
      panel.style.height = `${Math.max(0, vh - topbar)}px`;
    }
  }

  function scrollCurrentChatToBottom() {
    const mobileMsgs = document.getElementById('molChatThreadMsgs');
    if (mobileMsgs) {
      mobileMsgs.scrollTop = mobileMsgs.scrollHeight;
    }

    document.querySelectorAll('[id^="molToastMsgs-"]').forEach(el => {
      el.scrollTop = el.scrollHeight;
    });
  }

  window.addEventListener('load', () => {
    setChatViewportHeight();
    setTimeout(scrollCurrentChatToBottom, 100);
  });

  window.addEventListener('resize', () => {
    setChatViewportHeight();
    setTimeout(scrollCurrentChatToBottom, 80);
  });

  window.addEventListener('orientationchange', () => {
    setTimeout(() => {
      setChatViewportHeight();
      scrollCurrentChatToBottom();
    }, 250);
  });

  if (window.visualViewport) {
    window.visualViewport.addEventListener('resize', () => {
      setChatViewportHeight();
      setTimeout(scrollCurrentChatToBottom, 80);
    });

    window.visualViewport.addEventListener('scroll', () => {
      setChatViewportHeight();
    });
  }

  document.addEventListener('focusin', (e) => {
    if (
      e.target.closest('#molChatThreadInput') ||
      e.target.closest('[id^="molToastInput-"]')
    ) {
      setTimeout(() => {
        setChatViewportHeight();
        scrollCurrentChatToBottom();
      }, 120);
    }
  });
})();
</script>
    </body>
</html>