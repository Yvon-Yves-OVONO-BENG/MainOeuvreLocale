    {# PRO CSS BUBBLE  #}
    <script>
    
        /* =========================
        Messenger Premium Add-ons
        ========================= */

        const MOL_UI = {
            maxOpenToasts: 3,      // ✅ empilement intelligent
            minimized: new Set(),  // convId minimisés
            dockHiddenCount: 0,    // nombre cachés dans le dock (+N)
        };

        function MOLEnsureDock(){
            let dock = document.getElementById('molChatDock');
            if(!dock){
                dock = document.createElement('div');
                dock.id = 'molChatDock';
                document.body.appendChild(dock);
            }
            return dock;
        }

        /* ✅ Bouton minimiser/restaurer dans header (tu peux l'appeler après insertion) */
        function MOLAddMinimizeButton(convId){
            const toast = document.getElementById(`molToast-${convId}`);
            if(!toast) return;

            // Eviter doublon
            if(toast.querySelector('[data-mol-minbtn="1"]')) return;
        
        }

        function MOLToggleMinimize(convId){
            const toast = document.getElementById(`molToast-${convId}`);
            if(!toast) return;

            const isMin = toast.classList.toggle('mol-minimized');
            if(isMin) MOL_UI.minimized.add(convId);
            else MOL_UI.minimized.delete(convId);

            MOLRenderDock();
        }

        /* ✅ Empilement: ne garde que N toasts visibles, le reste -> dock (+N) */
        function MOLApplyStacking(){
            const container = document.getElementById('molChatToasts');
            if(!container) return;

            const all = [...container.querySelectorAll('.toast')];

            // Priorité: les minimisés prennent moins de place => on les garde
            const minimized = all.filter(t => t.classList.contains('mol-minimized'));
            const normal = all.filter(t => !t.classList.contains('mol-minimized'));

            // On veut maxOpenToasts visibles AU TOTAL (min + norm)
            const keep = [];
            minimized.forEach(t => keep.push(t));

            for(const t of normal){
                if(keep.length >= MOL_UI.maxOpenToasts) break;
                keep.push(t);
            }

            const keepIds = new Set(keep.map(t => t.id));

            // Cache les autres (mais ne les supprime pas)
            let hiddenCount = 0;
            for(const t of all){
                if(!keepIds.has(t.id)){
                t.style.display = 'none';
                hiddenCount++;
                }else{
                t.style.display = '';
                }
            }

            MOL_UI.dockHiddenCount = hiddenCount;
            MOLRenderDock();
        }

        /* ✅ Dock: affiche +N, et aussi les minimisés en avatars cliquables */
        function MOLRenderDock(){
            const dock = MOLEnsureDock();

            // avatars minimisés
            const minimizedIds = [...MOL_UI.minimized.values()];
            const pills = minimizedIds.map(id => {
                const toast = document.getElementById(`molToast-${id}`);
                const img = toast?.querySelector('img')?.getAttribute('src') || '';
                return `
                <div class="mol-dock-pill" data-mol-open="${id}" title="Ouvrir">
                    <div class="mol-dock-ava"><img src="${img}" alt=""></div>
                </div>
                `;
            }).join('');

            // +N hidden
            const plus = (MOL_UI.dockHiddenCount > 0)
                ? `<div class="mol-dock-pill" data-mol-showall="1" title="Afficher tout">
                    <span class="mol-dock-count">+${MOL_UI.dockHiddenCount}</span>
                </div>`
                : '';

            dock.innerHTML = pills + plus;

            // handlers
            dock.querySelectorAll('[data-mol-open]').forEach(el => {
                el.onclick = () => {
                const id = parseInt(el.getAttribute('data-mol-open'), 10);
                // restaurer
                const toast = document.getElementById(`molToast-${id}`);
                if(toast){
                    toast.classList.remove('mol-minimized');
                    MOL_UI.minimized.delete(id);
                    toast.style.display = ''; // au cas où
                    bootstrap.Toast.getOrCreateInstance(toast).show();
                }
                MOLApplyStacking();
                };
            });

            dock.querySelectorAll('[data-mol-showall="1"]').forEach(el => {
                el.onclick = () => {
                // show all toasts
                const container = document.getElementById('molChatToasts');
                if(!container) return;
                container.querySelectorAll('.toast').forEach(t => t.style.display = '');
                MOL_UI.dockHiddenCount = 0;
                MOLRenderDock();
                };
            });
        }

        /* ✅ Typing indicator: show/hide */
        function MOLShowTyping(convId){
            const box = document.getElementById(`molToastMsgs-${convId}`);
            if(!box) return;

            if(box.querySelector(`[data-mol-typing="${convId}"]`)) return;

            const wrap = document.createElement('div');
            wrap.className = 'd-flex mb-2';
            wrap.setAttribute('data-mol-typing', String(convId));
            wrap.innerHTML = `
                <div class="mol-typing">
                <div class="mol-dots">
                    <span class="mol-dot"></span>
                    <span class="mol-dot"></span>
                    <span class="mol-dot"></span>
                </div>
                <div class="small text-secondary">écrit...</div>
                </div>
            `;
            box.appendChild(wrap);
            box.scrollTop = box.scrollHeight;
        }

        function MOLHideTyping(convId){
            const box = document.getElementById(`molToastMsgs-${convId}`);
            if(!box) return;
            box.querySelectorAll(`[data-mol-typing="${convId}"]`).forEach(n => n.remove());
        }

        /* ✅ Son + vibration (limites navigateur) */
        let MOL_SOUND_ENABLED = true;
        let MOL_VIBRATE_ENABLED = true;

        // Son (petit “pop”). Le navigateur bloque tant qu’il n’y a pas eu interaction utilisateur.
        function MOLPlayPopSound(){
            if(!MOL_SOUND_ENABLED) return;

            try{
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const o = ctx.createOscillator();
                const g = ctx.createGain();
                o.type = 'sine';
                o.frequency.value = 880;
                g.gain.value = 0.03;
                o.connect(g); g.connect(ctx.destination);
                o.start();
                setTimeout(() => { o.stop(); ctx.close(); }, 60);
            }catch(e){
                // ignore
            }
        }

        function MOLVibrate(){
            if(!MOL_VIBRATE_ENABLED) return;
            if('vibrate' in navigator){
                navigator.vibrate([20, 30, 20]);
            }
        }

        /* ✅ Hook à appeler quand tu ouvres/crées un toast */
        function MOLUpgradeToastUI(convId){
            MOLAddMinimizeButton(convId);
            MOLApplyStacking();
        }

        /* ✅ Hook à appeler quand tu reçois un nouveau message */
        function MOLOnNewMessage(convId, { playSound=true, vibrate=true } = {}){
            if(playSound) MOLPlayPopSound();
            if(vibrate) MOLVibrate();

            // petite animation visuelle sur le toast
            const toast = document.getElementById(`molToast-${convId}`);
            if(toast){
                toast.style.animation = 'none';
                // reflow
                void toast.offsetHeight;
                toast.style.animation = 'mol-pop .18s ease-out';
            }
        }

    </script>

