                            <div class="mol-inline-file__name" title="${escapeHtml(filename)}">
                                ${escapeHtml(filename || '{% trans %}Fichier{% endtrans %}')}
                            </div>
                            <div class="mol-inline-file__meta">${escapeHtml(size || '{% trans %}Fichier{% endtrans %}')}</div>
