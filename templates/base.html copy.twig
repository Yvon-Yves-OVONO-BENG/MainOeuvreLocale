                            <div class="mol-inline-filebar">
                                <div class="mol-inline-filebar__main">
                                    <div class="mol-inline-filebar__name" title="${escapeHtml(filename)}">
                                        ${escapeHtml(filename || '{% trans %}Vidéo{% endtrans %}')}
                                    </div>
                                    ${size ? `<div class="mol-inline-filebar__meta">${escapeHtml(size)}</div>` : ''}
                                </div>

                                <a
                                    class="mol-inline-filebar__download"
                                    href="${attachmentUrl}"
                                    download="${escapeHtml(filename || 'video')}"
                                    title="{% trans %}Télécharger{% endtrans %}"
                                >
                                    <i class="bi bi-download"></i>
                                </a>
                            </div>
                        </div>
                    `;
                }

                if (isAudio) {
                    return `
                        <div class="mol-inline-audio">
                            <audio controls preload="metadata" class="mol-chat-audio">
                                <source src="${attachmentUrl}" type="${escapeHtml(mimeType || 'audio/webm')}">
                            </audio>

                            <div class="mol-inline-filebar mol-inline-filebar--audio">
                                <div class="mol-inline-filebar__main">
                                    <div class="mol-inline-filebar__name" title="${escapeHtml(filename)}">
                                        ${escapeHtml(filename || '{% trans %}Audio{% endtrans %}')}
                                    </div>
                                </div>

                                <a
                                    class="mol-inline-filebar__download"
                                    href="${attachmentUrl}"
                                    download="${escapeHtml(filename || 'audio')}"
                                    title="{% trans %}Télécharger{% endtrans %}"
