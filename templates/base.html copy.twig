                    end: "{{ path('chat_call_end', {id: 0}) }}".replace('/0', '/__CALL__')
                }
            };
        </script>

        {# FRIENDSHIP JS  #}
        <script>
            document.addEventListener('DOMContentLoaded', () => {

            const modal = document.getElementById('friendsModal');
            if (!modal) return;

            modal.addEventListener('show.bs.modal', () => {
                loadPendingRequests();
                loadFriends();
            });

            });

            async function loadPendingRequests()
            {
                const container = document.getElementById('pendingRequestsContainer');

                const res = await fetch("{{ path('friendship_pending_list') }}");
                if (!res.ok) return;

                const data = await res.json();

                if (!data.items.length) {
                    container.innerHTML = `<div class="text-muted">Aucune demande reçue.</div>`;
                    return;
                }

                container.innerHTML = buildFriendTable(data.items, true);
            }

            async function loadFriends()
            {
                const container = document.getElementById('friendsContainer');

                const res = await fetch("{{ path('friendship_friends_list') }}");
                if (!res.ok) return;

                const data = await res.json();

                if (!data.items.length) {
                    container.innerHTML = `<div class="text-muted">Aucun ami pour le moment.</div>`;
                    return;
                }

                container.innerHTML = buildFriendTable(data.items, false);
            }

            function buildFriendTable(items, showActions)
            {
                return `
                <div class="mol-friend-list">

                    ${items.map(u => `
                        <div class="mol-friend-row">

                            <div class="mol-avatar-wrapper">
                                <img src="${u.avatarUrl}" class="mol-avatar">
                                <span class="mol-status ${u.online ? 'online':'offline'}"></span>
                            </div>

                            <div class="mol-friend-info">
                                <div class="mol-friend-name">${u.name}</div>
                                <div class="mol-friend-meta">
                                    ${u.online ? 'En ligne':'Hors ligne'}
                                </div>
                            </div>

                            <div class="mol-friend-actions">
                                ${showActions ? `
                                    <button class="btn btn-sm btn-success"
                                            onclick="acceptFriend(${u.friendshipId})">
                                        Accepter
                                    </button>

                                    <button class="btn btn-sm btn-light"
                                            onclick="rejectFriend(${u.friendshipId})">
                                        Refuser
                                    </button>
                                ` : `
                                    <button class="btn btn-sm btn-danger"
                                            onclick="blockFriend(${u.userId})">
                                        Bloquer
                                    </button>
                                `}
                            </div>

                        </div>
                    `).join('')}

                </div>`;
            }


            async function acceptFriend(id){
                await fetch(`/friendship/accept/${id}`, {method:'POST'});
                loadPendingRequests();
                loadFriends();
            }

            async function rejectFriend(id){
                await fetch(`/friendship/reject/${id}`, {method:'POST'});
                loadPendingRequests();
            }

            async function blockFriend(userId){
                await fetch(`/friendship/block/${userId}`, {method:'POST'});
                loadFriends();
            }

        </script>

        <script>
            window.MOL_PRESENCE = {
                heartbeat: "{{ path('presence_heartbeat') }}",
                offline: "{{ path('presence_offline') }}"
            };
        </script>

    
