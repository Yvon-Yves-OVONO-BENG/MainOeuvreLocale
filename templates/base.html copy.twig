                    box-shadow: 0 22px 60px rgba(2,6,23,.24);
                    display: flex;
                    align-items: stretch;
                }

                .mol-call-remote,
                .mol-call-local{
                    width: 100%;
                    height: 100%;
                    min-height: 480px;
                    object-fit: cover;
                    background: #0f172a;
                }

                .mol-call-local-card{
                    position: absolute;
                    right: 18px;
                    bottom: 18px;
                    width: 240px;
                    height: 168px;
                    border-radius: 24px;
                    overflow: hidden;
                    border: 2px solid rgba(255,255,255,.18);
                    box-shadow: 0 22px 46px rgba(0,0,0,.35);
                    backdrop-filter: blur(8px);
                    background: rgba(15,23,42,.55);
                }

                .mol-call-local-card .mol-call-local{
                    min-height: auto;
                    height: 100%;
                }

                .mol-call-label{
                    position: absolute;
                    top: 12px;
                    left: 12px;
                    z-index: 2;
                    padding: 7px 12px;
                    border-radius: 999px;
                    background: rgba(15,23,42,.55);
                    color: #fff;
                    font-size: .72rem;
                    font-weight: 900;
                    backdrop-filter: blur(10px);
                    border: 1px solid rgba(255,255,255,.12);
                }

                .mol-call-footer{
                    position: relative;
                    z-index: 2;
                    padding: 14px 18px 18px;
                    border-top: 1px solid rgba(15,23,42,.08);
                    background: rgba(255,255,255,.62);
                    backdrop-filter: blur(14px);
                    display: flex;
                    flex-direction: column;
                    gap: 14px;
                }

                .mol-call-main-actions{
                    display: flex;
                align-items: center;
                    justify-content: center;
                    gap: 12px;
                    flex-wrap: wrap;
                }

                .mol-call-secondary-actions{
                    display: flex;
                    align-items: center;
                    justify-content: center;
