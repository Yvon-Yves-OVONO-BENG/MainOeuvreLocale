            function MOLRenderMessageReactions(reactions) {
                if (!reactions || !reactions.length) return '';

                return `
                    <div class="mol-msg-reactions">
                        ${reactions.map(r => `
                            <span class="mol-msg-reaction-chip">
                                <span>${escapeHtml(r.emoji)}</span>
                                <span>${Number(r.total ?? r.count ?? 1)}</span>
                            </span>
                        `).join('')}
                    </div>
                `;
            }

            async function MOLEnsureReactionPicker() {
                await MOLEnsureEmojiLib();

                if (MOL_REACTION_PICKER_READY) return;

                MOL_REACTION_PICKER = new window.EmojiButton({
                    position: 'top-start',
                    autoHide: true,
                    theme: 'light',
                    rootElement: document.body,
                    zIndex: 2147483647
                });

                MOL_REACTION_PICKER_READY = true;
            }

            async function MOLOpenReactionPicker(event, messageId) {
                event.preventDefault();
                event.stopPropagation();

                await MOLEnsureReactionPicker();

                const trigger = event.currentTarget;
                const conversationId = Number(trigger.closest('.toast')?.id?.replace('molToast-', '') || 0);

                MOL_REACTION_PICKER.off?.('emoji');

                MOL_REACTION_PICKER.on('emoji', async (selection) => {
                    const emoji = typeof selection === 'string' ? selection : selection?.emoji;
                    if (!emoji) return;

                    try {
                        await MOLSendReaction(messageId, emoji, conversationId);
                    } catch (e) {
                        console.error('reaction error', e);
                    }
                });

                MOL_REACTION_PICKER.togglePicker(trigger);
            }

            async function MOLSendReaction(messageId, emoji, conversationId) {
                if (!window.MOL_CHAT?.urls?.react) {
                    console.warn('reaction url missing');
                    return;
                }

                const url = molUrl(window.MOL_CHAT.urls.react, messageId);

                const res = await fetch(url, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({ emoji })
                });

                const data = await res.json().catch(() => ({}));

                if (!res.ok || data.ok === false) {
                    throw new Error(data.error || ('HTTP ' + res.status));
                }

                if (conversationId) {
                    await MOLChatRefreshBubble(conversationId);
                    if (typeof window.MOLChatRefreshList === 'function') {
                        await window.MOLChatRefreshList();
                    }
                }
            }

            function MOLChatRenderBubbleMessages(items) {
                const visibleItems = (items || []).filter(m => !(m.deleted === true || m.isDeleted === true || Number(m.deleted) === 1));

                if (!visibleItems.length) {
                    return `<div class="text-center small text-secondary my-2">{% trans %}Aucun message{% endtrans %}</div>`;
                }

                return visibleItems.map(m => {
                    const mine = !!m.mine;
                    const time = escapeHtml(m.createdAt || '');
                    const content = escapeHtml(m.content || '');
                    const avatar = MOLAbsUrl(m.avatarUrl);
                    const replyBanner = MOLRenderReplyBanner(m);
                    const replyQuote = MOLRenderReplyInMessage(m.replyTo);
                    const attachment = MOLRenderAttachment(m);
                    const reactions = MOLRenderMessageReactions(m.reactions || []);

                    if (m.type === 'system') {
                        return `
                            <div class="mol-system-line">
                                <div class="mol-system-badge">
                                    <i class="bi bi-info-circle"></i>
                                    <span>${content}</span>
                                </div>
                            </div>
                        `;
                    }

                    const statusIcon = !mine ? '' : (
                        m.readAt
                            ? '<i class="bi bi-check2-all text-success mol-check"></i>'
                            : m.deliveredAt
                                ? '<i class="bi bi-check2-all text-secondary mol-check"></i>'
                                : '<i class="bi bi-check2 text-secondary mol-check"></i>'
                    );

                    let bodyHtml = '';

                    if (m.type === 'text' || !m.type) {
                        bodyHtml = `<div class="mol-msg-body">${content}</div>`;
                    } else if (m.type === 'call') {
                        bodyHtml = `
                            <div class="mol-call-card">
                                <span class="mol-call-card__icon"><i class="bi bi-telephone-fill"></i></span>
                                <div>
                                    <div class="mol-call-card__title">${content || '{% trans %}Appel{% endtrans %}'}</div>
                                    <div class="mol-call-card__meta">${time}</div>
                                </div>
                            </div>
                        `;
                    } else if (m.type === 'file' || m.type === 'voice') {
                        bodyHtml = '';
                    } else {
                        bodyHtml = `<div class="mol-msg-body">${content}</div>`;
                    }

                    return `
                        <div class="mol-msg-row d-flex ${mine ? 'justify-content-end' : 'justify-content-start'} mb-2"
                            data-message-id="${Number(m.id || 0)}"
                            data-mine="${mine ? '1' : '0'}"
                            data-content="${escapeHtml(m.content || '')}"
                            data-author-name="${escapeHtml(m.authorName || (mine ? '{% trans %}Vous{% endtrans %}' : '{% trans %}Contact{% endtrans %}'))}"
                            data-type="${escapeHtml(m.type || 'text')}">
                            <span class="mol-msg-swipe-hint reply"><i class="bi bi-reply"></i> {% trans %}Répondre{% endtrans %}</span>
                            <span class="mol-msg-swipe-hint delete"><i class="bi bi-trash"></i> {% trans %}Supprimer{% endtrans %}</span>

                            ${!mine ? `
                                <div class="flex-shrink-0 me-2">
                                    <img src="${avatar}" class="mol-msg-avatar" alt="">
                                </div>` : ''}

                            <div class="mol-msg-bubble-wrap ${mine ? 'mine' : 'other'}">
                                ${replyBanner}
                                <div style="position:relative;">
                                    <div class="mol-msg-card ${mine ? 'mine' : 'other'}">
                                        ${replyQuote}
                                        ${bodyHtml}
                                        ${attachment}
                                    </div>

                                    <button class="mol-msg-react-trigger"
                                            type="button"
                                            title="{% trans %}Réagir{% endtrans %}"
                                            onclick="MOLOpenReactionPicker(event, ${Number(m.id || 0)})">
                                        <i class="bi bi-emoji-smile"></i>
                                    </button>
                                </div>

                                ${reactions}

                                <div class="mol-msg-meta ${mine ? 'text-end' : 'text-start'}">
                                    ${time} ${statusIcon}
                                </div>
                            </div>

                            ${mine ? `
                                <div class="flex-shrink-0 ms-2">
                                    <img src="${avatar}" class="mol-msg-avatar" alt="">
                                </div>` : ''}
                        </div>
                    `;
                }).join('');
            }

            function MOLGetMessagePayloadFromRow(row) {
                return {
                    id: Number(row.dataset.messageId || 0),
                    mine: row.dataset.mine === '1',
                    content: row.dataset.content || '',
                    authorName: row.dataset.authorName || '',
                    type: row.dataset.type || 'text'
                };
            }

            async function MOLDeleteMessage(messageId, conversationId) {
                if (!messageId) return;

                const template = MOLGetMessageDeleteTemplate();
                const url = molUrl(template, messageId);

                try {
                    const res = await fetch(url, {
                        method: 'DELETE',
                        credentials: 'same-origin',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    if (!res.ok) {
                        throw new Error('HTTP ' + res.status);
                    }

                    await MOLChatRefreshBubble(conversationId);
                    if (typeof window.MOLChatRefreshList === 'function') {
                        await window.MOLChatRefreshList();
                    }
                } catch (e) {
                    console.error('delete message error', e);
                    alert("{% trans %}Impossible de supprimer le message.{% endtrans %}");
                }
            }

            function MOLBindMessageInteractions(conversationId) {
                const msgBox = document.getElementById(`molToastMsgs-${conversationId}`);
                if (!msgBox || msgBox.__msgInteractionsBound) return;

                msgBox.__msgInteractionsBound = true;

                msgBox.addEventListener('contextmenu', (e) => {
                    const row = e.target.closest('.mol-msg-row');
                    if (!row) return;

                    e.preventDefault();
                    MOLShowContextMenu(e.clientX, e.clientY, conversationId, MOLGetMessagePayloadFromRow(row));
                });

                msgBox.addEventListener('dblclick', (e) => {
                    const row = e.target.closest('.mol-msg-row');
                    if (!row) return;

                    MOLPrepareReply(conversationId, MOLGetMessagePayloadFromRow(row));
                });

                let touchState = null;

                msgBox.addEventListener('touchstart', (e) => {
                    const row = e.target.closest('.mol-msg-row');
                    if (!row) return;

                    touchState = {
                        row,
                        startX: e.changedTouches[0].clientX,
                        currentX: e.changedTouches[0].clientX
                    };
                }, { passive: true });

                msgBox.addEventListener('touchmove', (e) => {
                    if (!touchState?.row) return;

                    touchState.currentX = e.changedTouches[0].clientX;
                    const dx = Math.max(-90, Math.min(90, touchState.currentX - touchState.startX));

                    touchState.row.style.transform = `translateX(${dx}px)`;
                    touchState.row.classList.toggle('is-swiping-right', dx > 30);
                    touchState.row.classList.toggle('is-swiping-left', dx < -30);
                }, { passive: true });

                msgBox.addEventListener('touchend', async () => {
                    if (!touchState?.row) return;

                    const row = touchState.row;
                    const dx = Math.max(-90, Math.min(90, touchState.currentX - touchState.startX));
                    const message = MOLGetMessagePayloadFromRow(row);

                    row.style.transform = '';
                    row.classList.remove('is-swiping-right', 'is-swiping-left');

                    if (dx > 70) {
                        MOLPrepareReply(conversationId, message);
                    } else if (dx < -70 && message.mine) {
                        await MOLDeleteMessage(message.id, conversationId);
                    }

                    touchState = null;
                }, { passive: true });
            }

            async function MOLChatRefreshBubble(conversationId) {
                const msgBox = document.getElementById(`molToastMsgs-${conversationId}`);
                if (!msgBox) {
                    console.warn('[chat] msgBox introuvable pour', conversationId);
                    return;
                }

                try {
                    msgBox.innerHTML = `<div class="text-center small text-secondary my-2">{% trans %}Chargement...{% endtrans %}</div>`;
                    const data = await MOLChatFetchMessages(conversationId);
                    msgBox.innerHTML = MOLChatRenderBubbleMessages(data.items || []);
                    MOLBindMessageInteractions(conversationId);
                    msgBox.scrollTop = msgBox.scrollHeight;
                } catch (e) {
                    console.error('[chat] refresh bubble error', e);
                    msgBox.innerHTML = `<div class="text-center small text-danger my-2">{% trans %}Erreur chargement messages{% endtrans %}</div>`;
                }
            }

            function MOLIsProbablyMobile() {
                return /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent);
            }

            async function MOLHandleCameraClick(conversationId) {
                if (MOLIsProbablyMobile()) {
                    document.getElementById(`molCamera-${conversationId}`)?.click();
                    return;
                }

                await MOLOpenDesktopCamera(conversationId);
            }

            function MOLEnsureCameraOverlay() {
                let overlay = document.getElementById('molCameraOverlay');
                if (overlay) return overlay;

                document.body.insertAdjacentHTML('beforeend', `
                    <div id="molCameraOverlay" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.72);z-index:2147483647;align-items:center;justify-content:center;padding:20px;">
                        <div style="width:min(640px,100%);background:#fff;border-radius:20px;padding:14px;box-shadow:0 24px 60px rgba(15,23,42,.25);">
                            <video id="molCameraVideo" autoplay playsinline style="width:100%;border-radius:16px;background:#000;"></video>
                            <canvas id="molCameraCanvas" class="d-none"></canvas>
                            <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:12px;">
                                <button type="button" id="molCameraCloseBtn" class="btn btn-light">Fermer</button>
                                <button type="button" id="molCameraSnapBtn" class="btn btn-primary">Capturer</button>
                            </div>
                        </div>
                    </div>
                `);

                return document.getElementById('molCameraOverlay');
            }

            async function MOLOpenDesktopCamera(conversationId) {
                const overlay = MOLEnsureCameraOverlay();
                const video = document.getElementById('molCameraVideo');
                const closeBtn = document.getElementById('molCameraCloseBtn');
                const snapBtn = document.getElementById('molCameraSnapBtn');

                MOL_CAMERA_CONV_ID = conversationId;
                MOL_CAMERA_STREAM = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });

                video.srcObject = MOL_CAMERA_STREAM;
                overlay.style.display = 'flex';

                closeBtn.onclick = MOLCloseDesktopCamera;
                snapBtn.onclick = MOLCaptureDesktopCamera;
            }

            function MOLCloseDesktopCamera() {
                const overlay = document.getElementById('molCameraOverlay');
                const video = document.getElementById('molCameraVideo');

                if (MOL_CAMERA_STREAM) {
                    MOL_CAMERA_STREAM.getTracks().forEach(t => t.stop());
                    MOL_CAMERA_STREAM = null;
                }

                if (video) {
                    video.srcObject = null;
                }

                if (overlay) {
                    overlay.style.display = 'none';
                }
            }

            async function MOLCaptureDesktopCamera() {
                const video = document.getElementById('molCameraVideo');
                const canvas = document.getElementById('molCameraCanvas');

                if (!video || !canvas || !MOL_CAMERA_CONV_ID) return;

                canvas.width = video.videoWidth || 1280;
                canvas.height = video.videoHeight || 720;

                const ctx = canvas.getContext('2d');
                ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

                const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.92));
                if (!blob) return;

                const file = new File([blob], `camera-${Date.now()}.jpg`, { type: 'image/jpeg' });

                MOLCloseDesktopCamera();
                await MOLChatToastSendFile(MOL_CAMERA_CONV_ID, file);
            }

