            <style>

                .mol-call-btn{
                    min-width: 170px;
                    height: 52px;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    gap: 10px;
                    font-weight: 800;
                    border-radius: 999px;
                    box-shadow: 0 14px 35px rgba(0,0,0,.18);
                }

                .mol-call-btn i{
                    font-size: 1.1rem;
                    line-height: 1;
                }

                /* Icône téléphone qui vibre / sonne */
                .mol-ring-icon{
                    display: inline-block;
                    transform-origin: 50% 100%;
                    animation: mol-phone-ring 1s ease-in-out infinite;
                }

                .mol-vibrate-icon{
                    display: inline-block;
                    animation: mol-phone-vibrate .18s linear infinite;
                }

                @keyframes mol-phone-ring{
                    0%   { transform: rotate(0deg) scale(1); }
                    10%  { transform: rotate(18deg) scale(1.05); }
                    20%  { transform: rotate(-16deg) scale(1.05); }
                    30%  { transform: rotate(14deg) scale(1.05); }
                    40%  { transform: rotate(-12deg) scale(1.05); }
                    50%  { transform: rotate(10deg) scale(1.04); }
                    60%  { transform: rotate(-8deg) scale(1.03); }
                    70%  { transform: rotate(6deg) scale(1.02); }
                    80%  { transform: rotate(-4deg) scale(1.01); }
                    90%  { transform: rotate(2deg) scale(1.01); }
                    100% { transform: rotate(0deg) scale(1); }
                }

                @keyframes mol-phone-vibrate{
                    0%   { transform: translateX(0); }
                    25%  { transform: translateX(-1.5px); }
                    50%  { transform: translateX(1.5px); }
                    75%  { transform: translateX(-1.5px); }
                    100% { transform: translateX(0); }
                }

                /* petit effet premium */
                #molCallAcceptBtn:hover,
                #molCallDeclineBtn:hover,
                #molCallEndBtn:hover{
                    transform: translateY(-1px);
                }
            </style>
            
            <style>
                .mol-presence-dot{
                    position:absolute;
                    right:2px;
                    bottom:2px;
                    width:11px;
                    height:11px;
                    border-radius:999px;
                    border:2px solid #fff;
                    box-shadow: 0 0 0 2px rgba(255,255,255,.35);
                }

                .mol-presence-online{
                    background:#22c55e; /* vert */
                }

                .mol-presence-recently-offline{
                    background:#f59e0b; /* orange */
                }

                .mol-presence-offline{
                    background:#ef4444; /* rouge */
                }
                .mol-call-overlay{
                    position: fixed;
                    inset: 0;
                    z-index: 2147483647;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    padding: 20px;
                    background:
                        radial-gradient(900px circle at 20% 20%, rgba(59,130,246,.18), transparent 45%),
                        radial-gradient(900px circle at 80% 20%, rgba(16,185,129,.14), transparent 42%),
                        radial-gradient(900px circle at 50% 90%, rgba(236,72,153,.12), transparent 45%),
                        rgba(2,6,23,.58);
                    backdrop-filter: blur(18px);
                    -webkit-backdrop-filter: blur(18px);
                }

                .mol-call-overlay.d-none{
                    display: none !important;
                }

                .mol-call-shell{
                    width: min(1180px, 100%);
                    min-height: min(760px, calc(100vh - 40px));
                    border-radius: 30px;
                    overflow: hidden;
