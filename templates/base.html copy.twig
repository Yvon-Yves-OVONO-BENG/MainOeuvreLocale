                .mol-inline-audio,
                .mol-inline-file,
                .mol-inline-media{
                    margin-top: 6px;
                    width: 100%;
                }

                .mol-chat-audio{
                    display: block;
                    width: 100%;
                    max-width: 260px;
                    min-width: 220px;
                    height: 42px;
                    border-radius: 999px;
                    background: transparent;
                }

                .mol-inline-filebar{
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 8px;
                    margin-top: 6px;
