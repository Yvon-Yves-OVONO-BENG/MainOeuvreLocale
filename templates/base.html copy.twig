        // Affiche la conversation mobile et cache la liste
        async function MOLChatOpenConversationMobile(conv){
            const thread = MOLChatEnsureMobileThreadUI();
            if(!thread) return;

            const convId = Number(conv.id);

            const dropdown = thread.querySelector('.dropdown-menu');
            if (dropdown && !thread.__callBound) {
                thread.__callBound = true;

                dropdown.addEventListener('click', (e) => {
                    const currentConvId = Number(thread.dataset.conversationId || 0);

                    const callLink = e.target.closest('[data-call-type]');
                    if (callLink) {
                        e.preventDefault();
                        MOLStartConversationCall(currentConvId, callLink.dataset.callType);
                        return;
                    }

                    const actionLink = e.target.closest('[data-chat-action]');
                    if (actionLink) {
                        e.preventDefault();
                        MOLChatRunAction(e, currentConvId, actionLink.dataset.chatAction);
                    }
                });
            }

            const list = document.getElementById('molChatList');
            if(list) list.classList.add('d-none');

            const search = document.getElementById('molChatSearch')?.closest('.mol-chat-search-wrap') || document.getElementById('molChatSearch');
            if(search) search.classList.add('d-none');

            thread.classList.remove('d-none');
            thread.dataset.conversationId = String(convId);

            const avatar = MOLAbsUrl(conv.avatar || '');
            thread.querySelector('#molChatThreadAvatar').src = avatar;
            thread.querySelector('#molChatThreadName').textContent = conv.name || 'Conversation';
            thread.querySelector('#molChatThreadStatus').textContent =
                conv.presence === 'online'
                    ? 'En ligne'
                    : conv.presence === 'recently_offline'
                        ? 'Vient de se déconnecter'
                        : 'Hors ligne';

            const msgBox = thread.querySelector('#molChatThreadMsgs');
            msgBox.innerHTML = `<div class="text-center small text-secondary my-2">Chargement...</div>`;

            try{
                const data = await MOLChatFetchMessages(convId);
                msgBox.innerHTML = MOLChatRenderBubbleMessages(data.items || []);
                msgBox.scrollTop = msgBox.scrollHeight;
            }catch(e){
                console.error('[chat] mobile thread load error', e);
                msgBox.innerHTML = `<div class="text-center small text-danger my-2">Erreur chargement messages</div>`;
            }

            const input = thread.querySelector('#molChatThreadInput');
            const sendBtn = thread.querySelector('#molChatThreadSend');
            const likeBtn = thread.querySelector('#molChatThreadLikeBtn');
            const fileInput = thread.querySelector('#molChatThreadFile');
            const attachBtn = thread.querySelector('#molChatThreadAttachBtn');
            const cameraInput = thread.querySelector('#molChatThreadCamera');
            const cameraBtn = thread.querySelector('#molChatThreadCameraBtn');
            const micBtn = thread.querySelector('#molChatThreadMicBtn');

            function refreshMobileComposerState(){
                const hasContent = (input.value || '').replace(/\s/g, '').length > 0;
                likeBtn.classList.toggle('mol-hidden', hasContent);
                sendBtn.classList.toggle('mol-hidden', !hasContent);
            }

            if(!thread.__bound){
                thread.__bound = true;

                input.addEventListener('input', () => {
                    refreshMobileComposerState();
                    if (typeof MOLAutoResize === 'function') MOLAutoResize(input);
                    if (typeof MOLHandleTypingInput === 'function') {
                        const currentConvId = Number(thread.dataset.conversationId || 0);
                        if (currentConvId) MOLHandleTypingInput(currentConvId);
                    }
                });

                input.addEventListener('keydown', (ev) => {
                    if(ev.key === 'Enter' && !ev.shiftKey){
                        ev.preventDefault();
                        MOLChatMobileSend();
                    }
                });

                sendBtn.addEventListener('click', () => MOLChatMobileSend());

                likeBtn.addEventListener('click', async () => {
                    const currentConvId = Number(thread.dataset.conversationId || 0);
                    if (!currentConvId) return;
                    await MOLChatSendLike(currentConvId);
                });

                attachBtn.addEventListener('click', () => fileInput.click());

                fileInput.addEventListener('change', async () => {
                    const currentConvId = Number(thread.dataset.conversationId || 0);
                    const file = fileInput.files?.[0];
                    if (currentConvId && file) {
                        await MOLChatToastSendFile(currentConvId, file);
                    }
                    fileInput.value = '';
                });

                cameraBtn.addEventListener('click', () => cameraInput.click());

                cameraInput.addEventListener('change', async () => {
                    const currentConvId = Number(thread.dataset.conversationId || 0);
                    const file = cameraInput.files?.[0];
                    if (currentConvId && file) {
                        await MOLChatToastSendFile(currentConvId, file);
                    }
                    cameraInput.value = '';
                });

                micBtn.addEventListener('click', async () => {
                    const currentConvId = Number(thread.dataset.conversationId || 0);
                    if (!currentConvId) return;
                    await MOLChatToastToggleVoice(currentConvId);
                });
            }

            try{
                await MOLEnsureEmojiLib?.();
                const btn = thread.querySelector('#molChatThreadEmojiBtn');

                if(btn && window.EmojiButton){
                    if(!thread.__emojiPicker){
                        thread.__emojiPicker = new EmojiButton({
                            position: 'top-start',
                            autoHide: true,
                            theme: 'light',
                            rootElement: document.body,
                            zIndex: 2147483647
                        });

                        thread.__emojiPicker.on('emoji', (selection) => {
                            const val = selection.emoji || selection;
                            input.value = (input.value || '') + val;
                            input.dispatchEvent(new Event('input'));
                            input.focus();
                        });
                    }

                    btn.onclick = () => thread.__emojiPicker.togglePicker(btn);
                }
            }catch(e){
                console.warn('[emoji mobile]', e);
            }

            refreshMobileComposerState();

            setTimeout(() => {
                if (typeof MOLAutoResize === 'function') MOLAutoResize(input);
                input?.focus();
            }, 120);

            MOLInitMercure?.(convId);
        }

        // Ferme conversation mobile et revient à la liste
        function MOLChatCloseConversationMobile(){
            const panel = document.getElementById('molChatPanel');
            if(!panel) return;

            const thread = panel.querySelector('#molChatThread');
            if(thread) thread.classList.add('d-none');

            const list = document.getElementById('molChatList');
            if(list) list.classList.remove('d-none');

            const search = document.getElementById('molChatSearch')?.closest('.mol-chat-search-wrap') || document.getElementById('molChatSearch');
            if(search) search.classList.remove('d-none');
        }

        // Envoi message depuis la vue mobile (sans casser ton send existant)
        async function MOLChatMobileSend(){
            const panel = document.getElementById('molChatPanel');
            const thread = panel?.querySelector('#molChatThread');
            if(!thread) return;

            const convId = Number(thread.dataset.conversationId || 0);
            if(!convId) return;

            const input = thread.querySelector('#molChatThreadInput');
            const sendBtn = thread.querySelector('#molChatThreadSend');
            const likeBtn = thread.querySelector('#molChatThreadLikeBtn');
            const content = (input?.value || '').trim();
            if(!content) return;

            input.disabled = true;
            sendBtn.disabled = true;

            try{
                const url = molUrl(window.MOL_CHAT.urls.send, convId);
                const res = await fetch(url, {
                    method:'POST',
                    headers:{
                        'Content-Type':'application/json',
                        'X-Requested-With':'XMLHttpRequest'
                    },
                    body: JSON.stringify({ content })
                });

                if(!res.ok) throw new Error('HTTP '+res.status);

                input.value = '';
                if (typeof MOLAutoResize === 'function') MOLAutoResize(input);

                likeBtn.classList.remove('mol-hidden');
                sendBtn.classList.add('mol-hidden');

                const msgBox = thread.querySelector('#molChatThreadMsgs');
                const data = await MOLChatFetchMessages(convId);
                msgBox.innerHTML = MOLChatRenderBubbleMessages(data.items || []);
                msgBox.scrollTop = msgBox.scrollHeight;

                MOLOnNewMessage?.(convId);
                MOLChatRefreshList?.(document.getElementById('molChatSearch')?.value?.trim() || '');

            }catch(e){
                alert("Erreur réseau: impossible d’envoyer.");
            }finally{
                input.disabled = false;
                sendBtn.disabled = false;
                input.focus();
            }
        }


        async function MOLChatConversationAction(conversationId, action, payload = {}) {
            if (!window.MOL_CHAT?.urls?.[action]) {
                throw new Error('Action inconnue: ' + action);
            }

            const url = molUrl(window.MOL_CHAT.urls[action], conversationId);

            const res = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(payload)
            });

            const data = await res.json().catch(() => ({}));

            if (!res.ok || !data.ok) {
                throw new Error(data.message || ('HTTP ' + res.status));
            }

            return data;
        }

        function MOLChatToastNotice(message) {
            if (!message) return;
            console.log('[chat]', message);
        }

        async function MOLChatRunAction(event, conversationId, action) {
            event.preventDefault();

            try {
                let payload = {};

                if (action === 'report') {
                    const reason = window.prompt("Entrez la raison du signalement :");
                    if (reason === null) {
                        return false;
                    }
                    payload.reason = reason;
                }

                const data = await MOLChatConversationAction(conversationId, action, payload);

                MOLChatToastNotice(data.message || 'Action effectuée.');

                if (action === 'deleteConversation') {
                    const toast = document.getElementById(`molToast-${conversationId}`);
                    if (toast) {
                        toast.remove();
                    }
                    await MOLChatRefreshList();
                    return false;
                }

                await MOLChatRefreshBubble(conversationId);
                await MOLChatRefreshList();

                return false;
            } catch (e) {
                console.error(e);
                alert(e.message || "Une erreur est survenue.");
                return false;
            }
        }

    </script>

    <script>
    
        (function(){
        const dds = () => Array.from(document.querySelectorAll('[data-mol-dd]'));

        function closeAll(except = null){
            dds().forEach(dd => {
            if(except && dd === except) return;
            dd.classList.remove('is-open');
            const btn = dd.querySelector('[data-mol-dd-btn]');
            if(btn) btn.setAttribute('aria-expanded', 'false');
            });
        }

        // Toggle au click (utile sur mobile; desktop hover reste OK)
        document.addEventListener('click', (e) => {
            const btn = e.target.closest('[data-mol-dd-btn]');
            const dd  = e.target.closest('[data-mol-dd]');

            // clic sur un bouton dropdown
            if(btn && dd){
            e.preventDefault();

            const isOpen = dd.classList.contains('is-open');

            // ferme les autres d'abord
            closeAll(dd);

            // retap => ferme, sinon ouvre
            if(isOpen){
                dd.classList.remove('is-open');
                btn.setAttribute('aria-expanded', 'false');
            }else{
                dd.classList.add('is-open');
                btn.setAttribute('aria-expanded', 'true');
            }
            return;
            }

            // clic sur un item qui doit fermer
            if(e.target.closest('[data-mol-dd-close]')){
            closeAll();
            return;
            }

            // clic ailleurs => ferme
            if(!dd){
            closeAll();
            }
        });

        // ESC => ferme
        document.addEventListener('keydown', (e) => {
            if(e.key === 'Escape') closeAll();
        });

        // Option : quand tu changes d’orientation / resize => ferme
        window.addEventListener('resize', () => closeAll());
        })();
    </script>

    
    <script>
        /* =========================================================
        MOBILE KEYBOARD FIX (Messenger-like)
        - Remonte la zone de saisie au-dessus du clavier
        - Scrolle la conversation vers le bas quand focus
        ========================================================= */
        (function(){
        function setKbOffset(px){
            document.documentElement.style.setProperty('--mol-kb', (px > 0 ? px : 0) + 'px');
        }

        function computeKb(){
            // VisualViewport = le meilleur signal sur mobile
            if(window.visualViewport){
            const vv = window.visualViewport;

            // Diff entre la fenêtre "layout" et la fenêtre visible (clavier)
            const diff = Math.max(0, window.innerHeight - vv.height - vv.offsetTop);
            setKbOffset(diff);
            return;
            }

            // Fallback simple (moins précis)
            setKbOffset(0);
        }

        function scrollThreadToBottom(){
            const panel = document.getElementById('molChatPanel');
            const thread = panel?.querySelector('#molChatThread');
            const msgBox = thread?.querySelector('#molChatThreadMsgs');
            if(msgBox){
            msgBox.scrollTop = msgBox.scrollHeight;
            }
        }

        // Update quand clavier change
        if(window.visualViewport){
            window.visualViewport.addEventListener('resize', () => {
            computeKb();
            // petit délai pour laisser le layout se stabiliser
            setTimeout(scrollThreadToBottom, 50);
            });
            window.visualViewport.addEventListener('scroll', () => {
            computeKb();
            });
        }

        window.addEventListener('orientationchange', () => {
            setTimeout(() => { computeKb(); scrollThreadToBottom(); }, 250);
        });

        // Focus: remonter + scroll bas (comme Messenger)
        document.addEventListener('focusin', (e) => {
            const ta = e.target.closest('#molChatThreadInput, [id^="molToastInput-"]');
            if(!ta) return;

            computeKb();

            // Scroll bas (mobile thread)
            setTimeout(scrollThreadToBottom, 60);

            // Assure que l'input est visible
            setTimeout(() => {
            try{ ta.scrollIntoView({ block:'end', behavior:'smooth' }); }catch(_){}
            }, 80);
        });

        document.addEventListener('focusout', (e) => {
            const ta = e.target.closest('#molChatThreadInput, [id^="molToastInput-"]');
            if(!ta) return;
            // quand on ferme le clavier
            setTimeout(() => setKbOffset(0), 120);
        });

        // Init
        document.addEventListener('DOMContentLoaded', computeKb);
        })();
    </script>

    <script>
        /* =========================================================
        Topbar height -> CSS var (--mol-topbar-h)
        Pour que le panel chat commence juste en dessous
        ========================================================= */
        (function(){
        function getTopbarEl(){
            // Ta topbar premium:
            return document.querySelector('.mol-topbar');
        }

        function applyTopbarHeight(){
            const topbar = getTopbarEl();
            const h = topbar ? Math.ceil(topbar.getBoundingClientRect().height) : 0;
            document.documentElement.style.setProperty('--mol-topbar-h', h + 'px');
        }

        window.addEventListener('load', applyTopbarHeight);
        window.addEventListener('resize', applyTopbarHeight);
        window.addEventListener('orientationchange', () => setTimeout(applyTopbarHeight, 250));

        // Si la topbar change de hauteur (dropdown, responsive, etc.)
        if(window.ResizeObserver){
            const topbar = getTopbarEl();
            if(topbar){
            const ro = new ResizeObserver(() => applyTopbarHeight());
            ro.observe(topbar);
            }
        }

        document.addEventListener('DOMContentLoaded', applyTopbarHeight);
        })();
    </script>


    <script>
        (function () {
        function portalDropdown(toggleEl) {
            const menu = toggleEl.parentElement?.querySelector('.dropdown-menu');
            if (!menu) return;

            // Si déjà porté, ne pas refaire
            if (menu.dataset.portal === "1") return;

            menu.dataset.portal = "1";
            menu.__originalParent = menu.parentElement;
            menu.__nextSibling = menu.nextSibling;

            // Met le menu dans body pour éviter tous les overflow cachés
            document.body.appendChild(menu);

            // Style pour être au-dessus de tout
            menu.style.position = 'fixed';
            menu.style.zIndex = '99999';
            menu.style.display = 'block'; // Bootstrap gère aussi via .show

            function place() {
            const r = toggleEl.getBoundingClientRect();
            // dropdown-menu-end => aligner à droite du bouton
            const left = Math.max(8, r.right - menu.offsetWidth);
            const top = r.bottom + 8;

            menu.style.left = left + 'px';
            menu.style.top = top + 'px';
            }

            menu.__place = place;
            place();

            // Reposition si scroll/resize
            window.addEventListener('scroll', place, true);
            window.addEventListener('resize', place, true);
        }

        function unportalDropdown(toggleEl) {
            const menu = document.querySelector('.dropdown-menu[data-portal="1"].show');
            // On essaye de retrouver celui du toggle
            const m = toggleEl.parentElement?.querySelector('.dropdown-menu');
            const menuEl = m && m.dataset.portal === "1" ? m : menu;
            if (!menuEl || menuEl.dataset.portal !== "1") return;

            window.removeEventListener('scroll', menuEl.__place, true);
            window.removeEventListener('resize', menuEl.__place, true);

            // Remettre dans son parent d'origine
            if (menuEl.__originalParent) {
            if (menuEl.__nextSibling) menuEl.__originalParent.insertBefore(menuEl, menuEl.__nextSibling);
            else menuEl.__originalParent.appendChild(menuEl);
            }

            menuEl.style.position = '';
            menuEl.style.left = '';
            menuEl.style.top = '';
            menuEl.style.zIndex = '';
            menuEl.style.display = '';
            delete menuEl.dataset.portal;
        }

        document.addEventListener('shown.bs.dropdown', function (e) {
            // e.target = toggle
            portalDropdown(e.target);
        });

        document.addEventListener('hide.bs.dropdown', function (e) {
            unportalDropdown(e.target);
        });
        })();
    </script>

    <script>
        (() => {
            if (window.__MOL_CALL_PREMIUM_BOOTED__) return;
            window.__MOL_CALL_PREMIUM_BOOTED__ = true;

            const CALL = {
                current: null,
                peer: null,
                localStream: null,
                remoteStream: null,
                mercureIncoming: null,
                mercureCall: null,
                isMuted: false,
                isCameraEnabled: true,
                isSpeakerOn: false,
                currentFacingMode: 'user',
                timerInterval: null,
                startedAt: null,
            };

            function qs(id) {
                return document.getElementById(id);
            }

            function urlTpl(tpl, key, value) {
                return String(tpl).replace(key, String(value));
            }

            function callUrl(name, value, placeholder) {
                return urlTpl(window.MOL_CALL.urls[name], placeholder, value);
            }

            function callOverlayOpen() {
                const el = qs('molCallOverlay');
                if (!el) return;
                el.classList.remove('d-none');
                document.body.style.overflow = 'hidden';
            }

            function callOverlayClose() {
                const el = qs('molCallOverlay');
                if (!el) return;
                el.classList.add('d-none');
                document.body.style.overflow = '';
            }

            function formatDuration(sec) {
                const s = Math.max(0, sec | 0);
                const mm = String(Math.floor(s / 60)).padStart(2, '0');
                const ss = String(s % 60).padStart(2, '0');
                return `${mm}:${ss}`;
            }

            function startTimer() {
                stopTimer();
                CALL.startedAt = Date.now();
                qs('molCallTimer').textContent = '00:00';

                CALL.timerInterval = setInterval(() => {
                    const diff = Math.floor((Date.now() - CALL.startedAt) / 1000);
                    qs('molCallTimer').textContent = formatDuration(diff);
                }, 1000);
            }

            function stopTimer() {
                if (CALL.timerInterval) {
                    clearInterval(CALL.timerInterval);
                    CALL.timerInterval = null;
                }
                qs('molCallTimer').textContent = '00:00';
            }

            function setTypeUi(type) {
                const isVideo = type === 'video';
                qs('molCallTypeText').textContent = isVideo ? 'Appel vidéo' : 'Appel audio';
                qs('molCallTypeIcon').className = isVideo ? 'bi bi-camera-video-fill' : 'bi bi-telephone-fill';
                qs('molCallCenterIcon').className = isVideo ? 'bi bi-camera-video-fill' : 'bi bi-telephone-fill';
            }

            function setStatus(text, sub = '') {
                if (qs('molCallStatus')) qs('molCallStatus').textContent = text || '';
                if (qs('molCallTopStatus')) qs('molCallTopStatus').textContent = text || '';
                if (qs('molCallSubStatus')) qs('molCallSubStatus').textContent = sub || '';
            }

            function setCallerUi({ name = 'Appel', avatar = '/uploads/profiles/avatar.png' } = {}) {
                if (qs('molCallName')) qs('molCallName').textContent = name;
                if (qs('molCallTopName')) qs('molCallTopName').textContent = name;
                if (qs('molCallAvatar')) qs('molCallAvatar').src = avatar;
                if (qs('molCallAvatarTop')) qs('molCallAvatarTop').src = avatar;
            }

            function setPhase(phase) {
                const acceptBtn = qs('molCallAcceptBtn');
                const declineBtn = qs('molCallDeclineBtn');
                const endBtn = qs('molCallEndBtn');

                const secondary = [
                    qs('molCallMuteBtn'),
                    qs('molCallSpeakerBtn'),
                    qs('molCallVideoToggleBtn'),
                    qs('molCallSwitchCameraBtn'),
                    qs('molCallFullscreenBtn'),
                    qs('molCallPipBtn')
                ];

                if (acceptBtn) acceptBtn.style.display = phase === 'incoming' ? '' : 'none';
                if (declineBtn) declineBtn.style.display = (phase === 'incoming' || phase === 'outgoing') ? '' : 'none';
                if (endBtn) endBtn.style.display = phase === 'incall' ? '' : 'none';

                secondary.forEach(btn => {
                    if (!btn) return;
                    btn.disabled = phase !== 'incall';
                });

                const isVideo = CALL.current?.type === 'video';
                if (qs('molCallVideoToggleBtn')) qs('molCallVideoToggleBtn').disabled = phase !== 'incall' || !isVideo;
                if (qs('molCallSwitchCameraBtn')) qs('molCallSwitchCameraBtn').disabled = phase !== 'incall' || !isVideo;
                updateToolStates();
            }

            function updateMiniStates() {
                qs('molCallMiniMic').textContent = CALL.isMuted ? 'Coupé' : 'Actif';
                qs('molCallMiniCam').textContent = CALL.isCameraEnabled ? 'Active' : 'Désactivée';
                qs('molCallMiniSpeaker').textContent = CALL.isSpeakerOn ? 'Amplifiée' : 'Normale';
                qs('molCallMiniFacing').textContent = CALL.currentFacingMode === 'user' ? 'Frontale' : 'Dorsale';
            }

            function updateToolStates() {
                const muteBtn = qs('molCallMuteBtn');
                const speakerBtn = qs('molCallSpeakerBtn');
                const videoBtn = qs('molCallVideoToggleBtn');

                if (muteBtn) {
                    muteBtn.classList.toggle('is-muted', CALL.isMuted);
                    muteBtn.innerHTML = CALL.isMuted
                        ? '<i class="bi bi-mic-mute-fill"></i>'
                        : '<i class="bi bi-mic-fill"></i>';
                }

                if (speakerBtn) {
                    speakerBtn.classList.toggle('is-active', CALL.isSpeakerOn);
                    speakerBtn.innerHTML = CALL.isSpeakerOn
                        ? '<i class="bi bi-volume-up-fill"></i>'
                        : '<i class="bi bi-volume-down-fill"></i>';
                }

                if (videoBtn) {
                    videoBtn.classList.toggle('is-muted', !CALL.isCameraEnabled);
                    videoBtn.innerHTML = CALL.isCameraEnabled
                        ? '<i class="bi bi-camera-video-fill"></i>'
                        : '<i class="bi bi-camera-video-off-fill"></i>';
                }

                updateMiniStates();
            }

            async function ensureLocalMedia(isVideo) {
                if (CALL.localStream) {
                    const hasAudio = CALL.localStream.getAudioTracks().length > 0;
                    const hasVideo = CALL.localStream.getVideoTracks().length > 0;

                    if (hasAudio && (!isVideo || hasVideo)) {
                        return CALL.localStream;
                    }
                }

                if (CALL.localStream) {
                    CALL.localStream.getTracks().forEach(track => track.stop());
                    CALL.localStream = null;
                }

                CALL.localStream = await navigator.mediaDevices.getUserMedia({
                    audio: true,
                    video: isVideo ? { facingMode: { ideal: CALL.currentFacingMode } } : false
                });

                qs('molLocalVideo').srcObject = CALL.localStream;

                CALL.isMuted = false;
                CALL.isCameraEnabled = isVideo ? true : false;
                updateToolStates();

                return CALL.localStream;
            }

            function createPeer(callId, isVideo) {
                if (CALL.peer) {
                    CALL.peer.close();
                    CALL.peer = null;
                }

                const pc = new RTCPeerConnection({
                    iceServers: [{ urls: 'stun:stun.l.google.com:19302' }]
                });

                pc.onicecandidate = async (event) => {
                    if (!event.candidate) return;

                    await fetch(callUrl('signal', callId, '__CALL__'), {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({
                            type: 'candidate',
                            data: event.candidate
                        })
                    });
                };

                pc.ontrack = (event) => {
                    const [stream] = event.streams;
                    if (stream) {
                        CALL.remoteStream = stream;
                        qs('molRemoteVideo').srcObject = stream;
                    }
                };

                pc.onconnectionstatechange = () => {
                    const state = pc.connectionState;
                    if (state === 'connected') {
                        setStatus('Appel en cours', 'Connexion établie');
                        startTimer();
                        setPhase('incall');
                    } else if (state === 'connecting') {
                        setStatus('Connexion en cours...', 'Établissement de la liaison');
                    } else if (state === 'failed' || state === 'disconnected' || state === 'closed') {
                        setStatus('Appel terminé', 'Connexion fermée');
                    }
                };

                CALL.peer = pc;
                return pc;
            }

            async function attachLocalTracks(pc, stream) {
                const senders = pc.getSenders();
                stream.getTracks().forEach(track => {
                    const exists = senders.find(sender => sender.track && sender.track.id === track.id);
                    if (!exists) {
                        pc.addTrack(track, stream);
                    }
                });
            }

            async function switchCamera() {
                if (!CALL.current || CALL.current.type !== 'video') return;

                try {
                    CALL.currentFacingMode = CALL.currentFacingMode === 'user' ? 'environment' : 'user';

                    const fresh = await navigator.mediaDevices.getUserMedia({
                        audio: false,
                        video: { facingMode: { ideal: CALL.currentFacingMode } }
                    });

                    const newTrack = fresh.getVideoTracks()[0];
                    if (!newTrack) return;

                    const oldTrack = CALL.localStream?.getVideoTracks()[0];
                    if (CALL.peer) {
                        const sender = CALL.peer.getSenders().find(s => s.track && s.track.kind === 'video');
                        if (sender) {
                            await sender.replaceTrack(newTrack);
                        }
                    }

                    if (CALL.localStream) {
                        if (oldTrack) {
                            CALL.localStream.removeTrack(oldTrack);
                            oldTrack.stop();
                        }
                        CALL.localStream.addTrack(newTrack);
                        qs('molLocalVideo').srcObject = CALL.localStream;
                    } else {
                        CALL.localStream = fresh;
                        qs('molLocalVideo').srcObject = fresh;
                    }

                    CALL.isCameraEnabled = true;
                    updateToolStates();
                    setStatus('Caméra changée', CALL.currentFacingMode === 'user' ? 'Caméra frontale activée' : 'Caméra dorsale activée');
                } catch (e) {
                    console.warn('Impossible de changer de caméra', e);
                    setStatus('Caméra inchangée', 'Le navigateur ou le téléphone a refusé le changement');
                }
            }

            async function toggleCamera() {
                if (!CALL.current || CALL.current.type !== 'video') return;

                const track = CALL.localStream?.getVideoTracks()?.[0];
                if (!track) return;

                CALL.isCameraEnabled = !CALL.isCameraEnabled;
                track.enabled = CALL.isCameraEnabled;
                updateToolStates();

                setStatus(
                    CALL.isCameraEnabled ? 'Caméra activée' : 'Caméra désactivée',
                    CALL.isCameraEnabled ? 'Votre vidéo est visible' : 'Votre vidéo est masquée'
                );
            }

            function toggleMute() {
                const track = CALL.localStream?.getAudioTracks()?.[0];
                if (!track) return;

                CALL.isMuted = !CALL.isMuted;
                track.enabled = !CALL.isMuted;
                updateToolStates();

                setStatus(
                    CALL.isMuted ? 'Micro coupé' : 'Micro activé',
                    CALL.isMuted ? 'Votre interlocuteur ne vous entend plus' : 'Votre micro est actif'
                );
            }

            async function toggleSpeaker() {
                CALL.isSpeakerOn = !CALL.isSpeakerOn;
                const remote = qs('molRemoteVideo');

                try {
                    if (remote && typeof remote.setSinkId === 'function') {
                        await remote.setSinkId('default');
                    }
                } catch (e) {
                    console.warn('Sortie audio non pilotable sur ce navigateur', e);
                }

                if (remote) {
                    remote.volume = CALL.isSpeakerOn ? 1 : 0.85;
                }

                updateToolStates();
                setStatus(
                    CALL.isSpeakerOn ? 'Haut-parleur activé' : 'Haut-parleur normal',
                    'Le routage audio final dépend du navigateur et du téléphone'
                );
            }

            async function toggleFullscreen() {
                const shell = qs('molCallOverlay');
                if (!shell) return;

                try {
                    if (!document.fullscreenElement) {
                        await shell.requestFullscreen();
                    } else {
                        await document.exitFullscreen();
                    }
                } catch (e) {
                    console.warn('Fullscreen indisponible', e);
                }
            }

            async function togglePip() {
                const video = qs('molRemoteVideo');
                if (!video || !document.pictureInPictureEnabled) return;

                try {
                    if (document.pictureInPictureElement) {
                        await document.exitPictureInPicture();
                    } else {
                        await video.requestPictureInPicture();
                    }
                } catch (e) {
                    console.warn('PiP indisponible', e);
                }
            }

            function resetVideos() {
                if (qs('molLocalVideo')) qs('molLocalVideo').srcObject = null;
                if (qs('molRemoteVideo')) qs('molRemoteVideo').srcObject = null;
            }

            function getConversationUiMeta(conversationId) {
                const item = document.querySelector(`.mol-chat-item[data-id="${conversationId}"]`);
                if (item) {
                    return {
                        name: item.dataset.name || 'Conversation',
                        avatar: item.dataset.avatar || '/uploads/profiles/avatar.png'
                    };
                }

                const toast = qs(`molToast-${conversationId}`);
                if (toast) {
                    const img = toast.querySelector('img');
                    const name = toast.querySelector('.fw-bold')?.textContent?.trim() || 'Conversation';
                    return {
                        name,
                        avatar: img?.src || '/uploads/profiles/avatar.png'
                    };
                }

                return {
                    name: 'Conversation',
                    avatar: '/uploads/profiles/avatar.png'
                };
            }

            async function subscribeCallTopic(callId) {
                if (CALL.mercureCall) {
                    CALL.mercureCall.close();
                    CALL.mercureCall = null;
                }

                const url = new URL(window.MOL_CALL.mercureHub);
                url.searchParams.set('topic', `/chat/call/${callId}`);

                CALL.mercureCall = new EventSource(url.toString());

                CALL.mercureCall.onmessage = async (event) => {
                    const payload = JSON.parse(event.data);
                    if (!CALL.current || CALL.current.id !== payload.callId) return;

                    if (payload.event === 'accepted') {
                        setStatus('Appel accepté', 'Initialisation WebRTC');
                        setPhase('incall');

                        if (CALL.current.role === 'caller') {
                            const isVideo = CALL.current.type === 'video';
                            const stream = await ensureLocalMedia(isVideo);
                            const pc = createPeer(CALL.current.id, isVideo);
                            await attachLocalTracks(pc, stream);

                            const offer = await pc.createOffer();
                            await pc.setLocalDescription(offer);

                            await fetch(callUrl('signal', CALL.current.id, '__CALL__'), {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'X-Requested-With': 'XMLHttpRequest'
                                },
                                body: JSON.stringify({
                                    type: 'offer',
                                    data: offer
                                })
                            });
                        }

                        return;
                    }

                    if (payload.event === 'declined') {
                        setStatus('Appel refusé', 'Votre correspondant a refusé l’appel');
                        setTimeout(() => cleanupCall(true), 900);
                        return;
                    }

                    if (payload.event === 'ended') {
                        setStatus('Appel terminé', 'La communication a été fermée');
                        setTimeout(() => cleanupCall(true), 600);
                        return;
                    }

                    if (payload.event === 'signal') {
                        if (payload.fromUserId === window.MOL_CALL.meId) return;

                        const pc = CALL.peer || createPeer(CALL.current.id, CALL.current.type === 'video');

                        if (payload.signalType === 'offer') {
                            const isVideo = CALL.current.type === 'video';
                            const stream = await ensureLocalMedia(isVideo);
                            await attachLocalTracks(pc, stream);

                            await pc.setRemoteDescription(new RTCSessionDescription(payload.data));
                            const answer = await pc.createAnswer();
                            await pc.setLocalDescription(answer);

                            await fetch(callUrl('signal', CALL.current.id, '__CALL__'), {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'X-Requested-With': 'XMLHttpRequest'
                                },
                                body: JSON.stringify({
                                    type: 'answer',
                                    data: answer
                                })
                            });

                            setStatus('Connexion en cours...', 'Réponse envoyée');
                            setPhase('incall');
                            return;
                        }

                        if (payload.signalType === 'answer') {
                            await pc.setRemoteDescription(new RTCSessionDescription(payload.data));
                            setStatus('Connexion établie', 'Appel en cours');
                            startTimer();
                            return;
                        }

                        if (payload.signalType === 'candidate' && payload.data) {
                            try {
                                await pc.addIceCandidate(new RTCIceCandidate(payload.data));
                            } catch (e) {
                                console.warn('ICE candidate ignoré', e);
                            }
                        }
                    }
                };

                CALL.mercureCall.onerror = (e) => {
                    console.warn('[CALL] erreur topic appel', e);
                };
            }

            async function startConversationCall(conversationId, type) {
                try {
                    const ui = getConversationUiMeta(conversationId);

                    setCallerUi(ui);
                    setTypeUi(type);
                    setStatus(
                        type === 'video' ? 'Appel vidéo en cours de sonnerie...' : 'Appel audio en cours de sonnerie...',
                        'Notification de l’autre participant...'
                    );
                    setPhase('outgoing');
                    callOverlayOpen();

                    const res = await fetch(callUrl('start', conversationId, '__CONV__'), {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({ type })
                    });

                    const data = await res.json();

                    if (!res.ok || !data.ok) {
                        callOverlayClose();
                        alert(data.error || "Impossible de démarrer l'appel.");
                        return;
                    }

                    CALL.current = {
                        id: data.callId,
                        conversationId,
                        type,
                        role: 'caller'
                    };

                    await subscribeCallTopic(data.callId);
                } catch (e) {
                    console.error('Erreur startConversationCall:', e);
                    callOverlayClose();
                    alert("Erreur lors du lancement de l'appel.");
                }
            }

            async function acceptIncomingCall() {
                if (!CALL.current) return;

                try {
                    const res = await fetch(callUrl('accept', CALL.current.id, '__CALL__'), {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const data = await res.json();
                    if (!res.ok || !data.ok) {
                        alert("Impossible d'accepter l'appel.");
                        return;
                    }

                    await subscribeCallTopic(CALL.current.id);
                    setStatus('Appel accepté', 'Connexion en cours...');
                    setPhase('incall');
                } catch (e) {
                    console.error(e);
                    alert("Erreur lors de l’acceptation.");
                }
            }

            async function declineIncomingCall() {
                if (!CALL.current) return;

                try {
                    await fetch(callUrl('decline', CALL.current.id, '__CALL__'), {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                } catch (e) {
                    console.warn(e);
                }

                cleanupCall(true);
            }

            async function endCurrentCall() {
                if (!CALL.current) return;

                try {
                    await fetch(callUrl('end', CALL.current.id, '__CALL__'), {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                } catch (e) {
                    console.warn(e);
                }

                cleanupCall(true);
            }

            function cleanupCall(hideOverlay = true) {
                if (CALL.peer) {
                    CALL.peer.close();
                    CALL.peer = null;
                }

                if (CALL.localStream) {
                    CALL.localStream.getTracks().forEach(track => track.stop());
                    CALL.localStream = null;
                }

                if (CALL.remoteStream) {
                    CALL.remoteStream.getTracks().forEach(track => track.stop());
                    CALL.remoteStream = null;
                }

                if (CALL.mercureCall) {
                    CALL.mercureCall.close();
                    CALL.mercureCall = null;
                }

                CALL.current = null;
                CALL.isMuted = false;
                CALL.isCameraEnabled = true;
                CALL.isSpeakerOn = false;
                CALL.currentFacingMode = 'user';

                stopTimer();
                resetVideos();
                updateToolStates();
                setPhase('idle');
                setStatus('En attente...', 'Prêt pour un nouvel appel');
                setCallerUi({ name: 'Appel', avatar: '/uploads/profiles/avatar.png' });
                setTypeUi('audio');

                if (hideOverlay) {
                    callOverlayClose();
                }
            }

            function subscribeIncomingCalls() {
                if (!window.MOL_CALL?.meId || !window.MOL_CALL?.mercureHub) {
                    console.warn('[CALL] abonnement impossible', window.MOL_CALL);
                    return;
                }

                if (CALL.mercureIncoming) {
                    CALL.mercureIncoming.close();
                    CALL.mercureIncoming = null;
                }

                const url = new URL(window.MOL_CALL.mercureHub);
                url.searchParams.set('topic', `/chat/user/${window.MOL_CALL.meId}/incoming-call`);

                CALL.mercureIncoming = new EventSource(url.toString());

                CALL.mercureIncoming.onopen = () => {
                    console.log('[CALL] connecté incoming-call');
                };

                CALL.mercureIncoming.onmessage = (event) => {
                    const payload = JSON.parse(event.data);
                    if (payload.event !== 'incoming_call') return;

                    CALL.current = {
                        id: payload.callId,
                        conversationId: payload.conversationId,
                        type: payload.type,
                        role: 'callee'
                    };

                    setCallerUi({
                        name: payload.fromName || 'Appel entrant',
                        avatar: payload.fromAvatar || '/uploads/profiles/avatar.png'
                    });

                    setTypeUi(payload.type || 'audio');
                    setStatus(
                        payload.type === 'video' ? 'Appel vidéo entrant...' : 'Appel audio entrant...',
                        'Décrochez ou refusez'
                    );
                    setPhase('incoming');
                    callOverlayOpen();
                };

                CALL.mercureIncoming.onerror = (e) => {
                    console.warn('[CALL] erreur incoming-call', e);
                };
            }

            function bindUi() {
                qs('molCallAcceptBtn')?.addEventListener('click', acceptIncomingCall);
                qs('molCallDeclineBtn')?.addEventListener('click', declineIncomingCall);
                qs('molCallEndBtn')?.addEventListener('click', endCurrentCall);
                qs('molCallCloseBtn')?.addEventListener('click', endCurrentCall);

                qs('molCallMuteBtn')?.addEventListener('click', toggleMute);
                qs('molCallSpeakerBtn')?.addEventListener('click', toggleSpeaker);
                qs('molCallVideoToggleBtn')?.addEventListener('click', toggleCamera);
                qs('molCallSwitchCameraBtn')?.addEventListener('click', switchCamera);
                qs('molCallFullscreenBtn')?.addEventListener('click', toggleFullscreen);
                qs('molCallPipBtn')?.addEventListener('click', togglePip);
            }

            document.addEventListener('DOMContentLoaded', () => {
                bindUi();
                updateToolStates();
                setPhase('idle');
                subscribeIncomingCalls();
            });

            window.MOLStartConversationCall = startConversationCall;
        })();
    </script>

    <div id="molCallOverlay" class="mol-call-overlay d-none">
