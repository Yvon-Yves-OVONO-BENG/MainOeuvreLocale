	{# JS : ouvre/ferme panel (et ne montre aucune bubble au chargement) #}
	<script>

        // ---------- Panel open/close ----------
        window.MOLChatOpen = async function () {
            const panel = document.getElementById('molChatPanel');
            if (!panel) return;

            panel.classList.add('is-open');
            panel.setAttribute('aria-hidden', 'false');

            // charge la liste au moment où tu ouvres
            await MOLChatRefreshList(document.getElementById('molChatSearch')?.value?.trim() || '');
        };

        window.MOLChatClose = function () {
            const panel = document.getElementById('molChatPanel');
            if (!panel) return;

            panel.classList.remove('is-open');
            panel.setAttribute('aria-hidden', 'true');
        };
	
    </script>

    <script>
        (() => {
            if (window.__MOL_CHAT_UI_BOOTED__) {
                console.warn('MOL chat UI déjà initialisé');
                return;
            }
            window.__MOL_CHAT_UI_BOOTED__ = true;

            window.__MOL_EMOJI_LOADING__ = window.__MOL_EMOJI_LOADING__ || null;

            const MOL_REPLY_STATE = {};
            const MOL_VOICE_RECORDERS = {};
            let MOL_ACTIVE_CONTEXT = null;
            let MOL_REACTION_PICKER = null;
            let MOL_REACTION_PICKER_READY = false;
            let MOL_CAMERA_STREAM = null;
            let MOL_CAMERA_CONV_ID = null;

            function debounce(fn, wait = 250) {
                let t;
                return (...args) => {
                    clearTimeout(t);
                    t = setTimeout(() => fn(...args), wait);
                };
            }

            function escapeHtml(s) {
                return String(s ?? '')
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;')
                    .replaceAll("'", '&#039;');
            }

            function formatTime(str) {
                if (!str) return '';
                const m = String(str).match(/(\d{2}):(\d{2})/);
                return m ? `${m[1]}:${m[2]}` : str;
            }

            function molUrl(template, id) {
                const s = String(id);
                const t = String(template || '');

                if (!t) {
                    throw new Error('URL template missing');
                }

                if (t.includes('__ID__')) return t.replace('__ID__', s);
                if (t.includes('/0/')) return t.replace('/0/', `/${s}/`);
                if (t.includes('/0')) return t.replace('/0', `/${s}`);

                return t;
            }

            function MOLFormatDateTime(str) {
                if (!str) return '';
                const d = new Date(String(str).replace(' ', 'T'));
                if (Number.isNaN(d.getTime())) return String(str);

                const now = new Date();
                const sameDay = d.getDate() === now.getDate()
                    && d.getMonth() === now.getMonth()
                    && d.getFullYear() === now.getFullYear();

                const time = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

                if (sameDay) return time;

                const yesterday = new Date(now);
                yesterday.setDate(now.getDate() - 1);

                const isYesterday = d.getDate() === yesterday.getDate()
                    && d.getMonth() === yesterday.getMonth()
                    && d.getFullYear() === yesterday.getFullYear();

                if (isYesterday) return `Hier ${time}`;

                const date = d.toLocaleDateString([], { day: 'numeric', month: 'short' });
                return `${date} ${time}`;
            }

            function MOLAbsUrl(path) {
                const base = window.location.origin + (window.MOL_CHAT?.baseUrl || '');
                if (!path) return '';
                const p = String(path);
                if (/^https?:\/\//i.test(p)) return p;
                return new URL(p.startsWith('/') ? p : '/' + p, base).toString();
            }

            function MOLBytesToSize(bytes) {
                const n = Number(bytes || 0);
                if (!n) return '';
                const units = ['o', 'Ko', 'Mo', 'Go'];
                let i = 0;
                let v = n;

                while (v >= 1024 && i < units.length - 1) {
                    v /= 1024;
                    i++;
                }

                return `${v.toFixed(v >= 10 || i === 0 ? 0 : 1)} ${units[i]}`;
            }

            function MOLGuessFileIcon(name = '') {
                const ext = String(name).split('.').pop()?.toLowerCase() || '';
                if (['jpg', 'jpeg', 'png', 'gif', 'webp', 'svg'].includes(ext)) return 'bi-image';
                if (['pdf'].includes(ext)) return 'bi-file-earmark-pdf';
                if (['doc', 'docx'].includes(ext)) return 'bi-file-earmark-word';
                if (['xls', 'xlsx', 'csv'].includes(ext)) return 'bi-file-earmark-excel';
                if (['zip', 'rar', '7z', 'tar', 'gz'].includes(ext)) return 'bi-file-earmark-zip';
                if (['mp3', 'wav', 'ogg', 'm4a'].includes(ext)) return 'bi-file-earmark-music';
                if (['mp4', 'avi', 'mov', 'webm', 'mkv'].includes(ext)) return 'bi-file-earmark-play';
                return 'bi-file-earmark';
            }

            function MOLGetPresenceMeta(input = 'offline') {
                let presence = 'offline';

                if (typeof input === 'string') {
                    presence = input;
                } else if (input && typeof input === 'object') {
                    presence = input.presence || (input.online === true ? 'online' : 'offline');
                }

                presence = String(presence || 'offline').trim().toLowerCase();

                if (presence === 'online') {
                    return {
                        online: true,
                        presence: 'online',
                        dotClass: 'mol-presence-online',
                        pillClass: 'online',
                        avatarStatusClass: 'is-online',
                        label: '{% trans %}Connecté(e){% endtrans %}',
                    };
                }

                if (presence === 'recently_offline') {
                    return {
                        online: false,
                        presence: 'recently_offline',
                        dotClass: 'mol-presence-recently-offline',
                        pillClass: 'offline',
                        avatarStatusClass: 'is-recently-offline',
                        label: '{% trans %}Vient de se déconnecter{% endtrans %}',
                    };
                }

                return {
                    online: false,
                    presence: 'offline',
                    dotClass: 'mol-presence-offline',
                    pillClass: 'offline',
                    avatarStatusClass: 'is-offline',
                    label: '{% trans %}Déconnecté(e){% endtrans %}',
                };
            }

            function MOLGetMessageDeleteTemplate() {
                return window.MOL_CHAT?.urls?.messageDelete || '{{ path('chat_message_delete', {id: 0}) }}';
            }

            function MOLEnsureContextMenu() {
                let menu = document.getElementById('molMsgContextMenu');
                if (menu) return menu;

                document.body.insertAdjacentHTML('beforeend', `
                    <div id="molMsgContextMenu" class="mol-msg-menu">
                        <button type="button" data-action="reply"><i class="bi bi-reply"></i><span>{% trans %}Répondre{% endtrans %}</span></button>
                        <button type="button" data-action="copy"><i class="bi bi-copy"></i><span>{% trans %}Copier{% endtrans %}</span></button>
                        <button type="button" data-action="delete"><i class="bi bi-trash"></i><span>{% trans %}Supprimer{% endtrans %}</span></button>
                    </div>
                `);

                menu = document.getElementById('molMsgContextMenu');

                menu.addEventListener('click', async (e) => {
                    const btn = e.target.closest('[data-action]');
                    if (!btn || !MOL_ACTIVE_CONTEXT) return;

                    const action = btn.dataset.action;
                    const ctx = MOL_ACTIVE_CONTEXT;
                    MOLHideContextMenu();

                    if (action === 'reply') {
                        MOLPrepareReply(ctx.conversationId, ctx.message);
                        return;
                    }

                    if (action === 'copy') {
                        const text = ctx.message?.content || '';
                        if (text && navigator.clipboard?.writeText) {
                            try {
                                await navigator.clipboard.writeText(text);
                            } catch (err) {
                                console.warn('copy error', err);
                            }
                        }
                        return;
                    }

                    if (action === 'delete' && ctx.message?.mine) {
                        await MOLDeleteMessage(ctx.message.id, ctx.conversationId);
                    }
                });

                document.addEventListener('click', MOLHideContextMenu);
                document.addEventListener('scroll', MOLHideContextMenu, true);
                window.addEventListener('resize', MOLHideContextMenu);

                return menu;
            }

            function MOLShowContextMenu(x, y, conversationId, message) {
                const menu = MOLEnsureContextMenu();
                MOL_ACTIVE_CONTEXT = { conversationId, message };

                const deleteBtn = menu.querySelector('[data-action="delete"]');
                if (deleteBtn) {
                    deleteBtn.style.display = message?.mine ? '' : 'none';
                }

                menu.style.left = `${x}px`;
                menu.style.top = `${y}px`;
                menu.classList.add('is-open');
            }

            function MOLHideContextMenu() {
                const menu = document.getElementById('molMsgContextMenu');
                if (menu) {
                    menu.classList.remove('is-open');
                }
                MOL_ACTIVE_CONTEXT = null;
            }

            function MOLPrepareReply(conversationId, message) {
                MOL_REPLY_STATE[conversationId] = {
                    id: message.id,
                    authorName: message.mine
                        ? '{% trans %}Vous{% endtrans %}'
                        : (message.authorName || '{% trans %}Contact{% endtrans %}'),
                    content: message.type === 'text'
                        ? (message.content || '')
                        : message.type === 'voice'
                            ? '{% trans %}Message vocal{% endtrans %}'
                            : (message.meta?.filename || '{% trans %}Fichier{% endtrans %}')
                };

                MOLRenderReplyBox(conversationId);
                document.getElementById(`molToastInput-${conversationId}`)?.focus();
            }

            function MOLClearReply(conversationId) {
                delete MOL_REPLY_STATE[conversationId];
                MOLRenderReplyBox(conversationId);
            }

            function MOLRenderReplyBox(conversationId) {
                const box = document.getElementById(`molReplyBox-${conversationId}`);
                if (!box) return;

                const state = MOL_REPLY_STATE[conversationId];
                if (!state) {
                    box.classList.remove('is-active');
                    box.innerHTML = '';
                    return;
                }

                box.classList.add('is-active');
                box.innerHTML = `
                    <div class="flex-grow-1 overflow-hidden">
                        <div class="mol-reply-box__title">${escapeHtml(state.authorName)}</div>
                        <div class="mol-reply-box__text text-truncate">${escapeHtml(state.content)}</div>
                    </div>
                    <button type="button" class="mol-reply-close" onclick="MOLClearReply(${conversationId})">
                        <i class="bi bi-x-lg"></i>
                    </button>
                `;
            }

            async function MOLRefreshRenderedPresence() {
                const items = [...document.querySelectorAll('.mol-chat-item[data-user-id]')];
                if (!items.length) return;

                const userStatusTemplate = '{{ path('presence_user_status', {id: 0}) }}';

                for (const item of items) {
                    const userId = Number(item.dataset.userId || 0);
                    if (!userId) continue;

                    try {
                        const url = userStatusTemplate.replace(/\/0$/, '/' + userId) + '?_ts=' + Date.now();
                        const res = await fetch(url, {
                            method: 'GET',
                            credentials: 'same-origin',
                            cache: 'no-store',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'Cache-Control': 'no-cache'
                            }
                        });

                        if (!res.ok) continue;

                        const data = await res.json();
                        if (!data || !data.ok) continue;

                        const meta = MOLGetPresenceMeta(data.presence || 'offline');

                        item.dataset.online = meta.online ? '1' : '0';
                        item.dataset.presence = meta.presence;

                        const dot = item.querySelector('.mol-presence-dot');
                        if (dot) {
                            dot.className = `mol-presence-dot ${meta.dotClass}`;
                        }

                        const pill = item.querySelector('.mol-presence-pill');
                        if (pill) {
                            pill.className = `mol-presence-pill ${meta.pillClass}`;
                            pill.innerHTML = `<span class="mol-presence-pill__dot"></span>${meta.label}`;
                        }

                        const toast = document.getElementById(`molToast-${item.dataset.id}`);
                        if (toast) {
                            const toastAvatarDot = toast.querySelector('.mol-avatar-status-dot');
                            if (toastAvatarDot) {
                                toastAvatarDot.className = `mol-avatar-status-dot ${meta.avatarStatusClass}`;
                            }
                        }
                    } catch (e) {
                        console.warn('presence refresh error', userId, e);
                    }
                }
            }

            async function MOLChatLoadConversations(q = '') {
                if (!window.MOLRequireChatConfig || !window.MOLRequireChatConfig()) {
                    throw new Error('MOL_CHAT config missing');
                }

                const base = window.location.origin + (window.MOL_CHAT.baseUrl || '');
                const url = new URL(window.MOL_CHAT.urls.conversations, base);

                if (q) url.searchParams.set('q', q);
                url.searchParams.set('_ts', Date.now().toString());

                const res = await fetch(url.toString(), {
                    method: 'GET',
                    credentials: 'same-origin',
                    cache: 'no-store',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Cache-Control': 'no-cache'
                    }
                });

                if (!res.ok) {
                    throw new Error('HTTP ' + res.status);
                }

                return await res.json();
            }

            async function MOLChatStartWith(userId) {
                const base = window.location.origin + (window.MOL_CHAT.baseUrl || '');
                const url = new URL(`/chat/conversation/with/${userId}`, base);

                const res = await fetch(url.toString(), {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (!res.ok) {
                    console.error('Erreur ouverture conversation');
                    return;
                }

                const data = await res.json();
                if (!data.ok) return;

                if (typeof window.MOLChatOpenConversation === 'function') {
                    window.MOLChatOpenConversation(data.conversationId);
                }

                if (typeof window.MOLChatRefreshList === 'function') {
                    await window.MOLChatRefreshList();
                }
            }

            function MOLChatRenderConversations(items) {
                const list = document.getElementById('molChatList');
                if (!list) return;

                if (!items || !items.length) {
                    list.innerHTML = `<li class="text-secondary small py-3">{% trans %}Aucune conversation trouvée.{% endtrans %}</li>`;
                    return;
                }

                list.innerHTML = items.map(c => {
                    const presence = MOLGetPresenceMeta(c.presence || 'offline');
                    const avatarUrl = MOLAbsUrl(c.avatarUrl);
                    const timeLabel = MOLFormatDateTime(c.lastMessageAt);
                    const unreadCount = Number(c.unreadCount ?? 0);
                    const unread = unreadCount > 0 ? `<span class="mol-unread">${unreadCount}</span>` : '';

                    return `
                        <li class="mt-3 hstack gap-3 align-items-center position-relative mol-chat-item"
                            data-id="${Number(c.id || 0)}"
                            data-user-id="${Number(c.userId || 0)}"
                            data-name="${escapeHtml(c.name || 'Conversation')}"
                            data-avatar="${escapeHtml(avatarUrl)}"
                            data-online="${presence.online ? '1' : '0'}"
                            data-presence="${presence.presence}">

                            <div class="position-relative" style="width:44px;height:44px;flex:0 0 44px;">
                                <img class="avatar-img rounded-circle"
                                    src="${avatarUrl}"
                                    alt="${escapeHtml(c.name || 'Conversation')}"
                                    style="width:44px;height:44px;object-fit:cover;">
                                <span class="mol-presence-dot ${presence.dotClass}"></span>
                            </div>

                            <div class="overflow-hidden flex-grow-1">
                                <a class="h6 mb-0 stretched-link d-block text-truncate" href="#">
                                    ${escapeHtml(c.name || 'Conversation')}
                                </a>

                                <div class="small text-secondary text-truncate">
                                    ${escapeHtml(c.lastMessage || '{% trans %}Aucun message{% endtrans %}')}
                                </div>

                                <div class="small mt-1">
                                    <span class="mol-presence-pill ${presence.pillClass}">
                                        <span class="mol-presence-pill__dot"></span>
                                        ${presence.label}
                                    </span>
                                </div>
                            </div>

                            <div class="d-flex flex-column align-items-end ms-auto">
                                <div class="small text-nowrap text-secondary">${escapeHtml(timeLabel)}</div>
                                ${unread}
                            </div>
                        </li>
                    `;
                }).join('');
            }

            async function MOLChatFetchMessages(conversationId) {
                if (!window.MOLRequireChatConfig || !window.MOLRequireChatConfig()) {
                    throw new Error('MOL_CHAT config missing');
                }

                let url = molUrl(window.MOL_CHAT.urls.messages, conversationId);
                const sep = url.includes('?') ? '&' : '?';
                url += `${sep}_ts=${Date.now()}`;

                const res = await fetch(url, {
                    credentials: 'same-origin',
                    cache: 'no-store',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Cache-Control': 'no-cache'
                    }
                });

                const text = await res.text();

                if (!res.ok) {
                    console.error('[chat] messages HTTP', res.status, text);
                    throw new Error('HTTP ' + res.status);
                }

                try {
                    return JSON.parse(text);
                } catch (e) {
                    console.error('[chat] JSON parse error, response=', text);
                    throw e;
                }
            }

            function MOLRenderReplyInMessage(replyTo) {
                if (!replyTo) return '';

                const author = escapeHtml(replyTo.authorName || '{% trans %}Message cité{% endtrans %}');
                const content = escapeHtml(replyTo.content || '{% trans %}Message{% endtrans %}');

                return `
                    <div class="mol-msg-reply-quote">
                        <div class="mol-msg-reply-quote__author">${author}</div>
                        <div class="mol-msg-reply-quote__text">${content}</div>
                    </div>
                `;
            }

            function MOLRenderReplyBanner(message) {
                if (!message.replyTo) return '';

                const name = escapeHtml(message.replyTo.authorName || '{% trans %}Contact{% endtrans %}');
                const text = message.mine
                    ? `{% trans %}Vous avez répondu à{% endtrans %} ${name}`
                    : `${name} {% trans %}vous a répondu{% endtrans %}`;

                return `
                    <div class="mol-reply-banner">
                        <i class="bi bi-reply-fill"></i>
                        <span>${text}</span>
                    </div>
                `;
            }

            function MOLRenderAttachment(m) {
                const meta = m.meta || {};
                const filename = meta.filename || meta.originalName || m.attachmentName || m.content || '';
                const attachmentUrl = m.attachmentUrl ? MOLAbsUrl(m.attachmentUrl) : '';
                const mimeType = String(meta.mimeType || '').toLowerCase();
                const icon = MOLGuessFileIcon(filename);
                const size = MOLBytesToSize(meta.size || meta.filesize);

                if (!attachmentUrl) {
                    return '';
                }

                const isImage =
                    mimeType.startsWith('image/')
                    || /\.(jpg|jpeg|png|gif|webp|svg|bmp)$/i.test(filename);

                const isVideo =
                    mimeType.startsWith('video/')
                    || /\.(mp4|webm|mov|avi|mkv)$/i.test(filename);

                const isAudio =
                    m.type === 'voice'
                    || mimeType.startsWith('audio/')
                    || /\.(mp3|wav|ogg|m4a|aac|webm)$/i.test(filename);

                if (isImage) {
                    return `
                        <div class="mol-inline-media mol-inline-image">
                            <a href="${attachmentUrl}" target="_blank" rel="noopener noreferrer" class="mol-image-link">
                                <img
                                    src="${attachmentUrl}"
                                    alt="${escapeHtml(filename || 'Image')}"
                                    class="mol-chat-image"
                                    loading="lazy"
                                >
                            </a>

                            <div class="mol-inline-filebar">
                                <div class="mol-inline-filebar__main">
                                    <div class="mol-inline-filebar__name" title="${escapeHtml(filename)}">
                                        ${escapeHtml(filename || '{% trans %}Image{% endtrans %}')}
                                    </div>
                                </div>

                                <a
                                    class="mol-inline-filebar__download"
                                    href="${attachmentUrl}"
                                    download="${escapeHtml(filename || 'image')}"
                                    title="{% trans %}Télécharger{% endtrans %}"
                                >
                                    <i class="bi bi-download"></i>
                                </a>
                            </div>
                        </div>
                    `;
                }

                if (isVideo) {
                    return `
                        <div class="mol-inline-media mol-inline-video">
                            <video controls preload="metadata" class="mol-chat-video">
                                <source src="${attachmentUrl}" type="${escapeHtml(mimeType || 'video/mp4')}">
