<div class="border rounded-4 p-3 mb-2">
  <div class="d-flex justify-content-between align-items-center">
    <div class="fw-semibold">
      {{ review.targetBy ? review.targetBy.publicDisplayName : ('Client'|trans) }}
    </div>
    <div class="text-muted small">
      {{ review.createdAt ? review.createdAt|date('d/m/Y H:i') : '' }}
    </div>
  </div>
  <div class="mt-2">
    {{ review.comment }}
  </div>
</div>
