{% extends 'base.html.twig' %}
{% block title %}Analytics entreprise{% endblock %}

{% block body %}
{# (Optionnel) si tu utilises Tailwind compilé, enlève le CDN.
   Sinon ça te donne un rendu VIP rapidement. #}
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

{% include "company/_vip_ui_analytics.html.twig" %}

<div class="vip-wrap">
  <div class="mx-auto max-w-7xl px-4">

    {# ===== Header ===== #}
    <div class="vip-card overflow-hidden">
      <div class="p-6 sm:p-8">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <div class="vip-chip">
              <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
              {% trans %}Analytics • Entreprise{% endtrans %}
            </div>
            <h1 class="mt-3 text-2xl sm:text-3xl font-black tracking-tight text-slate-900">
              {% trans %}📊 Performance & traction{% endtrans %}
            </h1>
            <p class="mt-1 text-sm text-slate-600">
              {% trans %}Période :{% endtrans %} <span class="font-extrabold">{{ filters.from }}</span> → <span class="font-extrabold">{{ filters.to }}</span>
              {% if selectedJob %} • {% trans %}Offre :{% endtrans %} <span class="font-extrabold">{{ selectedJob.title }}</span>{% endif %}
            </p>
          </div>

          <div class="flex gap-2 flex-wrap">
            <a href="{{ path('subscription_plans') }}"
               class="rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-extrabold text-slate-900 hover:bg-slate-50">
              {% trans %}🚀 Booster{% endtrans %}
            </a>
            <a href="{{ path('tableau_de_bord') }}"
               class="rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-extrabold text-slate-900 hover:bg-slate-50">
              {% trans %}← Retour{% endtrans %}
            </a>
          </div>
        </div>

        {# ===== Filters ===== #}
        <form method="get" class="mt-6 vip-soft p-4">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
            <div class="md:col-span-3">
              <label class="text-xs font-extrabold text-slate-700">{% trans %}Période{% endtrans %}</label>
              <select name="period" class="mt-1 w-full rounded-2xl border-slate-200 bg-white px-3 py-2 text-sm">
                <option value="7"  {{ filters.period == '7'  ? 'selected' : '' }}>{% trans %}7 jours{% endtrans %}</option>
                <option value="30" {{ filters.period == '30' ? 'selected' : '' }}>{% trans %}30 jours{% endtrans %}</option>
                <option value="90" {{ filters.period == '90' ? 'selected' : '' }}>{% trans %}90 jours{% endtrans %}</option>
                <option value="custom" {{ filters.period == 'custom' ? 'selected' : '' }}>{% trans %}Personnalisée{% endtrans %}</option>
              </select>
            </div>

            <div class="md:col-span-4">
              <label class="text-xs font-extrabold text-slate-700">{% trans %}Offre{% endtrans %}</label>
              <select name="job" class="mt-1 w-full rounded-2xl border-slate-200 bg-white px-3 py-2 text-sm">
                <option value="0">{% trans %}Toutes les offres{% endtrans %}</option>
                {% for j in jobsForSelect %}
                  <option value="{{ j.id }}" {{ (filters.jobId == j.id) ? 'selected' : '' }}>
                    #{{ j.id }} — {{ j.title }}
                  </option>
                {% endfor %}
              </select>
            </div>

            <div class="md:col-span-2">
              <label class="text-xs font-extrabold text-slate-700">{% trans %}Du{% endtrans %}</label>
              <input type="date" name="from" value="{{ filters.from }}"
                     class="mt-1 w-full rounded-2xl border-slate-200 bg-white px-3 py-2 text-sm"/>
            </div>

            <div class="md:col-span-2">
              <label class="text-xs font-extrabold text-slate-700">{% trans %}Au{% endtrans %}</label>
              <input type="date" name="to" value="{{ filters.to }}"
                     class="mt-1 w-full rounded-2xl border-slate-200 bg-white px-3 py-2 text-sm"/>
            </div>

            <div class="md:col-span-1 flex gap-2">
              <button class="w-full rounded-2xl bg-slate-900 px-4 py-2 text-sm font-extrabold text-white hover:bg-slate-800">
                {% trans %}Filtrer{% endtrans %}
              </button>
            </div>
          </div>

          <p class="mt-2 text-xs text-slate-500">
            {% trans %}Astuce : si tu choisis “Personnalisée”, les champs Du/Au sont pris en compte.{% endtrans %}
          </p>
        </form>

        {# ===== KPI ===== #}
        <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3">
          <div class="vip-kpi">
            <div class="t">{% trans %}Offres actives{% endtrans %}</div>
            <div class="v">{{ kpis.activeJobs }}</div>
            <div class="h">{% trans %}Non expirées{% endtrans %}</div>
          </div>
          <div class="vip-kpi">
            <div class="t">{% trans %}Vues{% endtrans %}</div>
            <div class="v">{{ kpis.views }}</div>
            <div class="h">{% trans %}Vues uniques (users){% endtrans %}</div>
          </div>
          <div class="vip-kpi">
            <div class="t">{% trans %}Candidatures{% endtrans %}</div>
            <div class="v">{{ kpis.apps }}</div>
            <div class="h">{% trans %}Sur la période{% endtrans %}</div>
          </div>
          <div class="vip-kpi">
            <div class="t">{% trans %}Conversion{% endtrans %}</div>
            <div class="v">{{ kpis.conversion }}%</div>
            <div class="h">{% trans %}Apps / Vues{% endtrans %}</div>
          </div>
          <div class="vip-kpi">
            <div class="t">{% trans %}Traitement{% endtrans %}</div>
            <div class="v">{{ kpis.replyRate }}%</div>
            <div class="h">{% trans %}Candidatures consultées{% endtrans %}</div>
          </div>
          <div class="vip-kpi">
            <div class="t">{% trans %}Temps moyen{% endtrans %}</div>
            <div class="v">{{ kpis.avgFirstViewHours }}h</div>
            <div class="h">{% trans %}Avant 1ère consultation{% endtrans %}</div>
          </div>
        </div>

        {# ===== Status breakdown ===== #}
        <div class="mt-5 vip-soft p-4">
          <div class="flex items-center justify-between gap-3 flex-wrap">
            <div class="font-black text-slate-900">{% trans %}📌 Répartition des statuts{% endtrans %}</div>
            <div class="text-xs text-slate-500">{% trans %}Sur la période sélectionnée{% endtrans %}</div>
          </div>

          <div class="mt-3 grid grid-cols-2 sm:grid-cols-5 gap-2">
            {% set sb = statusBreakdown %}
            <div class="rounded-2xl border border-slate-200 bg-white p-3">
              <div class="text-xs font-extrabold text-slate-600">NEW</div>
              <div class="text-lg font-black text-slate-900">{{ sb['NEW'] ?? 0 }}</div>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-3">
              <div class="text-xs font-extrabold text-slate-600">REVIEWED</div>
              <div class="text-lg font-black text-slate-900">{{ sb['REVIEWED'] ?? 0 }}</div>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-3">
              <div class="text-xs font-extrabold text-slate-600">SHORTLIST</div>
              <div class="text-lg font-black text-slate-900">{{ sb['SHORTLIST'] ?? 0 }}</div>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-3">
              <div class="text-xs font-extrabold text-slate-600">REJECTED</div>
              <div class="text-lg font-black text-slate-900">{{ sb['REJECTED'] ?? 0 }}</div>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-3">
              <div class="text-xs font-extrabold text-slate-600">ACCEPTED</div>
              <div class="text-lg font-black text-slate-900">{{ sb['ACCEPTED'] ?? 0 }}</div>
            </div>
          </div>
        </div>

        {# ===== Chart ===== #}
        <div class="mt-6 grid grid-cols-1 lg:grid-cols-12 gap-4">
          <div class="lg:col-span-8 vip-soft p-4">
            <div class="flex items-center justify-between flex-wrap gap-2">
              <div class="font-black text-slate-900">{% trans %}📈 Vues vs Candidatures{% endtrans %}</div>
              <div class="text-xs text-slate-500">{% trans %}Quotidien • période{% endtrans %}</div>
            </div>
            <div class="mt-3">
              <canvas id="chartLine" height="110"></canvas>
            </div>
          </div>

          <div class="lg:col-span-4 vip-soft p-4">
            <div class="font-black text-slate-900">{% trans %}🎯 Lecture rapide{% endtrans %}</div>
            <ul class="mt-3 space-y-2 text-sm text-slate-600">
              <li>• <span class="font-extrabold text-slate-900">{{ kpis.views }}</span> {% trans %}vues uniques{% endtrans %}</li>
              <li>• <span class="font-extrabold text-slate-900">{{ kpis.apps }}</span> {% trans %}candidatures{% endtrans %}</li>
              <li>• {% trans %}Conversion :{% endtrans %} <span class="font-extrabold text-slate-900">{{ kpis.conversion }}%</span></li>
              <li>• {% trans %}Traitement :{% endtrans %} <span class="font-extrabold text-slate-900">{{ kpis.replyRate }}%</span></li>
            </ul>

            <div class="mt-4 rounded-2xl border border-slate-200 bg-white p-3">
              <div class="text-xs font-extrabold text-slate-600">{% trans %}Recommandation{% endtrans %}</div>
              {% if kpis.views > 0 and kpis.apps == 0 %}
                <div class="mt-1 text-sm font-bold text-slate-900">{% trans %}Beaucoup de vues, 0 candidature → revoir l’offre (titre/salaire/description).{% endtrans %}</div>
              {% elseif kpis.apps > 0 and kpis.replyRate < 70 %}
                <div class="mt-1 text-sm font-bold text-slate-900">{% trans %}Traitement &lt; 70% → répondre / consulter plus vite pour garder les candidats.{% endtrans %}</div>
              {% elseif kpis.conversion >= 5 %}
                <div class="mt-1 text-sm font-bold text-slate-900">{% trans %}Bonne conversion → tu peux booster pour amplifier.{% endtrans %}</div>
              {% else %}
                <div class="mt-1 text-sm font-bold text-slate-900">{% trans %}Stabilise la traction (publication régulière + amélioration offre).{% endtrans %}</div>
              {% endif %}
            </div>
          </div>
        </div>

        {# ===== Extra charts ===== #}
        <div class="mt-4 grid grid-cols-1 lg:grid-cols-12 gap-4">
          <div class="lg:col-span-5 vip-soft p-4">
            <div class="flex items-center justify-between flex-wrap gap-2">
              <div class="font-black text-slate-900">{% trans %}🧩 Statuts des candidatures{% endtrans %}</div>
              <div class="text-xs text-slate-500">{% trans %}Répartition (période){% endtrans %}</div>
            </div>
            <div class="mt-3">
              <canvas id="chartStatus" height="170"></canvas>
            </div>
          </div>

          <div class="lg:col-span-7 vip-soft p-4">
            <div class="flex items-center justify-between flex-wrap gap-2">
              <div class="font-black text-slate-900">{% trans %}🏆 Top offres (Vues vs Apps){% endtrans %}</div>
              <div class="text-xs text-slate-500">{% trans %}Top 6 (tri candidatures){% endtrans %}</div>
            </div>
            <div class="mt-3">
              <canvas id="chartTop" height="170"></canvas>
            </div>
          </div>
        </div>

        {# <div class="lg:col-span-7 vip-soft p-4">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <div class="font-black text-slate-900">{% trans %}🔥 Conversion par offre{% endtrans %}</div>
            <div class="text-xs text-slate-500">{% trans %}Apps / Vues (%) • Top 6{% endtrans %}</div>
          </div>
          <div class="mt-3">
            <canvas id="chartConv" height="170"></canvas>
          </div>
        </div> #}

        {# ===== Table ===== #}
        <div class="mt-6 vip-soft p-4 overflow-hidden">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <div class="font-black text-slate-900">{% trans %}🧾 Performance par offre{% endtrans %}</div>
            <div class="text-xs text-slate-500">{% trans %}Trié par candidatures{% endtrans %}</div>
          </div>

          <div class="mt-3 overflow-x-auto">
            <table class="min-w-full vip-table">
              <thead>
                <tr class="border-b border-slate-200">
                  <th class="py-3 text-left">{% trans %}Offre{% endtrans %}</th>
                  <th class="py-3 text-center">{% trans %}Vues{% endtrans %}</th>
                  <th class="py-3 text-center">{% trans %}Apps{% endtrans %}</th>
                  <th class="py-3 text-center">{% trans %}Conv.{% endtrans %}</th>
                  <th class="py-3 text-center">{% trans %}Trait.{% endtrans %}</th>
                  <th class="py-3 text-center">{% trans %}Favoris{% endtrans %}</th>
                  <th class="py-3 text-right">{% trans %}Activité{% endtrans %}</th>
                </tr>
              </thead>
              <tbody>
                {% if rows is empty %}
                  <tr>
                    <td colspan="7" class="py-6 text-center text-sm text-slate-500">
                      {% trans %}Aucune donnée sur cette période.{% endtrans %}
                    </td>
                  </tr>
                {% endif %}

                {% for r in rows %}
                  {% set expired = r.expiresAt ? (r.expiresAt < date()) : false %}
                  {% set last = r.lastAppAt ?? r.lastViewAt %}
                  <tr class="border-b border-slate-100 hover:bg-white/60">
                    <td class="py-3 pr-4">
                      <div class="font-extrabold text-slate-900">
                        {{ r.title }}
                        <span class="ml-2 inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-black
                          {{ expired ? 'bg-rose-100 text-rose-700' : 'bg-emerald-100 text-emerald-700' }}">
                          {{ expired ? 'Expirée'|trans : 'Active'|trans }}
                        </span>
                      </div>
                      <div class="text-xs text-slate-500">📍 {{ r.city ?? '—' }}</div>
                    </td>

                    <td class="py-3 text-center font-extrabold text-slate-900">{{ r.views }}</td>
                    <td class="py-3 text-center font-extrabold text-slate-900">{{ r.apps }}</td>

                    <td class="py-3 text-center">
                      <div class="font-extrabold text-slate-900">{{ r.conversion }}%</div>
                      <div class="mt-1 h-2 rounded-full bg-slate-100 overflow-hidden">
                        <div class="h-2 bg-indigo-500/80" style="width: {{ r.conversion > 100 ? 100 : r.conversion }}%"></div>
                      </div>
                    </td>

                    <td class="py-3 text-center">
                      <div class="font-extrabold text-slate-900">{{ r.replyRate }}%</div>
                      <div class="mt-1 h-2 rounded-full bg-slate-100 overflow-hidden">
                        <div class="h-2 bg-emerald-500/80" style="width: {{ r.replyRate > 100 ? 100 : r.replyRate }}%"></div>
                      </div>
                    </td>

                    <td class="py-3 text-center font-extrabold text-slate-900">{{ r.favs }}</td>

                    <td class="py-3 text-right">
                      <div class="text-xs text-slate-500">
                        {% if r.lastAppAt %}
                          {% trans %}Dernière app :{% endtrans %} <span class="font-bold text-slate-900">{{ r.lastAppAt|date('Y-m-d H:i') }}</span>
                        {% elseif r.lastViewAt %}
                          {% trans %}Dernière vue :{% endtrans %} <span class="font-bold text-slate-900">{{ r.lastViewAt|date('Y-m-d H:i') }}</span>
                        {% else %}
                          —
                        {% endif %}
                      </div>
                      <a href="{{ path('company_analytics', filters|merge({'job': r.id})) }}"
                         class="mt-2 inline-flex items-center rounded-2xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-extrabold text-slate-900 hover:bg-slate-50">
                        {% trans %}Détails →{% endtrans %}
                      </a>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>

          <div class="mt-2 text-xs text-slate-500">
            {% trans %}* “Trait.” = candidatures consultées (viewedAt) / candidatures sur la période.{% endtrans %}
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<script>
  const labels = {{ chart.labels|json_encode|raw }};
  const views  = {{ chart.views|json_encode|raw }};
  const apps   = {{ chart.apps|json_encode|raw }};

  const ctx = document.getElementById('chartLine');
  if (ctx) {
    new Chart(ctx, {
      type: 'line',
      data: {
        labels,
        datasets: [
          { label: 'Vues', data: views, tension: 0.35 },
          { label: 'Candidatures', data: apps, tension: 0.35 }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { display: true }
        },
        scales: {
          y: { beginAtZero: true }
        }
      }
    });
  }
</script>

<script>
  // ===== Donut statuts =====
  const statusLabels = {{ chartStatus.labels|json_encode|raw }};
  const statusValues = {{ chartStatus.values|json_encode|raw }};

  const elStatus = document.getElementById('chartStatus');
  if (elStatus) {
    new Chart(elStatus, {
      type: 'doughnut',
      data: {
        labels: statusLabels,
        datasets: [{ data: statusValues }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { position: 'bottom' }
        },
        cutout: '62%'
      }
    });
  }

  // ===== Bar top offres =====
  const topLabels = {{ chartTop.labels|json_encode|raw }};
  const topViews  = {{ chartTop.views|json_encode|raw }};
  const topApps   = {{ chartTop.apps|json_encode|raw }};

  const elTop = document.getElementById('chartTop');
  if (elTop) {
    new Chart(elTop, {
      type: 'bar',
      data: {
        labels: topLabels,
        datasets: [
          { label: 'Vues', data: topViews },
          { label: 'Candidatures', data: topApps }
        ]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: true } },
        scales: {
          y: { beginAtZero: true }
        }
      }
    });
  }
</script>


<script>
  const convLabels = {{ chartTop.labels|json_encode|raw }};
  const convValues = {{ chartTop.conv|json_encode|raw }};

  const elConv = document.getElementById('chartConv');
  if (elConv) {
    new Chart(elConv, {
      type: 'bar',
      data: {
        labels: convLabels,
        datasets: [
          { label: 'Conversion (%)', data: convValues }
        ]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: true } },
        scales: {
          y: {
            beginAtZero: true,
            suggestedMax: 15, // utile si conversions faibles (sinon enlève)
            ticks: {
              callback: (v) => v + '%'
            }
          }
        }
      }
    });
  }
</script>
{% endblock %}