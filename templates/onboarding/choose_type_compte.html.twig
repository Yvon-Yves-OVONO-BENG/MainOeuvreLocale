{% extends 'base.html.twig' %}

{% block title %}{% trans %}Choisir votre type de compte{% endtrans %}{% endblock %}

{% block body %}

{% include "onboarding/_ui_vip.html.twig" %}

<section class="choose-account-page">
  <div class="choose-account-card">
    <div class="choose-account-badge" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4Z" stroke="currentColor" stroke-width="2"/>
        <path d="M4 20a8 8 0 0 1 16 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </div>

    <h1 class="auth-title">{% trans %}Choisir votre type de compte{% endtrans %}</h1>
    <p class="auth-subtitle">
      {% trans %}Cette étape permet d'afficher le bon formulaire de profil et de personnaliser votre expérience.{% endtrans %}
    </p>

    {{ form_start(form, {
      attr: {
        class: 'choose-account-form'
      }
    }) }}

      <div class="form-groupx">
        <div class="floating-field select-floating has-value">
          {{ form_widget(form.typeCompte, {
            attr: {
              class: 'form-select in floating-control'
            }
          }) }}
        </div>

        {{ form_errors(form.typeCompte) }}
      </div>

      <button type="submit" class="btn-create">
        {% trans %}Continuer{% endtrans %}
      </button>

    {{ form_end(form) }}

    <div class="choose-account-note">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 9v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <path d="M12 17h.01" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      </svg>
      <span>
        {% trans %}Vous pourrez compléter vos informations personnelles ou professionnelles à l’étape suivante.{% endtrans %}
      </span>
    </div>
  </div>
</section>
{% endblock %}