
<style>
  :root{
    --mol-bg:#f5f8fe;
    --mol-bg-2:#eef4ff;
    --mol-card:rgba(255,255,255,.96);
    --mol-card-soft:rgba(255,255,255,.84);
    --mol-border:rgba(15,23,42,.08);
    --mol-border-strong:rgba(37,99,235,.16);
    --mol-text:#0f172a;
    --mol-muted:rgba(15,23,42,.62);
    --mol-primary:#2563eb;
    --mol-primary-2:#0ea5e9;
    --mol-success:#10b981;
    --mol-danger:#dc3545;
    --mol-warning:#f59e0b;
    --mol-shadow:0 24px 60px rgba(2,6,23,.08);
    --mol-shadow-sm:0 10px 24px rgba(2,6,23,.06);
    --mol-shadow-lg:0 28px 70px rgba(37,99,235,.12);
    --mol-radius:26px;
    --mol-radius-md:20px;
    --mol-radius-sm:16px;
  }

  .mol-portfolio-page{
    position:relative;
    padding-top:28px;
    padding-bottom:42px;
    background:
      radial-gradient(1200px circle at 0% 0%, rgba(37,99,235,.11), transparent 42%),
      radial-gradient(900px circle at 100% 8%, rgba(14,165,233,.10), transparent 36%),
      radial-gradient(1000px circle at 50% 100%, rgba(16,185,129,.07), transparent 38%),
      linear-gradient(180deg, #fbfdff 0%, var(--mol-bg) 100%);
  }

  .mol-shell{
    display:flex;
    flex-direction:column;
    gap:20px;
  }

  .mol-hero{
    position:relative;
    overflow:hidden;
    border:1px solid var(--mol-border);
    border-radius:var(--mol-radius);
    background:
      radial-gradient(900px circle at 10% 15%, rgba(37,99,235,.18), transparent 50%),
      radial-gradient(850px circle at 90% 10%, rgba(14,165,233,.13), transparent 44%),
      linear-gradient(180deg, rgba(255,255,255,.97), rgba(255,255,255,.82));
    box-shadow:var(--mol-shadow-lg);
    padding:28px;
  }

  .mol-hero::before{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(135deg, rgba(255,255,255,.40), transparent 35%);
    pointer-events:none;
  }

  .mol-hero::after{
    content:"";
    position:absolute;
    width:280px;
    height:280px;
    right:-90px;
    top:-90px;
    border-radius:50%;
    background: radial-gradient(circle, rgba(255,255,255,.55), transparent 64%);
    pointer-events:none;
  }

  .mol-kicker{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:8px 14px;
    border-radius:999px;
    border:1px solid rgba(37,99,235,.14);
    background:rgba(255,255,255,.86);
    color:var(--mol-primary);
    font-weight:900;
    font-size:.82rem;
    letter-spacing:.02em;
    box-shadow:var(--mol-shadow-sm);
    margin-bottom:14px;
  }

  .mol-title{
    margin:0;
    font-weight:900;
    letter-spacing:-.045em;
    color:var(--mol-text);
    line-height:1.02;
    font-size:clamp(1.65rem, 2.9vw, 2.55rem);
  }

  .mol-subtitle{
    margin:12px 0 0;
    color:var(--mol-muted);
    font-weight:600;
    max-width:820px;
    font-size:1rem;
    line-height:1.65;
  }

  .mol-actions-top{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
    justify-content:flex-end;
  }

  .mol-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    min-height:48px;
    padding:11px 16px;
    border-radius:16px;
    text-decoration:none;
    font-weight:800;
    border:1px solid var(--mol-border);
    transition:transform .16s ease, box-shadow .16s ease, filter .16s ease, background .16s ease;
    white-space:nowrap;
  }

  .mol-btn:hover{
    transform:translateY(-1px);
    box-shadow:var(--mol-shadow-sm);
    text-decoration:none;
  }

  .mol-btn-primary{
    color:#fff;
    border-color:transparent;
    background:linear-gradient(135deg, var(--mol-primary), var(--mol-primary-2));
    box-shadow:0 16px 30px rgba(37,99,235,.24);
  }

  .mol-btn-primary:hover{
    color:#fff;
    filter:brightness(1.03);
  }

  .mol-btn-light{
    color:var(--mol-text);
    background:rgba(255,255,255,.94);
  }

  .mol-stats{
    display:grid;
    grid-template-columns:repeat(3, minmax(0,1fr));
    gap:14px;
  }

  .mol-stat{
    border:1px solid var(--mol-border);
    border-radius:20px;
    background:rgba(255,255,255,.78);
    padding:16px;
    box-shadow:var(--mol-shadow-sm);
    backdrop-filter:blur(10px);
  }

  .mol-stat-top{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    margin-bottom:8px;
  }

  .mol-stat-label{
    color:var(--mol-muted);
    font-size:.88rem;
    font-weight:700;
  }

  .mol-stat-icon{
    width:40px;
    height:40px;
    border-radius:14px;
    display:grid;
    place-items:center;
    font-size:1rem;
    color:var(--mol-primary);
    background:rgba(37,99,235,.10);
    border:1px solid rgba(37,99,235,.14);
  }

  .mol-stat-value{
    font-size:1.55rem;
    font-weight:900;
    color:var(--mol-text);
    line-height:1;
  }

  .mol-card{
    border:1px solid var(--mol-border);
    border-radius:var(--mol-radius);
    background:var(--mol-card);
    box-shadow:var(--mol-shadow-sm);
    overflow:hidden;
  }

  .mol-card-body{
    padding:20px;
  }

  .mol-card-title{
    font-weight:900;
    color:var(--mol-text);
    margin:0;
    letter-spacing:-.02em;
  }

  .mol-soft{
    color:var(--mol-muted);
  }

  .mol-pill{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    padding:8px 13px;
    border-radius:999px;
    border:1px solid var(--mol-border);
    background:rgba(255,255,255,.94);
    font-weight:800;
    color:var(--mol-text);
    white-space:nowrap;
    box-shadow:0 8px 20px rgba(2,6,23,.05);
  }

  .mol-upload-box{
    border:1px dashed rgba(37,99,235,.25);
    background:linear-gradient(180deg, rgba(37,99,235,.05), rgba(37,99,235,.02));
    border-radius:22px;
    padding:18px;
  }

  .mol-upload-label{
    font-weight:900;
    margin-bottom:8px;
    color:var(--mol-text);
  }

  .mol-upload-input .input-group-text{
    border:1px solid var(--mol-border);
    border-right:0;
    background:#fff;
    border-radius:16px 0 0 16px;
    min-height:54px;
    min-width:58px;
    display:flex;
    align-items:center;
    justify-content:center;
  }

  .mol-upload-input .form-control{
    border:1px solid var(--mol-border);
    border-left:0;
    background:#fff;
    border-radius:0 16px 16px 0;
    min-height:54px;
    font-weight:700;
    box-shadow:none !important;
  }

  .mol-upload-input .form-control:focus{
    box-shadow:none !important;
  }

  .mol-upload-hint{
    margin-top:8px;
    font-size:.92rem;
    color:var(--mol-muted);
  }

  .mol-gallery-head{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    flex-wrap:wrap;
    margin-bottom:16px;
  }

  .mol-grid{
    display:grid;
    grid-template-columns:repeat(1, minmax(0, 1fr));
    gap:16px;
  }

  @media (min-width:576px){
    .mol-grid{ grid-template-columns:repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width:992px){
    .mol-grid{ grid-template-columns:repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width:1400px){
    .mol-grid{ grid-template-columns:repeat(4, minmax(0, 1fr)); }
  }

  .mol-media-card{
    position:relative;
    overflow:hidden;
    border-radius:22px;
    border:1px solid var(--mol-border);
    background:#fff;
    box-shadow:0 12px 26px rgba(2,6,23,.06);
    transition:transform .18s ease, box-shadow .18s ease;
  }

  .mol-media-card:hover{
    transform:translateY(-3px);
    box-shadow:0 22px 42px rgba(2,6,23,.10);
  }

  .mol-media-thumb-wrap{
    position:relative;
    overflow:hidden;
    cursor:pointer;
  }

  .mol-media-thumb{
    width:100%;
    height:245px;
    object-fit:cover;
    display:block;
    transition:transform .34s ease;
    background:#eef2f7;
  }

  .mol-media-card:hover .mol-media-thumb{
    transform:scale(1.05);
  }

  .mol-media-overlay{
    position:absolute;
    inset:0;
    background:linear-gradient(180deg, rgba(2,6,23,0) 42%, rgba(2,6,23,.72) 100%);
    opacity:0;
    transition:opacity .18s ease;
  }

  .mol-media-card:hover .mol-media-overlay{
    opacity:1;
  }

  .mol-media-zoom{
    position:absolute;
    inset:auto 12px 12px 12px;
    z-index:2;
    display:flex;
    align-items:center;
    justify-content:flex-start;
    opacity:0;
    transform:translateY(8px);
    transition:all .18s ease;
  }

  .mol-media-card:hover .mol-media-zoom{
    opacity:1;
    transform:translateY(0);
  }

  .mol-zoom-badge{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:8px 12px;
    border-radius:999px;
    background:rgba(255,255,255,.94);
    border:1px solid rgba(255,255,255,.65);
    color:var(--mol-text);
    font-weight:900;
    box-shadow:0 10px 22px rgba(2,6,23,.10);
  }

  .mol-media-top{
    position:absolute;
    top:12px;
    left:12px;
    right:12px;
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:8px;
    z-index:2;
  }

  .mol-date-badge{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:6px 10px;
    border-radius:999px;
    background:rgba(255,255,255,.95);
    border:1px solid rgba(255,255,255,.72);
    color:rgba(15,23,42,.84);
    font-size:.78rem;
    font-weight:900;
    box-shadow:0 10px 20px rgba(2,6,23,.08);
  }

  .mol-quality-badge{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:6px 10px;
    border-radius:999px;
    background:rgba(16,185,129,.95);
    color:#fff;
    font-size:.76rem;
    font-weight:900;
    box-shadow:0 10px 20px rgba(16,185,129,.18);
  }

  .mol-media-bottom{
    padding:14px 14px 12px;
  }

  .mol-media-title{
    font-weight:900;
    color:var(--mol-text);
    margin:0 0 4px;
    line-height:1.3;
    font-size:.97rem;
  }

  .mol-media-sub{
    color:var(--mol-muted);
    font-size:.88rem;
    font-weight:600;
    line-height:1.5;
    min-height:40px;
    word-break:break-word;
  }

  .mol-media-actions{
    padding:0 14px 14px;
    display:flex;
    align-items:center;
    justify-content:flex-end;
    gap:8px;
  }

  .mol-btn-glass{
    display:inline-flex;
    align-items:center;
    gap:8px;
    border:1px solid rgba(220,53,69,.18);
    background:rgba(220,53,69,.08);
    color:var(--mol-danger);
    padding:9px 13px;
    border-radius:14px;
    font-weight:900;
    box-shadow:0 10px 22px rgba(2,6,23,.06);
    transition:all .16s ease;
  }

  .mol-btn-glass:hover{
    background:rgba(220,53,69,.12);
    transform:translateY(-1px);
  }

  .mol-empty{
    border:1px dashed rgba(15,23,42,.12);
    border-radius:22px;
    background:rgba(255,255,255,.82);
    padding:34px 18px;
    text-align:center;
  }

  .mol-empty-icon{
    width:70px;
    height:70px;
    margin:0 auto 14px;
    border-radius:20px;
    display:grid;
    place-items:center;
    background:rgba(37,99,235,.08);
    color:var(--mol-primary);
    font-size:1.5rem;
    box-shadow:0 10px 22px rgba(37,99,235,.08);
  }

  .mol-empty-title{
    font-weight:900;
    color:var(--mol-text);
    margin-bottom:8px;
  }

  .mol-empty-sub{
    color:var(--mol-muted);
    max-width:560px;
    margin:0 auto;
    line-height:1.6;
  }

  .mol-swal-popup{
    border-radius:22px !important;
    box-shadow:0 30px 80px rgba(2,6,23,.18) !important;
    padding:1.5rem 1.25rem 1.25rem !important;
  }

  .mol-swal-confirm,
  .mol-swal-cancel{
    border-radius:14px !important;
    font-weight:900 !important;
    padding:10px 18px !important;
    box-shadow:none !important;
  }

  .mol-swal-cancel{
    color:#0f172a !important;
  }

  /* Visionneuse / diaporama */
  .mol-lightbox{
    position:fixed;
    inset:0;
    z-index:99999;
    display:none;
    align-items:center;
    justify-content:center;
    background:rgba(2,6,23,.86);
    backdrop-filter:blur(10px);
    padding:18px;
  }

  .mol-lightbox.is-open{
    display:flex;
  }

  .mol-lightbox-dialog{
    position:relative;
    width:min(1100px, 100%);
    max-height:100%;
    display:flex;
    flex-direction:column;
    gap:12px;
  }

  .mol-lightbox-topbar{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    color:#fff;
  }

  .mol-lightbox-counter{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:8px 14px;
    border-radius:999px;
    background:rgba(255,255,255,.12);
    border:1px solid rgba(255,255,255,.16);
    font-weight:800;
  }

  .mol-lightbox-close{
    width:46px;
    height:46px;
    border-radius:14px;
    border:1px solid rgba(255,255,255,.18);
    background:rgba(255,255,255,.12);
    color:#fff;
    display:grid;
    place-items:center;
    font-size:1.1rem;
    cursor:pointer;
    transition:.16s ease;
  }

  .mol-lightbox-close:hover{
    background:rgba(255,255,255,.18);
  }

  .mol-lightbox-stage{
    position:relative;
    border-radius:24px;
    overflow:hidden;
    background:rgba(255,255,255,.04);
    border:1px solid rgba(255,255,255,.10);
    min-height:320px;
    display:flex;
    align-items:center;
    justify-content:center;
  }

  .mol-lightbox-img{
    width:100%;
    max-height:78vh;
    object-fit:contain;
    display:block;
    background:#0b1220;
  }

  .mol-lightbox-nav{
    position:absolute;
    top:50%;
    transform:translateY(-50%);
    width:52px;
    height:52px;
    border:none;
    border-radius:16px;
    background:rgba(255,255,255,.14);
    color:#fff;
    display:grid;
    place-items:center;
    font-size:1.2rem;
    cursor:pointer;
    transition:.16s ease;
    backdrop-filter:blur(8px);
  }

  .mol-lightbox-nav:hover{
    background:rgba(255,255,255,.22);
  }

  .mol-lightbox-prev{ left:14px; }
  .mol-lightbox-next{ right:14px; }

  .mol-lightbox-caption{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    flex-wrap:wrap;
    color:#fff;
  }

  .mol-lightbox-caption-main{
    font-weight:800;
    line-height:1.5;
    word-break:break-word;
  }

  .mol-lightbox-strip{
    display:flex;
    gap:10px;
    overflow:auto;
    padding-bottom:4px;
  }

  .mol-lightbox-strip::-webkit-scrollbar{
    height:8px;
  }

  .mol-lightbox-strip::-webkit-scrollbar-thumb{
    background:rgba(255,255,255,.18);
    border-radius:999px;
  }

  .mol-lightbox-thumb{
    width:72px;
    height:72px;
    border-radius:16px;
    overflow:hidden;
    flex:0 0 auto;
    border:2px solid transparent;
    cursor:pointer;
    opacity:.82;
    transition:.16s ease;
    background:rgba(255,255,255,.08);
  }

  .mol-lightbox-thumb img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
  }

  .mol-lightbox-thumb.active{
    border-color:#fff;
    opacity:1;
    transform:translateY(-1px);
  }

  @media (max-width:991.98px){
    .mol-stats{
      grid-template-columns:1fr;
    }
  }

  @media (max-width:767.98px){
    .mol-portfolio-page{
      padding-top:16px;
      padding-bottom:24px;
    }

    .mol-hero{
      padding:18px 14px;
      border-radius:18px;
    }

    .mol-card-body{
      padding:16px 14px;
    }

    .mol-title{
      font-size:1.45rem;
      line-height:1.1;
    }

    .mol-subtitle{
      font-size:.94rem;
      margin-top:10px;
    }

    .mol-actions-top{
      width:100%;
    }

    .mol-actions-top .mol-btn{
      flex:1 1 100%;
      width:100%;
    }

    .mol-gallery-head{
      align-items:flex-start;
      flex-direction:column;
    }

    .mol-pill{
      width:100%;
    }

    .mol-upload-box{
      padding:14px;
    }

    .mol-upload-input .input-group-text{
      min-height:48px;
      border-radius:14px 0 0 14px;
    }

    .mol-upload-input .form-control{
      min-height:48px;
      border-radius:0 14px 14px 0;
    }

    .mol-media-thumb{
      height:215px;
    }

    .mol-media-overlay{
      opacity:1;
      background:linear-gradient(180deg, rgba(2,6,23,.02) 40%, rgba(2,6,23,.58) 100%);
    }

    .mol-media-zoom{
      opacity:1;
      transform:none;
    }

    .mol-btn-glass{
      width:100%;
      justify-content:center;
    }

    .mol-media-sub{
      min-height:auto;
    }

    .mol-media-actions{
      padding:0 14px 14px;
    }

    .mol-lightbox{
      padding:10px;
    }

    .mol-lightbox-dialog{
      gap:10px;
    }

    .mol-lightbox-topbar{
      gap:8px;
    }

    .mol-lightbox-counter{
      font-size:.9rem;
      padding:7px 12px;
    }

    .mol-lightbox-close{
      width:42px;
      height:42px;
      border-radius:12px;
    }

    .mol-lightbox-stage{
      border-radius:18px;
      min-height:240px;
    }

    .mol-lightbox-img{
      max-height:62vh;
    }

    .mol-lightbox-nav{
      width:44px;
      height:44px;
      border-radius:14px;
      font-size:1rem;
    }

    .mol-lightbox-prev{ left:8px; }
    .mol-lightbox-next{ right:8px; }

    .mol-lightbox-thumb{
      width:58px;
      height:58px;
      border-radius:14px;
    }
  }
</style>