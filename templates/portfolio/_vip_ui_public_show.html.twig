
<style>
  :root{
    --mol-bg:#f6f9fe;
    --mol-bg-2:#edf3fb;
    --mol-surface:rgba(255,255,255,.58);
    --mol-surface-2:rgba(255,255,255,.74);
    --mol-surface-3:rgba(247,250,255,.62);
    --mol-border:rgba(15,23,42,.06);
    --mol-border-strong:rgba(59,130,246,.12);
    --mol-text:#0f172a;
    --mol-muted:rgba(15,23,42,.54);
    --mol-primary:#2f6fed;
    --mol-primary-2:#66c7d9;
    --mol-accent:#10b981;
    --mol-dark:#020617;
    --mol-shadow:0 18px 50px rgba(15,23,42,.06);
    --mol-shadow-lg:0 22px 60px rgba(37,99,235,.10);
    --mol-shadow-sm:0 8px 22px rgba(15,23,42,.05);
    --mol-shadow-xs:0 4px 12px rgba(15,23,42,.035);
    --mol-radius-xl:30px;
    --mol-radius-lg:24px;
    --mol-radius-md:18px;
    --mol-radius-sm:14px;
  }

  .mol-page{
    position:relative;
    overflow:hidden;
    padding:30px 0 48px;
    background:
      radial-gradient(1200px circle at 0% 0%, rgba(37,99,235,.12), transparent 44%),
      radial-gradient(900px circle at 100% 10%, rgba(6,182,212,.10), transparent 38%),
      radial-gradient(800px circle at 50% 100%, rgba(16,185,129,.06), transparent 32%),
      linear-gradient(180deg, #fbfdff 0%, var(--mol-bg) 100%);
  }

  .mol-page::before,
  .mol-page::after{
    content:"";
    position:absolute;
    border-radius:999px;
    pointer-events:none;
    filter:blur(10px);
    opacity:.40;
  }

  .mol-page::before{
    width:220px;
    height:220px;
    top:40px;
    right:-70px;
    background:radial-gradient(circle, rgba(37,99,235,.16), transparent 70%);
  }

  .mol-page::after{
    width:260px;
    height:260px;
    bottom:80px;
    left:-80px;
    background:radial-gradient(circle, rgba(16,185,129,.10), transparent 70%);
  }

  .mol-shell{
    position:relative;
    z-index:2;
    display:flex;
    flex-direction:column;
    gap:20px;
  }

  .mol-glass{
    background:linear-gradient(180deg, rgba(255,255,255,.54), rgba(255,255,255,.42));
    backdrop-filter:blur(18px);
    -webkit-backdrop-filter:blur(18px);
    border:1px solid rgba(255,255,255,.34);
    box-shadow:var(--mol-shadow);
  }

  .mol-card{
    border-radius:var(--mol-radius-xl);
    overflow:hidden;
    border:1px solid var(--mol-border);
    background:linear-gradient(180deg, rgba(255,255,255,.82), rgba(250,252,255,.68));
    box-shadow:var(--mol-shadow-sm);
  }

  .mol-hero{
    position:relative;
    overflow:hidden;
    border-radius:34px;
    padding:26px;
    border:1px solid rgba(255,255,255,.40);
    background:
      radial-gradient(1000px circle at 10% 10%, rgba(37,99,235,.12), transparent 52%),
      radial-gradient(800px circle at 90% 0%, rgba(6,182,212,.09), transparent 48%),
      linear-gradient(145deg, rgba(255,255,255,.76), rgba(248,251,255,.56));
    box-shadow:var(--mol-shadow-lg);
  }

  .mol-hero::before{
    content:"";
    position:absolute;
    inset:0;
    background:
      linear-gradient(135deg, rgba(255,255,255,.30), transparent 32%),
      radial-gradient(500px circle at 80% 20%, rgba(255,255,255,.16), transparent 55%);
    pointer-events:none;
  }

  .mol-hero-grid{
    position:relative;
    z-index:2;
    display:grid;
    grid-template-columns:minmax(0,1.35fr) minmax(320px,.9fr);
    gap:22px;
    align-items:stretch;
  }

  .mol-hero-left{
    min-width:0;
  }

  .mol-kicker{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:6px 11px;
    border-radius:999px;
    font-size:.76rem;
    font-weight:800;
    color:var(--mol-primary);
    border:1px solid rgba(37,99,235,.10);
    background:rgba(255,255,255,.46);
    box-shadow:var(--mol-shadow-xs);
    margin-bottom:14px;
  }

  .mol-title{
    margin:0;
    color:var(--mol-text);
    font-size:clamp(1.85rem, 3vw, 2.75rem);
    line-height:1.02;
    letter-spacing:-.05em;
    font-weight:900;
    max-width:820px;
  }

  .mol-sub{
    margin-top:14px;
    color:var(--mol-muted);
    font-size:.97rem;
    line-height:1.72;
    max-width:760px;
    font-weight:500;
  }

  .mol-hero-tags{
  position:relative;
  z-index:3;
  display:flex;
  flex-wrap:wrap;
  gap:9px;
  margin-top:18px;
  }

    .mol-chip{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:8px 12px;
    border-radius:999px;
    border:1px solid rgba(15,23,42,.10);
    background:rgba(255,255,255,.88) !important;
    color:#0f172a !important;
    font-size:.84rem;
    font-weight:800;
    box-shadow:0 6px 18px rgba(15,23,42,.06);
    white-space:nowrap;
    position:relative;
    z-index:3;
  }

    .mol-chip i{
    color:#2563eb !important;
  }

  .mol-chip,
  .mol-chip *{
    text-shadow:none !important;
  }

    .mol-hero-actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      margin-top:22px;
    }

    .mol-btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      min-height:40px;
      padding:9px 14px;
      border-radius:13px;
      border:1px solid rgba(15,23,42,.07);
      font-weight:800;
      font-size:.88rem;
      letter-spacing:.01em;
      text-decoration:none;
      white-space:nowrap;
      transition:transform .16s ease, box-shadow .16s ease, background .16s ease, border-color .16s ease, color .16s ease, opacity .16s ease;
      box-shadow:var(--mol-shadow-xs);
    }

    .mol-btn:hover{
      transform:translateY(-1px);
      text-decoration:none;
    }

    .mol-btn-primary{
      color:#f8fbff;
      border-color:rgba(37,99,235,.12);
      background:linear-gradient(135deg, rgba(47,111,237,.88), rgba(102,199,217,.80));
      box-shadow:0 10px 24px rgba(37,99,235,.14);
    }

    .mol-btn-primary:hover{
      color:#fff;
      box-shadow:0 14px 26px rgba(37,99,235,.16);
    }

    .mol-btn-light{
      color:var(--mol-text);
      background:linear-gradient(180deg, rgba(255,255,255,.50), rgba(248,251,255,.40));
      border-color:rgba(15,23,42,.06);
      box-shadow:var(--mol-shadow-xs);
    }

    .mol-btn-light:hover{
      background:linear-gradient(180deg, rgba(255,255,255,.62), rgba(248,251,255,.50));
    }

    .mol-hero-right{
      display:flex;
      flex-direction:column;
      gap:14px;
      min-width:0;
    }

    .mol-profile-card{
      position:relative;
      overflow:hidden;
      padding:18px;
      border-radius:24px;
      background:linear-gradient(180deg, rgba(255,255,255,.50), rgba(248,251,255,.40));
      border:1px solid rgba(255,255,255,.34);
      backdrop-filter:blur(14px);
      box-shadow:var(--mol-shadow);
    }

    .mol-profile-top{
      display:flex;
      align-items:center;
      gap:14px;
      margin-bottom:14px;
    }

    .mol-avatar{
      width:84px;
      height:84px;
      border-radius:22px;
      object-fit:cover;
      border:1px solid rgba(255,255,255,.82);
      box-shadow:0 14px 26px rgba(15,23,42,.11);
      background:#fff;
      flex:0 0 auto;
    }

    .mol-profile-name{
      font-size:1.04rem;
      font-weight:900;
      color:var(--mol-text);
      line-height:1.2;
    }

    .mol-profile-meta{
      margin-top:4px;
      color:var(--mol-muted);
      font-size:.89rem;
      font-weight:700;
      line-height:1.5;
    }

    .mol-mini-stats{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:10px;
    }

    .mol-mini-stat{
      border-radius:16px;
      padding:13px;
      background:linear-gradient(180deg, rgba(255,255,255,.48), rgba(248,251,255,.36));
      border:1px solid rgba(15,23,42,.05);
      box-shadow:var(--mol-shadow-xs);
    }

  .mol-mini-label{
    color:var(--mol-muted);
    font-size:.79rem;
    font-weight:800;
    margin-bottom:6px;
  }

  .mol-mini-value{
    color:var(--mol-text);
    font-size:1.28rem;
    line-height:1;
    font-weight:900;
  }

  .mol-mini-icon{
    width:34px;
    height:34px;
    border-radius:12px;
    display:grid;
    place-items:center;
    background:rgba(37,99,235,.08);
    color:var(--mol-primary);
    border:1px solid rgba(37,99,235,.10);
    margin-left:auto;
    margin-bottom:8px;
  }

  .mol-upload-card{
    padding:18px;
  }

  .mol-card-head{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    flex-wrap:wrap;
    margin-bottom:16px;
  }

  .mol-card-title{
    margin:0;
    color:var(--mol-text);
    font-weight:900;
    letter-spacing:-.02em;
  }

  .mol-soft,
  .mol-shot-meta,
  .mol-lightbox-sub{
    color:var(--mol-muted);
  }

  .mol-dropzone{
    position:relative;
    overflow:hidden;
    border:1px dashed rgba(37,99,235,.16);
    border-radius:22px;
    padding:18px;
    background:
      radial-gradient(900px circle at 10% 0%, rgba(37,99,235,.05), transparent 52%),
      linear-gradient(180deg, rgba(255,255,255,.72), rgba(248,250,252,.58));
    transition:.22s ease;
  }

  .mol-dropzone.is-dragover{
    border-color:rgba(37,99,235,.28);
    box-shadow:0 0 0 4px rgba(37,99,235,.04);
    transform:translateY(-1px);
  }

  .mol-dropzone::after{
    content:"";
    position:absolute;
    width:180px;
    height:180px;
    right:-40px;
    bottom:-40px;
    border-radius:50%;
    background:radial-gradient(circle, rgba(37,99,235,.08), transparent 70%);
    pointer-events:none;
  }

  .mol-drop-inner{
    position:relative;
    z-index:2;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:18px;
    flex-wrap:wrap;
  }

  .mol-drop-icon{
    width:52px;
    height:52px;
    border-radius:16px;
    display:grid;
    place-items:center;
    background:linear-gradient(135deg, rgba(37,99,235,.08), rgba(6,182,212,.06));
    color:var(--mol-primary);
    border:1px solid rgba(37,99,235,.10);
    box-shadow:var(--mol-shadow-xs);
    font-size:1.15rem;
    flex:0 0 auto;
  }

  .mol-drop-copy{
    flex:1 1 280px;
    min-width:0;
  }

  .mol-drop-title{
    color:var(--mol-text);
    font-size:1rem;
    font-weight:900;
    margin-bottom:4px;
  }

  .mol-drop-sub{
    color:var(--mol-muted);
    font-weight:600;
    line-height:1.62;
  }

  .mol-selected-files{
    margin-top:14px;
    display:none;
    flex-wrap:wrap;
    gap:8px;
    position:relative;
    z-index:2;
  }

  .mol-selected-files.is-visible{ display:flex; }

  .mol-file-pill{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:7px 10px;
    border-radius:999px;
    background:rgba(255,255,255,.62);
    border:1px solid rgba(15,23,42,.05);
    box-shadow:var(--mol-shadow-xs);
    font-weight:800;
    font-size:.82rem;
    color:var(--mol-text);
    max-width:100%;
  }

  .mol-file-pill span{
    max-width:240px;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
    display:inline-block;
  }

  .mol-hidden-input{
    position:absolute !important;
    inset:0 !important;
    width:100% !important;
    height:100% !important;
    opacity:0 !important;
    cursor:pointer !important;
  }

  .mol-gallery-card{
    padding:18px;
  }

  .mol-gallery-top{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:14px;
    flex-wrap:wrap;
    margin-bottom:16px;
  }

  .mol-gallery-right{
    display:flex;
    align-items:center;
    gap:10px;
    flex-wrap:wrap;
  }

  .mol-counter-pill{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:7px 11px;
    border-radius:999px;
    background:rgba(255,255,255,.48);
    border:1px solid rgba(15,23,42,.06);
    font-weight:800;
    font-size:.83rem;
    color:var(--mol-text);
    box-shadow:var(--mol-shadow-xs);
  }

  .mol-counter-value{
    display:inline-block;
    min-width:22px;
    text-align:center;
  }

  .mol-masonry{
    column-gap:16px;
    columns:1;
  }

  .mol-masonry-item{
    break-inside:avoid;
    -webkit-column-break-inside:avoid;
    margin-bottom:16px;
  }

  @media (min-width:640px){
    .mol-masonry{ columns:2; }
  }
  @media (min-width:1100px){
    .mol-masonry{ columns:3; }
  }
  @media (min-width:1500px){
    .mol-masonry{ columns:4; }
  }

  .mol-shot{
    position:relative;
    overflow:hidden;
    border-radius:22px;
    background:linear-gradient(180deg, rgba(255,255,255,.82), rgba(250,252,255,.66));
    border:1px solid rgba(15,23,42,.06);
    box-shadow:0 10px 24px rgba(15,23,42,.06);
    cursor:pointer;
    opacity:0;
    transform:translateY(24px);
    transition:transform .24s ease, box-shadow .24s ease, opacity .55s ease;
  }

  .mol-shot.is-visible{
    opacity:1;
    transform:translateY(0);
  }

  .mol-shot:hover{
    transform:translateY(-3px);
    box-shadow:0 16px 34px rgba(15,23,42,.09);
  }

  .mol-shot-media{
    position:relative;
    overflow:hidden;
    background:linear-gradient(180deg, #f8fbff, #eef4fb);
  }

  .mol-shot-media img{
    display:block;
    width:100%;
    height:auto;
    transform:scale(1);
    transition:transform .45s ease, filter .25s ease;
    filter:saturate(1.02) contrast(1.01);
  }

  .mol-shot:hover .mol-shot-media img{
    transform:scale(1.04);
  }

  .mol-shot-overlay{
    position:absolute;
    inset:0;
    background:
      linear-gradient(180deg, rgba(2,6,23,0) 38%, rgba(2,6,23,.68) 100%);
    opacity:0;
    transition:opacity .22s ease;
  }

  .mol-shot:hover .mol-shot-overlay{
    opacity:1;
  }

  .mol-shot-top{
    position:absolute;
    top:12px;
    left:12px;
    right:12px;
    z-index:2;
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:8px;
  }

  .mol-shot-top{
  position:absolute;
  top:12px;
  left:12px;
  right:12px;
  z-index:4;
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:8px;
  }

  .mol-badge{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:6px 10px;
    border-radius:999px;
    font-size:.74rem;
    font-weight:900;
    white-space:nowrap;
    box-shadow:0 8px 18px rgba(2,6,23,.14);
    text-shadow:none !important;
  }

  .mol-badge-light{
    background:rgba(255,255,255,.96) !important;
    color:#0f172a !important;
    border:1px solid rgba(15,23,42,.10) !important;
  }

  .mol-badge-light i{
    color:#2563eb !important;
  }

  .mol-badge-green{
    background:#10b981 !important;
    color:#ffffff !important;
    border:1px solid rgba(0,0,0,.06) !important;
  }

  .mol-badge-green i{
    color:#ffffff !important;
  }

  .mol-badge,
  .mol-badge span,
  .mol-badge i{
    opacity:1 !important;
    filter:none !important;
  }

    .mol-shot-bottom{
      position:absolute;
      left:12px;
      right:12px;
      bottom:12px;
      z-index:2;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      opacity:0;
      transform:translateY(10px);
      transition:all .22s ease;
    }

    .mol-shot:hover .mol-shot-bottom{
      opacity:1;
      transform:translateY(0);
    }

    .mol-shot-open{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:7px 11px;
      border-radius:999px;
      background:rgba(255,255,255,.64);
      color:var(--mol-text);
      border:1px solid rgba(255,255,255,.36);
      font-weight:800;
      font-size:.81rem;
      box-shadow:0 8px 18px rgba(2,6,23,.07);
    }

    .mol-shot-info{
      padding:13px 13px 15px;
    }

    .mol-shot-title{
      margin:0 0 4px;
      font-size:.96rem;
      font-weight:900;
      color:var(--mol-text);
      line-height:1.3;
    }

    .mol-shot-meta{
      font-size:.85rem;
      font-weight:650;
      line-height:1.56;
      word-break:break-word;
    }

    .mol-empty{
      border:1px dashed rgba(15,23,42,.10);
      border-radius:24px;
      background:rgba(255,255,255,.62);
      padding:38px 20px;
      text-align:center;
    }

    .mol-empty-icon{
      width:70px;
      height:70px;
      margin:0 auto 14px;
      border-radius:20px;
      display:grid;
      place-items:center;
      color:var(--mol-primary);
      background:rgba(37,99,235,.07);
      font-size:1.45rem;
      box-shadow:var(--mol-shadow-xs);
    }

    .mol-empty-title{
      margin-bottom:8px;
      color:var(--mol-text);
      font-size:1.02rem;
      font-weight:900;
    }

    .mol-empty-sub{
      max-width:560px;
      margin:0 auto;
      color:var(--mol-muted);
      line-height:1.65;
      font-weight:600;
    }

    .mol-lightbox{
      position:fixed;
      inset:0;
      z-index:99999;
      opacity:0;
      visibility:hidden;
      pointer-events:none;
      background:
        radial-gradient(1000px circle at 20% 0%, rgba(37,99,235,.10), transparent 50%),
        radial-gradient(1000px circle at 100% 10%, rgba(6,182,212,.08), transparent 45%),
        rgba(2,6,23,.94);
      backdrop-filter:blur(20px);
      -webkit-backdrop-filter:blur(20px);
      padding:14px;
      transition:opacity .22s ease, visibility .22s ease;
    }

    .mol-lightbox.is-open{
      opacity:1;
      visibility:visible;
      pointer-events:auto;
    }

    body.mol-no-scroll{
      overflow:hidden !important;
    }

    .mol-lightbox-shell{
      height:100%;
      display:grid;
      grid-template-rows:auto auto 1fr auto auto;
      gap:12px;
    }

    .mol-lightbox-toolbar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      flex-wrap:wrap;
    }

    .mol-lightbox-left,
    .mol-lightbox-right{
      display:flex;
      align-items:center;
      gap:8px;
      flex-wrap:wrap;
    }

    .mol-lb-btn{
      width:40px;
      height:40px;
      border:none;
      border-radius:13px;
      background:rgba(255,255,255,.07);
      color:rgba(255,255,255,.92);
      display:grid;
      place-items:center;
      cursor:pointer;
      transition:.18s ease;
      backdrop-filter:blur(10px);
      box-shadow:none;
    }

    .mol-lb-btn:hover{
      background:rgba(255,255,255,.12);
    }

    .mol-lb-counter{
      display:inline-flex;
      align-items:center;
      gap:8px;
      min-height:40px;
      padding:0 13px;
      border-radius:999px;
      border:1px solid rgba(255,255,255,.09);
      background:rgba(255,255,255,.06);
      color:#fff;
      font-weight:800;
      font-size:.84rem;
      backdrop-filter:blur(10px);
    }

    .mol-lb-counter.is-bump{
      animation:molBump .34s ease;
    }

    @keyframes molBump{
      0%{ transform:scale(.94); opacity:.78; }
      60%{ transform:scale(1.08); opacity:1; }
      100%{ transform:scale(1); opacity:1; }
    }

    .mol-progress{
      width:100%;
      height:5px;
      border-radius:999px;
      overflow:hidden;
      background:rgba(255,255,255,.08);
      border:1px solid rgba(255,255,255,.05);
    }

    .mol-progress-bar{
      width:0%;
      height:100%;
      border-radius:999px;
      background:linear-gradient(90deg, #60a5fa, #34d399);
      transition:width .16s linear;
    }

    .mol-lightbox-stage{
      position:relative;
      min-height:0;
      overflow:hidden;
      border-radius:28px;
      border:1px solid rgba(255,255,255,.08);
      background:rgba(255,255,255,.025);
      display:flex;
      align-items:center;
      justify-content:center;
      touch-action:pan-y;
      box-shadow:0 18px 60px rgba(0,0,0,.20);
    }

    .mol-lightbox-image-wrap{
      width:100%;
      height:100%;
      display:flex;
      align-items:center;
      justify-content:center;
      overflow:hidden;
    }

    .mol-lightbox-img{
      max-width:100%;
      max-height:72vh;
      object-fit:contain;
      user-select:none;
