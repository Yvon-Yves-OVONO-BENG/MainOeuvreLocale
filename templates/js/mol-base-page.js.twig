            (() => {
                if (window.__MOL_CHAT_CLEAN_UNIQUE_PATCH__) return;
                window.__MOL_CHAT_CLEAN_UNIQUE_PATCH__ = true;

                const PATCH = {
                    menus: new Set(),
                    original: {}
                };

                function qs(id){
                    return document.getElementById(id);
                }

                function qsa(sel, root = document){
                    return Array.from(root.querySelectorAll(sel));
                }

                function isDesktop(){
                    return window.matchMedia && window.matchMedia('(min-width: 992px)').matches;
                }

                function debounce(fn, wait = 220){
                    let t;
                    return (...args) => {
                        clearTimeout(t);
                        t = setTimeout(() => fn(...args), wait);
                    };
                }

                function getToastConvId(toast){
                    if (!toast || !toast.id) return 0;
                    return Number(String(toast.id).replace('molToast-', '')) || 0;
                }

                function getThreadConvId(){
                    return Number(qs('molChatThread')?.dataset?.conversationId || 0);
                }

                function filterLocalConversations(query){
                    const list = qs('molChatList');
                    if (!list) return;

                    const items = qsa('.mol-chat-item', list);
                    if (!items.length) return;

                    const q = String(query || '').trim().toLowerCase();
                    let visible = 0;

                    items.forEach((item) => {
                        const name = String(item.dataset.name || '').toLowerCase();
                        const text = String(item.textContent || '').toLowerCase();
                        const match = !q || name.includes(q) || text.includes(q);
                        item.style.display = match ? '' : 'none';
                        if (match) visible++;
                    });

                    let empty = qs('molChatSearchEmptyState');

                    if (!visible) {
                        if (!empty) {
                            empty = document.createElement('li');
                            empty.id = 'molChatSearchEmptyState';
                            empty.className = 'text-secondary small py-3';
                            empty.textContent = 'Aucune conversation trouvée.';
                            list.appendChild(empty);
                        }
                    } else if (empty) {
                        empty.remove();
                    }
                }

                function setDockShift(){
                    const panel = qs('molChatPanel');
                    let shift = 0;

                    if (isDesktop() && panel && panel.classList.contains('is-open')) {
                        shift = Math.ceil(panel.getBoundingClientRect().width || 390) + 16;
                    }

                    document.documentElement.style.setProperty('--mol-chat-dock-shift', shift + 'px');

                    const dock = qs('molChatToasts');
                    if (dock && isDesktop()) {
                        requestAnimationFrame(() => {
                            dock.scrollLeft = dock.scrollWidth;
                        });
                    }
                }

                function closePanelMenu(){
                    const menu = qs('molChatPanelMenu');
                    const btn = qs('molChatPanelOptionsBtn');

                    if (menu) menu.classList.remove('is-open');
                    if (btn) btn.setAttribute('aria-expanded', 'false');
                }

                function ensurePanelMenu(){
                    const panel = qs('molChatPanel');
                    const header = panel?.querySelector('.mol-chat-panel__header');
                    if (!panel || !header) return;

                    const closeBtn = header.querySelector('.mol-btn-icon[onclick*="MOLChatClose"]');
                    if (!closeBtn) return;

                    let actions = header.querySelector('.mol-panel-actions');
                    if (!actions) {
                        actions = document.createElement('div');
                        actions.className = 'mol-panel-actions';
                        header.appendChild(actions);
                    }

                    let optionsBtn = qs('molChatPanelOptionsBtn');
                    if (!optionsBtn) {
                        optionsBtn = document.createElement('button');
                        optionsBtn.type = 'button';
                        optionsBtn.id = 'molChatPanelOptionsBtn';
                        optionsBtn.className = 'mol-btn-icon';
                        optionsBtn.setAttribute('aria-label', 'Options');
                        optionsBtn.setAttribute('aria-expanded', 'false');
                        optionsBtn.innerHTML = '<i class="bi bi-three-dots"></i>';
                        actions.appendChild(optionsBtn);
                    }

                    if (closeBtn.parentElement !== actions) {
                        actions.appendChild(closeBtn);
                    }

                    let menu = qs('molChatPanelMenu');
                    if (!menu) {
                        menu = document.createElement('div');
                        menu.id = 'molChatPanelMenu';
                        menu.className = 'mol-panel-menu';
                        menu.innerHTML = `
                            <button type="button" class="mol-panel-menu__item" data-action="mark_all_read">
                                <i class="bi bi-check2-square"></i>
                                <span>Tout marquer comme lu</span>
                            </button>

                            <button type="button" class="mol-panel-menu__item" data-action="chat_setting">
                                <i class="bi bi-gear"></i>
                                <span>Paramètres du chat</span>
                            </button>

                            <button type="button" class="mol-panel-menu__item" data-action="disable_notifications">
                                <i class="bi bi-bell-slash"></i>
                                <span>Désactiver les notifications</span>
                            </button>

                            <button type="button" class="mol-panel-menu__item" data-action="message_sounds">
                                <i class="bi bi-volume-up"></i>
                                <span>Sons des messages</span>
                            </button>

                            <button type="button" class="mol-panel-menu__item" data-action="block_setting">
                                <i class="bi bi-slash-circle"></i>
                                <span>Réglages de blocage</span>
                            </button>

                            <div class="mol-panel-menu__divider"></div>

                            <button type="button" class="mol-panel-menu__item" data-action="create_group_chat">
                                <i class="bi bi-people"></i>
                                <span>Créer un groupe</span>
                            </button>
                        `;
                        document.body.appendChild(menu);
                    }

                    if (!optionsBtn.__molPanelBound) {
                        optionsBtn.__molPanelBound = true;

                        optionsBtn.addEventListener('click', (e) => {
                            e.preventDefault();
                            e.stopPropagation();

                            const isOpen = menu.classList.contains('is-open');
                            closePanelMenu();

                            if (isOpen) return;

                            const rect = optionsBtn.getBoundingClientRect();
                            menu.style.left = Math.max(10, rect.right - 250) + 'px';
                            menu.style.top = (rect.bottom + 8) + 'px';
                            menu.classList.add('is-open');
                            optionsBtn.setAttribute('aria-expanded', 'true');
                        });
                    }

                    if (!menu.__molPanelActionsBound) {
                        menu.__molPanelActionsBound = true;

                        menu.addEventListener('click', async (e) => {
                            const item = e.target.closest('[data-action]');
                            if (!item) return;

                            const action = item.dataset.action;
                            closePanelMenu();

                            if (typeof window.MOLChatPanelAction === 'function') {
                                window.MOLChatPanelAction(action);
                                return;
                            }

                            if (action === 'mark_all_read' && typeof window.MOLChatRefreshList === 'function') {
                                await window.MOLChatRefreshList(qs('molChatSearch')?.value?.trim() || '');
                                return;
                            }

                            console.log('[MOL CHAT PANEL ACTION]', action);
                        });
                    }
                }

                function bindMinimizeButtons(root = document){
                    qsa('#molChatToasts .toast', root).forEach((toast) => {
                        if (toast.__molMinimizeBound) return;
                        toast.__molMinimizeBound = true;

                        const btn =
                            toast.querySelector('a[href^="#molToastBody-"]') ||
                            toast.querySelector('[data-bs-toggle="collapse"]');

                        if (!btn) return;

                        btn.removeAttribute('data-bs-toggle');
                        btn.removeAttribute('data-bs-target');
                        btn.setAttribute('href', '#');
                        btn.dataset.molRole = 'minimize';

                        btn.addEventListener('click', (e) => {
                            e.preventDefault();
                            e.stopPropagation();
                            e.stopImmediatePropagation();

                            toast.classList.toggle('mol-toast-mini');
                            setDockShift();
                        }, true);
                    });
                }

                function enhanceComposerRow(row){
                    if (!row || row.__molComposerEnhanced) return;
                    row.__molComposerEnhanced = true;

                    let toggle = row.querySelector('.mol-more-toggle');
                    if (!toggle) {
                        toggle = document.createElement('button');
                        toggle.type = 'button';
                        toggle.className = 'mol-more-toggle';
                        toggle.innerHTML = '<i class="bi bi-chevron-right"></i>';
                        toggle.title = 'Plus d’options';
                        row.insertBefore(toggle, row.firstElementChild);
                    }

                    toggle.addEventListener('click', (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        row.classList.toggle('is-open');
                    });

                    const input = row.querySelector('.mol-compose__input');
                    const likeBtn = row.querySelector('.mol-like-btn');
                    const sendBtn = row.querySelector('.mol-send-btn');

                    if (input && likeBtn && sendBtn && !input.__molSyncBound) {
                        input.__molSyncBound = true;

                        const sync = () => {
                            const hasContent = (input.value || '').replace(/\s/g, '').length > 0;
                            likeBtn.classList.toggle('mol-hidden', hasContent);
                            sendBtn.classList.toggle('mol-hidden', !hasContent);
                        };

                        input.addEventListener('input', sync);
                        sync();
                    }
                }

                function enhanceComposers(root = document){
                    qsa('.mol-bottombar__row', root).forEach(enhanceComposerRow);
                }

                function closeAllPortalMenus(except = null){
                    PATCH.menus.forEach((menu) => {
                        if (menu === except) return;
                        menu.classList.remove('show');
                        menu.style.display = 'none';
                        menu.style.left = '';
                        menu.style.top = '';
                        const toggle = menu.__molToggle;
                        if (toggle) toggle.setAttribute('aria-expanded', 'false');
                    });
                }

                function getToggleMenu(toggle){
                    if (!toggle) return null;
                    if (toggle.__molPortalMenu) return toggle.__molPortalMenu;

                    const menu =
                        toggle.parentElement?.querySelector('.dropdown-menu') ||
                        (toggle.id ? document.querySelector(`.dropdown-menu[aria-labelledby="${toggle.id}"]`) : null);

                    if (menu) {
                        toggle.__molPortalMenu = menu;
                        menu.__molToggle = toggle;
                    }

                    return menu || null;
                }

                function placePortalMenu(toggle, menu){
                    menu.style.setProperty('position', 'fixed', 'important');
                    menu.style.setProperty('display', 'block', 'important');
                    menu.style.setProperty('visibility', 'hidden', 'important');
                    menu.style.setProperty('transform', 'none', 'important');
                    menu.style.setProperty('right', 'auto', 'important');
                    menu.style.setProperty('bottom', 'auto', 'important');
                    menu.style.setProperty('z-index', '2147483647', 'important');
                    menu.style.setProperty('box-sizing', 'border-box', 'important');
                    menu.classList.add('show');

                    const rect = toggle.getBoundingClientRect();
                    const surface = toggle.closest('#molChatPanel, #molChatToasts .toast');
                    const surfaceRect = surface?.getBoundingClientRect?.() || rect;
                    const visual = window.visualViewport;
                    const viewportLeft = visual?.offsetLeft || 0;
                    const viewportTop = visual?.offsetTop || 0;
                    const viewportWidth = visual?.width || document.documentElement.clientWidth || window.innerWidth;
                    const viewportHeight = visual?.height || document.documentElement.clientHeight || window.innerHeight;
                    const margin = 10;
                    const usableLeft = Math.max(viewportLeft + margin, surfaceRect.left + margin);
                    const usableRight = Math.min(viewportLeft + viewportWidth - margin, surfaceRect.right - margin);
                    const usableWidth = Math.max(160, usableRight - usableLeft);
                    const width = Math.max(160, Math.min(278, viewportWidth - (margin * 2), usableWidth));
                    const maxHeight = Math.max(120, viewportHeight - (margin * 2));

                    menu.style.width = width + 'px';
                    menu.style.maxWidth = `calc(100vw - ${margin * 2}px)`;
                    menu.style.maxHeight = maxHeight + 'px';
                    menu.style.overflowY = 'auto';
                    menu.style.overflowX = 'hidden';
                    menu.querySelectorAll('.dropdown-item').forEach((item) => {
                        item.style.whiteSpace = 'nowrap';
                        item.style.overflowWrap = 'normal';
                    });

                    const height = Math.min(Math.ceil(menu.scrollHeight || menu.getBoundingClientRect().height || 260), maxHeight);
                    const horizontalSpare = Math.max(0, usableWidth - width);
                    const rightInset = Math.min(44, horizontalSpare / 2);
                    const left = Math.max(usableLeft, usableRight - rightInset - width);

                    let top = rect.bottom + 8;
                    if (top + height > viewportTop + viewportHeight - margin) {
                        top = rect.top - height - 8;
                    }
                    top = Math.max(
                        viewportTop + margin,
                        Math.min(viewportTop + viewportHeight - height - margin, top)
                    );

                    menu.style.left = left + 'px';
                    menu.style.top = top + 'px';
                    menu.style.setProperty('visibility', 'visible', 'important');
                }

                function bindPortalDropdown(toggle){
                    if (!toggle || toggle.__molPortalBound) return;
                    toggle.__molPortalBound = true;

                    const menu = getToggleMenu(toggle);
                    if (!menu) return;

                    menu.classList.add('mol-chat-portal-menu');
                    PATCH.menus.add(menu);

                    toggle.addEventListener('click', (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        e.stopImmediatePropagation();

                        const isOpen = menu.classList.contains('show');

                        closeAllPortalMenus(menu);

                        if (isOpen) {
                            menu.classList.remove('show');
                            menu.style.display = 'none';
                            toggle.setAttribute('aria-expanded', 'false');
                            return;
                        }

                        if (menu.parentElement !== document.body) {
                            document.body.appendChild(menu);
                        }

                        const toast = toggle.closest('.toast');
                        const convId = toast ? getToastConvId(toast) : getThreadConvId();
                        menu.dataset.conversationId = String(convId || 0);
                        menu.__molToggle = toggle;

                        toggle.setAttribute('aria-expanded', 'true');
                        placePortalMenu(toggle, menu);
                    }, true);
                }

                function bindPortalDropdowns(root = document){
                    qsa(
                        '#molChatToasts [data-bs-toggle="dropdown"], #molChatThread [data-bs-toggle="dropdown"]',
                        root
                    ).forEach(bindPortalDropdown);
                }

                function bindPortalActions(){
                    if (document.__molPortalActionsBound) return;
                    document.__molPortalActionsBound = true;

                    document.addEventListener('click', (e) => {
                        const item = e.target.closest('.mol-chat-portal-menu .dropdown-item');
                        if (!item) return;

                        const menu = item.closest('.mol-chat-portal-menu');
                        const convId = Number(menu?.dataset?.conversationId || 0);
                        const callType = item.dataset.callType;
                        const chatAction = item.dataset.chatAction;

                        if (callType) {
                            e.preventDefault();
                            e.stopPropagation();
                            e.stopImmediatePropagation();
                            closeAllPortalMenus();

                            if (convId && typeof window.MOLStartConversationCall === 'function') {
                                window.MOLStartConversationCall(convId, callType);
                            }
                            return;
                        }

                        if (chatAction) {
                            e.preventDefault();
                            e.stopPropagation();
                            e.stopImmediatePropagation();
                            closeAllPortalMenus();

                            if (convId && typeof window.MOLChatRunAction === 'function') {
                                window.MOLChatRunAction(e, convId, chatAction);
                            }
                            return;
                        }

                        setTimeout(() => closeAllPortalMenus(), 0);
                    }, true);

                    document.addEventListener('click', (e) => {
                        if (e.target.closest('.mol-chat-portal-menu')) return;

                        const toggle = e.target.closest('#molChatToasts [data-bs-toggle="dropdown"], #molChatThread [data-bs-toggle="dropdown"]');
                        if (toggle) return;

                        closeAllPortalMenus();
                    });

                    document.addEventListener('keydown', (e) => {
                        if (e.key === 'Escape') {
                            closeAllPortalMenus();
                            closePanelMenu();
                        }
                    });

                    window.addEventListener('resize', () => {
                        closeAllPortalMenus();
                        closePanelMenu();
                        setDockShift();
                    });

                    window.addEventListener('scroll', () => {
                        closeAllPortalMenus();
                        closePanelMenu();
                    }, true);
                }

                function bindSearchFix(){
                    const input = qs('molChatSearch');
                    if (!input || input.__molSearchBound) return;
                    input.__molSearchBound = true;

                    const localOnly = () => filterLocalConversations(input.value.trim());
                    input.addEventListener('input', localOnly);
                    input.addEventListener('keyup', localOnly);
                    input.addEventListener('search', localOnly);
                }

                function patchRefreshList(){
                    if (typeof window.MOLChatRefreshList !== 'function') return;
                    if (window.MOLChatRefreshList.__molPatched) return;

                    const oldRefresh = window.MOLChatRefreshList;
                    const wrapped = async function(...args){
                        const result = await oldRefresh.apply(this, args);
                        filterLocalConversations(qs('molChatSearch')?.value?.trim() || '');
                        enhanceAll(qs('molChatPanel') || document);
                        setDockShift();
                        return result;
                    };

                    wrapped.__molPatched = true;
                    window.MOLChatRefreshList = wrapped;
                }

                function patchOpenClose(){
                    if (typeof window.MOLChatOpen === 'function' && !window.MOLChatOpen.__molPatched) {
                        const oldOpen = window.MOLChatOpen;
                        const wrapped = async function(...args){
                            const r = await oldOpen.apply(this, args);
                            ensurePanelMenu();
                            enhanceAll(document);
                            setDockShift();
                            return r;
                        };
                        wrapped.__molPatched = true;
                        window.MOLChatOpen = wrapped;
                    }

                    if (typeof window.MOLChatClose === 'function' && !window.MOLChatClose.__molPatched) {
                        const oldClose = window.MOLChatClose;
                        const wrapped = function(...args){
                            const r = oldClose.apply(this, args);
                            closePanelMenu();
                            closeAllPortalMenus();
                            setDockShift();
                            return r;
                        };
                        wrapped.__molPatched = true;
                        window.MOLChatClose = wrapped;
                    }

                    if (typeof window.MOLChatOpenBubble === 'function' && !window.MOLChatOpenBubble.__molPatched) {
                        const oldOpenBubble = window.MOLChatOpenBubble;
                        const wrapped = async function(...args){
                            setDockShift();
                            const r = await oldOpenBubble.apply(this, args);
                            enhanceAll(qs('molChatToasts') || document);
                            setDockShift();
                            return r;
                        };
                        wrapped.__molPatched = true;
                        window.MOLChatOpenBubble = wrapped;
                    }

                    if (typeof window.MOLChatOpenConversationMobile === 'function' && !window.MOLChatOpenConversationMobile.__molPatched) {
                        const oldOpenMobile = window.MOLChatOpenConversationMobile;
                        const wrapped = async function(...args){
                            const r = await oldOpenMobile.apply(this, args);
                            enhanceAll(qs('molChatPanel') || document);
                            return r;
                        };
                        wrapped.__molPatched = true;
                        window.MOLChatOpenConversationMobile = wrapped;
                    }
                }

                function patchLikeButton(){
                    if (typeof window.MOLChatSendLike !== 'function') return;
                    if (window.MOLChatSendLike.__molPatched) return;

                    const oldLike = window.MOLChatSendLike;

                    const wrapped = async function(conversationId){
                        const desktopBtn = qs(`molLikeBtn-${conversationId}`);
                        const threadBtn = getThreadConvId() === Number(conversationId) ? qs('molChatThreadLikeBtn') : null;
                        const buttons = [desktopBtn, threadBtn].filter(Boolean);

                        if (!buttons.length) return;
                        if (buttons.some(btn => btn.dataset.sending === '1')) return;

                        const oldHtml = new Map();

                        buttons.forEach((btn) => {
                            oldHtml.set(btn, btn.innerHTML);
                            btn.dataset.sending = '1';
                            btn.disabled = true;
                            btn.classList.add('is-sending');
                            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
                        });

                        try {
                            await oldLike(conversationId);
                        } finally {
                            buttons.forEach((btn) => {
                                btn.dataset.sending = '0';
                                btn.disabled = false;
                                btn.classList.remove('is-sending');
                                btn.innerHTML = oldHtml.get(btn) || '<i class="bi bi-hand-thumbs-up-fill"></i>';
                            });
                        }
                    };

                    wrapped.__molPatched = true;
                    window.MOLChatSendLike = wrapped;
                }

                function enhanceAll(root = document){
                    ensurePanelMenu();
                    bindMinimizeButtons(root);
                    enhanceComposers(root);
                    bindPortalDropdowns(root);
                    bindSearchFix();
                    filterLocalConversations(qs('molChatSearch')?.value?.trim() || '');
                    setDockShift();
                }

                function observeDom(){
                    const panel = qs('molChatPanel');
                    const toasts = qs('molChatToasts');

                    if (panel && !panel.__molObserved && window.MutationObserver) {
                        panel.__molObserved = true;
                        new MutationObserver(() => {
                            enhanceAll(panel);
                        }).observe(panel, {
                            childList: true,
                            subtree: true,
                            attributes: true,
                            attributeFilter: ['class']
                        });
                    }

                    if (toasts && !toasts.__molObserved && window.MutationObserver) {
                        toasts.__molObserved = true;
                        new MutationObserver(() => {
                            enhanceAll(toasts);
                        }).observe(toasts, {
                            childList: true,
                            subtree: true
                        });
                    }
                }

                function boot(){
                    bindPortalActions();
                    patchRefreshList();
                    patchOpenClose();
                    patchLikeButton();
                    enhanceAll(document);
                    observeDom();
                    setDockShift();

                    window.addEventListener('orientationchange', () => {
                        setTimeout(setDockShift, 180);
                    });

                    if (window.visualViewport) {
                        window.visualViewport.addEventListener('resize', setDockShift);
                    }
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', boot);
                } else {
                    boot();
                }
            })();
        
