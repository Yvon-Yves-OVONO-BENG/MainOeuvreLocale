                            <div class="d-flex align-items-center justify-content-between gap-2 px-3 py-2 border-bottom bg-white" style="position:sticky;top:0;z-index:5;overflow:visible;flex:0 0 auto;">
                                <div class="d-flex align-items-center gap-2 overflow-hidden" style="min-width:0;flex:1 1 auto;">
                                    <button type="button" class="btn btn-light btn-sm flex-shrink-0" id="molChatThreadBack" aria-label="Retour">
                                        <i class="bi bi-arrow-left"></i>
                                    </button>

                                    <div style="width:34px;height:34px;border-radius:999px;overflow:hidden;flex:0 0 auto;">
                                        <img id="molChatThreadAvatar" alt="" style="width:100%;height:100%;object-fit:cover;">
