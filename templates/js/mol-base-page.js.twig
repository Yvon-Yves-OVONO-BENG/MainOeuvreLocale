                    } catch (e) {
                        console.error('like send error', e);
                    }
                }

                function ensureCameraOverlay() {
                    let overlay = qs('molCameraOverlay');
                    if (overlay) return overlay;

                    document.body.insertAdjacentHTML('beforeend', `
                        <div id="molCameraOverlay" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.72);z-index:2147483647;align-items:center;justify-content:center;padding:20px;">
                            <div style="width:min(640px,100%);background:#fff;border-radius:24px;padding:14px;box-shadow:0 24px 60px rgba(15,23,42,.25);">
                                <video id="molCameraVideo" autoplay playsinline style="width:100%;border-radius:16px;background:#000;"></video>
                                <canvas id="molCameraCanvas" class="d-none"></canvas>
                                <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;margin-top:12px;">
                                    <button type="button" id="molCameraSwitchBtn" class="btn btn-light" title="Changer de caméra">
                                        <i class="bi bi-arrow-repeat"></i> Changer de caméra
                                    </button>
                                    <div style="display:flex;gap:8px;margin-left:auto;">
                                        <button type="button" id="molCameraCloseBtn" class="btn btn-light">Fermer</button>
                                        <button type="button" id="molCameraSnapBtn" class="btn btn-primary"><i class="bi bi-camera-fill"></i> Capturer</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `);

                    return qs('molCameraOverlay');
                }

                function isProbablyMobileDevice() {
                    return /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent);
                }

                async function openDesktopCamera(conversationId) {
                    if (!window.isSecureContext || !navigator.mediaDevices?.getUserMedia) {
                        throw new Error('camera-api-unavailable');
                    }

                    const overlay = ensureCameraOverlay();
                    const video = qs('molCameraVideo');
                    const closeBtn = qs('molCameraCloseBtn');
                    const snapBtn = qs('molCameraSnapBtn');
                    const switchBtn = qs('molCameraSwitchBtn');

                    CHAT.cameraConversationId = conversationId;
                    closeDesktopCamera(false);
                    CHAT.cameraStream = await navigator.mediaDevices.getUserMedia({
                        video: { facingMode: { ideal: CHAT.cameraFacingMode || 'environment' } },
                        audio: false
                    });

                    video.srcObject = CHAT.cameraStream;
                    await video.play().catch(() => {});
                    overlay.style.display = 'flex';

                    closeBtn.onclick = () => closeDesktopCamera(true);
                    snapBtn.onclick = captureDesktopCamera;
                    switchBtn.onclick = switchDesktopCamera;
                }

                async function switchDesktopCamera() {
                    if (!CHAT.cameraConversationId || !navigator.mediaDevices?.getUserMedia) return;
                    const video = qs('molCameraVideo');
                    const nextFacing = CHAT.cameraFacingMode === 'user' ? 'environment' : 'user';
                    const previous = CHAT.cameraStream;

                    try {
                        previous?.getTracks().forEach(track => track.stop());
                        CHAT.cameraStream = await navigator.mediaDevices.getUserMedia({
                            video: { facingMode: { ideal: nextFacing } },
                            audio: false
                        });
                        CHAT.cameraFacingMode = nextFacing;
                        if (video) {
                            video.srcObject = CHAT.cameraStream;
                            await video.play().catch(() => {});
                        }
                    } catch (error) {
                        CHAT.cameraStream = null;
                        notify('error', '{% trans %}Caméra indisponible{% endtrans %}', '{% trans %}Impossible de changer de caméra sur cet appareil.{% endtrans %}');
                    }
                }

                function closeDesktopCamera(resetConversation = true) {
                    const overlay = qs('molCameraOverlay');
                    const video = qs('molCameraVideo');

                    if (CHAT.cameraStream) {
                        CHAT.cameraStream.getTracks().forEach(t => t.stop());
                        CHAT.cameraStream = null;
                    }

                    if (video) video.srcObject = null;
                    if (overlay) overlay.style.display = 'none';
                    if (resetConversation) CHAT.cameraConversationId = null;
                }

                async function captureDesktopCamera() {
                    const video = qs('molCameraVideo');
                    const canvas = qs('molCameraCanvas');
                    if (!video || !canvas || !CHAT.cameraConversationId) return;

                    canvas.width = video.videoWidth || 1280;
                    canvas.height = video.videoHeight || 720;

                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

                    const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.92));
                    if (!blob) return;

                    const file = new File([blob], `camera-${Date.now()}.jpg`, { type: 'image/jpeg' });
                    const conversationId = Number(CHAT.cameraConversationId || 0);
                    closeDesktopCamera(true);
                    if (conversationId) await sendFile(conversationId, file);
                }

                async function handleCameraClick(conversationId) {
                    try {
                        await openDesktopCamera(conversationId);
                    } catch (e) {
                        console.debug('Caméra navigateur indisponible, repli natif.', e);
                        const input = Number(CHAT.currentMobileConversationId || 0) === Number(conversationId)
                            ? qs('molChatThreadCamera')
                            : qs(`molCamera-${conversationId}`);

                        if (input) {
                            input.setAttribute('accept', 'image/*');
                            input.setAttribute('capture', CHAT.cameraFacingMode || 'environment');
                            input.click();
                            return;
                        }

                        notify(
                            'error',
                            "{% trans %}Caméra indisponible{% endtrans %}",
                            "{% trans %}Impossible d’ouvrir la caméra.{% endtrans %}"
                        );
                    }
                }

                async function startWithUser(userId) {
                    try {
                        const base = window.location.origin + (window.MOL_CHAT?.baseUrl || '');
                        const url = new URL(`/chat/conversation/with/${userId}`, base);

                        const res = await fetch(url.toString(), {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        if (!res.ok) throw new Error('HTTP ' + res.status);
                        const data = await res.json();
                        if (!data?.ok) return;

                        await refreshList(qs('molChatSearch')?.value?.trim() || '');
                        await openConversation(data.conversationId);
                    } catch (e) {
                        console.error('startWithUser error', e);
                    }
                }

                async function openConversation(conversationId) {
                    const item = document.querySelector(`.mol-chat-item[data-id="${conversationId}"]`);

                    const conv = item ? {
                        id: Number(item.dataset.id || 0),
                        name: item.dataset.name || 'Conversation',
                        avatar: item.dataset.avatar || '',
                        online: item.dataset.online === '1',
                        presence: item.dataset.presence || 'offline'
                    } : {
                        id: Number(conversationId || 0),
                        name: 'Conversation',
                        avatar: '',
                        online: false,
                        presence: 'offline'
                    };

                    if (!conv.id) return;

                    if (isMobileChat()) {
                        await openConversationMobile(conv);
                    } else {
                        await openBubble(conv);
                    }
                }

                function onToastKeydown(e, conversationId) {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        sendToastText(conversationId);
                    }
                }

                function showTyping(conversationId) {
                    const targets = [];
                    const bubbleBox = qs(`molToastMsgs-${conversationId}`);
                    const mobileBox = CHAT.currentMobileConversationId === Number(conversationId) ? qs('molChatThreadMsgs') : null;

                    if (bubbleBox) targets.push(bubbleBox);
                    if (mobileBox) targets.push(mobileBox);

                    targets.forEach(box => {
                        if (box.querySelector(`[data-mol-typing="${conversationId}"]`)) return;
                        const wrap = document.createElement('div');
                        wrap.className = 'd-flex mb-2';
                        wrap.setAttribute('data-mol-typing', String(conversationId));
                        wrap.innerHTML = `
                            <div class="mol-typing">
                                <div class="mol-dots">
                                    <span class="mol-dot"></span>
                                    <span class="mol-dot"></span>
                                    <span class="mol-dot"></span>
                                </div>
                                <div class="small text-secondary">écrit...</div>
                            </div>
                        `;
                        box.appendChild(wrap);
                        box.scrollTop = box.scrollHeight;
                    });
                }

                function hideTyping(conversationId) {
                    [qs(`molToastMsgs-${conversationId}`), qs('molChatThreadMsgs')].forEach(box => {
                        if (!box) return;
                        box.querySelectorAll(`[data-mol-typing="${conversationId}"]`).forEach(n => n.remove());
                    });
                }

                function notifyTyping(conversationId, typing) {
                    if (!window.MOL_CHAT?.urls?.typing) return;

                    fetch(molUrl(window.MOL_CHAT.urls.typing, conversationId), {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({ typing })
                    }).catch(() => {});
                }

                function handleTypingInput(conversationId) {
                    if (CHAT.typingTimers.has(conversationId)) {
                        clearTimeout(CHAT.typingTimers.get(conversationId));
                    }

                    if (!CHAT.typingState.get(conversationId)) {
                        CHAT.typingState.set(conversationId, true);
                        notifyTyping(conversationId, true);
                    }

                    const timer = setTimeout(() => {
                        CHAT.typingState.set(conversationId, false);
                        notifyTyping(conversationId, false);
                        CHAT.typingTimers.delete(conversationId);
                    }, 900);

                    CHAT.typingTimers.set(conversationId, timer);
                }

                async function pollTyping(conversationId) {
                    if (!window.MOL_CHAT?.urls?.typing) return;
                    try {
                        const res = await fetch(molUrl(window.MOL_CHAT.urls.typing, conversationId), {
                            credentials: 'same-origin',
                            cache: 'no-store',
                            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Cache-Control': 'no-cache' }
                        });
                        if (!res.ok) return;
                        const data = await res.json();
                        if (data?.typing) showTyping(conversationId);
                        else hideTyping(conversationId);
                    } catch (_) {}
                }

                async function pollConversation(conversationId) {
                    conversationId = Number(conversationId || 0);
                    if (!conversationId || document.visibilityState === 'hidden') return;

                    const bubbleBox = qs(`molToastMsgs-${conversationId}`);
                    const mobileBox = Number(CHAT.currentMobileConversationId || 0) === conversationId
                        ? qs('molChatThreadMsgs') : null;

                    if (!bubbleBox && !mobileBox) {
                        const entry = CHAT.ajaxPollers.get(conversationId);
                        if (entry) {
                            entry.misses = (entry.misses || 0) + 1;
                            if (entry.misses >= 6) {
                                clearInterval(entry.timer);
                                CHAT.ajaxPollers.delete(conversationId);
                                CHAT.ajaxSnapshots.delete(conversationId);
                                CHAT.ajaxLastIncoming.delete(conversationId);
                            }
                        }
                        return;
                    }

                    const entry = CHAT.ajaxPollers.get(conversationId);
                    if (entry) entry.misses = 0;

                    try {
                        const data = await fetchMessages(conversationId);
                        const items = Array.isArray(data?.items) ? data.items : [];
                        const signature = items.map((m) => {
                            const reactions = (m.reactions || []).map(r => `${r.emoji}:${r.count ?? r.total ?? 0}:${r.reactedByMe ? 1 : 0}`).join(',');
                            return `${m.id}:${m.status || ''}:${m.deleted ? 1 : 0}:${m.readAt || ''}:${m.deliveredAt || ''}:${reactions}`;
                        }).join('|');

                        const previousSignature = CHAT.ajaxSnapshots.get(conversationId);
                        const incomingIds = items.filter(m => !m.mine).map(m => Number(m.id || 0));
                        const lastIncoming = incomingIds.length ? Math.max(...incomingIds) : 0;
                        const previousIncoming = CHAT.ajaxLastIncoming.get(conversationId);

                        if (previousSignature !== signature) {
                            const html = renderMessages(items, conversationId);
                            [bubbleBox, mobileBox].filter(Boolean).forEach((box) => {
                                const nearBottom = box.scrollHeight - box.scrollTop - box.clientHeight < 110;
                                box.innerHTML = html;
                                bindMessageInteractions(box, conversationId);
                                if (nearBottom || previousSignature === undefined) box.scrollTop = box.scrollHeight;
                            });
                            CHAT.ajaxSnapshots.set(conversationId, signature);
                        }

                        if (previousIncoming !== undefined && lastIncoming > previousIncoming) {
                            onNewMessage(conversationId, { playSound: true, useVibrate: true });
                            refreshList(qs('molChatSearch')?.value?.trim() || '').catch(() => {});
                        }
                        CHAT.ajaxLastIncoming.set(conversationId, Math.max(lastIncoming, previousIncoming || 0));
                        await pollTyping(conversationId);
                    } catch (error) {
                        console.debug('Chat AJAX poll différé', error);
                    }
                }

                function initAjaxConversation(conversationId) {
                    conversationId = Number(conversationId || 0);
                    if (!conversationId || CHAT.ajaxPollers.has(conversationId)) return;

                    const entry = { timer: null, misses: 0 };
                    entry.timer = window.setInterval(() => pollConversation(conversationId), 1100);
                    CHAT.ajaxPollers.set(conversationId, entry);
                    pollConversation(conversationId);
                }

                function ensureMobileThreadUi() {
                    const panel = qs('molChatPanel');
                    if (!panel) return null;

                    let thread = qs('molChatThread');
                    if (thread) return thread;

                    const list = qs('molChatList');
                    if (!list || !list.parentElement) return null;

                    const wrap = document.createElement('div');
                    wrap.innerHTML = `
