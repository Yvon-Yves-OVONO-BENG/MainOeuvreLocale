{% extends 'base.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{% trans %}Tableau de bord administrateur{% endtrans %}{% endblock %}

{% block body %}

{% include "tableau_de_bord_administrateur/_vip_ui.html.twig" %}

	{% set envLabel = environment|default('PROD') %}
	{% set ops = ops|default({
		'uptime': 99.98,
		'latency': 182,
		'errorRate': 0.24,
		'cpu': 46,
		'ram': 63,
		'storage': 71,
		'queueDepth': 148,
		'cronSuccess': 98,
		'backupStatus': 'OK',
		'securityScore': 91,
		'openIncidents': 2,
		'deploymentsToday': 6,
		'apiCallsToday': 128420,
		'failedPayments': 3,
		'activeSubscriptions': 184,
		'mrr': 2450000,
		'gmv': 18600000
	}) %}

	{% set plansData = plansData|default([]) %}

	<script>
		tailwind.config = {
			darkMode: 'class',
			theme: {
				extend: {
					boxShadow: {
						soft: '0 18px 55px rgba(2,6,23,.10)',
						soft2: '0 12px 35px rgba(2,6,23,.08)',
						soft3: '0 8px 18px rgba(2,6,23,.08)'
					}
				}
			}
		}
	</script>

	<div class="min-h-[calc(100vh-1px)] bg-[radial-gradient(1200px_circle_at_12%_10%,rgba(99,102,241,.14),transparent_55%),radial-gradient(900px_circle_at_90%_12%,rgba(6,182,212,.12),transparent_52%),radial-gradient(900px_circle_at_22%_88%,rgba(16,185,129,.10),transparent_55%),linear-gradient(180deg,#f8fafc,#eef2ff_50%,#f8fafc)] text-slate-900">
		<div class="mx-auto max-w-[1440px] px-4 py-6 lg:py-8">
			<div class="grid gap-6 lg:grid-cols-[290px,1fr]">

				<aside class="lg:sticky lg:top-6 lg:self-start">
					<div class="sa-card shadow-[0_20px_60px_rgba(15,23,42,.12)] overflow-hidden rounded-3xl backdrop-blur-xl border border-slate-200/60 bg-white/80">
						
						<div class="p-5 bg-[radial-gradient(900px_circle_at_15%_10%,rgba(99,102,241,.18),transparent_60%),radial-gradient(700px_circle_at_85%_15%,rgba(6,182,212,.14),transparent_60%),linear-gradient(180deg,rgba(255,255,255,.95),rgba(255,255,255,.75))] border-b border-slate-200/70">
							<div class="flex items-start justify-between gap-3">
								<div class="flex items-center gap-3">
									<div class="h-11 w-11 rounded-2xl bg-gradient-to-br from-indigo-600 to-blue-600 text-white grid place-items-center shadow-[0_18px_35px_rgba(79,70,229,.35)] ring-1 ring-white/40">
										<span class="text-lg">🛡️</span>
									</div>
									<div>
										<div class="text-sm font-extrabold tracking-tight text-slate-900">Admin Console</div>
										<div class="text-xs font-medium text-slate-500">Main d’Oeuvre Local</div>
									</div>
								</div>
							</div>

						</div>

						<div class="p-3">
							{% set nav = [
								{'href': path('tableau_de_bord'),'label':'Tableau de bord'|trans,'icon':'🏠','badge':'Accueil'|trans,'active':true},
								{'href': path('admin_categories_index'), 'label':'Catégories'|trans, 'icon':'🏷️', 'badge': (kpi.categories ?? '-')},
                                {'href': path('admin_professions_index'), 'label':'Professions'|trans, 'icon':'💼', 'badge': (kpi.professions ?? '-')},
								{'href': path('admin_talents_index'), 'label':'Talents'|trans,'icon':'🧑‍🔧','badge': (kpi.talents ?? '-')},
								{'href': path('admin_companies_index'), 'label':'Compagnies'|trans,'icon':'🏢','badge': (kpi.companies ?? '-')},
								{'href': path('admin_individuals_index'), 'label':'Particuliers'|trans,'icon':'🧑‍💼','badge': (kpi.individuals ?? '-')},
								{'href': path('admin_moderators_index'), 'label':'Modérateurs'|trans,'icon':'🧿','badge': (kpi.moderators ?? '-')},
								{'href': path('admin_jobs_moderation'), 'label':'Modération Offres'|trans,'icon':'📣','badge': (kpi.pendingModerationJobs ?? 0),'warn':true},
								{'href': path('admin_annonces_moderation'), 'label':'Modération Annonces'|trans,'icon':'📢','badge':'À valider'|trans,'warn':true},
								{'href': path('admin_jobs_index'), 'label':'Offres'|trans,'icon':'📣','badge': (kpi.activeJobs ?? '-')},
								{'href': path('moderateur_verifications_index'),'label':'Vérifications'|trans,'icon':'✅','badge': (kpi.pendingVerifications ?? (kpi.pendingProfiles ?? '-')),'warn':true},
								{'href': path('admin_harassment_investigate'), 'label':'Harcèlement'|trans,'icon':'🚨','badge': (kpi.harassmentOpen ?? 0),'danger':true},
								{'href': path('moderateur_reports_index'), 'label':'Signalements'|trans,'icon':'🚨','badge': (kpi.pendingReports ?? '-'),'danger':true},
								{'href': path('admin_payment_dispute_index'), 'label':'Litiges'|trans,'icon':'💳','badge': (securityEvents|length),'danger':true},
								{'href': path('admin_kyc_rules'), 'label':'Règles KYC'|trans,'icon':'🧠','badge': (kpi.rules ?? '-'),'danger':true},
								{'href': path('admin_sanction_index'),'label':'Sanctions'|trans,'icon':'🧾','badge': (kpi.sanctions ?? 0)|number_format(0, ',', ' '),'warn':true},
								{'href': path('admin_invoices_index'),'label':'Paiements du jour'|trans,'icon':'💳','badge': (kpi.paymentsToday ?? 0)|number_format(0, ',', ' ')},
								{'href': path('admin_moderation_queue'),'label':'Modération contenu'|trans,'icon':'🧹','badge':'Auto'},
								{'href': path('admin_newsletter_index'),'label':'Alertes offres'|trans,'icon':'🔔','badge':'Auto'},
								{'href': path('admin_audit_index'),'label':'Audit & logs'|trans,'icon':'🧾','badge':'Logs'},
								{'href': path('admin_support_new'),'label':'Support'|trans,'icon':'🎧','badge': (kpi.openTickets ?? '-')}
							] %}

							<nav class="space-y-1 py-0.5">
								{% for item in nav %}
									{% set isActive = item.active ?? false %}
									{% set badgeClass =
										(item.danger ?? false)
										? 'border-rose-200/70 bg-rose-50 text-rose-700'
										: ((item.warn ?? false)
										? 'border-amber-200/70 bg-amber-50 text-amber-700'
										: 'border-slate-200 bg-white text-slate-700')
									%}

									<a href="{{ item.href }}" class="group flex items-center justify-between gap-3 rounded-xl border px-3 py-2.5 transition-all duration-200 ease-out
										{{ isActive
										? 'border-indigo-200/70 bg-[linear-gradient(135deg,rgba(99,102,241,.14),rgba(59,130,246,.10))] shadow-sm'
										: 'border-transparent hover:border-indigo-200/60 hover:bg-indigo-50/40 hover:shadow-sm' }}" data-turbo="false">

										<span class="flex items-center gap-2">
											<span class="h-7 w-7 rounded-lg border border-slate-200/70 bg-white/80 grid place-items-center text-[12px] shadow-sm group-hover:scale-105 transition">
												{{ item.icon }}
											</span>

											<span class="text-[12.5px] leading-[1.05] font-semibold text-slate-800">
												{{ item.label }}
											</span>
										</span>

										<span class="inline-flex items-center rounded-full border px-2 py-[2px] text-[10.5px] font-extrabold {{ badgeClass }} shadow-sm">
											{{ item.badge }}
										</span>
									</a>
								{% endfor %}
							</nav>

							<div class="mt-5 rounded-3xl border border-slate-200/70 bg-white/70 p-4 shadow-[0_10px_30px_rgba(15,23,42,.06)] backdrop-blur">
								<div class="flex items-center justify-between">
									<div class="text-sm font-extrabold">{% trans %}Actions rapides{% endtrans %}</div>
									<span class="text-[11px] font-bold text-slate-500">Ops</span>
								</div>

								<div class="mt-3 grid grid-cols-2 gap-2">
									<a href="{{ path('moderateur_verifications_index') }}" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-gradient-to-br from-indigo-600 to-blue-600 px-3 py-2.5 text-xs font-extrabold text-white shadow-[0_10px_25px_rgba(79,70,229,.35)] hover:opacity-95 transition">
										✅ {% trans %}Valider{% endtrans %}
									</a>

									<a href="{{ path('admin_harassment_investigate') }}" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-xs font-extrabold text-slate-800 hover:bg-slate-50 shadow-sm transition">
										🚨 {% trans %}Traiter{% endtrans %}
									</a>

									<a href="{{ path('job_new') }}" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-xs font-extrabold text-slate-800 hover:bg-slate-50 shadow-sm transition">
										➕ {% trans %}Offre{% endtrans %}
									</a>

									<a href="{{ path('admin_annonces_moderation') }}" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-amber-200 bg-amber-50 px-3 py-2.5 text-xs font-extrabold text-amber-800 hover:bg-amber-100 shadow-sm transition" data-turbo="false">
										📢 {% trans %}Annonces{% endtrans %}
									</a>

									<a href="{{ path('admin_broadcast_index') }}" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-xs font-extrabold text-slate-800 hover:bg-slate-50 shadow-sm transition">
										📢 Broadcast
									</a>
								</div>
							</div>

							<div class="mt-4 rounded-3xl border border-slate-200/70 bg-white/70 p-4 backdrop-blur">
								<div class="text-xs font-semibold text-slate-500">
									{% trans %}Centre d’administration{% endtrans %}
								</div>

								<div class="mt-1 text-sm font-extrabold tracking-tight">
									{% trans %}Sécurité • Qualité • Finance • Support{% endtrans %}
								</div>

								<div class="mt-3 flex flex-wrap gap-2">
									<a href="{{ path('admin_settings_index') }}" class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-[11px] font-extrabold text-slate-700 hover:bg-slate-50 shadow-sm transition">
										⚙️ {% trans %}Paramètres{% endtrans %}
									</a>

									<a href="{{ path('admin_backups_index') }}" class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-[11px] font-extrabold text-slate-700 hover:bg-slate-50 shadow-sm transition">
										🗄️ Backups
									</a>

									<a href="{{ path('admin_integrations_index') }}" class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-[11px] font-extrabold text-slate-700 hover:bg-slate-50 shadow-sm transition">
										🔌 {% trans %}Intégrations{% endtrans %}
									</a>
								</div>
							</div>
						</div>
					</div>
				</aside>

				<main class="space-y-6">
					
					<section class="rounded-3xl border border-slate-200/70 bg-white/70 backdrop-blur-xl shadow-soft overflow-hidden">
						<div class="p-5 bg-[radial-gradient(900px_circle_at_15%_10%,rgba(99,102,241,.16),transparent_60%),radial-gradient(800px_circle_at_90%_30%,rgba(6,182,212,.12),transparent_60%),linear-gradient(180deg,rgba(255,255,255,.90),rgba(255,255,255,.72))]">
							<div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
								<div>
									<h1 class="mt-1 text-3xl sm:text-4xl font-black tracking-tight text-slate-900">🛡️ {% trans %}Administration{% endtrans %}</h1>
									<p class="mt-2 max-w-2xl text-sm font-medium text-slate-600">
										{% trans %}Gestion complète : utilisateurs, contenus, modération, paiements, support, sécurité & contrôle qualité.{% endtrans %}
									</p>

									<div class="mt-5 flex flex-wrap gap-2.5">
										<span class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-[11px] font-extrabold text-slate-700">
											👥 {% trans %}Connectés:{% endtrans %} {{ kpi.onlineUsers ?? '-' }}
										</span>
										<span class="inline-flex items-center gap-2 rounded-full border border-cyan-200/70 bg-cyan-50 px-3 py-1.5 text-[11px] font-extrabold text-cyan-700">
											✨ {% trans %}Inscriptions (24h):{% endtrans %} {{ kpi.signups24h ?? '-' }}
										</span>
										<span class="inline-flex items-center gap-2 rounded-full border border-rose-200/70 bg-rose-50 px-3 py-1.5 text-[11px] font-extrabold text-rose-700">
											🚨 {% trans %}Incidents:{% endtrans %} {{ kpi.incidentsOpen ?? 0 }}
										</span>
										<span class="inline-flex items-center gap-2 rounded-full border border-cyan-200/70 bg-cyan-50 px-3 py-1.5 text-[11px] font-extrabold text-cyan-700">
											💰 {{ (kpi.mrr ?? 0)|number_format(0, ',', ' ') }} XAF RMR
										</span>
										{# <span class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-[11px] font-extrabold text-slate-700">
											🕒 <span id="saLiveClock" class="font-mono">--:--:--</span>
										</span> #}
									</div>
								</div>

								<div class="flex flex-wrap gap-3">
									<a href="{{ path('admin_broadcast_index') }}" class="inline-flex items-center gap-2 rounded-2xl bg-gradient-to-br from-indigo-600 to-blue-600 px-3 py-2 text-xs font-extrabold text-white shadow-soft2 hover:opacity-95">
										📢 {% trans %}Notifier tout le monde{% endtrans %}
									</a>

									
								</div>
							</div>
						</div>
					</section>

					<div class="sticky top-4 z-50">
						<div class="sa-card px-5 py-3 rounded-3xl border border-slate-200/60 bg-[linear-gradient(180deg,rgba(255,255,255,.92),rgba(255,255,255,.75))] backdrop-blur-xl shadow-[0_12px_40px_rgba(15,23,42,.08)]">
							<div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
								

								<div class="flex flex-wrap items-center gap-2">
									<a href="{{ path('admin_users_index') }}" class="sa-btn inline-flex items-center gap-2 rounded-xl border border-slate-200/70 bg-white/80 px-3 py-2 text-xs font-semibold text-slate-800 shadow-[0_6px_20px_rgba(15,23,42,.06)] hover:bg-white hover:shadow-[0_10px_30px_rgba(15,23,42,.08)] transition">
										👥 {% trans %}Tous les utilisateurs{% endtrans %}
									</a>

									<a href="{{ path('admin_audit_index') }}" class="sa-btn inline-flex items-center gap-2 rounded-xl border border-slate-200/70 bg-white/80 px-3 py-2 text-xs font-semibold text-slate-800 shadow-[0_6px_20px_rgba(15,23,42,.06)] hover:bg-white hover:shadow-[0_10px_30px_rgba(15,23,42,.08)] transition">
										🧾 {% trans %}Audit{% endtrans %}
									</a>

									<a type="button" onclick="MOLChatOpen()" class="relative inline-flex items-center gap-2 rounded-2xl bg-slate-900 px-3 py-2 text-xs font-extrabold text-white shadow-[0_10px_30px_rgba(15,23,42,.25)] hover:opacity-95 transition">
										💬 {% trans %}Messages{% endtrans %}
										<span class="absolute -right-2 -top-2 min-w-[22px] rounded-full bg-rose-500 px-1.5 py-1 text-[11px] font-black text-white shadow-[0_6px_18px_rgba(244,63,94,.45)] text-center animate-pulse">
											{{ kpi.unreadAdminMessages ?? 0 }}
										</span>
									</a>

									<a href="{{ path('moderateur_verifications_index') }}" class="inline-flex items-center gap-2 rounded-2xl bg-gradient-to-br from-indigo-600 to-blue-600 px-3 py-2 text-xs font-extrabold text-white shadow-[0_10px_30px_rgba(79,70,229,.35)] hover:opacity-95 transition">
										✅ {% trans %}Vérifier profils{% endtrans %}
									</a>

									<a href="{{ path('moderateur_reports_index', {status: 'open'}) }}" class="inline-flex items-center gap-2 rounded-2xl bg-gradient-to-br from-rose-500 to-orange-500 px-3 py-2 text-xs font-extrabold text-white shadow-[0_10px_30px_rgba(244,63,94,.35)] hover:opacity-95 transition">
										🚨 {% trans %}Urgences{% endtrans %}
									</a>
									<a id="saOpenCommand" class="sa-btn inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-800 shadow-sm hover:bg-slate-50 cursor-pointer">
										⌘ {% trans %}Commandes{% endtrans %}
									</a>
								</div>
							</div>
						</div>
					</div>

					<section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
						{% set kpis = [
							{'label':'Comptes actifs'|trans,'value': (kpi.activeAccounts ?? 0), 'icon':'✅', 'href':path('admin_users_index'), 'meta': ('+' ~ (kpi.activeDelta7d ?? 0) ~ ' / 7j'), 'tone':'indigo'},
							{'label':'Comptes bloqués'|trans,'value': (kpi.blockedAccounts ?? 0), 'icon':'⛔', 'href': path('admin_users_index'), 'meta':'Fraude / abus'|trans, 'tone':'rose'},
							{'label':'Offres actives'|trans,'value': (kpi.activeJobs ?? 0), 'icon':'📣', 'href': path('admin_jobs_index', {status: 'active'}), 'meta':'Qualité & conformité'|trans, 'tone':'cyan'},
							{'label':'Signalements ouverts'|trans,'value': (kpi.pendingReports ?? 0), 'icon':'🚨', 'href':path('moderateur_reports_index'), 'meta': ('SLA: ' ~ (kpi.slaHours ?? '—')), 'tone':'amber'}
						] %}

						{% for c in kpis %}
							{% set ring =
								c.tone == 'rose'
								? 'from-rose-500/15 to-orange-500/10'
								: (c.tone == 'cyan'
									? 'from-cyan-500/15 to-sky-500/10'
									: (c.tone == 'amber'
									? 'from-amber-500/15 to-yellow-500/10'
									: 'from-indigo-500/15 to-blue-500/10'))
							%}

							<div class="sa-card shadow-soft3 overflow-hidden">
								<div class="p-4 bg-gradient-to-br {{ ring }}">
									<div class="flex items-start justify-between gap-3">
										<div>
											<div class="text-xs font-semibold text-slate-500">{{ c.label }}</div>
											<div class="mt-1 text-4xl font-black tracking-tight text-slate-900">{{ c.value }}</div>
										</div>
										<div class="h-11 w-11 rounded-2xl border border-slate-200/70 bg-white/80 grid place-items-center text-lg">
											{{ c.icon }}
										</div>
									</div>

									<div class="mt-3 flex items-center justify-between gap-3">
										<a href="{{ c.href }}" class="text-xs font-extrabold text-indigo-700 hover:underline">{% trans %}Ouvrir{% endtrans %}</a>
										<span class="rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[11px] font-extrabold text-slate-600">
											{{ c.meta }}
										</span>
									</div>
								</div>
							</div>
						{% endfor %}
					</section>

					<section class="mt-5 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-8 gap-3">
						<div class="sa-card sa-kpi" data-search-item="utilisateurs users comptes croissance">
							{% set usersCurrent = kpi.usersCurrentMonthCount ?? 0 %}
							{% set usersPrevious = kpi.usersPreviousMonthCount ?? 0 %}
							{% set usersDelta = kpi.usersCurrentMonthDelta ?? 0 %}

							{% if usersPrevious > 0 %}
								{% set usersProgress = ((usersCurrent / usersPrevious) * 100) %}
								{% if usersProgress > 100 %}
									{% set usersProgress = 100 %}
								{% endif %}
							{% else %}
								{% set usersProgress = usersCurrent > 0 ? 100 : 0 %}
							{% endif %}

							<div class="flex items-start justify-between">
								<div>
									<div class="text-xs uppercase tracking-wider text-slate-400">
										{% trans %}Utilisateurs{% endtrans %}
									</div>

									<div class="mt-2 flex items-end gap-2">
										<div class="text-3xl font-extrabold" data-count="{{ usersCurrent }}">
											{{ usersCurrent }}
										</div>

										<div class="mb-1 inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-extrabold text-slate-600">
											{{ usersCurrent }}/{{ usersPrevious }}
										</div>
									</div>

									<div class="mt-2 text-[11px] text-slate-500">
										{% trans %}Ce mois / mois dernier{% endtrans %}
									</div>

									<div class="mt-2 text-xs {{ usersDelta >= 0 ? 'text-emerald-500' : 'text-rose-500' }}">
										{{ usersDelta >= 0 ? '+' : '' }}{{ usersDelta|number_format(1, ',', ' ') }}%
										{% trans %}vs mois dernier{% endtrans %}
									</div>
								</div>

								<div class="sa-icon">👥</div>
							</div>

							<div class="mt-4">
								<div class="flex items-center justify-between text-[11px] font-bold text-slate-500 mb-1">
									<span>{% trans %}Progression{% endtrans %}</span>
									<span>{{ usersProgress|number_format(0, ',', ' ') }}%</span>
								</div>

								<div class="mt-1 sa-kpi-line bg-slate-200/80">
									<span
										style="
											width: {{ usersProgress }}%;
											background:
												linear-gradient(
													90deg,
													#ef4444 0%,
													#f97316 35%,
													#f59e0b 60%,
													#84cc16 80%,
													#10b981 100%
												);
										">
									</span>
								</div>
							</div>
						</div>

						<div class="sa-card sa-kpi" data-search-item="revenus billing mrr abonnement saas">
							<div class="flex items-start justify-between">
								<div>
									<div class="text-xs uppercase tracking-wider text-slate-400">{% trans %}RMR{% endtrans %}</div>

									<div class="mt-1 text-[11px] text-slate-500">
										{% trans %}Revenu mensuel récurrent{% endtrans %}
									</div>

									<div class="mt-2 text-3xl font-extrabold" data-count="{{ kpi.mrr ?? 0 }}">
										{{ (kpi.mrr ?? 0)|number_format(0, ',', ' ') }}
									</div>

									{% set mrrDelta = kpi.mrrDelta ?? 0 %}
									<div class="mt-2 text-xs {{ mrrDelta >= 0 ? 'text-emerald-500' : 'text-rose-500' }}">
										{{ mrrDelta >= 0 ? '+' : '' }}{{ mrrDelta|number_format(1, ',', ' ') }}%
										{% trans %}vs période précédente{% endtrans %}
									</div>
								</div>

								<div class="sa-icon">💰</div>
							</div>

							<div class="mt-4 sa-kpi-line">
