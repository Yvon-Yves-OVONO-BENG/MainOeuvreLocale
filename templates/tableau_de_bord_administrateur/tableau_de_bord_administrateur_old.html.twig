	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

	<script>
		const revenueLabels = {{ revenueChart.labels|default([])|json_encode|raw }};
		const revenueValues = {{ revenueChart.mrr|default([])|json_encode|raw }};
	</script>

	<script>
		const subscriptionPlanLabels = {{ subscriptionPlanLabels|default([])|json_encode|raw }};
		const subscriptionPlanValues = {{ subscriptionPlanValues|default([])|json_encode|raw }};
	</script>

	<script>
		const providerLabels = {{ providerLabels|default([])|json_encode|raw }};
		const providerValues = {{ providerValues|default([])|json_encode|raw }};
	</script>

	<script>
		const userTrendLabels = {{ userTrendChart.labels|default([])|json_encode|raw }};
		const userTrendTalent = {{ userTrendChart.talent|default([])|json_encode|raw }};
		const userTrendParticulier = {{ userTrendChart.particulier|default([])|json_encode|raw }};
		const userTrendCompany = {{ userTrendChart.company|default([])|json_encode|raw }};
	</script>

	<script>
		(function () {
			const searchInput = document.getElementById('adminSearch');
			const resultsBox = document.getElementById('globalSearchResults');
			const resultsContent = document.getElementById('searchResultsContent');
			const commandModal = document.getElementById('saCommandModal');
			const openCommandBtn = document.getElementById('saOpenCommand');
			const closeCommandBtn = document.getElementById('saCloseCommand');
			const commandInput = document.getElementById('saCommandInput');
			const toastWrap = document.getElementById('saToastWrap');
			const searchUrl = '{{ path('admin_search_global') }}';

			function saToast(message) {
				if (!toastWrap) return;
				const el = document.createElement('div');
				el.className = 'sa-toast sa-toast-success show';
				el.innerHTML = `<div class="font-semibold">{% trans %}Action console{% endtrans %}</div><div class="text-sm mt-1 text-slate-300">${message}</div>`;
				toastWrap.appendChild(el);

				setTimeout(() => {
					el.style.opacity = '0';
					el.style.transform = 'translateY(8px)';
					el.style.transition = '.25s ease';
					setTimeout(() => el.remove(), 260);
				}, 2600);
			}

			document.querySelectorAll('[data-sa-action]').forEach(btn => {
				btn.addEventListener('click', function () {
					const action = this.getAttribute('data-sa-action');
					saToast(`{% trans %}À brancher côté backend :{% endtrans %} ${action}`);
				});
			});

			function openCommandModal() {
				if (!commandModal) return;
				commandModal.classList.remove('hidden');
				commandModal.classList.add('flex');
				setTimeout(() => commandInput && commandInput.focus(), 30);
			}

			function closeCommandModal() {
				if (!commandModal) return;
				commandModal.classList.add('hidden');
				commandModal.classList.remove('flex');
			}

			openCommandBtn && openCommandBtn.addEventListener('click', openCommandModal);
			closeCommandBtn && closeCommandBtn.addEventListener('click', closeCommandModal);

			commandModal && commandModal.addEventListener('click', function (e) {
				if (e.target === commandModal) closeCommandModal();
			});

			document.addEventListener('keydown', function (e) {
				if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
					e.preventDefault();
					searchInput && searchInput.focus();
				}

				if (e.key === 'Escape') {
					closeCommandModal();
					resultsBox && resultsBox.classList.add('hidden');
				}
			});

			document.addEventListener('click', function (e) {
				if (!resultsBox || !searchInput) return;
				if (!resultsBox.contains(e.target) && e.target !== searchInput) {
					resultsBox.classList.add('hidden');
				}
			});

			const tabs = document.querySelectorAll('[data-tab-btn]');
			const panels = document.querySelectorAll('[data-tab-panel]');

			tabs.forEach(btn => {
				btn.addEventListener('click', function () {
					const key = this.dataset.tabBtn;
					tabs.forEach(b => b.classList.remove('active'));
					panels.forEach(panel => panel.classList.remove('active'));
					this.classList.add('active');
					const target = document.querySelector('[data-tab-panel="' + key + '"]');
					if (target) target.classList.add('active');
				});
			});

			function updateClock() {
				const el = document.getElementById('saLiveClock');
				if (!el) return;
				const d = new Date();
				const hh = String(d.getHours()).padStart(2, '0');
				const mm = String(d.getMinutes()).padStart(2, '0');
				const ss = String(d.getSeconds()).padStart(2, '0');
				el.textContent = `${hh}:${mm}:${ss}`;
			}
			updateClock();
			setInterval(updateClock, 1000);

			document.querySelectorAll('[data-count]').forEach(el => {
				const raw = parseInt((el.getAttribute('data-count') || '0').replace(/\s+/g, ''), 10) || 0;
				const duration = 900;
				const start = performance.now();

				function tick(now) {
					const p = Math.min((now - start) / duration, 1);
					const v = Math.floor(raw * p);
					el.textContent = new Intl.NumberFormat('fr-FR').format(v);
					if (p < 1) requestAnimationFrame(tick);
				}
				requestAnimationFrame(tick);
			});

			async function runGlobalSearch(q) {
				try {
					const response = await fetch(`${searchUrl}?q=${encodeURIComponent(q)}`, {
						headers: { 'X-Requested-With': 'XMLHttpRequest' }
					});
					const data = await response.json();

					function section(title, icon, items) {
						if (!items || items.length === 0) return '';
						let html = `<div class="border-b last:border-none"><div class="px-4 py-2 text-[11px] font-extrabold text-slate-500 bg-slate-50">${icon} ${title}</div>`;
						items.forEach(item => {
							const label = item.label || item.email || item.nom || item.title || item.reference || '—';
							const url = item.url || '#';
							html += `<a href="${url}" class="flex items-center justify-between px-4 py-2 text-sm hover:bg-indigo-50"><span>${label}</span></a>`;
						});
						html += `</div>`;
						return html;
					}

					let html = '';
					html += section('{% trans %}Utilisateurs{% endtrans %}', '👤', data.users);
					html += section('{% trans %}Entreprises{% endtrans %}', '🏢', data.companies);
					html += section('{% trans %}Offres{% endtrans %}', '📣', data.jobs);
					html += section('{% trans %}Transactions{% endtrans %}', '💳', data.transactions);
					html += section('{% trans %}Tickets{% endtrans %}', '🎫', data.tickets);

					resultsContent.innerHTML = html || `<div class="px-4 py-4 text-sm text-slate-500">{% trans %}Aucun résultat{% endtrans %}</div>`;
					resultsBox.classList.remove('hidden');
				} catch (e) {
					resultsContent.innerHTML = `<div class="px-4 py-4 text-sm text-rose-600">{% trans %}Erreur lors de la recherche globale{% endtrans %}</div>`;
					resultsBox.classList.remove('hidden');
				}
			}

			searchInput && searchInput.addEventListener('input', function () {
				const q = this.value.trim();
				if (q.length < 2) {
					resultsBox && resultsBox.classList.add('hidden');
					return;
				}
				runGlobalSearch(q);
			});

			const defaultMonths = ["Jan", "Fév", "Mar", "Avr", "Mai", "Juin", "Juil", "Aoû", "Sep", "Oct", "Nov", "Déc"];
			const gridColor = 'rgba(148,163,184,.18)';
			const labelColor = '#64748b';

			const commonOptions = {
				responsive: true,
				maintainAspectRatio: false,
				plugins: {
					legend: {
						labels: {
							color: labelColor,
							boxWidth: 10,
							usePointStyle: true
						}
					},
					tooltip: {
						backgroundColor: '#ffffff',
						titleColor: '#0f172a',
						bodyColor: '#475569',
						borderColor: 'rgba(226,232,240,.95)',
						borderWidth: 1,
						padding: 12
					}
				},
				scales: {
					x: { ticks: { color: labelColor }, grid: { color: gridColor } },
					y: { ticks: { color: labelColor }, grid: { color: gridColor }, beginAtZero: true }
				}
			};

			const raw30d = {{ charts.signups30d|default([])|json_encode|raw }};
			const labels30d = raw30d.map(x => x.d);
			const data30d = raw30d.map(x => parseInt(x.c, 10) || 0);

			const chart30d = document.getElementById('chartSignups30d');
			if (chart30d) {
				new Chart(chart30d, {
					type: 'line',
					data: {
						labels: labels30d,
						datasets: [{
							label: '{% trans %}Inscriptions{% endtrans %}',
							data: data30d,
							tension: .35,
							fill: true,
							pointRadius: 2,
							pointHoverRadius: 4,
							borderWidth: 2,
							borderColor: '#6366f1',
							backgroundColor: 'rgba(99,102,241,.12)'
						}]
					},
					options: commonOptions
				});
			}

			const split = {{ usersSplit|default({'company':0,'talent':0,'particulier':0,'staff':0})|json_encode|raw }};
			const jobs = {{ chartJobVsRecruits.jobsVsRecruits|default({'jobs':0,'recruited':0})|json_encode|raw }};
			const mod = {{ chartsModeration|default({'spam':0,'abuse':0,'fraud':0,'identity':0,'other':0})|json_encode|raw }};
			const revenueChartLabels = Array.isArray(revenueLabels) ? revenueLabels : [];
			const revenueChartValues = Array.isArray(revenueValues) ? revenueValues : [];
			const healthRaw = {{ charts.healthSeries|default([])|json_encode|raw }};
			const healthLabels = healthRaw.length ? healthRaw.map(x => x.label) : ["Lun","Mar","Mer","Jeu","Ven","Sam","Dim"];
			const latencyValues = healthRaw.length ? healthRaw.map(x => parseInt(x.latency, 10) || 0) : [180,176,191,169,174,186,182];
			const errorValues = healthRaw.length ? healthRaw.map(x => parseFloat(x.errors) || 0) : [0.22,0.18,0.31,0.15,0.19,0.26,0.24];
			const plans = {{ plansData|default([])|json_encode|raw }};
			const planLabels = plans.length ? plans.map(x => x.name) : ['Starter', 'Pro', 'Business', 'Enterprise'];
			const planValues = plans.length ? plans.map(x => parseInt(x.count, 10) || 0) : [64,81,29,10];

			const elSplit = document.getElementById('chartUsersSplit');
			if (elSplit) {
				new Chart(elSplit, {
					type: 'doughnut',
					data: {
						labels: ['Company','Talent','Particulier','Staff'],
						datasets: [{
							data: [split.company || 0, split.talent || 0, split.particulier || 0, split.staff || 0],
							backgroundColor: ['#6366f1','#06b6d4','#10b981','#f59e0b'],
							borderWidth: 0
						}]
					},
					options: {
						responsive: true,
						plugins: { legend: { display: false } },
						cutout: '68%'
					}
				});
			}

			const elJobs = document.getElementById('chartJobs');
			if (elJobs) {
				if (elJobs._chartInstance) {
					elJobs._chartInstance.destroy();
				}

				elJobs._chartInstance = new Chart(elJobs, {
					type: 'bar',
					data: {
						labels: ['{% trans %}Offres{% endtrans %}', '{% trans %}Recrutés{% endtrans %}'],
						datasets: [{
							label: '{% trans %}Volume{% endtrans %}',
							data: [
								parseInt(jobs.jobs ?? 0, 10),
								parseInt(jobs.recruited ?? 0, 10)
							],
							backgroundColor: [
								'rgba(56,189,248,.80)',
								'rgba(45,212,191,.80)'
							],
							borderRadius: 16,
							borderSkipped: false,
							maxBarThickness: 90
						}]
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						plugins: {
							legend: {
								display: true,
								labels: {
									color: '#64748b',
									boxWidth: 10,
									usePointStyle: true
								}
							},
							tooltip: {
								backgroundColor: '#ffffff',
								titleColor: '#0f172a',
								bodyColor: '#475569',
								borderColor: 'rgba(226,232,240,.95)',
								borderWidth: 1,
								padding: 12
							}
						},
						scales: {
							x: {
								ticks: { color: '#64748b' },
								grid: { display: false }
							},
							y: {
								beginAtZero: true,
								ticks: {
									color: '#64748b',
									precision: 0
								},
								grid: { color: 'rgba(148,163,184,.18)' }
							}
						}
					}
				});
			}

			const elModSecurity = document.getElementById('chartModerationSecurity');
			if (elModSecurity) {
				new Chart(elModSecurity, {
					type: 'polarArea',
					data: {
						labels: ['{% trans %}Spam{% endtrans %}','{% trans %}Abus{% endtrans %}','{% trans %}Fraude{% endtrans %}','{% trans %}Identité{% endtrans %}','{% trans %}Autres{% endtrans %}'],
						datasets: [{
							data: [mod.spam || 0, mod.abuse || 0, mod.fraud || 0, mod.identity || 0, mod.other || 0],
							backgroundColor: ['rgba(99,102,241,.65)','rgba(6,182,212,.65)','rgba(244,63,94,.65)','rgba(245,158,11,.65)','rgba(16,185,129,.65)'],
							borderWidth: 0
						}]
					},
					options: {
						responsive: true,
						plugins: { legend: { labels: { color: labelColor } } },
						scales: { r: { grid: { color: gridColor }, ticks: { backdropColor: 'transparent', color: labelColor }, pointLabels: { color: labelColor } } }
					}
				});
			}

			const elRevenue = document.getElementById('chartRevenue');

			if (elRevenue) {
				new Chart(elRevenue, {
					type: 'line',
					data: {
						labels: revenueChartLabels,
						datasets: [
							{
								label: 'RMR',
								data: revenueChartValues,
								borderColor: '#10b981',
								backgroundColor: 'rgba(16,185,129,.12)',
								fill: true,
								tension: 0.35,
								pointRadius: 2
							}
						]
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						plugins: {
							legend: {
								display: true,
								labels: {
									color: labelColor,
									boxWidth: 10,
									usePointStyle: true
								}
							},
							tooltip: {
								backgroundColor: '#ffffff',
								titleColor: '#0f172a',
								bodyColor: '#475569',
								borderColor: 'rgba(226,232,240,.95)',
								borderWidth: 1,
								padding: 12,
								callbacks: {
									label: function(context) {
										return context.dataset.label + ': ' + Number(context.raw).toLocaleString('fr-FR') + ' XAF';
									}
								}
							}
						},
						scales: {
							x: {
								ticks: { color: labelColor },
								grid: { color: gridColor }
							},
							y: {
								beginAtZero: true,
								ticks: {
									color: labelColor,
									callback: function(value) {
										return Number(value).toLocaleString('fr-FR');
									}
								},
								grid: { color: gridColor }
							}
						}
					}
				});
			}


			const elPlans = document.getElementById('chartPlans');
			if (elPlans) {
				new Chart(elPlans, {
					type: 'doughnut',
					data: {
						labels: subscriptionPlanLabels,
						datasets: [{
							data: subscriptionPlanValues,
							backgroundColor: ['#6366f1', '#06b6d4', '#10b981', '#f59e0b', '#8b5cf6'],
							borderWidth: 0
						}]
					},
					options: {
						responsive: true,
						plugins: { legend: { display: false } },
						cutout: '64%'
					}
				});
			}

			const elProviders = document.getElementById('chartProviders');

			if (elProviders) {
				new Chart(elProviders, {
					type: 'doughnut',
					data: {
						labels: providerLabels,
						datasets: [{
							data: providerValues,
							backgroundColor: ['#10b981', '#f59e0b', '#3b82f6'],
							borderWidth: 0
						}]
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						plugins: {
							legend: { display: false },
							tooltip: {
								callbacks: {
									label: function(context) {
										return context.label + ': ' + Number(context.raw).toLocaleString('fr-FR');
									}
								}
							}
						},
						cutout: '64%'
					}
				});
			}

			const elHealth = document.getElementById('chartHealth');
			if (elHealth) {
				new Chart(elHealth, {
					type: 'line',
					data: {
						labels: userTrendLabels,
						datasets: [
							{
								label: 'TALENTS',
								data: userTrendTalent,
								borderColor: '#06b6d4',
								backgroundColor: 'rgba(6,182,212,.10)',
								fill: false,
								tension: 0.35,
								pointRadius: 2,
								pointHoverRadius: 4,
								borderWidth: 3
							},
							{
								label: 'PARTICULIERS',
								data: userTrendParticulier,
								borderColor: '#10b981',
								backgroundColor: 'rgba(16,185,129,.10)',
								fill: false,
								tension: 0.35,
								pointRadius: 2,
								pointHoverRadius: 4,
								borderWidth: 3
							},
							{
								label: 'ENTREPRISES',
								data: userTrendCompany,
								borderColor: '#6366f1',
								backgroundColor: 'rgba(99,102,241,.10)',
								fill: false,
								tension: 0.35,
								pointRadius: 2,
								pointHoverRadius: 4,
								borderWidth: 3
							}
						]
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						plugins: {
							legend: {
								labels: {
									color: labelColor,
									boxWidth: 10,
									usePointStyle: true
								}
							},
							tooltip: {
								backgroundColor: '#ffffff',
								titleColor: '#0f172a',
								bodyColor: '#475569',
								borderColor: 'rgba(226,232,240,.95)',
								borderWidth: 1,
								padding: 12
							}
						},
						scales: {
							x: {
								ticks: { color: labelColor },
								grid: { color: gridColor }
							},
							y: {
								beginAtZero: true,
								ticks: {
									color: labelColor,
									precision: 0
								},
								grid: { color: gridColor }
							}
						}
					}
				});
			}

		})();
	</script>

	<script>
		document.addEventListener('DOMContentLoaded', function () {
		const root = document.querySelector('[data-admin-placeholder-actions]');
		const toast = document.getElementById('saSoonToast');

		if (!root || !toast) return;

		let toastTimer = null;

		function showToast(message) {
			toast.textContent = message;
			toast.classList.add('show');

			clearTimeout(toastTimer);
			toastTimer = setTimeout(() => {
			toast.classList.remove('show');
			}, 2200);
		}

		root.querySelectorAll('[data-soon-label]').forEach((button) => {
			button.addEventListener('click', function () {
			const label = this.getAttribute('data-soon-label') || 'Cette fonctionnalité';
			showToast(label + ' : bientôt disponible');
			});
		});
		});
	</script>

	<script>
		document.addEventListener('DOMContentLoaded', function () {
			const toasts = document.querySelectorAll('.sa-toast');

			toasts.forEach((toast, index) => {
				setTimeout(() => {
					toast.classList.add('show');
				}, 120 + (index * 120));

				setTimeout(() => {
					toast.classList.remove('show');
					setTimeout(() => {
						toast.remove();
					}, 250);
				}, 3200 + (index * 150));
			});
		});
	</script>

