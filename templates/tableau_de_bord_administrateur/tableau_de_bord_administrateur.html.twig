                        {# =====================================================
                           FINANCE
                           ===================================================== #}
                        <section class="admin-tab-panel" data-admin-panel="finance">
                            <div class="admin-stack">
                                <article class="admin-card">
                                    <header class="admin-card__header">
                                        <div>
                                            <h2 class="admin-section-title">{% trans %}Revenus{% endtrans %}</h2>
                                            <p class="admin-section-subtitle">{% trans %}Revenu mensuel récurrent et stabilité des abonnements.{% endtrans %}</p>
                                        </div>
                                        <span class="admin-status admin-status--success">RMR</span>
                                    </header>
                                    <div class="admin-card__body"><div class="admin-chart admin-chart--lg"><canvas id="chartRevenue"></canvas></div></div>
                                </article>

                                <div class="admin-grid-12">
                                    <article class="admin-card admin-col-6">
                                        <header class="admin-card__header"><div><h2 class="admin-section-title">{% trans %}Mix des plans{% endtrans %}</h2><p class="admin-section-subtitle">{% trans %}Répartition de la base d’abonnés.{% endtrans %}</p></div></header>
                                        <div class="admin-card__body admin-grid-12">
                                            <div class="admin-col-6"><div class="admin-chart admin-chart--sm"><canvas id="chartPlans"></canvas></div></div>
                                            <div class="admin-col-6 admin-card-list">
                                                {% for plan in plansData %}
                                                    <div class="admin-list-item__head"><span class="admin-list-item__meta">{{ plan.name }}</span><span><strong>{{ plan.count|number_format(0, ',', ' ') }}</strong><small class="admin-list-item__meta"> · {{ plan.total|number_format(0, ',', ' ') }} XAF</small></span></div>
                                                {% else %}
                                                    <div class="admin-empty">{% trans %}Aucune donnée plan{% endtrans %}</div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    </article>

                                    <article class="admin-card admin-col-6">
                                        <header class="admin-card__header"><div><h2 class="admin-section-title">{% trans %}Mix des providers{% endtrans %}</h2><p class="admin-section-subtitle">{% trans %}Répartition des paiements réussis par fournisseur.{% endtrans %}</p></div></header>
                                        <div class="admin-card__body admin-grid-12">
                                            <div class="admin-col-6"><div class="admin-chart admin-chart--sm"><canvas id="chartProviders"></canvas></div></div>
                                            <div class="admin-col-6 admin-card-list">
                                                {% for provider in providerData %}
                                                    <div class="admin-list-item__head"><span class="admin-list-item__meta">{{ provider.name }}</span><span><strong>{{ provider.count|number_format(0, ',', ' ') }}</strong><small class="admin-list-item__meta"> · {{ provider.total|number_format(0, ',', ' ') }} XAF</small></span></div>
                                                {% else %}
                                                    <div class="admin-empty">{% trans %}Aucune donnée provider{% endtrans %}</div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    </article>

                                    <article class="admin-card admin-col-4">
                                        <header class="admin-card__header"><div><h2 class="admin-section-title">{% trans %}Paiements échoués{% endtrans %}</h2><p class="admin-section-subtitle">{% trans %}Dernières transactions à investiguer.{% endtrans %}</p></div><a class="admin-button admin-button--compact" href="{{ path('admin_payments_failures_index') }}">{% trans %}Ouvrir{% endtrans %}</a></header>
                                        <div class="admin-card__body admin-card-list">
                                            {% for payment in latestFailedPayments %}
                                                <div class="admin-list-item"><div class="admin-list-item__head"><div><div class="admin-list-item__title">#{{ payment.id }} · {{ payment.userEmail }}</div><div class="admin-list-item__meta">{{ payment.provider }} · {{ payment.plan }} · {{ payment.status }}</div><div class="admin-list-item__meta">{{ payment.paidAt ? payment.paidAt|date('d/m/Y H:i') : '-' }}</div></div><span class="admin-status admin-status--danger">{{ payment.amount|number_format(0, ',', ' ') }} {{ payment.currency }}</span></div></div>
                                            {% else %}<div class="admin-empty">{% trans %}Aucun paiement échoué{% endtrans %}</div>{% endfor %}
                                        </div>
                                    </article>

                                    <article class="admin-card admin-col-4">
                                        <header class="admin-card__header"><div><h2 class="admin-section-title">Queue payouts</h2><p class="admin-section-subtitle">{% trans %}Reversements à approuver.{% endtrans %}</p></div><a class="admin-button admin-button--compact" href="{{ path('admin_payments_index') }}">Payouts</a></header>
                                        <div class="admin-card__body admin-card-list">
                                            {% for payout in payoutQueue %}
                                                <div class="admin-list-item"><div class="admin-list-item__head"><div><div class="admin-list-item__title">{{ payout.beneficiary|default('—') }}</div><div class="admin-list-item__meta">{{ payout.status|default('—') }}</div></div><span class="admin-status admin-status--warning">{{ (payout.amount|default(0))|number_format(0, ',', ' ') }}</span></div></div>
                                            {% else %}<div class="admin-empty">{% trans %}Aucun payout en attente{% endtrans %}</div>{% endfor %}
                                        </div>
                                    </article>

                                    <article class="admin-card admin-col-4">
                                        <header class="admin-card__header"><div><h2 class="admin-section-title">{% trans %}Derniers paiements{% endtrans %}</h2><p class="admin-section-subtitle">{% trans %}Traçabilité monétique et factures.{% endtrans %}</p></div><a class="admin-button admin-button--compact" href="{{ path('admin_payments_index') }}">{% trans %}Voir tout{% endtrans %}</a></header>
                                        <div class="admin-table-wrap">
                                            <table class="admin-table" style="min-width:430px;">
                                                <thead><tr><th>{% trans %}Montant{% endtrans %}</th><th>{% trans %}Date{% endtrans %}</th><th>{% trans %}Facture{% endtrans %}</th></tr></thead>
                                                <tbody>
                                                    {% for payment in latestPayments %}
                                                        <tr>
                                                            <td class="admin-table__title">{{ payment.amount is defined and payment.amount ? payment.amount|number_format(0, ',', ' ') : '-' }} XAF</td>
                                                            <td>{{ payment.paidAt is defined and payment.paidAt ? payment.paidAt|date('d/m/Y H:i') : '-' }}</td>
                                                            <td>
                                                                {% if payment.invoices is defined and payment.invoices|length > 0 %}
                                                                    <a class="admin-button admin-button--compact admin-button--icon" href="{{ path('invoice_download', {slug: payment.invoices[0].slug}) }}" title="{{ 'Télécharger la facture'|trans }}">📥</a>
                                                                {% else %}
                                                                    <span class="admin-status">{% trans %}Indisponible{% endtrans %}</span>
                                                                {% endif %}
                                                            </td>
                                                        </tr>
                                                    {% else %}<tr><td colspan="3" class="admin-empty">{% trans %}Aucun paiement récent{% endtrans %}</td></tr>{% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    </article>
                                </div>
                            </div>
                        </section>

                        {# =====================================================
                           CLOUD & OPS
                           ===================================================== #}
                        <section class="admin-tab-panel" data-admin-panel="ops">
                            <div class="admin-stack">
                                <div class="admin-grid-12">
                                    <article class="admin-card admin-col-8">
                                        <header class="admin-card__header"><div><h2 class="admin-section-title">{% trans %}Tendances utilisateurs{% endtrans %}</h2><p class="admin-section-subtitle">{% trans %}Inscriptions quotidiennes par rôle.{% endtrans %}</p></div><span class="admin-status admin-status--info">{% trans %}Observabilité{% endtrans %}</span></header>
                                        <div class="admin-card__body"><div class="admin-chart admin-chart--lg"><canvas id="chartHealth"></canvas></div></div>
                                    </article>

                                    <article class="admin-card admin-col-4">
                                        <header class="admin-card__header"><div><h2 class="admin-section-title">Top APIs</h2><p class="admin-section-subtitle">{% trans %}Endpoints les plus sollicités.{% endtrans %}</p></div></header>
                                        <div class="admin-card__body admin-card-list">
                                            {% for api in topApis %}
                                                <div class="admin-list-item"><div class="admin-list-item__head"><div><div class="admin-list-item__title">{{ api.endpoint }}</div><div class="admin-list-item__meta">{{ api.avgMs|number_format(0, ',', ' ') }} ms · {{ api.errorRate|number_format(1, ',', ' ') }}% erreurs</div></div><strong>{{ api.hits >= 1000 ? (api.hits / 1000)|number_format(1, ',', ' ') ~ 'k' : api.hits|number_format(0, ',', ' ') }}</strong></div></div>
                                            {% else %}<div class="admin-empty">{% trans %}Aucune métrique API{% endtrans %}</div>{% endfor %}
                                            <a class="admin-button" href="{{ path('admin_api_metrics_index') }}">📡 Metrics API</a>
                                        </div>
                                    </article>
                                </div>

                                <div class="admin-grid-12">
                                    <article class="admin-card admin-col-8">
                                        <header class="admin-card__header"><div><h2 class="admin-section-title">Control center</h2><p class="admin-section-subtitle">{% trans %}Actions d’exploitation et de gouvernance technique.{% endtrans %}</p></div><span class="admin-status">Ops</span></header>
                                        <div class="admin-card__body">
                                            <div class="admin-control-grid" data-admin-placeholder-actions>
                                                <a class="admin-control-button" href="{{ path('admin_kyc_rules') }}">✅ KYC</a>
                                                {# <button type="button" class="admin-control-button" data-soon-label="{{ 'Réindexer'|trans }}">🔎 {% trans %}Réindexer{% endtrans %}</button>
                                                <button type="button" class="admin-control-button" data-soon-label="Restart queue">📨 Restart queue</button>
                                                <button type="button" class="admin-control-button" data-soon-label="Webhooks">🪝 Webhooks</button> #}
                                                <a class="admin-control-button" href="{{ path('admin_audit_index') }}">🧾 {% trans %}Audit{% endtrans %}</a>
                                                <form method="post" action="{{ path('admin_platform_toggle_maintenance') }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_maintenance') }}">
                                                    <button type="submit" class="admin-control-button {{ maintenanceEnabled|default(false) ? 'admin-button--success' : 'admin-button--danger' }}">
                                                        {{ maintenanceEnabled|default(false) ? '✅' : '⛔' }}
                                                        {{ maintenanceEnabled|default(false) ? ('Rouvrir le site'|trans) : ('Mettre le site en maintenance'|trans) }}
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </article>

                                    <article class="admin-card admin-col-4">
                                        <header class="admin-card__header"><div><h2 class="admin-section-title">{% trans %}Santé technique{% endtrans %}</h2><p class="admin-section-subtitle">{% trans %}Résumé des services applicatifs.{% endtrans %}</p></div></header>
                                        <div class="admin-card__body admin-card-list">
                                            {% set opsRows = [
                                                {'label':'CPU','value':ops.cpu ~ '%','progress':ops.cpu},
                                                {'label':'RAM','value':ops.ram ~ '%','progress':ops.ram},
                                                {'label':'Stockage'|trans,'value':ops.storage ~ '%','progress':ops.storage},
                                                {'label':'Cron success','value':ops.cronSuccess ~ '%','progress':ops.cronSuccess},
                                                {'label':'Queue depth','value':ops.queueDepth,'progress':50}
                                            ] %}
                                            {% for metric in opsRows %}
                                                <div><div class="admin-mini-metric__head"><span>{{ metric.label }}</span><strong>{{ metric.value }}</strong></div><div class="admin-progress"><span style="width:{{ metric.progress > 100 ? 100 : metric.progress }}%"></span></div></div>
                                            {% endfor %}
                                            <div class="admin-list-item__head"><span class="admin-list-item__meta">Backup</span><span class="admin-status admin-status--success">{{ ops.backupStatus }}</span></div>
                                        </div>
                                    </article>
                                </div>
                            </div>
                        </section>

                        
                    </div>
                </main>
            </div>
        </div>

        {# Command center #}
        <div id="adminCommandModal" class="admin-modal" aria-hidden="true">
            <div class="admin-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="adminCommandTitle">
                <header class="admin-modal__header">
                    <div>
                        <h2 id="adminCommandTitle" class="admin-section-title">Command Center</h2>
                        <p class="admin-section-subtitle">{% trans %}Raccourcis administrateur et navigation rapide.{% endtrans %}</p>
                    </div>
                    <button type="button" id="adminCloseCommand" class="admin-button admin-button--icon" aria-label="{{ 'Fermer'|trans }}">×</button>
                </header>
                <div class="admin-modal__body">
                    <input id="adminCommandInput" class="admin-modal__input" type="text" placeholder="{{ 'Tapez une commande ou une action…'|trans }}">
                    <div class="admin-command-grid">
                        <a class="admin-command-card" href="{{ path('admin_companies_pending_index') }}"><div class="admin-command-card__title">✅ {% trans %}Ouvrir la file KYC{% endtrans %}</div><div class="admin-command-card__meta">{% trans %}Entreprises à vérifier et valider{% endtrans %}</div></a>
                        <button type="button" class="admin-command-card" data-open-admin-tab="finance"><div class="admin-command-card__title">💳 {% trans %}Voir les finances{% endtrans %}</div><div class="admin-command-card__meta">RMR, {% trans %}revenus et paiements{% endtrans %}</div></button>
                        <button type="button" class="admin-command-card" data-soon-label="{{ 'Purger le cache'|trans }}"><div class="admin-command-card__title">🧹 {% trans %}Purger le cache{% endtrans %}</div><div class="admin-command-card__meta">{% trans %}Action à brancher côté serveur{% endtrans %}</div></button>
                        <a class="admin-command-card" href="{{ path('admin_security_incidents') }}"><div class="admin-command-card__title">🚨 Incident manager</div><div class="admin-command-card__meta">{% trans %}Piloter les incidents critiques{% endtrans %}</div></a>
                    </div>
                </div>
            </div>
        </div>

        <div id="adminToastWrap" class="admin-toast-wrap" aria-live="polite">
            {% for message in app.flashes('success') %}<div class="admin-toast admin-toast--success">{{ message }}</div>{% endfor %}
            {% for message in app.flashes('warning') %}<div class="admin-toast admin-toast--warning">{{ message }}</div>{% endfor %}
            {% for message in app.flashes('error') %}<div class="admin-toast admin-toast--error">{{ message }}</div>{% endfor %}
        </div>

        {# Seul pont Twig -> JavaScript. Aucun script métier inline. #}
        <script id="adminDashboardData" type="application/json">
            {{ {
                searchUrl: path('admin_search_global'),
                charts: {
                    signups30d: charts.signups30d|default([]),
                    usersSplit: usersSplit,
                    jobs: chartJobVsRecruits.jobsVsRecruits|default({'jobs':0,'recruited':0}),
                    moderation: chartsModeration|default({'spam':0,'abuse':0,'fraud':0,'identity':0,'other':0}),
                    revenue: {
                        labels: revenueChart.labels|default([]),
                        values: revenueChart.mrr|default([])
                    },
                    plans: {
                        labels: subscriptionPlanLabels|default([]),
                        values: subscriptionPlanValues|default([])
                    },
                    providers: {
                        labels: providerLabels|default([]),
                        values: providerValues|default([])
                    },
                    userTrend: {
                        labels: userTrendChart.labels|default([]),
                        talent: userTrendChart.talent|default([]),
                        particulier: userTrendChart.particulier|default([]),
                        company: userTrendChart.company|default([])
                    },
                    growth: signupChartData|default({
                        '30': {'labels': [], 'signups': []},
                        '90': {'labels': [], 'signups': []},
                        '12': {'labels': [], 'signups': []}
                    })
                },
                i18n: {
                    users: 'Utilisateurs'|trans,
                    companies: 'Entreprises'|trans,
                    jobs: 'Offres'|trans,
                    transactions: 'Transactions'|trans,
                    tickets: 'Tickets'|trans,
                    noResult: 'Aucun résultat'|trans,
                    searchError: 'Erreur lors de la recherche globale'|trans,
                    comingSoon: 'bientôt disponible'|trans,
                    signups: 'Inscriptions'|trans,
                    recruited: 'Recrutés'|trans,
                    volume: 'Volume'|trans,
                    reports: 'Signalements'|trans,
                    spam: 'Spam'|trans,
                    abuse: 'Abus'|trans,
                    fraud: 'Fraude'|trans,
                    identity: 'Identité'|trans,
                    other: 'Autres'|trans
                }
            }|json_encode|raw }}
        </script>

        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js" defer></script>
        <script src="{{ asset('js/admin-dashboard.js') }}?v=20260726-2" defer></script>
    </div>
