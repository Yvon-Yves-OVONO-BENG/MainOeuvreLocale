{% extends 'base.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{% trans %}Tableau de bord administrateur{% endtrans %}{% endblock %}

{% block body %}
    {% include 'tableau_de_bord_administrateur/_vip_ui.html.twig' %}

    {# =====================================================
       Valeurs sûres : on conserve les variables existantes
       sans rendre le template fragile si une donnée manque.
       ===================================================== #}
    {% set kpi = kpi|default({}) %}
    {% set envLabel = environment|default('PROD') %}
    {% set securityEvents = securityEvents|default([]) %}
    {% set alertsData = alertsData|default([]) %}
    {% set flaggedJobs = flaggedJobs|default([]) %}
    {% set topZones = topZones|default([]) %}
    {% set recentConnections = recentConnections|default([]) %}
    {% set pendingKyc = pendingKyc|default([]) %}
    {% set latestFailedPayments = latestFailedPayments|default([]) %}
    {% set payoutQueue = payoutQueue|default([]) %}
    {% set latestPayments = latestPayments|default([]) %}
    {% set topApis = topApis|default([]) %}
    {% set plansData = plansData|default([]) %}
    {% set providerData = providerData|default([]) %}
    {% set usersSplit = usersSplit|default({'company': 0, 'talent': 0, 'particulier': 0, 'staff': 0}) %}
    {% set growthStats = growthStats|default({'signups': 0, 'delta': 0}) %}
    {% set activationRate = activationRate|default(0) %}
    {% set retentionRate = retentionRate|default(0) %}
    {% set roleCounts = roleCounts|default({
        'superAdmin': 0,
        'admin': 0,
        'moderateur': 0,
        'company': 0,
        'particulier': 0,
        'talent': 0
    }) %}
    {% set complianceChecklist = complianceChecklist|default({
        'twoFactorStaff': {'rate': 0},
        'kycCompanies': {'rate': 0},
        'sensitiveLogs': {'rate': 0},
        'signedWebhooks': {'rate': 0},
        'encryptedBackups': {'allEncrypted': false}
    }) %}
    {% set securityPosture = kpi.securityPosture|default({
        'score': 0,
        'metrics': {
            'twoFactorStaff': {'label': '2FA staff', 'rate': 0},
            'kycCompanies': {'label': 'KYC entreprises', 'rate': 0},
            'auditCoverage': {'label': 'Couverture audit', 'rate': 0}
        }
    }) %}
    {% set ops = ops|default({
        'uptime': 99.98,
        'latency': 182,
        'errorRate': 0.24,
        'cpu': 46,
        'ram': 63,
        'storage': 71,
        'queueDepth': 148,
        'cronSuccess': 98,
        'backupStatus': 'OK',
        'securityScore': 91,
        'openIncidents': 2,
        'deploymentsToday': 6,
        'apiCallsToday': 128420,
        'failedPayments': 3,
        'activeSubscriptions': 184,
        'mrr': 2450000,
        'gmv': 18600000
    }) %}

    {% set currentRoute = app.request.attributes.get('_route')|default('') %}
    {% set unreadMessages = kpi.unreadAdminMessages ?? 0 %}

    <div class="admin-dashboard" data-admin-dashboard>
        <div class="admin-dashboard__container">
            <div class="admin-dashboard__layout">

                {# =====================================================
                   MENU GAUCHE CONSERVÉ
                   ===================================================== #}
                <aside class="admin-sidebar">
                    <div class="admin-sidebar__panel">
                        <div class="admin-sidebar__header">
                            <div class="admin-sidebar__identity">
                                <span class="admin-sidebar__logo" aria-hidden="true">🛡️</span>
                                <div>
                                    <h2 class="admin-sidebar__title">Admin Console</h2>
                                    <div class="admin-sidebar__subtitle">Main d’Œuvre Locale</div>
                                </div>
                            </div>

                            <button
                                type="button"
                                id="adminSidebarToggle"
                                class="admin-sidebar__toggle"
                                aria-controls="adminSidebarBody"
                                aria-expanded="false"
                                title="{{ 'Afficher ou masquer le menu'|trans }}"
                            >☰</button>
                        </div>

                        <div id="adminSidebarBody" class="admin-sidebar__body">
                            {% set nav = [
                                {'route':'tableau_de_bord','href':path('tableau_de_bord'),'label':'Tableau de bord'|trans,'icon':'🏠','badge':'Accueil'|trans},
                                {'route':'admin_categories_index','href':path('admin_categories_index'),'label':'Catégories'|trans,'icon':'🏷️','badge':kpi.categories ?? '-'},
                                {'route':'admin_professions_index','href':path('admin_professions_index'),'label':'Professions'|trans,'icon':'💼','badge':kpi.professions ?? '-'},
                                {'route':'admin_talents_index','href':path('admin_talents_index'),'label':'Talents'|trans,'icon':'🧑‍🔧','badge':kpi.talents ?? '-'},
                                {'route':'admin_companies_index','href':path('admin_companies_index'),'label':'Compagnies'|trans,'icon':'🏢','badge':kpi.companies ?? '-'},
                                {'route':'admin_individuals_index','href':path('admin_individuals_index'),'label':'Particuliers'|trans,'icon':'🧑‍💼','badge':kpi.individuals ?? '-'},
                                {'route':'admin_moderators_index','href':path('admin_moderators_index'),'label':'Modérateurs'|trans,'icon':'🧿','badge':kpi.moderators ?? '-'},
                                {'route':'admin_jobs_moderation','href':path('admin_jobs_moderation'),'label':'Modération Offres'|trans,'icon':'📣','badge':kpi.pendingModerationJobs ?? 0,'tone':'warning'},
                                {'route':'admin_annonces_moderation','href':path('admin_annonces_moderation'),'label':'Modération Annonces'|trans,'icon':'📢','badge':'À valider'|trans,'tone':'warning'},
                                {'route':'moderateur_verifications_index','href':path('moderateur_verifications_index'),'label':'Vérifications'|trans,'icon':'✅','badge':kpi.pendingVerifications ?? (kpi.pendingProfiles ?? '-'),'tone':'warning'},
                                {'route':'admin_harassment_investigate','href':path('admin_harassment_investigate'),'label':'Harcèlement'|trans,'icon':'🚨','badge':kpi.harassmentOpen ?? 0,'tone':'danger'},
                                {'route':'moderateur_reports_index','href':path('moderateur_reports_index'),'label':'Signalements'|trans,'icon':'🚨','badge':kpi.pendingReports ?? '-','tone':'danger'},
                                {'route':'admin_payment_dispute_index','href':path('admin_payment_dispute_index'),'label':'Litiges'|trans,'icon':'💳','badge':securityEvents|length,'tone':'danger'},
                                {'route':'admin_kyc_rules','href':path('admin_kyc_rules'),'label':'Règles KYC'|trans,'icon':'🧠','badge':kpi.rules ?? '-','tone':'danger'},
                                {'route':'admin_sanction_index','href':path('admin_sanction_index'),'label':'Sanctions'|trans,'icon':'🧾','badge':(kpi.sanctions ?? 0)|number_format(0, ',', ' '),'tone':'warning'},
                                {'route':'admin_invoices_index','href':path('admin_invoices_index'),'label':'Paiements du jour'|trans,'icon':'💳','badge':(kpi.paymentsToday ?? 0)|number_format(0, ',', ' ')},
                                {'route':'admin_newsletter_index','href':path('admin_newsletter_index'),'label':'Alertes offres'|trans,'icon':'🔔','badge':'Auto'},
                                {'route':'admin_audit_index','href':path('admin_audit_index'),'label':'Audit & logs'|trans,'icon':'🧾','badge':'Logs'},
                                {'route':'admin_incidents_index','href':path('admin_incidents_index'),'label':'Incidents techniques'|trans,'icon':'⚠️','badge':'Erreurs'|trans,'tone':'danger'},
                                {'route':'admin_support_new','href':path('admin_support_new'),'label':'Support'|trans,'icon':'🎧','badge':kpi.openTickets ?? '-'}
                            ] %}

                            <nav class="admin-nav" aria-label="{{ 'Navigation administration'|trans }}">
                                {% for item in nav %}
                                    {% set isActive = currentRoute == item.route %}
                                    <a
                                        href="{{ item.href }}"
                                        class="admin-nav__link{{ isActive ? ' is-active' : '' }}{{ item.tone is defined ? ' is-' ~ item.tone : '' }}"
                                        data-turbo="false"
                                    >
                                        <span class="admin-nav__main">
                                            <span class="admin-nav__icon" aria-hidden="true">{{ item.icon }}</span>
                                            <span class="admin-nav__label">{{ item.label }}</span>
                                        </span>
                                        <span class="admin-nav__badge">{{ item.badge }}</span>
                                    </a>
                                {% endfor %}
                            </nav>

                            {# <section class="admin-sidebar__section">
                                <div class="admin-sidebar__section-head">
                                    <span class="admin-sidebar__section-title">{% trans %}Actions rapides{% endtrans %}</span>
                                    <span class="admin-sidebar__section-label">Ops</span>
                                </div>
                                <div class="admin-sidebar__quick-grid">
                                    <a class="admin-sidebar__quick" href="{{ path('moderateur_verifications_index') }}">✅ {% trans %}Valider{% endtrans %}</a>
                                    <a class="admin-sidebar__quick" href="{{ path('admin_harassment_investigate') }}">🚨 {% trans %}Traiter{% endtrans %}</a>
                                    <a class="admin-sidebar__quick" href="{{ path('admin_annonces_moderation') }}" data-turbo="false">📢 {% trans %}Annonces{% endtrans %}</a>
                                    <a class="admin-sidebar__quick" href="{{ path('admin_broadcast_index') }}">📣 Broadcast</a>
                                </div>
                            </section> #}

                            {# <section class="admin-sidebar__section">
                                <div class="admin-sidebar__section-head">
                                    <div>
                                        <div class="admin-sidebar__section-title">{% trans %}Centre d’administration{% endtrans %}</div>
                                        <div class="admin-sidebar__section-label">{% trans %}Sécurité • Finance • Support{% endtrans %}</div>
                                    </div>
                                </div>
                                <div class="admin-sidebar__chips">
                                    <a class="admin-sidebar__chip" href="{{ path('admin_settings_index') }}">⚙️ {% trans %}Paramètres{% endtrans %}</a>
                                    <a class="admin-sidebar__chip" href="{{ path('admin_backups_index') }}">🗄️ Backups</a>
                                    <a class="admin-sidebar__chip" href="{{ path('admin_integrations_index') }}">🔌 {% trans %}Intégrations{% endtrans %}</a>
                                </div>
                            </section> #}
                        </div>
                    </div>
                </aside>

                {# =====================================================
                   CONTENU CENTRAL REDISPOSÉ
                   ===================================================== #}
                <main class="admin-main" style="padding:clamp(12px, 1.8vw, 24px);">
                    <div class="admin-stack">

                        <section class="admin-hero">
                            <div class="admin-hero__inner">
                                <div>
                                    {# <div class="admin-eyebrow">Administration · {{ envLabel }}</div> #}
                                    <h1 class="admin-hero__title">{% trans %}Tableau de bord Admin.{% endtrans %}</h1>
                                    {# <p class="admin-hero__description">
                                        {% trans %}Utilisateurs, modération, paiements, sécurité et exploitation sont regroupés par niveau de priorité, sans supprimer vos outils ni modifier vos routes.{% endtrans %}
                                    </p> #}

                                    <div class="admin-hero__meta">
                                        <a
                                            class="admin-meta-chip"
                                            href="{{ path('admin_users_online') }}"
                                            style="color:inherit;text-decoration:none;cursor:pointer;"
                                            title="{{ 'Afficher les utilisateurs connectés'|trans }}"
                                        >👥 {% trans %}Connectés :{% endtrans %} {{ kpi.onlineUsers ?? '-' }}</a>
                                        <a
                                            class="admin-meta-chip admin-meta-chip--info"
                                            href="{{ path('admin_users_signups_24h') }}"
                                            style="color:inherit;text-decoration:none;cursor:pointer;"
                                            title="{{ 'Afficher les inscriptions des dernières 24 heures'|trans }}"
                                        >✨ {% trans %}Inscriptions 24h :{% endtrans %} {{ kpi.signups24h ?? '-' }}</a>
                                        {# <span class="admin-meta-chip admin-meta-chip--danger">🚨 {% trans %}Incidents :{% endtrans %} {{ kpi.incidentsOpen ?? 0 }}</span> #}
                                        {# <span class="admin-meta-chip admin-meta-chip--success">💰 {{ (kpi.mrr ?? 0)|number_format(0, ',', ' ') }} XAF RMR</span> #}
                                        {# <span class="admin-meta-chip">🕒 <span id="adminLiveClock">--:--:--</span></span> #}
                                    </div>
                                </div>

                                <div class="admin-hero__actions">
                                    <div class="admin-search">
                                        <input
                                            id="adminSearch"
                                            class="admin-search__input"
                                            type="search"
                                            autocomplete="off"
                                            placeholder="{{ 'Rechercher un utilisateur, une offre, un paiement…'|trans }}"
                                            aria-label="{{ 'Recherche globale'|trans }}"
                                        >
                                        <span class="admin-search__icon" aria-hidden="true">⌕</span>
                                        <div id="globalSearchResults" class="admin-search__results" hidden>
                                            <div id="searchResultsContent"></div>
                                        </div>
                                    </div>

                                    {# <button type="button" class="admin-button admin-button--dark" data-chat-open>
                                        💬 {% trans %}Messages{% endtrans %}
                                        {% if unreadMessages > 0 %}
                                            <span class="admin-status admin-status--danger">{{ unreadMessages > 99 ? '99+' : unreadMessages }}</span>
                                        {% endif %}
                                    </button> #}
                                    <a class="admin-button admin-button--primary" href="{{ path('admin_broadcast_index') }}">📢 {% trans %}Notifier{% endtrans %}</a>
                                    {# <button type="button" id="adminOpenCommand" class="admin-button">⌘ {% trans %}Commandes{% endtrans %}</button> #}
                                </div>
                            </div>
                        </section>

                        {# Priorités directement actionnables #}
                        <section>
                            <div class="admin-card__header" style="padding:0 0 10px;border:0;">
                                <div>
                                    {# <h2 class="admin-section-title">{% trans %}Priorités administratives{% endtrans %}</h2>
                                    <p class="admin-section-subtitle">{% trans %}Les files qui nécessitent une décision ou une vérification immédiate.{% endtrans %}</p> #}
                                </div>
                            </div>

                            <div class="admin-priority-grid">
                                <a class="admin-action-card" href="{{ path('moderateur_verifications_index') }}">
                                    <div class="admin-action-card__top">
                                        <span class="admin-action-card__icon">✅</span>
                                        <strong class="admin-action-card__count">{{ kpi.pendingVerifications ?? (kpi.pendingProfiles ?? 0) }}</strong>
                                    </div>
                                    <div>
                                        <h3 class="admin-action-card__title">{% trans %}Profils à vérifier{% endtrans %}</h3>
                                        <p class="admin-action-card__description">{% trans %}Contrôler les profils, pièces et informations professionnelles.{% endtrans %}</p>
                                        <span class="admin-action-card__link">{% trans %}Ouvrir la file{% endtrans %} →</span>
                                    </div>
                                </a>

                                <a class="admin-action-card admin-action-card--warning" href="{{ path('admin_jobs_moderation') }}" data-turbo="false">
                                    <div class="admin-action-card__top">
                                        <span class="admin-action-card__icon">📣</span>
                                        <strong class="admin-action-card__count">{{ kpi.pendingModerationJobs ?? 0 }}</strong>
                                    </div>
                                    <div>
                                        <h3 class="admin-action-card__title">{% trans %}Offres à modérer{% endtrans %}</h3>
                                        <p class="admin-action-card__description">{% trans %}Examiner la conformité et la qualité des offres soumises.{% endtrans %}</p>
                                        <span class="admin-action-card__link">{% trans %}Modérer les offres{% endtrans %} →</span>
                                    </div>
                                </a>

                                <a class="admin-action-card admin-action-card--warning" href="{{ path('admin_annonces_moderation') }}" data-turbo="false">
                                    <div class="admin-action-card__top">
                                        <span class="admin-action-card__icon">📢</span>
                                        <strong class="admin-action-card__count">{{ kpi.pendingModerationAnnonces ?? '—' }}</strong>
                                    </div>
                                    <div>
                                        <h3 class="admin-action-card__title">{% trans %}Annonces à modérer{% endtrans %}</h3>
                                        <p class="admin-action-card__description">{% trans %}Valider, refuser ou demander une correction avant diffusion.{% endtrans %}</p>
                                        <span class="admin-action-card__link">{% trans %}Modérer les annonces{% endtrans %} →</span>
                                    </div>
                                </a>

                                <a class="admin-action-card admin-action-card--danger" href="{{ path('moderateur_reports_index', {status: 'open'}) }}">
                                    <div class="admin-action-card__top">
                                        <span class="admin-action-card__icon">🚨</span>
                                        <strong class="admin-action-card__count">{{ kpi.pendingReports ?? 0 }}</strong>
                                    </div>
                                    <div>
                                        <h3 class="admin-action-card__title">{% trans %}Signalements ouverts{% endtrans %}</h3>
                                        <p class="admin-action-card__description">{% trans %}Traiter les abus, fraudes, contenus et comportements signalés.{% endtrans %}</p>
                                        <span class="admin-action-card__link">{% trans %}Traiter les urgences{% endtrans %} →</span>
                                    </div>
                                </a>

                                <a class="admin-action-card admin-action-card--danger" href="{{ path('admin_payment_dispute_index') }}">
                                    <div class="admin-action-card__top">
                                        <span class="admin-action-card__icon">💳</span>
                                        <strong class="admin-action-card__count">{{ securityEvents|length }}</strong>
                                    </div>
                                    <div>
                                        <h3 class="admin-action-card__title">{% trans %}Litiges de paiement{% endtrans %}</h3>
                                        <p class="admin-action-card__description">{% trans %}Contrôler les transactions contestées ou nécessitant une preuve.{% endtrans %}</p>
                                        <span class="admin-action-card__link">{% trans %}Voir les litiges{% endtrans %} →</span>
                                    </div>
                                </a>

                                <a class="admin-action-card admin-action-card--success" href="{{ path('admin_support_new') }}">
                                    <div class="admin-action-card__top">
                                        <span class="admin-action-card__icon">🎧</span>
                                        <strong class="admin-action-card__count">{{ kpi.openTickets ?? 0 }}</strong>
                                    </div>
                                    <div>
                                        <h3 class="admin-action-card__title">{% trans %}Tickets support{% endtrans %}</h3>
                                        <p class="admin-action-card__description">{% trans %}Suivre les demandes qui attendent une réponse administrative.{% endtrans %}</p>
                                        <span class="admin-action-card__link">{% trans %}Accéder au support{% endtrans %} →</span>
                                    </div>
                                </a>
                            </div>
                        </section>

                        {# KPI essentiels #}
                        <section class="admin-kpi-grid">
                            {% set mainKpis = [
                                {'label':'Comptes actifs'|trans,'value':kpi.activeAccounts ?? 0,'icon':'✓','href':path('admin_users_index'),'meta':'+' ~ (kpi.activeDelta7d ?? 0) ~ ' / 7j'},
                                {'label':'Comptes bloqués'|trans,'value':kpi.blockedAccounts ?? 0,'icon':'⛔','href':path('admin_users_index'),'meta':'Fraude / abus'|trans},
                                {'label':'Offres actives'|trans,'value':kpi.activeJobs ?? 0,'icon':'📣','href':path('admin_jobs_index', {status:'active'}),'meta':'Qualité & conformité'|trans},
                                {'label':'Signalements ouverts'|trans,'value':kpi.pendingReports ?? 0,'icon':'🚨','href':path('moderateur_reports_index'),'meta':'SLA : ' ~ (kpi.slaHours ?? '—')}
                            ] %}

                            {% for item in mainKpis %}
                                <article class="admin-kpi">
                                    <div class="admin-kpi__head">
                                        <span class="admin-kpi__label">{{ item.label }}</span>
                                        <span class="admin-kpi__icon">{{ item.icon }}</span>
                                    </div>
                                    <div class="admin-kpi__value">{{ item.value }}</div>
                                    <div class="admin-kpi__meta">
                                        <span>{{ item.meta }}</span>
                                        <a href="{{ item.href }}">{% trans %}Ouvrir{% endtrans %} →</a>
                                    </div>
                                </article>
                            {% endfor %}
                        </section>

                        {# Bande compacte : données business et exploitation #}
                        {% set usersCurrent = kpi.usersCurrentMonthCount ?? 0 %}
                        {% set usersPrevious = kpi.usersPreviousMonthCount ?? 0 %}
                        {% set usersProgress = usersPrevious > 0 ? ((usersCurrent / usersPrevious) * 100) : (usersCurrent > 0 ? 100 : 0) %}
                        {% if usersProgress > 100 %}{% set usersProgress = 100 %}{% endif %}

                        <section class="admin-metric-strip">
                            <div class="admin-metric">
                                <div class="admin-metric__label">{% trans %}Utilisateurs ce mois{% endtrans %}</div>
                                <div class="admin-metric__value" data-count="{{ usersCurrent }}">{{ usersCurrent }}</div>
                                <div class="admin-metric__note">{{ usersCurrent }}/{{ usersPrevious }} · {{ (kpi.usersCurrentMonthDelta ?? 0)|number_format(1, ',', ' ') }}%</div>
                                <div class="admin-progress"><span style="width:{{ usersProgress }}%"></span></div>
                            </div>

                            <div class="admin-metric">
                                <div class="admin-metric__label">{% trans %}Revenu mensuel récurrent{% endtrans %}</div>
                                <div class="admin-metric__value">{{ (kpi.mrr ?? 0)|number_format(0, ',', ' ') }} XAF</div>
                                <div class="admin-metric__note">{{ (kpi.mrrDelta ?? 0) >= 0 ? '+' : '' }}{{ (kpi.mrrDelta ?? 0)|number_format(1, ',', ' ') }}%</div>
                                <div class="admin-progress"><span style="width:{{ kpi.mrrProgress ?? 0 }}%"></span></div>
                            </div>

                            <div class="admin-metric">
                                <div class="admin-metric__label">{% trans %}Valeur brute des transactions{% endtrans %}</div>
                                <div class="admin-metric__value">{{ (kpi.gmvStats.gmv ?? 0)|number_format(0, ',', ' ') }} XAF</div>
                                <div class="admin-metric__note">VBTT plateforme</div>
                                <div class="admin-progress"><span style="width:100%"></span></div>
                            </div>

                            <a class="admin-metric" href="{{ path('admin_uptime_index') }}">
                                <div class="admin-metric__label">Uptime</div>
                                <div class="admin-metric__value">{{ ops.uptime|default(0)|number_format(2, ',', ' ') }}%</div>
                                <div class="admin-metric__note">{% trans %}Disponibilité plateforme{% endtrans %}</div>
                                <div class="admin-progress"><span style="width:{{ ops.uptime|default(0) > 100 ? 100 : ops.uptime|default(0) }}%"></span></div>
                            </a>

                            <a class="admin-metric" href="{{ path('admin_api_latency_index') }}">
                                {% set latency = kpi.latency|default(ops.latency|default(0)) %}
                                {% set latencyProgress = latency <= 100 ? 90 : (latency <= 200 ? 70 : (latency <= 400 ? 45 : 20)) %}
                                <div class="admin-metric__label">API latency</div>
                                <div class="admin-metric__value">{{ latency }} ms</div>
                                <div class="admin-metric__note">{% trans %}Temps de réponse moyen{% endtrans %}</div>
                                <div class="admin-progress"><span style="width:{{ latencyProgress }}%"></span></div>
                            </a>
                        </section>

                        <div class="admin-tabs-wrap">
                            <div class="admin-tabs" role="tablist" aria-label="{{ 'Sections du tableau de bord'|trans }}">
                                <button type="button" class="admin-tab is-active" data-admin-tab="overview" role="tab" aria-selected="true">📊 {% trans %}Vue d’ensemble{% endtrans %}</button>
                                <button type="button" class="admin-tab" data-admin-tab="finance" role="tab" aria-selected="false">💳 {% trans %}Finance{% endtrans %}</button>
                                <button type="button" class="admin-tab" data-admin-tab="ops" role="tab" aria-selected="false">☁️ {% trans %}Cloud & Ops{% endtrans %}</button>
                            </div>
                        </div>

                        {# =====================================================
                           VUE D'ENSEMBLE
                           ===================================================== #}
                        <section class="admin-tab-panel is-active" data-admin-panel="overview">
                            <div class="admin-stack">
                                <div class="admin-grid-12">
                                    <article class="admin-card admin-card--elevated admin-col-7">
                                        <header class="admin-card__header">
                                            <div>
                                                <h2 class="admin-section-title">{% trans %}Croissance & inscriptions{% endtrans %}</h2>
                                                <p class="admin-section-subtitle">{% trans %}Évolution des inscriptions selon la période sélectionnée.{% endtrans %}</p>
                                            </div>
                                            <div class="admin-tabs" data-growth-range-switcher>
                                                <button type="button" class="admin-tab" data-growth-range="30">30j</button>
                                                <button type="button" class="admin-tab" data-growth-range="90">90j</button>
                                                <button type="button" class="admin-tab is-active" data-growth-range="12">12m</button>
                                            </div>
                                        </header>
                                        <div class="admin-card__body">
                                            <div class="admin-kpi__meta" style="justify-content:flex-start;margin-top:0;">
                                                <strong class="admin-section-title">{{ growthStats.signups|default(0) }}</strong>
                                                <span>{{ growthStats.delta|default(0) >= 0 ? '+' : '' }}{{ growthStats.delta|default(0) }}%</span>
                                            </div>
                                            <div class="admin-chart admin-chart--lg"><canvas id="chartSignups"></canvas></div>
                                        </div>
                                    </article>

                                    <article class="admin-card admin-card--elevated admin-col-5">
                                        <header class="admin-card__header">
                                            <div>
