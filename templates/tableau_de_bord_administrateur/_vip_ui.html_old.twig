/* =========================================================
   RESPONSIVE DASHBOARD — À AJOUTER À LA FIN DU CSS
   ========================================================= */

/* Empêche les éléments de dépasser horizontalement */
html,
body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
}

*,
*::before,
*::after {
    box-sizing: border-box;
}

/* Les contenus flex et grid peuvent réellement se réduire */
.sa-card,
.sa-glass,
.sa-card-soft,
.sa-kpi,
.sa-tab-panel,
main,
section,
article,
aside {
    min-width: 0;
    max-width: 100%;
}

/* Ne jamais désactiver les liens et boutons */
a,
button,
input,
select,
textarea,
.sa-btn,
.sa-tab-btn,
.sa-chip-filter {
    pointer-events: auto !important;
    position: relative;
    z-index: 2;
    touch-action: manipulation;
}

/* Les décorations ne doivent pas bloquer les clics */
.sa-card::before,
.sa-card::after,
.sa-glass::before,
.sa-glass::after,
.sa-kpi::before,
.sa-kpi::after {
    pointer-events: none !important;
}

/* Images, graphiques, SVG et vidéos responsifs */
img,
svg,
video,
canvas {
    max-width: 100%;
}

img,
video {
    height: auto;
}

canvas {
    width: 100% !important;
    max-width: 100% !important;
}

/* Permet aux textes longs de revenir à la ligne */
.sa-card,
.sa-glass,
.sa-card-soft,
.sa-alert,
.sa-toast,
.sa-chip,
.sa-badge,
.sa-btn,
.sa-tab-btn,
td,
th {
    overflow-wrap: anywhere;
    word-break: normal;
}

/* Les conteneurs flex ne doivent pas pousser la page */
.flex,
[class*="flex"] {
    min-width: 0;
}

/* =========================================================
   TABLEAUX RESPONSIFS
   ========================================================= */

/*
 * Les cartes contenant directement ou indirectement un tableau
 * deviennent scrollables horizontalement.
 */
.sa-card:has(table),
.sa-glass:has(table),
.sa-card-soft:has(table),
.overflow-table,
.table-responsive,
.sa-table-wrapper {
    width: 100%;
    max-width: 100%;
    overflow-x: auto !important;
    overflow-y: visible;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    touch-action: pan-x pan-y;
    scrollbar-width: thin;
    scrollbar-color: rgba(100, 116, 139, .65) rgba(226, 232, 240, .55);
}

/* Scrollbar visible sur Chrome, Edge et Safari */
.sa-card:has(table)::-webkit-scrollbar,
.sa-glass:has(table)::-webkit-scrollbar,
.sa-card-soft:has(table)::-webkit-scrollbar,
.overflow-table::-webkit-scrollbar,
.table-responsive::-webkit-scrollbar,
.sa-table-wrapper::-webkit-scrollbar {
    height: 8px;
}

.sa-card:has(table)::-webkit-scrollbar-track,
.sa-glass:has(table)::-webkit-scrollbar-track,
.sa-card-soft:has(table)::-webkit-scrollbar-track,
.overflow-table::-webkit-scrollbar-track,
.table-responsive::-webkit-scrollbar-track,
.sa-table-wrapper::-webkit-scrollbar-track {
    background: rgba(226, 232, 240, .55);
    border-radius: 999px;
}

.sa-card:has(table)::-webkit-scrollbar-thumb,
.sa-glass:has(table)::-webkit-scrollbar-thumb,
.sa-card-soft:has(table)::-webkit-scrollbar-thumb,
.overflow-table::-webkit-scrollbar-thumb,
.table-responsive::-webkit-scrollbar-thumb,
.sa-table-wrapper::-webkit-scrollbar-thumb {
    background: rgba(100, 116, 139, .65);
    border-radius: 999px;
}

/* Conserve la structure horizontale des tableaux */
.sa-table,
table {
    width: 100%;
    border-collapse: collapse;
}

/* Les grands tableaux restent scrollables au lieu d'écraser les colonnes */
.sa-card:has(table) table,
.sa-glass:has(table) table,
.sa-card-soft:has(table) table,
.table-responsive table,
.sa-table-wrapper table,
.overflow-table table {
    min-width: 720px;
}

/* Cellules lisibles */
.sa-table th,
.sa-table td {
    padding: 12px 14px;
    vertical-align: middle;
}

/* La colonne des actions reste utilisable */
.sa-table td:last-child,
.sa-table th:last-child {
    white-space: nowrap;
}

/* =========================================================
   TABLETTES
   ========================================================= */

@media (max-width: 1024px) {
    .sa-card,
    .sa-glass {
        border-radius: 18px;
    }

    .sa-kpi {
        padding: 16px;
        border-radius: 20px;
    }

    /* Les grilles Tailwind trop larges passent sur deux colonnes */
    .grid.grid-cols-4,
    .grid.grid-cols-5,
    .grid.grid-cols-6,
    .lg\:grid-cols-4,
    .xl\:grid-cols-4,
    .xl\:grid-cols-5,
    .xl\:grid-cols-6 {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }

    /* Les zones principales avec sidebar restent réductibles */
    main,
    .main-content,
    .dashboard-content,
    .sa-dashboard-content {
        width: 100%;
        min-width: 0;
        max-width: 100%;
    }
}

/* =========================================================
   MOBILES
   ========================================================= */

@media (max-width: 767px) {
    body {
        overflow-x: hidden;
    }

    /* Espacement général plus adapté au mobile */
    main,
    .main-content,
    .dashboard-content,
    .sa-dashboard-content {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        padding-left: 12px !important;
        padding-right: 12px !important;
    }

    /* Toutes les grandes grilles passent sur une colonne */
    .grid,
    .grid.grid-cols-2,
    .grid.grid-cols-3,
    .grid.grid-cols-4,
    .grid.grid-cols-5,
    .grid.grid-cols-6,
    .sm\:grid-cols-2,
    .md\:grid-cols-2,
    .md\:grid-cols-3,
    .lg\:grid-cols-2,
    .lg\:grid-cols-3,
    .lg\:grid-cols-4,
    .xl\:grid-cols-4,
    .xl\:grid-cols-5,
    .xl\:grid-cols-6 {
        grid-template-columns: minmax(0, 1fr) !important;
    }

    /* Les rangées flex se placent verticalement */
    .sa-mobile-stack,
    .sa-card > .flex,
    .sa-glass > .flex,
    .sa-card-soft > .flex {
        flex-wrap: wrap;
        min-width: 0;
    }

    .sa-card,
    .sa-glass,
    .sa-card-soft {
        width: 100%;
        max-width: 100%;
        border-radius: 16px;
    }

    /* Désactive le déplacement hover sur écran tactile */
    .sa-card:hover,
    .sa-btn:hover,
    .sa-tab-btn:hover {
        transform: none;
    }

    .sa-kpi {
        width: 100%;
        padding: 14px;
        border-radius: 18px;
    }

    .sa-icon {
        width: 38px;
        height: 38px;
        min-width: 38px;
        border-radius: 12px;
        font-size: 16px;
    }

    /* Boutons plus faciles à toucher */
    .sa-btn {
        min-height: 42px;
        padding: 10px 13px;
    }

    /* Groupes de boutons responsifs */
    .sa-actions,
    .sa-button-group,
    .actions,
    .card-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        width: 100%;
        max-width: 100%;
    }

    .sa-actions .sa-btn,
    .sa-button-group .sa-btn {
        flex: 1 1 auto;
    }

    /* Les onglets défilent horizontalement sans bloquer la page */
    .sa-tabs,
    .sa-tab-list,
    [role="tablist"] {
        display: flex;
        flex-wrap: nowrap;
        gap: 8px;
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        padding: 4px 2px 10px;
        -webkit-overflow-scrolling: touch;
        touch-action: pan-x;
        scrollbar-width: thin;
    }

    .sa-tab-btn {
        flex: 0 0 auto;
        white-space: nowrap;
        min-height: 40px;
        padding: 9px 12px;
    }

    /* Filtres défilables */
    .sa-chip-filter {
        flex: 0 0 auto;
        white-space: nowrap;
        min-height: 38px;
    }

    /* Tableau mobile */
    .sa-card:has(table),
    .sa-glass:has(table),
    .sa-card-soft:has(table),
    .table-responsive,
    .sa-table-wrapper,
    .overflow-table {
        display: block;
        overflow-x: auto !important;
        overflow-y: visible !important;
        touch-action: pan-x pan-y !important;
    }

    .sa-card:has(table) table,
    .sa-glass:has(table) table,
    .sa-card-soft:has(table) table,
    .table-responsive table,
    .sa-table-wrapper table,
    .overflow-table table {
        width: max-content;
        min-width: 700px;
        max-width: none;
    }

    .sa-table th,
    .sa-table td {
        padding: 10px 12px;
        font-size: 12px;
        white-space: nowrap;
    }

    /* Les toasts ne doivent pas recouvrir toute la largeur */
    .sa-toast-wrap {
        top: auto;
        right: 10px;
        bottom: 10px;
        left: 10px;
        width: auto;
        pointer-events: none;
    }

    .sa-toast,
    .sa-soon-toast {
        min-width: 0;
        width: 100%;
        max-width: 100%;
        pointer-events: none;
    }

    /* Modal responsive, sans bloquer ses propres contrôles */
    #saCommandModal {
        padding: 12px;
