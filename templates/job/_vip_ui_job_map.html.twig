<style>
		.map-page{
			min-height:100vh;
			background:
				radial-gradient(900px 500px at 15% 0%, rgba(246,211,101,.22), transparent 55%),
				radial-gradient(900px 500px at 85% 10%, rgba(79,70,229,.12), transparent 55%),
				linear-gradient(180deg, #f7f9ff, #f3f6fd);
			padding: 28px 0 40px;
		}

		.map-shell{
			border-radius: 22px;
			background: rgba(255,255,255,.88);
			border: 1px solid rgba(15,23,42,.10);
			box-shadow: 0 18px 60px rgba(2,6,23,.10);
			overflow:hidden;
		}

		.map-head{
			padding: 18px 20px;
			border-bottom: 1px solid rgba(15,23,42,.10);
			display:flex;
			align-items:center;
			justify-content:space-between;
			gap:12px;
			flex-wrap:wrap;
			background: linear-gradient(180deg, rgba(255,255,255,.96), rgba(255,255,255,.72));
		}

		.map-grid{
			display:grid;
			grid-template-columns: 360px 1fr;
			min-height: 70vh;
		}

		.map-side{
			border-right: 1px solid rgba(15,23,42,.10);
			background: rgba(255,255,255,.70);
			backdrop-filter: blur(10px);
			overflow:auto;
		}

		.map-item{
			padding: 14px 16px;
			border-bottom: 1px solid rgba(15,23,42,.08);
		}
		.map-item:last-child{ border-bottom: 0; }

		.map-item-title{
			font-weight: 900;
			color: #0b1220;
			margin-bottom: 4px;
		}

		.map-item-meta{
			color: rgba(15,23,42,.62);
			font-size: 13px;
			margin-bottom: 8px;
		}

		#jobsCityMap{
			position:relative;
			display:block;
			width:100%;
			height:100%;
			min-height: 70vh;
			background:#e9f0f8;
		}
		#jobsCityMap.leaflet-container{height:100% !important;min-height:70vh !important;}

		.map-empty{
			padding: 18px;
			color: rgba(15,23,42,.68);
		}

		@media (max-width: 991.98px){
			.map-grid{
				grid-template-columns: 1fr;
			}
			.map-side{
				border-right: 0;
				border-bottom: 1px solid rgba(15,23,42,.10);
				max-height: 360px;
			}
			#jobsCityMap,
			#jobsCityMap.leaflet-container{
				height: 440px !important;
				min-height: 440px !important;
			}
		}
	</style>
