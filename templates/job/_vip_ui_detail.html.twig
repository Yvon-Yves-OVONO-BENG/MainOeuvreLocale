<style>
  :root{
    --job-bg:#f4f7fb;
    --job-bg-2:#eef4fb;
    --job-card:rgba(255,255,255,.86);
    --job-card-strong:rgba(255,255,255,.96);
    --job-line:rgba(15,23,42,.07);
    --job-line-strong:rgba(15,23,42,.12);
    --job-text:#0f172a;
    --job-text-soft:#1e293b;
    --job-muted:#64748b;
    --job-muted-2:#94a3b8;
    --job-primary:#2563eb;
    --job-primary-2:#4f46e5;
    --job-info:#0ea5e9;
    --job-success:#16a34a;
    --job-danger:#dc2626;
    --job-warning:#f59e0b;
    --job-radius:18px;
    --job-radius-md:24px;
    --job-radius-lg:30px;
    --job-shadow-xs:0 8px 20px rgba(15,23,42,.04);
    --job-shadow-sm:0 16px 40px rgba(15,23,42,.06);
    --job-shadow-md:0 24px 60px rgba(15,23,42,.08);
    --job-shadow-lg:0 38px 90px rgba(15,23,42,.12);
  }

  html{
    scroll-behavior:smooth;
  }

  body{
    font-size:12.6px;
    color:var(--job-text);
    letter-spacing:.01em;
    background:
      radial-gradient(900px 340px at 0% 0%, rgba(37,99,235,.08), transparent 58%),
      radial-gradient(900px 380px at 100% 0%, rgba(79,70,229,.07), transparent 58%),
      radial-gradient(780px 360px at 50% 100%, rgba(14,165,233,.04), transparent 62%),
      linear-gradient(180deg, #f8fbff 0%, #f4f7fb 44%, #edf3fa 100%);
  }

  .container{
    width:min(100% - 24px, 1720px) !important;
    max-width:1720px !important;
  }

  .sptb{
    padding-top:.55rem !important;
    padding-bottom:1.5rem !important;
  }

  .row.g-4{
    --bs-gutter-x:1rem;
    --bs-gutter-y:1rem;
  }

  .job-page-top{
    padding:10px 0 8px;
  }

  .job-top-banner{
    position:relative;
    overflow:hidden;
    border-radius:30px;
    padding:18px 20px;
    border:1px solid rgba(255,255,255,.42);
    background:
      radial-gradient(700px circle at 0% 0%, rgba(96,165,250,.22), transparent 42%),
      radial-gradient(600px circle at 100% 100%, rgba(129,140,248,.16), transparent 40%),
      linear-gradient(135deg, #0f172a 0%, #132238 24%, #17345f 58%, #1d4ed8 100%);
    box-shadow:0 26px 70px rgba(15,23,42,.16);
  }

  .job-top-banner::before{
    content:"";
    position:absolute;
    inset:0;
    background:
      linear-gradient(180deg, rgba(255,255,255,.05), transparent 34%, transparent 72%, rgba(255,255,255,.03)),
      linear-gradient(120deg, rgba(255,255,255,.07), transparent 18%, transparent 82%, rgba(255,255,255,.04));
    pointer-events:none;
  }

  .job-top-grid{
    position:relative;
    z-index:2;
    display:grid;
    grid-template-columns:minmax(0, 1.6fr) minmax(280px, .7fr);
    gap:14px;
    align-items:stretch;
  }

  .job-top-left,
  .job-top-right{
    min-width:0;
  }

  .job-badge{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:7px 12px;
    border-radius:999px;
    color:#fff;
    font-size:.69rem;
    font-weight:900;
    background:rgba(255,255,255,.11);
    border:1px solid rgba(255,255,255,.14);
    backdrop-filter:blur(12px);
    margin-bottom:10px;
  }

  .job-main-title{
    margin:0 0 8px;
    color:#fff;
    font-weight:900;
    font-size:clamp(1.3rem, 2vw, 2.2rem);
    line-height:1.05;
    letter-spacing:-.05em;
    text-shadow:0 10px 24px rgba(0,0,0,.10);
  }

  .job-main-subtitle{
    max-width:760px;
    color:rgba(255,255,255,.82);
    font-size:.75rem;
    line-height:1.68;
    margin:0 0 12px;
    font-weight:600;
  }

  .job-hero-pills{
    display:flex;
    flex-wrap:wrap;
    gap:7px;
    margin:0;
    padding:0;
    list-style:none;
  }

  .job-hero-pills li{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:8px 11px;
    border-radius:999px;
    background:rgba(255,255,255,.10);
    border:1px solid rgba(255,255,255,.13);
    color:#fff;
    font-size:.69rem;
    font-weight:800;
    backdrop-filter:blur(12px);
  }

  .job-top-statbox{
    height:100%;
    display:flex;
    flex-direction:column;
    justify-content:center;
    gap:10px;
    padding:14px;
    border-radius:22px;
    background:rgba(255,255,255,.11);
    border:1px solid rgba(255,255,255,.14);
    backdrop-filter:blur(14px);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.05);
  }

  .job-top-statbox-head{
    color:#fff;
    font-size:.66rem;
    font-weight:900;
    letter-spacing:.12em;
    text-transform:uppercase;
    opacity:.92;
  }

  .job-top-stat-grid{
    display:grid;
    grid-template-columns:1fr;
    gap:8px;
  }

  .job-top-stat{
    padding:10px 11px;
    border-radius:16px;
    background:rgba(255,255,255,.10);
    border:1px solid rgba(255,255,255,.11);
  }

  .job-top-stat-label{
    display:block;
    color:rgba(255,255,255,.68);
    font-size:.58rem;
    font-weight:900;
    letter-spacing:.11em;
    text-transform:uppercase;
    margin-bottom:4px;
  }

  .job-top-stat-value{
    display:block;
    color:#fff;
    font-size:.76rem;
    font-weight:900;
    line-height:1.35;
    word-break:break-word;
  }

  .job-breadcrumb{
    margin-top:10px;
    background:rgba(255,255,255,.78);
    border:1px solid rgba(255,255,255,.7);
    backdrop-filter:blur(16px);
    border-radius:20px;
    box-shadow:var(--job-shadow-sm);
    padding:12px 16px;
  }

  .job-breadcrumb-inner{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    flex-wrap:wrap;
  }

  .job-breadcrumb-title{
    margin:0;
    font-size:.84rem;
    font-weight:900;
    color:var(--job-text);
    letter-spacing:-.02em;
  }

  .breadcrumb{
    margin:0;
    padding:0;
    background:transparent;
    gap:2px;
  }

  .breadcrumb-item{
    font-size:.7rem;
    font-weight:800;
  }

  .breadcrumb-item a{
    color:var(--job-muted);
    text-decoration:none;
  }

  .breadcrumb-item a:hover{
    color:var(--job-primary);
  }

  .breadcrumb-item.active{
    color:var(--job-primary);
  }

  .card{
    border:none;
    border-radius:28px;
    overflow:hidden;
    background:var(--job-card);
    backdrop-filter:blur(16px);
    border:1px solid rgba(255,255,255,.76);
    box-shadow:var(--job-shadow-sm);
    transition:transform .22s ease, box-shadow .22s ease;
  }

  .card:hover{
    transform:translateY(-2px);
    box-shadow:var(--job-shadow-md);
  }

  .card-header{
    padding:14px 18px;
    border-bottom:1px solid var(--job-line);
    background:linear-gradient(180deg, rgba(255,255,255,.96), rgba(247,250,254,.90));
  }

  .card-body{
    padding:18px;
  }

  .card-footer{
    padding:14px 18px;
    border-top:1px solid var(--job-line);
    background:linear-gradient(180deg, rgba(255,255,255,.88), rgba(246,249,253,.96));
  }

  .card-title{
    margin:0;
    font-size:.7rem;
    font-weight:900;
    letter-spacing:.12em;
    text-transform:uppercase;
    color:var(--job-text);
  }

  .bg-light-50{
    background:linear-gradient(180deg, rgba(255,255,255,.88), rgba(244,248,252,.96)) !important;
  }

  .border-top{
    border-top:1px solid var(--job-line) !important;
  }

  .job-main-card{
    overflow:visible;
  }

  .job-main-head{
    display:grid;
    grid-template-columns:84px minmax(0, 1fr);
    gap:16px;
    align-items:start;
  }

  .job-author-avatar,
  .job-author-avatar img,
  .job-main-avatar img{
    width:84px;
    height:84px;
    border-radius:50%;
    object-fit:cover;
    display:block;
    margin:0 auto;
    background:#fff;
    border:4px solid rgba(255,255,255,.96);
    box-shadow:0 14px 30px rgba(15,23,42,.10);
  }

  .job-title{
    margin:0 0 10px;
    color:var(--job-text);
    font-size:clamp(1rem, 1.35vw, 1.34rem);
    font-weight:900;
    line-height:1.14;
    letter-spacing:-.035em;
  }

  .job-top-chips{
    display:grid;
    grid-template-columns:repeat(3, minmax(0, 1fr));
    gap:10px;
    margin-bottom:12px;
  }

  .job-chip{
    position:relative;
    padding:12px 13px;
    border-radius:16px;
    border:1px solid var(--job-line);
    background:linear-gradient(180deg, rgba(255,255,255,.97), rgba(245,249,254,.99));
    overflow:hidden;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.8);
  }

  .job-chip::before{
    content:"";
    position:absolute;
    inset:0 auto 0 0;
    width:3px;
    background:linear-gradient(180deg, var(--job-primary), #93c5fd);
  }

  .job-chip-label{
    display:block;
    padding-left:7px;
    margin-bottom:5px;
    color:var(--job-muted);
    font-size:.59rem;
    font-weight:900;
    letter-spacing:.10em;
    text-transform:uppercase;
  }

  .job-chip-value{
    display:block;
    padding-left:7px;
    color:var(--job-text);
    font-size:.76rem;
    font-weight:900;
    line-height:1.35;
    word-break:break-word;
  }

  .job-meta{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin:0;
    padding:0;
    list-style:none;
  }

  .job-meta li a{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:8px 11px;
    border-radius:999px;
    background:linear-gradient(180deg, #fbfdff, #f2f7fd);
    border:1px solid rgba(15,23,42,.06);
    color:var(--job-text-soft);
    text-decoration:none;
    font-size:.68rem;
    font-weight:900;
  }

  .job-meta li a i{
    color:var(--job-primary);
  }

  .job-actions{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    align-items:center;
    margin-top:14px;
  }

  .btn{
    border:none;
    border-radius:14px;
    font-size:.72rem;
    font-weight:900;
    line-height:1.12;
    padding:10px 14px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:6px;
    transition:all .18s ease;
    box-shadow:none !important;
  }

  .btn:hover{
    transform:translateY(-1px);
  }

  .btn:focus{
    outline:none;
    box-shadow:none !important;
  }

  .btn-primary{
    color:#fff;
    background:linear-gradient(135deg, var(--job-primary), var(--job-primary-2));
  }

  .btn-info{
    color:#fff;
    background:linear-gradient(135deg, #38bdf8, #0284c7);
  }

  .btn-danger{
    color:#fff;
    background:linear-gradient(135deg, #ef4444, #dc2626);
  }

  .btn-light{
    color:var(--job-text);
    background:linear-gradient(180deg, #f8fbff, #edf3fb);
    border:1px solid rgba(37,99,235,.08);
  }

  .btn-sm{
    padding:8px 12px;
    border-radius:12px;
    font-size:.68rem;
  }

  .job-content-grid{
    display:grid;
    grid-template-columns:minmax(0, 1.45fr) minmax(300px, .78fr);
    gap:18px;
    align-items:start;
  }

  .job-stack{
    display:grid;
    gap:16px;
  }

  .job-section{
    margin:0;
  }

  .job-section-title{
    margin:0 0 9px;
    font-size:.69rem;
    font-weight:900;
    letter-spacing:.12em;
    text-transform:uppercase;
    color:var(--job-text);
  }

  .job-section-box{
    padding:15px 16px;
    border-radius:18px;
    border:1px solid var(--job-line);
    background:linear-gradient(180deg, rgba(255,255,255,.97), rgba(246,250,254,.99));
    color:#334155;
    font-size:.76rem;
    line-height:1.82;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.82);
  }

  .job-section-box p:last-child{
    margin-bottom:0;
  }

  .job-side-panel{
    padding:16px;
    border-radius:22px;
    border:1px solid var(--job-line);
    background:linear-gradient(180deg, rgba(255,255,255,.98), rgba(245,249,254,1));
    box-shadow:var(--job-shadow-xs);
  }

  .job-side-panel + .job-side-panel{
    margin-top:14px;
  }

  .job-side-title{
    margin:0 0 12px;
    font-size:.69rem;
    font-weight:900;
    letter-spacing:.12em;
    text-transform:uppercase;
    color:var(--job-text);
  }

  .job-details-grid{
    display:grid;
    grid-template-columns:1fr;
    gap:10px;
  }

  .job-detail{
    position:relative;
    padding:12px 13px;
    border-radius:16px;
    border:1px solid var(--job-line);
    background:linear-gradient(180deg, rgba(255,255,255,.98), rgba(246,250,254,.99));
    overflow:hidden;
  }

  .job-detail::before{
    content:"";
    position:absolute;
    inset:0 auto 0 0;
    width:3px;
    background:linear-gradient(180deg, var(--job-primary), #93c5fd);
  }

  .job-detail-label{
    display:block;
    padding-left:7px;
    margin-bottom:5px;
    color:var(--job-muted);
    font-size:.58rem;
    font-weight:900;
    letter-spacing:.11em;
    text-transform:uppercase;
  }

  .job-detail-value{
    display:block;
    padding-left:7px;
    color:var(--job-text);
    font-size:.75rem;
    font-weight:900;
    word-break:break-word;
    line-height:1.45;
  }

  .job-bottom-info{
    color:var(--job-muted);
    font-size:.71rem;
  }

  .job-bottom-info a{
    color:var(--job-text);
    text-decoration:none;
  }

  .job-bottom-info .fw-bold{
    font-weight:900 !important;
  }

  .ribbon span{
    border-radius:12px;
    font-size:10px;
    font-weight:900;
    letter-spacing:.08em;
    text-transform:uppercase;
    box-shadow:0 10px 26px rgba(220,38,38,.24);
  }

  .arrow-ribbon{
    z-index:2;
    font-weight:900;
    letter-spacing:.06em;
    font-size:.62rem;
    border-radius:0 0 12px 12px;
  }

  .item-card7-img{
    border-radius:22px 22px 0 0;
    overflow:hidden;
  }

  .item-card7-imgs{
    position:relative;
  }

  .item-card7-imgs::after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(180deg, rgba(15,23,42,.02), rgba(15,23,42,.18));
    pointer-events:none;
  }

  .item-card7-imgs img{
    width:100%;
    height:230px;
    object-fit:cover;
  }

  .item-card7-overlaytext{
    position:absolute;
    left:0;
    right:0;
    bottom:0;
    z-index:2;
    padding:16px;
    background:linear-gradient(180deg, transparent, rgba(2,6,23,.82));
    color:#fff;
  }

  .item-card7-overlaytext a,
  .item-card7-overlaytext h4{
    color:#fff !important;
  }

  .item-card7-overlaytext a{
    font-size:.64rem;
    font-weight:900;
    letter-spacing:.11em;
    text-transform:uppercase;
  }

  .item-card7-overlaytext h4{
    font-size:.86rem;
    margin-top:4px;
  }

  .item-card7-desc h4{
    font-size:.8rem;
    margin-bottom:0;
    line-height:1.4;
  }

  .item-card7-text{
    margin-top:10px;
  }

  .icon-card{
    list-style:none;
    margin:0;
    padding:0;
    display:grid;
    gap:8px;
  }

  .icon-card li a{
    text-decoration:none;
    color:var(--job-text-soft);
    font-size:.71rem;
    font-weight:800;
  }

  .icon-card li a i{
    color:var(--job-primary);
  }

  .text-muted,
  .text-gray{
    color:var(--job-muted) !important;
  }

  a.text-dark:hover,
  .text-dark:hover{
    color:var(--job-primary) !important;
  }

  .disabled{
    pointer-events:none;
    opacity:.72;
  }

  .toast-container{
    position:fixed;
    top:50%;
    left:50%;
    width:min(92vw,420px);
    transform:translate(-50%,-50%);
    z-index:99999;
    pointer-events:none;
  }

  .mol-toast{
    width:100%;
    min-width:0;
    margin-bottom:10px;
    padding:14px 18px;
    border-radius:16px;
    color:#fff;
    font-size:.75rem;
    font-weight:800;
    text-align:center;
    box-shadow:0 16px 40px rgba(0,0,0,.18);
    pointer-events:auto;
    animation:toastIn .25s ease, toastOut .30s ease 2.65s forwards;
  }

  .mol-toast-success{ background:#16a34a; }
  .mol-toast-warning{ background:#f59e0b; }
  .mol-toast-danger{ background:#dc2626; }

  @keyframes toastIn{
    from{ transform:translateY(12px) scale(.97); opacity:0; }
    to{ transform:translateY(0) scale(1); opacity:1; }
  }

  @keyframes toastOut{
    to{ transform:translateY(-8px) scale(.98); opacity:0; }
  }

  @media print {
    body *{
      visibility:hidden !important;
    }

    #printJobArea, #printJobArea *{
      visibility:visible !important;
    }

    #printJobArea{
      position:absolute;
      left:0;
      top:0;
      width:100% !important;
      padding:0 !important;
      margin:0 !important;
    }

    a, button, .btn, .breadcrumb, .job-page-top{
      display:none !important;
    }

    .card{
      box-shadow:none !important;
      border:1px solid #e5e7eb !important;
      background:#fff !important;
    }
  }

  @media (max-width:1199.98px){
    .container{
      width:min(100% - 18px, 100%) !important;
      max-width:none !important;
    }

    .job-content-grid{
      grid-template-columns:1fr;
    }
  }

  @media (max-width:991.98px){
    .job-top-grid{
      grid-template-columns:1fr;
    }

    .job-main-head{
      grid-template-columns:1fr;
      text-align:center;
    }

    .job-top-chips{
      grid-template-columns:1fr;
    }

    .job-meta,
    .job-actions{
      justify-content:center;
    }

    .job-main-avatar img{
      margin-inline:auto;
    }

    .job-breadcrumb-inner{
      flex-direction:column;
      align-items:flex-start;
    }
  }

  @media (max-width:767.98px){
    body{
      font-size:12.4px;
    }

    .container{
      width:calc(100% - 12px) !important;
      max-width:none !important;
    }

    .job-top-banner{
      border-radius:22px;
      padding:14px 13px;
    }

    .job-breadcrumb{
      border-radius:16px;
      padding:12px 13px;
    }

    .card{
      border-radius:22px;
    }

    .card-header,
    .card-body,
    .card-footer{
      padding:14px;
    }

    .job-main-title{
      font-size:1.3rem;
    }

    .job-hero-pills li{
      width:100%;
      justify-content:center;
    }

    .btn,
    .job-actions .btn,
    .js-apply-toggle{
      width:100%;
    }

    .job-actions{
      display:grid;
      grid-template-columns:1fr;
      width:100%;
    }

    .item-card7-imgs img{
      height:190px;
    }
  }
</style>