<script>
(() => {
  'use strict';

  const BULK_DELETE_URL = '/mes-offres/suppression-multiple';
  const BULK_DELETE_TOKEN = {{ csrf_token('bulk_delete_jobs')|json_encode|raw }};

  const escapeHtml = (value) => String(value ?? '')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#039;');

  const normalize = (value) => String(value ?? '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim();

  const numberFrom = (value) => {
    const match = String(value ?? '').match(/\d+/);
    return match ? Number(match[0]) : 0;
  };

  const parseDate = (value) => {
    const match = String(value ?? '').match(/(\d{2})\/(\d{2})\/(\d{4})/);
    if (!match) return 0;
    return new Date(Number(match[3]), Number(match[2]) - 1, Number(match[1])).getTime();
  };

  const extractId = (href) => {
    const value = String(href ?? '');
    const queryMatch = value.match(/[?&]id=(\d+)/i);
    if (queryMatch) return queryMatch[1];
    const pathNumbers = value.match(/\d+/g);
    return pathNumbers?.length ? pathNumbers[pathNumbers.length - 1] : '';
  };

  const pageItems = (current, total) => {
    if (total <= 7) return Array.from({ length: total }, (_, index) => index + 1);
    const values = new Set([1, total, current - 1, current, current + 1]);
    if (current <= 3) [2, 3, 4].forEach((page) => values.add(page));
    if (current >= total - 2) [total - 3, total - 2, total - 1].forEach((page) => values.add(page));
    const pages = [...values].filter((page) => page > 0 && page <= total).sort((a, b) => a - b);
    const result = [];
    pages.forEach((page, index) => {
      if (index && page - pages[index - 1] > 1) result.push('gap');
      result.push(page);
    });
    return result;
  };

  const init = () => {
    const page = document.querySelector('.pub-page');
    if (!page || page.dataset.molPremiumReady === '1') return;

    const wrap = page.querySelector('.pub-wrap');
    const originalItems = [...page.querySelectorAll('.pub-list .pub-item')];
    const originalEmpty = page.querySelector('.pub-list .empty-state');
    const oldBack = page.querySelector('.pub-head a[href]');
    if (!wrap) return;

    page.dataset.molPremiumReady = '1';

    const records = originalItems.map((item, index) => {
      const titleNode = item.querySelector('.fw-bold');
      const titleClone = titleNode?.cloneNode(true);
      titleClone?.querySelectorAll('.badge').forEach((badge) => badge.remove());
      const title = titleClone?.textContent?.trim() || `Mission ${index + 1}`;
      const isNew = Boolean(item.querySelector('.badge'));
      const meta = item.querySelector('.text-muted.small')?.textContent?.replace(/\s+/g, ' ').trim() || '';
      const metaParts = meta.split('•').map((part) => part.replace('📍', '').trim());
      const city = metaParts[0] || '—';
      const date = metaParts[1] || '—';
      const pills = [...item.querySelectorAll('.pill')];
      const total = numberFrom(pills[0]?.textContent);
      const remaining = numberFrom(pills[1]?.textContent);
      const links = [...item.querySelectorAll('a[href]')];
      const editLink = links[0];
      const viewLink = links[1];
      const editHref = editLink?.getAttribute('href') || '#';
      const viewHref = viewLink?.getAttribute('href') || '#';
      const id = extractId(editHref) || String(index + 1);

      return {
        id,
        title,
        city,
        date,
        timestamp: parseDate(date),
        total,
        remaining,
        isNew,
        editHref,
        viewHref,
        originalItem: item
      };
    });

    const backHref = oldBack?.getAttribute('href') || 'javascript:history.back()';
    const emptyLinks = originalEmpty ? [...originalEmpty.querySelectorAll('a[href]')] : [];
    const publishHref = emptyLinks[0]?.getAttribute('href') || '';
    const templateHref = emptyLinks[1]?.getAttribute('href') || '';

    wrap.innerHTML = `
      <div class="mol-jobs-v2" data-mol-jobs-v2>
        <section class="mol-jobs-v2__hero">
          <div>
            <h1 class="mol-jobs-v2__title">Mes offres publiées</h1>
            <p class="mol-jobs-v2__subtitle">Recherchez, triez et gérez vos missions et les candidatures reçues dans un tableau clair et professionnel.</p>
          </div>
          <a href="${escapeHtml(backHref)}" class="mol-jobs-v2__back" data-action-link><span aria-hidden="true">←</span> Retour au tableau de bord</a>
        </section>

        <section class="mol-jobs-v2__stats" aria-label="Résumé des missions">
          <article class="mol-jobs-v2__stat"><span class="mol-jobs-v2__stat-icon">📄</span><div><strong data-stat-offers>0</strong><span>Offres publiées</span></div></article>
          <article class="mol-jobs-v2__stat"><span class="mol-jobs-v2__stat-icon">👥</span><div><strong data-stat-total>0</strong><span>Candidatures reçues</span></div></article>
          <article class="mol-jobs-v2__stat"><span class="mol-jobs-v2__stat-icon">🕒</span><div><strong data-stat-remaining>0</strong><span>Candidatures non vues</span></div></article>
        </section>

        <section class="mol-jobs-v2__panel">
          <header class="mol-jobs-v2__toolbar">
            <div>
              <div class="mol-jobs-v2__toolbar-title">Toutes mes missions</div>
              <div class="mol-jobs-v2__toolbar-subtitle" data-result-summary aria-live="polite"></div>
            </div>
            <div class="mol-jobs-v2__controls">
              <div class="mol-jobs-v2__search">
                <span class="mol-jobs-v2__search-icon" aria-hidden="true">⌕</span>
                <input type="search" data-search placeholder="Rechercher une mission, une ville…" autocomplete="off" aria-label="Rechercher une mission">
                <button type="button" class="mol-jobs-v2__search-clear" data-search-clear aria-label="Effacer la recherche" hidden>×</button>
              </div>
              <select class="mol-jobs-v2__limit" data-page-size aria-label="Nombre de missions par page">
                <option value="5">5 par page</option>
                <option value="10" selected>10 par page</option>
                <option value="25">25 par page</option>
                <option value="50">50 par page</option>
              </select>
            </div>
          </header>

          <div class="mol-jobs-v2__bulk" data-bulk-bar hidden>
            <div class="mol-jobs-v2__bulk-copy"><strong data-selected-count>0</strong> mission(s) sélectionnée(s)</div>
            <button type="button" class="mol-jobs-v2__button mol-jobs-v2__button--danger" data-bulk-delete>🗑️ Supprimer la sélection</button>
          </div>

          <div class="mol-jobs-v2__table-wrap" data-table-wrap>
            <table class="mol-jobs-v2__table">
              <thead>
                <tr>
                  <th><input type="checkbox" class="mol-jobs-v2__checkbox" data-select-page aria-label="Sélectionner la page"></th>
                  <th><button type="button" class="mol-jobs-v2__sort" data-sort="title">Mission <span>↕</span></button></th>
                  <th><button type="button" class="mol-jobs-v2__sort" data-sort="date">Publication <span>↓</span></button></th>
                  <th><button type="button" class="mol-jobs-v2__sort" data-sort="total">Candidatures <span>↕</span></button></th>
                  <th><button type="button" class="mol-jobs-v2__sort" data-sort="remaining">Non vues <span>↕</span></button></th>
                  <th style="text-align:right">Actions</th>
                </tr>
              </thead>
              <tbody data-tbody></tbody>
            </table>
          </div>

          <div class="mol-jobs-v2__empty" data-empty hidden>
            <span class="mol-jobs-v2__empty-icon">📂</span>
            <strong>Aucune mission trouvée</strong>
            <span>Modifiez votre recherche ou publiez une nouvelle mission.</span>
            ${publishHref ? `<div style="margin-top:16px"><a href="${escapeHtml(publishHref)}" class="mol-jobs-v2__action mol-jobs-v2__action--primary" data-action-link>＋ Publier une offre</a>${templateHref ? ` <a href="${escapeHtml(templateHref)}" class="mol-jobs-v2__action" data-action-link>🧩 Utiliser un modèle</a>` : ''}</div>` : ''}
          </div>

          <footer class="mol-jobs-v2__footer">
            <div class="mol-jobs-v2__range" data-range></div>
            <nav class="mol-jobs-v2__pagination" data-pagination aria-label="Pagination"></nav>
          </footer>
        </section>

        <div class="mol-jobs-v2__modal" data-delete-modal hidden>
          <div class="mol-jobs-v2__modal-card" role="dialog" aria-modal="true" aria-labelledby="molDeleteJobsTitle">
            <h3 id="molDeleteJobsTitle">Supprimer les missions sélectionnées ?</h3>
            <p>Cette action est définitive. <strong data-modal-count>0</strong> mission(s) seront supprimée(s).</p>
            <div class="mol-jobs-v2__modal-actions">
              <button type="button" class="mol-jobs-v2__modal-cancel" data-modal-cancel>Annuler</button>
              <button type="button" class="mol-jobs-v2__modal-confirm" data-modal-confirm>Supprimer définitivement</button>
            </div>
          </div>
        </div>

        <div class="mol-jobs-v2__toast" data-toast hidden></div>
      </div>
    `;

    const root = wrap.querySelector('[data-mol-jobs-v2]');
    const tbody = root.querySelector('[data-tbody]');
    const search = root.querySelector('[data-search]');
    const searchClear = root.querySelector('[data-search-clear]');
    const pageSize = root.querySelector('[data-page-size]');
    const pagination = root.querySelector('[data-pagination]');
    const range = root.querySelector('[data-range]');
    const resultSummary = root.querySelector('[data-result-summary]');
    const selectPage = root.querySelector('[data-select-page]');
    const bulkBar = root.querySelector('[data-bulk-bar]');
    const selectedCount = root.querySelector('[data-selected-count]');
    const bulkDelete = root.querySelector('[data-bulk-delete]');
    const empty = root.querySelector('[data-empty]');
    const tableWrap = root.querySelector('[data-table-wrap]');
    const modal = root.querySelector('[data-delete-modal]');
    const modalCount = root.querySelector('[data-modal-count]');
    const modalCancel = root.querySelector('[data-modal-cancel]');
    const modalConfirm = root.querySelector('[data-modal-confirm]');
    const toast = root.querySelector('[data-toast]');

    const state = {
      query: '',
      page: 1,
      size: 10,
      sortKey: 'date',
      sortDirection: 'desc',
      selected: new Set(),
      visible: []
    };

    let mutableRecords = [...records];
    let toastTimer = null;

    const rowHtml = (record) => `
      <tr data-id="${escapeHtml(record.id)}">
        <td><input type="checkbox" class="mol-jobs-v2__checkbox" data-row-check="${escapeHtml(record.id)}" aria-label="Sélectionner ${escapeHtml(record.title)}"></td>
        <td data-label="Mission">
          <div class="mol-jobs-v2__mission">
            <div class="mol-jobs-v2__mission-title">${escapeHtml(record.title)} ${record.isNew ? '<span class="mol-jobs-v2__new">Nouveau</span>' : ''}</div>
            <div class="mol-jobs-v2__mission-meta"><span>📍 ${escapeHtml(record.city)}</span><span>📅 ${escapeHtml(record.date)}</span></div>
          </div>
        </td>
        <td data-label="Publication">${escapeHtml(record.date)}</td>
        <td data-label="Candidatures"><span class="mol-jobs-v2__count">${record.total}</span></td>
        <td data-label="Non vues"><span class="mol-jobs-v2__count ${record.remaining > 0 ? 'mol-jobs-v2__count--new' : ''}">${record.remaining}</span></td>
        <td data-label="Actions">
          <div class="mol-jobs-v2__actions">
            <a href="${escapeHtml(record.editHref)}" class="mol-jobs-v2__action" data-action-link>✎ Optimiser</a>
            <a href="${escapeHtml(record.viewHref)}" class="mol-jobs-v2__action mol-jobs-v2__action--primary" data-action-link>Voir plus →</a>
          </div>
        </td>
      </tr>
    `;

    const getFiltered = () => {
      const filtered = mutableRecords.filter((record) => {
        if (!state.query) return true;
        return normalize(`${record.title} ${record.city} ${record.date}`).includes(state.query);
      });

      return filtered.sort((a, b) => {
        const direction = state.sortDirection === 'asc' ? 1 : -1;
        if (state.sortKey === 'title') return a.title.localeCompare(b.title, 'fr', { sensitivity: 'base' }) * direction;
        if (state.sortKey === 'total') return (a.total - b.total) * direction;
        if (state.sortKey === 'remaining') return (a.remaining - b.remaining) * direction;
        return (a.timestamp - b.timestamp) * direction;
      });
    };

    const updateStats = () => {
      root.querySelector('[data-stat-offers]').textContent = String(mutableRecords.length);
      root.querySelector('[data-stat-total]').textContent = String(mutableRecords.reduce((sum, record) => sum + record.total, 0));
      root.querySelector('[data-stat-remaining]').textContent = String(mutableRecords.reduce((sum, record) => sum + record.remaining, 0));
    };

    const updateSelection = () => {
      root.querySelectorAll('[data-row-check]').forEach((checkbox) => {
        const checked = state.selected.has(String(checkbox.dataset.rowCheck));
        checkbox.checked = checked;
        checkbox.closest('tr')?.classList.toggle('is-selected', checked);
      });

      bulkBar.hidden = state.selected.size === 0;
      selectedCount.textContent = String(state.selected.size);
      modalCount.textContent = String(state.selected.size);

      const ids = state.visible.map((record) => String(record.id));
      const selectedVisible = ids.filter((id) => state.selected.has(id)).length;
      selectPage.checked = ids.length > 0 && selectedVisible === ids.length;
      selectPage.indeterminate = selectedVisible > 0 && selectedVisible < ids.length;
      selectPage.disabled = ids.length === 0;
    };

    const renderPagination = (pages) => {
      pagination.innerHTML = '';
      const createButton = (label, target, active = false, disabled = false) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = `mol-jobs-v2__page-btn${active ? ' is-active' : ''}`;
        button.textContent = label;
        button.disabled = disabled;
        button.addEventListener('click', () => {
          state.page = target;
          render();
          root.querySelector('.mol-jobs-v2__panel')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        return button;
      };

      pagination.appendChild(createButton('‹', Math.max(1, state.page - 1), false, state.page === 1));
      pageItems(state.page, pages).forEach((item) => {
        if (item === 'gap') {
          const gap = document.createElement('span');
          gap.textContent = '…';
          gap.style.color = '#94a3b8';
          pagination.appendChild(gap);
        } else {
          pagination.appendChild(createButton(String(item), item, item === state.page));
        }
      });
      pagination.appendChild(createButton('›', Math.min(pages, state.page + 1), false, state.page === pages));
    };

    const render = () => {
      const filtered = getFiltered();
      const pages = Math.max(1, Math.ceil(filtered.length / state.size));
      state.page = Math.min(Math.max(state.page, 1), pages);
      const start = (state.page - 1) * state.size;
      state.visible = filtered.slice(start, start + state.size);

      tbody.innerHTML = state.visible.map(rowHtml).join('');
      const noRows = filtered.length === 0;
      tableWrap.hidden = noRows;
      empty.hidden = !noRows;
      range.textContent = noRows ? '0 mission' : `Affichage de ${start + 1} à ${Math.min(start + state.size, filtered.length)} sur ${filtered.length} mission(s)`;
      resultSummary.textContent = state.query ? `${filtered.length} résultat(s) trouvé(s)` : `${filtered.length} mission(s) disponible(s)`;
      searchClear.hidden = !search.value;

      renderPagination(pages);
      updateStats();
      updateSelection();
    };

    const showToast = (message, isError = false) => {
      clearTimeout(toastTimer);
      toast.textContent = message;
      toast.classList.toggle('is-error', isError);
      toast.hidden = false;
      toastTimer = setTimeout(() => { toast.hidden = true; }, 4200);
    };

    const closeModal = () => {
      modal.hidden = true;
      document.body.style.removeProperty('overflow');
    };

    search.addEventListener('input', () => {
      state.query = normalize(search.value);
      state.page = 1;
      render();
    });

    searchClear.addEventListener('click', () => {
      search.value = '';
      state.query = '';
      state.page = 1;
      search.focus();
      render();
    });

    pageSize.addEventListener('change', () => {
      state.size = Number(pageSize.value) || 10;
      state.page = 1;
      render();
    });

    root.addEventListener('click', (event) => {
      const sort = event.target.closest('[data-sort]');
      if (sort) {
        const key = sort.dataset.sort;
        if (state.sortKey === key) state.sortDirection = state.sortDirection === 'asc' ? 'desc' : 'asc';
        else {
          state.sortKey = key;
          state.sortDirection = key === 'title' ? 'asc' : 'desc';
        }
        state.page = 1;
        root.querySelectorAll('[data-sort] span').forEach((indicator) => { indicator.textContent = '↕'; });
        sort.querySelector('span').textContent = state.sortDirection === 'asc' ? '↑' : '↓';
        render();
        return;
      }

      const action = event.target.closest('[data-action-link]');
      if (action && action.getAttribute('href') && !action.getAttribute('href').startsWith('javascript:')) {
        action.classList.add('is-loading');
      }
    });

    tbody.addEventListener('change', (event) => {
      const checkbox = event.target.closest('[data-row-check]');
      if (!checkbox) return;
      const id = String(checkbox.dataset.rowCheck);
      checkbox.checked ? state.selected.add(id) : state.selected.delete(id);
      updateSelection();
    });

    selectPage.addEventListener('change', () => {
      state.visible.forEach((record) => {
        const id = String(record.id);
        selectPage.checked ? state.selected.add(id) : state.selected.delete(id);
      });
      updateSelection();
    });

    bulkDelete.addEventListener('click', () => {
      if (!state.selected.size) return;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      modalConfirm.focus();
    });

    modalCancel.addEventListener('click', closeModal);
    modal.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });

    modalConfirm.addEventListener('click', async () => {
      if (!state.selected.size) return;
      const ids = [...state.selected];
      const initialText = modalConfirm.textContent;
      modalConfirm.disabled = true;
      modalConfirm.textContent = 'Suppression…';

      try {
        const response = await fetch(BULK_DELETE_URL, {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
            'X-CSRF-TOKEN': BULK_DELETE_TOKEN
          },
          body: JSON.stringify({ ids, _token: BULK_DELETE_TOKEN })
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || payload.success === false) throw new Error(payload.message || 'Suppression impossible.');

        const deleted = new Set((payload.deleted || ids).map(String));
        mutableRecords = mutableRecords.filter((record) => !deleted.has(String(record.id)));
        deleted.forEach((id) => state.selected.delete(id));
        closeModal();
        state.page = 1;
        render();
        showToast(payload.message || `${deleted.size} mission(s) supprimée(s).`);
      } catch (error) {
        showToast(error instanceof Error ? error.message : 'Une erreur est survenue.', true);
      } finally {
        modalConfirm.disabled = false;
        modalConfirm.textContent = initialText;
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.hidden) closeModal();
    });

    render();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
  document.addEventListener('turbo:load', init);
})();
</script>
