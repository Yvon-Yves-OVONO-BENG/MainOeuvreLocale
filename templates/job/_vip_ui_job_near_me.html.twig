<style>
		:root{
			--near-ink:#0b1220;
			--near-bg:#f6f8fc;
			--near-surface:#ffffff;
			--near-border:rgba(15,23,42,.10);
			--near-muted:rgba(15,23,42,.62);
			--near-gold:#f6d365;
			--near-gold2:#d4af37;
			--near-blue:#4f46e5;
			--near-shadow:0 18px 60px rgba(2,6,23,.10);
			--near-shadow2:0 10px 26px rgba(2,6,23,.08);
			--near-radius:18px;
		}

		.near-page{
			background:
				radial-gradient(900px 500px at 15% 0%, rgba(246,211,101,.22), transparent 55%),
				radial-gradient(900px 500px at 85% 10%, rgba(79,70,229,.12), transparent 55%),
				linear-gradient(180deg, #f7f9ff, #f3f6fd);
			min-height: 100vh;
		}

		.near-hero{
			position: relative;
			border-bottom: 1px solid var(--near-border);
			overflow: hidden;
			background: rgba(255,255,255,.60);
			backdrop-filter: blur(10px);
		}
		.near-hero::before{
			content:"";
			position:absolute; inset:-2px;
			background:
				radial-gradient(1200px 600px at 50% 0%, rgba(79,70,229,.08), transparent 60%),
				linear-gradient(120deg, rgba(246,211,101,.22), rgba(212,175,55,.10), rgba(255,255,255,0));
			pointer-events:none;
		}
		.near-hero-inner{ position:relative; padding: 44px 0 28px; }

		.near-title{
			color: var(--near-ink);
			font-weight: 900;
			font-size: clamp(26px, 4vw, 44px);
			line-height: 1.05;
			margin: 0 0 10px;
		}
		.near-sub{
			color: var(--near-muted);
			margin: 0 0 18px;
			font-size: clamp(14px, 1.6vw, 16px);
		}

		.near-pillrow{ display:flex; flex-wrap:wrap; gap:10px; margin-bottom:18px; }
		.near-pill{
			display:inline-flex; align-items:center; gap:8px;
			padding: 9px 12px;
			border-radius: 999px;
			background: rgba(255,255,255,.78);
			border: 1px solid var(--near-border);
			color: rgba(15,23,42,.86);
			font-size: 13px;
			box-shadow: 0 10px 24px rgba(2,6,23,.06);
		}

		.near-wrap{ padding: 22px 0 46px; }

		.near-card{
			border-radius: var(--near-radius);
			background: rgba(255,255,255,.88);
			border: 1px solid var(--near-border);
			box-shadow: var(--near-shadow);
			overflow:hidden;
		}

		.near-head{
			padding: 16px;
			display:flex;
			gap:10px;
			align-items:center;
			justify-content: space-between;
			border-bottom: 1px solid var(--near-border);
			background: linear-gradient(180deg, rgba(255,255,255,.96), rgba(255,255,255,.70));
		}

		.near-job{
			padding: 14px;
			display:flex;
			gap:14px;
			align-items: stretch;
			border-bottom: 1px solid rgba(15,23,42,.08);
		}
		.near-job:last-child{ border-bottom: 0; }

		.near-logo{
			width: 56px; height: 56px;
			border-radius: 16px;
			background: rgba(79,70,229,.06);
			border: 1px solid rgba(79,70,229,.14);
			display:flex; align-items:center; justify-content:center;
			flex: 0 0 auto;
			overflow:hidden;
		}
		.near-logo img{ width:100%; height:100%; object-fit:cover; }

		.near-body{ flex:1; min-width:0; }
		.near-job-title{
			margin:0;
			font-weight: 950;
			color: var(--near-ink);
			font-size: 16px;
			line-height: 1.2;
		}

		.near-meta{
			margin-top: 8px;
			display:flex; flex-wrap:wrap;
			gap: 10px 12px;
			color: rgba(15,23,42,.70);
			font-size: 13px;
		}

		.near-desc{
			margin: 8px 0 0;
			color: rgba(15,23,42,.62);
			font-size: 13px;
			line-height: 1.35;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow:hidden;
		}

		.near-actions{
			display:flex;
			flex-direction: column;
			gap: 10px;
			justify-content: space-between;
			align-items:flex-end;
			min-width: 160px;
		}

		.near-badge{
			font-size: 12px;
			padding: 6px 10px;
			border-radius: 999px;
			border: 1px solid rgba(15,23,42,.10);
			background: rgba(15,23,42,.04);
			color: rgba(15,23,42,.78);
		}

		.near-btn{
			border-radius: 14px;
			padding: 10px 12px;
			font-weight: 950;
			color: #101018;
			background: linear-gradient(135deg, var(--near-gold), var(--near-gold2));
			border: 0;
			width: 100%;
			box-shadow: 0 18px 44px rgba(212,175,55,.14);
			text-decoration:none;
			display:inline-flex;
			align-items:center;
			justify-content:center;
		}

		.near-pager{ display:flex; gap:10px; justify-content:center; margin-top: 16px; flex-wrap:wrap; }
		.near-pagebtn{
			padding: 10px 12px;
			border-radius: 14px;
			border: 1px solid rgba(15,23,42,.12);
			background: rgba(255,255,255,.92);
			color: rgba(15,23,42,.86);
			text-decoration:none;
			min-width: 44px;
			text-align:center;
			font-weight: 950;
		}
		.near-pagebtn.active{
			background: rgba(79,70,229,.10);
			border-color: rgba(79,70,229,.18);
			color: rgba(79,70,229,.92);
		}
		.near-pagebtn.disabled{ opacity:.55; pointer-events:none; }

		.near-empty{
			padding: 28px;
			text-align:center;
			color: rgba(15,23,42,.70);
		}

		@media (max-width: 991.98px){
			.near-job{ flex-direction: column; }
			.near-actions{ align-items: stretch; min-width: auto; }
		}
	</style>