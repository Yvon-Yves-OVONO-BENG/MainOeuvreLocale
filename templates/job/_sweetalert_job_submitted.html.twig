{# templates/job/_sweetalert_job_submitted.html.twig #}
<div style="padding: 10px 0; text-align: center;">
    <div style="font-size: 64px; margin-bottom: 15px; animation: bounceIn 0.6s ease;">✨</div>
    
    <h3 style="font-size: 20px; font-weight: 700; color: #0f172a; margin-bottom: 15px; line-height: 1.4;">
        {{ job.title }}
    </h3>
    
    <div style="background: #f8fafc; border-radius: 12px; padding: 12px 16px; margin-bottom: 15px; text-align: left;">
        <div style="display: flex; align-items: center; gap: 10px; padding: 6px 0; font-size: 14px; color: #475569;">
            <span style="width: 20px;">🏢</span>
            <span>{{ job.city }}</span>
        </div>
        <div style="display: flex; align-items: center; gap: 10px; padding: 6px 0; font-size: 14px; color: #475569;">
            <span style="width: 20px;">🏷️</span>
            <span>{{ job.profession ? job.profession.profession : 'Non spécifié' }}</span>
        </div>
        <div style="display: flex; align-items: center; gap: 10px; padding: 6px 0; font-size: 14px; color: #475569;">
            <span style="width: 20px;">💰</span>
            <span>{{ job.salaireMin|number_format(0, ',', ' ') }} - {{ job.salaireMax|number_format(0, ',', ' ') }} FCFA</span>
        </div>
    </div>
    
    <div style="background: linear-gradient(135deg, #fef3c7, #fef9c3); border: 1px solid #fcd34d; border-radius: 12px; padding: 16px; margin-bottom: 20px; display: flex; gap: 12px; text-align: left;">
        <div style="font-size: 24px; color: #f59e0b; margin-top: 3px;">🛡️</div>
        <div>
            <strong style="display: block; color: #92400e; margin-bottom: 5px; font-size: 15px;">En cours de vérification</strong>
            <p style="color: #78350f; font-size: 13px; line-height: 1.5; margin: 0 0 8px 0;">
                Votre offre sera examinée par notre équipe de modération. Vous serez notifié par email dès qu'elle sera approuvée.
            </p>
            <p style="font-size: 12px; color: #64748b; margin: 0;">
                Référence : <strong style="color: #0f172a;">{{ job.reference }}</strong>
            </p>
        </div>
    </div>
    
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 0 10px;">
        <div style="text-align: center;">
            <div style="width: 32px; height: 32px; border-radius: 50%; background: #10b981; display: flex; align-items: center; justify-content: center; font-size: 14px; margin: 0 auto 6px;">✅</div>
            <div style="font-size: 11px; color: #0f172a; font-weight: 600;">Offre créée</div>
        </div>
        <div style="text-align: center;">
            <div style="width: 32px; height: 32px; border-radius: 50%; background: #6366f1; display: flex; align-items: center; justify-content: center; font-size: 14px; margin: 0 auto 6px; animation: pulse 2s infinite;">🔍</div>
            <div style="font-size: 11px; color: #0f172a; font-weight: 600;">En vérification</div>
        </div>
        <div style="text-align: center;">
            <div style="width: 32px; height: 32px; border-radius: 50%; background: #e2e8f0; display: flex; align-items: center; justify-content: center; font-size: 14px; margin: 0 auto 6px;">📢</div>
            <div style="font-size: 11px; color: #94a3b8; font-weight: 500;">Publication</div>
        </div>
    </div>
</div>

