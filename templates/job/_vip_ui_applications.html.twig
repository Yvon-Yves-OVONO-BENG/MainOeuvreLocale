<style>
  .app-wrap{
    background:
      radial-gradient(900px circle at 10% 0%, rgba(13,110,253,.10), transparent 55%),
      radial-gradient(900px circle at 90% 10%, rgba(32,201,151,.10), transparent 55%),
      linear-gradient(180deg, rgba(255,255,255,.98), rgba(255,255,255,.86));
    border: 1px solid rgba(0,0,0,.06);
    border-radius: 18px;
    box-shadow: 0 18px 50px rgba(0,0,0,.08);
    overflow: hidden;
  }
  .app-head{
    padding: 18px 18px 14px;
    border-bottom: 1px solid rgba(0,0,0,.06);
    display:flex; align-items:center; justify-content:space-between; gap:12px;
  }
  .app-title{ font-weight:900; letter-spacing:.2px; }
  .app-sub{ color: rgba(0,0,0,.55); font-size:.92rem; }
  .row-item{ padding: 14px 0; border-bottom:1px solid rgba(0,0,0,.06); }
  .row-item:last-child{ border-bottom:0; }
  .toggle-btn{ min-width: 130px; }
  .toast-container{ position: fixed; top: 18px; right: 18px; z-index: 999999; }
  .mol-toast{
    min-width: 280px; margin-bottom: 10px; padding: 14px 18px; border-radius: 10px;
    color: white; font-weight: 700; box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    animation: toastIn .35s ease, toastOut .35s ease 3.8s forwards;
  }
  .mol-toast-success{ background: #16a34a; }
  .mol-toast-danger{ background: #dc2626; }
  @keyframes toastIn{ from{ transform: translateX(120%); opacity: 0 } to{ transform: translateX(0); opacity: 1 } }
  @keyframes toastOut{ to{ transform: translateX(120%); opacity: 0 } }
</style>